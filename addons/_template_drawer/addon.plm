language 0.1
import "addon-palette.plm"

//  A Vitreus add-on with a PANEL: the shell puts the add-on's icon on the add-on pill (the pill of icons in the corner the app dock is not in) and draws a panel out of it
//  (the same glass as its own drawers) and this scene draws what is in it. A click on the icon opens the panel (or `pleamar --say vitreus "emit ax_toggle"`, which a key can run).
//
//  What the shell does, and an add-on cannot change or leave out:
//    - The icon: a panel needs one (`icon` in addon.toml, with `[drawer]`); without it the add-on is left out of the list, with that said under it.
//    - The title bar across the top: the add-on's name (`name` in addon.toml), a grip to pull the panel by (it can be pulled away from the pill and left anywhere) and the X in
//      the top corner that shuts it. The panel also shuts with its icon. This scene draws only below the bar.
//    - The glass, which stands against the frame like the Desk does: wherever a side is within a hand of the frame it reaches on into it, and lets go as it is pulled away.
//    - Resizing: a handle in each corner (the cursor shows it). The size in addon.toml is the first one (width 240 to 1600, height 160 to 1600; 0 for the shell's choice); once
//      the panel has been resized the new size is kept for the next time it opens. It cannot get smaller than 240 x 160 or bigger than the room inside the frame.
//
//  What it tells this scene, as facts, as the panel settles: `slot_x`, `slot_y` the middle of the content, `slot_w`, `slot_h` its size, in pixels of the screen (below the
//  title bar), and `slot_open` (true while the panel is out and not being pulled or resized: the content waits and appears at its new place and size). Draw inside that
//  rectangle only, and work everything out from `slot_w` and `slot_h`, never from a fixed size: the user can change it. It also tells it the palette (`pal_*`), the bar's room
//  (`room_*`), the theme's shape (`look`) and the forecast (`wx_*`), and the size of the monitor the panel is on (`slot_sw`, `slot_sh`).
//
//  One monitor: the scene has a copy on each monitor (`screens: each`), and only the copy on the panel's monitor should draw; `shown` below is 1 only there. A copy is told
//  apart by its monitor's size, not its number (a scene numbers its monitors in its own order, not the shell's). Hide with `shown`, and make zones `active: shown > 0.5`.
//
//  Text fields: this scene does not take the keyboard (no `keyboard:` on its surface: asked of every copy at once, Hyprland gave it, and the pointer with it, to a
//  copy on the wrong monitor). The shell takes the keys for it instead: the logic tells the shell where the field is (`axf_*`, see addon.luau and logic/addons.luau in
//  Vitreus), this scene leaves that rectangle without a zone of its own, so a click there reaches the shell, and the shell sends back what is written (`field_q`), whether
//  it is being typed in (`field_kb`: draw the caret) and Enter and Escape (`field_enter`, `field_esc`). One field at a time, one line, the caret at its end; it takes the
//  keys only from a click on it (a field given the keys without one would take the pointer from this scene until it let go).
//
//  The logic is addon.luau beside this file (the scene's name with .luau): it keeps what it must in the scene's own data folder with the `files` services below, and any
//  program it runs (`run("wl-paste", ...)`, `curl`, a helper of your own) has to be named in `permissions` (`pleamar`, to talk to the shell about the field). The shell sets `wx_*` texts on a scene that declares them: name your own weather facts something else (the News & Weather add-on uses `nw_*`).

scene MyDrawer {
    surface { size: full, full; anchor: top_left; margin: 0; level: top, overlay while slot_open; screens: each max 4 }

    permissions {
        services: "files", "files.write"          // what addon.luau uses to keep `clicks`
        run: "pleamar"                           // the programs the logic may run, by name: `pleamar --say vitreus ...` places the field (add "wl-paste", "curl"... as you need them)
    }

    fact pal_ink_r = 0.9608
    fact pal_ink_g = 0.9686
    fact pal_ink_b = 0.9608
    fact pal_faint_r = 0.7608
    fact pal_faint_g = 0.7804
    fact pal_faint_b = 0.8000
    fact pal_mint_r = 0.6196
    fact pal_mint_g = 0.8392
    fact pal_mint_b = 0.7412
    fact pal_mintlo_r = 0.4235
    fact pal_mintlo_g = 0.7373
    fact pal_mintlo_b = 0.6118
    fact pal_minthi_r = 0.8627
    fact pal_minthi_g = 0.9725
    fact pal_minthi_b = 0.9255
    fact pal_onmint_r = 0.0627
    fact pal_onmint_g = 0.0863
    fact pal_onmint_b = 0.1020
    fact pal_tint_r = 0.1059
    fact pal_tint_g = 0.1294
    fact pal_tint_b = 0.1529
    fact pal_panel_r = 0.0863
    fact pal_panel_g = 0.1020
    fact pal_panel_b = 0.1216
    fact pal_deep_r = 0.0431
    fact pal_deep_g = 0.0549
    fact pal_deep_b = 0.0667
    fact pal_off_r = 0.2275
    fact pal_off_g = 0.2510
    fact pal_off_b = 0.2824
    fact pal_alert_r = 0.9373
    fact pal_alert_g = 0.2667
    fact pal_alert_b = 0.2667

    fact room_t = 0
    fact room_r = 0
    fact room_b = 0
    fact room_l = 0
    fact look = 0
    fact wx_ok = false
    text wx_temp = ""
    text wx_desc = ""

    fact slot_open = false
    fact slot_sw = 0                                  // the size of the monitor the panel is on: the scene has a copy on each (`screens: each`, numbered in its own order) and only the copy of that size draws (0: not told yet, every copy does)
    fact slot_sh = 0
    fact slot_x = 0
    fact slot_y = 0
    fact slot_w = 0
    fact slot_h = 0
    let shown = if(slot_open and (slot_sw == 0 or (screen.width == slot_sw and screen.height == slot_sh)), 1, 0)       // 1 on the copy that is on the panel's monitor, while the panel is out

    fact clicks = 0
    text field_q = ""                                 // the field: what is written in it (the shell sends it), whether it is being typed in, and its Enter and Escape
    fact field_kb = false
    event field_enter ->
    event field_esc ->
    text hello = ""                                   // what Enter kept (addon.luau)
    measure fq
    let left = slot_x - slot_w / 2
    let top = slot_y - slot_h / 2

    //  The content follows the panel's size: this bar is as wide as the panel, and the dots keep to its right edge.
    box { at: left + slot_w / 2, top + slot_h - 24; size: slot_w - 48, 4; corner: 2; color: mint; opacity: 40% * shown }
    text "Your panel goes here" { at: left + 24, top + 28; anchor: left center; size: 18; weight: 700; color: ink; opacity: shown; family: "Space Grotesk" }
    text wx_temp { at: left + 24, top + 56; anchor: left center; size: 16; color: faint; opacity: shown; family: "Space Grotesk" }
    box { at: left + 70, top + 104; size: 124, 36; corner: 18; color: mint; opacity: 80% * shown }
    text "Press me" { at: left + 70, top + 104; anchor: center; size: 15; weight: 700; color: onmint; opacity: shown; family: "Space Grotesk" }
    zone box press_me { at: left + 70, top + 104; size: 124, 36; corner: 18; cursor: pointer; active: shown > 0.5 }
    on press press_me { clicks = clicks + 1 }
    repeat i in 0..8 {
        ellipse { at: left + slot_w - 24 - (7 - i) * 16, top + 104; radius: 5; color: mint; opacity: if(clicks > i, 1, 0.2) * shown }
    }
    //  The field: 24 from the content's left and right edges, 140 down, 36 tall (what addon.luau tells the shell). Drawn here; no zone over it, so the click is the shell's.
    box { at: left + slot_w / 2, top + 158; size: slot_w - 48, 36; corner: 18; color: ink; opacity: (8% + 6% * if(field_kb, 1, 0)) * shown }
    text "Type your name, then Enter" { at: left + 42, top + 158; anchor: left center; size: 15; color: faint; opacity: 70% * shown * if(fq.width < 1, 1, 0); family: "Space Grotesk" }
    text field_q { at: left + 42, top + 158; anchor: left center; size: 15; color: ink; opacity: shown; family: "Space Grotesk"; measure: fq }
    box { at: left + 43 + fq.width, top + 158; size: 2, 20; color: mint; opacity: shown * if(field_kb, 1, 0) }
    text hello { at: left + 24, top + 196; anchor: left center; size: 15; weight: 700; color: mint; opacity: shown; family: "Space Grotesk" }
}
