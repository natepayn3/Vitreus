            //  Doodle: the close button is always there (the pencil's cross above shows only under the pointer, and not on plastic): a cream disc, a thick black ring and a cross.
        group {
            show: dd > 0.01
            opacity: dd * sh
            ellipse { at: if(f14 == 3, 16, 184), 13; radius: 10; color: #fffaf6 }
            ellipse { at: if(f14 == 3, 16, 184), 13; radius: 10; stroke: 2.4; color: ink }
            line { from: if(f14 == 3, 16, 184) - 3.6, 13 - 3.6; to: if(f14 == 3, 16, 184) + 3.6, 13 + 3.6; width: 2.4; color: ink }
            line { from: if(f14 == 3, 16, 184) - 3.6, 13 + 3.6; to: if(f14 == 3, 16, 184) + 3.6, 13 - 3.6; width: 2.4; color: ink }
        }
            text t14 { at: 20, 46; anchor: left top; size: 17; weight: 500; width: 160; lines: 5; color: mix(deep, ink, dd); family: "Space Grotesk"; show: eix != 14 and h14 }
            text "Click to write" { at: 20, 46; anchor: left top; size: 15; weight: 500; color: mix(deep, ink, dd); opacity: 45%; family: "Space Grotesk"; show: eix != 14 and not h14 }
        }
    }
    group {
        show: o15 and sh > 0.01
        move: lx15, ly15
        pivot: 100, 84
        rotate: 1.4deg
        z: sz15
        //  Its grab area and its cross are inside it, so that they stack with it (the one drawn on top is the one that is pressed where two overlap): the grab area a little larger than the paper,
        //  and a good deal larger while it is held, so that a quick pull cannot outrun it (it moves with the sticker, a frame behind).
        zone box zb15 { at: 100, 84; size: 212 + 600 * zb15.pressed, 180 + 600 * zb15.pressed; corner: 6; cursor: grab; active: o15 and sh > 0.5 }
        zone box zx15 { at: if(f15 == 3, 16, 184), 13; size: 26, 26; corner: 13; cursor: pointer; active: o15 and sh > 0.5 }
        //  The paper: an opaque sheet of one of the shell's colours warmed towards cream (not glass), almost square, with its bottom left corner folded over, a soft shadow, a piece of tape and faint
        //  ruled lines. In Retro and UwU it takes their outline and hard shadow like the rest.
        body {
            color: pp15
            rim: 0%
            border: (2 + 1.2 * uk + 2.2 * dd) * pl, mix(deep, ink, dd)
            shadow: 3 * pl, 4 - pl, 11 * (1 - pl) + 2, (36% + 40% * pl) * (1 - dd), mix(#000000, deep, pl)
            opacity: sh
            path { at: 0, 0; move 0, if(f15 == 2, 26, 0); line if(f15 == 2, 26, 0), 0; line if(f15 == 3, 174, 200), 0; line 200, if(f15 == 3, 26, 0); line 200, if(f15 == 1, 142, 168); line if(f15 == 1, 174, 200), 168; line if(f15 == 0, 26, 0), 168; line 0, if(f15 == 0, 142, 168); close }
        }
        body {
            color: mix(pp15, #ffffff, 0.45)
            rim: 0%
            shadow: 1, -1, 4, 28%
            opacity: sh
            path { at: 0, 0; move pick(f15, 0, 200, 0, 174), pick(f15, 142, 142, 26, 0); line pick(f15, 26, 174, 26, 200), pick(f15, 168, 168, 0, 26); line pick(f15, 26, 174, 26, 174), pick(f15, 142, 142, 26, 26); close }
        }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; color: #efe9cc; opacity: 62% * sh }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; stroke: 0.8; color: deep; opacity: 14% * sh }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 66.62 + (0.25 + 0.4 * pa.15) * sin(fr15 * 63 + 3966); line 100, 65.12 + (0.25 + 0.4 * pa.15) * sin(fr15 * 67 + 814); line 186, 66.59 + (0.25 + 0.4 * pa.15) * sin(fr15 * 47 + 4158) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 87.21 + (0.25 + 0.4 * pa.15) * sin(fr15 * 75 + 464); line 100, 86.90 + (0.25 + 0.4 * pa.15) * sin(fr15 * 43 + 1291); line 186, 87.35 + (0.25 + 0.4 * pa.15) * sin(fr15 * 53 + 3604) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 108.80 + (0.25 + 0.4 * pa.15) * sin(fr15 * 53 + 2079); line 100, 107.31 + (0.25 + 0.4 * pa.15) * sin(fr15 * 56 + 1658); line 186, 107.95 + (0.25 + 0.4 * pa.15) * sin(fr15 * 55 + 229) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 128.66 + (0.25 + 0.4 * pa.15) * sin(fr15 * 47 + 1216); line 100, 128.49 + (0.25 + 0.4 * pa.15) * sin(fr15 * 64 + 1018); line 186, 128.44 + (0.25 + 0.4 * pa.15) * sin(fr15 * 60 + 2817) }
        //  The Cyber's HUD marks (as on its drawers, bar_glass.plm): a neon hairline and bright corner brackets 6 px outside the sticker.
        group {
            show: cyk > 0.01
            opacity: cyk * sh
            box { from: 0, 0; size: 200, 168; corner: 22 * (1 - 0.73 * cyk); stroke: 1.1; color: mint; opacity: 38% }
            repeat nc15 in 0..4 {
                let nx15 = if(mod(nc15, 2) == 0, -6, 206)
                let ny15 = if(nc15 < 2, -6, 174)
                let nsx15 = if(mod(nc15, 2) == 0, -1, 1)
                let nsy15 = if(nc15 < 2, -1, 1)
                path { at: nx15, ny15; stroke: 5; color: mint; opacity: 16%; move 0, -nsy15 * 13; line 0, 0; line -nsx15 * 13, 0 }
                path { at: nx15, ny15; stroke: 1.7; color: minthi; move 0, -nsy15 * 13; line 0, 0; line -nsx15 * 13, 0 }
            }
        }
