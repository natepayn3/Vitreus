            //  Doodle: the close button is always there (the pencil's cross above shows only under the pointer, and not on plastic): a cream disc, a thick black ring and a cross.
        group {
            show: dd > 0.01
            opacity: dd * sh
            ellipse { at: if(f1 == 3, 16, 184), 13; radius: 10; color: #fffaf6 }
            ellipse { at: if(f1 == 3, 16, 184), 13; radius: 10; stroke: 2.4; color: ink }
            line { from: if(f1 == 3, 16, 184) - 3.6, 13 - 3.6; to: if(f1 == 3, 16, 184) + 3.6, 13 + 3.6; width: 2.4; color: ink }
            line { from: if(f1 == 3, 16, 184) - 3.6, 13 + 3.6; to: if(f1 == 3, 16, 184) + 3.6, 13 - 3.6; width: 2.4; color: ink }
        }
            text t1 { at: 20, 46; anchor: left top; size: 17; weight: 500; width: 160; lines: 5; color: mix(deep, ink, dd); family: "Space Grotesk"; show: eix != 1 and h1 }
            text "Click to write" { at: 20, 46; anchor: left top; size: 15; weight: 500; color: mix(deep, ink, dd); opacity: 45%; family: "Space Grotesk"; show: eix != 1 and not h1 }
        }
    }
    group {
        show: o2 and sh > 0.01
        move: lx2, ly2
        pivot: 100, 84
        rotate: -0.7deg
        z: sz2
        //  Its grab area and its cross are inside it, so that they stack with it (the one drawn on top is the one that is pressed where two overlap): the grab area a little larger than the paper,
        //  and a good deal larger while it is held, so that a quick pull cannot outrun it (it moves with the sticker, a frame behind).
        zone box zb2 { at: 100, 84; size: 212 + 600 * zb2.pressed, 180 + 600 * zb2.pressed; corner: 6; cursor: grab; active: o2 and sh > 0.5 }
        zone box zx2 { at: if(f2 == 3, 16, 184), 13; size: 26, 26; corner: 13; cursor: pointer; active: o2 and sh > 0.5 }
        //  The paper: an opaque sheet of one of the shell's colours warmed towards cream (not glass), almost square, with its bottom left corner folded over, a soft shadow, a piece of tape and faint
        //  ruled lines. In Retro and UwU it takes their outline and hard shadow like the rest.
        body {
            color: pp2
            rim: 0%
            border: (2 + 1.2 * uk + 2.2 * dd) * pl, mix(deep, ink, dd)
            shadow: 3 * pl, 4 - pl, 11 * (1 - pl) + 2, (36% + 40% * pl) * (1 - dd), mix(#000000, deep, pl)
            opacity: sh
            path { at: 0, 0; move 0, if(f2 == 2, 26, 0); line if(f2 == 2, 26, 0), 0; line if(f2 == 3, 174, 200), 0; line 200, if(f2 == 3, 26, 0); line 200, if(f2 == 1, 142, 168); line if(f2 == 1, 174, 200), 168; line if(f2 == 0, 26, 0), 168; line 0, if(f2 == 0, 142, 168); close }
        }
        body {
            color: mix(pp2, #ffffff, 0.45)
            rim: 0%
            shadow: 1, -1, 4, 28%
            opacity: sh
            path { at: 0, 0; move pick(f2, 0, 200, 0, 174), pick(f2, 142, 142, 26, 0); line pick(f2, 26, 174, 26, 200), pick(f2, 168, 168, 0, 26); line pick(f2, 26, 174, 26, 174), pick(f2, 142, 142, 26, 26); close }
        }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; color: #efe9cc; opacity: 62% * sh }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; stroke: 0.8; color: deep; opacity: 14% * sh }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 65.11 + (0.25 + 0.4 * pa.2) * sin(fr2 * 56 + 411); line 100, 66.84 + (0.25 + 0.4 * pa.2) * sin(fr2 * 64 + 3783); line 186, 65.44 + (0.25 + 0.4 * pa.2) * sin(fr2 * 46 + 4719) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 86.55 + (0.25 + 0.4 * pa.2) * sin(fr2 * 49 + 2596); line 100, 87.18 + (0.25 + 0.4 * pa.2) * sin(fr2 * 46 + 3120); line 186, 87.69 + (0.25 + 0.4 * pa.2) * sin(fr2 * 74 + 4830) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 108.72 + (0.25 + 0.4 * pa.2) * sin(fr2 * 45 + 4664); line 100, 107.19 + (0.25 + 0.4 * pa.2) * sin(fr2 * 40 + 3290); line 186, 107.99 + (0.25 + 0.4 * pa.2) * sin(fr2 * 43 + 320) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 128.41 + (0.25 + 0.4 * pa.2) * sin(fr2 * 49 + 2672); line 100, 129.78 + (0.25 + 0.4 * pa.2) * sin(fr2 * 72 + 3657); line 186, 129.40 + (0.25 + 0.4 * pa.2) * sin(fr2 * 76 + 4524) }
        //  The Cyber's HUD marks (as on its drawers, bar_glass.plm): a neon hairline and bright corner brackets 6 px outside the sticker.
        group {
            show: cyk > 0.01
            opacity: cyk * sh
            box { from: 0, 0; size: 200, 168; corner: 22 * (1 - 0.73 * cyk); stroke: 1.1; color: mint; opacity: 38% }
            repeat nc2 in 0..4 {
                let nx2 = if(mod(nc2, 2) == 0, -6, 206)
                let ny2 = if(nc2 < 2, -6, 174)
                let nsx2 = if(mod(nc2, 2) == 0, -1, 1)
                let nsy2 = if(nc2 < 2, -1, 1)
                path { at: nx2, ny2; stroke: 5; color: mint; opacity: 16%; move 0, -nsy2 * 13; line 0, 0; line -nsx2 * 13, 0 }
                path { at: nx2, ny2; stroke: 1.7; color: minthi; move 0, -nsy2 * 13; line 0, 0; line -nsx2 * 13, 0 }
            }
        }
        group {
            opacity: sh
            path { at: 0, 0; stroke: 1.3; color: deep; opacity: 40% * sh * (1 - pl); move 19.97 + (0.3 + 0.55 * pa.2) * sin(fr2 * 46 + 1980), 30.78 + (0.3 + 0.55 * pa.2) * sin(fr2 * 63 + 3867); line 40.55 + (0.3 + 0.55 * pa.2) * sin(fr2 * 51 + 3927), 31.53 + (0.3 + 0.55 * pa.2) * sin(fr2 * 49 + 2942); line 60.45 + (0.3 + 0.55 * pa.2) * sin(fr2 * 48 + 362), 31.57 + (0.3 + 0.55 * pa.2) * sin(fr2 * 40 + 4161); line 80.58 + (0.3 + 0.55 * pa.2) * sin(fr2 * 55 + 4328), 31.05 + (0.3 + 0.55 * pa.2) * sin(fr2 * 57 + 1946); line 100.03 + (0.3 + 0.55 * pa.2) * sin(fr2 * 64 + 383), 30.64 + (0.3 + 0.55 * pa.2) * sin(fr2 * 42 + 1784); line 120.19 + (0.3 + 0.55 * pa.2) * sin(fr2 * 75 + 377), 30.48 + (0.3 + 0.55 * pa.2) * sin(fr2 * 56 + 1451); line 140.18 + (0.3 + 0.55 * pa.2) * sin(fr2 * 70 + 2638), 31.47 + (0.3 + 0.55 * pa.2) * sin(fr2 * 48 + 4158); line 160.53 + (0.3 + 0.55 * pa.2) * sin(fr2 * 66 + 4106), 30.43 + (0.3 + 0.55 * pa.2) * sin(fr2 * 57 + 3889); line 180.43 + (0.3 + 0.55 * pa.2) * sin(fr2 * 74 + 2189), 31.24 + (0.3 + 0.55 * pa.2) * sin(fr2 * 49 + 3807) }
            path { at: 0.4, 0.4; stroke: 0.9; color: deep; opacity: 18% * sh * (1 - pl); move 19.54 + (0.3 + 0.55 * pa.2) * sin(fr2 * 50 + 224), 31.51 + (0.3 + 0.55 * pa.2) * sin(fr2 * 66 + 715); line 40.33 + (0.3 + 0.55 * pa.2) * sin(fr2 * 61 + 1598), 30.77 + (0.3 + 0.55 * pa.2) * sin(fr2 * 72 + 483); line 60.37 + (0.3 + 0.55 * pa.2) * sin(fr2 * 41 + 348), 31.11 + (0.3 + 0.55 * pa.2) * sin(fr2 * 65 + 4922); line 79.81 + (0.3 + 0.55 * pa.2) * sin(fr2 * 75 + 2978), 30.85 + (0.3 + 0.55 * pa.2) * sin(fr2 * 75 + 3868); line 99.74 + (0.3 + 0.55 * pa.2) * sin(fr2 * 75 + 2483), 30.47 + (0.3 + 0.55 * pa.2) * sin(fr2 * 55 + 1370); line 119.83 + (0.3 + 0.55 * pa.2) * sin(fr2 * 72 + 3792), 30.74 + (0.3 + 0.55 * pa.2) * sin(fr2 * 72 + 4064); line 139.94 + (0.3 + 0.55 * pa.2) * sin(fr2 * 68 + 2013), 30.75 + (0.3 + 0.55 * pa.2) * sin(fr2 * 41 + 2876); line 160.51 + (0.3 + 0.55 * pa.2) * sin(fr2 * 74 + 2230), 30.54 + (0.3 + 0.55 * pa.2) * sin(fr2 * 73 + 3209); line 180.01 + (0.3 + 0.55 * pa.2) * sin(fr2 * 43 + 2769), 31.00 + (0.3 + 0.55 * pa.2) * sin(fr2 * 72 + 2887) }
