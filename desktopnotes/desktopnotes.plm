            repeat nc7 in 0..4 {
                let nx7 = if(mod(nc7, 2) == 0, -6, 206)
                let ny7 = if(nc7 < 2, -6, 174)
                let nsx7 = if(mod(nc7, 2) == 0, -1, 1)
