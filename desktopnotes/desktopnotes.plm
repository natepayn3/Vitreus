            //  Doodle: the close button is always there (the pencil's cross above shows only under the pointer, and not on plastic): a cream disc, a thick black ring and a cross.
        group {
            show: dd > 0.01
            opacity: dd * sh
            ellipse { at: if(f7 == 3, 16, 184), 13; radius: 10; color: #fffaf6 }
            ellipse { at: if(f7 == 3, 16, 184), 13; radius: 10; stroke: 2.4; color: ink }
            line { from: if(f7 == 3, 16, 184) - 3.6, 13 - 3.6; to: if(f7 == 3, 16, 184) + 3.6, 13 + 3.6; width: 2.4; color: ink }
            line { from: if(f7 == 3, 16, 184) - 3.6, 13 + 3.6; to: if(f7 == 3, 16, 184) + 3.6, 13 - 3.6; width: 2.4; color: ink }
        }
            text t7 { at: 20, 46; anchor: left top; size: 17; weight: 500; width: 160; lines: 5; color: mix(deep, ink, dd); family: "Space Grotesk"; show: eix != 7 and h7 }
            text "Click to write" { at: 20, 46; anchor: left top; size: 15; weight: 500; color: mix(deep, ink, dd); opacity: 45%; family: "Space Grotesk"; show: eix != 7 and not h7 }
        }
    }
    group {
        show: o8 and sh > 0.01
        move: lx8, ly8
        pivot: 100, 84
        rotate: -1.6deg
        z: sz8
        //  Its grab area and its cross are inside it, so that they stack with it (the one drawn on top is the one that is pressed where two overlap): the grab area a little larger than the paper,
        //  and a good deal larger while it is held, so that a quick pull cannot outrun it (it moves with the sticker, a frame behind).
        zone box zb8 { at: 100, 84; size: 212 + 600 * zb8.pressed, 180 + 600 * zb8.pressed; corner: 6; cursor: grab; active: o8 and sh > 0.5 }
        zone box zx8 { at: if(f8 == 3, 16, 184), 13; size: 26, 26; corner: 13; cursor: pointer; active: o8 and sh > 0.5 }
        //  The paper: an opaque sheet of one of the shell's colours warmed towards cream (not glass), almost square, with its bottom left corner folded over, a soft shadow, a piece of tape and faint
        //  ruled lines. In Retro and UwU it takes their outline and hard shadow like the rest.
        body {
            color: pp8
            rim: 0%
            border: (2 + 1.2 * uk + 2.2 * dd) * pl, mix(deep, ink, dd)
            shadow: 3 * pl, 4 - pl, 11 * (1 - pl) + 2, (36% + 40% * pl) * (1 - dd), mix(#000000, deep, pl)
            opacity: sh
            path { at: 0, 0; move 0, if(f8 == 2, 26, 0); line if(f8 == 2, 26, 0), 0; line if(f8 == 3, 174, 200), 0; line 200, if(f8 == 3, 26, 0); line 200, if(f8 == 1, 142, 168); line if(f8 == 1, 174, 200), 168; line if(f8 == 0, 26, 0), 168; line 0, if(f8 == 0, 142, 168); close }
        }
        body {
            color: mix(pp8, #ffffff, 0.45)
            rim: 0%
            shadow: 1, -1, 4, 28%
            opacity: sh
            path { at: 0, 0; move pick(f8, 0, 200, 0, 174), pick(f8, 142, 142, 26, 0); line pick(f8, 26, 174, 26, 200), pick(f8, 168, 168, 0, 26); line pick(f8, 26, 174, 26, 174), pick(f8, 142, 142, 26, 26); close }
        }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; color: #efe9cc; opacity: 62% * sh }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; stroke: 0.8; color: deep; opacity: 14% * sh }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 65.38 + (0.25 + 0.4 * pa.8) * sin(fr8 * 40 + 4860); line 100, 66.46 + (0.25 + 0.4 * pa.8) * sin(fr8 * 58 + 2063); line 186, 66.17 + (0.25 + 0.4 * pa.8) * sin(fr8 * 60 + 194) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 87.43 + (0.25 + 0.4 * pa.8) * sin(fr8 * 51 + 4693); line 100, 87.08 + (0.25 + 0.4 * pa.8) * sin(fr8 * 73 + 2853); line 186, 86.47 + (0.25 + 0.4 * pa.8) * sin(fr8 * 67 + 4158) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 107.70 + (0.25 + 0.4 * pa.8) * sin(fr8 * 48 + 2030); line 100, 107.57 + (0.25 + 0.4 * pa.8) * sin(fr8 * 47 + 2164); line 186, 108.00 + (0.25 + 0.4 * pa.8) * sin(fr8 * 44 + 3061) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 128.19 + (0.25 + 0.4 * pa.8) * sin(fr8 * 53 + 3124); line 100, 129.22 + (0.25 + 0.4 * pa.8) * sin(fr8 * 41 + 3033); line 186, 129.06 + (0.25 + 0.4 * pa.8) * sin(fr8 * 68 + 1528) }
        //  The Cyber's HUD marks (as on its drawers, bar_glass.plm): a neon hairline and bright corner brackets 6 px outside the sticker.
        group {
            show: cyk > 0.01
            opacity: cyk * sh
            box { from: 0, 0; size: 200, 168; corner: 22 * (1 - 0.73 * cyk); stroke: 1.1; color: mint; opacity: 38% }
            repeat nc8 in 0..4 {
                let nx8 = if(mod(nc8, 2) == 0, -6, 206)
                let ny8 = if(nc8 < 2, -6, 174)
                let nsx8 = if(mod(nc8, 2) == 0, -1, 1)
                let nsy8 = if(nc8 < 2, -1, 1)
                path { at: nx8, ny8; stroke: 5; color: mint; opacity: 16%; move 0, -nsy8 * 13; line 0, 0; line -nsx8 * 13, 0 }
                path { at: nx8, ny8; stroke: 1.7; color: minthi; move 0, -nsy8 * 13; line 0, 0; line -nsx8 * 13, 0 }
            }
        }
        group {
            opacity: sh
            path { at: 0, 0; stroke: 1.3; color: deep; opacity: 40% * sh * (1 - pl); move 20.04 + (0.3 + 0.55 * pa.8) * sin(fr8 * 53 + 2405), 31.12 + (0.3 + 0.55 * pa.8) * sin(fr8 * 64 + 2643); line 40.11 + (0.3 + 0.55 * pa.8) * sin(fr8 * 40 + 2871), 31.54 + (0.3 + 0.55 * pa.8) * sin(fr8 * 75 + 3271); line 59.87 + (0.3 + 0.55 * pa.8) * sin(fr8 * 51 + 2531), 30.75 + (0.3 + 0.55 * pa.8) * sin(fr8 * 72 + 1343); line 80.32 + (0.3 + 0.55 * pa.8) * sin(fr8 * 41 + 4655), 31.19 + (0.3 + 0.55 * pa.8) * sin(fr8 * 66 + 1357); line 99.69 + (0.3 + 0.55 * pa.8) * sin(fr8 * 56 + 4252), 30.49 + (0.3 + 0.55 * pa.8) * sin(fr8 * 45 + 417); line 119.73 + (0.3 + 0.55 * pa.8) * sin(fr8 * 56 + 3217), 30.64 + (0.3 + 0.55 * pa.8) * sin(fr8 * 41 + 1463); line 139.89 + (0.3 + 0.55 * pa.8) * sin(fr8 * 75 + 3471), 30.73 + (0.3 + 0.55 * pa.8) * sin(fr8 * 40 + 2365); line 159.58 + (0.3 + 0.55 * pa.8) * sin(fr8 * 43 + 4508), 30.75 + (0.3 + 0.55 * pa.8) * sin(fr8 * 52 + 622); line 179.65 + (0.3 + 0.55 * pa.8) * sin(fr8 * 74 + 623), 31.56 + (0.3 + 0.55 * pa.8) * sin(fr8 * 56 + 4649) }
