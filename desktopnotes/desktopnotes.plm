        group {
            show: dd > 0.01
            opacity: dd * sh
            ellipse { at: if(f6 == 3, 16, 184), 13; radius: 10; color: #fffaf6 }
            ellipse { at: if(f6 == 3, 16, 184), 13; radius: 10; stroke: 2.4; color: ink }
            line { from: if(f6 == 3, 16, 184) - 3.6, 13 - 3.6; to: if(f6 == 3, 16, 184) + 3.6, 13 + 3.6; width: 2.4; color: ink }
            line { from: if(f6 == 3, 16, 184) - 3.6, 13 + 3.6; to: if(f6 == 3, 16, 184) + 3.6, 13 - 3.6; width: 2.4; color: ink }
        }
            text t6 { at: 20, 46; anchor: left top; size: 17; weight: 500; width: 160; lines: 5; color: mix(deep, ink, dd); family: "Space Grotesk"; show: eix != 6 and h6 }
            text "Click to write" { at: 20, 46; anchor: left top; size: 15; weight: 500; color: mix(deep, ink, dd); opacity: 45%; family: "Space Grotesk"; show: eix != 6 and not h6 }
        }
    }
    group {
        show: o7 and sh > 0.01
        move: lx7, ly7
        pivot: 100, 84
        rotate: 1.4deg
        z: sz7
        //  Its grab area and its cross are inside it, so that they stack with it (the one drawn on top is the one that is pressed where two overlap): the grab area a little larger than the paper,
        //  and a good deal larger while it is held, so that a quick pull cannot outrun it (it moves with the sticker, a frame behind).
        zone box zb7 { at: 100, 84; size: 212 + 600 * zb7.pressed, 180 + 600 * zb7.pressed; corner: 6; cursor: grab; active: o7 and sh > 0.5 }
        zone box zx7 { at: if(f7 == 3, 16, 184), 13; size: 26, 26; corner: 13; cursor: pointer; active: o7 and sh > 0.5 }
        //  The paper: an opaque sheet of one of the shell's colours warmed towards cream (not glass), almost square, with its bottom left corner folded over, a soft shadow, a piece of tape and faint
        //  ruled lines. In Retro and UwU it takes their outline and hard shadow like the rest.
        body {
            color: pp7
            rim: 0%
            border: (2 + 1.2 * uk + 2.2 * dd) * pl, mix(deep, ink, dd)
            shadow: 3 * pl, 4 - pl, 11 * (1 - pl) + 2, (36% + 40% * pl) * (1 - dd), mix(#000000, deep, pl)
            opacity: sh
            path { at: 0, 0; move 0, if(f7 == 2, 26, 0); line if(f7 == 2, 26, 0), 0; line if(f7 == 3, 174, 200), 0; line 200, if(f7 == 3, 26, 0); line 200, if(f7 == 1, 142, 168); line if(f7 == 1, 174, 200), 168; line if(f7 == 0, 26, 0), 168; line 0, if(f7 == 0, 142, 168); close }
        }
        body {
            color: mix(pp7, #ffffff, 0.45)
            rim: 0%
            shadow: 1, -1, 4, 28%
            opacity: sh
            path { at: 0, 0; move pick(f7, 0, 200, 0, 174), pick(f7, 142, 142, 26, 0); line pick(f7, 26, 174, 26, 200), pick(f7, 168, 168, 0, 26); line pick(f7, 26, 174, 26, 174), pick(f7, 142, 142, 26, 26); close }
        }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; color: #efe9cc; opacity: 62% * sh }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; stroke: 0.8; color: deep; opacity: 14% * sh }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 66.14 + (0.25 + 0.4 * pa.7) * sin(fr7 * 48 + 2923); line 100, 65.79 + (0.25 + 0.4 * pa.7) * sin(fr7 * 72 + 3085); line 186, 66.78 + (0.25 + 0.4 * pa.7) * sin(fr7 * 72 + 1637) }
