            opacity: cyk * sh
            box { from: 0, 0; size: 200, 168; corner: 22 * (1 - 0.73 * cyk); stroke: 1.1; color: mint; opacity: 38% }
            repeat nc1 in 0..4 {
                let nx1 = if(mod(nc1, 2) == 0, -6, 206)
                let ny1 = if(nc1 < 2, -6, 174)
                let nsx1 = if(mod(nc1, 2) == 0, -1, 1)
                let nsy1 = if(nc1 < 2, -1, 1)
                path { at: nx1, ny1; stroke: 5; color: mint; opacity: 16%; move 0, -nsy1 * 13; line 0, 0; line -nsx1 * 13, 0 }
                path { at: nx1, ny1; stroke: 1.7; color: minthi; move 0, -nsy1 * 13; line 0, 0; line -nsx1 * 13, 0 }
