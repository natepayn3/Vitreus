        group {
            show: dd > 0.01
            opacity: dd * sh
            ellipse { at: if(f12 == 3, 16, 184), 13; radius: 10; color: #fffaf6 }
            ellipse { at: if(f12 == 3, 16, 184), 13; radius: 10; stroke: 2.4; color: ink }
            line { from: if(f12 == 3, 16, 184) - 3.6, 13 - 3.6; to: if(f12 == 3, 16, 184) + 3.6, 13 + 3.6; width: 2.4; color: ink }
            line { from: if(f12 == 3, 16, 184) - 3.6, 13 + 3.6; to: if(f12 == 3, 16, 184) + 3.6, 13 - 3.6; width: 2.4; color: ink }
        }
