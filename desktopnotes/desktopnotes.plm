language 0.1
import "../palette.plm"

//  The desktop stickers: sticky notes that stay on the desktop, glass on the bottom layer (above the wallpaper, under every window). Each one is its own little pane of glass, tinted with one of the shell's colours: drag it
//  (by the strip along its top or anywhere on it) all over the desktop, onto another monitor too; click it to write on it (a line or two: Enter keeps what is typed, Escape lets it be);
//  the cross in its corner takes it away. New ones come from the desktop's right-click menu ("New sticky note") or the launcher ("Sticky note: new"); up to sixteen. They stay
//  where they were put, from one session to the next.
//
//  (They sit on the bottom layer, under the windows, like the clock and the system monitor. Two things lift the surface to the top layer: pleamar-wm, where a bottom-layer surface hears no
//  mouse (`pwm`, which Vitreus knows), and a sticker being written on (`eix >= 0`), because only a surface above the windows can be given the keyboard. Only the stickers take the pointer either way.)
//  The scene is one surface a monitor, each as big as it, and only the stickers take the pointer. Where a sticker is is kept in the desktop's own coordinates (all the monitors'
//  together, `gx`, `gy`), and each monitor draws the part of that which falls on it: the logic tells the scene where the monitors lie (`m0x` and the rest, from `hyprctl monitors`).
//
//  Turn them on or off with   pleamar --say desktopnotes "fact shown true"   (or false); "Desktop notes: toggle" in the launcher does it, and starts it if it is not running.
//  Its settings are kept in desktopnotes.json and the stickers in desktopnotes-stickers.json, in ~/.local/share/pleamar/desktopnotes (see desktopnotes.luau).

scene DesktopNotes {
    surface { size: full, full; anchor: top_left; margin: 0; level: bottom, top while edit or eix >= 0; screens: each; reserve: -1; keyboard: exclusive while eix >= 0 }

    permissions { services: "files", "files.write"; run: "pleamar", "hyprctl", "socat", "printenv" }

    fact shown = false     // the logic sets it from desktopnotes.json (so that `sh` follows it from nothing)
    fact cli = 1           // the glass: 0 clear, 1 soft, 2 full
    fact pwm = false       // the session is pleamar-wm (asked of Vitreus: `wm_pwm`): there the surface has to be on top to hear the mouse
    fact edit = false      // the desktop editor is open (desktopedit says so): the stickers come above the windows to be moved, written on or taken away; otherwise they stay under them
    fact obs = false       // Vitreus has its glass off (Vitreus says so with `fact obs true`): the stickers are flat obsidian
    fact nmon = 0          // a new sticker is asked for: on which monitor, and where in it (-1 for the middle)
    fact nx = -1
    fact ny = -1

    //  Where the monitors lie in the desktop (logical pixels), up to four, and the box all of them make together.
    fact mcount = 1
    fact m0x = 0
    fact m0y = 0
    fact m1x = 0
    fact m1y = 0
    fact m2x = 0
    fact m2y = 0
    fact m3x = 0
    fact m3y = 0
    fact vx0 = 0
    fact vy0 = 0
    fact vx1 = 1920
    fact vy1 = 1080

    fact sel = -1          // the sticker being held (a press goes only to the topmost one under the pointer; the others do not move)
    fact ztop = 0          // the highest stacking order given so far: the sticker pressed (or made) takes the next one and comes to the front
    fact eix = -1          // the sticker being written on, -1 for none
    text ei = ""           // what is typed
    fact bx = 0            // where the sticker being dragged was when the drag began
    fact by = 0
    event note_new ->
    event note_del ->      // a sticker, by place
    event note_commit ->   // Enter in the field

    prop sh = 0 ~calm
    follow sh = if(shown, 1, 0)
    prop ob = 0 ~calm
    follow ob = if(obs or look == 1 or look == 2 or look == 7, 1, 0)
    fact look = 0           // the shell's theme (Vitreus says so): 0 Glass, 1 Retro, 2 UwU; the last two draw the stickers as plastic, like the bar (outline, hard shadow)
    prop pl = 0 ~calm
    follow pl = if(look == 1 or look == 2 or look == 7, 1, 0)
    prop dd = 0 ~calm
    follow dd = if(look == 7, 1, 0)         // Doodle: thick black outline, no hard shadow
    prop uk = 0 ~calm
    follow uk = if(look == 2, 1, 0)
    prop cyk = 0 ~calm
    follow cyk = if(look == 3, 1, 0)       // Cyber is glass with its HUD marks on top (corner brackets, a hairline) and squarer corners, as on the bar's drawers
    prop time = 0           // the pencil's own clock: it only runs while a sticker is hot (hovered or being written on), so the scene rests the rest of the time (`spin`, below)
    let clr = if(cli == 0, 55%, if(cli == 1, 80%, 100%))
    let mi = clamp(screen.index, 0, 3)
    let ox = pick(mi, m0x, m1x, m2x, m3x)     // where this monitor's top left is in the desktop
    let oy = pick(mi, m0y, m1y, m2y, m3y)

    on key Escape while eix >= 0 { eix = -1 }
    //  (The keyboard is asked for only while a sticker is being written on (`eix >= 0`), and let go at Enter or Escape: pleamar-wm does not hand it over on a click, so `on_demand` left typing dead until the next login. A sticker is
    //  written on only after it is clicked, which is what hands the keyboard over.)
    on submit ei { emit note_commit }

    //  ── sticker 0 ──
    fact o0 = false      // there is one
    fact h0 = false      // it has writing
    fact gx0 = 0         // its top left in the desktop
    fact gy0 = 0
    fact c0 = 0          // its paper: 0 yellow, 1 pink, 2 green, 3 blue, 4 orange, 5 violet
    fact f0 = 0          // its folded corner: 0 bottom left, 1 bottom right, 2 top left, 3 top right (picked when it is made; with the top right folded its cross is at the top left)
    fact sz0 = 0         // its stacking order: the larger, the nearer the front
    text t0 = ""
    let lx0 = gx0 - ox
    let ly0 = gy0 - oy
    on press zb0 while pointer.x >= lx0 and pointer.x <= lx0 + 200 and pointer.y >= ly0 and pointer.y <= ly0 + 168 and not ((o1 and pointer.x >= lx1 and pointer.x <= lx1 + 200 and pointer.y >= ly1 and pointer.y <= ly1 + 168 and (sz1 > sz0 or (sz1 == sz0 and 1 > 0))) or (o2 and pointer.x >= lx2 and pointer.x <= lx2 + 200 and pointer.y >= ly2 and pointer.y <= ly2 + 168 and (sz2 > sz0 or (sz2 == sz0 and 2 > 0))) or (o3 and pointer.x >= lx3 and pointer.x <= lx3 + 200 and pointer.y >= ly3 and pointer.y <= ly3 + 168 and (sz3 > sz0 or (sz3 == sz0 and 3 > 0))) or (o4 and pointer.x >= lx4 and pointer.x <= lx4 + 200 and pointer.y >= ly4 and pointer.y <= ly4 + 168 and (sz4 > sz0 or (sz4 == sz0 and 4 > 0))) or (o5 and pointer.x >= lx5 and pointer.x <= lx5 + 200 and pointer.y >= ly5 and pointer.y <= ly5 + 168 and (sz5 > sz0 or (sz5 == sz0 and 5 > 0))) or (o6 and pointer.x >= lx6 and pointer.x <= lx6 + 200 and pointer.y >= ly6 and pointer.y <= ly6 + 168 and (sz6 > sz0 or (sz6 == sz0 and 6 > 0))) or (o7 and pointer.x >= lx7 and pointer.x <= lx7 + 200 and pointer.y >= ly7 and pointer.y <= ly7 + 168 and (sz7 > sz0 or (sz7 == sz0 and 7 > 0))) or (o8 and pointer.x >= lx8 and pointer.x <= lx8 + 200 and pointer.y >= ly8 and pointer.y <= ly8 + 168 and (sz8 > sz0 or (sz8 == sz0 and 8 > 0))) or (o9 and pointer.x >= lx9 and pointer.x <= lx9 + 200 and pointer.y >= ly9 and pointer.y <= ly9 + 168 and (sz9 > sz0 or (sz9 == sz0 and 9 > 0))) or (o10 and pointer.x >= lx10 and pointer.x <= lx10 + 200 and pointer.y >= ly10 and pointer.y <= ly10 + 168 and (sz10 > sz0 or (sz10 == sz0 and 10 > 0))) or (o11 and pointer.x >= lx11 and pointer.x <= lx11 + 200 and pointer.y >= ly11 and pointer.y <= ly11 + 168 and (sz11 > sz0 or (sz11 == sz0 and 11 > 0))) or (o12 and pointer.x >= lx12 and pointer.x <= lx12 + 200 and pointer.y >= ly12 and pointer.y <= ly12 + 168 and (sz12 > sz0 or (sz12 == sz0 and 12 > 0))) or (o13 and pointer.x >= lx13 and pointer.x <= lx13 + 200 and pointer.y >= ly13 and pointer.y <= ly13 + 168 and (sz13 > sz0 or (sz13 == sz0 and 13 > 0))) or (o14 and pointer.x >= lx14 and pointer.x <= lx14 + 200 and pointer.y >= ly14 and pointer.y <= ly14 + 168 and (sz14 > sz0 or (sz14 == sz0 and 14 > 0))) or (o15 and pointer.x >= lx15 and pointer.x <= lx15 + 200 and pointer.y >= ly15 and pointer.y <= ly15 + 168 and (sz15 > sz0 or (sz15 == sz0 and 15 > 0)))) { sel = 0; bx = gx0; by = gy0; sz0 = ztop + 1; ztop = ztop + 1 }
    //  A right click does nothing here, on purpose: a scene that never names the right button is closed by one (pleamar's way out of a prototype with no
    //  keyboard), and the keeper starts it again a moment later, out of Edit mode: the widget went away and came back stuck.
    on press right zb0 { }
    on drag zb0 while sel == 0 { gx0 = clamp(bx + drag.dx, vx0, max(vx0, vx1 - 200)); gy0 = clamp(by + drag.dy, vy0, max(vy0, vy1 - 168)) }
    on release zb0 while sel == 0 and abs(gx0 - bx) + abs(gy0 - by) < 6 { eix = 0; focus ei }
    on release zb0 while sel == 0 { sel = -1 }
    on press zx0 while pointer.x >= lx0 and pointer.x <= lx0 + 200 and pointer.y >= ly0 and pointer.y <= ly0 + 168 and not ((o1 and pointer.x >= lx1 and pointer.x <= lx1 + 200 and pointer.y >= ly1 and pointer.y <= ly1 + 168 and (sz1 > sz0 or (sz1 == sz0 and 1 > 0))) or (o2 and pointer.x >= lx2 and pointer.x <= lx2 + 200 and pointer.y >= ly2 and pointer.y <= ly2 + 168 and (sz2 > sz0 or (sz2 == sz0 and 2 > 0))) or (o3 and pointer.x >= lx3 and pointer.x <= lx3 + 200 and pointer.y >= ly3 and pointer.y <= ly3 + 168 and (sz3 > sz0 or (sz3 == sz0 and 3 > 0))) or (o4 and pointer.x >= lx4 and pointer.x <= lx4 + 200 and pointer.y >= ly4 and pointer.y <= ly4 + 168 and (sz4 > sz0 or (sz4 == sz0 and 4 > 0))) or (o5 and pointer.x >= lx5 and pointer.x <= lx5 + 200 and pointer.y >= ly5 and pointer.y <= ly5 + 168 and (sz5 > sz0 or (sz5 == sz0 and 5 > 0))) or (o6 and pointer.x >= lx6 and pointer.x <= lx6 + 200 and pointer.y >= ly6 and pointer.y <= ly6 + 168 and (sz6 > sz0 or (sz6 == sz0 and 6 > 0))) or (o7 and pointer.x >= lx7 and pointer.x <= lx7 + 200 and pointer.y >= ly7 and pointer.y <= ly7 + 168 and (sz7 > sz0 or (sz7 == sz0 and 7 > 0))) or (o8 and pointer.x >= lx8 and pointer.x <= lx8 + 200 and pointer.y >= ly8 and pointer.y <= ly8 + 168 and (sz8 > sz0 or (sz8 == sz0 and 8 > 0))) or (o9 and pointer.x >= lx9 and pointer.x <= lx9 + 200 and pointer.y >= ly9 and pointer.y <= ly9 + 168 and (sz9 > sz0 or (sz9 == sz0 and 9 > 0))) or (o10 and pointer.x >= lx10 and pointer.x <= lx10 + 200 and pointer.y >= ly10 and pointer.y <= ly10 + 168 and (sz10 > sz0 or (sz10 == sz0 and 10 > 0))) or (o11 and pointer.x >= lx11 and pointer.x <= lx11 + 200 and pointer.y >= ly11 and pointer.y <= ly11 + 168 and (sz11 > sz0 or (sz11 == sz0 and 11 > 0))) or (o12 and pointer.x >= lx12 and pointer.x <= lx12 + 200 and pointer.y >= ly12 and pointer.y <= ly12 + 168 and (sz12 > sz0 or (sz12 == sz0 and 12 > 0))) or (o13 and pointer.x >= lx13 and pointer.x <= lx13 + 200 and pointer.y >= ly13 and pointer.y <= ly13 + 168 and (sz13 > sz0 or (sz13 == sz0 and 13 > 0))) or (o14 and pointer.x >= lx14 and pointer.x <= lx14 + 200 and pointer.y >= ly14 and pointer.y <= ly14 + 168 and (sz14 > sz0 or (sz14 == sz0 and 14 > 0))) or (o15 and pointer.x >= lx15 and pointer.x <= lx15 + 200 and pointer.y >= ly15 and pointer.y <= ly15 + 168 and (sz15 > sz0 or (sz15 == sz0 and 15 > 0)))) { emit note_del(0) }
    prop pa.0 = 0 ~calm              // how hot it is: the pencil redraws about five times a second while it is
    let fr0 = if(pa.0 > 0.02, floor(time * 5), 0)
    let pp0 = mix(mix(#fbf4da, pick(c0, mint, alert, mintlo, ink, minthi, panel), 0.4), pick(c0, #fcd77f, #f4b6c8, #b5d99c, #aebfef, #f9c08a, #c9b6e8), dd)      // its paper: cream warmed towards its colour
    //  ── sticker 1 ──
    fact o1 = false      // there is one
    fact h1 = false      // it has writing
    fact gx1 = 0         // its top left in the desktop
    fact gy1 = 0
    fact c1 = 0          // its paper: 0 yellow, 1 pink, 2 green, 3 blue, 4 orange, 5 violet
    fact f1 = 0          // its folded corner: 0 bottom left, 1 bottom right, 2 top left, 3 top right (picked when it is made; with the top right folded its cross is at the top left)
    fact sz1 = 0         // its stacking order: the larger, the nearer the front
    text t1 = ""
    let lx1 = gx1 - ox
    let ly1 = gy1 - oy
    on press zb1 while pointer.x >= lx1 and pointer.x <= lx1 + 200 and pointer.y >= ly1 and pointer.y <= ly1 + 168 and not ((o0 and pointer.x >= lx0 and pointer.x <= lx0 + 200 and pointer.y >= ly0 and pointer.y <= ly0 + 168 and (sz0 > sz1 or (sz0 == sz1 and 0 > 1))) or (o2 and pointer.x >= lx2 and pointer.x <= lx2 + 200 and pointer.y >= ly2 and pointer.y <= ly2 + 168 and (sz2 > sz1 or (sz2 == sz1 and 2 > 1))) or (o3 and pointer.x >= lx3 and pointer.x <= lx3 + 200 and pointer.y >= ly3 and pointer.y <= ly3 + 168 and (sz3 > sz1 or (sz3 == sz1 and 3 > 1))) or (o4 and pointer.x >= lx4 and pointer.x <= lx4 + 200 and pointer.y >= ly4 and pointer.y <= ly4 + 168 and (sz4 > sz1 or (sz4 == sz1 and 4 > 1))) or (o5 and pointer.x >= lx5 and pointer.x <= lx5 + 200 and pointer.y >= ly5 and pointer.y <= ly5 + 168 and (sz5 > sz1 or (sz5 == sz1 and 5 > 1))) or (o6 and pointer.x >= lx6 and pointer.x <= lx6 + 200 and pointer.y >= ly6 and pointer.y <= ly6 + 168 and (sz6 > sz1 or (sz6 == sz1 and 6 > 1))) or (o7 and pointer.x >= lx7 and pointer.x <= lx7 + 200 and pointer.y >= ly7 and pointer.y <= ly7 + 168 and (sz7 > sz1 or (sz7 == sz1 and 7 > 1))) or (o8 and pointer.x >= lx8 and pointer.x <= lx8 + 200 and pointer.y >= ly8 and pointer.y <= ly8 + 168 and (sz8 > sz1 or (sz8 == sz1 and 8 > 1))) or (o9 and pointer.x >= lx9 and pointer.x <= lx9 + 200 and pointer.y >= ly9 and pointer.y <= ly9 + 168 and (sz9 > sz1 or (sz9 == sz1 and 9 > 1))) or (o10 and pointer.x >= lx10 and pointer.x <= lx10 + 200 and pointer.y >= ly10 and pointer.y <= ly10 + 168 and (sz10 > sz1 or (sz10 == sz1 and 10 > 1))) or (o11 and pointer.x >= lx11 and pointer.x <= lx11 + 200 and pointer.y >= ly11 and pointer.y <= ly11 + 168 and (sz11 > sz1 or (sz11 == sz1 and 11 > 1))) or (o12 and pointer.x >= lx12 and pointer.x <= lx12 + 200 and pointer.y >= ly12 and pointer.y <= ly12 + 168 and (sz12 > sz1 or (sz12 == sz1 and 12 > 1))) or (o13 and pointer.x >= lx13 and pointer.x <= lx13 + 200 and pointer.y >= ly13 and pointer.y <= ly13 + 168 and (sz13 > sz1 or (sz13 == sz1 and 13 > 1))) or (o14 and pointer.x >= lx14 and pointer.x <= lx14 + 200 and pointer.y >= ly14 and pointer.y <= ly14 + 168 and (sz14 > sz1 or (sz14 == sz1 and 14 > 1))) or (o15 and pointer.x >= lx15 and pointer.x <= lx15 + 200 and pointer.y >= ly15 and pointer.y <= ly15 + 168 and (sz15 > sz1 or (sz15 == sz1 and 15 > 1)))) { sel = 1; bx = gx1; by = gy1; sz1 = ztop + 1; ztop = ztop + 1 }
    on drag zb1 while sel == 1 { gx1 = clamp(bx + drag.dx, vx0, max(vx0, vx1 - 200)); gy1 = clamp(by + drag.dy, vy0, max(vy0, vy1 - 168)) }
    on release zb1 while sel == 1 and abs(gx1 - bx) + abs(gy1 - by) < 6 { eix = 1; focus ei }
    on release zb1 while sel == 1 { sel = -1 }
    on press zx1 while pointer.x >= lx1 and pointer.x <= lx1 + 200 and pointer.y >= ly1 and pointer.y <= ly1 + 168 and not ((o0 and pointer.x >= lx0 and pointer.x <= lx0 + 200 and pointer.y >= ly0 and pointer.y <= ly0 + 168 and (sz0 > sz1 or (sz0 == sz1 and 0 > 1))) or (o2 and pointer.x >= lx2 and pointer.x <= lx2 + 200 and pointer.y >= ly2 and pointer.y <= ly2 + 168 and (sz2 > sz1 or (sz2 == sz1 and 2 > 1))) or (o3 and pointer.x >= lx3 and pointer.x <= lx3 + 200 and pointer.y >= ly3 and pointer.y <= ly3 + 168 and (sz3 > sz1 or (sz3 == sz1 and 3 > 1))) or (o4 and pointer.x >= lx4 and pointer.x <= lx4 + 200 and pointer.y >= ly4 and pointer.y <= ly4 + 168 and (sz4 > sz1 or (sz4 == sz1 and 4 > 1))) or (o5 and pointer.x >= lx5 and pointer.x <= lx5 + 200 and pointer.y >= ly5 and pointer.y <= ly5 + 168 and (sz5 > sz1 or (sz5 == sz1 and 5 > 1))) or (o6 and pointer.x >= lx6 and pointer.x <= lx6 + 200 and pointer.y >= ly6 and pointer.y <= ly6 + 168 and (sz6 > sz1 or (sz6 == sz1 and 6 > 1))) or (o7 and pointer.x >= lx7 and pointer.x <= lx7 + 200 and pointer.y >= ly7 and pointer.y <= ly7 + 168 and (sz7 > sz1 or (sz7 == sz1 and 7 > 1))) or (o8 and pointer.x >= lx8 and pointer.x <= lx8 + 200 and pointer.y >= ly8 and pointer.y <= ly8 + 168 and (sz8 > sz1 or (sz8 == sz1 and 8 > 1))) or (o9 and pointer.x >= lx9 and pointer.x <= lx9 + 200 and pointer.y >= ly9 and pointer.y <= ly9 + 168 and (sz9 > sz1 or (sz9 == sz1 and 9 > 1))) or (o10 and pointer.x >= lx10 and pointer.x <= lx10 + 200 and pointer.y >= ly10 and pointer.y <= ly10 + 168 and (sz10 > sz1 or (sz10 == sz1 and 10 > 1))) or (o11 and pointer.x >= lx11 and pointer.x <= lx11 + 200 and pointer.y >= ly11 and pointer.y <= ly11 + 168 and (sz11 > sz1 or (sz11 == sz1 and 11 > 1))) or (o12 and pointer.x >= lx12 and pointer.x <= lx12 + 200 and pointer.y >= ly12 and pointer.y <= ly12 + 168 and (sz12 > sz1 or (sz12 == sz1 and 12 > 1))) or (o13 and pointer.x >= lx13 and pointer.x <= lx13 + 200 and pointer.y >= ly13 and pointer.y <= ly13 + 168 and (sz13 > sz1 or (sz13 == sz1 and 13 > 1))) or (o14 and pointer.x >= lx14 and pointer.x <= lx14 + 200 and pointer.y >= ly14 and pointer.y <= ly14 + 168 and (sz14 > sz1 or (sz14 == sz1 and 14 > 1))) or (o15 and pointer.x >= lx15 and pointer.x <= lx15 + 200 and pointer.y >= ly15 and pointer.y <= ly15 + 168 and (sz15 > sz1 or (sz15 == sz1 and 15 > 1)))) { emit note_del(1) }
    prop pa.1 = 0 ~calm              // how hot it is: the pencil redraws about five times a second while it is
    let fr1 = if(pa.1 > 0.02, floor(time * 5), 0)
    let pp1 = mix(mix(#fbf4da, pick(c1, mint, alert, mintlo, ink, minthi, panel), 0.4), pick(c1, #fcd77f, #f4b6c8, #b5d99c, #aebfef, #f9c08a, #c9b6e8), dd)      // its paper: cream warmed towards its colour
    //  ── sticker 2 ──
    fact o2 = false      // there is one
    fact h2 = false      // it has writing
    fact gx2 = 0         // its top left in the desktop
    fact gy2 = 0
    fact c2 = 0          // its paper: 0 yellow, 1 pink, 2 green, 3 blue, 4 orange, 5 violet
    fact f2 = 0          // its folded corner: 0 bottom left, 1 bottom right, 2 top left, 3 top right (picked when it is made; with the top right folded its cross is at the top left)
    fact sz2 = 0         // its stacking order: the larger, the nearer the front
    text t2 = ""
    let lx2 = gx2 - ox
    let ly2 = gy2 - oy
    on press zb2 while pointer.x >= lx2 and pointer.x <= lx2 + 200 and pointer.y >= ly2 and pointer.y <= ly2 + 168 and not ((o0 and pointer.x >= lx0 and pointer.x <= lx0 + 200 and pointer.y >= ly0 and pointer.y <= ly0 + 168 and (sz0 > sz2 or (sz0 == sz2 and 0 > 2))) or (o1 and pointer.x >= lx1 and pointer.x <= lx1 + 200 and pointer.y >= ly1 and pointer.y <= ly1 + 168 and (sz1 > sz2 or (sz1 == sz2 and 1 > 2))) or (o3 and pointer.x >= lx3 and pointer.x <= lx3 + 200 and pointer.y >= ly3 and pointer.y <= ly3 + 168 and (sz3 > sz2 or (sz3 == sz2 and 3 > 2))) or (o4 and pointer.x >= lx4 and pointer.x <= lx4 + 200 and pointer.y >= ly4 and pointer.y <= ly4 + 168 and (sz4 > sz2 or (sz4 == sz2 and 4 > 2))) or (o5 and pointer.x >= lx5 and pointer.x <= lx5 + 200 and pointer.y >= ly5 and pointer.y <= ly5 + 168 and (sz5 > sz2 or (sz5 == sz2 and 5 > 2))) or (o6 and pointer.x >= lx6 and pointer.x <= lx6 + 200 and pointer.y >= ly6 and pointer.y <= ly6 + 168 and (sz6 > sz2 or (sz6 == sz2 and 6 > 2))) or (o7 and pointer.x >= lx7 and pointer.x <= lx7 + 200 and pointer.y >= ly7 and pointer.y <= ly7 + 168 and (sz7 > sz2 or (sz7 == sz2 and 7 > 2))) or (o8 and pointer.x >= lx8 and pointer.x <= lx8 + 200 and pointer.y >= ly8 and pointer.y <= ly8 + 168 and (sz8 > sz2 or (sz8 == sz2 and 8 > 2))) or (o9 and pointer.x >= lx9 and pointer.x <= lx9 + 200 and pointer.y >= ly9 and pointer.y <= ly9 + 168 and (sz9 > sz2 or (sz9 == sz2 and 9 > 2))) or (o10 and pointer.x >= lx10 and pointer.x <= lx10 + 200 and pointer.y >= ly10 and pointer.y <= ly10 + 168 and (sz10 > sz2 or (sz10 == sz2 and 10 > 2))) or (o11 and pointer.x >= lx11 and pointer.x <= lx11 + 200 and pointer.y >= ly11 and pointer.y <= ly11 + 168 and (sz11 > sz2 or (sz11 == sz2 and 11 > 2))) or (o12 and pointer.x >= lx12 and pointer.x <= lx12 + 200 and pointer.y >= ly12 and pointer.y <= ly12 + 168 and (sz12 > sz2 or (sz12 == sz2 and 12 > 2))) or (o13 and pointer.x >= lx13 and pointer.x <= lx13 + 200 and pointer.y >= ly13 and pointer.y <= ly13 + 168 and (sz13 > sz2 or (sz13 == sz2 and 13 > 2))) or (o14 and pointer.x >= lx14 and pointer.x <= lx14 + 200 and pointer.y >= ly14 and pointer.y <= ly14 + 168 and (sz14 > sz2 or (sz14 == sz2 and 14 > 2))) or (o15 and pointer.x >= lx15 and pointer.x <= lx15 + 200 and pointer.y >= ly15 and pointer.y <= ly15 + 168 and (sz15 > sz2 or (sz15 == sz2 and 15 > 2)))) { sel = 2; bx = gx2; by = gy2; sz2 = ztop + 1; ztop = ztop + 1 }
    on drag zb2 while sel == 2 { gx2 = clamp(bx + drag.dx, vx0, max(vx0, vx1 - 200)); gy2 = clamp(by + drag.dy, vy0, max(vy0, vy1 - 168)) }
    on release zb2 while sel == 2 and abs(gx2 - bx) + abs(gy2 - by) < 6 { eix = 2; focus ei }
    on release zb2 while sel == 2 { sel = -1 }
