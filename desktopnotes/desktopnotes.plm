            text "Click to write" { at: 20, 46; anchor: left top; size: 15; weight: 500; color: ink; opacity: 50%; family: "Space Grotesk"; shadow: 0, 1, 5, 70%; show: eix != 13 and not h13 }
        }
    }
    group {
        show: o14 and sh > 0.01
        move: lx14, ly14
        body {
            color: tint
            glass: 1
            lens: false
            rim: 70%
            shine: 0, 0
            shadow: 0, 6, 18, 30%
            opacity: sh * clr * (1 - ob)
            show: ob < 0.996
            box { from: 0, 0; size: 200, 168; corner: 22 }
        }
        //  Obsidian (Vitreus has its glass off): the same shape as a flat, dark piece.
        body {
            color: mix(mix(tint, #000000, 0.7), ink, 0.3)
            rim: 0%
            opacity: sh * ob
            shadow: 0, 6, 18, 45%, #000000
            show: ob > 0.004
            box { from: 0, 0; size: 200, 168; corner: 22 }
        }
        //  Its tint: a wash of one of the shell's own colours over the glass (they follow the wallpaper).
        box { from: 0, 0; size: 200, 168; corner: 22; color: pick(c14, mint, alert, mintlo, ink, minthi, panel); opacity: 17% * sh }
        group {
            opacity: sh
            box { at: 100, 31; size: 160, 1.2; corner: 0.6; color: ink; opacity: 22% }
            ellipse { at: 100 - 9, 15; radius: 1.8; color: ink; opacity: 45% }
            ellipse { at: 100, 15; radius: 1.8; color: ink; opacity: 45% }
            ellipse { at: 100 + 9, 15; radius: 1.8; color: ink; opacity: 45% }
            line { from: 174, 10.5; to: 184, 19.5; width: 1.5; color: ink; opacity: 65% * zb14.hover }
            line { from: 184, 10.5; to: 174, 19.5; width: 1.5; color: ink; opacity: 65% * zb14.hover }
            text t14 { at: 20, 46; anchor: left top; size: 17; weight: 500; width: 160; lines: 5; color: ink; family: "Space Grotesk"; shadow: 0, 1, 5, 70%; show: eix != 14 and h14 }
            text "Click to write" { at: 20, 46; anchor: left top; size: 15; weight: 500; color: ink; opacity: 50%; family: "Space Grotesk"; shadow: 0, 1, 5, 70%; show: eix != 14 and not h14 }
        }
    }
    group {
        show: o15 and sh > 0.01
        move: lx15, ly15
        body {
            color: tint
            glass: 1
            lens: false
            rim: 70%
            shine: 0, 0
            shadow: 0, 6, 18, 30%
            opacity: sh * clr * (1 - ob)
            show: ob < 0.996
            box { from: 0, 0; size: 200, 168; corner: 22 }
        }
        //  Obsidian (Vitreus has its glass off): the same shape as a flat, dark piece.
        body {
            color: mix(mix(tint, #000000, 0.7), ink, 0.3)
            rim: 0%
            opacity: sh * ob
            shadow: 0, 6, 18, 45%, #000000
            show: ob > 0.004
            box { from: 0, 0; size: 200, 168; corner: 22 }
        }
        //  Its tint: a wash of one of the shell's own colours over the glass (they follow the wallpaper).
        box { from: 0, 0; size: 200, 168; corner: 22; color: pick(c15, mint, alert, mintlo, ink, minthi, panel); opacity: 17% * sh }
        group {
            opacity: sh
            box { at: 100, 31; size: 160, 1.2; corner: 0.6; color: ink; opacity: 22% }
            ellipse { at: 100 - 9, 15; radius: 1.8; color: ink; opacity: 45% }
            ellipse { at: 100, 15; radius: 1.8; color: ink; opacity: 45% }
            ellipse { at: 100 + 9, 15; radius: 1.8; color: ink; opacity: 45% }
            line { from: 174, 10.5; to: 184, 19.5; width: 1.5; color: ink; opacity: 65% * zb15.hover }
            line { from: 184, 10.5; to: 174, 19.5; width: 1.5; color: ink; opacity: 65% * zb15.hover }
            text t15 { at: 20, 46; anchor: left top; size: 17; weight: 500; width: 160; lines: 5; color: ink; family: "Space Grotesk"; shadow: 0, 1, 5, 70%; show: eix != 15 and h15 }
            text "Click to write" { at: 20, 46; anchor: left top; size: 15; weight: 500; color: ink; opacity: 50%; family: "Space Grotesk"; shadow: 0, 1, 5, 70%; show: eix != 15 and not h15 }
        }
    }

    //  The field, over the sticker being written on (not inside its group: where it is typed in is where it is drawn).
    let egx = pick(clamp(eix, 0, 15), gx0, gx1, gx2, gx3, gx4, gx5, gx6, gx7, gx8, gx9, gx10, gx11, gx12, gx13, gx14, gx15) - ox
    let egy = pick(clamp(eix, 0, 15), gy0, gy1, gy2, gy3, gy4, gy5, gy6, gy7, gy8, gy9, gy10, gy11, gy12, gy13, gy14, gy15) - oy
    box { at: egx + 100, egy + 98; size: 168, 90; corner: 12; color: mix(tint, #000000, 0.35); opacity: 60% * sh; show: eix >= 0 }
    input ei { at: egx + 20, egy + 52; width: 160; size: 17; weight: 500; color: ink; family: "Space Grotesk"; placeholder: "Write here…"; show: eix >= 0 and sh > 0.01; opacity: sh }
}
