            path { at: 0.4, 0.3; stroke: 0.8; color: deep; opacity: 9% * sh * (1 - pl); move if(f15 == 1, 200 - 178.71, 178.71) + (0.3 + 0.55 * pa.15) * sin(fr15 * 59 + 3925), 159.22 + (0.3 + 0.55 * pa.15) * sin(fr15 * 52 + 2007); line if(f15 == 1, 200 - 190.80, 190.80) + (0.3 + 0.55 * pa.15) * sin(fr15 * 47 + 3187), 146.50 + (0.3 + 0.55 * pa.15) * sin(fr15 * 40 + 4990) }
            ellipse { at: 91.22 + (0.3 + 0.55 * pa.15) * sin(fr15 * 59 + 583), 15.15 + (0.3 + 0.55 * pa.15) * sin(fr15 * 42 + 3842); radius: 1.8 * (1 + 0.08 * sin(fr15 * 53 + 601)); color: deep; opacity: 45% }
            ellipse { at: 91.24 + (0.3 + 0.55 * pa.15) * sin(fr15 * 72 + 4124), 15.18 + (0.3 + 0.55 * pa.15) * sin(fr15 * 71 + 4833); radius: 1.5; color: deep; opacity: 14% }
            ellipse { at: 100.07 + (0.3 + 0.55 * pa.15) * sin(fr15 * 71 + 432), 14.70 + (0.3 + 0.55 * pa.15) * sin(fr15 * 65 + 3623); radius: 1.8 * (1 + 0.08 * sin(fr15 * 53 + 581)); color: deep; opacity: 45% }
            ellipse { at: 100.62 + (0.3 + 0.55 * pa.15) * sin(fr15 * 40 + 3674), 15.03 + (0.3 + 0.55 * pa.15) * sin(fr15 * 64 + 1643); radius: 1.5; color: deep; opacity: 14% }
            ellipse { at: 108.68 + (0.3 + 0.55 * pa.15) * sin(fr15 * 60 + 2936), 14.72 + (0.3 + 0.55 * pa.15) * sin(fr15 * 71 + 2652); radius: 1.8 * (1 + 0.08 * sin(fr15 * 53 + 552)); color: deep; opacity: 45% }
            ellipse { at: 109.26 + (0.3 + 0.55 * pa.15) * sin(fr15 * 63 + 4754), 15.09 + (0.3 + 0.55 * pa.15) * sin(fr15 * 57 + 4170); radius: 1.5; color: deep; opacity: 14% }
            path { at: 0, 0; stroke: 1.6; color: deep; opacity: 75% * zb15.hover * (1 - pl) + 0% ; move if(f15 == 3, 200 - 174.86, 174.86) + (0.3 + 0.55 * pa.15) * sin(fr15 * 44 + 1171), 10.51 + (0.3 + 0.55 * pa.15) * sin(fr15 * 42 + 832); line if(f15 == 3, 200 - 179.08, 179.08) + (0.3 + 0.55 * pa.15) * sin(fr15 * 48 + 2951), 15.02 + (0.3 + 0.55 * pa.15) * sin(fr15 * 67 + 356); line if(f15 == 3, 200 - 183.99, 183.99) + (0.3 + 0.55 * pa.15) * sin(fr15 * 58 + 4500), 19.04 + (0.3 + 0.55 * pa.15) * sin(fr15 * 40 + 3851) }
            path { at: 0.4, 0.35; stroke: 1.0; color: deep; opacity: 30% * zb15.hover * (1 - pl); move if(f15 == 3, 200 - 174.08, 174.08) + (0.3 + 0.55 * pa.15) * sin(fr15 * 75 + 221), 10.40 + (0.3 + 0.55 * pa.15) * sin(fr15 * 58 + 2063); line if(f15 == 3, 200 - 178.62, 178.62) + (0.3 + 0.55 * pa.15) * sin(fr15 * 47 + 3619), 15.59 + (0.3 + 0.55 * pa.15) * sin(fr15 * 70 + 740); line if(f15 == 3, 200 - 183.72, 183.72) + (0.3 + 0.55 * pa.15) * sin(fr15 * 49 + 3020), 19.64 + (0.3 + 0.55 * pa.15) * sin(fr15 * 63 + 2325) }
            path { at: 0, 0; stroke: 1.6; color: deep; opacity: 75% * zb15.hover * (1 - pl) + 0% ; move if(f15 == 3, 200 - 183.98, 183.98) + (0.3 + 0.55 * pa.15) * sin(fr15 * 66 + 198), 10.95 + (0.3 + 0.55 * pa.15) * sin(fr15 * 68 + 1040); line if(f15 == 3, 200 - 179.00, 179.00) + (0.3 + 0.55 * pa.15) * sin(fr15 * 41 + 4033), 15.34 + (0.3 + 0.55 * pa.15) * sin(fr15 * 50 + 1066); line if(f15 == 3, 200 - 174.80, 174.80) + (0.3 + 0.55 * pa.15) * sin(fr15 * 47 + 2563), 19.06 + (0.3 + 0.55 * pa.15) * sin(fr15 * 42 + 2499) }
            path { at: 0.4, 0.35; stroke: 1.0; color: deep; opacity: 30% * zb15.hover * (1 - pl); move if(f15 == 3, 200 - 183.19, 183.19) + (0.3 + 0.55 * pa.15) * sin(fr15 * 65 + 142), 10.48 + (0.3 + 0.55 * pa.15) * sin(fr15 * 73 + 3253); line if(f15 == 3, 200 - 178.60, 178.60) + (0.3 + 0.55 * pa.15) * sin(fr15 * 62 + 273), 14.74 + (0.3 + 0.55 * pa.15) * sin(fr15 * 71 + 2206); line if(f15 == 3, 200 - 174.53, 174.53) + (0.3 + 0.55 * pa.15) * sin(fr15 * 53 + 2048), 19.89 + (0.3 + 0.55 * pa.15) * sin(fr15 * 52 + 3771) }
            //  Doodle: the close button is always there (the pencil's cross above shows only under the pointer, and not on plastic): a cream disc, a thick black ring and a cross.
        group {
            show: dd > 0.01
            opacity: dd * sh
            ellipse { at: if(f15 == 3, 16, 184), 13; radius: 10; color: #fffaf6 }
            ellipse { at: if(f15 == 3, 16, 184), 13; radius: 10; stroke: 2.4; color: ink }
            line { from: if(f15 == 3, 16, 184) - 3.6, 13 - 3.6; to: if(f15 == 3, 16, 184) + 3.6, 13 + 3.6; width: 2.4; color: ink }
            line { from: if(f15 == 3, 16, 184) - 3.6, 13 + 3.6; to: if(f15 == 3, 16, 184) + 3.6, 13 - 3.6; width: 2.4; color: ink }
        }
            text t15 { at: 20, 46; anchor: left top; size: 17; weight: 500; width: 160; lines: 5; color: mix(deep, ink, dd); family: "Space Grotesk"; show: eix != 15 and h15 }
            text "Click to write" { at: 20, 46; anchor: left top; size: 15; weight: 500; color: mix(deep, ink, dd); opacity: 45%; family: "Space Grotesk"; show: eix != 15 and not h15 }
        }
    }

    //  The field, over the sticker being written on (not inside its group: where it is typed in is where it is drawn).
    let egx = pick(clamp(eix, 0, 15), gx0, gx1, gx2, gx3, gx4, gx5, gx6, gx7, gx8, gx9, gx10, gx11, gx12, gx13, gx14, gx15) - ox
    let egy = pick(clamp(eix, 0, 15), gy0, gy1, gy2, gy3, gy4, gy5, gy6, gy7, gy8, gy9, gy10, gy11, gy12, gy13, gy14, gy15) - oy
    box { at: egx + 100, egy + 98; size: 168, 90; corner: 12; color: mix(tint, #000000, 0.35); opacity: 60% * sh; show: eix >= 0 }
    input ei { at: egx + 20, egy + 52; width: 160; size: 17; weight: 500; color: deep; family: "Space Grotesk"; placeholder: "Write here…"; show: eix >= 0 and sh > 0.01; opacity: sh }
    //  How hot each sticker is (hovered or being written on): after the stickers, because their grab areas are inside them.
    follow pa.0 = if(zb0.hover > 0.5 or eix == 0, 1, 0)
    follow pa.1 = if(zb1.hover > 0.5 or eix == 1, 1, 0)
    follow pa.2 = if(zb2.hover > 0.5 or eix == 2, 1, 0)
    follow pa.3 = if(zb3.hover > 0.5 or eix == 3, 1, 0)
    follow pa.4 = if(zb4.hover > 0.5 or eix == 4, 1, 0)
    follow pa.5 = if(zb5.hover > 0.5 or eix == 5, 1, 0)
    follow pa.6 = if(zb6.hover > 0.5 or eix == 6, 1, 0)
    follow pa.7 = if(zb7.hover > 0.5 or eix == 7, 1, 0)
    follow pa.8 = if(zb8.hover > 0.5 or eix == 8, 1, 0)
    follow pa.9 = if(zb9.hover > 0.5 or eix == 9, 1, 0)
    follow pa.10 = if(zb10.hover > 0.5 or eix == 10, 1, 0)
    follow pa.11 = if(zb11.hover > 0.5 or eix == 11, 1, 0)
    follow pa.12 = if(zb12.hover > 0.5 or eix == 12, 1, 0)
    follow pa.13 = if(zb13.hover > 0.5 or eix == 13, 1, 0)
    follow pa.14 = if(zb14.hover > 0.5 or eix == 14, 1, 0)
    follow pa.15 = if(zb15.hover > 0.5 or eix == 15, 1, 0)
}
