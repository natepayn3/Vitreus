            //  Doodle: the close button is always there (the pencil's cross above shows only under the pointer, and not on plastic): a cream disc, a thick black ring and a cross.
        group {
            show: dd > 0.01
            opacity: dd * sh
            ellipse { at: if(f0 == 3, 16, 184), 13; radius: 10; color: #fffaf6 }
            ellipse { at: if(f0 == 3, 16, 184), 13; radius: 10; stroke: 2.4; color: ink }
            line { from: if(f0 == 3, 16, 184) - 3.6, 13 - 3.6; to: if(f0 == 3, 16, 184) + 3.6, 13 + 3.6; width: 2.4; color: ink }
            line { from: if(f0 == 3, 16, 184) - 3.6, 13 + 3.6; to: if(f0 == 3, 16, 184) + 3.6, 13 - 3.6; width: 2.4; color: ink }
        }
            text t0 { at: 20, 46; anchor: left top; size: 17; weight: 500; width: 160; lines: 5; color: mix(deep, ink, dd); family: "Space Grotesk"; show: eix != 0 and h0 }
            text "Click to write" { at: 20, 46; anchor: left top; size: 15; weight: 500; color: mix(deep, ink, dd); opacity: 45%; family: "Space Grotesk"; show: eix != 0 and not h0 }
        }
    }
    group {
        show: o1 and sh > 0.01
        move: lx1, ly1
        pivot: 100, 84
        rotate: 1.1deg
        z: sz1
        //  Its grab area and its cross are inside it, so that they stack with it (the one drawn on top is the one that is pressed where two overlap): the grab area a little larger than the paper,
        //  and a good deal larger while it is held, so that a quick pull cannot outrun it (it moves with the sticker, a frame behind).
        zone box zb1 { at: 100, 84; size: 212 + 600 * zb1.pressed, 180 + 600 * zb1.pressed; corner: 6; cursor: grab; active: o1 and sh > 0.5 }
        zone box zx1 { at: if(f1 == 3, 16, 184), 13; size: 26, 26; corner: 13; cursor: pointer; active: o1 and sh > 0.5 }
        //  The paper: an opaque sheet of one of the shell's colours warmed towards cream (not glass), almost square, with its bottom left corner folded over, a soft shadow, a piece of tape and faint
        //  ruled lines. In Retro and UwU it takes their outline and hard shadow like the rest.
        body {
            color: pp1
            rim: 0%
            border: (2 + 1.2 * uk + 2.2 * dd) * pl, mix(deep, ink, dd)
            shadow: 3 * pl, 4 - pl, 11 * (1 - pl) + 2, (36% + 40% * pl) * (1 - dd), mix(#000000, deep, pl)
            opacity: sh
            path { at: 0, 0; move 0, if(f1 == 2, 26, 0); line if(f1 == 2, 26, 0), 0; line if(f1 == 3, 174, 200), 0; line 200, if(f1 == 3, 26, 0); line 200, if(f1 == 1, 142, 168); line if(f1 == 1, 174, 200), 168; line if(f1 == 0, 26, 0), 168; line 0, if(f1 == 0, 142, 168); close }
        }
        body {
            color: mix(pp1, #ffffff, 0.45)
            rim: 0%
            shadow: 1, -1, 4, 28%
            opacity: sh
            path { at: 0, 0; move pick(f1, 0, 200, 0, 174), pick(f1, 142, 142, 26, 0); line pick(f1, 26, 174, 26, 200), pick(f1, 168, 168, 0, 26); line pick(f1, 26, 174, 26, 174), pick(f1, 142, 142, 26, 26); close }
        }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; color: #efe9cc; opacity: 62% * sh }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; stroke: 0.8; color: deep; opacity: 14% * sh }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 66.23 + (0.25 + 0.4 * pa.1) * sin(fr1 * 76 + 2513); line 100, 65.32 + (0.25 + 0.4 * pa.1) * sin(fr1 * 76 + 4608); line 186, 65.49 + (0.25 + 0.4 * pa.1) * sin(fr1 * 48 + 4793) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 86.94 + (0.25 + 0.4 * pa.1) * sin(fr1 * 64 + 3901); line 100, 86.81 + (0.25 + 0.4 * pa.1) * sin(fr1 * 52 + 3247); line 186, 87.41 + (0.25 + 0.4 * pa.1) * sin(fr1 * 43 + 3315) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 108.40 + (0.25 + 0.4 * pa.1) * sin(fr1 * 75 + 4398); line 100, 108.78 + (0.25 + 0.4 * pa.1) * sin(fr1 * 66 + 4675); line 186, 107.82 + (0.25 + 0.4 * pa.1) * sin(fr1 * 62 + 1261) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 129.55 + (0.25 + 0.4 * pa.1) * sin(fr1 * 40 + 3046); line 100, 129.05 + (0.25 + 0.4 * pa.1) * sin(fr1 * 63 + 3505); line 186, 129.76 + (0.25 + 0.4 * pa.1) * sin(fr1 * 60 + 798) }
        //  The Cyber's HUD marks (as on its drawers, bar_glass.plm): a neon hairline and bright corner brackets 6 px outside the sticker.
        group {
