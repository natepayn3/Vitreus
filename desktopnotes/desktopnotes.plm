            //  Doodle: the close button is always there (the pencil's cross above shows only under the pointer, and not on plastic): a cream disc, a thick black ring and a cross.
        group {
            show: dd > 0.01
            opacity: dd * sh
            ellipse { at: if(f2 == 3, 16, 184), 13; radius: 10; color: #fffaf6 }
            ellipse { at: if(f2 == 3, 16, 184), 13; radius: 10; stroke: 2.4; color: ink }
            line { from: if(f2 == 3, 16, 184) - 3.6, 13 - 3.6; to: if(f2 == 3, 16, 184) + 3.6, 13 + 3.6; width: 2.4; color: ink }
            line { from: if(f2 == 3, 16, 184) - 3.6, 13 + 3.6; to: if(f2 == 3, 16, 184) + 3.6, 13 - 3.6; width: 2.4; color: ink }
        }
            text t2 { at: 20, 46; anchor: left top; size: 17; weight: 500; width: 160; lines: 5; color: mix(deep, ink, dd); family: "Space Grotesk"; show: eix != 2 and h2 }
            text "Click to write" { at: 20, 46; anchor: left top; size: 15; weight: 500; color: mix(deep, ink, dd); opacity: 45%; family: "Space Grotesk"; show: eix != 2 and not h2 }
        }
    }
    group {
        show: o3 and sh > 0.01
        move: lx3, ly3
        pivot: 100, 84
        rotate: 1.8deg
        z: sz3
        //  Its grab area and its cross are inside it, so that they stack with it (the one drawn on top is the one that is pressed where two overlap): the grab area a little larger than the paper,
        //  and a good deal larger while it is held, so that a quick pull cannot outrun it (it moves with the sticker, a frame behind).
        zone box zb3 { at: 100, 84; size: 212 + 600 * zb3.pressed, 180 + 600 * zb3.pressed; corner: 6; cursor: grab; active: o3 and sh > 0.5 }
        zone box zx3 { at: if(f3 == 3, 16, 184), 13; size: 26, 26; corner: 13; cursor: pointer; active: o3 and sh > 0.5 }
        //  The paper: an opaque sheet of one of the shell's colours warmed towards cream (not glass), almost square, with its bottom left corner folded over, a soft shadow, a piece of tape and faint
        //  ruled lines. In Retro and UwU it takes their outline and hard shadow like the rest.
        body {
            color: pp3
            rim: 0%
            border: (2 + 1.2 * uk + 2.2 * dd) * pl, mix(deep, ink, dd)
            shadow: 3 * pl, 4 - pl, 11 * (1 - pl) + 2, (36% + 40% * pl) * (1 - dd), mix(#000000, deep, pl)
            opacity: sh
            path { at: 0, 0; move 0, if(f3 == 2, 26, 0); line if(f3 == 2, 26, 0), 0; line if(f3 == 3, 174, 200), 0; line 200, if(f3 == 3, 26, 0); line 200, if(f3 == 1, 142, 168); line if(f3 == 1, 174, 200), 168; line if(f3 == 0, 26, 0), 168; line 0, if(f3 == 0, 142, 168); close }
        }
        body {
            color: mix(pp3, #ffffff, 0.45)
            rim: 0%
            shadow: 1, -1, 4, 28%
            opacity: sh
            path { at: 0, 0; move pick(f3, 0, 200, 0, 174), pick(f3, 142, 142, 26, 0); line pick(f3, 26, 174, 26, 200), pick(f3, 168, 168, 0, 26); line pick(f3, 26, 174, 26, 174), pick(f3, 142, 142, 26, 26); close }
        }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; color: #efe9cc; opacity: 62% * sh }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; stroke: 0.8; color: deep; opacity: 14% * sh }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 65.61 + (0.25 + 0.4 * pa.3) * sin(fr3 * 50 + 3415); line 100, 66.43 + (0.25 + 0.4 * pa.3) * sin(fr3 * 64 + 4814); line 186, 65.89 + (0.25 + 0.4 * pa.3) * sin(fr3 * 68 + 4304) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 86.45 + (0.25 + 0.4 * pa.3) * sin(fr3 * 74 + 3390); line 100, 86.95 + (0.25 + 0.4 * pa.3) * sin(fr3 * 58 + 4113); line 186, 87.40 + (0.25 + 0.4 * pa.3) * sin(fr3 * 55 + 4574) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 107.64 + (0.25 + 0.4 * pa.3) * sin(fr3 * 44 + 4367); line 100, 107.69 + (0.25 + 0.4 * pa.3) * sin(fr3 * 71 + 1351); line 186, 108.54 + (0.25 + 0.4 * pa.3) * sin(fr3 * 67 + 152) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 128.39 + (0.25 + 0.4 * pa.3) * sin(fr3 * 53 + 4265); line 100, 129.87 + (0.25 + 0.4 * pa.3) * sin(fr3 * 62 + 4079); line 186, 128.15 + (0.25 + 0.4 * pa.3) * sin(fr3 * 51 + 4579) }
        //  The Cyber's HUD marks (as on its drawers, bar_glass.plm): a neon hairline and bright corner brackets 6 px outside the sticker.
        group {
            show: cyk > 0.01
            opacity: cyk * sh
            box { from: 0, 0; size: 200, 168; corner: 22 * (1 - 0.73 * cyk); stroke: 1.1; color: mint; opacity: 38% }
            repeat nc3 in 0..4 {
                let nx3 = if(mod(nc3, 2) == 0, -6, 206)
                let ny3 = if(nc3 < 2, -6, 174)
                let nsx3 = if(mod(nc3, 2) == 0, -1, 1)
                let nsy3 = if(nc3 < 2, -1, 1)
                path { at: nx3, ny3; stroke: 5; color: mint; opacity: 16%; move 0, -nsy3 * 13; line 0, 0; line -nsx3 * 13, 0 }
                path { at: nx3, ny3; stroke: 1.7; color: minthi; move 0, -nsy3 * 13; line 0, 0; line -nsx3 * 13, 0 }
            }
        }
