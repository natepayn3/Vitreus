            //  Doodle: the close button is always there (the pencil's cross above shows only under the pointer, and not on plastic): a cream disc, a thick black ring and a cross.
        group {
            show: dd > 0.01
            opacity: dd * sh
            ellipse { at: if(f8 == 3, 16, 184), 13; radius: 10; color: #fffaf6 }
            ellipse { at: if(f8 == 3, 16, 184), 13; radius: 10; stroke: 2.4; color: ink }
            line { from: if(f8 == 3, 16, 184) - 3.6, 13 - 3.6; to: if(f8 == 3, 16, 184) + 3.6, 13 + 3.6; width: 2.4; color: ink }
            line { from: if(f8 == 3, 16, 184) - 3.6, 13 + 3.6; to: if(f8 == 3, 16, 184) + 3.6, 13 - 3.6; width: 2.4; color: ink }
        }
            text t8 { at: 20, 46; anchor: left top; size: 17; weight: 500; width: 160; lines: 5; color: mix(deep, ink, dd); family: "Space Grotesk"; show: eix != 8 and h8 }
            text "Click to write" { at: 20, 46; anchor: left top; size: 15; weight: 500; color: mix(deep, ink, dd); opacity: 45%; family: "Space Grotesk"; show: eix != 8 and not h8 }
        }
    }
    group {
        show: o9 and sh > 0.01
        move: lx9, ly9
        pivot: 100, 84
        rotate: 1.1deg
        z: sz9
        //  Its grab area and its cross are inside it, so that they stack with it (the one drawn on top is the one that is pressed where two overlap): the grab area a little larger than the paper,
        //  and a good deal larger while it is held, so that a quick pull cannot outrun it (it moves with the sticker, a frame behind).
        zone box zb9 { at: 100, 84; size: 212 + 600 * zb9.pressed, 180 + 600 * zb9.pressed; corner: 6; cursor: grab; active: o9 and sh > 0.5 }
        zone box zx9 { at: if(f9 == 3, 16, 184), 13; size: 26, 26; corner: 13; cursor: pointer; active: o9 and sh > 0.5 }
        //  The paper: an opaque sheet of one of the shell's colours warmed towards cream (not glass), almost square, with its bottom left corner folded over, a soft shadow, a piece of tape and faint
        //  ruled lines. In Retro and UwU it takes their outline and hard shadow like the rest.
        body {
            color: pp9
            rim: 0%
            border: (2 + 1.2 * uk + 2.2 * dd) * pl, mix(deep, ink, dd)
            shadow: 3 * pl, 4 - pl, 11 * (1 - pl) + 2, (36% + 40% * pl) * (1 - dd), mix(#000000, deep, pl)
            opacity: sh
            path { at: 0, 0; move 0, if(f9 == 2, 26, 0); line if(f9 == 2, 26, 0), 0; line if(f9 == 3, 174, 200), 0; line 200, if(f9 == 3, 26, 0); line 200, if(f9 == 1, 142, 168); line if(f9 == 1, 174, 200), 168; line if(f9 == 0, 26, 0), 168; line 0, if(f9 == 0, 142, 168); close }
        }
        body {
            color: mix(pp9, #ffffff, 0.45)
            rim: 0%
            shadow: 1, -1, 4, 28%
            opacity: sh
            path { at: 0, 0; move pick(f9, 0, 200, 0, 174), pick(f9, 142, 142, 26, 0); line pick(f9, 26, 174, 26, 200), pick(f9, 168, 168, 0, 26); line pick(f9, 26, 174, 26, 174), pick(f9, 142, 142, 26, 26); close }
        }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; color: #efe9cc; opacity: 62% * sh }
        box { at: 100, 3; size: 64, 17; corner: 1; rotate: -2.5deg; stroke: 0.8; color: deep; opacity: 14% * sh }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 66.38 + (0.25 + 0.4 * pa.9) * sin(fr9 * 74 + 2678); line 100, 65.74 + (0.25 + 0.4 * pa.9) * sin(fr9 * 73 + 4481); line 186, 66.40 + (0.25 + 0.4 * pa.9) * sin(fr9 * 56 + 3014) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 86.60 + (0.25 + 0.4 * pa.9) * sin(fr9 * 46 + 2732); line 100, 87.13 + (0.25 + 0.4 * pa.9) * sin(fr9 * 59 + 3117); line 186, 86.89 + (0.25 + 0.4 * pa.9) * sin(fr9 * 67 + 3475) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 107.90 + (0.25 + 0.4 * pa.9) * sin(fr9 * 45 + 4417); line 100, 108.67 + (0.25 + 0.4 * pa.9) * sin(fr9 * 63 + 3833); line 186, 108.79 + (0.25 + 0.4 * pa.9) * sin(fr9 * 74 + 2833) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 129.08 + (0.25 + 0.4 * pa.9) * sin(fr9 * 66 + 1884); line 100, 129.21 + (0.25 + 0.4 * pa.9) * sin(fr9 * 60 + 1201); line 186, 128.57 + (0.25 + 0.4 * pa.9) * sin(fr9 * 47 + 891) }
        //  The Cyber's HUD marks (as on its drawers, bar_glass.plm): a neon hairline and bright corner brackets 6 px outside the sticker.
        group {
            show: cyk > 0.01
            opacity: cyk * sh
            box { from: 0, 0; size: 200, 168; corner: 22 * (1 - 0.73 * cyk); stroke: 1.1; color: mint; opacity: 38% }
            repeat nc9 in 0..4 {
                let nx9 = if(mod(nc9, 2) == 0, -6, 206)
                let ny9 = if(nc9 < 2, -6, 174)
                let nsx9 = if(mod(nc9, 2) == 0, -1, 1)
                let nsy9 = if(nc9 < 2, -1, 1)
                path { at: nx9, ny9; stroke: 5; color: mint; opacity: 16%; move 0, -nsy9 * 13; line 0, 0; line -nsx9 * 13, 0 }
                path { at: nx9, ny9; stroke: 1.7; color: minthi; move 0, -nsy9 * 13; line 0, 0; line -nsx9 * 13, 0 }
            }
        }
