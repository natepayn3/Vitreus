        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 107.72 + (0.25 + 0.4 * pa.7) * sin(fr7 * 53 + 1929); line 100, 107.20 + (0.25 + 0.4 * pa.7) * sin(fr7 * 62 + 2192); line 186, 108.51 + (0.25 + 0.4 * pa.7) * sin(fr7 * 51 + 3836) }
        path { at: 0, 0; stroke: 1; color: deep; opacity: 13% * sh * (1 - pl); move 14, 128.47 + (0.25 + 0.4 * pa.7) * sin(fr7 * 41 + 3202); line 100, 128.25 + (0.25 + 0.4 * pa.7) * sin(fr7 * 75 + 3593); line 186, 129.64 + (0.25 + 0.4 * pa.7) * sin(fr7 * 53 + 2404) }
        //  The Cyber's HUD marks (as on its drawers, bar_glass.plm): a neon hairline and bright corner brackets 6 px outside the sticker.
