[Desktop Entry]
Type=Application
Version=1.0
Name=View
GenericName=Image Viewer and Video Player
Comment=Look at pictures and play videos, in the shell's look
Exec=@BIN@ %U
Icon=vitreus-view
Terminal=false
Categories=Graphics;Viewer;AudioVideo;Video;Player;Utility;
MimeType=image/png;image/jpeg;image/gif;image/webp;image/bmp;image/svg+xml;image/tiff;image/avif;image/heic;image/heif;image/jxl;image/x-icon;image/vnd.microsoft.icon;image/x-tga;image/vnd.adobe.photoshop;image/qoi;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-anymap;video/mp4;video/x-m4v;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/x-ms-wmv;video/x-flv;video/mpeg;video/mp2t;video/ogg;video/3gpp;video/3gpp2;
Keywords=picture;photo;image;viewer;gallery;video;movie;player;
StartupWMClass=vitreus.view
