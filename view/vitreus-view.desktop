[Desktop Entry]
Type=Application
Version=1.0
Name=View
GenericName=Image Viewer
Comment=Look at pictures, in the shell's glass
Exec=@BIN@ %U
Icon=vitreus-view
Terminal=false
Categories=Graphics;Viewer;Utility;
MimeType=image/png;image/jpeg;image/gif;image/webp;image/bmp;image/svg+xml;image/tiff;image/avif;image/heic;image/heif;image/jxl;image/x-icon;image/vnd.microsoft.icon;image/x-tga;image/vnd.adobe.photoshop;image/qoi;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-anymap;
Keywords=picture;photo;image;viewer;gallery;
StartupWMClass=vitreus.view
