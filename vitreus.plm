    }
    fact theme_sel = 0               // Settings > Theme: the selected card's place in the list (0 the wallpaper's colours, -1 monochrome)
    //  The cards of Settings > Theme, one per theme file (themes/*.toml, ~/.config/pleamar/vitreus-themes): the name, its small line, and five stripes (three
    //  numbers a colour, 0 to 1: a model has no colour field). `live`: the stripes are the wallpaper's (Glass), which the scene already holds.
    model themes max 16 { name: text; tag: text; live: bool; c0r: number; c0g: number; c0b: number; c1r: number; c1g: number; c1b: number; c2r: number; c2g: number; c2b: number; c3r: number; c3g: number; c3b: number; c4r: number; c4g: number; c4b: number }
    fact th_first = 0                // the first card in view (four are, of however many themes there are)
    prop th_pos = 0 ~calm            // ... and where the strip is, travelling there
    follow th_pos = clamp(th_first, 0, max(0, themes.count - 4))
    text th_note = ""                // the line under the cards: a file that did not load, or where to put a theme
    fact th_err = false
    event themes_refresh ->
    //  Settings > Add-ons: a row for each folder in ~/.config/pleamar/vitreus-addons (logic/addons.luau), with its switch.
