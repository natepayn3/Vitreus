language 0.1

import "palette-live.plm"
import "desktopclock/clockface.plm"

//  Vitreus: a bar of liquid glass. The glass only blurs what is behind it (the
//  compositor does it; `lens: false`, unless the Glass page turns bending on), and the panel is not stuck under the
//  bar: it is the same silhouette, melted, so it hangs from it like a drop.

scene Vitreus {
    //  The palette (palette-live.plm). The logic sets these from the wallpaper (Iris); what is here is the stock look it starts from.
    fact pal_ink_r = 0.9608   // #f5f7f5
    fact pal_ink_g = 0.9686
    fact pal_ink_b = 0.9608
    fact pal_faint_r = 0.7608   // #c2c7cc
    fact pal_faint_g = 0.7804
    fact pal_faint_b = 0.8000
    fact pal_mint_r = 0.6196   // #9ed6bd
    fact pal_mint_g = 0.8392
    fact pal_mint_b = 0.7412
    fact pal_mintlo_r = 0.4235   // #6cbc9c
    fact pal_mintlo_g = 0.7373
    fact pal_mintlo_b = 0.6118
    fact pal_minthi_r = 0.8627   // #dcf8ec
    fact pal_minthi_g = 0.9725
    fact pal_minthi_b = 0.9255
    fact pal_onmint_r = 0.0627   // #10161a
    fact pal_onmint_g = 0.0863
    fact pal_onmint_b = 0.1020
    fact pal_tint_r = 0.1059   // #1b2127
    fact pal_tint_g = 0.1294
    fact pal_tint_b = 0.1529
    fact pal_panel_r = 0.0863   // #161a1f
    fact pal_panel_g = 0.1020
    fact pal_panel_b = 0.1216
    fact pal_deep_r = 0.0431   // #0b0e11
    fact pal_deep_g = 0.0549
    fact pal_deep_b = 0.0667
    fact pal_off_r = 0.2275   // #3a4048
    fact pal_off_g = 0.2510
    fact pal_off_b = 0.2824
    fact pal_alert_r = 0.9373   // #ef4444
    fact pal_alert_g = 0.2667
    fact pal_alert_b = 0.2667
    surface { size: full, full; anchor: bar_anchor; margin: 0; reserve: 68 while bar_anchor == top; screens: all; keyboard: exclusive while (panel != none and panel != volume and panel != notif) or wp_picker_open or ov_open or pk_open or desk_kb }
    permissions { services: "files", "files.write", "clock", "audio", "audio.*", "window", "media", "media.*", "workspaces", "workspaces.focus", "brightness", "brightness.*", "battery", "network", "network.*", "bluetooth", "bluetooth.*", "apps", "tray", "tray.*", "notifications", "notifications.*"
                  run: "git", "pleamar", "pleamar-update", "cava", "playerctl", "curl", "notify-send", "which", "pgrep", "pkill", "systemctl", "hyprctl", "socat", "printenv", "awww", "iris", "cp", "ls", "xdg-user-dir", "magick", "grim", "mkdir", "bluetoothctl", "nmcli", "chmod", "wl-copy", "find", "vitreus-term", "claude", "ollama", "codex", "gemini", "cliphist", "stat", "file", "vitreus-clipimg", "grep", "pactl", "sed", "setsid", "powerprofilesctl", "loginctl", "vitreus-polkit-agent", "vitreus-sysmon", "pw-play", "ffmpeg", "tesseract" }

    model wifi_nets max 8 { ssid: text; strength: number; secure: bool; known: bool; active: bool }
    model bt_devices max 24 { name: text; address: text; paired: bool; connected: bool; battery: number; busy: number }

    service clock as now { time: text = "--:--"; date: text }
    service audio { volume: number; muted: bool }
    service window as win { title: text; class: text }
    service media { playing: bool; title: text; artist: text; player: text }
    service brightness { present: bool; level: number }
    service battery as pwr { present: bool; percent: number; charging: bool }     // the bar is its gauge (see `batt_*`)
    service network as net { online: bool; wifi: bool; name: text; strength: number; networks: wifi_nets }
    service bluetooth as bt { present: bool; powered: bool }        // the list itself is built by the logic

    text clock12 = "--:--"
    text clock_h = ""              // the bar clock in three parts: the hour (oversized), the minutes (in the accent), am/pm
    text clock_mm = ""
    text clock_mn = ""             // the minutes alone, for the bar down the left
    text bar_ap = ""
    text bar_ap1 = ""              // the first letter of am/pm, for the badge by the hour down the left (the second is always an m)
    text bar_date = ""              // the short day stacked above the am/pm: MON
    text datelong = ""
    //  The clock card's pieces: the numerals, the am/pm tucked beside them, and the date as weekday | month day.
    text clock_hm = "--:--"
    text clock_ap = ""
    text date_wd = ""
    text date_md = ""
    measure hmw                    // how wide the big numerals are, to tuck the am/pm against them
    measure mdw                    // and the month and day, the date being right-aligned from them
    text arturl = ""               // the cover: a path to an image file, from the logic
    fact art_on = false            // is there one
    image art = from arturl, 200, 200
    event trackchange              // the logic says the song changed
    //  The calendar: 42 days in the grid (six weeks), what the logic says of each, and the
    //  chosen day's reminders. The logic keeps them in `calendar.json` and paints these.
    event cal_pick ->              // a day of the grid, by its place
    event cal_prev ->
    event cal_next ->
    event cal_today ->
    event cal_open ->              // the calendar panel just opened: back to today
    event cal_add ->               // the Add button (Enter in the field does the same)
    event cal_check ->             // a reminder of the chosen day, by its row: done / not done
    event cal_delete ->
    fact cal.sel = 0               // which place of the grid is chosen
    text cal.month = ""
    text cal.sel_title = ""
    text cal.sel_sub = ""
    text cal_new = ""              // what is being typed in the field
    model cal_events max 4 { time: text; title: text; done: bool }
    repeat k in 0..42 {
        fact cal.day.$k = 0
        fact cal.in.$k = false
        fact cal.today.$k = false
        fact cal.n.$k = 0
    }
    repeat w in 1..8 { text cal.wd.$w = "" }
    text outname = ""              // where the sound is going: the default output
    measure outw                   // how wide that name really is
    measure clsw                   // how wide the focused app's name really is
    measure lhw0                   // how wide the launcher's five hints are, to centre each in its cell
    measure lhw1
    measure lhw2
    measure lhw3
    measure lhw4
    measure titw                   // and its window title
    measure vclw                   // the same two, at the size they are drawn down the left bar
    measure vtiw
    measure chw                    // the bar clock's hour, minutes and am/pm: how wide each really is; the bar's
    measure cmw                    // buttons and the calendar's click area are placed from them
    measure caw
    measure cdw
    //  Which panel hangs from the bar: the clock and calendar (click the clock), or the
    //  controls (click the window title).
    fact panel: none | calendar | controls | player | volume | notif | settings | launch | tray | desk = none
    fact media_on = false          // is there a player at all
    fact bass = 0
    //  The six bars cava reports, 0..1 each, for the equalizer in the media card. Each one
    //  has its own quick spring, so they rise and fall smoothly instead of stepping.
    repeat i in 0..6 {
        fact spec.$i = 0
        prop spec.s.$i = 0 ~quick
        follow spec.s.$i = spec.$i
    }                  // 0..1, from cava: how hard the low end is hitting
    model outlist max 6 { name: text; current: bool }   // every place the sound can go
    //  The mixer under the volume slider (right-click it): one row per app that is playing sound.
    model mixer max 6 { name: text; pct: number; muted: bool; corked: bool; icon: image 27, 27 }
    event mix_set ->                // a row's slider: the row times 4, plus 0..1 along its track (one number)
    event mix_mute ->               // a row's speaker
    //  The running windows (asked of Hyprland by the logic: the window service has no list there) and
    //  the apps that live in the tray, for the panel that hangs from the window title. Icons are named
    //  by the logic, which matches each window's class to an app.
    model tasks max 12 { title: text; ws: text; active: bool; icon: image 30, 30 }
    fact tasks_watch = false       // the panel is open: keep the list fresh
    model trays max 16 { title: text; icon: image 30, 30; pinned: bool; menu: bool }
    model bartrays max 8 { icon: image 36, 36 }          // the tray apps that ride the bar
    //  One entry of a tray app's menu, flattened: an open submenu is followed by its own entries, `depth` deeper.
    model tray_menu max 40 { label: text; enabled: bool; sep: bool; checked: bool; kids: bool; open: bool; depth: number }
    //  The tray menu panel (it hangs from the window title, like the player's) is about one app.
    text tm_title = ""
    text tm_sub = ""
    text tm_iconurl = ""
    image tm_icon = from tm_iconurl, 44, 44
    fact tm_pinned = false
    fact tm_has_menu = false
    fact tm_h = 0                       // how tall the menu's rows are, unscaled
    fact tray_only_pinned = false       // the bar shows only the pinned apps
    fact dm_mode: dmm_player | dmm_tray = dmm_player      // what the window-title panel holds
    event tray_pin ->
    event tray_menu_open ->
    event bar_tray_click ->
    event bar_tray_menu ->
    event tray_menu_pick ->
    event tm_pin ->
    event tm_open ->
    event tm_alt ->
    event tray_mode ->
    //  The two transient panels (volume, and a notification arriving) share one drawer. `osd_kind` is
    //  which one it draws; unlike `panel` it stays put while the drawer closes, so it fades out
    //  showing what it was showing.
    fact osd_kind: vol | note | shot = vol
    fact osd_on = false                                     // the volume / notification drawer is out: set by the logic; it is not a value of `panel`, so it shows beside Settings, the search, the desk...
    text nt_app = ""
    text nt_title = ""
    text nt_body = ""
    measure ntt                    // how tall the notification's title really is once wrapped
    measure ntb                    // and its body
    text nt_iconpath = ""          // the app's icon, or the picture it brought: a name or a path
    image nt_img = from nt_iconpath, 59, 59       // drawn at 44 * u = 59: declared at that, or it is made at 44 and stretched (soft, with a jagged edge)
    fact nt_icon_on = false
    fact nt_body_on = false
    fact nt_urgent = false
    model nt_acts max 3 { label: text }
    event ntnew                    // a notification just arrived: ripple the tile
    event nt_close ->              // its cross, or a press on the plate
    //  A screenshot just taken, as a card in the same drawer (logic: `shot_done`): its picture, its name, and what can be done with it. The text buttons
    //  need tesseract (`shot_ocr`).
    text shot_path = ""
    text shot_imgpath = ""
    text shot_name = ""
    image shot_img = from shot_imgpath, 394, 222               // drawn at 292 * u = 394 by 164 * u = 222
    fact shot_ocr = false
    event shot_done ->
    event shot_act ->                // one of its buttons: 0 open, 1 copy the text, 2 ask about the text, 3 delete
    event shot_close ->
    event nt_act ->                // one of its buttons, by position
    //  Settings: a panel of pages, the wallpaper picker first. The logic lists the folder and keeps one
    //  page of twelve thumbnails at a time (the folder can hold hundreds of full-size images).
    model wps max 12 { thumb: image 260, 146 }
    fact wp_sel = -1                // which thumbnail of this page is the wallpaper in use, or -1
    text wp_curpath = ""            // the wallpaper in use: a path
    image wp_cur = from wp_curpath, 320, 180
    text wp_name = ""
    text wp_dirtext = ""
    text wp_pager = ""
    event wp_pick ->                // a thumbnail, by position on the page
    event wp_prev ->
    event wp_next ->
    event wp_random ->
    //  The colour filter (twelve swatches; the lit one is `wp_filter`, -1 for none) and the slideshow.
    fact wp_filter = -1
    //  The glass of the bar and every drawer: how much of the glass effect it has (tint, edge light, and the blur
    //  the compositor puts behind it), and how opaque it is. Set from the Glass page of the settings.
    fact glass_frost = 1
    fact glass_op = 1
    text glass_frost_text = "100%"
    text glass_op_text = "100%"
    event glass_frost_set ->        // the Glass slider: 0..1 along its track
    //  The rest of the Glass page: the edge light (a multiplier, 0 to 2), and, only while the glass bends what is behind
    //  it (`glass_bend`), how thick it is (0 to 2) and the rainbow at its edge (0 to 2.5). The blur is Hyprland's (`hy_blur`).
    fact glass_rim = 1
    fact glass_refr = 1
    fact glass_disp = 1
    fact glass_bend = false
    fact hy_blur = 3
    prop glass_bend_k = 0 ~quick
    follow glass_bend_k = if(glass_bend, 1, 0)
    text glass_rim_text = "100%"
    text glass_refr_text = "100%"
    text glass_disp_text = "100%"
    text hy_blur_text = "3"
    event glass_rim_set ->
    event glass_refr_set ->
    event glass_disp_set ->
    event glass_bend_toggle ->
    event glass_blur_set ->
    event glass_op_set ->           // the Opacity slider: 0..1 along its track
    event hy_layout_set ->
    event hy_gaps_set ->
    event hy_round_set ->
    event hy_border_set ->
    event hy_sens_set ->
    event hy_follow_set ->
    event hy_toggle ->
    event hy_refresh ->
    event wm_layout_set ->
    event wm_share_set ->
    event wm_gap_set ->
    event wm_toggle ->
    event wm_input_set ->
    event wm_style_set ->
    event wm_refresh ->
    //  The launcher (SUPER + Space): what is typed, the results, and which one is chosen.
    event launch_toggle ->          // from a key bind (hypr_vitreus.lua)
    event launch_open ->
    event launch_move ->            // -1 up, +1 down
    event launch_pick ->            // a row, by place
    event launch_scroll ->          // the wheel over the rows: notches, positive is down
    event launch_run ->             // Enter
    event launch_del ->             // a row's remove button, by place (the clipboard's)
    event launch_delsel ->          // Shift + Delete: remove the chosen row
    event launch_hint ->            // a hint under the field: type its first character
    text lq = ""                    // the search field
    text lmode = "Apps"             // which kind of search the text asks for
    text lmsg = ""                  // what to say when there is no row: "No results", "Searching…"
    text lfoot = ""                 // "3 / 20"
    fact lcount = 0
    fact lp_on = false               // this kind of search has a preview beside its rows
    prop lpv = 0 ~calm               // 0..1: how far the preview is in
    follow lpv = if(lp_on, 1, 0)
    text lp_kind = ""                // FILE, IMAGE, TEXT, WALLPAPER
    text lp_title = ""
    text lp_path = ""
    text lp_body = ""                // the text of a text entry
    text lp_k1 = ""
    text lp_v1 = ""
    text lp_k2 = ""
    text lp_v2 = ""
    text lp_k3 = ""
    text lp_v3 = ""
    text lp_k4 = ""
    text lp_v4 = ""
    text lp_imgpath = ""             // a small copy of the picture, at a fixed path with a version on the end
    fact lp_img_on = false
    image lp_img = from lp_imgpath, 480, 320
    model lres max 6 { title: text; sub: text; desc: text; hasdesc: bool; glyph: text; sel: bool; hasicon: bool; deletable: bool; icon: image 35, 35 }
    event settings_toggle ->        // from a key bind (hypr_vitreus.lua): open or close Settings
    event glass_reset ->
    //  The pages of the settings panel, and how far the second is in (for the sidebar's highlight and the
    //  panel's height, which follows the page).
    fact set_page: pg_wall | pg_glass | pg_disp | pg_bar | pg_night | pg_hypr | pg_about | pg_sys | pg_nt | pg_lock | pg_wm | pg_vpn | pg_clock | pg_theme = pg_wall
    //  The Bar page: which monitors the bar is on (see the Bar section of vitreus.luau). `bar_scr` is -1 for all
    //  of them, or which monitor tile is chosen.
    fact bar_scr = -1
    //  The bar's position (Settings > Bar): along the top, or down the left edge with a frame round the screen (see the Bar section of
    //  vitreus.luau). The surface's anchor follows it; `bar_lm` is how far over to the left it has got, and the panels still hang from the top
    //  edge, `lp_w` wide (the one last opened), their left edge by the strip.
    fact bar_anchor: top | left = top
    //  Down the left a panel never turns into another: asking for one while another is open closes the open one first, and the new one
    //  opens when it has gone (see the rule after `lp.top`). `pcur` is the panel as the rule last saw it, `pending` the one that is waiting.
    fact pcur: none | calendar | controls | player | volume | notif | settings | launch | tray = none
    fact pending: none | calendar | controls | player | volume | notif | settings | launch | tray = none
    fact pq_sw = false
    event bar_pick_pos ->
    fact lp_w = 450
    fact lp_k = 0                   // which panel was opened last: 1 settings, 2 launcher, 3 controls, 4 calendar, 5 tray, 6 player, 7 volume, 8 notification
    repeat i in 0..4 {
        fact bar_m.$i.on = false
        text bar_m.$i.name = ""
        text bar_m.$i.sub = ""
    }
    text bar_msg = ""
    event bar_pick_scr ->
    //  The bar's layout (Settings > Bar): each piece's place in the row, 0 leftmost, and whether it is shown. The
    //  title is the stretch: what comes before it hugs the left, what comes after it the right.
    fact bo.ws = 0
    fact bo.title = 1
    fact bo.media = 2
    fact bo.tray = 3
    fact bo.set = 4
    fact bo.sr = 5
    fact bo.ctl = 6
    fact bo.clock = 7
    fact bv.ws = true
    fact bv.title = true
    fact bv.media = true
    fact bv.sr = true
    fact bv.ctl = true
    fact bv.clock = true
    fact bv.tray = true
    //  The layout editor on the Bar page: a chip per piece (0 workspaces, 1 title, 2 player, 3 settings, 4 search,
    //  5 controls, 6 clock, 7 tray), where the logic puts it (`bc.$i`, top-left and width, in the editor's unscaled units:
    //  the bar row starts at y 4, the hidden tray at 56), and the one being dragged, which follows the pointer.
    repeat i in 0..8 {
        fact bc.$i.x = 0
        fact bc.$i.y = 4
        fact bc.$i.w = 34
    }
    fact bdrag = -1                 // the chip being dragged, -1 none
    fact bdx = 0                    // the pointer, in the editor's units
    fact bdy = 0
    fact bgx = 0                    // where in the chip it was taken
    fact bgy = 0
    fact bdrop_tray = false         // the dragged chip would go to the hidden tray
    fact btray_n = 0                // how many pieces are hidden
    event bar_lay_grab ->
    event bar_lay_drag ->
    event bar_lay_drop ->
    event bar_lay_reset ->
    //  The Display page: what the logic reads from Hyprland and the draft the page edits (see the Display
    //  section of vitreus.luau). `disp_boxes` is the canvas, one box per monitor, in canvas units.
    //  The canvas's boxes, the refresh-rate chips, the monitor pills and the profile rows are numbered slots.
    repeat i in 0..4 {
        fact disp_b.$i.on = false
        fact disp_b.$i.x = 0
        fact disp_b.$i.y = 0
        fact disp_b.$i.w = 0
        fact disp_b.$i.h = 0
        fact disp_b.$i.sel = false
        fact disp_b.$i.dirty = false
        text disp_b.$i.name = ""
        text disp_b.$i.mode = ""
        text disp_b.$i.scale = ""
        text disp_b.$i.wp = ""
        fact disp_b.$i.main = false
        image disp_wpi.$i = from disp_b.$i.wp, 320, 180
        fact disp_pill.$i.on = false
        text disp_pill.$i.text = ""
        fact disp_p.$i.on = false
        fact disp_p.$i.active = false
        text disp_p.$i.name = ""
        text disp_p.$i.sub = ""
    }
    repeat i in 0..6 {
        fact disp_hz.$i.on = false
        fact disp_hz.$i.lit = false
        text disp_hz.$i.text = ""
    }
    text disp_res_text = ""
    measure disp_rw                 // how wide the resolution's text is: the dropdown is as wide as that needs
    fact disp_res_open = false      // the resolution dropdown is open
    fact disp_scroll_to = 0         // where the Display page is scrolled to (unscaled units, from the top)
    fact disp_res_chars = 10        // how many characters the longest resolution in the list has
    fact disp_res_count = 0         // how many resolutions it lists
    fact disp_pcount = 0            // how many saved profiles there are (the card is as tall as they need)
    repeat i in 0..14 {
        fact disp_r.$i.on = false
        fact disp_r.$i.lit = false
        text disp_r.$i.text = ""
    }
    fact disp_count = 0
    fact disp_sel = 0               // which monitor the inspector is about
    fact disp_dirty = false         // the draft is not what the screens are
    fact disp_scale = 0             // which of the seven scale choices is the draft's
    fact disp_rot = 0               // 0..3, or -1 for a flipped one
    fact disp_sdrb = 1
    fact disp_sdrs = 1
    fact disp_auto = true           // reapply a saved profile when its set of displays is connected
    fact disp_trial = 0             // seconds left of a change on trial; 0 for none
    fact disp_grab_i = 0
    fact disp_px = 0
    fact disp_py = 0
    text disp_title = ""
    text disp_desc = ""
    text disp_cur = ""
    text disp_topo = ""
    text disp_msg = ""
    text disp_trial_text = ""
    text disp_sdrb_text = "1"
    text disp_sdrs_text = "1"
    text disp_profile_name = ""
    event disp_pick_mon ->
    event disp_pick_res ->
    event disp_pick_hz ->
    event disp_pick_scale ->
    event disp_pick_rot ->
    event disp_rot_mon ->
    event disp_sdrb_set ->
    event disp_sdrs_set ->
    event disp_apply ->
    event disp_keep ->
    event disp_revert ->
    event disp_reset ->
    event disp_refresh ->
    event disp_grab ->
    event disp_drag ->
    event disp_drop ->
    event disp_arrange ->
    event disp_swap ->
    event disp_profile_save ->
    event disp_profile_apply ->
    event disp_profile_delete ->
    event disp_auto_toggle ->
    text wp_count = ""              // 57 wallpapers, or 12 of 57 with a colour picked
    event wp_filter_set ->          // a swatch, by position
    fact wp_show = false            // the slideshow is on
    text wp_show_sub = ""           // Next change in 4:31
    text wp_mins_text = ""          // 5 min
    event wp_show_toggle ->
    fact rand_turn = 0              // how many times Random has been pressed: the die turns once for each
    fact theme_sel = 0               // Settings > Theme: 0 the wallpaper's colours, 1 to 6 a named palette, 7 monochrome
    fact iris_int = 1                // how strongly the wallpaper's accent is pushed: 0 subtle, 1 medium, 2 bold
    event theme_pick ->
    event iris_int_set ->
    fact iris_on = true             // Iris, the palette from the wallpaper, is on; off, the shell is monochrome
    event iris_toggle ->
    event wp_mins_step ->           // the stepper: -1 or 1 along a short list of intervals
    //  Weather, for the calendar panel: what it is now, and the week ahead. The logic fetches it (Open-Meteo)
    //  and gives each day a `kind`: 0 clear, 1 partly cloudy, 2 cloud, 3 fog, 4 rain, 5 snow, 6 storm.
    fact wx_ok = false
    fact wx_kind = 2
    text wx_temp = ""
    text wx_desc = ""
    model wx_days max 7 { label: text; kind: number; hi: text; lo: text; today: bool }
    event task_focus ->            // a window's row, by position: give it the keyboard
    event task_close ->            // its close button, or a middle click
    event tray_click ->            // a tray app's row
    fact dd_open = false           // the output dropdown
    fact vm_open = false           // the per-app mixer under the volume slider
    event pick_out ->              // a row of it, by position
    event mute ->                  // the speaker icon
    event setvol ->                // the volume slider: 0..1
    event mcmd ->                  // 0 previous · 1 play/pause · 2 next
    event setbright ->             // the brightness slider: 0..1
    event togglewifi ->            // the wifi row: flips the radio
    event togglebt ->              // the bluetooth row: flips the radio
    fact bt_connected = false      // a device is paired and connected
    text bt_name = ""              // its name, from the logic
    fact bright_avail = true       // brightnessctl is installed: the slider can actually be dragged
    //  Tapping the rest of a tile (not its toggle) grows it into its own window.
    //  `showing_sub` only follows `panel_sub` on the way in - see its rule below -
    //  so the window it drew stays up, fading out, while it closes.
    fact panel_sub: none | netview | btview | notifview | cafview | capview | powview = none
    fact showing_sub: none | netview | btview | notifview | cafview | capview | powview = none
    //  Which row is open, in each list - its password field or its
    //  Connect/Disconnect/Forget, right underneath it. -1 is none.
    fact on_wifi = false            // the connection in use is Wi-Fi (not wired): the logic reads network.kind
    fact wifi_open_row = -1
    fact bt_open_row = -1
    //  The open Bluetooth row's audio profiles (High Fidelity, Headset, Off...), the way PipeWire offers them for that device: up to six, each a
    //  label and whether it is the one in use (`bt_po`: there is one in this place). `bt_pf_h` is how tall the pills are, 0 when there is nothing to choose.
    fact bt_pf_h = 0
    event bt_prof_set ->
    repeat i in 0..6 { text bt_pl.$i = "" }
    repeat i in 0..6 { fact bt_pa.$i = false }
    repeat i in 0..6 { fact bt_po.$i = false }
    event wifi_pick ->              // a network row's own button: connect, or leave it
    event wifi_forget ->            // a network row's Forget
    event wifi_scan ->              // the rescan button
    fact wifi_scanning = false      // a scan is running: the logic holds it up for a few seconds
    fact bt_scanning = false
    fact bt_working = false         // a device is being connected or disconnected (its row pulses)
    text wifi_pw = ""               // the password field open under a row
    event wifi_join_go ->           // its Join button, or Enter in the field
    event bt_pick ->                // a device row's own button: connect, or leave it
    event bt_forget ->              // a device row's Forget
    event bt_scan ->                // the rescan button
    //  Do Not Disturb is a preference the logic keeps in `dnd.json`; Caffeine is whether hypridle
    //  has been stopped, which the logic asks the system rather than remembering.
    fact dnd_on = false
    fact caf_on = false
    fact caf_avail = true          // hypridle is installed: there is something to hold off
    event togglednd ->
    //  The notifications module: Do Not Disturb with a timer, and the history of what came in.
    model nt_hist max 30 { title: text; sub: text; when: text }
    text nt_tile_sub = ""          // the tile's second line: Silenced · 23:41, 12 in history, All clear
    text dnd_left = ""             // the window's DND row: 23:41 left, On until turned off, Off
    fact dnd_len = 0               // minutes of the timer that is running (which chip is lit), 0 for none
    event dnd_for ->               // a timer chip: minutes
    event nt_clear ->              // the Clear button
    event nt_hist_del ->           // a history row's cross, by position
    fact caf_len = 0               // minutes of the Caffeine timer that is running (which chip is lit), 0 for none
    text caf_left = ""             // the Caffeine window's row: 23:41 left, On until turned off, Off
    text caf_tile_sub = ""         // the tile's second line while a timer runs: Awake · 23:41
    event togglecaf ->
    event caf_for ->               // a timer chip: minutes, or 0 for until it is turned off
    //  Capture and Power, the third row of tiles: screenshots and screen recording, the session and the power profile.
    fact rec_on = false            // wf-recorder is running
    text rec_time = ""             // how long, 1:23
    fact pow_prof = -1             // 0 power saver, 1 balanced, 2 performance, -1 no power-profiles-daemon
    event shot ->                  // 0 a region, 1 the whole screen
    event rec_start ->             // the same
    event rec_stop ->
    event rec_toggle ->            // the tile's button
    event pow_press ->             // a session button held for one second: 0 lock, 1 sleep, 2 log out, 3 restart, 4 power off
    event pow_prof_set ->          // 0, 1 or 2
    fact ws.active = 1
    repeat i in 1..6 { fact ws.$i.urgent = false }   // a window on that workspace asked for attention while it was out of view
    repeat i in 1..6 { fact ws.$i.busy = false }
    event go ->
    event ov_go ->                     // a click on a workspace in the overview: it closes, then the switch

    //  The colours live in palette-live.plm (ink, faint, mint, tint…); only the veil is the scene's.
    let veil  = 8%
    let glyph_a = 0.4              // how strong the little marks on the toggle knobs are: kept subtle

    shader wave = file "wave.wgsl"
    spring dripl = 46, 8          // the drip down the left: slow enough to see the neck stretch, thin and snap, and loose enough to swing past where it lands
    spring drip = 170, 18         // underdamped: it overshoots and settles back, like a real drop landing
    spring pop  = 300, 12         // snappier and much less damped: a toggle knob popping past where it lands
    spring slide = 220, 24        // the Caffeine thumb: quick, with only a hint of overshoot

    prop drop  = 0 ~drip          // the panel, 0 to 1: it hangs from the bar and falls
    //  The settle: the panel hangs a few px lower when it lands and eases back. Critically damped, so it is one slow hump and never a bounce.
    spring hang = 260, 32
    prop sag   = 0 ~hang
    //  The water's own spring, from Marea: a quarter of a second of period and two bounces you can see. A drawer
    //  that lands shakes on it for a moment, as a drop does when it comes to rest.
    spring splash = 420, 13
    prop wobble = 0 ~splash
    //  Where the ripple that crosses the bar is born: 0 at the player controls (the music), 1 in the middle
    //  (a drawer that has just closed, the surface closing over it).
    prop ring_mid = 0 ~30ms
    prop hot   = 0 ~quick         // the bar, when the pointer is on it
    prop f1    = 0 ~200ms        // what is inside, arriving one after another
    prop f2    = 0 ~380ms
    prop f3    = 0 ~520ms
    prop f4    = 0 ~380ms          // the calendar's second stage
    prop f5    = 0 ~620ms          // the controls drawer, third in: brightness
    prop f6    = 0 ~700ms          // fourth: wifi
    prop f7    = 0 ~780ms          // fifth: bluetooth
    prop glass_bend_pill = 0 ~pop    // the Glass page's lens switch, popping past where it lands
    follow glass_bend_pill = if(glass_bend, 1, 0)
    prop wifi_on = 0 ~pop         // the wifi toggle pill, popping past where it lands
    prop wifi_extra = 0 ~calm     // 0..1: whether a Wi-Fi row is open
    //  The Wi-Fi toggle's own motion: finger down, a press held long enough, the tile filling with colour, the ring from the touch.
    prop wf_press = 0 ~pop        // 0..1: the pill is being pressed
    prop wf_hold = 0 ~calm        // 0..1: held long enough, so the pill has grown into a signal meter
    prop wf_fill = 0 ~700ms       // 0..1: the colour that floods the tile from the toggle
    prop wf_rip = 1 ~700ms        // 0..1: the ring that leaves the touch point and fades
    fact wf_held = false          // the press became a hold: letting go then does not flip the radio
    fact wf_rx = 0                // where the ring started (surface coordinates)
    fact wf_ry = 0
    //  The same motion on the other control center toggles (Bluetooth, Notifications, Caffeine).
    prop bt_press = 0 ~pop
    prop bt_rip = 1 ~700ms
    prop bt_fill = 0 ~700ms
    fact bt_rx = 0
    fact bt_ry = 0
    prop dnd_press = 0 ~pop
    prop dnd_rip = 1 ~700ms
    prop dnd_fill = 0 ~700ms
    fact dnd_rx = 0
    fact dnd_ry = 0
    prop caf_press = 0 ~pop
    prop dnd_sel = 0 ~slide         // which Do Not Disturb stop the thumb is on (0 = Off, 1 = 15m .. 4 = 2h, 5 = until turned off)
    let dnd_sel_t = if(not dnd_on, 0, if(dnd_len == 15, 1, if(dnd_len == 30, 2, if(dnd_len == 60, 3, if(dnd_len == 120, 4, 5)))))
    prop nt_rip = 1 ~700ms
    fact nt_rx = 0
    fact nt_ry = 0
    prop caf_sel = 0 ~slide         // which Caffeine stop the thumb is on (0 = Off, 1 = 15m .. 5 = 4h, 6 = until off)
    let caf_sel_t = if(not caf_on, 0, if(caf_len == 15, 1, if(caf_len == 30, 2, if(caf_len == 60, 3, if(caf_len == 120, 4, if(caf_len == 240, 5, 6))))))
    prop cs_rip = 1 ~700ms
    fact cs_rx = 0
    fact cs_ry = 0
    prop caf_rip = 1 ~700ms
    prop caf_fill = 0 ~700ms
    fact caf_rx = 0
    fact caf_ry = 0
    prop wifi_sel = 0 ~calm       // which row, as a position: slides from one row to the next
    prop bt_extra = 0 ~calm       // 0..1: whether a Bluetooth row is open
    prop bt_pf = 0 ~calm          // the room its audio profiles take, once open
    prop bt_sel  = 0 ~calm        // which row, as a position: slides from one row to the next
    prop bt_on   = 0 ~pop         // the bluetooth toggle pill, popping past where it lands
    prop media_open = 0 ~drip      // the media plate: a sliver with nothing playing, a full card with something to show
    //  Each panel has its own amount, 0 shut .. 1 open. Each one is a drawer that comes out of the
    //  bar and melts into it; the calendar is as wide as the bar, the others are narrower.
    prop dc    = 0 ~drip
    prop dk    = 0 ~drip
    prop dm    = 0 ~drip          // the player's panel, hanging from the window title
    prop do    = 0 ~drip          // the volume / notification drawer
    prop dz    = 0 ~drip          // the desk's drawer, out of the right frame
    prop ds    = 0 ~drip          // the settings panel
    prop fs    = 0 ~300ms         // what is in it, fading in
    prop dl    = 0 ~drip          // the launcher
    prop fl    = 0 ~300ms         // what is in it, fading in
    prop lr    = 1 ~calm          // how many rows it has room for
    prop fo    = 0 ~300ms         // what is in it, fading in
    prop okv   = 0 ~calm          // 1 while it is the volume that is drawn
    prop okn   = 0 ~calm          // 1 while it is a notification
    prop oks   = 0 ~calm          // 1 while it is a screenshot
    prop osd_h = 64 ~calm         // the height of its plate: a notification is taller with text and buttons
    prop nt_ring = 1 ~900ms       // a ripple off the notification's tile: 0 born, 1 gone
    prop expand = 0 ~drip          // a tile growing into its own window, 0 tile .. 1 full window
    //  The music: fast, and a little loose, so the bar bounces on the beat.
    spring beat = 480, 15
    prop pulse = 0 ~beat
    prop ring  = 1 ~900ms          // a ripple crossing the bar: 0 born, 1 gone
    prop dd    = 0 ~calm           // the output dropdown, 0 shut .. 1 open
    prop vm    = 0 ~calm           // the per-app mixer, 0 shut .. 1 open
    prop mvis  = 0 ~calm           // 1 while there is an app playing sound (or the mixer is open): the dots show
    prop swap  = 1 ~700ms          // the cover popping in on a new song: 0 just changed, 1 settled
    prop playf = 0 ~calm           // 1 while playing: the cover is full and colourful
    prop mshow = 0 ~calm          // the bar's player controls: there while a player exists, paused or not

    follow drop = if(panel != none, 1, 0)
    follow dtrav = if(panel != none, 1, 0)
    follow hot  = if(panel != none, 1, 0)
    follow dc   = if(panel == calendar, 1, 0)
    follow dk   = if(panel == controls, 1, 0)
    follow dm   = if(panel == player or panel == tray, 1, 0)
    follow do   = if(osd_on, 1, 0)
    follow dz   = if(desk_open, 1, 0)
    follow ds   = if(panel == settings, 1, 0)
    follow dl   = if(panel == launch, 1, 0)
    follow lr   = max(1, lcount, if(lp_on, 6, 1))
    follow okv  = if(osd_kind == vol, 1, 0)
    follow okn  = if(osd_kind == note, 1, 0)
    follow oks  = if(osd_kind == shot, 1, 0)
    on ntnew {
        nt_ring: 0 ~16ms
        nt_ring: 1 ~800ms after 30ms
    }
    follow expand = if(panel_sub != none, 1, 0)
    //  Which window to actually draw. It jumps to match `panel_sub` the moment
    //  that becomes something - opening one, or switching straight to the other
    //  - but not back to `none`: closing is `expand` fading the same window out,
    //  so it has to stay named while that happens.
    on change panel_sub while panel_sub != none { showing_sub = panel_sub }
    on change panel_sub { wifi_open_row = -1; bt_open_row = -1 }
    //  Each workspace's indicator has its own amount of «active», 0..1, and morphs by it: the one that
    //  becomes active widens and turns mint in place while the one that stops shrinks back. Nothing
    //  travels. The speed is one with no overshoot: a morph, not a bounce.
    prop ws.act.1 = 0 ~260ms
    prop ws.act.2 = 0 ~260ms
    prop ws.act.3 = 0 ~260ms
    prop ws.act.4 = 0 ~260ms
    prop ws.act.5 = 0 ~260ms
    follow ws.act.1 = if(ws.active == 1, 1, 0)
    follow ws.act.2 = if(ws.active == 2, 1, 0)
    follow ws.act.3 = if(ws.active == 3, 1, 0)
    follow ws.act.4 = if(ws.active == 4, 1, 0)
    follow ws.act.5 = if(ws.active == 5, 1, 0)
    //  Where the active one is, as a number that moves smoothly between slots while two are morphing
    //  (the amounts of the two add up to 1, so this is their weighted middle).
    let pill = ws.act.1 * 1 + ws.act.2 * 2 + ws.act.3 * 3 + ws.act.4 * 4 + ws.act.5 * 5
    //  Occupied but not active: the dot stretches up into a capsule.
    prop ws.tall.1 = 0 ~lively
    prop ws.tall.2 = 0 ~lively
    prop ws.tall.3 = 0 ~lively
    prop ws.tall.4 = 0 ~lively
    prop ws.tall.5 = 0 ~lively
    follow ws.tall.1 = if(ws.1.busy, 1, 0)
    follow ws.tall.2 = if(ws.2.busy, 1, 0)
    follow ws.tall.3 = if(ws.3.busy, 1, 0)
    follow ws.tall.4 = if(ws.4.busy, 1, 0)
    follow ws.tall.5 = if(ws.5.busy, 1, 0)
    //  The mark of the workspace in view is one piece that travels: its head runs ahead to the new place and its tail follows, so it
    //  stretches across what lies between and gathers again.
    prop pl.head = 1 ~150ms
    prop pl.tail = 1 ~400ms
    follow pl.head = ws.active
    follow pl.tail = ws.active
    //  A workspace that is out of view and has a window asking for attention: its dot warms and breathes until you go there.
    let warm = #ff7a59
    prop ws.urg.1 = 0 ~calm
    prop ws.urg.2 = 0 ~calm
    prop ws.urg.3 = 0 ~calm
    prop ws.urg.4 = 0 ~calm
    prop ws.urg.5 = 0 ~calm
    follow ws.urg.1 = if(ws.1.urgent, 1, 0)
    follow ws.urg.2 = if(ws.2.urgent, 1, 0)
    follow ws.urg.3 = if(ws.3.urgent, 1, 0)
    follow ws.urg.4 = if(ws.4.urgent, 1, 0)
    follow ws.urg.5 = if(ws.5.urgent, 1, 0)

    on change drop > 0.97 while drop > 0.97 { impulse sag 220; impulse wobble -260 }
    //  The volume's and notifications' drawer lands the same way (it is no longer a value of `panel`, so `drop` does not follow it).
    on change do0 > 0.97 while do0 > 0.97 { impulse sag 220; impulse wobble -260 }
    //  The same moments as in Marea, for the left layout's drop: it lets go (the edge jumps and bounces, two ripples set off, a small drop stays
    //  hanging and is swallowed), it is grabbed on its way back, and the edge closes over it once it has gone in.
    on change dsl > 0.84 while dsl > 0.84 and lm > 0.5 { impulse pbounce -280; impulse wobble -520; prip: 0 ~16ms; prip: 1 ~1100ms after 30ms; pstray: 1 ~16ms; pstray: 0 ~700ms after 60ms }
    on change dsl < 0.84 while dsl < 0.84 and lm > 0.5 { impulse wobble 300; impulse pbounce 80 }
    on change dsl < 0.06 while dsl < 0.06 and lm > 0.5 { impulse pbounce -200; impulse wobble -160; prip: 0 ~16ms; prip: 1 ~900ms after 30ms }
    //  A drawer that has gone back into the bar: the surface closes over it, and a ripple runs out from the
    //  middle of the bar (the same wave the music makes, from another place).
    on change drop < 0.08 while drop < 0.08 and panel == none {
        impulse wobble 90
        ring_mid: 1 ~0ms
        ring: 0 ~16ms
        ring: 1 ~900ms after 30ms
    }
    //  What is inside a panel arrives after the drawer has come down, not with it (it was showing while the
    //  drawer was still a sliver under the bar, over the bar's lower half), and leaves at once when the panel
    //  closes, so nothing is left hanging over the bar as it shuts. Each keeps its own spring, so the
    //  controls' plates still arrive one after another.
    on change panel while panel == calendar   { f1: 1 after 220ms; f4: 1 after 300ms }
    on change panel while panel != calendar   { f1: 0 ~80ms; f4: 0 ~80ms }
    on change panel while panel == controls   { f2: 1 after 200ms; f5: 1 after 200ms; f6: 1 after 200ms; f7: 1 after 200ms }
    on change panel while panel != controls   { f2: 0 ~80ms; f5: 0 ~80ms; f6: 0 ~80ms; f7: 0 ~80ms }
    on change panel while panel == player     { dm_mode = dmm_player }
    on change panel while panel == tray       { dm_mode = dmm_tray }
    on change panel while panel == player or panel == tray { f3: 1 after 200ms }
    on change panel while panel != player and panel != tray { f3: 0 ~80ms }
    on change panel while panel == settings   { fs: 1 after 220ms }
    on change panel while panel == launch     { fl: 1 after 200ms; focus lq; emit launch_open }
    on change panel while panel != launch     { fl: 0 ~80ms }
    on change panel while panel != settings   { fs: 0 ~80ms }
    on change osd_on while osd_on { fo: 1 after 140ms }
    on change osd_on while not osd_on { fo: 0 ~80ms }
    follow wifi_on = if(net.wifi, 1, 0)
    follow wf_fill = if(net.wifi, 1, 0)
    follow bt_fill = if(bt.powered, 1, 0)
    follow dnd_fill = if(dnd_on, 1, 0)
    follow caf_fill = if(caf_on, 1, 0)
    follow dnd_sel = if(not dnd_on, 0, if(dnd_len == 15, 1, if(dnd_len == 30, 2, if(dnd_len == 60, 3, if(dnd_len == 120, 4, 5)))))
    follow caf_sel = if(not caf_on, 0, if(caf_len == 15, 1, if(caf_len == 30, 2, if(caf_len == 60, 3, if(caf_len == 120, 4, if(caf_len == 240, 5, 6))))))
    follow wifi_extra = if(wifi_open_row >= 0, 1, 0)
    on change wifi_open_row while wifi_open_row >= 0 and wifi_extra < 0.05 { wifi_sel: wifi_open_row ~0ms }
    on change wifi_open_row while wifi_open_row >= 0 and wifi_extra >= 0.05 { wifi_sel: wifi_open_row }
    follow bt_extra = if(bt_open_row >= 0, 1, 0)
    follow bt_pf = bt_pf_h
    on change bt_open_row while bt_open_row >= 0 and bt_extra < 0.05 { bt_sel: bt_open_row ~0ms }
    on change bt_open_row while bt_open_row >= 0 and bt_extra >= 0.05 { bt_sel: bt_open_row }
    follow bt_on   = if(bt.powered, 1, 0)
    prop dnd_pill = 0 ~pop
    prop caf_pill = 0 ~pop
    prop rec_pill = 0 ~pop
    fact pw_s0 = 0                   // when the Lock button was pressed (`time`)
    prop pw_hp0 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d0 = false               // it is being held
    follow pw_hp0 = if(pw_d0, clamp((time - pw_s0) / 1, 0, 1), 0)
    fact pw_s1 = 0                   // when the Sleep button was pressed (`time`)
    prop pw_hp1 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d1 = false               // it is being held
    follow pw_hp1 = if(pw_d1, clamp((time - pw_s1) / 1, 0, 1), 0)
    fact pw_s2 = 0                   // when the Log out button was pressed (`time`)
    prop pw_hp2 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d2 = false               // it is being held
    follow pw_hp2 = if(pw_d2, clamp((time - pw_s2) / 1, 0, 1), 0)
    fact pw_s3 = 0                   // when the Restart button was pressed (`time`)
    prop pw_hp3 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d3 = false               // it is being held
    follow pw_hp3 = if(pw_d3, clamp((time - pw_s3) / 1, 0, 1), 0)
    fact pw_s4 = 0                   // when the Power off button was pressed (`time`)
    prop pw_hp4 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d4 = false               // it is being held
    follow pw_hp4 = if(pw_d4, clamp((time - pw_s4) / 1, 0, 1), 0)
    prop pow_th = 1 ~pop                // where the power-profile thumb is: 0 saver, 1 balanced, 2 performance
    prop wp_show_pill = 0 ~pop
    prop iris_pill = 0 ~pop
    prop bar_lm = 0 ~calm
    prop pw_x = 450 ~90ms
    prop dtrav = 0 ~dripl             // how far a panel has come out of the strip, 0 to 1 (the left layout's own, slow, drop)
    prop pbounce = 0 ~splash          // the strip's edge bouncing when the thread breaks
    prop prip = 1 ~1100ms              // the ripple that runs along the strip's edge, 0 just born, 1 gone
    prop pstray = 0 ~700ms            // the small drop that is left hanging from the edge
    prop pw_y = 20 ~90ms
    prop rand_spin = 0 ~pop
    prop set_pg = 0 ~calm
    prop set_pgd = 0 ~calm
    prop set_pgh = 0 ~calm
    prop set_pga = 0 ~calm
    prop set_pgn = 0 ~calm
    prop set_pgs = 0 ~calm
    prop set_pgt = 0 ~calm
    prop set_pgl = 0 ~calm
    prop set_pgw = 0 ~calm
    prop set_pgv = 0 ~calm
    prop set_pgk = 0 ~calm
    prop set_pgp = 0 ~calm
    prop set_pgb = 0 ~calm
    prop bs.ws = 1 ~calm              // each piece of the bar, 1 shown .. 0 hidden: its room and its opacity
    prop bs.title = 1 ~calm
    prop bs.media0 = 1 ~calm
    prop bs.title0 = 1 ~calm
    prop bs.media = 1 ~calm
    prop bs.sr = 1 ~calm
    prop bs.ctl = 1 ~calm
    prop bs.clock = 1 ~calm
    prop bs.tray = 1 ~calm
    //  The scene's own `time`. If a scene only names `time`, pleamar makes one that never stops, and a scene with a
    //  clock that never stops never rests: it paints every frame for as long as it lives. This one turns only while
    //  something on screen is using it (the scan rings, the pulse of a device being connected, the volume drawer's
    //  face and ripple, the caffeine steam, the urgent dot, the "More" cue), and the scene sleeps the rest of the time.
    prop time = 0
    //  The battery: the bar itself is the gauge. A soft fill grows from its left edge as far as the charge goes, and
    //  goes red below 20 % while it is draining. A machine with no battery (a desktop) draws nothing.
    prop batt_fill = 0 ~calm            // 0..1, the charge, smoothly
    prop batt_on = 0 ~calm              // 1 when there is a battery
    prop batt_low = 0 ~calm             // 1 while below 20 % and not charging
    //  The gauge is not there at rest. It appears (grows a little and fades in) while the pointer is on the bar (any of
    //  its zones: a zone is only hovered while it is the topmost one under the pointer, so it is the most of them all),
    //  and stays while the charge is under 20 %, whatever the pointer does.
    prop batt_open = 0 ~calm
    //  While the charger is filling the battery, a soft glint crosses the bar every 5 seconds (and once as soon as it
    //  is plugged in): `charge_sweep` goes from 0 to 1 over 0.9 s and then rests at 1. It is a timer that wakes the
    //  scene for that second and lets it sleep for the other four. A battery that says "charging" at 98 % or more is
    //  full and only being held there, so it does not glint.
    prop charge_sweep = 1 ~calm
    every 5s while pwr.charging and pwr.percent < 98 { charge_sweep: 0 ~0ms; charge_sweep: 1 ~900ms after 40ms }
    on change pwr.charging while pwr.charging and pwr.percent < 98 { charge_sweep: 0 ~0ms; charge_sweep: 1 ~900ms after 40ms }
    repeat i in 1..6 { prop wsh.$i = 0 ~quick }         // each workspace dot's hover, brought out of its `repeat`
    repeat i in 1..6 { prop wsp.$i = 0 ~pop }           // the same, on a spring that pops a little past: how much a hovered mark swells
    follow batt_fill = clamp(pwr.percent / 100, 0, 1)
    follow batt_on = if(pwr.present, 1, 0)
    follow batt_low = if(pwr.percent < 20 and not pwr.charging, 1, 0)
    prop rcn = 0 ~calm                // the recording dot's slot on the bar, 1 while a recording runs
    prop trn = 0 ~calm                // how many tray icons the bar holds, smoothly: the bar widens with it
    prop disp_auto_pill = 0 ~pop
    prop disp_dd = 0 ~calm            // the resolution dropdown, 0 shut .. 1 open
    prop disp_scroll = 0 ~quick       // the page's scroll, following disp_scroll_to
    prop disp_pn_s = 0 ~calm          // the profiles card's rows, smoothed: it grows and shrinks with them
    prop dnd_wobble = 0 ~pop       // the bell, swung when DND flips
    follow dnd_pill = if(dnd_on, 1, 0)
    follow caf_pill = if(caf_on, 1, 0)
    follow rec_pill = if(rec_on, 1, 0)
    follow pow_th = if(pow_prof < 0, 1, pow_prof)
    follow wp_show_pill = if(wp_show, 1, 0)
    follow iris_pill = if(iris_on, 1, 0)
    follow bar_lm = if(bar_anchor == left, 1, 0)
    follow pw_x = lp_w
    follow rand_spin = rand_turn
    follow set_pg = if(set_page == pg_glass, 1, 0)
    follow set_pgd = if(set_page == pg_disp, 1, 0)
    follow set_pgh = if(set_page == pg_hypr, 1, 0)
    follow set_pgb = if(set_page == pg_bar, 1, 0)
    follow set_pga = if(set_page == pg_about, 1, 0)
    follow set_pgn = if(set_page == pg_night, 1, 0)
    follow set_pgs = if(set_page == pg_sys, 1, 0)
    follow set_pgt = if(set_page == pg_nt, 1, 0)
    follow set_pgl = if(set_page == pg_lock, 1, 0)
    follow set_pgw = if(set_page == pg_wm, 1, 0)
    follow set_pgv = if(set_page == pg_vpn, 1, 0)
    follow set_pgk = if(set_page == pg_clock, 1, 0)
    follow set_pgp = if(set_page == pg_theme, 1, 0)
    follow bs.ws = if(bv.ws, 1, 0)
    follow bs.title = if(bv.title and bar_anchor == top, 1, 0)
    follow bs.media = if(bv.media and bar_anchor == top, 1, 0)
    follow bs.media0 = if(bv.media, 1, 0)
    follow bs.title0 = if(bv.title, 1, 0)
    follow bs.sr = if(bv.sr, 1, 0)
    follow bs.ctl = if(bv.ctl, 1, 0)
    follow bs.clock = if(bv.clock, 1, 0)
    follow bs.tray = if(bv.tray, 1, 0)
    follow trn = bartrays.count
    follow rcn = if(rec_on, 1, 0)
    repeat i in 0..8 {
        prop bcx.$i = 0 ~quick
        prop bcy.$i = 4 ~quick
        prop bcw.$i = 34 ~quick
        follow bcx.$i = bc.$i.x
        follow bcy.$i = bc.$i.y
        follow bcw.$i = bc.$i.w
    }
    //  Settings > Hyprland: what Hyprland has now (see the logic), and the toggles' knobs.
    fact hy_layout = 3
    fact hy_gaps = 5
    fact hy_round = 10
    fact hy_border = 3
    fact hy_sens = 0
    fact hy_follow = 1
    fact hy_resize = false
    fact hy_tear = false
    fact hy_anim = true
    fact hy_nat = false
    //  Settings > Pleamar-WM: what the window manager has now (see the logic). The window manager's own facts are set live; the
    //  input lines go to session.conf and apply at the next login.
    fact wm_layout = 0
    fact wm_share = 0.56
    fact wm_gap = 12
    fact wm_free = false
    fact wm_rain = false
    fact wm_snow = false
    fact wm_ms = 0
    fact wm_ts = 0
    fact wm_nat = false
    fact wm_tap = false
    fact wm_idle = 7
    fact wm_bw = 1.5
    fact wm_ba = 70
    fact wm_rad = 12
    fact wm_shd = 100
    fact wm_tb = 22
    fact wm_tbo = 72
    fact wm_wa = 100
    fact wm_wi = 100
    fact wm_fr = 80
    text wm_fr_text = "80%"
    text wm_wa_text = "100%"
    text wm_wi_text = "100%"
    text wm_bw_text = "1.5 px"
    text wm_ba_text = "70%"
    text wm_rad_text = "12 px"
    text wm_shd_text = "100%"
    text wm_tb_text = "22 px"
    text wm_tbo_text = "72%"
    fact wm_scroll_to = 0
    prop wm_scroll = 0 ~quick
    follow wm_scroll = wm_scroll_to
    text wm_share_text = "56%"
    text wm_gap_text = "12 px"
    text wm_ms_text = "0.00"
    text wm_ts_text = "0.00"
    text wm_idle_text = "7 min"
    prop wm_k0 = 0 ~pop
    prop wm_k1 = 0 ~pop
    prop wm_k2 = 0 ~pop
    prop wm_k3 = 0 ~pop
    follow wm_k0 = if(wm_free, 1, 0)
    follow wm_k1 = if(wm_rain, 1, 0)
    follow wm_k2 = if(wm_snow, 1, 0)
    follow wm_k3 = if(wm_nat, 1, 0)
    prop wm_k4 = 0 ~pop
    follow wm_k4 = if(wm_tap, 1, 0)
    //  The About page (Settings > System): what this shell is built from, and how to update it.
    text about_commit = "…"
    text about_date = ""
    text about_sub = ""
    text about_pl = ""
    text about_msg = ""
    fact about_behind = -1              // commits waiting upstream; -1 not known yet
    fact about_busy = false
    fact about_restarting = false   // Restart was pressed: the shell is about to be replaced (the only reason to grey the button out)
    //  Night mode (Settings > Night mode): a warm tint over the whole screen, made by Hyprland's screen shader (see the
    //  logic), by hand or on a schedule.
    fact night_on = false               // the shader is on now
    fact night_auto = false             // it switches itself on and off on the schedule
    fact night_t = 0.65                 // how warm, 0 (6500 K) to 1 (2500 K), along the slider
    text night_temp_text = "3900 K"
    text night_start_text = "9:00 PM"
    text night_end_text = "6:00 AM"
    text night_status = "Off"
    prop night_pill = 0 ~pop
    prop night_auto_pill = 0 ~pop
    follow night_pill = if(night_on, 1, 0)
    follow night_auto_pill = if(night_auto, 1, 0)
    //  Settings > Lock screen: what the lock screen scene holds. The logic asks it when the page opens (`lk_ok` is false if it did not
    //  answer) and tells it what is changed; the lock screen keeps them in its own lockscreen.json.
    fact lk_blur = 36                  // pixels at 1920 wide: 18, 36 or 60 are the chips
    fact lk_12h = true
    fact lk_ampm = true
    fact lk_media = true
    fact lk_date: lkd_long | lkd_std | lkd_day | lkd_iso = lkd_long
    fact lk_ok = true
    //  Settings > Clock: the desktop clock is a scene of its own (desktopclock/), which keeps its settings in its own desktopclock.json. This page asks it
    //  for them when it opens (`ck_ok` is false when it does not answer, which is when it is not running) and tells it each change.
    fact ck_on = false
    fact ck_lay = 0                    // the layout: 0 pipe, 1 rule, 2 tower, 3 capsule, 4 slash, 5 hero
    fact ck_pos = 4                    // where it sits, row by row: 0 top left, 1 top, 2 top right, 3 left, 4 centre, 5 right, 6 bottom left, 7 bottom, 8 bottom right
    fact ck_px = 220                   // the digits' height: 140, 220, 280 or 340
    fact ck_12h = true
    fact ck_wt = 1                     // the strokes: 0 thin, 1 regular, 2 bold
    fact ck_cl = 1                     // the glass: 0 clear, 1 soft, 2 full
    fact ck_ok = true
    prop ck_pill = 0 ~pop
    follow ck_pill = if(ck_on, 1, 0)
    prop ck_mx = 1 ~quick              // the marker on the position grid: column and row, 0 to 2
    prop ck_my = 1 ~quick
    follow ck_mx = if(ck_pos == 0 or ck_pos == 3 or ck_pos == 6, 0, if(ck_pos == 2 or ck_pos == 5 or ck_pos == 8, 2, 1))
    follow ck_my = if(ck_pos < 3, 0, if(ck_pos < 6, 1, 2))
    event ck_toggle ->
    event ck_lay_set ->                // 0 to 5, as above
    event ck_pos_set ->                // 0 to 8, as above
    event ck_size_set ->               // 0 small, 1 medium, 2 large, 3 extra large
    event ck_12h_set ->                // 1 twelve hours, 0 twenty-four
    event ck_wt_set ->
    event ck_cl_set ->
    prop lk_pill_am = 0 ~pop
    prop lk_pill_md = 0 ~pop
    follow lk_pill_am = if(lk_ampm, 1, 0)
    follow lk_pill_md = if(lk_media, 1, 0)
    event lk_blur_set ->               // 0 light, 1 medium, 2 heavy
    event lk_12h_set ->                // 1 twelve hours, 0 twenty-four
    event lk_ampm_toggle ->
    event lk_media_toggle ->
    event lk_date_set ->               // 0 long, 1 standard, 2 day first, 3 ISO
    //  The password bar on that page: what a typed character becomes, in what colours, and the example bar that is typed into (nothing typed
    //  is kept). They are the lock screen's own mask_style and shape_palette.
    fact lk_mask: lkm_shapes | lkm_dots | lkm_stars | lkm_special = lkm_shapes
    fact lk_pal: lkc_vibrant | lkc_accent | lkc_neon | lkc_pastel | lkc_mono = lkc_accent
    event lk_mask_set ->               // 0 shapes, 1 dots, 2 asterisks, 3 special
    event lk_pal_set ->                // 0 vibrant, 1 accent, 2 neon, 3 pastel, 4 monochrome
    text lb_pw = ""
    model lb max 16 { idx: number; rot: number; outline: bool; ci: number; sym: text }
    fact lb_ok = false                 // the example's pretend "unlocked"
    prop lb_okt = 0 ~calm
    follow lb_okt = if(lb_ok, 1, 0)
    event lb_submit ->
    figure lkshp = file "lockscreen/shapes.svg"
    fact lk_px = 200                   // the lock screen's clock size: 100, 150 or 200
    fact lk_secs = false               // seconds on its clock
    fact lk_power = true               // the sleep, restart and power off buttons on it
    prop lk_pill_sec = 0 ~pop
    follow lk_pill_sec = if(lk_secs, 1, 0)
    prop lk_pill_pw = 0 ~pop
    follow lk_pill_pw = if(lk_power, 1, 0)
    event lk_size_set ->               // 0 → 100, 1 → 150, 2 → 200
    event lk_secs_toggle ->
    event lk_power_toggle ->
    //  Where the clock, the password bar and the buttons are: on every monitor, or on one. `lk_mon` is 0 for all, or 1 and up for a monitor's slot.
    fact lk_mon = 0
    repeat i in 0..4 {
        fact lk_m.$i.on = false
        text lk_m.$i.name = ""
    }
    event lk_mon_set ->
    event lk_test ->                   // lock now, as a test: Esc or a minute opens it
    fact lk_scroll_to = 0              // the page scrolls like System monitor's
    prop lk_scroll = 0 ~quick
    follow lk_scroll = lk_scroll_to
    event night_toggle ->
    event night_auto_toggle ->
    event night_temp_set ->             // the slider: 0..1
    event night_start_step ->           // -1 or 1, a half hour
    event night_end_step ->
    //  The wallpaper picker (SUPER + B): glass hexagons centred on the screen, drawn at the end of this scene. Every wallpaper is one
    //  hexagon (its picture already cut to the hexagon by the logic); how many there are sets how big they are, so that they always fill
    //  the tray. The logic makes the pictures (`wp_picker`), orders them by colour and does the awww side of a pick.
    model wp_picker max 200 { img: image 104, 120; hue: number; cur: bool; dim: bool; name: text }       // the picture is 124 x 143 (120 x 139 and two transparent pixels all round), and the cell is declared smaller, 104 x 120, in the same shape (the picture is fitted inside it; the resting tiles are drawn at about that size): every image takes its whole cell from the atlas (one 2048 x 2048 texture, shared with the text), and at 186 x 215 only about a hundred of the hundred and thirty-seven tiles fitted, the rest were drawn empty
    fact wp_picker_open = false
    text wp_picker_status = ""                // "Reading your wallpapers… 42 of 137" while the first analysis runs
    text wp_picker_hero_name = ""             // the name of the hexagon under the pointer
    fact wp_picker_hero_cur = false           // the one under the pointer is the wallpaper in use
    fact wp_picker_hot = -1                   // the hexagon under the pointer, -1 none
    fact wp_picker_px = 0                     // where a pick was, for awww: pixels from the bottom left
    fact wp_picker_py = 0
    event wp_picker_toggle ->
    event wp_picker_pick ->
    event wp_picker_random ->
    fact wp_picker_leaving = false            // a wallpaper was picked: the tray fades so the desktop's own transition shows
    prop wp_picker_veil = 1 ~calm             // 1 normal, 0 while it is leaving
    follow wp_picker_veil = if(wp_picker_leaving, 0, 1)
    prop wp_picker_show = 0 ~calm             // 0 shut, 1 open
    follow wp_picker_show = if(wp_picker_open, 1, 0)
    //  The hexagon under the pointer is drawn again, on top, as a piece of liquid glass (see the end of the scene): it swells
    //  with a spring that overshoots, glides from one hexagon to the next, has a light sweep across it each time the pointer
    //  arrives, and its edge ripples (`liquid.wgsl`).
    shader liquid = file "liquid.wgsl"
    spring wp_picker_pop = 240, 14             // a spring that overshoots (about 17%): the snap out to the large size bounces
    fact wp_picker_hx = 0                     // where the hovered hexagon is
    fact wp_picker_hy = 0
    prop wp_picker_hs = 0 ~wp_picker_pop            // 0 at rest, 1 hovered (it overshoots)
    prop wp_picker_lx = 0 ~quick
    prop wp_picker_ly = 0 ~quick
    prop wp_picker_sw = 0 ~calm               // the light sweep's progress, 0 to 1
    //  Every tile has its own spring for how hovered it is, so each one morphs from small to large (and back) with a bounce.
    repeat i in 0..200 {
        prop gt.$i = 0 ~wp_picker_pop
        follow gt.$i = if(wp_picker_hot == i and wp_picker_open, 1, 0)
    }
    follow wp_picker_hs = if(wp_picker_hot >= 0 and wp_picker_open, 1, 0)
    prop wp_picker_tx = 0 ~quick              // where the pointer is on the hovered tile, about -0.5 to 0.5 across and down: the tilt follows it
    prop wp_picker_ty = 0 ~quick
    follow wp_picker_lx = wp_picker_hx
    follow wp_picker_ly = wp_picker_hy
    on change wp_picker_hot while wp_picker_hot >= 0 { wp_picker_sw: 0 ~40ms }
    on change wp_picker_hot while wp_picker_hot >= 0 { wp_picker_sw: 1 ~700ms after 60ms }
    on change wp_picker_open while not wp_picker_open { wp_picker_hot = -1 }
    on key Escape while wp_picker_open { wp_picker_open = false }
    //  The workspace overview (right-click the bar's workspace dots, or the launcher): a card for each of the five workspaces,
    //  listing the windows on it. The logic fills `ovw` a slot at a time (nine to a workspace, in order) from `hyprctl clients`, each with a
    //  picture of the window taken while its workspace was in front.
    model ovw max 45 { gx: number; gy: number; gc: number; gr: number; title: text; active: bool; used: bool; snap: bool; icon: image 37, 37; thumb: image 456, 257 }
    repeat i in 0..5 { fact ov_cnt.$i = 0 }   // how many windows each workspace has 
    fact ov_else = 0                          // windows that are not on one of the five (special workspaces)
    fact ov_open = false
    event ov_toggle ->
    event ov_move ->                          // a window dropped on another workspace: its slot (and `ov_col`, the column)
    fact ov_drag = -1                         // the tile being held
    fact ov_col = 0                           // the column it was dropped on
    fact ov_dx = 0                            // how far it has been dragged
    fact ov_px = 0                            // where it was pressed: the card carried is there plus the drag
    fact ov_py = 0
    fact ov_dy = 0
    fact ov_hot = -1                          // the tile under the pointer
    event ov_focus ->
    prop ov_show = 0 ~calm
    follow ov_show = if(ov_open, 1, 0)
    on key Escape while ov_open { ov_open = false }
    on change ov_open while not ov_open { ov_drag = -1; ov_dx = 0; ov_dy = 0; ov_hot = -1 }
    //  The authentication dialog. Vitreus is this session's polkit agent (bin/vitreus-polkit-agent, which the logic starts): when
    //  something asks for admin rights, the agent sets `pk_open` and the texts below; when Authenticate is pressed it reads the
    //  password out of `pk_pw` itself and clears the field.
    fact pk_open = false
    fact pk_busy = false            // polkit's helper is checking the password
    fact pk_shake = false           // the last password was wrong (and, with it, `pk_error` is showing)
    text pk_message = ""            // what polkit says: "Authentication is required to ..."
    text pk_user = ""               // whose password it asks for
    text pk_error = ""
    text pk_pw = ""                 // the password field
    fact pk_go = false              // Enter or Authenticate was pressed: the agent sees it, reads the field, and puts this back
    prop pk_show = 0 ~calm
    prop pk_sk = 0 ~pop             // the card's shake when the password is wrong
    follow pk_show = if(pk_open, 1, 0)
    on change pk_open while pk_open { focus pk_pw }
    on change pk_shake while pk_shake { pk_sk: -1 ~30ms }
    on change pk_shake while pk_shake { pk_sk: 0 ~450ms after 70ms }
    //  Everything here is the scene's own, so the dialog can always be put away: closing it (`pk_open` false) is what cancels the
    //  request, which the agent notices by asking; nothing has to get through the logic.
    on key Escape while pk_open { pk_open = false }
    on submit pk_pw { pk_go = true }
    //  Settings > System monitor. While that page is showing the logic runs bin/vitreus-sysmon, which prints what the machine is doing once a
    //  second; the logic turns it into the facts, texts and models below (nothing runs while the page is shut). The numbers that draw
    //  something are 0 to 1; the `*_p` springs smooth them so a gauge glides between readings.
    fact sm_scroll_to = 0
    prop sm_scroll = 0 ~quick
    follow sm_scroll = sm_scroll_to
    fact sm_cpu = 0                     // total CPU load, 0..1
    fact sm_mem_f = 0                   // memory in use
    fact sm_cache_f = 0                 // and in caches (which can be given back)
    fact sm_swap_f = 0
    fact sm_gpu_on = false              // a GPU that reports itself
    fact sm_gpu_f = 0                   // its load
    fact sm_vram_f = 0                  // its memory
    fact sm_pw_f = 0                    // its power draw against its limit
    prop sm_cpu_p = 0 ~calm
    prop sm_mem_p = 0 ~calm
    prop sm_cache_p = 0 ~calm
    prop sm_swap_p = 0 ~calm
    prop sm_gpu_p = 0 ~calm
    prop sm_vram_p = 0 ~calm
    prop sm_pw_p = 0 ~calm
    follow sm_cpu_p = sm_cpu
    follow sm_mem_p = sm_mem_f
    follow sm_cache_p = sm_cache_f
    follow sm_swap_p = sm_swap_f
    follow sm_gpu_p = sm_gpu_f
    follow sm_vram_p = sm_vram_f
    follow sm_pw_p = sm_pw_f
    text sm_host = ""
    text sm_cpu_name = ""
    text sm_kernel = ""
    text sm_uptime = ""
    text sm_load = ""
    text sm_cpu_txt = "0%"
    text sm_cpu_meta = ""               // 3.2 GHz · 46°C
    text sm_threads = ""
    text sm_mem_pct = "0%"
    text sm_mem_total = ""
    text sm_mem_used = ""
    text sm_mem_cache = ""
    text sm_mem_free = ""
    text sm_swap_txt = ""
    text sm_gpu_name = ""
    text sm_gpu_txt = "0%"
    text sm_gpu_vram = ""
    text sm_gpu_power = ""
    text sm_gpu_temp = ""
    text sm_gpu_fan = ""
    text sm_gpu_clock = ""
    text sm_iface = ""
    text sm_rx_txt = ""
    text sm_tx_txt = ""
    text sm_rx_total = ""
    text sm_tx_total = ""
    text sm_dr_txt = ""
    text sm_dw_txt = ""
    text sm_fans = ""
    model sm_core max 32 { pct: number }
    model sm_hist max 60 { cpu: number; mem: number; gpu: number; rx: number; tx: number; dr: number; dw: number }
    model sm_mnt max 6 { name: text; info: text; pct: number }
    model sm_tmp max 8 { label: text; txt: text; f: number; heat: number }
    model sm_proc max 8 { name: text; cpu_txt: text; mem_txt: text; cpu: number }
    //  Settings > VPN (see "Settings > VPN" in vitreus.luau): the profiles NetworkManager holds, and a form to add one.
    fact vpn_scroll_to = 0
    prop vpn_scroll = 0 ~quick
    follow vpn_scroll = vpn_scroll_to
    fact vpn_mode: vpm_wg | vpm_ovpn | vpm_imp = vpm_wg
    fact vpn_tcp = false              // the OpenVPN form: TCP instead of UDP
    fact vpn_busy = false             // something is being connected, deleted or added
    fact vpn_on = false               // a profile is connected
    fact vpn_count = 0
    fact vpn_arm = -1                 // the row whose delete button has been pressed once
    text vpn_title = "Not connected"
    text vpn_sub = ""
    text vpn_msg = ""
    text vpn_file = ""
    text vpnw_name = ""
    text vpnw_addr = ""
    text vpnw_key = ""
    text vpnw_peer = ""
    text vpnw_end = ""
    text vpnw_dns = ""
    text vpnw_ips = ""
    text vpnw_psk = ""
    text vpno_name = ""
    text vpno_server = ""
    text vpno_port = ""
    text vpno_user = ""
    text vpno_pw = ""
    text vpno_ca = ""
    event vpn_refresh ->
    event vpn_toggle ->
    event vpn_down ->
    event vpn_arm_ask ->
    event vpn_delete ->
    event vpn_import ->
    event vpn_add_wg ->
    event vpn_add_ovpn ->
    event vpn_fpick ->                // a row of the file browser on the Import tab
    event vpn_fscroll ->
    fact vpn_fmore = false            // the folder has more rows than the browser shows
    text vpn_dir = ""
    repeat i in 0..8 {
        fact vpn_f.$i.on = false
        fact vpn_f.$i.dir = false
        text vpn_f.$i.name = ""
    }
    repeat i in 0..8 {
        fact vpn_r.$i.on = false
        fact vpn_r.$i.active = false
        text vpn_r.$i.name = ""
        text vpn_r.$i.sub = ""
    }
    //  Settings > Notifications (see "Notification rules and sounds" in vitreus.luau): the global switches and default sound, the apps that
    //  have sent something, and the rules of the one that is open.
    fact nt_scroll_to = 0
    prop nt_scroll = 0 ~quick
    follow nt_scroll = nt_scroll_to
    fact ntg_sounds = true             // a sound when one is shown
    fact ntg_crit = true               // critical ones ignore Do Not Disturb
    fact nt_quiet = false              // quiet hours are on (Settings > Notifications)
    fact nt_fs = false                 // hold notifications back while a window is fullscreen
    text nt_qfrom_t = ""
    text nt_qto_t = ""
    event nt_q_toggle ->
    event nt_fs_toggle ->
    event nt_q_step ->                 // 0 start earlier, 1 start later, 2 end earlier, 3 end later
    fact ntg_snd = 0                  // the default sound, 0..7
    fact nta_sel = -1                 // the app whose rules are open (its row), -1 none
    fact nta_count = 0
    fact nta_mute = false
    fact nta_silent = false
    fact nta_bypass = false
    fact nta_hide = false
    fact nta_urg = 0                  // 0 as the app sent it, 1 low, 2 normal, 3 critical
    fact nta_to = 0                   // 0 the usual, 1 4 s, 2 8 s, 3 15 s, 4 until dismissed
    fact nta_snd = 0                  // 0 the default sound, else 1..8
    fact nta_has_rule = false
    text nta_name = ""
    text nta_explain = ""
    model nta_apps max 14 { name: text; info: text; rule: bool }
    event nta_pick ->
    event nta_flag ->
    event nta_urgency ->
    event nta_timeout ->
    event nta_sound ->
    event nta_reset ->
    event ntg_flag ->
    event ntg_sound ->
    event nt_test ->
    prop ntk0 = 0 ~pop
    prop ntq0 = 0 ~pop
    prop ntq1 = 0 ~pop
    prop ntk1 = 0 ~pop
    prop ntk2 = 0 ~pop
    prop ntk3 = 0 ~pop
    prop ntk4 = 0 ~pop
    prop ntk5 = 0 ~pop
    follow ntk0 = if(ntg_sounds, 1, 0)
    follow ntk1 = if(ntg_crit, 1, 0)
    follow ntq0 = if(nt_quiet, 1, 0)
    follow ntq1 = if(nt_fs, 1, 0)
    follow ntk2 = if(nta_mute, 1, 0)
    follow ntk3 = if(nta_silent, 1, 0)
    follow ntk4 = if(nta_bypass, 1, 0)
    follow ntk5 = if(nta_hide, 1, 0)
    event about_check ->
    event about_update ->
    event about_restart ->
    text hy_gaps_text = "5 px"
    text hy_round_text = "10 px"
    text hy_border_text = "3 px"
    text hy_sens_text = "0.00"
    prop hy_k0 = 0 ~pop
    prop hy_k1 = 0 ~pop
    prop hy_k2 = 1 ~pop
    prop hy_k3 = 0 ~pop
    follow hy_k0 = if(hy_resize, 1, 0)
    follow hy_k1 = if(hy_tear, 1, 0)
    follow hy_k2 = if(hy_anim, 1, 0)
    follow hy_k3 = if(hy_nat, 1, 0)
    follow disp_auto_pill = if(disp_auto, 1, 0)
    follow disp_dd = if(disp_res_open, 1, 0)
    follow disp_scroll = disp_scroll_to
    follow disp_pn_s = disp_pcount
    on change dnd_on {
        dnd_wobble: -1 ~30ms
        dnd_wobble: 0 ~400ms after 60ms
    }
    follow mshow = if(media_on, 1, 0)
    follow media_open = if(media_on, 1, 0)
    follow playf = if(media.playing, 1, 0)
    on trackchange {
        swap: 0 ~16ms
        swap: 1 ~700ms after 30ms
    }
    follow dd = if(dd_open and panel == controls, 1, 0)
    follow vm = if(vm_open and panel == controls, 1, 0)
    follow mvis = if(mixer.count > 0 or vm_open, 1, 0)
    on launch_toggle { panel = if(panel == launch, none, launch) }
    on settings_toggle { panel = if(panel == settings, none, settings) }
    on change panel { dd_open = false; vm_open = false; panel_sub = none; disp_res_open = false; disp_scroll_to = 0; sm_scroll_to = 0; nt_scroll_to = 0; lk_scroll_to = 0; wm_scroll_to = 0; vpn_scroll_to = 0 }
    on change set_page { disp_res_open = false; disp_scroll_to = 0; sm_scroll_to = 0; nt_scroll_to = 0; lk_scroll_to = 0; wm_scroll_to = 0; vpn_scroll_to = 0; vpn_arm = -1; emit hy_refresh; emit wm_refresh }
    on change panel { tasks_watch = panel == player }
    on pick_out { dd_open = false }
    follow pulse = bass
    //  Every time the bass hits hard, a wave is born at the player controls (the
    //  bar's shader reads `ring` as how far it has travelled). It
    //  has to fall back below the threshold before the next one can be born.
    on change bass > 0.6 while bass > 0.6 {
        ring_mid: 0 ~0ms
        ring: 0 ~16ms
        ring: 1 ~1100ms after 30ms
    }

    //  One number scales the whole shell. The exclusive zone (`reserve` above) is
    //  the bar and a little air: 8 + bar.h + 6. Only along the top: down the left, the room is the windows' gaps
    //  (vitreus_colors.lua), and a reserve there as well would leave an empty strip beside the bar.
    let u = 1.35                    // (the icon models are declared at their size times this: 20 → 27, 22 → 30, 26 → 35)
    let cu = 1.5525                  // u * 1.15: the control center, the calendar and the player and tray are laid out 15% larger than the rest
    let pu = 1.6875                  // u * 1.25: the Settings and the launcher are laid out 25% larger than the rest, at real size (not zoomed)
    //  One reminder of the chosen day: a circle to tick it off, its time, its words, a cross.
    component CalRow(e: record, tick: event, gone: event) {
        //  30 px tall at least, and as tall as its title needs: a reminder wraps onto more lines rather
        //  than being cut short with an ellipsis. Whole pixels (a row at 22 units, x 1.35, sits on a
        //  fraction of a pixel, and text drawn between pixels comes out soft), and the text and the
        //  ring are put on whole pixels too. The ring, time and cross stay level with the first line.
        size: 154 * cu, max(30, floor(14 + wrap.height + 0.5))
        let rowh = max(30, floor(14 + wrap.height + 0.5))
        zone box touch { from: 0, 0; size: 154 * cu, rowh; corner: 8 * cu }
        box { from: 0, 0; size: 154 * cu, rowh; corner: 8 * cu; color: ink; opacity: 6% + 7% * touch.hover }
        ellipse { at: 15, 15; radius: 5.5 * cu; stroke: 1.3 * cu; color: mint; opacity: if(e.done, 0, 85%) }
        ellipse { at: 15, 15; radius: 5.5 * cu; color: mint; opacity: if(e.done, 100%, 0) }
        path { at: 15, 15; stroke: 1.4 * cu; color: onmint; opacity: if(e.done, 100%, 0); move -2.5 * cu, 0; line -0.5 * cu, 2.2 * cu; line 3 * cu, -2.4 * cu }
        text e.time { at: floor(22 * cu + 0.5), 15; anchor: left center; size: 11.5; weight: 600; width: 34 * cu; lines: 1; color: mint; opacity: if(e.done, 40%, 100%); family: "Space Grotesk" }
        column wrap {
            at: floor(56 * cu + 0.5), 7
            text e.title { size: 13; width: 74 * cu; lines: 5; color: ink; opacity: if(e.done, 40%, 100%); family: "Space Grotesk" }
        }
        line { from: 137 * cu, 15 - 3 * cu; to: 143 * cu, 15 + 3 * cu; width: 1.4 * cu; color: ink; opacity: 22% + 60% * touch.hover }
        line { from: 143 * cu, 15 - 3 * cu; to: 137 * cu, 15 + 3 * cu; width: 1.4 * cu; color: ink; opacity: 22% + 60% * touch.hover }
        zone box check_z { at: 15, 15; size: 22 * cu, 30; corner: 11 * cu; cursor: pointer }
        zone box gone_z { at: 140 * cu, 15; size: 20 * cu, 30; corner: 10 * cu; cursor: pointer }
        on press check_z { emit tick(e.index) }
        on press gone_z { emit gone(e.index) }
    }

    //  One row of the Ask tab's conversation (logic/ask.luau cuts it): a message, or the prose or the code of an answer. The first row of a message has its
    //  name above it (and, on an answer, Copy); a piece of code is in a card of its own with its own Copy. As tall as its text needs.
    component AskRow(m: record, copy: event) {
        size: 300 * cu, (if(m.first, 20, 0)) + if(m.kind == 2, 26 * cu + floor(cwrap.height + 0.5) + 12 * cu, floor(wrap.height + 0.5) + 6)
        let hh   = if(m.first, 20, 0)
        let ph   = floor(if(m.kind == 2, cwrap.height, wrap.height) + 0.5)
        text m.who { at: 2, 10; anchor: left center; size: 11; weight: 700; color: if(m.kind == 0, faint, mint); opacity: 90%; family: "Space Grotesk"; show: m.first }
        text "Copy" { at: 300 * cu - 2, 10; anchor: right center; align: right; size: 11; weight: 600; color: mix(faint, mint, hc.hover); family: "Space Grotesk"; show: m.first and m.kind == 1 }
        zone box hc { at: 300 * cu - 22 * cu, 10; size: 44 * cu, 20; cursor: pointer; active: m.first and m.kind == 1 }
        on press hc { emit copy(m.index) }
        column wrap {
            at: 2, hh + 2
            text m.body { size: 13; width: 292 * cu; lines: 400; line_height: 1.25; color: if(m.kind == 3, faint, ink); family: "Space Grotesk"; show: m.kind != 2 }
        }
        group {
            show: m.kind == 2
            box { from: 0, hh + 2; size: 300 * cu, 24 * cu + ph + 12 * cu - 2; corner: 10 * cu; color: ink; opacity: 11% }
            text m.lang { at: 10 * cu, hh + 2 + 12 * cu; anchor: left center; size: 10; weight: 600; color: faint; family: "Space Grotesk" }
            text "Copy" { at: 300 * cu - 10 * cu, hh + 2 + 12 * cu; anchor: right center; align: right; size: 11; weight: 600; color: mix(faint, mint, cc.hover); family: "Space Grotesk" }
            zone box cc { at: 300 * cu - 26 * cu, hh + 2 + 12 * cu; size: 52 * cu, 22 * cu; cursor: pointer }
            on press cc { emit copy(m.index) }
        }
        column cwrap {
            at: 10 * cu, hh + 2 + 24 * cu
            text m.body { size: 11.5; width: 280 * cu; lines: 400; line_height: 1.2; color: ink; family: "SpaceMono Nerd Font"; show: m.kind == 2 }
        }
    }

    //  One row of the Desk's Clip tab: a dot (filled when pinned), the text, Ask, and a cross. Pressing the row copies it again.
    component ClipRow(c: record, copy: event, pin: event, ask: event, del: event) {
        size: 300 * cu, 34 * cu
        zone box touch { from: 0, 0; size: 300 * cu, 34 * cu; corner: 11 * cu; cursor: pointer }
        box { from: 0, 0; size: 300 * cu, 34 * cu; corner: 11 * cu; color: ink; opacity: 7% + 7% * touch.hover }
        ellipse { at: 15 * cu, 17 * cu; radius: 4.5 * cu; stroke: 1.4 * cu; color: mint; opacity: if(c.image, 0, 70% + 30% * pin_z.hover) }
        ellipse { at: 15 * cu, 17 * cu; radius: 4.5 * cu; color: mint; opacity: if(c.pinned, 100%, 0) }
        text "IMG" { at: 15 * cu, 17 * cu; anchor: center; align: center; size: 8.5; weight: 700; color: mint; family: "Space Grotesk"; show: c.image }
        text c.label { at: floor(30 * cu + 0.5), floor(17 * cu + 0.5); anchor: left center; size: 12; width: if(c.image, 210 * cu, 190 * cu); lines: 1; color: ink; opacity: 92%; family: "Space Grotesk" }
        text "Ask" { at: 238 * cu, 17 * cu; anchor: center; align: center; size: 10.5; weight: 700; color: mix(faint, mint, ask_z.hover); family: "Space Grotesk"; show: not c.image }
        line { from: 276 * cu, 17 * cu - 3 * cu; to: 282 * cu, 17 * cu + 3 * cu; width: 1.4 * cu; color: ink; opacity: 28% + 62% * del_z.hover }
        line { from: 282 * cu, 17 * cu - 3 * cu; to: 276 * cu, 17 * cu + 3 * cu; width: 1.4 * cu; color: ink; opacity: 28% + 62% * del_z.hover }
        on press touch { emit copy(c.index) }
        zone box pin_z { at: 15 * cu, 17 * cu; size: 24 * cu, 30 * cu; cursor: pointer; active: not c.image }
        zone box ask_z { at: 238 * cu, 17 * cu; size: 30 * cu, 30 * cu; cursor: pointer; active: not c.image }
        zone box del_z { at: 279 * cu, 17 * cu; size: 24 * cu, 30 * cu; cursor: pointer }
        on press pin_z { emit pin(c.index) }
        on press ask_z { emit ask(c.index) }
        on press del_z { emit del(c.index) }
    }

    //  One row of the output dropdown: a dot if it is the current one, its name.
    component OutRow(f: record, pick: event) {
        size: 276 * cu, floor(28 * cu + 0.5)
        zone box touch { from: 0, 0; size: 276 * cu, 28 * cu; corner: 10 * cu; cursor: pointer; active: dd > 0.05 }
        box { from: 0, 0; size: 276 * cu, 28 * cu; corner: 10 * cu; color: ink
              opacity: if(f.current, 12%, 0%) + 9% * touch.hover }
        ellipse { at: 14 * cu, 14 * cu; radius: 3 * cu; color: mint; opacity: if(f.current, 100%, 0%) }
        text f.name { at: floor(28 * cu + 0.5), floor(14 * cu + 0.5); anchor: left center; size: 15.5; width: 236 * cu; lines: 1
                      color: ink; family: "Space Grotesk" }
        on press touch { emit pick(f.index) }
    }

    //  One row of the Wi-Fi window: a dot if it's the one in use, its name, and
    //  what tapping it means right now. A secured network no password is known
    //  for yet opens the join field instead of trying to connect outright.
    //  Tapping a row never acts by itself - it only opens what's underneath it,
    //  right there: a password field for a secured network not seen before, or
    //  Connect/Disconnect and Forget for anything else. `wifi_open_row` is the
    //  one index that's open at a time, so opening another closes the last one.
    component WifiRow(n: record, pick: event, forget: event, joingo: event) {
        //  Grows on a spring like the Bluetooth rows: wifi_sel slides between rows, wifi_extra is how open.
        size: 276 * cu, floor((30 + 44 * wifi_extra * clamp(1 - abs(n.index - wifi_sel), 0, 1)) * cu + 0.5)
        let isopen = wifi_open_row == n.index
        let open_t = wifi_extra * clamp(1 - abs(n.index - wifi_sel), 0, 1)
        //  One card: the network line on top, and what opens is the same plate carrying on below it.
        box { from: 0, 0; size: 276 * cu, (30 + 44 * open_t) * cu; corner: 10 * cu; color: ink; opacity: if(n.active, 12%, 0%) + 5% * open_t + 9% * touch.hover }
        zone box touch { from: 0, 0; size: 276 * cu, 30 * cu; corner: 10 * cu; cursor: pointer }
        ellipse { at: 14 * cu, 15 * cu; radius: 3 * cu; color: mint; opacity: if(n.active, 100%, 0%) }
        text n.ssid { at: floor(28 * cu + 0.5), floor(15 * cu + 0.5); anchor: left center; size: 14.5; width: 150 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        text "Connected" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: mint; family: "Space Grotesk"; show: n.active }
        text "Saved" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; family: "Space Grotesk"; show: n.known and not n.active }
        text "Secured" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; family: "Space Grotesk"; show: n.secure and not n.known and not n.active }
        text "Open" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; family: "Space Grotesk"; show: not n.secure and not n.known and not n.active }
        on press touch { wifi_open_row = if(isopen, -1, n.index) }

        group {
            show: open_t > 0.01
            opacity: clamp(open_t, 0, 1)
            move: 0, (clamp(open_t, 0, 1) - 1) * 8 * cu
            box { at: 138 * cu, 30 * cu; size: 240 * cu, 1 * cu; color: ink; opacity: 10% }
            //  A secured network never seen before: the password, right here.
            group {
                show: n.secure and not n.known and not n.active
                box { at: 106 * cu, 52 * cu; size: 184 * cu, 26 * cu; corner: 8 * cu; color: ink; opacity: 8% }
                input wifi_pw { at: floor(24 * cu + 0.5), floor(52 * cu - 6.3 * cu + 0.5); width: 164 * cu; size: 13; color: ink; family: "Space Grotesk"; secret: true; placeholder: "Password" }
                box { at: 234 * cu, 52 * cu; size: 56 * cu, 26 * cu; corner: 8 * cu; color: mint; opacity: 85% + 15% * joinbtn.hover }
                text "Join" { at: floor(234 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk" }
                zone box joinbtn { at: 234 * cu, 52 * cu; size: 56 * cu, 26 * cu; corner: 8 * cu; cursor: pointer }
                on press joinbtn { emit joingo(n.index) }
            }
            //  Open, and never joined: nothing to type, just a way in.
            group {
                show: not n.secure and not n.known and not n.active
                box { at: 138 * cu, 52 * cu; size: 248 * cu, 26 * cu; corner: 8 * cu; color: mint; opacity: 85% + 15% * connbtn.hover }
                text "Connect" { at: floor(138 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk" }
                zone box connbtn { at: 138 * cu, 52 * cu; size: 248 * cu, 26 * cu; corner: 8 * cu; cursor: pointer }
                on press connbtn { emit pick(n.index) }
            }
            //  Known, or the one in use: leave it, join it again, or forget it outright.
            group {
                show: n.known or n.active
                box { at: 76 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; color: if(n.active, ink, mint); opacity: if(n.active, 12% + 10% * primbtn.hover, 85% + 15% * primbtn.hover) }
                text "Disconnect" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; family: "Space Grotesk"; show: n.active }
                text "Connect" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk"; show: not n.active }
                zone box primbtn { at: 76 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; cursor: pointer }
                on press primbtn { emit pick(n.index) }
                box { at: 200 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; color: ink; opacity: 6% + 10% * forgetbtn.hover }
                text "Forget" { at: floor(200 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
                zone box forgetbtn { at: 200 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; cursor: pointer }
                on press forgetbtn { emit forget(n.index) }
            }
        }
    }

    //  One row of the Bluetooth window: connected (with its battery, if it says), paired, or just seen.
    //  Tapping it opens Connect/Disconnect and Forget underneath, the same as a Wi-Fi row.
    component BtRow(d: record, pick: event, forget: event) {
        //  The row grows and its buttons fade in on a spring, instead of jumping. One spring says which
        //  row is open (bt_sel, sliding between rows) and one how open (bt_extra): a row's share is how
        //  close it is to the selection.
        size: 276 * cu, floor((30 + (44 + bt_pf) * bt_extra * clamp(1 - abs(d.index - bt_sel), 0, 1)) * cu + 0.5)
        let isopen = bt_open_row == d.index
        let open_t = bt_extra * clamp(1 - abs(d.index - bt_sel), 0, 1)
        //  What a tap asked for and BlueZ has not answered yet: 1 connecting, 2 disconnecting, 3 it could not.
        let working = d.busy == 1 or d.busy == 2
        let pulse = if(working, 55% + 45% * sin(time * 260), 100%)
        //  One card: the device line on top, and what opens is the same plate carrying on below it,
        //  with a hairline between, not a separate strip of buttons.
        box { from: 0, 0; size: 276 * cu, (30 + (44 + bt_pf) * open_t) * cu; corner: 10 * cu; color: ink; opacity: if(d.connected, 12%, 0%) + 5% * open_t + 9% * touch.hover }
        box { from: 0, 0; size: 276 * cu, (30 + (44 + bt_pf) * open_t) * cu; corner: 10 * cu; color: mint; opacity: if(working, 4% + 6% * pulse, 0%) }
        zone box touch { from: 0, 0; size: 276 * cu, 30 * cu; corner: 10 * cu; cursor: pointer }
        ellipse { at: 14 * cu, 15 * cu; radius: 3 * cu; color: mint; opacity: if(working, pulse, if(d.connected and d.busy == 0, 100%, 0%)) }
        ellipse { at: 14 * cu, 15 * cu; radius: 3 * cu; color: #e0655a; opacity: if(d.busy == 3, 100%, 0%) }
        text d.name { at: floor(28 * cu + 0.5), floor(15 * cu + 0.5); anchor: left center; size: 14.5; width: 150 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        text "Connected" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: mint; family: "Space Grotesk"; show: d.connected and d.battery < 0 and d.busy == 0 }
        text number(d.battery * 100, 0, "%") { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: mint; family: "Space Grotesk"; show: d.connected and d.battery >= 0 and d.busy == 0 }
        text "Paired" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; family: "Space Grotesk"; show: d.paired and not d.connected and d.busy == 0 }
        text "Not paired" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; family: "Space Grotesk"; show: not d.paired and not d.connected and d.busy == 0 }
        text "Connecting…" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: mint; opacity: pulse; family: "Space Grotesk"; show: d.busy == 1 }
        text "Disconnecting…" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; opacity: pulse; family: "Space Grotesk"; show: d.busy == 2 }
        text "Couldn't connect" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: #e0655a; family: "Space Grotesk"; show: d.busy == 3 }
        on press touch { bt_open_row = if(isopen, -1, d.index) }

        group {
            show: open_t > 0.01
            opacity: clamp(open_t, 0, 1)
            move: 0, (clamp(open_t, 0, 1) - 1) * 8 * cu
            box { at: 138 * cu, 30 * cu; size: 240 * cu, 1 * cu; color: ink; opacity: 10% }
            group {
                show: not d.paired and not d.connected
                box { at: 138 * cu, 52 * cu; size: 248 * cu, 26 * cu; corner: 8 * cu; color: mint; opacity: if(working, 30% + 20% * pulse, 85% + 15% * pairbtn.hover) }
                text "Pair & Connect" { at: floor(138 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk"; show: not working }
                text "Pairing…" { at: floor(138 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; family: "Space Grotesk"; show: working }
                zone box pairbtn { at: 138 * cu, 52 * cu; size: 248 * cu, 26 * cu; corner: 8 * cu; cursor: pointer; active: not working }
                on press pairbtn { emit pick(d.index) }
            }
            group {
                show: d.paired or d.connected
                box { at: 76 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; color: if(d.connected, ink, mint); opacity: if(working, 12% + 12% * pulse, if(d.connected, 12% + 10% * primbtn.hover, 85% + 15% * primbtn.hover)) }
                text "Disconnect" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; family: "Space Grotesk"; show: d.connected and not working }
                text "Connect" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk"; show: not d.connected and not working }
                text "Connecting…" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; opacity: pulse; family: "Space Grotesk"; show: d.busy == 1 }
                text "Disconnecting…" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; opacity: pulse; family: "Space Grotesk"; show: d.busy == 2 }
                zone box primbtn { at: 76 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; cursor: pointer; active: not working }
                on press primbtn { emit pick(d.index) }
                box { at: 200 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; color: ink; opacity: 6% + 10% * forgetbtn.hover }
                text "Forget" { at: floor(200 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
                zone box forgetbtn { at: 200 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; cursor: pointer }
                on press forgetbtn { emit forget(d.index) }
            }
            //  What the connected device does with sound: a headset drops to the telephone profile (mono, mic on) on a call and nothing puts it back.
            //  Not more buttons: its own heading under a hairline, and a choice of radio dots, two to a line, so it reads as a setting of the device.
            group {
                show: d.connected and isopen and bt_pf_h > 0
                box { at: 138 * cu, 74 * cu; size: 240 * cu, 1 * cu; color: ink; opacity: 10% }
                text "AUDIO PROFILE" { at: floor(14 * cu + 0.5), floor(88 * cu + 0.5); anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }
                repeat i in 0..6 {
                    let px = (14 + mod(i, 2) * 128) * cu
                    let py = (108 + floor(i / 2) * 26) * cu
                    box { from: px, py - 12 * cu; size: 124 * cu, 24 * cu; corner: 8 * cu; color: ink; opacity: if(bt_po.$i, 7% * bt_pz.$i.hover, 0%) }
                    ellipse { at: px + 11 * cu, py; radius: 5 * cu; stroke: 1.3 * cu; color: if(bt_pa.$i, mint, ink); opacity: if(bt_po.$i, if(bt_pa.$i, 100%, 45%), 0%) }
                    ellipse { at: px + 11 * cu, py; radius: 2.6 * cu; color: mint; opacity: if(bt_pa.$i, 100%, 0%) }
                    text bt_pl.$i { at: floor(px + 23 * cu + 0.5), floor(py + 0.5); anchor: left center; size: 12; weight: 600; width: 98 * cu; lines: 1; color: if(bt_pa.$i, mint, ink); opacity: if(bt_pa.$i, 100%, 80%); family: "Space Grotesk"; show: bt_po.$i }
                    zone box bt_pz.$i { from: px, py - 12 * cu; size: 124 * cu, 24 * cu; corner: 8 * cu; cursor: pointer; active: bt_po.$i }
                    on press bt_pz.$i { emit bt_prof_set(i) }
                }
            }
        }
    }

    //  One running window: its app icon, its title (mint and
    //  bold if it has the keyboard), and a close button that shows while the row is under the pointer.
    //  A press gives it the keyboard; a middle press closes it.
    component TaskRow(t: record, focus: event, kill: event) {
        size: 288 * cu, floor(36 * cu + 0.5)          // whole pixels (with the list's gap), so the icon is not drawn between two
        zone box touch { from: 0, 0; size: 288 * cu, 36 * cu; corner: 12 * cu; cursor: pointer }
        box { from: 0, 0; size: 288 * cu, 36 * cu; corner: 12 * cu; color: ink; opacity: if(t.active, 11%, 5%) + 8% * touch.hover }
        image t.icon { at: floor(8 * cu + 0.5), floor(7 * cu + 0.5); size: floor(22 * cu + 0.5), floor(22 * cu + 0.5) }
        text t.title { at: floor(38 * cu + 0.5), floor(18 * cu + 0.5); anchor: left center; size: 14.5; width: 186 * cu; lines: 1; color: ink; family: "Space Grotesk"; show: not t.active }
        text t.title { at: floor(38 * cu + 0.5), floor(18 * cu + 0.5); anchor: left center; size: 14.5; weight: 700; width: 186 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: t.active }
        //  Which workspace it is on, in a small pill.
        box { at: 240 * cu, 18 * cu; size: 24 * cu, 18 * cu; corner: 9 * cu; color: ink; opacity: 8% }
        text t.ws { at: floor(240 * cu + 0.5), floor(18 * cu + 0.5); anchor: center; align: center; size: 12; weight: 700; width: 24 * cu; lines: 1; color: ink; opacity: 80%; family: "Space Grotesk" }
        ellipse { at: 268 * cu, 18 * cu; radius: 10 * cu; color: if(close_z.hover, alert, ink); opacity: (if(close_z.hover, 90%, 9%)) * touch.hover }
        line { from: 264.5 * cu, 14.5 * cu; to: 271.5 * cu, 21.5 * cu; width: 1.4 * cu; color: ink; opacity: 70% * touch.hover }
        line { from: 271.5 * cu, 14.5 * cu; to: 264.5 * cu, 21.5 * cu; width: 1.4 * cu; color: ink; opacity: 70% * touch.hover }
        zone box close_z { at: 268 * cu, 18 * cu; size: 22 * cu, 22 * cu; corner: 11 * cu; cursor: pointer }
        on press touch { emit focus(t.index); panel = none }
        on press middle touch { emit kill(t.index) }
        on press close_z { emit kill(t.index) }
    }

    //  One app in the mixer: its icon, its name, a small slider and its percentage, and a speaker that silences it.
    component MixRow(m: record, set: event, mute: event) {
        size: 288 * cu, floor(28 * cu + 0.5)          // whole pixels (with the list's gap), so the icon is not drawn between two
        opacity: if(m.corked, 55%, 100%)
        image m.icon { at: floor(10 * cu + 0.5), floor(5 * cu + 0.5); size: floor(20 * cu + 0.5), floor(20 * cu + 0.5) }
        text m.name { at: floor(38 * cu + 0.5), floor(13 * cu + 0.5); anchor: left center; size: 12.5; width: 78 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        box { from: 116 * cu, 11 * cu; size: 100 * cu, 6 * cu; corner: 3 * cu; color: deep; opacity: 60% }
        box { from: 116 * cu, 11 * cu; size: max(0.1, 100 * cu * clamp(m.pct / 100, 0, 1)), 6 * cu; corner: 3 * cu; color: if(m.muted, faint, mint); opacity: if(m.muted, 60%, 100%) }
        zone box track { at: 166 * cu, 14 * cu; size: 112 * cu, 24 * cu; cursor: pointer }
        on press track { emit set(m.index * 4 + clamp((local.x - 116 * cu) / (100 * cu), 0, 1)) }
        on drag track { emit set(m.index * 4 + clamp((local.x - 116 * cu) / (100 * cu), 0, 1)) }
        text number(m.pct, 0, "%") { at: floor(252 * cu + 0.5), floor(14 * cu + 0.5); anchor: right center; align: right; size: 12; width: 30 * cu; lines: 1; color: faint; family: "Space Grotesk" }
        path { at: 264 * cu, 14 * cu; color: if(m.muted, faint, mint); opacity: 85% + 15% * mzone.hover; move 0, -2 * cu; line 2.5 * cu, -2 * cu; line 5.5 * cu, -5 * cu; line 5.5 * cu, 5 * cu; line 2.5 * cu, 2 * cu; line 0, 2 * cu; close }
        line { from: 255 * cu, 8 * cu; to: 271 * cu, 20 * cu; width: 1.5 * cu; color: alert; opacity: if(m.muted, 100%, 0) }
        zone box mzone { at: 263 * cu, 14 * cu; size: 20 * cu, 24 * cu; cursor: pointer }
        on press mzone { emit mute(m.index) }
    }

    //  A result of the launcher: an icon (or a letter where there is none), its name, and a line of detail.
    //  Its width is the rows' width (`lw`): narrower where a preview sits beside the rows, and then it has no detail line.
    let lw = mix(430, 238, lpv) * pu
    component LRow(t: record, pick: event, del: event) {
        size: lw, 40 * pu
        //  How much the remove button shows (see the end of the row).
        let rm = if(t.deletable, max(max(touch.hover, rm_z.hover), if(t.sel, 0.45, 0)), 0)
        zone box touch { from: 0, 0; size: lw, 40 * pu; corner: 14 * pu; cursor: pointer }
        box { from: 0, 0; size: lw, 40 * pu; corner: 14 * pu; color: if(t.sel, mint, ink); opacity: if(t.sel, 20%, 4%) + 8% * touch.hover }
        image t.icon { at: floor(10 * pu + 0.5), floor(7 * pu + 0.5); size: floor(26 * pu + 0.5), floor(26 * pu + 0.5); show: t.hasicon }
        ellipse { at: 23 * pu, 20 * pu; radius: 13 * pu; color: mint; opacity: 16%; show: not t.hasicon }
        text t.glyph { at: floor(23 * pu + 0.5), floor(20 * pu + 0.5); anchor: center; align: center; size: 17.5; weight: 700; width: 26 * pu; lines: 1; color: mint; family: "Space Grotesk"; show: not t.hasicon }
        text t.title { at: floor(48 * pu + 0.5), floor(if(t.hasdesc, 14, 20) * pu + 0.5); anchor: left center; size: 18; weight: 600; width: lw - (58 + 96 * (1 - lpv) + if(t.deletable, 24, 0)) * pu; lines: 1; color: if(t.sel, mint, ink); family: "Space Grotesk" }
        text t.desc { at: floor(48 * pu + 0.5), floor(29 * pu + 0.5); anchor: left center; size: 13.5; width: lw - 62 * pu; lines: 1; color: faint; family: "Space Grotesk"; show: t.hasdesc }
        text t.sub { at: floor(lw - 10 * pu + 0.5), floor(20 * pu + 0.5); anchor: right center; align: right; size: 14; width: 90 * pu; lines: 1; color: faint; opacity: (1 - lpv) * (1 - rm); family: "Space Grotesk" }
        on press touch { emit pick(t.index) }
        //  The clipboard's rows can be removed: a small cross where the kind ("text", "image") is, while the row is under the pointer or chosen
        //  (Shift + Delete does the same for the chosen one). Declared last, so a press on it is its own and does not paste the row.
        ellipse { at: lw - 20 * pu, 20 * pu; radius: 11 * pu; color: if(rm_z.hover, alert, ink); opacity: (if(rm_z.hover, 90%, 10%)) * rm }
        line { from: lw - 24 * pu, 16 * pu; to: lw - 16 * pu, 24 * pu; width: 1.5 * pu; color: ink; opacity: 75% * rm }
        line { from: lw - 16 * pu, 16 * pu; to: lw - 24 * pu, 24 * pu; width: 1.5 * pu; color: ink; opacity: 75% * rm }
        zone box rm_z { at: lw - 20 * pu, 20 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: t.deletable }
        on press rm_z { emit del(t.index) }
    }

    //  One app that lives in the tray, with no window of its own: its icon and name. A press is what clicking its
    //  icon would do; the dots open its menu, and the pin keeps it on the bar.
    component TrayRow(t: record, click: event, pin: event, menu: event) {
        size: 288 * cu, floor(36 * cu + 0.5)          // whole pixels (with the list's gap), so the icon is not drawn between two
        zone box touch { from: 0, 0; size: 288 * cu, 36 * cu; corner: 12 * cu; cursor: pointer }
        box { from: 0, 0; size: 288 * cu, 36 * cu; corner: 12 * cu; color: ink; opacity: 5% + 8% * touch.hover }
        image t.icon { at: floor(8 * cu + 0.5), floor(7 * cu + 0.5); size: floor(22 * cu + 0.5), floor(22 * cu + 0.5) }
        text t.title { at: floor(38 * cu + 0.5), floor(18 * cu + 0.5); anchor: left center; size: 14.5; width: 184 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        //  Its menu: three dots.
        group {
            show: t.menu
            opacity: 45% + 55% * menu_z.hover
            ellipse { at: 232 * cu, 18 * cu; radius: 1.4 * cu; color: ink }
            ellipse { at: 238 * cu, 18 * cu; radius: 1.4 * cu; color: ink }
            ellipse { at: 244 * cu, 18 * cu; radius: 1.4 * cu; color: ink }
        }
        zone box menu_z { at: 238 * cu, 18 * cu; size: 24 * cu, 28 * cu; corner: 10 * cu; cursor: pointer; active: t.menu }
        //  The pin: shown on the row under the pointer, and always on a pinned one.
        group {
            opacity: if(t.pinned, 100%, 55% * touch.hover + 25% * pin_z.hover)
            ellipse { at: 266 * cu, 15 * cu; radius: 3.6 * cu; color: mint; opacity: if(t.pinned, 100%, 0%) }
            ellipse { at: 266 * cu, 15 * cu; radius: 3.6 * cu; stroke: 1.3 * cu; color: ink; opacity: if(t.pinned, 0%, 100%) }
            line { from: 266 * cu, 18.5 * cu; to: 266 * cu, 24 * cu; width: 1.4 * cu; color: if(t.pinned, mint, ink) }
        }
        zone box pin_z { at: 266 * cu, 18 * cu; size: 22 * cu, 28 * cu; corner: 10 * cu; cursor: pointer }
        on press touch { emit click(t.index); panel = none }
        on press menu_z { emit menu(t.index) }
        on press pin_z { emit pin(t.index) }
    }

    //  One entry of a tray app's menu: a check if it is ticked, its label (in a step for each level of submenu
    //  it is under), and an arrow if it opens more. A separator is a line.
    component TmRow(r: record, pick: event) {
        size: 288 * cu, floor(if(r.sep, 10, 28) * cu + 0.5)
        zone box touch { from: 0, 0; size: 288 * cu, 28 * cu; corner: 9 * cu; cursor: pointer; active: r.enabled and not r.sep }
        box { from: 0, 0; size: 288 * cu, 28 * cu; corner: 9 * cu; color: ink; opacity: if(r.sep, 0%, 9% * touch.hover) }
        box { at: 144 * cu, 5 * cu; size: 264 * cu, 1 * cu; color: ink; opacity: if(r.sep, 12%, 0%) }
        path { at: 15 * cu, 14 * cu; stroke: 1.6 * cu; color: mint; opacity: if(r.checked, 100%, 0%); move -3.5 * cu, 0.5 * cu; line -1 * cu, 3 * cu; line 4 * cu, -3.5 * cu }
        text r.label { at: floor((30 + r.depth * 14) * cu + 0.5), floor(14 * cu + 0.5); anchor: left center; size: 14.5; width: (226 - r.depth * 14) * cu; lines: 1; color: ink; opacity: if(r.enabled, 100%, 40%); show: not r.sep; family: "Space Grotesk" }
        path { at: 274 * cu, 14 * cu; stroke: 1.5 * cu; color: ink; rotate: if(r.open, 90deg, 0deg); opacity: if(r.kids, 60%, 0%); move -2 * cu, -3.5 * cu; line 2 * cu, 0; line -2 * cu, 3.5 * cu }
        on press touch { emit pick(r.index) }
    }

    //  A tray app's icon on the bar: a left click is what clicking it would do, a right click opens its menu.
    component BarTray(t: record, click: event, menu: event) {
        size: floor(18 * u + 0.5), floor(18 * u + 0.5)
        box { at: 9 * u, 9 * u; size: 26 * u, 26 * u; corner: 8 * u; color: ink; opacity: 14% * touch.hover * bs.tray }
        image t.icon { at: 0, 0; size: floor(18 * u + 0.5), floor(18 * u + 0.5); opacity: (78% + 22% * touch.hover) * bs.tray }
        zone box touch { at: 9 * u, 9 * u; size: 24 * u, 30 * u; cursor: pointer; active: bs.tray > 0.5 }
        on press touch { emit click(t.index) }
        on press right touch { emit menu(t.index) }
    }

    //  While a screen recording runs, a red dot rides the tray. Under the pointer it squares off into a stop button.
    component BarRec(stop: event) {
        size: floor(18 * u + 0.5), floor(18 * u + 0.5)
        box { at: 9 * u, 9 * u; size: 26 * u, 26 * u; corner: 8 * u; color: ink; opacity: 14% * touch.hover }
        let beat = 0.5 + 0.5 * sin(time * 300)
        let wave = fract(time * 0.83)
        ellipse { at: 9 * u, 9 * u; radius: (6 + 7 * wave) * u; stroke: 1.3 * u; color: #ef4444; opacity: 55% * (1 - wave) * (1 - touch.hover) }
        body {
            color: #ef4444
            opacity: 88% + 12% * touch.hover - (1 - touch.hover) * 0.25 * (1 - beat)
            shadow: 0, 0, (4 + 5 * beat * (1 - touch.hover)) * u, 70%, #ef4444
            box { at: 9 * u, 9 * u; size: (12 + 1.5 * beat * (1 - touch.hover) - 1.5 * touch.hover) * u, (12 + 1.5 * beat * (1 - touch.hover) - 1.5 * touch.hover) * u; corner: (6 - 4 * touch.hover) * u }
        }
        zone box touch { at: 9 * u, 9 * u; size: 24 * u, 30 * u; cursor: pointer; label: "Stop recording" }
        on press touch { emit stop }
    }

    //  A notification's button (Reply, Mark read…): a small pill with its label.
    component NtAct(a: record, click: event) {
        size: floor(82 * u + 0.5), floor(26 * u + 0.5)
        zone box touch { from: 0, 0; size: 82 * u, 26 * u; corner: 8 * u; cursor: pointer }
        box { from: 0, 0; size: 82 * u, 26 * u; corner: 8 * u; color: if(touch.hover, mint, ink); opacity: if(touch.hover, 100%, 8%) }
        text a.label { at: floor(41 * u + 0.5), floor(13 * u + 0.5); anchor: center; align: center; size: 12.5 * u; weight: 700; width: 74 * u; lines: 1; color: if(touch.hover, onmint, ink); family: "Space Grotesk" }
        on press touch { emit click(a.index) }
    }

    //  One wallpaper in the gallery: its picture in rounded corners, a ring when it is the one in use.
    component WpThumb(t: record, pick: event) {
        size: 96 * pu, 54 * pu
        zone box touch { from: 0, 0; size: 96 * pu, 54 * pu; corner: 8 * pu; cursor: pointer }
        //  The pictures are cropped to 16:9 in a cache by the logic, so every tile is the same.
        group {
            clip inset 0 box { from: 0, 0; size: 96 * pu, 54 * pu; corner: 8 * pu }
            image t.thumb { at: 0, 0; size: 96 * pu, 54 * pu }
        box { from: 0, 0; size: 96 * pu, 54 * pu; color: ink; opacity: 14% * touch.hover }
        }
        box { from: 0, 0; size: 96 * pu, 54 * pu; corner: 8 * pu; stroke: 2 * pu; color: mint; opacity: if(wp_sel == t.index, 100%, 0) }
        on press touch { emit pick(t.index) }
    }

    //  A weather icon, drawn from shapes (there is no icon font): `kind` 0 clear · 1 partly cloudy · 2 cloud ·
    //  3 fog · 4 rain · 5 snow · 6 storm. The cloud is `cloud`; the sun, rain, snow and bolt are `sun`.
    component WxIcon(kind: number, cloud: color = ink, sun: color = mint) {
        size: 26 * cu, 20 * cu
        //  clear
        group {
            show: kind == 0
            ellipse { at: 13 * cu, 10 * cu; radius: 4.6 * cu; color: sun }
            repeat i in 0..8 {
                group {
                    pivot: 13 * cu, 10 * cu
                    rotate: i * 45deg
                    box { at: 13 * cu, 10 * cu - 7.8 * cu; size: 1.7 * cu, 3 * cu; corner: 0.8 * cu; color: sun }
                }
            }
        }
        //  partly cloudy: a small sun behind a cloud
        group {
            show: kind == 1
            ellipse { at: 8.5 * cu, 7.5 * cu; radius: 3.4 * cu; color: sun }
            repeat i in 0..8 {
                group {
                    pivot: 8.5 * cu, 7.5 * cu
                    rotate: i * 45deg
                    box { at: 8.5 * cu, 7.5 * cu - 5.9 * cu; size: 1.4 * cu, 2.2 * cu; corner: 0.7 * cu; color: sun }
                }
            }
            ellipse { at: 10 * cu, 13 * cu; radius: 3.6 * cu; color: cloud }
            ellipse { at: 15 * cu, 11.5 * cu; radius: 4.6 * cu; color: cloud }
            ellipse { at: 19 * cu, 13.5 * cu; radius: 3.2 * cu; color: cloud }
            box { at: 14.5 * cu, 15.5 * cu; size: 13 * cu, 4.5 * cu; corner: 2.2 * cu; color: cloud }
        }
        //  the cloud alone, and the cloud that rain, snow and storm hang from
        group {
            show: kind == 2 or kind == 4 or kind == 5 or kind == 6
            let cy0 = if(kind == 2, 10, 7.5) * cu
            ellipse { at: 9 * cu, cy0 + 1 * cu; radius: 4 * cu; color: cloud }
            ellipse { at: 14 * cu, cy0 - 1.5 * cu; radius: 5 * cu; color: cloud }
            ellipse { at: 18.5 * cu, cy0 + 1 * cu; radius: 3.6 * cu; color: cloud }
            box { at: 13.5 * cu, cy0 + 3 * cu; size: 14 * cu, 5 * cu; corner: 2.5 * cu; color: cloud }
        }
        //  fog
        group {
            show: kind == 3
            box { at: 13 * cu, 5.5 * cu; size: 17 * cu, 2 * cu; corner: 1 * cu; color: cloud }
            box { at: 13 * cu, 10 * cu; size: 13 * cu, 2 * cu; corner: 1 * cu; color: cloud }
            box { at: 13 * cu, 14.5 * cu; size: 17 * cu, 2 * cu; corner: 1 * cu; color: cloud }
        }
        //  rain
        group {
            show: kind == 4
            line { from: 8.5 * cu, 14 * cu; to: 7 * cu, 18 * cu; width: 1.5 * cu; color: sun }
            line { from: 13.5 * cu, 14 * cu; to: 12 * cu, 18 * cu; width: 1.5 * cu; color: sun }
            line { from: 18.5 * cu, 14 * cu; to: 17 * cu, 18 * cu; width: 1.5 * cu; color: sun }
        }
        //  snow
        group {
            show: kind == 5
            ellipse { at: 8 * cu, 15.5 * cu; radius: 1.3 * cu; color: sun }
            ellipse { at: 13 * cu, 17.5 * cu; radius: 1.3 * cu; color: sun }
            ellipse { at: 18 * cu, 15.5 * cu; radius: 1.3 * cu; color: sun }
        }
        //  storm: a bolt
        path {
            show: kind == 6
            at: floor(13 * cu + 0.5), floor(11 * cu + 0.5)
            color: sun
            move 1.5 * cu, 0
            line -2.5 * cu, 4.5 * cu
            line 0.2 * cu, 4.5 * cu
            line -1.2 * cu, 4 * cu
            line 4 * cu, -5.5 * cu
            line 0.5 * cu, -5.5 * cu
            close
        }
    }

    //  One day of the forecast: its name, its icon, its high and its low. Today is in the accent.
    component WxDay(d: record) {
        size: floor(42 * cu + 0.5), floor(50 * cu + 0.5)
        text d.label { at: floor(21 * cu + 0.5), floor(7 * cu + 0.5); anchor: center; align: center; size: 11; weight: 700; width: 40 * cu; lines: 1; color: if(d.today, mint, faint); family: "Space Grotesk" }
        column icon_col { at: 8 * cu, 15 * cu; WxIcon(d.kind, if(d.today, mint, ink), mint) }
        text d.hi { at: floor(12 * cu + 0.5), floor(42 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 700; width: 20 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        text d.lo { at: floor(31 * cu + 0.5), floor(42 * cu + 0.5); anchor: center; align: center; size: 11.5; width: 20 * cu; lines: 1; color: faint; family: "Space Grotesk" }
    }

    //  One notification in the history: its title and when it came, and under them the app and what it said.
    //  54 px tall, so a stack of them sits on whole pixels. A cross shows on hover, in place of the time.
    component NtHistRow(h: record, del: event) {
        size: 276 * cu, 54
        zone box touch { from: 0, 0; size: 276 * cu, 54; corner: 12 * cu }
        box { from: 0, 0; size: 276 * cu, 54; corner: 12 * cu; color: ink; opacity: 5% + 6% * touch.hover }
        text h.title { at: floor(12 * cu + 0.5), 17; anchor: left center; size: 14.5; weight: 700; width: 200 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        text h.sub { at: floor(12 * cu + 0.5), 37; anchor: left center; size: 12; width: 244 * cu; lines: 1; color: faint; family: "Space Grotesk" }
        text h.when { at: floor(264 * cu + 0.5), 17; anchor: right center; size: 11.5; color: faint; opacity: 100% - 100% * touch.hover; family: "Space Grotesk" }
        ellipse { at: floor(258 * cu + 0.5), 17; radius: 9 * cu; color: if(del_z.hover, alert, ink); opacity: (if(del_z.hover, 80%, 12%)) * touch.hover }
        line { from: floor(258 * cu + 0.5) - 3.2 * cu, 17 - 3.2 * cu; to: floor(258 * cu + 0.5) + 3.2 * cu, 17 + 3.2 * cu; width: 1.4 * cu; color: ink; opacity: 70% * touch.hover }
        line { from: floor(258 * cu + 0.5) + 3.2 * cu, 17 - 3.2 * cu; to: floor(258 * cu + 0.5) - 3.2 * cu, 17 + 3.2 * cu; width: 1.4 * cu; color: ink; opacity: 70% * touch.hover }
        zone box del_z { at: floor(258 * cu + 0.5), 17; size: 24 * cu, 24 * cu; corner: 12 * cu; cursor: pointer }
        on press del_z { emit del(h.index) }
    }

    let cx = screen.width / 2
    //  The bar down the left: a strip `lf.w` wide on the left and a frame `lf.t` thick round the other three edges, in the same glass. `lm` is how
    //  far over it is (the panels follow: `pcx` is where they are centred, with their left edge `lf.w` and a little in from the strip).
    let lm = clamp(bar_lm, 0, 1)
    let lf.t = 8 * u
    let lf.w = 46 * u
    let lf.x = lf.w / 2                                    // the strip's middle line, where its pieces sit
    //  Down the left a panel comes out of the strip like a drop and ends up in the middle of the screen. The Settings and the launcher are larger
    //  than the rest (`pu` instead of `u`, in their shapes, the contents and the rows they use: laid out at that size, not zoomed); `ku` is the
    //  unit of the one that is open. `lp.gx0` is where its left edge leaves the strip and `lp.gxf` where it lands;
    //  its left edge travels between them (`lp.xl`, as far as `dsl` of the way: a little after it starts to open), and its contents with it. The
    //  glass melts shapes that are near each other, so as it leaves a neck stretches and breaks: the drawers' blend (below) is what makes the neck.
    //  The surface is the whole monitor (`size: full, full`, which keeps the bar's reserved strip since pleamar 0.2.9), but with the bar on
    //  more than one monitor `screen.height` is only one of them. The logic reports the monitor's real height (`mon_h`, 0 until it is known, and always 0
    //  where it cannot ask): `vh` is what to centre on (never more than the surface, which is all there is to draw on), `mh` the
    //  monitor's own, for the compositor's coordinates.
    fact mon_h = 0
    let vh = if(mon_h > 0, min(mon_h, screen.height), screen.height)
    let mh = if(mon_h > 0, mon_h, screen.height)
    let yo = lm * (screen.height - vh) / 2                   // down the left the surface is not anchored to the top, so it is centred on the monitor: the monitor starts `yo` down it
    let vb = yo + vh                                         // the monitor's bottom edge, on the surface
    let vc = yo + vh / 2
    let ccx = mix(cx, (lf.w + screen.width - lf.t) / 2, lm)         // the middle of what can be seen: right of the strip, inside the frame
    let att = if(lp_k == 3 or lp_k == 4 or lp_k == 5 or lp_k == 6 or lp_k > 6, 1, 0)           // the control center, the calendar, the player and tray, the volume and the notifications: they stay joined to the strip, and are not scaled
    let rgt = if(lp_k > 6, 1, 0)                                    // the volume and the notifications come out of the right frame, not the strip, and grow leftwards
    let edg = if(lp_k == 1 or lp_k == 2, 1, 0)                      // Settings rises out of the bottom frame's middle, the launcher lowers out of the top frame's: not from the strip
    let dsl = max(0, dtrav * 1.3 - 0.3)
    let ku = if(lp_k == 1 or lp_k == 2, pu, if(lp_k == 9 or (lp_k >= 3 and lp_k <= 6), cu, u))                      // the unit of the panel that is open: the Settings and the launcher are larger
    let dsk_w = 340 * cu                                   // the desk's width and height, once out
    let dsk_h = 460 * cu
    let lp.gx0 = lf.x
    let lp.gxf = ccx - (pw_x / 2 + 6.5) * ku
    let lp.xl = mix(lp.gx0 + (lp.gxf - lp.gx0) * dsl, lf.x, att)
    let pcx = mix(cx, mix(mix(ccx - (lp.gxf - lp.gx0) * (1 - dsl), ccx, edg), mix(lf.w + 6.5 * ku + pw_x * ku / 2, screen.width - lf.t - 6.5 * u - pw_x * u / 2, rgt), att), lm)
    //  Click away. The surface is the whole screen (its input region is only what has a zone, so the rest lets clicks through), and this
    //  zone, declared before everything else so that everything else wins over it, closes the panel on a press anywhere that is not
    //  the panel or the bar. A second surface for this would take Escape away from the panel, so it is done here.
    zone box away_z { at: screen.width / 2, screen.height / 2; size: screen.width, screen.height; active: (panel != none and panel != volume and panel != notif) or wp_picker_open or ov_open }
    on press away_z { panel = none; wp_picker_open = false; ov_open = false }
    on press right away_z { panel = none; wp_picker_open = false; ov_open = false }
    //  The tray's icons (the pinned apps, or all of them) are a piece of the bar like the others; the bar widens for them.
    let bar.gap = 12 * u
    let tn = trn * bs.tray + rcn                      // what the tray piece holds: the icons (as far as the piece is shown) and the recording dot
    let fw.tray = max(0, tn * 24 - 6) * u               // icons 18 wide, 6 apart
    let vw.tray = fw.tray
    let bw.tray = fw.tray + bar.gap * min(1, tn)
    let bar.w = 450 * u + bw.tray
    let bar.h = 40 * u
    let bar.y0 = 8 + bar.h / 2
    //  Down the left the panels come out of the strip at the height of their button: `pw_y` is where the open panel's top is (see `lp.top`), and
    //  the bar's "middle line" is half a bar above it, so that the first plate keeps the 12 it has under a panel's top (`bar.y` + 32).
    let bar.y = mix(bar.y0, pw_y - bar.h / 2, lm)
    let bar.rad = 14 * u                 // the bar's corner when shut: the same as the plates', not a full pill
    //  The bar's pieces sit in a row in the order Settings > Bar gives them (`bo.*`), 16 in from each end and
    //  `bar.gap` apart. Each one is as wide as what it draws (`fw.*`) and takes that and a gap (`bw.*`: less while
    //  it is being hidden, and the player's only while there is something playing); the title takes none, it is
    //  the stretch between the two ends: what comes before it is laid from the left edge, what comes after it
    //  from the right, so its gap is on the side towards the title.
    //  The clock's width is measured: the hour, the minutes and, at the edge, the day over the am/pm (both about
    //  the same width, so the column is as wide as the wider).
    let clock.col = max(caw.width, cdw.width)
    let bar.l = pcx - bar.w / 2 + 16 * u
    let bar.r = pcx + bar.w / 2 - 16 * u
    let fw.ws = 108 * u                  // five squares 18 apart, one of them stretched out
    let fw.media = 0                     // previous, play, next have no slot of their own: they sit inside the window title's button, top right
    let fw.set = 15 * u                  // the gear with its teeth
    let fw.sr = 12 * u                   // the magnifier, glass and handle
    let fw.ctl = 13 * u                  // the two sliders
    let fw.clock = chw.width + cmw.width + clock.col
    let vw.ws = fw.ws * bs.ws            // what each one draws, now
    let vw.media = fw.media * mshow * bs.media
    let vw.sr = fw.sr * bs.sr
    let vw.ctl = fw.ctl * bs.ctl
    let vw.clock = fw.clock * bs.clock
    let bw.ws = (fw.ws + bar.gap) * bs.ws
    let bw.media = (fw.media + bar.gap) * mshow * bs.media
    let bw.set = fw.set + bar.gap
    let bw.sr = (fw.sr + bar.gap) * bs.sr
    let bw.ctl = (fw.ctl + bar.gap) * bs.ctl
    let bw.clock = (fw.clock + bar.gap) * bs.clock
    //  How much of the row comes before each piece (`pre.*`) and after it (`post.*`).
    let pre.ws = if(bo.media < bo.ws, bw.media, 0) + if(bo.set < bo.ws, bw.set, 0) + if(bo.sr < bo.ws, bw.sr, 0) + if(bo.ctl < bo.ws, bw.ctl, 0) + if(bo.clock < bo.ws, bw.clock, 0) + if(bo.tray < bo.ws, bw.tray, 0)
    let post.ws = if(bo.media > bo.ws, bw.media, 0) + if(bo.set > bo.ws, bw.set, 0) + if(bo.sr > bo.ws, bw.sr, 0) + if(bo.ctl > bo.ws, bw.ctl, 0) + if(bo.clock > bo.ws, bw.clock, 0) + if(bo.tray > bo.ws, bw.tray, 0)
    let pre.media = if(bo.ws < bo.media, bw.ws, 0) + if(bo.set < bo.media, bw.set, 0) + if(bo.sr < bo.media, bw.sr, 0) + if(bo.ctl < bo.media, bw.ctl, 0) + if(bo.clock < bo.media, bw.clock, 0) + if(bo.tray < bo.media, bw.tray, 0)
    let post.media = if(bo.ws > bo.media, bw.ws, 0) + if(bo.set > bo.media, bw.set, 0) + if(bo.sr > bo.media, bw.sr, 0) + if(bo.ctl > bo.media, bw.ctl, 0) + if(bo.clock > bo.media, bw.clock, 0) + if(bo.tray > bo.media, bw.tray, 0)
    let pre.set = if(bo.ws < bo.set, bw.ws, 0) + if(bo.media < bo.set, bw.media, 0) + if(bo.sr < bo.set, bw.sr, 0) + if(bo.ctl < bo.set, bw.ctl, 0) + if(bo.clock < bo.set, bw.clock, 0) + if(bo.tray < bo.set, bw.tray, 0)
    let post.set = if(bo.ws > bo.set, bw.ws, 0) + if(bo.media > bo.set, bw.media, 0) + if(bo.sr > bo.set, bw.sr, 0) + if(bo.ctl > bo.set, bw.ctl, 0) + if(bo.clock > bo.set, bw.clock, 0) + if(bo.tray > bo.set, bw.tray, 0)
    let pre.sr = if(bo.ws < bo.sr, bw.ws, 0) + if(bo.media < bo.sr, bw.media, 0) + if(bo.set < bo.sr, bw.set, 0) + if(bo.ctl < bo.sr, bw.ctl, 0) + if(bo.clock < bo.sr, bw.clock, 0) + if(bo.tray < bo.sr, bw.tray, 0)
    let post.sr = if(bo.ws > bo.sr, bw.ws, 0) + if(bo.media > bo.sr, bw.media, 0) + if(bo.set > bo.sr, bw.set, 0) + if(bo.ctl > bo.sr, bw.ctl, 0) + if(bo.clock > bo.sr, bw.clock, 0) + if(bo.tray > bo.sr, bw.tray, 0)
    let pre.ctl = if(bo.ws < bo.ctl, bw.ws, 0) + if(bo.media < bo.ctl, bw.media, 0) + if(bo.set < bo.ctl, bw.set, 0) + if(bo.sr < bo.ctl, bw.sr, 0) + if(bo.clock < bo.ctl, bw.clock, 0) + if(bo.tray < bo.ctl, bw.tray, 0)
    let post.ctl = if(bo.ws > bo.ctl, bw.ws, 0) + if(bo.media > bo.ctl, bw.media, 0) + if(bo.set > bo.ctl, bw.set, 0) + if(bo.sr > bo.ctl, bw.sr, 0) + if(bo.clock > bo.ctl, bw.clock, 0) + if(bo.tray > bo.ctl, bw.tray, 0)
    let pre.clock = if(bo.ws < bo.clock, bw.ws, 0) + if(bo.media < bo.clock, bw.media, 0) + if(bo.set < bo.clock, bw.set, 0) + if(bo.sr < bo.clock, bw.sr, 0) + if(bo.ctl < bo.clock, bw.ctl, 0) + if(bo.tray < bo.clock, bw.tray, 0)
    let post.clock = if(bo.ws > bo.clock, bw.ws, 0) + if(bo.media > bo.clock, bw.media, 0) + if(bo.set > bo.clock, bw.set, 0) + if(bo.sr > bo.clock, bw.sr, 0) + if(bo.ctl > bo.clock, bw.ctl, 0) + if(bo.tray > bo.clock, bw.tray, 0)
    let pre.title = if(bo.ws < bo.title, bw.ws, 0) + if(bo.media < bo.title, bw.media, 0) + if(bo.set < bo.title, bw.set, 0) + if(bo.sr < bo.title, bw.sr, 0) + if(bo.ctl < bo.title, bw.ctl, 0) + if(bo.clock < bo.title, bw.clock, 0) + if(bo.tray < bo.title, bw.tray, 0)
    let post.title = if(bo.ws > bo.title, bw.ws, 0) + if(bo.media > bo.title, bw.media, 0) + if(bo.set > bo.title, bw.set, 0) + if(bo.sr > bo.title, bw.sr, 0) + if(bo.ctl > bo.title, bw.ctl, 0) + if(bo.clock > bo.title, bw.clock, 0) + if(bo.tray > bo.title, bw.tray, 0)
    let pre.tray = if(bo.ws < bo.tray, bw.ws, 0) + if(bo.media < bo.tray, bw.media, 0) + if(bo.set < bo.tray, bw.set, 0) + if(bo.sr < bo.tray, bw.sr, 0) + if(bo.ctl < bo.tray, bw.ctl, 0) + if(bo.clock < bo.tray, bw.clock, 0)
    let post.tray = if(bo.ws > bo.tray, bw.ws, 0) + if(bo.media > bo.tray, bw.media, 0) + if(bo.set > bo.tray, bw.set, 0) + if(bo.sr > bo.tray, bw.sr, 0) + if(bo.ctl > bo.tray, bw.ctl, 0) + if(bo.clock > bo.tray, bw.clock, 0)
    //  Each piece's middle: from the left edge before the title, from the right edge after it.
    let at.ws = if(bo.ws < bo.title, bar.l + pre.ws + vw.ws / 2, bar.r - post.ws - vw.ws / 2)
    let mc = if(bo.media < bo.title, bar.l + pre.media + vw.media / 2, bar.r - post.media - vw.media / 2)
    let set.x = if(bo.set < bo.title, bar.l + pre.set + fw.set / 2, bar.r - post.set - fw.set / 2)
    let sr.x = if(bo.sr < bo.title, bar.l + pre.sr + vw.sr / 2, bar.r - post.sr - vw.sr / 2)
    let ctl.x = if(bo.ctl < bo.title, bar.l + pre.ctl + vw.ctl / 2, bar.r - post.ctl - vw.ctl / 2)
    let tr.x = if(bo.tray < bo.title, bar.l + pre.tray + vw.tray / 2, bar.r - post.tray - vw.tray / 2)
    let at.clock = if(bo.clock < bo.title, bar.l + pre.clock + vw.clock / 2, bar.r - post.clock - vw.clock / 2)
    //  The clock's texts are set against its right edge: the day column, the minutes, the hour.
    let clock.r = at.clock + fw.clock / 2
    let clock.left = clock.r - clock.col - cmw.width - chw.width
    //  Where the window title starts, and how far it may reach: the stretch (the gaps are its neighbours').
    let win.x = bar.l + pre.title
    let win.w = max(0, bar.r - post.title - win.x)
    let room = 14 * u
    let roomv = 14 * cu                    // and down the left, where the dots are larger
    //  Down the left, top to bottom: the workspaces (their middle one at `lv.ws`), the title, and from the foot up the clock (its
    //  hour at `lv.clk`, the minutes, am/pm, the weekday and the date under it), the controls, search and the gear, 32 apart. Whole pixels, for the texts.
    let lv.ws = yo + lf.t + 62 * cu
    let lv.clk = vb - lf.t - 73 * u
    let lv.ctl = lv.clk - 34 * u
    let lv.set = lv.ctl - 32 * u
    let lv.sr = lv.set - 32 * u
    let lv.tray = lv.sr - 22 * u - max(0, tn * 24 - 6) * u      // the tray apps sit just above the search, under the title
    //  The window title down the left, as in Synoptik's ActiveWindowCard: the app and its title turned a quarter anticlockwise (read from the foot
    //  up), centred in what the other pieces leave (`lv.tt` to `lv.bot`), with the player's buttons stacked at its top end while there is a player.
    let lv.tt = lv.ws + 52 * cu + 14 * u
    let lv.bot = lv.tray - 14 * u * min(1, tn)
    let lv.mc = 62 * cu * mshow * bs.media0            // what the player's buttons take, along the title
    let lv.none = if(max(vclw.width, vtiw.width) < 1, 1, 0)       // nothing is focused (an empty workspace): three dots take the title's place, so there is something to click
    let lv.span = clamp(max(max(vclw.width, vtiw.width), lv.none * 44 * cu), 0, max(1, lv.bot - lv.tt - lv.mc))     // how long the text is (cut where the stretch ends)
    let lv.y0 = clamp(vc - (lv.span + lv.mc) / 2, lv.tt, max(lv.tt, lv.bot - lv.span - lv.mc))     // the top of buttons and text together, centred as one on the middle of the screen, as near as the pieces above and below let it
    let lv.mid = lv.y0 + 31 * cu                       // the buttons' middle (previous nearest the text, 17 apart)
    let lv.tm = lv.y0 + lv.mc + lv.span / 2           // the text's middle
    //  The marks are laid out along one line with the SAME empty space between every neighbouring pair, whatever their sizes: each one has a slot as long
    //  as itself (a dot, a larger square if it has windows, or the pill while it is the active one, and in between while it morphs), and the slots follow
    //  each other `ws.g` apart, the whole row centred on its place. `ws.cN` is where slot N's middle is, from the row's middle.
    let ws.U = mix(u, cu, lm)
    let ws.g = 9 * ws.U
    let ws.pb = 15 * ws.U                 // the pill's thickness, the same wherever it is
    let ws.pl = ws.pb + 14 * ws.U         // and its length, resting on one workspace
    let ws.s1 = mix((8 + 4.5 * ws.tall.1) * ws.U, ws.pl, ws.act.1)
    let ws.s2 = mix((8 + 4.5 * ws.tall.2) * ws.U, ws.pl, ws.act.2)
    let ws.s3 = mix((8 + 4.5 * ws.tall.3) * ws.U, ws.pl, ws.act.3)
    let ws.s4 = mix((8 + 4.5 * ws.tall.4) * ws.U, ws.pl, ws.act.4)
    let ws.s5 = mix((8 + 4.5 * ws.tall.5) * ws.U, ws.pl, ws.act.5)
    let ws.w = ws.s1 + ws.s2 + ws.s3 + ws.s4 + ws.s5 + 4 * ws.g
    let ws.c1 = ws.s1 / 2 - ws.w / 2
    let ws.c2 = ws.c1 + ws.s1 / 2 + ws.g + ws.s2 / 2
    let ws.c3 = ws.c2 + ws.s2 / 2 + ws.g + ws.s3 / 2
    let ws.c4 = ws.c3 + ws.s3 / 2 + ws.g + ws.s4 / 2
    let ws.c5 = ws.c4 + ws.s4 / 2 + ws.g + ws.s5 / 2
    let ws.o = mix(at.ws, lv.ws, lm)
    let ws.a1 = ws.o + ws.c1
    let ws.a2 = ws.o + ws.c2
    let ws.a3 = ws.o + ws.c3
    let ws.a4 = ws.o + ws.c4
    let ws.a5 = ws.o + ws.c5

    //  The music only moves the bar: it fades out as the panel opens (gone by a third of
    //  the way), so an open panel sits still.
    let pv = pulse * (1 - min(1, drop * 3)) * (1 - lm)
    let pop = pv * 6 * u           // how far the bar swells on the beat
    //  The bounce on `dc`/`dk` (below) is free to swing past 1 on the way open - that
    //  overshoot is the spring showing - but a size can't go negative, so anything
    //  that scales a width or height reads the clamped version instead: it shrinks
    //  cleanly to nothing on the way closed rather than through it.
    let dc0 = max(0, dc)
    let dk0 = max(0, dk)
    let dm0 = max(0, dm)
    let do0 = max(0, do)
    let dz0 = max(0, dz)
    let ds0 = max(0, ds)
    let dl0 = max(0, dl)
    let expand0 = max(0, expand)
    //  Marea's liquid: while a drawer comes out (or goes back), the neck that joins it to the bar is a bell,
    //  thickest halfway; the drawer is a little narrower there, as a falling drop is, and it is round at first
    //  and squares up as it grows (and rounds again as it goes). `*.bell` is 0 shut, 1 halfway, 0 open.
    let dk.bell = 4 * min(1, dk0) * (1 - min(1, dk0))
    let ds.bell = 4 * min(1, ds0) * (1 - min(1, ds0))
    let dl.bell = 4 * min(1, dl0) * (1 - min(1, dl0))
    let dc.bell = 4 * min(1, dc0) * (1 - min(1, dc0))
    let do.bell = 4 * min(1, do0) * (1 - min(1, do0))
    let dz.bell = 4 * min(1, dz0) * (1 - min(1, dz0))
    let dm.bell = 4 * min(1, dm0) * (1 - min(1, dm0))
    //  Both panels fill in their width quickly and then keep growing taller - so a
    //  plain `min(1, …)` on the width leaves it capped flat once that's done, and
    //  the bounce on the way to fully open (or the little one closing overshoots
    //  into) only ever shows up as a change in height. The `max(0, … - 1) * 0.6`
    //  term only wakes up past that cap, so the width bulges a little with the
    //  same overshoot instead of sitting there rigid while the height does all
    //  the springing.
    let card.w = bar.w * (min(1, dc0 * 3) + max(0, dc0 - 1) * 0.6)
    let card.h = 373 * cu * dc0        // 303, and 70 more for the weather strip
    //  The controls drawer: as wide as its plates and their margins need (288 + 2 x 12), coming
    //  out of the bar. It starts narrow and wide-open in height last, and widens to its place.
    //  It reaches up into the bar so the two can melt; `dk.hh` is how far down it goes.
    let dk.w = (120 + 192 * (min(1, dk0 * 1.6) + max(0, dk0 - 1) * 0.6)) * cu
    //  The plates stack from a shared cursor, each one naming where the one
    //  before it ended, so a plate that changes height (the media one, which
    //  shrinks to a sliver with nothing playing) pushes what is under it
    //  instead of leaving a gap or a pile-up. Unscaled: `u` is applied where
    //  each offset is finally used. Wi-Fi and Bluetooth are tiles side by side
    //  now, at the very top, so they cost one row's height between them.
    let tiles_top  = 8
    let tiles_h    = 72
    let tiles_bot  = tiles_top + tiles_h
    //  Do Not Disturb and Caffeine: a second row of tiles, the same size as the first.
    let tiles2_top = tiles_bot + 4
    let tiles2_bot = tiles2_top + tiles_h
    let bright_top = tiles2_bot + 4
    let bright_bot = bright_top + 64
    let vol_top    = bright_bot + 4
    let vol_bot    = vol_top + 64
    //  The player's plate is alone in its own panel now, at the top of it.
    let media_top  = 8
    let media_h    = mix(40, 96, media_open)
    let media_bot  = media_top + media_h
    //  Either tile can grow past the stack into its own window - as tall as its
    //  list actually is (one open row taller, while one is), up to a ceiling
    //  where the list itself starts scrolling instead of the window still
    //  growing to fit it.
    let wifi_rows_h = max(1, wifi_nets.count) * 34 - 4 + 44 * wifi_extra
    let bt_rows_h   = max(1, bt_devices.count) * 34 - 4 + (44 + bt_pf) * bt_extra
    let list_max    = 220
    //  The notifications window has a Do Not Disturb row and its timer chips above its list (84 more), and a
    //  shorter list. Its rows are 54 px with 6 between, whole pixels.
    let nt_rows_h = (max(1, nt_hist.count) * 60 - 6) / u
    let list_view_h = min(if(showing_sub == btview, bt_rows_h, if(showing_sub == notifview, nt_rows_h, wifi_rows_h)), if(showing_sub == notifview, 150, list_max))
    //  The Caffeine window is a row and two lines of chips (91 under its title), and has no list.
    let sub_content = if(showing_sub == cafview, 38, if(showing_sub == capview, 142, if(showing_sub == powview, 151, if(showing_sub == notifview, 60, 0) + list_view_h)))
    let sub_bot = tiles_top + 54 + sub_content + 16
    //  The output list drops over what is under the volume row; with more than a couple of outputs
    //  it reaches past the drawer, so the drawer grows to hold it while it is open.
    let dd.rows = clamp(outlist.count, 1, 6)
    let dd.extra = max(0, dd.rows * 30 - 28) * max(0, dd)
    //  The mixer hangs under the volume plate: a row of 32 per app (a line of words with none), and the drawer
    //  grows to hold it.
    //  The mixer is part of the volume card: the card grows by `mix.m` while it is open (a row of 32 per app, or a line of
    //  words with none, and room for the dots at the foot).
    let mix.m = if(mixer.count > 0, mixer.count * 32 + 8, 40)
    let vp.h = 64 + mix.m * clamp(vm, 0, 1)                // the volume card's height, unscaled
    let mix.extra = mix.m * max(0, vm)
    let content_bot = mix(vol_bot + max(dd.extra, mix.extra), sub_bot, expand0)
    let dk.hh = bar.h / 2 + (content_bot + 16) * cu * dk0 + max(0, sag)
    //  The player's panel: the same drawer as the controls, centred on the bar, and as tall as
    //  its one plate.
    //  The calendar's drawer: it falls as a narrow drop out of the bar and widens to exactly the bar's width as it
    //  lands, with the liquid neck of the other drawers while it is narrower (see `dc.bell`). It starts at the bar's
    //  middle, as they do, so the blend has the bar to melt into; as tall as the bar's lower half plus its content.
    let dc.w = (120 + 330 * (min(1, dc0 * 1.6) + max(0, dc0 - 1) * 0.6)) * cu
    let dc.hh = bar.h / 2 + card.h + max(0, sag)
    //  Once it is as wide as the bar (`f` 1) it must be a straight continuation of the bar's sides, so it moves its top up to
    //  the bar's top edge and stops blending: a blend there would puff the join out at the bar's corners.
    let dc.f = clamp((dc.w - bar.w + 24 * u) / (24 * u), 0, 1)
    let dc.top = mix(bar.y, bar.y - bar.h / 2, dc.f)
    //  The volume / notification drawer: 340 wide, as tall as its plate.
    //  The notification's plate is as tall as what is on it: the app line, the title (one line or more),
    //  the body if there is one (as many lines as it needs), and a row of buttons if it brought any,
    //  with 12 of air around. Never shorter than its icon tile. Each text measures itself once wrapped.
    let nt_th = max(24, ntt.height / u)
    let nt_bh = ntb.height / u
    let nt_content = if(nt_body_on, 39 + nt_th + nt_bh, 35 + nt_th)
    let nt_h = max(68, nt_content + if(nt_acts.count > 0, 34, 0) + 12)
    follow osd_h = if(osd_kind == note, nt_h, if(osd_kind == shot, 248, 64))
    //  The settings panel: 620 wide. A header (36), then the sidebar and the page side by side (352).
    //  How tall the settings page in view is (unscaled): Wallpaper, Glass, Display.
    //  The Display page: its cards down to the profiles one, which is as tall as its rows (none: a line).
    let disp.prows = max(24, disp_pn_s * 30)
    let disp.h = 554 + disp.prows + 114
    //  The System monitor page: the storage card has a row for each drive and the temperature card one for each sensor, and what is under
    //  them slides up as they shrink (see the page, which is generated: sm.ds and sm.dt are how much each has given back).
    //  The sidebar's SYSTEM group, top to bottom. To add a section, give it a row here (`side.NAME = previous row + 32`), draw its item
    //  like the others, and move `side.last` to its row: About is always the row after `side.last`, so it stays the final one, and
    //  Settings' minimum height follows it (see `set.h`).
    let side.ck = 202                  // the Clock row: after Night mode (170)
    let side.th = 234                  // the Theme row: the last of Visuals
    let side.hy = 290
    let side.wm = side.hy + 32
    let side.mon = side.wm + 32
    let side.nt = side.mon + 32
    let side.lk = side.nt + 32
    let side.vpn = side.lk + 32
    let side.last = side.vpn
    let side.ab = side.last + 32
    let sm.ds = (4 - clamp(sm_mnt.count, 1, 4)) * 38
    let sm.dt = (8 - clamp(sm_tmp.count, 1, 8)) * 24
    let sm.h = 1536 - sm.ds - sm.dt
    //  The VPN page: the profiles card is as tall as its rows, and the add card as its form (WireGuard 5 rows, OpenVPN 4, a file 1 and a line).
    let vpn.pb = 84
    let vpn.pbh = 34 + max(1, vpn_count) * 32 + 6
    let vpn.ab = vpn.pb + vpn.pbh + 12
    let vpn.fh = if(vpn_mode == vpm_wg, 180, if(vpn_mode == vpm_ovpn, 144, 276))
    let wm.h = 782                     // the Pleamar-WM page: to the bottom of its last card
    let lk.h = 806                     // the Lock screen page: its cards, to the bottom of the last
    //  The Notifications page: the apps card has a row for each app (up to 14), and the rules card is there while one is open.
    let nt.ds = (14 - clamp(nta_count, 1, 14)) * 36
    let nt.h = 246 + 146 + 552 - nt.ds + 8 + if(nta_sel >= 0, 456, 0) + 12              // 146 of it the quiet hours card on top
    //  A fixed height, whatever the page: the panel used to follow the page in view (262 to 456), so it resized, and moved what hangs from it, with
    //  every click in the sidebar. A page taller than this scrolls inside it (they have their scroll thumb and "More" cue); a shorter one has
    //  empty glass at its foot. It never goes below the sidebar's last row.
    let set.h = max(side.ab + 40, 456)
    //  A held Power button counts its second on this clock, and a recording pulses on it, so they need it too.
    let need_clock = ((wifi_scanning or bt_scanning or bt_working or caf_on or pw_d0 or pw_d1 or pw_d2 or pw_d3 or pw_d4) and dk > 0.01) or (do > 0.01 and (osd_kind == vol or nt_urgent)) or (set_pgd > 0.01 and disp.h > set.h) or rec_on
    spin time by if(need_clock, 1, 0)
    let ss.w = (120 + 500 * (min(1, ds0 * 1.6) + max(0, ds0 - 1) * 0.6)) * pu
    let ss.hh = bar.h / 2 + (8 + 36 + 8 + set.h + 16) * pu * ds0 + max(0, sag)
    //  The launcher: a drop that widens to the bar's width as it lands, like the calendar. The search field (40), the
    //  rows (44 each, up to eight; seven where there is a preview beside them) and a line of hints.
    let dl.w = (120 + 330 * (min(1, dl0 * 1.6) + max(0, dl0 - 1) * 0.6)) * pu
    let dl.hh = bar.h / 2 + (154 + lr * 44) * pu * dl0 + max(0, sag)
    let dl.f = clamp((dl.w - bar.w + 24 * u) / (24 * u), 0, 1)     // as for the calendar
    let dl.top = mix(bar.y, bar.y - bar.h / 2, dl.f)
    let dm.w = (120 + 192 * (min(1, dm0 * 1.6) + max(0, dm0 - 1) * 0.6)) * cu
    //  Under the player's plate, the running windows and then the tray apps, each a header and rows, scrolling past a few.
    let task_rows = min(max(1, tasks.count), 6)
    let tasks_top = media_bot + 8
    let tasks_list = tasks_top
    let tasks_bot = tasks_list + task_rows * 40 - 4
    let tray_rows = min(trays.count, 3)
    let tray_top = tasks_bot + 8
    let tray_list = tray_top + 26
    let panel_bot = if(trays.count > 0, tray_list + tray_rows * 40 - 4, tasks_bot)
    //  The tray menu: the app's plate (8..60), Open and Alt (66..92), then its menu from 100 (or a line saying it has none).
    let tm.list = min(tm_h, 224)
    let tm_bot = 100 + if(tm_has_menu, tm.list, 30) + 8
    let dm.hh = bar.h / 2 + (if(dm_mode == dmm_tray, tm_bot, panel_bot) + 16) * cu * dm0 + max(0, sag)
    let mdx = pcx
    //  Down the left, where the open panel is (`lp_k`: which was opened last), in its own coordinates: it ends up in the middle of the screen,
    //  except the volume, which is low, and the notification, which is high. It leaves the strip at the height of its button (`lp.btn`; the volume
    //  and the notification leave at their own height) and its middle travels from there to its place with the drop (`lp.cy`). `pw_y` follows its top.
    let lp.btn = if(lp_k == 1, vb - lf.t / 2, if(lp_k == 2, yo + lf.t / 2, if(lp_k == 3, lv.ctl, if(lp_k == 4, lv.clk + 30 * u, if(lp_k == 5, lv.tray + 9 * u, if(lp_k == 6, lv.tm, 0))))))
    //  Margins: the plates are 12 in from a drawer's top and bottom in their own layouts and 18.5 in from its sides, so a panel's content is moved by
    //  `lp.dy` and the drawer made `lp.dd` taller to make them 18.5 all round (Settings included).
    let lp.dy = if(lp_k == 1, 4.5, if(lp_k == 2 or lp_k == 3 or lp_k == 5 or lp_k == 6 or lp_k == 7 or lp_k == 8, 6.5, if(lp_k == 4, -0.5, 0))) * ku * lm
    let lp.dd = if(lp_k == 1, 11, if(lp_k == 2, 11, if(lp_k == 3 or lp_k == 5 or lp_k == 6 or lp_k == 7 or lp_k == 8, 13, if(lp_k == 4, 6, 0)))) * ku * lm
    let lp.hd = (if(lp_k == 1, (8 + 36 + 8 + set.h + 16) * pu, if(lp_k == 2, (154 + lr * 44) * pu, if(lp_k == 3, (content_bot + 16) * cu, if(lp_k == 4, 373 * cu, if(lp_k == 5 or lp_k == 6, (if(dm_mode == dmm_tray, tm_bot, panel_bot) + 16) * cu, if(lp_k == 9, dsk_h, (8 + osd_h + 16) * u))))))) + lp.dd
    //  Where it settles, as drawn (`ty`): Settings low, the launcher high, a good way from the middle, and clear of the frame; then back to the panel's
    //  own coordinates (the contents are scaled about the middle of the screen).
    let lp.ty = if(lp_k == 1, min(vc + 190 * u, vb - lf.t - 24 * u - lp.hd / 2), max(vc - 210 * u, yo + lf.t + 24 * u + lp.hd / 2))
    let lp.yf = if(lp_k == 1 or lp_k == 2, lp.ty, if(lp_k == 3 or lp_k == 4 or lp_k == 5 or lp_k == 6, clamp(lp.btn, yo + lf.t + 24 * u + lp.hd / 2, vb - lf.t - 24 * u - lp.hd / 2), if(lp_k == 7, vb - lf.t - 24 * u - lp.hd / 2, if(lp_k == 8, yo + lf.t + 24 * u + lp.hd / 2, vc))))
    let lp.sy0 = if(lp_k > 6, lp.yf, lp.btn)
    let lp.gy0 = if(att > 0.5, lp.yf, lp.btn)
    let lp.cy = lp.gy0 + (lp.yf - lp.gy0) * dsl
    let lp.top = lp.cy - lp.hd / 2
    follow pw_y = lp.top
    on change panel {
        pq_sw = lm > 0.5 and pcur != none and panel != none and panel != pcur
        pending = if(pq_sw, panel, if(panel != none and panel != pending, none, pending))
        panel = if(pq_sw, none, panel)
        pcur = panel
        //  Which panel was opened last, and how wide it is: where the panels sit down the left follows it (see `lp.top`, `pcx`). Here, in the
        //  scene, not in the logic (its own popups, volume and notifications, set `panel` itself and nothing told it), and only once the panel
        //  is really being opened: a switch from one to another leaves the open one in its own shape until it has gone.
        lp_w = if(panel == settings, 620, if(panel == controls or panel == player or panel == tray, 312, if(panel == volume or panel == notif, 340, if(panel == calendar or panel == launch, 450, if(panel == desk, 340, lp_w)))))
        lp_k = if(panel == settings, 1, if(panel == launch, 2, if(panel == controls, 3, if(panel == calendar, 4, if(panel == tray, 5, if(panel == player, 6, if(panel == volume, 7, if(panel == notif, 8, if(panel == desk, 9, lp_k)))))))))
    }
    //  Whatever happened on the way (a hover that bounced between the two), the drawer that is coming out is the one whose shape and width the strip uses.
    on change dk > 0.5 while dk > 0.5 { lp_k = 3; lp_w = 312 }
    on change dc > 0.5 while dc > 0.5 { lp_k = 4; lp_w = 450 }
    //  ...and the waiting one opens once the drop of the one before has gone back in (its `dtrav` is back to nothing). It is the compound that is
    //  watched, so that it also fires when the wait begins with the strip already at rest.
    //  `pq.at` is how far back in the closing drop has to be: 0 would wait until it is gone, 1 would not wait at all. Half way, the next panel
    //  starts while the old one is still folding in, and the glass turns round smoothly from where it is (`dtrav` follows `panel`, so it reverses
    //  instead of restarting). If the shape snaps where they meet, lower it; for a closer overlap, raise it.
    let pq.at = 0.5
    on change dtrav < pq.at and pending != none while dtrav < pq.at and pending != none { panel = pending; pending = none }
    //  What a drop out of the strip is made of, as in Marea's (marea.plm, "the body"): the strip's edge bulges towards the drop while it holds it
    //  (`dj.sag`, most halfway), the neck is a bell that ends at nothing so that the thread breaks by itself (`dj.neck`), when it breaks two crests
    //  run along the edge (`dj.ripx`, `dj.riph`) and a small drop is left hanging from it for a moment (`dj.stray`), and the drop stretches with its
    //  speed (`dj.stretch`) and shakes (`wobble`) when it lets go. `dj.y0` is where it comes out: the panel's own vertical middle.
    let dj.out = clamp(dsl, 0, 1)
    let dj.tension = 4 * dj.out * (1 - dj.out)
    let dj.sag = max((26 * dj.tension + pbounce) * u * lm * (1 - att), 0.3)
    let dj.neck = 52 * u * 4 * dj.out * (1 - dj.out)
    let dj.ripx = (12 + 90 * prip) * u
    let dj.riph = 20 * u * (1 - prip) * clamp(prip * 6, 0, 1) * lm * (1 - att)
    let dj.stray = 10 * u * pstray * lm * (1 - att)
    let dj.stretch = clamp(vel(dtrav) * 0.07, 0, 0.5) * lm
    let dj.y0 = lp.sy0
    let dj.ey = if(lp_k == 1, vb - lf.t / 2, yo + lf.t / 2)     // the frame edge a drop comes out of (bottom for Settings, top for the launcher)
    let dj.es = if(lp_k == 1, -1, 1)                                  // and which way the small stray drop hangs from it: up, or down
    //  Those four shapes are never zero-size (a floor of 0.3 keeps them valid), so left in place they are a sliver on the strip's edge at the height of
    //  the panel last opened. They are only in play while a panel that drips is on its way or just after it (its ripples and stray drop), and
    //  off the screen the rest of the time (`show:` does not take a shape off the glass).
    let dj.act = if(lm > 0.5 and att < 0.5 and (dtrav > 0.02 or prip < 0.98 or pstray > 0.01 or abs(pbounce) > 0.2), 1, 0)
    let dj.px = if(dj.act > 0.5, 0, 30000)
    //  Each drawer's shape as it is drawn (`*.ex`, `*.ey` its middle, `*.ew`, `*.eh` its size). From the top bar it is the drawer above: it falls,
    //  widening on the way. Down the left it comes out sideways from the strip instead: it starts small and grows in both ways (`*.lf`, the same quick
    //  rise the width has above) around the panel's own vertical middle, and to the right, from the strip's middle to where the panel ends (`*.rt`, 6.5 past the plates' side: with the 6.5 in `pcx` it makes the margin all round (strip side, right, top) the same, 18.5; the calendar's and the launcher's are 450 wide here, not the bar's width, which grows with the tray icons). Its contents stay where
    //  they will end up, and the drawer's shape uncovers them (they are clipped to it).
    let dk.gl = mix(min(dtrav, dk0), dk0, att)
    let dk.lf = mix(min(1, dk0 * 1.6) + max(0, dk0 - 1) * 0.6, min(1, dk.gl * 1.6) + max(0, dk.gl - 1) * 0.6, lm)
    let dk.rt = mix(2 * (156 + 6.5) * cu, (lf.w - lf.x) + 325 * cu, att)
    let dk.gw = max(0.1, dk.rt * dk.lf)
    let dk.gh = (((content_bot + 16) * cu) + lp.dd + max(0, sag)) * dk.lf
    let dk.gx = mix(lp.xl + dk.gw / 2, ccx, edg)
    let dk.ew = mix(dk.w, dk.gw, lm)
    let dk.eh = mix(dk.hh, dk.gh, lm)
    let dk.ex = mix(pcx, dk.gx, lm)
    let dk.ey = mix(bar.y + dk.hh / 2, lp.cy, lm)
    let dc.gl = mix(min(dtrav, dc0), dc0, att)
    let dc.lf = mix(min(1, dc0 * 1.6) + max(0, dc0 - 1) * 0.6, min(1, dc.gl * 1.6) + max(0, dc.gl - 1) * 0.6, lm)
    let dc.rt = mix(2 * (225 + 6.5) * cu, (lf.w - lf.x) + 463 * cu, att)
    let dc.gw = max(0.1, dc.rt * dc.lf)
    let dc.gh = ((373 * cu) + lp.dd + max(0, sag)) * dc.lf
    let dc.gx = mix(lp.xl + dc.gw / 2, ccx, edg)
    let dc.ew = mix(dc.w, dc.gw, lm)
    let dc.eh = mix((bar.y + dc.hh - dc.top), dc.gh, lm)
    let dc.ex = mix(pcx, dc.gx, lm)
    let dc.ey = mix((dc.top + bar.y + dc.hh) / 2, lp.cy, lm)
    let ds.gl = min(dtrav, ds0)
    let ds.lf = mix(min(1, ds0 * 1.6) + max(0, ds0 - 1) * 0.6, min(1, ds.gl * 1.6) + max(0, ds.gl - 1) * 0.6, lm)
    let ds.rt = 2 * (310 + 6.5) * pu
    let ds.gw = max(0.1, ds.rt * ds.lf)
    let ds.gh = (((8 + 36 + 8 + set.h + 16) * pu) + lp.dd + max(0, sag)) * ds.lf
    let ds.gx = mix(lp.xl + ds.gw / 2, ccx, edg)
    let ds.ew = mix(ss.w, ds.gw, lm)
    let ds.eh = mix(ss.hh, ds.gh, lm)
    let ds.ex = mix(pcx, ds.gx, lm)
    let ds.ey = mix(bar.y + ss.hh / 2, lp.cy, lm)
    let dl.gl = min(dtrav, dl0)
    let dl.lf = mix(min(1, dl0 * 1.6) + max(0, dl0 - 1) * 0.6, min(1, dl.gl * 1.6) + max(0, dl.gl - 1) * 0.6, lm)
    let dl.rt = 2 * (225 + 6.5) * pu
    let dl.gw = max(0.1, dl.rt * dl.lf)
    let dl.gh = (((154 + lr * 44) * pu) + lp.dd + max(0, sag)) * dl.lf
    let dl.gx = mix(lp.xl + dl.gw / 2, ccx, edg)
    let dl.ew = mix(dl.w, dl.gw, lm)
    let dl.eh = mix((bar.y + dl.hh - dl.top), dl.gh, lm)
    let dl.ex = mix(pcx, dl.gx, lm)
    let dl.ey = mix((dl.top + bar.y + dl.hh) / 2, lp.cy, lm)
    //  The volume's and the notifications' drawer has its own place, whatever else is open: out of the right frame, the volume low and the
    //  notification high (down the left); from the bar, as before (along the top). Its content hangs from `os.ck` and is centred on `os.px`.
    let os.hd = (8 + osd_h + 16 + 13) * u
    let os.cy = if(osd_kind == vol or osd_kind == shot, vb - lf.t - 24 * u - os.hd / 2, yo + lf.t + 24 * u + os.hd / 2)
    //  The same two places in both layouts (the left layout's): the volume low and the notification high, out of the right edge of the screen. Along the top there
    //  is no frame there, so they come out of the edge of the screen itself. Content hangs from `os.ck`, centred on `os.px`.
    let os.stop = bar.y - bar.h / 2                           // the bar's top edge (the desk's island placement hangs from it)
    let os.px = screen.width - lf.t - 176.5 * u
    let os.ck = os.cy - (8 + osd_h / 2) * u
    let do.lf = min(1, do0 * 1.6) + max(0, do0 - 1) * 0.6
    let do.rt = lf.t + 379 * u
    let do.gw = max(0.1, do.rt * do.lf)
    let do.gh = (os.hd + max(0, sag)) * do.lf
    let do.gx = screen.width + 26 * u * do.lf - do.gw / 2
    let do.ew = do.gw
    let do.eh = do.gh
    let do.ex = do.gx
    let do.ey = os.cy
    let do.iw = max(0.1, 352 * u * do.lf)                       // along the top the panel is wholly on screen (the right frame's 8 in from the edge), so its corners are all rounded
    let do.ix = screen.width - lf.t - do.iw / 2
    let do.bl = (16 + 20 * do.bell) * u * min(1, do0 * 4)         // how much the drawer melts into what it joins
    let do.stretch = clamp(vel(do) * 0.07, 0, 0.5)
    let dm.gl = mix(min(dtrav, dm0), dm0, att)
    let dm.lf = mix(min(1, dm0 * 1.6) + max(0, dm0 - 1) * 0.6, min(1, dm.gl * 1.6) + max(0, dm.gl - 1) * 0.6, lm)
    let dm.rt = mix(2 * (156 + 6.5) * cu, (lf.w - lf.x) + 325 * cu, att)
    let dm.gw = max(0.1, dm.rt * dm.lf)
    let dm.gh = (((if(dm_mode == dmm_tray, tm_bot, panel_bot) + 16) * cu) + lp.dd + max(0, sag)) * dm.lf
    let dm.gx = mix(lp.xl + dm.gw / 2, ccx, edg)
    let dm.ew = mix(dm.w, dm.gw, lm)
    let dm.eh = mix(dm.hh, dm.gh, lm)
    let dm.ex = mix(pcx, dm.gx, lm)
    let dm.ey = mix(bar.y + dm.hh / 2, lp.cy, lm)
    //  The desk's drawer: the volume's out of the right frame, with its own size (see `do.*`).
    //  The desk: out of the right frame, in the middle of it (the Frame layout); or, in the Island layout, hanging from the top right corner of the
    //  screen, its first row level with the bar's, from the icon that opens it. `dsk_*` is where its contents are laid out, once out.
    let dsk_ri = mix(14 * cu, lf.t, lm)                        // the gap between the panel and the screen's right edge
    //  It can be pulled off its place by the grip along its top (`desk_ox`, `desk_oy`: how far it is from where it sits attached) and put back
    //  by dragging it near that place again. `dsk_h*` is that place, `dsk_x0`, `dsk_y0` where it is: everything in it is laid out from them.
    let dsk_hx0 = screen.width - dsk_ri - dsk_w                // its inner left edge, attached
    let dsk_hy0 = vc - dsk_h / 2                              // vertically centred on the right edge, in both layouts
    let dsk_x0 = dsk_hx0 + desk_ox
    let dsk_xc = dsk_x0 + dsk_w / 2
    let dsk_y0 = dsk_hy0 + desk_oy
    //  How far it can be carried: against the frame's inner edge on every side (8 from the screen's edge along the top), and no further right than home.
    let desk_xlo = lf.w * lm + 8 * cu * (1 - lm)
    let desk_ylo = yo + lf.t * lm + 8 * cu * (1 - lm)
    let desk_yhi = vb - lf.t * lm - 8 * cu * (1 - lm)
    let desk_xhi = screen.width - dsk_ri
    let desk_xmin = -(dsk_hx0 - desk_xlo)
    let desk_ymin = -(dsk_hy0 - desk_ylo)
    let desk_ymax = desk_yhi - dsk_hy0 - dsk_h * desk_s
    let desk_smax = max(0.5, min(1, min((desk_yhi - dsk_y0) / dsk_h, (desk_xhi - dsk_x0) / dsk_w)))     // how big it can be made where it is
    let dz.lf = min(1, dz0 * 1.6) + max(0, dz0 - 1) * 0.6
    let dz.rt = dsk_ri + dsk_w + 32.5 * cu
    //  Pulled off the frame, the glass stays joined to it by a neck that stretches (the blend of its shape in the frame's glass) while its far side
    //  lets go of the frame: `dz.det` is 0 until it has been pulled a little way and 1 once it is a panel of its own, 6.5 wider than its contents all round.
    let dz.det = clamp((abs(desk_ox + (desk_s - 1) * dsk_w) - 14 * cu) / (50 * cu), 0, 1) * lm
    let dz.gl = screen.width + 26 * cu * dz.lf - max(0.1, dz.rt * dz.lf) + desk_ox
    let dz.gr = mix(screen.width + 26 * cu * dz.lf, dz.gl + (dsk_w + 13 * cu) * dz.lf, dz.det)
    let dz.gw = max(0.1, dz.gr - dz.gl)
    let dz.gh = dsk_h * dz.lf
    let dz.ex = (dz.gl + dz.gr) / 2
    //  The frame's edge while it is pulled (`dz.sag`, most halfway), the two ripples (`dz.ripx`, `dz.riph`) and the small drop (`dz.stray`). They are
    //  never zero-size, and off the screen when nothing is happening (`show:` does not take a shape off the glass).
    let dz.sag = max((24 * 4 * dz.det * (1 - dz.det) * (1 - 0.5 * dz.det) + dbounce) * u * lm, 0.3)
    let dz.ripx = (12 + 90 * dprip) * u
    let dz.riph = 20 * u * (1 - dprip) * clamp(dprip * 6, 0, 1) * lm
    let dz.stray = 10 * u * dpstray * lm
    let dz.act = if(lm > 0.5 and desk_open and (abs(desk_ox + (desk_s - 1) * dsk_w) > 4 * cu or dprip < 0.98 or dpstray > 0.01 or abs(dbounce) > 0.2), 1, 0)
    let dz.px = if(dz.act > 0.5, 0, 30000)
    let dz.fy = mix(vc + desk_oy, desk_ry, dz.det)       // along the frame: where the neck is, then where it broke
    let dz.ey = vc + desk_oy
    //  What the glass is when the desk is scaled (about its top left corner, which `dsk_x0`, `dsk_y0` is): the contents are scaled by a group and take
    //  the unscaled shapes above for their clip, so the glass has its own. (`dz.s*` in the frame, `dz.i*` along the top.)
    //  Its right side is the exception: attached, it reaches into the frame, and that reach is not scaled with the rest (it would fall short of the contents).
    let dz.sgl = dsk_x0 + (dz.gl - dsk_x0) * desk_s
    let dz.sgr = mix(screen.width + 26 * cu * dz.lf, dsk_x0 + (dz.gl + (dsk_w + 13 * cu) * dz.lf - dsk_x0) * desk_s, dz.det)
    let dz.sex = (dz.sgl + dz.sgr) / 2
    let dz.sew = max(0.1, dz.sgr - dz.sgl)
    //  The contents are clipped inside the scaled group, so their clip is that glass at unscaled size.
    let dz.cgr = dsk_x0 + (dz.sgr - dsk_x0) / desk_s
    let dz.cx = (dz.gl + dz.cgr) / 2
    let dz.cw = max(0.1, dz.cgr - dz.gl)
    let dz.sey = dsk_y0 + (dz.ey - dsk_y0) * desk_s
    let dz.seh = dz.gh * desk_s
    //  Touching the frame anywhere melts into it the way the right edge does: each side that is near the frame's inner edge (`dz.d*` 0 against it, 1 once
    //  it is 64 away) reaches into the frame instead of ending, and the blend makes the wings. The right side is `dz.det` (above).
    let dz.dl = clamp((dsk_x0 - desk_xlo - 14 * cu) / (50 * cu), 0, 1)
    let dz.dt = clamp((dsk_y0 - desk_ylo - 14 * cu) / (50 * cu), 0, 1)
    let dz.db = clamp((desk_yhi - dsk_y0 - dsk_h * desk_s - 14 * cu) / (50 * cu), 0, 1)
    let dz.fl = mix(-26 * cu, dz.sex - dz.sew / 2, dz.dl)
    let dz.fr = dz.sex + dz.sew / 2
    let dz.ft = mix(yo - 26 * cu, dz.sey - dz.seh / 2, dz.dt)
    let dz.fb = mix(vb + 26 * cu, dz.sey + dz.seh / 2, dz.db)
    let dz.fx = (dz.fl + dz.fr) / 2
    let dz.fw = max(0.1, dz.fr - dz.fl)
    let dz.fcy = (dz.ft + dz.fb) / 2
    let dz.fh = max(0.1, dz.fb - dz.ft)
    let dz.free = max(dz.det, clamp((1 - desk_s) * 20, 0, 1))         // off the frame, or smaller than it was: the corner handles are there
    //  Along the top it is wholly on screen and centred, as in the left layout: its right edge 7.5 in from the screen's, all four corners show.
    let dz.iw = (dsk_w + 13 * cu) * dz.lf
    let dz.ih = dsk_h * dz.lf
    let dz.ix = screen.width - 7.5 * cu - dz.iw / 2 + desk_ox
    let dz.iy = vc + desk_oy
    let dz.six = dsk_x0 + (dz.ix - dsk_x0) * desk_s
    let dz.siw = dz.iw * desk_s
    let dz.siy = dsk_y0 + (dz.iy - dsk_y0) * desk_s
    let dz.sih = dz.ih * desk_s
    let dz.stretch = clamp(vel(dz) * 0.07, 0, 0.5)
    //  The notches (Frame layout only). Touch the middle of the top frame and a small tab grows out of it, with the three dots the volume
    //  card has under its plate; touch the bottom frame's middle and one grows up out of it. Pressing the tab opens the panel that
    //  comes out of that edge (the launcher from the top, Settings from the bottom), and pressing it again closes it. Hovering only
    //  brings the tab out. They sit in the middle of what can be seen (`ccx`), where those panels come out, whatever the resolution.
    //  The zones are declared here, before the bar and the panels, so theirs still win.
    let nt_w = 52 * cu                                     // the tab's width
    let nt_d = 15 * cu                                     // how far it hangs out of the frame
    zone box ntz_t { at: ccx, yo + (lf.t + 6 * cu) / 2; size: nt_w + 24 * cu, lf.t + 6 * cu; active: lm > 0.5 }
    zone box ntz_b { at: ccx, vb - (lf.t + 6 * cu) / 2; size: nt_w + 24 * cu, lf.t + 6 * cu; active: lm > 0.5 }
    zone box ntn_t { at: ccx, yo + (lf.t + nt_d) / 2; size: nt_w, lf.t + nt_d; cursor: pointer; active: lm > 0.5 and nt_vis_t > 0.5 }
    zone box ntn_b { at: ccx, vb - (lf.t + nt_d) / 2; size: nt_w, lf.t + nt_d; cursor: pointer; active: lm > 0.5 and nt_vis_b > 0.5 }
    zone box ntp_t { at: dl.ex, dl.ey; size: dl.ew + 8, dl.eh + 8; active: lm > 0.5 and panel == launch }
    zone box ntp_b { at: ds.ex, ds.ey; size: ds.ew + 8, ds.eh + 8; active: lm > 0.5 and panel == settings }
    prop nt_vis_t = 0 ~calm                                // how far the tab is out
    prop nt_vis_b = 0 ~calm
    prop nt_hold_t = 0 ~280ms                              // on the edge, the tab or the panel: until the tab goes back and the panel closes
    prop nt_hold_b = 0 ~280ms
    follow nt_hold_t = if(max(ntz_t.hover, max(ntn_t.hover, ntp_t.hover)) > 0.5, 1, 0)
    follow nt_hold_b = if(max(ntz_b.hover, max(ntn_b.hover, ntp_b.hover)) > 0.5, 1, 0)
    follow nt_vis_t = if(nt_hold_t > 0.3, 1, 0)
    follow nt_vis_b = if(nt_hold_b > 0.3, 1, 0)
    //  The right notch opens the desk: a panel out of the right frame with a few small tools, in tabs. It is not one of the values of `panel`, so it
    //  stays open while the calendar, the controls, the volume or a notification come and go. It is drawn like the volume's and the title panel's
    //  drawers (`dz.*`: the same springs and shape) but with its own geometry, which does not depend on whichever of those is out.
    fact desk_open = false
    fact desk_tab = 3                                      // 0 Pad, 1 Shelf, 2 Clip, 3 Focus, 4 Term, 5 Ask
    prop desk_sel = 3 ~slide                               // which tab the thumb is on
    //  Carrying the desk: `desk_gx`, `desk_gy` is where it is being taken to (an offset from its place in the frame), `desk_ox`, `desk_oy` where it
    //  is, on a loose spring, so it trails the pointer like a drop and lands past its place when it is let go near it and snaps back.
    fact desk_gx = 0
    fact desk_gy = 0
    fact desk_bx = 0                                       // where it was when the grip was pressed
    fact desk_by = 0
    fact desk_hold = false                                 // the grip is held: its zone stays where it was pressed, it would lose the drag if it moved with the panel
    fact desk_hx = 0
    fact desk_hy = 0
    //  Detached, it can also be made smaller by the handle in its bottom corner (`desk_s`, 0.5 to 1; everything in it scales about its top left corner,
    //  `desk_gs` is where the scale is going). Put back in its place it is full size again.
    fact desk_gs = 1
    fact desk_bs = 1                                       // the scale when the handle was pressed
    fact desk_rk = -1                                      // which corner's handle is held (0 top left, 1 top right, 2 bottom left, 3 bottom right)
    fact desk_fcx = 0                                      // the corner across from it, which stays where it is
    fact desk_fcy = 0
    fact desk_rhold = false                                // the handle is held: its zone stays where the pointer is, as the grip's does
    fact desk_qx = 0
    fact desk_qy = 0
    spring desk_sp = 300, 20
    prop desk_s = 1 ~desk_sp
    follow desk_s = desk_gs
    prop desk_ox = 0 ~desk_sp
    prop desk_oy = 0 ~desk_sp
    follow desk_ox = desk_gx
    follow desk_oy = desk_gy
    on change desk_open while not desk_open { desk_gx = 0; desk_gy = 0; desk_gs = 1; desk_hold = false; desk_rhold = false; desk_rk = -1 }
    //  The frame's side of the liquid, as the drip down the left has it (`dj.*`): while the desk is pulled the frame's edge bulges towards it; when
    //  the neck breaks the edge jumps and bounces, two ripples run along it and a small drop is left hanging; put back, the edge closes over it.
    prop dbounce = 0 ~splash
    prop dprip = 1 ~1100ms
    prop dpstray = 0 ~700ms
    fact desk_ry = 0                                       // where along the frame the neck broke
    on change dz.det > 0.7 while dz.det > 0.7 { desk_ry = vc + desk_oy; impulse dbounce -280; impulse wobble -300; dprip: 0 ~16ms; dprip: 1 ~1100ms after 30ms; dpstray: 1 ~16ms; dpstray: 0 ~700ms after 60ms }
    on change dz.det < 0.7 while dz.det < 0.7 and desk_open { desk_ry = vc + desk_oy; impulse dbounce 80; impulse wobble 200 }
    on change dz.det < 0.05 while dz.det < 0.05 and desk_open { desk_ry = vc + desk_oy; impulse dbounce -200; impulse wobble -120; dprip: 0 ~16ms; dprip: 1 ~900ms after 30ms }
    follow desk_sel = desk_tab
    zone box ntz_r { at: screen.width - (lf.t + 6 * cu) / 2, vc; size: lf.t + 6 * cu, nt_w + 24 * cu; active: lm > 0.5 and not desk_open }
    zone box ntn_r { at: screen.width - (lf.t + nt_d) / 2, vc; size: lf.t + nt_d, nt_w; cursor: pointer; active: lm > 0.5 and nt_vis_r > 0.5 and not desk_open }
    prop nt_vis_r = 0 ~calm
    prop nt_hold_r = 0 ~280ms
    follow nt_hold_r = if(max(ntz_r.hover, ntn_r.hover) > 0.5, 1, 0)
    follow nt_vis_r = if(nt_hold_r > 0.3 and not desk_open, 1, 0)
    on press ntn_r { desk_open = true }
    //  The focus timer (see the Focus section of vitreus.luau).
    event ft_toggle ->                                      // start, pause or resume; carries the minutes
    event ft_reset ->
    event ft_set ->                                         // a preset was chosen while idle
    fact ft_len = 30
    fact ft_state = 0                                       // 0 ready, 1 running, 2 paused, 3 done
    fact ft_prog = 1.0                                      // the fraction left
    fact desk_kb = false                                    // typing in the desk (the task field, the terminal): only then does it take the keyboard
    on change desk_tab { desk_kb = false; term_armed = false }
    on change desk_open while not desk_open { desk_kb = false; term_armed = false }
    //  Settings and the launcher are wide (316.5 * pu each side of the middle), so on a smaller screen they reach the desk's side and the two glasses
    //  melt into each other. Whichever of the two was opened last stays; the other one goes.
    let desk_clash = if(lm > 0.5 and ccx + 316.5 * pu > dsk_hx0 - 8 * cu, 1, 0)
    on change desk_open while desk_open and desk_clash > 0.5 and (panel == settings or panel == launch) { panel = none }
    on change panel while (panel == settings or panel == launch) and desk_open and desk_clash > 0.5 { desk_open = false }
    //  The terminal follows the mouse, as Hyprland's windows do here: once it has been clicked, the pointer coming back over the desk
    //  gives it the keyboard again, and leaving lets it go (`desk_band`), until the desk shuts or another tab is chosen.
    fact term_armed = false
    //  The terminal (Term tab; see the Terminal section of vitreus.luau). bin/vitreus-term runs the shell and keeps its screen; the logic
    //  hands each stretch of one colour to `term_runs` (row, column, text, colours) and the cursor to `term_c*`. It is 64 by 35 cells of
    //  Space Mono (the monospaced sibling of Space Grotesk, as the Nerd Font build so prompts keep their icons) at 11.75 px, 7.19 by 16
    //  px each, which is what fits the desk's card; the logic starts the shell at that size.
    model term_runs max 256 { t: text; x: number; y: number; n: number; fg: bool; r: number; g: number; b: number; hasbg: bool; br: number; bg: number; bb: number; bold: bool }
    fact term_cx = 0
    fact term_cy = 0
    fact term_cur = false                                   // the cursor is to be drawn (a program can hide it; scrolled back it is not where you type)
    fact term_scrolled = 0                                  // how many lines back in the history the view is
    fact term_state = 0                                     // 0 not started, 1 running, 2 the shell has ended, 3 it cannot run (`term_msg` says why)
    text term_msg = ""
    event term_scroll ->                                    // the wheel over the terminal: carries `wheel`
    //  Keys typed in the terminal reach the logic only if no input has the writing cursor, and gaining the keyboard gives it to the
    //  first input there is (the task field, even hidden). So when it is the terminal that takes the keyboard, the cursor is taken
    //  away again; only then: the desk stays on Term while the search or another panel opens, and theirs must keep it.
    on focus while desk_open and desk_tab == 4 and desk_kb and panel == none { blur }
    fact ft_dnd = true                                      // silence notifications while it runs
    fact ft_caf = true                                      // keep the machine awake while it runs
    text ft_time = "30:00"
    prop ft_ring = 1 ~gentle
    prop ft_press = 0 ~pop
    //  The desk's contents come in one after another once the drawer is out, like the title panel's (`f3`) and the controls' (`f5`..`f7`):
    //  each section fades in and rises a little, on a longer spring than the one before.
    prop fd0 = 0 ~380ms                                     // the tabs
    prop fd1 = 0 ~560ms
    prop fd2 = 0 ~680ms
    prop fd3 = 0 ~780ms
    prop fd4 = 0 ~880ms
    on change desk_open while desk_open { fd0: 1 after 200ms; fd1: 1 after 200ms; fd2: 1 after 200ms; fd3: 1 after 200ms; fd4: 1 after 200ms }
    on change desk_open while not desk_open { fd0: 0 ~80ms; fd1: 0 ~80ms; fd2: 0 ~80ms; fd3: 0 ~80ms; fd4: 0 ~80ms }
    //  The shelf: up to eight things dropped on it (files, links, text), each draggable back out to another program.
    repeat k in 0..8 {
        text shelf.$k.name = ""
        text shelf.$k.path = ""
        text shelf.$k.tag = ""
        fact shelf.$k.has = false
        fact shelf.$k.askable = false
        //  The same for the shelf's cards: one that is dismissed slides off and fades, and the ones after it glide into its place.
        fact shelf.$k.gone = false
        prop shelf.$k.out = 0 ~180ms
        prop shelf.$k.dx = 0 ~220ms
        prop shelf.$k.dy = 0 ~220ms
        on change shelf.$k.gone while shelf.$k.gone { shelf.$k.out: 1 ~180ms }
        on change shelf.$k.gone while not shelf.$k.gone { shelf.$k.out: 0 ~0ms }
        on shelf_shifted(v) while k >= v { shelf.$k.dx: if(mod(k, 2) == 0, 158, -158) * cu ~0ms; shelf.$k.dy: if(mod(k, 2) == 0, 0, 50) * cu ~0ms; shelf.$k.dx: 0 ~220ms after 40ms; shelf.$k.dy: 0 ~220ms after 40ms }
    }
    fact shelf_n = 0
    event shelf_del ->
    event shelf_clear ->
    event shelf_ask ->
    prop desk_drag = 0 ~120ms                               // 1 while something from another program is being carried over the desk
    follow desk_drag = drag.over
    prop shelf_flash = 0 ~calm                              // the glow of a drop that has just landed
    //  The task list: nine lines with a check each.
    repeat k in 0..9 {
        text task.$k.text = ""
        fact task.$k.has = false
        fact task.$k.done = false
        prop task.$k.p = 0 ~pop
        follow task.$k.p = if(task.$k.done, 1, 0)
        //  Dismissed: the line slides off to the right and fades (the logic marks it `gone`, waits a moment, then removes it), and the
        //  lines under it glide up into the gap (`task_shifted` says from which one; each starts where its text was and settles).
        fact task.$k.gone = false
        prop task.$k.out = 0 ~180ms
        prop task.$k.dy = 0 ~220ms
        on change task.$k.gone while task.$k.gone { task.$k.out: 1 ~180ms }
        on change task.$k.gone while not task.$k.gone { task.$k.out: 0 ~0ms }
        on task_shifted(v) while k >= v { task.$k.dy: 29 * cu ~0ms; task.$k.dy: 0 ~220ms after 40ms }
    }
    fact task_n = 0
    //  The drawing board in the Pad tab: the logic keeps the strokes as short segments (half units, from the board's corner) and gives
    //  them back here to draw, up to 768 in three lists of 256. A point is reported as one number: x * 1000 + y, in half units.
    fact pad_mode = 0                                       // 0 tasks, 1 draw
    prop pad_sel = 0 ~slide
    follow pad_sel = pad_mode
    fact dr_col = 0                                         // the pen: a colour out of five
    fact dr_thick = 0                                       // and one of three sizes (also the eraser's)
    fact dr_tool = 0                                        // 0 pen, 1 eraser
    fact dr_held = false                                    // the pointer is down on the board
    fact dr_px = 0                                          // and where, for the eraser's ring
    fact dr_py = 0
    model dr_segs0 max 256 { x0: number; y0: number; x1: number; y1: number; c: number; w: number }
    model dr_segs1 max 256 { x0: number; y0: number; x1: number; y1: number; c: number; w: number }
    model dr_segs2 max 256 { x0: number; y0: number; x1: number; y1: number; c: number; w: number }
    event dr_down ->
    event dr_pt ->
    event dr_up ->
    event dr_undo ->
    event dr_clear ->
    text task_in = ""
    //  The Ask tab (logic/ask.luau): which assistant, which of them are installed, the conversation as one text, and where it is scrolled.
    fact ask_backend = 0                                   // 0 Claude, 1 Ollama, 2 Codex, 3 Gemini
    repeat k in 0..4 { fact ask_have.$k = false }
    fact ask_ok = false                                    // the chosen one can answer
    fact ask_busy = false
    fact ask_nmodels = 0                                   // how many Ollama models there are to choose from
    fact ask_n = 0
    text ask_in = ""
    model ask_rows max 60 { kind: number; who: text; body: text; lang: text; first: bool }     // 0 you, 1 answer, 2 code, 3 note
    event ask_copy ->
    //  The Clip tab (logic/clipboard.luau): the clipboard history, pinned entries first.
    model clip_rows max 48 { label: text; pinned: bool; image: bool }
    event clip_copy ->
    event clip_pin ->
    event clip_ask ->
    event clip_del ->
    event clip_refresh ->
    fact clip_n = 0
    text clip_msg = ""
    fact clip_flash = false                                   // `clip_msg` is showing (a moment, after a copy)
    event ask_attach ->                                       // something to ask about, from elsewhere: `ask_attach_in` is the text, `ask_attach_src` what it is
    event ask_att_clear ->
    event ask_attached ->
    text ask_attach_in = ""
    text ask_attach_src = ""
    text ask_att_label = ""
    fact ask_att = 0                                          // how many characters wait to go with the next question; 0 for none
    text ask_status = ""
    measure ask_clr                                        // the width of "Clear", so its underline is exactly as long
    event ask_pick ->
    event ask_new ->
    event ask_stop ->
    event ask_cycle ->
    //  Claude's plan usage (the five-hour and seven-day windows, 0 to 1, -1 until an answer has said), as two thin bars under the status row, and
    //  when each resets. The bars take 33 off the conversation's card (`ask_dy`) while Claude is the one chosen and has said.
    fact ask_u5 = -1
    fact ask_u7 = -1
    text ask_r5 = ""
    text ask_r7 = ""
    prop ask_us = 0 ~calm
    follow ask_us = if(ask_backend == 0 and ask_u5 >= 0, 1, 0)
    prop ask_f5 = 0 ~calm
    prop ask_f7 = 0 ~calm
    follow ask_f5 = max(0, ask_u5)
    follow ask_f7 = max(0, ask_u7)
    let ask_dy = 33 * cu * ask_us
    prop ask_atts = 0 ~calm
    follow ask_atts = if(ask_att > 0, 1, 0)
    let ask_db = 26 * cu * ask_atts                          // and 26 off its foot while something waits to go with the next question
    on ask_attached { desk_open = true; desk_tab = 5; focus ask_in; desk_kb = true }
    fact ask_follow = true                                   // the conversation follows its end while an answer comes in, until the wheel takes it back up
    on change desk_open while not desk_open { ask_follow = true }
    event task_toggle ->
    event task_del ->
    event task_clear ->
    event task_shifted                                      // from the logic: lines from this one on have moved up
    event shelf_shifted
    prop ft_dnd_p = 1 ~pop
    prop ft_caf_p = 1 ~pop
    follow ft_dnd_p = if(ft_dnd, 1, 0)
    follow ft_caf_p = if(ft_caf, 1, 0)
    prop ft_sel = 1 ~slide
    follow ft_ring = ft_prog
    follow ft_sel = if(ft_len == 15, 0, if(ft_len == 30, 1, if(ft_len == 45, 2, 3)))
    on press ntn_t { panel = if(panel == launch, none, launch) }
    on press ntn_b { panel = if(panel == settings, none, settings) }
    //  Declared here, before the bar and the panels, so that every zone of theirs drawn over them still takes its own presses.
    //  The control centre and the calendar open on a click, from the strip's icon and its clock; a click on either again, a click anywhere else or Esc closes them.
    zone box ctl_btn_z { at: lf.w / 2, lv.ctl; size: lf.w, 36 * u; cursor: pointer; active: lm > 0.5 }
    on press ctl_btn_z { panel = if(panel == controls, none, controls) }
    zone box cal_btn_z { at: lf.w / 2, lv.clk + 30 * u; size: lf.w, 104 * u; cursor: pointer; active: lm > 0.5 }
    on press cal_btn_z { panel = if(panel == calendar, none, calendar) }
    //  The window title (and the player's buttons over it) the same way: a click on it opens the player's panel.
    //  At least as long as an edge notch (`nt_w`), so a short title ("Signal") is still easy to find and to hit, and an empty workspace (no title at all) still opens the list of windows.
    zone box pl_btn_z { at: lf.w / 2, lv.tm; size: lf.w, max(52 * cu, lv.span); cursor: pointer; active: lm > 0.5 and bv.title }
    on press pl_btn_z { panel = if(panel == player, none, player) }
    //  A small tab out of the strip's right edge beside the title, while the pointer is on it: the edge notches' way of
    //  saying "this opens", only a few pixels. It tucks back in when the player's panel comes out of the same place.
    let ptab_h = max(52 * cu, lv.span)             // as long as what can be clicked (`pl_btn_z`): the title text only, not the player's buttons
    let ptab_d = 5 * u                                     // how far out it comes
    prop ptab_vis = 0 ~calm                        // the same spring as the edge notches (`nt_vis_*`)
    prop ptab_hold = 0 ~280ms                      // the notches' short wait before coming out, and grace before going back
    follow ptab_hold = if(pl_btn_z.hover > 0.5 and panel != player, 1, 0)
    follow ptab_vis = if(ptab_hold > 0.3, 1, 0)
    on change dm > 0.5 while dm > 0.5 and panel == player { lp_k = 6; lp_w = 312 }
    //  Where the contents hang from: the panel's old middle, so they keep their
    //  place when the panel grows to make room for the player.
    let cy = bar.y + bar.h / 2 + (6 + 125 * mix(drop, 1, lm)) * ku + lp.dy
    //  The controls' content hangs from here: 127 above `cy`, so the volume plate starts 12 under the
    //  bar and the drawer is only as tall as its two plates and their margins.
    let ck = cy - 127 * ku

    include "pages/bar_glass.plm"
    //  Along the top the volume's and the notification's glass is its own, outside the group above: that group is bent by the bar's wave, which the music drives,
    //  and these panels are not part of the bar. (In the left layout the shape stays in the main glass, where it joins the right frame.)
    group {
        body {
            color: tint
            glass: glass_frost
            opacity: glass_op
            lens: glass_bend
            refraction: glass_refr
            dispersion: glass_disp
            rim: 10% * glass_rim
            shine: pointer
            shadow: 0, 7, 20, 24%, deep
            box { at: do.ix + if(lm < 0.5 and do0 > 0.004, 0, 30000), do.ey; size: do.iw * (1 + do.stretch - 0.07 * do.bell + 0.003 * wobble), do.eh * (1 - do.stretch * 0.5 - 0.002 * wobble); corner: mix(min(do.ew, do.eh) / 2, 26 * u, clamp(do0 * 1.6 - 0.1, 0, 1)); show: do0 > 0.004 }
            box { at: dz.six + if(lm < 0.5 and dz0 > 0.004, 0, 30000), dz.siy; size: dz.siw * (1 + dz.stretch - 0.07 * dz.bell), dz.sih * (1 - dz.stretch * 0.5); corner: mix(min(dz.siw, dz.sih) / 2, 26 * u * desk_s, clamp(dz0 * 1.6 - 0.1, 0, 1)); show: dz0 > 0.004 }
        }
    }
    //  The desk's contents (and its tab and opener): drawn after the island's glass above, so the glass is under them and not over them.
        //  The right tab's three dots (stacked, since the tab is on the side).
        group {
            show: lm > 0.35 and nt_vis_r > 0.05
            repeat i in 0..3 {
                ellipse { at: screen.width - lf.t - nt_d * nt_vis_r / 2, vc + (i - 1) * 6.5 * cu; radius: 1.6 * cu; color: ink; opacity: (35% + 55% * ntn_r.hover) * clamp(nt_vis_r * 1.6 - 0.4, 0, 1) }
            }
        }
        //  The Island layout's way in to the desk: a small side-panel icon in the top right corner, level with the bar. It stays while the desk is open, lit,
        //  and pressing it opens or closes the desk.
        group {
            show: lm < 0.65
            opacity: 1 - clamp(lm * 1.5, 0, 1)
            ellipse { at: screen.width - 41 * cu, os.stop + 20 * u; radius: 14 * cu; color: mix(ink, mint, clamp(dz0, 0, 1)); opacity: 7% + 12% * desk_open_z.hover + 12% * clamp(dz0, 0, 1) }
            //  The glyph: a dashboard, one tall tile beside two small ones (a panel of several things), filled and soft; mint while the desk is open.
            box { at: screen.width - 41 * cu - 5 * cu, os.stop + 20 * u; size: 7 * cu, 14 * cu; corner: 2 * cu; color: mix(ink, mint, clamp(dz0, 0, 1)); opacity: 70% + 30% * desk_open_z.hover }
            box { at: screen.width - 41 * cu + 5 * cu, os.stop + 20 * u - 4.25 * cu; size: 7 * cu, 5.5 * cu; corner: 1.8 * cu; color: mix(ink, mint, clamp(dz0, 0, 1)); opacity: 70% + 30% * desk_open_z.hover }
            box { at: screen.width - 41 * cu + 5 * cu, os.stop + 20 * u + 4.25 * cu; size: 7 * cu, 5.5 * cu; corner: 1.8 * cu; color: mix(ink, mint, clamp(dz0, 0, 1)); opacity: 55% + 45% * desk_open_z.hover }
            zone box desk_open_z { at: screen.width - 41 * cu, os.stop + 20 * u; size: 32 * cu, 32 * cu; corner: 16 * cu; cursor: pointer; active: lm < 0.5 }
            on press desk_open_z { desk_open = not desk_open }
        }
    include "pages/desk.plm"

    include "pages/bar_icons.plm"


    //  The bar's text is drawn on top of the bar, outside its wave-shader group: inside it the letters are
    //  resampled by the shader, which blurs them and smears them whenever the music makes the wave move.
    //  The glass and the icons still bend; the words stay sharp.
    //  The clock in the bar is four texts, right-aligned and set against each other from their measured widths:
    //  the hour, oversized; the minutes with their colon, in the accent, the two digits tucked 3 px over each
    //  other (the colon is left clear: overlapped it disappears); and, at the edge, a small column: the day
    //  stacked tight over a dim am/pm, centred on each other.
    text bar_date { at: floor(clock.r - clock.col / 2 + 0.5), floor(bar.y - 8 + 0.5); anchor: center; size: 11; weight: 700; measure: cdw; color: faint; opacity: bs.clock * (1 - lm); shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text bar_ap { at: floor(clock.r - clock.col / 2 + 0.5), floor(bar.y + 7 + 0.5); anchor: center; size: 14; weight: 600; measure: caw; color: faint; opacity: bs.clock * (1 - lm); shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text clock_mm { at: floor(clock.r - clock.col - 3 + 0.5), floor(bar.y + 3 + 0.5); anchor: right center; size: 26; weight: 700; measure: cmw; letter_move: 3 * ((letters - 1 - letter) - if(letter == 0, 1, 0)), 0; color: mint; opacity: bs.clock * (1 - lm); shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text clock_h { at: floor(clock.r - clock.col - cmw.width + 0.5), floor(bar.y + 0.5); anchor: right center; size: 40; weight: 700; measure: chw; color: ink; opacity: bs.clock * (1 - lm); shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    //  Down the left the clock is stacked in the strip: the hour, the minutes under it in the accent, and the am/pm.
    text clock_h { at: floor(lf.x - 5 * u + 0.5), floor(lv.clk + 0.5); anchor: center; align: center; size: 30; weight: 700; gradient: 0, lv.clk - 18 * u to 0, lv.clk + 33 * u, minthi, mint 55%, mintlo; opacity: bs.clock * lm; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text clock_mn { at: floor(lf.x - 5 * u + 0.5), floor(lv.clk + 28 * u + 0.5); anchor: center; align: center; size: 17; weight: 700; gradient: 0, lv.clk - 18 * u to 0, lv.clk + 33 * u, minthi, mint 55%, mintlo; opacity: bs.clock * lm; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    box { at: lf.x - 5 * u, lv.clk + 16.5 * u; size: 18 * u, 1.8 * u; corner: 0.9 * u; color: mint; opacity: 65% * bs.clock * lm }   // the rule under the hour
    //  am/pm: two letters one over the other, on the right, level with the rule (the hour and the minutes are moved left to make room).
    text bar_ap1 { at: floor(lf.x + 12.5 * u + 0.5), floor(lv.clk + 11.9 * u + 0.5); anchor: center; align: center; size: 11; weight: 700; color: mint; opacity: bs.clock * lm; family: "Space Grotesk" }
    text "m" { at: floor(lf.x + 12.5 * u + 0.5), floor(lv.clk + 21.1 * u + 0.5); anchor: center; align: center; size: 11; weight: 700; color: mint; opacity: bs.clock * lm; family: "Space Grotesk" }
    //  Under them the day of the week and the date.
    text bar_date { at: floor(lf.x + 5 * u + 0.5), floor(lv.clk + 41 * u + 0.5); anchor: center; align: center; size: 11; weight: 700; color: faint; opacity: bs.clock * lm; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text date_md { at: floor(lf.x + 0.5), floor(lv.clk + 55 * u + 0.5); anchor: center; align: center; size: 14; weight: 700; color: ink; opacity: bs.clock * lm; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    //  The window title down the left: the app, and under it (to its right once turned) the title, turned a quarter anticlockwise so that it reads
    //  from the foot up, each centred on the strip's middle line and on the stretch `lv.tm` and cut with an ellipsis where that ends.
    group {
        pivot: lf.x - 9 * cu, lv.tm
        rotate: -90deg
        opacity: lm * bs.title0
        text win.class { at: floor(lf.x - 9 * cu + 0.5), floor(lv.tm + 0.5); anchor: center; align: center; size: 15; weight: 600; width: max(1, lv.span); lines: 1; color: faint; opacity: 70%; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    }
    group {
        opacity: lm * bs.title0 * lv.none
        repeat i in 0..3 {
            ellipse { at: lf.x, lv.tm + (i - 1) * 8 * cu; radius: 1.9 * cu; color: faint; opacity: 70% + 30% * pl_btn_z.hover }
        }
    }
    group {
        pivot: lf.x + 9 * cu, lv.tm
        rotate: -90deg
        opacity: lm * bs.title0
        text win.title { at: floor(lf.x + 9 * cu + 0.5), floor(lv.tm + 0.5); anchor: center; align: center; size: 14; weight: 500; width: max(1, lv.span); lines: 1; color: ink; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    }
    text win.class { at: floor(win.x + 0.5), floor(bar.y - 6.5 * u + 0.5); anchor: left center; size: 17 * u; weight: 600; width: max(0, win.hw - 12 * u - mctl); lines: 1; color: faint; opacity: 55% * bs.title; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text win.title { at: floor(win.x + 0.5), floor(bar.y + 8.75 * u + 0.5); anchor: left center; size: 13.5 * u; weight: 500; width: max(0, win.hw - 12 * u); lines: 1; color: ink; opacity: bs.title; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }

    include "pages/panel_frame.plm"
    include "pages/controls_drawer.plm"
    include "pages/player.plm"
    //  ── the launcher ──
    //  A search field over its results. What is typed picks the kind of search: apps, or after a first
    //  character `#` files, `>` commands, `:` emoji, `^` the clipboard, `~` wallpapers; and a sum is answered. The
    //  logic (see the Launcher section of vitreus.luau) reads the field and fills `lres`. Files, the clipboard and
    //  wallpapers have a preview beside the rows: the picture, or the text, and the file's details.
    group {
        clip inset 2 box { at: mix(pcx, dl.gx, lm), mix(bar.y + dl.hh / 2, lp.cy, lm); size: mix(dl.w, dl.gw, lm), mix(dl.hh, dl.gh, lm); corner: 26 * pu }
        opacity: fl
        move: 0, (1 - fl) * 12 * pu
        let lx = pcx - 215 * pu
        let lhy = ck + 25 * pu                             // the header's middle
        let ly = ck + 50 * pu                              // the field's top
        let lry = ly + 68 * pu                             // the rows start under the hints
        let lph = max(1, lr * 44 - 4) * pu                 // the rows' height, and the preview's
        let lpx = lx + lw + 8 * pu                         // the preview's left edge
        let lpw = 430 * pu - lw - 8 * pu
        //  Header, like Settings': a badge with an icon, the title, a chip with what kind of search it is (apps, files...), and a cross.
        box { at: lx + 16 * pu, lhy; size: 32 * pu, 32 * pu; corner: 9 * pu; color: mint; opacity: 20% }
        repeat i in 0..4 {
            box { at: lx + 16 * pu + (mod(i, 2) - 0.5) * 8.5 * pu, lhy + (floor(i / 2) - 0.5) * 8.5 * pu; size: 6.5 * pu, 6.5 * pu; corner: 2 * pu; color: mint }
        }
        text "SEARCH" { at: floor(lx + 40 * pu + 0.5), floor(lhy + 0.5); anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" }
        box { at: lx + 168 * pu, lhy; size: 100 * pu, 22 * pu; corner: 11 * pu; color: ink; opacity: 6% }
        text lmode { at: floor(lx + 168 * pu + 0.5), floor(lhy + 0.5); anchor: center; align: center; size: 13; weight: 700; width: 90 * pu; lines: 1; color: mint; family: "Space Grotesk" }
        ellipse { at: lx + 414 * pu, lhy; radius: 13 * pu; color: ink; opacity: 5% + 10% * launch_x.hover }
        line { from: lx + 409.5 * pu, lhy - 4.5 * pu; to: lx + 418.5 * pu, lhy + 4.5 * pu; width: 1.5 * pu; color: ink; opacity: 60% + 40% * launch_x.hover }
        line { from: lx + 418.5 * pu, lhy - 4.5 * pu; to: lx + 409.5 * pu, lhy + 4.5 * pu; width: 1.5 * pu; color: ink; opacity: 60% + 40% * launch_x.hover }
        zone box launch_x { at: lx + 414 * pu, lhy; size: 28 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
        on press launch_x { panel = none }
        box { from: lx, ly; size: 430 * pu, 40 * pu; corner: 20 * pu; color: ink; opacity: 8% }
        ellipse { at: lx + 24 * pu, ly + 19 * pu; radius: 5.5 * pu; stroke: 1.6 * pu; color: mint }
        line { from: lx + 28 * pu, ly + 23 * pu; to: lx + 32.5 * pu, ly + 27.5 * pu; width: 1.8 * pu; color: mint }
        input lq { at: floor(lx + 46 * pu + 0.5), floor(ly + 12 * pu + 0.5); width: 366 * pu; size: 20; color: ink; family: "Space Grotesk"; placeholder: "Search apps…" }
        text "files" { at: 0, 0; size: 13; lines: 1; measure: lhw0; opacity: 0; family: "Space Grotesk" }
        text "commands" { at: 0, 0; size: 13; lines: 1; measure: lhw1; opacity: 0; family: "Space Grotesk" }
        text "emoji" { at: 0, 0; size: 13; lines: 1; measure: lhw2; opacity: 0; family: "Space Grotesk" }
        text "clipboard" { at: 0, 0; size: 13; lines: 1; measure: lhw3; opacity: 0; family: "Space Grotesk" }
        text "wallpapers" { at: 0, 0; size: 13; lines: 1; measure: lhw4; opacity: 0; family: "Space Grotesk" }
        //  What the first character of the search does, in small type under the field: press one to type it. Five
        //  equal cells across the field, each pair (character, name) centred in its cell, a divider between cells.
        repeat i in 0..5 {
            let hc = lx + (i + 0.5) * 86 * pu                   // the cell's middle
            let hy = ly + 54 * pu
            let hx = floor(hc - (12 * pu + pick(i, lhw0.width, lhw1.width, lhw2.width, lhw3.width, lhw4.width)) / 2 + 0.5)   // where the pair starts
            box { at: hc, hy; size: 82 * pu, 18 * pu; corner: 9 * pu; color: ink; opacity: 8% * lhint_hit.$i.hover }
            text pick(i, "#", ">", ":", "^", "~") { at: hx, floor(hy + 0.5); anchor: left center; size: 15; weight: 700; color: mint; family: "Space Grotesk" }
            text pick(i, "files", "commands", "emoji", "clipboard", "wallpapers") { at: hx + floor(12 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; color: faint; family: "Space Grotesk" }
            line { from: lx + i * 86 * pu, hy - 5 * pu; to: lx + i * 86 * pu, hy + 5 * pu; width: 1 * pu; color: ink; opacity: 18%; show: i > 0 }
            zone box lhint_hit.$i { at: hc, hy; size: 84 * pu, 18 * pu; corner: 9 * pu; cursor: pointer }
            on press lhint_hit.$i { emit launch_hint(i) }
        }
        //  The wheel over the rows scrolls the list (under the rows, so their presses still win).
        zone box lwheel { from: lx, lry; size: lw, lph }
        on scroll lwheel { emit launch_scroll(-wheel) }
        column lcol {
            at: floor(lx + 0.5), floor(lry + 0.5)     // on whole pixels, as each row's height and the gap are: an icon
            view: lw, lph                             // between two pixels picks up a sliver of its neighbour in the atlas
            gap: floor(4 * pu + 0.5)
            for r in lres { LRow(r, pick: launch_pick, del: launch_del) }
        }
        text lmsg { at: floor(lx + lw / 2 + 0.5), floor(lry + 20 * pu + 0.5); anchor: center; align: center; size: 16; color: faint; width: lw - 16 * pu; lines: 2; family: "Space Grotesk"; show: lcount < 1 }

        //  The preview.
        group {
            opacity: lpv
            show: lpv > 0.01
            box { from: lpx, lry; size: lpw, lph; corner: 14 * pu; color: ink; opacity: 5% }
            text lp_kind { at: floor(lpx + 10 * pu + 0.5), floor(lry + 14 * pu + 0.5); anchor: left center; size: 12; weight: 700; width: lpw - 20 * pu; lines: 1; color: mint; family: "Space Grotesk" }
            group {
                show: lp_img_on
                clip inset 0 box { at: lpx + lpw / 2, lry + 28 * pu + (lpw - 20 * pu) / 3; size: lpw - 20 * pu, (lpw - 20 * pu) * 2 / 3; corner: 8 * pu }
                box { from: lpx + 10 * pu, lry + 28 * pu; size: lpw - 20 * pu, (lpw - 20 * pu) * 2 / 3; corner: 8 * pu; color: ink; opacity: 5% }
                image lp_img { at: lpx + 10 * pu, lry + 28 * pu; size: lpw - 20 * pu, (lpw - 20 * pu) * 2 / 3 }
            }
            let lpy = lry + 28 * pu + if(lp_img_on, (lpw - 20 * pu) * 2 / 3 + 8 * pu, 0)
            text lp_title { at: floor(lpx + 10 * pu + 0.5), floor(lpy + 8 * pu + 0.5); anchor: left center; size: 16; weight: 700; width: lpw - 20 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            text lp_path { at: floor(lpx + 10 * pu + 0.5), floor(lpy + 24 * pu + 0.5); anchor: left center; size: 13; width: lpw - 20 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            text lp_body { at: floor(lpx + 10 * pu + 0.5), floor(lpy + 40 * pu + 0.5); anchor: left top; size: 15; width: lpw - 20 * pu; lines: 9; color: ink; family: "Space Grotesk" }
            repeat i in 0..4 {
                let ky = lpy + 44 * pu + i * 16 * pu
                text pick(i, lp_k1, lp_k2, lp_k3, lp_k4) { at: floor(lpx + 10 * pu + 0.5), floor(ky + 0.5); anchor: left center; size: 13.5; width: 50 * pu; lines: 1; color: faint; family: "Space Grotesk" }
                text pick(i, lp_v1, lp_v2, lp_v3, lp_v4) { at: floor(lpx + 60 * pu + 0.5), floor(ky + 0.5); anchor: left center; size: 13.5; width: lpw - 70 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            }
        }
        text "↑↓ move   ·   Enter open   ·   Esc close" { at: floor(lx + 6 * pu + 0.5), floor(lry + (lr * 44 + 4 + 9) * pu + 0.5); anchor: left center; size: 13.5; color: faint; opacity: 70%; family: "Space Grotesk" }
        text lfoot { at: floor(lx + 424 * pu + 0.5), floor(lry + (lr * 44 + 4 + 9) * pu + 0.5); anchor: right center; align: right; size: 13.5; width: 120 * pu; lines: 1; color: faint; opacity: 70%; family: "Space Grotesk" }
    }

    include "pages/settings_panel.plm"
    prop volume_level = 0 ~calm
    follow volume_level = if(audio.muted, 0, audio.volume)
    prop bright_level = 0 ~calm
    follow bright_level = brightness.level
    // ── dismissing the panel ─────────────────────────────────────
    //  Escape closes it. The scene only asks for the keyboard while the panel is
    //  open (see `surface`), so typing goes to your apps the rest of the time.
    on key Down while panel == launch { emit launch_move(1) }
    on key Up while panel == launch { emit launch_move(-1) }
    on key Tab while panel == launch { emit launch_move(1) }
    on key Ctrl+n while panel == launch { emit launch_move(1) }
    on key Ctrl+p while panel == launch { emit launch_move(-1) }
    on key Shift+Delete while panel == launch { emit launch_delsel }
    on submit lq { emit launch_run }
    on key Escape while dd_open { dd_open = false }
    on key Escape while panel != none and not dd_open { panel = none }

    include "pages/osd_drawer.plm"
    //  ── the wallpaper picker ─────────────────────────────────────
    //  The tray hangs under the bar. Which layout fits N hexagons best (the biggest ones that still fit the tray) is worked out here,
    //  from a few column counts around the one that N and the tray's shape suggest.
    let g.n = max(1, wp_picker.count)
    let g.aw = min(screen.width - 168, 2400)              // the room for the hexagons
    let g.ah = vh - 260                        // and the height: the bar above, the foot below, some air
    let g.c0 = floor(g.aw / (1.7321 * sqrt(g.aw * g.ah / (2.6 * g.n))))
    let g.c1 = max(1, min(g.n, g.c0 - 2))
    let g.c2 = max(1, min(g.n, g.c0 - 1))
    let g.c3 = max(1, min(g.n, g.c0))
    let g.c4 = max(1, min(g.n, g.c0 + 1))
    let g.c5 = max(1, min(g.n, g.c0 + 2))
    let g.r1 = min(g.aw / (1.7321 * (g.c1 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c1 - 1) / g.c1) - 1) + 2))
    let g.r2 = min(g.aw / (1.7321 * (g.c2 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c2 - 1) / g.c2) - 1) + 2))
    let g.r3 = min(g.aw / (1.7321 * (g.c3 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c3 - 1) / g.c3) - 1) + 2))
    let g.r4 = min(g.aw / (1.7321 * (g.c4 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c4 - 1) / g.c4) - 1) + 2))
    let g.r5 = min(g.aw / (1.7321 * (g.c5 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c5 - 1) / g.c5) - 1) + 2))
    let g.rb = max(max(max(g.r1, g.r2), max(g.r3, g.r4)), g.r5)
    let g.cols = if(g.r1 == g.rb, g.c1, if(g.r2 == g.rb, g.c2, if(g.r3 == g.rb, g.c3, if(g.r4 == g.rb, g.c4, g.c5))))
    let g.R = min(g.rb, 120)                              // a hexagon's radius, corner to middle
    let g.w = 1.7321 * g.R
    let g.rows = floor((g.n + g.cols - 1) / g.cols)
    let g.gw = (g.cols + 0.5) * g.w
    let g.gh = (g.rows - 1) * 1.5 * g.R + 2 * g.R
    let g.x0 = cx - g.gw / 2
    //  Round the hovered hexagon the others give way: they are pushed outwards (by K, most at about a tile's distance and not at all far
    //  off) and the ring next to it shrinks a little. The hovered one grows on its own spring (`gt`). `sg` is how far this reaches.
    let g.K = 0.55 * clamp(wp_picker_hs, 0, 1.1)
    let g.sg = 1.5 * g.w
    let g.foot = 0.8 * g.R + 64                      // what the foot line takes below the hexagons: the hovered one in the last row swells down over 0.7 of a radius, and the line goes under that
    let g.y0 = yo + (vh - g.gh - g.foot) / 2          // centred on the screen

    group {
        show: wp_picker_show > 0.01
        opacity: wp_picker_show * wp_picker_veil
        //  Behind the tiles, a plain dark sheet over the whole surface (a shape, not a glass body: those were what made the picker slow), so that
        //  nothing of what is under shows through.
        box { at: screen.width / 2, screen.height / 2; size: screen.width, screen.height; color: #05070d; opacity: 88% }
        //  Where the pointer is on the hovered tile, for its tilt: a grid of invisible zones laid over it, 7 across and 8 down, each of which
        //  notes the pointer as it comes in. The tile's shader cannot be told (a group's shader is not given the pointer), and reading `cursor`
        //  instead made pleamar poll the mouse all the time. Declared before the tiles, so a press still goes to the tile under it.
        let tl.w = 1.732 * g.R * 0.93 * (1 + 0.8 * wp_picker_hs)
        let tl.h = 2 * g.R * 0.93 * (1 + 0.8 * wp_picker_hs)
        repeat k in 0..56 {
            zone box wp_tilt.$k { at: wp_picker_lx + (mod(k, 7) - 3) * tl.w / 7, wp_picker_ly + (floor(k / 7) - 3.5) * tl.h / 8; size: tl.w / 7 + 1, tl.h / 8 + 1; active: wp_picker_hot >= 0 and wp_picker_open and wp_picker_leaving == 0 }
            on enter wp_tilt.$k { wp_picker_tx: clamp((pointer.x - wp_picker_lx) / tl.w, -0.6, 0.6); wp_picker_ty: clamp((pointer.y - wp_picker_ly) / tl.h, -0.6, 0.6) }
        }
        repeat i in 0..200 {
            let grow = floor(i / g.cols)
            let bx = g.x0 + g.w * (i - grow * g.cols + 0.5 + 0.5 * mod(grow, 2))
            let by = g.y0 + g.R + grow * 1.5 * g.R
            let hv = wp_picker_z.$i.hover
            let cu = if(wp_picker.$i.cur, 1, 0)
            let ent = clamp(wp_picker_show * 2.4 - i * 0.008, 0, 1)
            let dxh = bx - wp_picker_lx
            let dyh = by - wp_picker_ly
            let xx = length(dxh, dyh) / g.sg
            let ee = exp(-xx * xx)
            let ring = 1 - 0.26 * clamp(wp_picker_hs, 0, 1) * exp(-pow((xx - 1.25) / 0.6, 2))
            let bxl = wp_picker_lx + dxh * (1 + g.K * ee)              // where the others have been pushed to, to make room
            let byl = wp_picker_ly + dyh * (1 + g.K * ee)
            let gi = gt.$i
            let rr = g.R * 0.93 * (0.6 + 0.4 * ent) * ring * (1 + 0.8 * gi)
            group {
                show: i < g.n and i < wp_picker.count and wp_picker_hot != i
                //  The fade goes on each shape, not on the group: a group with an opacity (or a clip) is drawn in a layer of its own, and the renderer gives only
                //  sixty-four of those a frame, so the lower tiles lost their opacity and the hovered one its tilt. The pictures are already cut to the hexagon.
                let to = ent * if(wp_picker.$i.dim, 25%, 1) 
                //  No blurred shadow under the resting tiles: a hundred and forty blur passes a frame were most of what this page cost. The hovered tile has its own.
                // (a plain path, not a `body`: a body is a layer of its own, and its rectangle's edge showed as a faint line across the small tiles)
                path { at: bxl, byl; color: #05070d; opacity: 30% * to; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
                image wp_picker.$i.img { at: floor(bxl - 0.866 * rr * 124 / 120 + 0.5), floor(byl - rr * 143 / 139 + 0.5); size: floor(1.732 * rr * 124 / 120 + 0.5), floor(2 * rr * 143 / 139 + 0.5); opacity: to }
                path { at: bxl, byl; stroke: 2.6 + 1.6 * cu; color: mix(#ffffff, mint, cu); opacity: (55% + 45% * max(hv, cu)) * to; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
            }
            //  The hovered one: the same tile as liquid glass. Its group's shader adds the light (a soft spot under the pointer, and a band
            //  that sweeps across on arrival), and it stands off the grid on a deeper shadow.
            group {
                show: i < g.n and i < wp_picker.count and wp_picker_hot == i
                shader: liquid, clamp(gi, 0, 1), 22, wp_picker_sw, wp_picker_tx, wp_picker_ty, 0, 0, 0
                //  The hovered tile grows to the large hexagon on its own spring (`gi`), which overshoots a little: that is the bounce.
                opacity: 0.75 + 0.25 * clamp(gi * 4, 0, 1)
                //  Room around the hexagon, so the tilt's perspective has somewhere to reach.
                box { at: bxl, byl; size: 2 * rr + 110, 2 * rr + 110; color: #ffffff; opacity: 0.4% }
                body {
                    color: #05070d
                    opacity: 30%
                    rim: 20%
                    shadow: 0, 20, 40, 80%, #000000
                    path { at: bxl, byl; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
                }
                group {
                    clip path { at: bxl, byl; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
                    image wp_picker.$i.img { at: bxl - 0.866 * rr * 124 / 120, byl - rr * 143 / 139; size: 1.732 * rr * 124 / 120, 2 * rr * 143 / 139 }
                }
                path { at: bxl, byl; stroke: 3.4; color: if(cu > 0, mint, #ffffff); opacity: 95%; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
            }
            //  Its zone is the circle inside the hexagon, as big as the hexagon is now.
            zone box wp_picker_z.$i { at: bxl, byl; size: 1.732 * rr, 1.732 * rr; corner: 0.866 * rr; cursor: pointer; active: i < g.n and i < wp_picker.count and wp_picker_show > 0.5 and wp_picker_leaving == 0 }
            on enter wp_picker_z.$i { wp_picker_hot = i; wp_picker_hx = bx; wp_picker_hy = by }
            on away wp_picker_z.$i for 200ms while wp_picker_hot == i { wp_picker_hot = -1 }
            on press wp_picker_z.$i { wp_picker_px = bxl; wp_picker_py = mh - byl; emit wp_picker_pick(i) }
        }

        //  The foot: the name of the one under the pointer, or a line of help; and Random.
        let fy = g.y0 + g.gh + g.foot - 22
        text wp_picker_hero_name { at: floor(cx + 0.5), floor(fy + 0.5); anchor: center; align: center; size: 23; weight: 700; width: 900; lines: 1; color: #ffffff; family: "Space Grotesk"; show: wp_picker_hot >= 0 }
        text "Pick a wallpaper  ·  Esc or a click outside closes" { at: floor(cx + 0.5), floor(fy + 0.5); anchor: center; align: center; size: 18; color: #ffffff; opacity: 55%; family: "Space Grotesk"; show: wp_picker_hot < 0 and wp_picker.count > 0 }
        text wp_picker_status { at: floor(cx + 0.5), floor(yo + vh / 2 + 0.5); anchor: center; align: center; size: 16; weight: 600; width: 600; lines: 1; color: #ffffff; opacity: 70%; family: "Space Grotesk"; show: wp_picker.count < 1 }
    }

    include "pages/overview.plm"

    //  ── the authentication dialog ────────────────────────────────────────────────────────────────────────────────────────────
    //  A card in the bar's glass, in the upper third of the screen, over a dimmed desktop. It is modal: the veil takes every press.
    group {
        show: pk_show > 0.01
        opacity: pk_show
        let pk.cy = yo + vh * 0.34 - 14 * u * (1 - pk_show)
        let pk.x = cx + pk_sk * 14 * u
        let pk.top = pk.cy - 128 * u
        let pk.l = pk.x - 176 * u
        box { at: cx, screen.height / 2; size: screen.width, screen.height; color: #000000; opacity: 34% }
        zone box pk_block { at: cx, screen.height / 2; size: screen.width, screen.height; cursor: pointer }
        body {
            color: tint
            glass: glass_frost
            opacity: glass_op
            lens: glass_bend
            refraction: glass_refr
            dispersion: glass_disp
            rim: 14% * glass_rim
            shadow: 0, 18 * u, 50 * u, 45%, deep
            box { at: pk.x, pk.cy; size: 400 * u, 256 * u; corner: 26 * u }
        }
        zone box pk_card { at: pk.x, pk.cy; size: 400 * u, 256 * u; corner: 26 * u }
        //  A padlock, then the title.
        path { at: pk.l + 12 * u, pk.top + 38 * u; stroke: 1.7 * u; color: mint; move -4 * u, -1 * u; line -4 * u, -5 * u; curve 4 * u, -5 * u via 0, -12 * u; line 4 * u, -1 * u }
        box { at: pk.l + 12 * u, pk.top + 41 * u; size: 15 * u, 11 * u; corner: 3 * u; stroke: 1.7 * u; color: mint }
        text "Authentication required" { at: floor(pk.l + 32 * u + 0.5), floor(pk.top + 38 * u + 0.5); anchor: left center; size: 15 * u; weight: 700; color: ink; family: "Space Grotesk" }
        text pk_message { at: floor(pk.l + 0.5), floor(pk.top + 62 * u + 0.5); anchor: left top; size: 11.5 * u; width: 352 * u; lines: 3; color: ink; opacity: 78%; family: "Space Grotesk" }
        //  Whose password it is.
        ellipse { at: pk.l + 10 * u, pk.top + 132 * u; radius: 9 * u; color: mint; opacity: 24% }
        ellipse { at: pk.l + 10 * u, pk.top + 129 * u; radius: 2.6 * u; color: mint }
        path { at: pk.l + 10 * u, pk.top + 138 * u; stroke: 1.5 * u; color: mint; move -4.5 * u, 0; curve 4.5 * u, 0 via 0, -7 * u }
        text pk_user { at: floor(pk.l + 28 * u + 0.5), floor(pk.top + 132 * u + 0.5); anchor: left center; size: 12 * u; weight: 600; color: ink; family: "Space Grotesk" }
        //  The password field.
        box { at: pk.x, pk.top + 166 * u; size: 352 * u, 38 * u; corner: 13 * u; color: ink; opacity: 8% }
        box { at: pk.x, pk.top + 166 * u; size: 352 * u, 38 * u; corner: 13 * u; stroke: 1.4 * u; color: mint; opacity: 40% + 50% * pk_sk * pk_sk }
        input pk_pw { at: floor(pk.l + 14 * u + 0.5), floor(pk.top + 166 * u - 8 * u + 0.5); width: 324 * u; size: 14 * u; color: ink; family: "Space Grotesk"; placeholder: "Password"; secret: true }
        text pk_error { at: floor(pk.l + 2 * u + 0.5), floor(pk.top + 194 * u + 0.5); anchor: left center; size: 10.5 * u; width: 350 * u; lines: 1; color: mint; family: "Space Grotesk"; show: pk_shake and not pk_busy }
        text "Checking…" { at: floor(pk.l + 2 * u + 0.5), floor(pk.top + 194 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: pk_busy }
        //  Cancel and Authenticate.
        box { at: pk.x - 88 * u, pk.top + 226 * u; size: 172 * u, 32 * u; corner: 14 * u; color: ink; opacity: 8% + 9% * pk_cancel_hit.hover }
        text "Cancel" { at: floor(pk.x - 88 * u + 0.5), floor(pk.top + 226 * u + 0.5); anchor: center; align: center; size: 12 * u; weight: 600; color: ink; family: "Space Grotesk" }
        zone box pk_cancel_hit { at: pk.x - 88 * u, pk.top + 226 * u; size: 174 * u, 34 * u; corner: 15 * u; cursor: pointer }
        on press pk_cancel_hit { pk_open = false }
        box { at: pk.x + 88 * u, pk.top + 226 * u; size: 172 * u, 32 * u; corner: 14 * u; color: mint; opacity: if(pk_busy, 28%, 80% + 20% * pk_ok_hit.hover) }
        text "Authenticate" { at: floor(pk.x + 88 * u + 0.5), floor(pk.top + 226 * u + 0.5); anchor: center; align: center; size: 12 * u; weight: 700; color: onmint; family: "Space Grotesk" }
        zone box pk_ok_hit { at: pk.x + 88 * u, pk.top + 226 * u; size: 174 * u, 34 * u; corner: 15 * u; cursor: pointer; active: not pk_busy }
        on press pk_ok_hit { pk_go = true }
    }

}
