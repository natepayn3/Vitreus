            text "Pastel" { at: floor(spx + 303 * pu + 0.5), floor(sby + 232 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 62 * pu; lines: 1; color: mix(ink, mint, lkc3); family: "Space Grotesk" }
