language 0.1

import "palette.plm"

//  Vitreus: a bar of liquid glass. The glass only blurs what is behind it (the
//  compositor does it; `lens: false`), and the panel is not stuck under the
//  bar: it is the same silhouette, melted, so it hangs from it like a drop.

scene Vitreus {
    surface { size: 900, 800; anchor: top; margin: 0; reserve: 68; screens: all; keyboard: exclusive while panel != none and panel != volume and panel != notif }
    permissions { services: "files", "files.write", "clock", "audio", "audio.*", "window", "media", "media.*", "workspaces", "workspaces.focus", "brightness", "brightness.*", "network", "network.*", "bluetooth", "bluetooth.*", "apps", "tray", "tray.*", "notifications", "notifications.*"
                  run: "git", "pleamar", "cava", "playerctl", "curl", "notify-send", "which", "pgrep", "pkill", "systemctl", "hyprctl", "printenv", "awww", "iris", "cp", "ls", "xdg-user-dir", "magick", "mkdir", "bluetoothctl", "nmcli", "wl-copy", "find", "cliphist", "stat", "file", "vitreus-clipimg", "grep", "pactl", "sed", "setsid" }

    model wifi_nets max 8 { ssid: text; strength: number; secure: bool; known: bool; active: bool }
    model bt_devices max 24 { name: text; address: text; paired: bool; connected: bool; battery: number; busy: number }

    service clock as now { time: text = "--:--"; date: text }
    service audio { volume: number; muted: bool }
    service window as win { title: text; class: text }
    service media { playing: bool; title: text; artist: text; player: text }
    service brightness { present: bool; level: number }
    service network as net { online: bool; wifi: bool; name: text; strength: number; networks: wifi_nets }
    service bluetooth as bt { present: bool; powered: bool }        // the list itself is built by the logic

    text clock12 = "--:--"
    text clock_h = ""              // the bar clock in three parts: the hour (oversized), the minutes (in the accent), am/pm
    text clock_mm = ""
    text bar_ap = ""
    text bar_date = ""              // the short day stacked above the am/pm: MON
    text datelong = ""
    //  The clock card's pieces: the numerals, the am/pm tucked beside them, and the date as weekday | month day.
    text clock_hm = "--:--"
    text clock_ap = ""
    text date_wd = ""
    text date_md = ""
    measure hmw                    // how wide the big numerals are, to tuck the am/pm against them
    measure mdw                    // and the month and day, the date being right-aligned from them
    text arturl = ""               // the cover: a path to an image file, from the logic
    fact art_on = false            // is there one
    image art = from arturl, 200, 200
    event trackchange              // the logic says the song changed
    //  The calendar: 42 days in the grid (six weeks), what the logic says of each, and the
    //  chosen day's reminders. The logic keeps them in `calendar.json` and paints these.
    event cal_pick ->              // a day of the grid, by its place
    event cal_prev ->
    event cal_next ->
    event cal_today ->
    event cal_open ->              // the calendar panel just opened: back to today
    event cal_add ->               // the Add button (Enter in the field does the same)
    event cal_check ->             // a reminder of the chosen day, by its row: done / not done
    event cal_delete ->
    fact cal.sel = 0               // which place of the grid is chosen
    text cal.month = ""
    text cal.sel_title = ""
    text cal.sel_sub = ""
    text cal_new = ""              // what is being typed in the field
    model cal_events max 4 { time: text; title: text; done: bool }
    repeat k in 0..42 {
        fact cal.day.$k = 0
        fact cal.in.$k = false
        fact cal.today.$k = false
        fact cal.n.$k = 0
    }
    repeat w in 1..8 { text cal.wd.$w = "" }
    text outname = ""              // where the sound is going: the default output
    measure outw                   // how wide that name really is
    measure clsw                   // how wide the focused app's name really is
    measure lhw0                   // how wide the launcher's five hints are, to centre each in its cell
    measure lhw1
    measure lhw2
    measure lhw3
    measure lhw4
    measure titw                   // and its window title
    measure chw                    // the bar clock's hour, minutes and am/pm: how wide each really is; the bar's
    measure cmw                    // buttons and the calendar's click area are placed from them
    measure caw
    measure cdw
    //  Which panel hangs from the bar: the clock and calendar (click the clock), or the
    //  controls (click the window title).
    fact panel: none | calendar | controls | player | volume | notif | settings | launch | tray = none
    fact media_on = false          // is there a player at all
    fact bass = 0
    //  The six bars cava reports, 0..1 each, for the equalizer in the media card. Each one
    //  has its own quick spring, so they rise and fall smoothly instead of stepping.
    repeat i in 0..6 {
        fact spec.$i = 0
        prop spec.s.$i = 0 ~quick
        follow spec.s.$i = spec.$i
    }                  // 0..1, from cava: how hard the low end is hitting
    model outlist max 6 { name: text; current: bool }   // every place the sound can go
    //  The mixer under the volume slider (right-click it): one row per app that is playing sound.
    model mixer max 6 { name: text; pct: number; muted: bool; corked: bool; icon: image 27, 27 }
    event mix_set ->                // a row's slider: the row times 4, plus 0..1 along its track (one number)
    event mix_mute ->               // a row's speaker
    //  The running windows (asked of Hyprland by the logic: the window service has no list there) and
    //  the apps that live in the tray, for the panel that hangs from the window title. Icons are named
    //  by the logic, which matches each window's class to an app.
    model tasks max 12 { title: text; ws: text; active: bool; icon: image 30, 30 }
    fact tasks_watch = false       // the panel is open: keep the list fresh
    model trays max 16 { title: text; icon: image 30, 30; pinned: bool; menu: bool }
    model bartrays max 8 { icon: image 36, 36 }          // the tray apps that ride the bar
    //  One entry of a tray app's menu, flattened: an open submenu is followed by its own entries, `depth` deeper.
    model tray_menu max 40 { label: text; enabled: bool; sep: bool; checked: bool; kids: bool; open: bool; depth: number }
    //  The tray menu panel (it hangs from the window title, like the player's) is about one app.
    text tm_title = ""
    text tm_sub = ""
    text tm_iconurl = ""
    image tm_icon = from tm_iconurl, 44, 44
    fact tm_pinned = false
    fact tm_has_menu = false
    fact tm_h = 0                       // how tall the menu's rows are, unscaled
    fact tray_only_pinned = false       // the bar shows only the pinned apps
    fact dm_mode: dmm_player | dmm_tray = dmm_player      // what the window-title panel holds
    event tray_pin ->
    event tray_menu_open ->
    event bar_tray_click ->
    event bar_tray_menu ->
    event tray_menu_pick ->
    event tm_pin ->
    event tm_open ->
    event tm_alt ->
    event tray_mode ->
    //  The two transient panels (volume, and a notification arriving) share one drawer. `osd_kind` is
    //  which one it draws; unlike `panel` it stays put while the drawer closes, so it fades out
    //  showing what it was showing.
    fact osd_kind: vol | note = vol
    text nt_app = ""
    text nt_title = ""
    text nt_body = ""
    measure ntt                    // how tall the notification's title really is once wrapped
    measure ntb                    // and its body
    text nt_iconpath = ""          // the app's icon, or the picture it brought: a name or a path
    image nt_img = from nt_iconpath, 44, 44
    fact nt_icon_on = false
    fact nt_body_on = false
    fact nt_urgent = false
    model nt_acts max 3 { label: text }
    event ntnew                    // a notification just arrived: ripple the tile
    event nt_close ->              // its cross, or a press on the plate
    event nt_act ->                // one of its buttons, by position
    //  Settings: a panel of pages, the wallpaper picker first. The logic lists the folder and keeps one
    //  page of twelve thumbnails at a time (the folder can hold hundreds of full-size images).
    model wps max 12 { thumb: image 260, 146 }
    fact wp_sel = -1                // which thumbnail of this page is the wallpaper in use, or -1
    text wp_curpath = ""            // the wallpaper in use: a path
    image wp_cur = from wp_curpath, 320, 180
    text wp_name = ""
    text wp_dirtext = ""
    text wp_pager = ""
    event wp_pick ->                // a thumbnail, by position on the page
    event wp_prev ->
    event wp_next ->
    event wp_random ->
    //  The colour filter (twelve swatches; the lit one is `wp_filter`, -1 for none) and the slideshow.
    fact wp_filter = -1
    //  The glass of the bar and every drawer: how much of the glass effect it has (tint, edge light, and the blur
    //  the compositor puts behind it), and how opaque it is. Set from the Glass page of the settings.
    fact glass_frost = 1
    fact glass_op = 1
    text glass_frost_text = "100%"
    text glass_op_text = "100%"
    event glass_frost_set ->        // the Glass slider: 0..1 along its track
    event glass_op_set ->           // the Opacity slider: 0..1 along its track
    event hy_layout_set ->
    event hy_gaps_set ->
    event hy_sens_set ->
    event hy_follow_set ->
    event hy_toggle ->
    event hy_refresh ->
    //  The launcher (SUPER + Space): what is typed, the results, and which one is chosen.
    event launch_toggle ->          // from a key bind (hypr_vitreus.lua)
    event launch_open ->
    event launch_move ->            // -1 up, +1 down
    event launch_pick ->            // a row, by place
    event launch_scroll ->          // the wheel over the rows: notches, positive is down
    event launch_run ->             // Enter
    event launch_hint ->            // a hint under the field: type its first character
    text lq = ""                    // the search field
    text lmode = "Apps"             // which kind of search the text asks for
    text lmsg = ""                  // what to say when there is no row: "No results", "Searching…"
    text lfoot = ""                 // "3 / 20"
    fact lcount = 0
    fact lp_on = false               // this kind of search has a preview beside its rows
    prop lpv = 0 ~calm               // 0..1: how far the preview is in
    follow lpv = if(lp_on, 1, 0)
    text lp_kind = ""                // FILE, IMAGE, TEXT, WALLPAPER
    text lp_title = ""
    text lp_path = ""
    text lp_body = ""                // the text of a text entry
    text lp_k1 = ""
    text lp_v1 = ""
    text lp_k2 = ""
    text lp_v2 = ""
    text lp_k3 = ""
    text lp_v3 = ""
    text lp_k4 = ""
    text lp_v4 = ""
    text lp_imgpath = ""             // a small copy of the picture, at a fixed path with a version on the end
    fact lp_img_on = false
    image lp_img = from lp_imgpath, 480, 320
    model lres max 6 { title: text; sub: text; desc: text; hasdesc: bool; glyph: text; sel: bool; hasicon: bool; icon: image 35, 35 }
    event settings_toggle ->        // from a key bind (hypr_vitreus.lua): open or close Settings
    event glass_reset ->
    //  The pages of the settings panel, and how far the second is in (for the sidebar's highlight and the
    //  panel's height, which follows the page).
    fact set_page: pg_wall | pg_glass | pg_disp | pg_bar | pg_hypr | pg_about = pg_wall
    //  The Bar page: which monitors the bar is on (see the Bar section of vitreus.luau). `bar_scr` is -1 for all
    //  of them, or which monitor tile is chosen.
    fact bar_scr = -1
    repeat i in 0..4 {
        fact bar_m.$i.on = false
        text bar_m.$i.name = ""
        text bar_m.$i.sub = ""
    }
    text bar_msg = ""
    event bar_pick_scr ->
    //  The bar's layout (Settings > Bar): each piece's place in the row, 0 leftmost, and whether it is shown. The
    //  title is the stretch: what comes before it hugs the left, what comes after it the right.
    fact bo.ws = 0
    fact bo.title = 1
    fact bo.media = 2
    fact bo.tray = 3
    fact bo.set = 4
    fact bo.sr = 5
    fact bo.ctl = 6
    fact bo.clock = 7
    fact bv.ws = true
    fact bv.title = true
    fact bv.media = true
    fact bv.sr = true
    fact bv.ctl = true
    fact bv.clock = true
    fact bv.tray = true
    //  The layout editor on the Bar page: a chip per piece (0 workspaces, 1 title, 2 player, 3 settings, 4 search,
    //  5 controls, 6 clock, 7 tray), where the logic puts it (`bc.$i`, top-left and width, in the editor's unscaled units:
    //  the bar row starts at y 4, the hidden tray at 56), and the one being dragged, which follows the pointer.
    repeat i in 0..8 {
        fact bc.$i.x = 0
        fact bc.$i.y = 4
        fact bc.$i.w = 34
    }
    fact bdrag = -1                 // the chip being dragged, -1 none
    fact bdx = 0                    // the pointer, in the editor's units
    fact bdy = 0
    fact bgx = 0                    // where in the chip it was taken
    fact bgy = 0
    fact bdrop_tray = false         // the dragged chip would go to the hidden tray
    fact btray_n = 0                // how many pieces are hidden
    event bar_lay_grab ->
    event bar_lay_drag ->
    event bar_lay_drop ->
    event bar_lay_reset ->
    //  The Display page: what the logic reads from Hyprland and the draft the page edits (see the Display
    //  section of vitreus.luau). `disp_boxes` is the canvas, one box per monitor, in canvas units.
    //  The canvas's boxes, the refresh-rate chips, the monitor pills and the profile rows are numbered slots.
    repeat i in 0..4 {
        fact disp_b.$i.on = false
        fact disp_b.$i.x = 0
        fact disp_b.$i.y = 0
        fact disp_b.$i.w = 0
        fact disp_b.$i.h = 0
        fact disp_b.$i.sel = false
        fact disp_b.$i.dirty = false
        text disp_b.$i.name = ""
        text disp_b.$i.mode = ""
        fact disp_pill.$i.on = false
        text disp_pill.$i.text = ""
        fact disp_p.$i.on = false
        fact disp_p.$i.active = false
        text disp_p.$i.name = ""
        text disp_p.$i.sub = ""
    }
    repeat i in 0..6 {
        fact disp_hz.$i.on = false
        fact disp_hz.$i.lit = false
        text disp_hz.$i.text = ""
    }
    text disp_res_text = ""
    measure disp_rw                 // how wide the resolution's text is: the dropdown is as wide as that needs
    fact disp_res_open = false      // the resolution dropdown is open
    fact disp_scroll_to = 0         // where the Display page is scrolled to (unscaled units, from the top)
    fact disp_res_chars = 10        // how many characters the longest resolution in the list has
    fact disp_res_count = 0         // how many resolutions it lists
    fact disp_pcount = 0            // how many saved profiles there are (the card is as tall as they need)
    repeat i in 0..14 {
        fact disp_r.$i.on = false
        fact disp_r.$i.lit = false
        text disp_r.$i.text = ""
    }
    fact disp_count = 0
    fact disp_sel = 0               // which monitor the inspector is about
    fact disp_dirty = false         // the draft is not what the screens are
    fact disp_scale = 0             // which of the seven scale choices is the draft's
    fact disp_rot = 0               // 0..3, or -1 for a flipped one
    fact disp_sdrb = 1
    fact disp_sdrs = 1
    fact disp_auto = true           // reapply a saved profile when its set of displays is connected
    fact disp_trial = 0             // seconds left of a change on trial; 0 for none
    fact disp_grab_i = 0
    fact disp_px = 0
    fact disp_py = 0
    text disp_title = ""
    text disp_desc = ""
    text disp_cur = ""
    text disp_topo = ""
    text disp_msg = ""
    text disp_trial_text = ""
    text disp_sdrb_text = "1"
    text disp_sdrs_text = "1"
    text disp_profile_name = ""
    event disp_pick_mon ->
    event disp_pick_res ->
    event disp_pick_hz ->
    event disp_pick_scale ->
    event disp_pick_rot ->
    event disp_sdrb_set ->
    event disp_sdrs_set ->
    event disp_apply ->
    event disp_keep ->
    event disp_revert ->
    event disp_reset ->
    event disp_refresh ->
    event disp_grab ->
    event disp_drag ->
    event disp_drop ->
    event disp_arrange ->
    event disp_swap ->
    event disp_profile_save ->
    event disp_profile_apply ->
    event disp_profile_delete ->
    event disp_auto_toggle ->
    text wp_count = ""              // 57 wallpapers, or 12 of 57 with a colour picked
    event wp_filter_set ->          // a swatch, by position
    fact wp_show = false            // the slideshow is on
    text wp_show_sub = ""           // Next change in 4:31
    text wp_mins_text = ""          // 5 min
    event wp_show_toggle ->
    event wp_mins_step ->           // the stepper: -1 or 1 along a short list of intervals
    //  Weather, for the calendar panel: what it is now, and the week ahead. The logic fetches it (Open-Meteo)
    //  and gives each day a `kind`: 0 clear, 1 partly cloudy, 2 cloud, 3 fog, 4 rain, 5 snow, 6 storm.
    fact wx_ok = false
    fact wx_kind = 2
    text wx_temp = ""
    text wx_desc = ""
    model wx_days max 7 { label: text; kind: number; hi: text; lo: text; today: bool }
    event task_focus ->            // a window's row, by position: give it the keyboard
    event task_close ->            // its close button, or a middle click
    event tray_click ->            // a tray app's row
    fact dd_open = false           // the output dropdown
    fact vm_open = false           // the per-app mixer under the volume slider
    event pick_out ->              // a row of it, by position
    event mute ->                  // the speaker icon
    event setvol ->                // the volume slider: 0..1
    event mcmd ->                  // 0 previous · 1 play/pause · 2 next
    event setbright ->             // the brightness slider: 0..1
    event togglewifi ->            // the wifi row: flips the radio
    event togglebt ->              // the bluetooth row: flips the radio
    fact bt_connected = false      // a device is paired and connected
    text bt_name = ""              // its name, from the logic
    fact bright_avail = true       // brightnessctl is installed: the slider can actually be dragged
    //  Tapping the rest of a tile (not its toggle) grows it into its own window.
    //  `showing_sub` only follows `panel_sub` on the way in - see its rule below -
    //  so the window it drew stays up, fading out, while it closes.
    fact panel_sub: none | netview | btview | notifview | cafview = none
    fact showing_sub: none | netview | btview | notifview | cafview = none
    //  Which row is open, in each list - its password field or its
    //  Connect/Disconnect/Forget, right underneath it. -1 is none.
    fact on_wifi = false            // the connection in use is Wi-Fi (not wired): the logic reads network.kind
    fact wifi_open_row = -1
    fact bt_open_row = -1
    event wifi_pick ->              // a network row's own button: connect, or leave it
    event wifi_forget ->            // a network row's Forget
    event wifi_scan ->              // the rescan button
    fact wifi_scanning = false      // a scan is running: the logic holds it up for a few seconds
    fact bt_scanning = false
    fact bt_working = false         // a device is being connected or disconnected (its row pulses)
    text wifi_pw = ""               // the password field open under a row
    event wifi_join_go ->           // its Join button, or Enter in the field
    event bt_pick ->                // a device row's own button: connect, or leave it
    event bt_forget ->              // a device row's Forget
    event bt_scan ->                // the rescan button
    //  Do Not Disturb is a preference the logic keeps in `dnd.json`; Caffeine is whether hypridle
    //  has been stopped, which the logic asks the system rather than remembering.
    fact dnd_on = false
    fact caf_on = false
    fact caf_avail = true          // hypridle is installed: there is something to hold off
    event togglednd ->
    //  The notifications module: Do Not Disturb with a timer, and the history of what came in.
    model nt_hist max 30 { title: text; sub: text; when: text }
    text nt_tile_sub = ""          // the tile's second line: Silenced · 23:41, 12 in history, All clear
    text dnd_left = ""             // the window's DND row: 23:41 left, On until turned off, Off
    fact dnd_len = 0               // minutes of the timer that is running (which chip is lit), 0 for none
    event dnd_for ->               // a timer chip: minutes
    event nt_clear ->              // the Clear button
    event nt_hist_del ->           // a history row's cross, by position
    fact caf_len = 0               // minutes of the Caffeine timer that is running (which chip is lit), 0 for none
    text caf_left = ""             // the Caffeine window's row: 23:41 left, On until turned off, Off
    text caf_tile_sub = ""         // the tile's second line while a timer runs: Awake · 23:41
    event togglecaf ->
    event caf_for ->               // a timer chip: minutes, or 0 for until it is turned off
    fact ws.active = 1
    repeat i in 1..6 { fact ws.$i.busy = false }
    event go ->

    //  The colours live in palette.plm (ink, faint, mint, tint…); only the veil is the scene's.
    let veil  = 8%

    shader wave = file "wave.wgsl"
    spring drip = 170, 18         // underdamped: it overshoots and settles back, like a real drop landing
    spring pop  = 300, 12         // snappier and much less damped: a toggle knob popping past where it lands

    prop drop  = 0 ~drip          // the panel, 0 to 1: it hangs from the bar and falls
    //  The settle: the panel hangs a few px lower when it lands and eases back. Critically damped, so it is one slow hump and never a bounce.
    spring hang = 260, 32
    prop sag   = 0 ~hang
    //  The water's own spring, from Marea: a quarter of a second of period and two bounces you can see. A drawer
    //  that lands shakes on it for a moment, as a drop does when it comes to rest.
    spring splash = 420, 13
    prop wobble = 0 ~splash
    //  Where the ripple that crosses the bar is born: 0 at the player controls (the music), 1 in the middle
    //  (a drawer that has just closed, the surface closing over it).
    prop ring_mid = 0 ~30ms
    prop hot   = 0 ~quick         // the bar, when the pointer is on it
    prop f1    = 0 ~200ms        // what is inside, arriving one after another
    prop f2    = 0 ~380ms
    prop f3    = 0 ~520ms
    prop f4    = 0 ~380ms          // the calendar's second stage
    prop f5    = 0 ~620ms          // the controls drawer, third in: brightness
    prop f6    = 0 ~700ms          // fourth: wifi
    prop f7    = 0 ~780ms          // fifth: bluetooth
    prop wifi_on = 0 ~pop         // the wifi toggle pill, popping past where it lands
    prop wifi_extra = 0 ~calm     // 0..1: whether a Wi-Fi row is open
    prop wifi_sel = 0 ~calm       // which row, as a position: slides from one row to the next
    prop bt_extra = 0 ~calm       // 0..1: whether a Bluetooth row is open
    prop bt_sel  = 0 ~calm        // which row, as a position: slides from one row to the next
    prop bt_on   = 0 ~pop         // the bluetooth toggle pill, popping past where it lands
    prop media_open = 0 ~drip      // the media plate: a sliver with nothing playing, a full card with something to show
    //  Each panel has its own amount, 0 shut .. 1 open. Each one is a drawer that comes out of the
    //  bar and melts into it; the calendar is as wide as the bar, the others are narrower.
    prop dc    = 0 ~drip
    prop dk    = 0 ~drip
    prop dm    = 0 ~drip          // the player's panel, hanging from the window title
    prop do    = 0 ~drip          // the volume / notification drawer
    prop ds    = 0 ~drip          // the settings panel
    prop fs    = 0 ~300ms         // what is in it, fading in
    prop dl    = 0 ~drip          // the launcher
    prop fl    = 0 ~300ms         // what is in it, fading in
    prop lr    = 1 ~calm          // how many rows it has room for
    prop fo    = 0 ~300ms         // what is in it, fading in
    prop okv   = 0 ~calm          // 1 while it is the volume that is drawn
    prop okn   = 0 ~calm          // 1 while it is a notification
    prop osd_h = 64 ~calm         // the height of its plate: a notification is taller with text and buttons
    prop nt_ring = 1 ~900ms       // a ripple off the notification's tile: 0 born, 1 gone
    prop expand = 0 ~drip          // a tile growing into its own window, 0 tile .. 1 full window
    //  The music: fast, and a little loose, so the bar bounces on the beat.
    spring beat = 480, 15
    prop pulse = 0 ~beat
    prop ring  = 1 ~900ms          // a ripple crossing the bar: 0 born, 1 gone
    prop dd    = 0 ~calm           // the output dropdown, 0 shut .. 1 open
    prop vm    = 0 ~calm           // the per-app mixer, 0 shut .. 1 open
    prop mvis  = 0 ~calm           // 1 while there is an app playing sound (or the mixer is open): the dots show
    prop swap  = 1 ~700ms          // the cover popping in on a new song: 0 just changed, 1 settled
    prop playf = 0 ~calm           // 1 while playing: the cover is full and colourful
    prop mshow = 0 ~calm          // the bar's player controls: there while a player exists, paused or not

    follow drop = if(panel != none, 1, 0)
    follow hot  = if(panel != none, 1, 0)
    follow dc   = if(panel == calendar, 1, 0)
    follow dk   = if(panel == controls, 1, 0)
    follow dm   = if(panel == player or panel == tray, 1, 0)
    follow do   = if(panel == volume or panel == notif, 1, 0)
    follow ds   = if(panel == settings, 1, 0)
    follow dl   = if(panel == launch, 1, 0)
    follow lr   = max(1, lcount, if(lp_on, 6, 1))
    follow okv  = if(osd_kind == vol, 1, 0)
    follow okn  = if(osd_kind == note, 1, 0)
    on ntnew {
        nt_ring: 0 ~16ms
        nt_ring: 1 ~800ms after 30ms
    }
    follow expand = if(panel_sub != none, 1, 0)
    //  Which window to actually draw. It jumps to match `panel_sub` the moment
    //  that becomes something - opening one, or switching straight to the other
    //  - but not back to `none`: closing is `expand` fading the same window out,
    //  so it has to stay named while that happens.
    on change panel_sub while panel_sub != none { showing_sub = panel_sub }
    on change panel_sub { wifi_open_row = -1; bt_open_row = -1 }
    //  Each workspace's indicator has its own amount of «active», 0..1, and morphs by it: the one that
    //  becomes active widens and turns mint in place while the one that stops shrinks back. Nothing
    //  travels. The speed is one with no overshoot: a morph, not a bounce.
    prop ws.act.1 = 0 ~260ms
    prop ws.act.2 = 0 ~260ms
    prop ws.act.3 = 0 ~260ms
    prop ws.act.4 = 0 ~260ms
    prop ws.act.5 = 0 ~260ms
    follow ws.act.1 = if(ws.active == 1, 1, 0)
    follow ws.act.2 = if(ws.active == 2, 1, 0)
    follow ws.act.3 = if(ws.active == 3, 1, 0)
    follow ws.act.4 = if(ws.active == 4, 1, 0)
    follow ws.act.5 = if(ws.active == 5, 1, 0)
    //  Where the active one is, as a number that moves smoothly between slots while two are morphing
    //  (the amounts of the two add up to 1, so this is their weighted middle).
    let pill = ws.act.1 * 1 + ws.act.2 * 2 + ws.act.3 * 3 + ws.act.4 * 4 + ws.act.5 * 5
    //  Occupied but not active: the dot stretches up into a capsule.
    repeat i in 1..6 { prop ws.tall.$i = 0 ~lively }
    repeat i in 1..6 { follow ws.tall.$i = if(ws.$i.busy, 1, 0) }

    on change drop > 0.97 while drop > 0.97 { impulse sag 220; impulse wobble -260 }
    //  A drawer that has gone back into the bar: the surface closes over it, and a ripple runs out from the
    //  middle of the bar (the same wave the music makes, from another place).
    on change drop < 0.08 while drop < 0.08 and panel == none {
        impulse wobble 90
        ring_mid: 1 ~0ms
        ring: 0 ~16ms
        ring: 1 ~900ms after 30ms
    }
    //  What is inside a panel arrives after the drawer has come down, not with it (it was showing while the
    //  drawer was still a sliver under the bar, over the bar's lower half), and leaves at once when the panel
    //  closes, so nothing is left hanging over the bar as it shuts. Each keeps its own spring, so the
    //  controls' plates still arrive one after another.
    on change panel while panel == calendar   { f1: 1 after 220ms; f4: 1 after 300ms }
    on change panel while panel != calendar   { f1: 0 ~80ms; f4: 0 ~80ms }
    on change panel while panel == controls   { f2: 1 after 200ms; f5: 1 after 200ms; f6: 1 after 200ms; f7: 1 after 200ms }
    on change panel while panel != controls   { f2: 0 ~80ms; f5: 0 ~80ms; f6: 0 ~80ms; f7: 0 ~80ms }
    on change panel while panel == player     { dm_mode = dmm_player }
    on change panel while panel == tray       { dm_mode = dmm_tray }
    on change panel while panel == player or panel == tray { f3: 1 after 200ms }
    on change panel while panel != player and panel != tray { f3: 0 ~80ms }
    on change panel while panel == settings   { fs: 1 after 220ms }
    on change panel while panel == launch     { fl: 1 after 200ms; focus lq; emit launch_open }
    on change panel while panel != launch     { fl: 0 ~80ms }
    on change panel while panel != settings   { fs: 0 ~80ms }
    on change panel while panel == volume or panel == notif { fo: 1 after 140ms }
    on change panel while panel != volume and panel != notif { fo: 0 ~80ms }
    follow wifi_on = if(net.wifi, 1, 0)
    follow wifi_extra = if(wifi_open_row >= 0, 1, 0)
    on change wifi_open_row while wifi_open_row >= 0 and wifi_extra < 0.05 { wifi_sel: wifi_open_row ~0ms }
    on change wifi_open_row while wifi_open_row >= 0 and wifi_extra >= 0.05 { wifi_sel: wifi_open_row }
    follow bt_extra = if(bt_open_row >= 0, 1, 0)
    on change bt_open_row while bt_open_row >= 0 and bt_extra < 0.05 { bt_sel: bt_open_row ~0ms }
    on change bt_open_row while bt_open_row >= 0 and bt_extra >= 0.05 { bt_sel: bt_open_row }
    follow bt_on   = if(bt.powered, 1, 0)
    prop dnd_pill = 0 ~pop
    prop caf_pill = 0 ~pop
    prop wp_show_pill = 0 ~pop
    prop set_pg = 0 ~calm
    prop set_pgd = 0 ~calm
    prop set_pgh = 0 ~calm
    prop set_pga = 0 ~calm
    prop set_pgb = 0 ~calm
    prop bs.ws = 1 ~calm              // each piece of the bar, 1 shown .. 0 hidden: its room and its opacity
    prop bs.title = 1 ~calm
    prop bs.media = 1 ~calm
    prop bs.sr = 1 ~calm
    prop bs.ctl = 1 ~calm
    prop bs.clock = 1 ~calm
    prop bs.tray = 1 ~calm
    //  The scene's own `time`. If a scene only names `time`, pleamar makes one that never stops, and a scene with a
    //  clock that never stops never rests: it paints every frame for as long as it lives. This one turns only while
    //  something on screen is using it (the scan rings, the pulse of a device being connected, the volume drawer's
    //  face and ripple, the caffeine steam, the urgent dot, the "More" cue), and the scene sleeps the rest of the time.
    prop time = 0
    prop trn = 0 ~calm                // how many tray icons the bar holds, smoothly: the bar widens with it
    prop disp_auto_pill = 0 ~pop
    prop disp_dd = 0 ~calm            // the resolution dropdown, 0 shut .. 1 open
    prop disp_scroll = 0 ~quick       // the page's scroll, following disp_scroll_to
    prop disp_pn_s = 0 ~calm          // the profiles card's rows, smoothed: it grows and shrinks with them
    prop dnd_wobble = 0 ~pop       // the bell, swung when DND flips
    follow dnd_pill = if(dnd_on, 1, 0)
    follow caf_pill = if(caf_on, 1, 0)
    follow wp_show_pill = if(wp_show, 1, 0)
    follow set_pg = if(set_page == pg_glass, 1, 0)
    follow set_pgd = if(set_page == pg_disp, 1, 0)
    follow set_pgh = if(set_page == pg_hypr, 1, 0)
    follow set_pgb = if(set_page == pg_bar, 1, 0)
    follow set_pga = if(set_page == pg_about, 1, 0)
    follow bs.ws = if(bv.ws, 1, 0)
    follow bs.title = if(bv.title, 1, 0)
    follow bs.media = if(bv.media, 1, 0)
    follow bs.sr = if(bv.sr, 1, 0)
    follow bs.ctl = if(bv.ctl, 1, 0)
    follow bs.clock = if(bv.clock, 1, 0)
    follow bs.tray = if(bv.tray, 1, 0)
    follow trn = bartrays.count
    repeat i in 0..8 {
        prop bcx.$i = 0 ~quick
        prop bcy.$i = 4 ~quick
        prop bcw.$i = 34 ~quick
        follow bcx.$i = bc.$i.x
        follow bcy.$i = bc.$i.y
        follow bcw.$i = bc.$i.w
    }
    //  Settings > Hyprland: what Hyprland has now (see the logic), and the toggles' knobs.
    fact hy_layout = 3
    fact hy_gaps = 5
    fact hy_sens = 0
    fact hy_follow = 1
    fact hy_resize = false
    fact hy_tear = false
    fact hy_anim = true
    fact hy_nat = false
    //  The About page (Settings > System): what this shell is built from, and how to update it.
    text about_commit = "…"
    text about_date = ""
    text about_sub = ""
    text about_pl = ""
    text about_msg = ""
    fact about_behind = -1              // commits waiting upstream; -1 not known yet
    fact about_busy = false
    event about_check ->
    event about_update ->
    event about_restart ->
    text hy_gaps_text = "5 px"
    text hy_sens_text = "0.00"
    prop hy_k0 = 0 ~quick
    prop hy_k1 = 0 ~quick
    prop hy_k2 = 1 ~quick
    prop hy_k3 = 0 ~quick
    follow hy_k0 = if(hy_resize, 1, 0)
    follow hy_k1 = if(hy_tear, 1, 0)
    follow hy_k2 = if(hy_anim, 1, 0)
    follow hy_k3 = if(hy_nat, 1, 0)
    follow disp_auto_pill = if(disp_auto, 1, 0)
    follow disp_dd = if(disp_res_open, 1, 0)
    follow disp_scroll = disp_scroll_to
    follow disp_pn_s = disp_pcount
    on change dnd_on {
        dnd_wobble: -1 ~30ms
        dnd_wobble: 0 ~400ms after 60ms
    }
    follow mshow = if(media_on, 1, 0)
    follow media_open = if(media_on, 1, 0)
    follow playf = if(media.playing, 1, 0)
    on trackchange {
        swap: 0 ~16ms
        swap: 1 ~700ms after 30ms
    }
    follow dd = if(dd_open and panel == controls, 1, 0)
    follow vm = if(vm_open and panel == controls, 1, 0)
    follow mvis = if(mixer.count > 0 or vm_open, 1, 0)
    on launch_toggle { panel = if(panel == launch, none, launch) }
    on settings_toggle { panel = if(panel == settings, none, settings) }
    on change panel { dd_open = false; vm_open = false; panel_sub = none; disp_res_open = false; disp_scroll_to = 0 }
    on change set_page { disp_res_open = false; disp_scroll_to = 0; emit hy_refresh }
    on change panel { tasks_watch = panel == player }
    on pick_out { dd_open = false }
    follow pulse = bass
    //  Every time the bass hits hard, a wave is born at the player controls (the
    //  bar's shader reads `ring` as how far it has travelled). It
    //  has to fall back below the threshold before the next one can be born.
    on change bass > 0.6 while bass > 0.6 {
        ring_mid: 0 ~0ms
        ring: 0 ~16ms
        ring: 1 ~1100ms after 30ms
    }

    //  One number scales the whole shell. The exclusive zone (`reserve` above) is
    //  the bar and a little air: 8 + bar.h + 6.
    let u = 1.35                    // (the icon models are declared at their size times this: 20 → 27, 22 → 30, 26 → 35)
    //  One reminder of the chosen day: a circle to tick it off, its time, its words, a cross.
    component CalRow(e: record, tick: event, gone: event) {
        //  30 px tall at least, and as tall as its title needs: a reminder wraps onto more lines rather
        //  than being cut short with an ellipsis. Whole pixels (a row at 22 units, x 1.35, sits on a
        //  fraction of a pixel, and text drawn between pixels comes out soft), and the text and the
        //  ring are put on whole pixels too. The ring, time and cross stay level with the first line.
        size: 154 * u, max(30, floor(14 + wrap.height + 0.5))
        let rowh = max(30, floor(14 + wrap.height + 0.5))
        zone box touch { from: 0, 0; size: 154 * u, rowh; corner: 8 * u }
        box { from: 0, 0; size: 154 * u, rowh; corner: 8 * u; color: ink; opacity: 6% + 7% * touch.hover }
        ellipse { at: 15, 15; radius: 5.5 * u; stroke: 1.3 * u; color: mint; opacity: if(e.done, 0, 85%) }
        ellipse { at: 15, 15; radius: 5.5 * u; color: mint; opacity: if(e.done, 100%, 0) }
        path { at: 15, 15; stroke: 1.4 * u; color: onmint; opacity: if(e.done, 100%, 0); move -2.5 * u, 0; line -0.5 * u, 2.2 * u; line 3 * u, -2.4 * u }
        text e.time { at: floor(22 * u + 0.5), 15; anchor: left center; size: 10 * u; weight: 600; width: 34 * u; lines: 1; color: mint; opacity: if(e.done, 40%, 100%); family: "Space Grotesk" }
        column wrap {
            at: floor(56 * u + 0.5), 7
            text e.title { size: 11.5 * u; width: 74 * u; lines: 5; color: ink; opacity: if(e.done, 40%, 100%); family: "Space Grotesk" }
        }
        line { from: 137 * u, 15 - 3 * u; to: 143 * u, 15 + 3 * u; width: 1.4 * u; color: ink; opacity: 22% + 60% * touch.hover }
        line { from: 143 * u, 15 - 3 * u; to: 137 * u, 15 + 3 * u; width: 1.4 * u; color: ink; opacity: 22% + 60% * touch.hover }
        zone box check_z { at: 15, 15; size: 22 * u, 30; corner: 11 * u; cursor: pointer }
        zone box gone_z { at: 140 * u, 15; size: 20 * u, 30; corner: 10 * u; cursor: pointer }
        on press check_z { emit tick(e.index) }
        on press gone_z { emit gone(e.index) }
    }

    //  One row of the output dropdown: a dot if it is the current one, its name.
    component OutRow(f: record, pick: event) {
        size: 276 * u, floor(28 * u + 0.5)
        zone box touch { from: 0, 0; size: 276 * u, 28 * u; corner: 10 * u; cursor: pointer; active: dd > 0.05 }
        box { from: 0, 0; size: 276 * u, 28 * u; corner: 10 * u; color: ink
              opacity: if(f.current, 12%, 0%) + 9% * touch.hover }
        ellipse { at: 14 * u, 14 * u; radius: 3 * u; color: mint; opacity: if(f.current, 100%, 0%) }
        text f.name { at: floor(28 * u + 0.5), floor(14 * u + 0.5); anchor: left center; size: 13.5 * u; width: 236 * u; lines: 1
                      color: ink; family: "Space Grotesk" }
        on press touch { emit pick(f.index) }
    }

    //  One row of the Wi-Fi window: a dot if it's the one in use, its name, and
    //  what tapping it means right now. A secured network no password is known
    //  for yet opens the join field instead of trying to connect outright.
    //  Tapping a row never acts by itself - it only opens what's underneath it,
    //  right there: a password field for a secured network not seen before, or
    //  Connect/Disconnect and Forget for anything else. `wifi_open_row` is the
    //  one index that's open at a time, so opening another closes the last one.
    component WifiRow(n: record, pick: event, forget: event, joingo: event) {
        //  Grows on a spring like the Bluetooth rows: wifi_sel slides between rows, wifi_extra is how open.
        size: 276 * u, floor((30 + 44 * wifi_extra * clamp(1 - abs(n.index - wifi_sel), 0, 1)) * u + 0.5)
        let isopen = wifi_open_row == n.index
        let open_t = wifi_extra * clamp(1 - abs(n.index - wifi_sel), 0, 1)
        //  One card: the network line on top, and what opens is the same plate carrying on below it.
        box { from: 0, 0; size: 276 * u, (30 + 44 * open_t) * u; corner: 10 * u; color: ink; opacity: if(n.active, 12%, 0%) + 5% * open_t + 9% * touch.hover }
        zone box touch { from: 0, 0; size: 276 * u, 30 * u; corner: 10 * u; cursor: pointer }
        ellipse { at: 14 * u, 15 * u; radius: 3 * u; color: mint; opacity: if(n.active, 100%, 0%) }
        text n.ssid { at: floor(28 * u + 0.5), floor(15 * u + 0.5); anchor: left center; size: 12.5 * u; width: 150 * u; lines: 1; color: ink; family: "Space Grotesk" }
        text "Connected" { at: floor(262 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: mint; family: "Space Grotesk"; show: n.active }
        text "Saved" { at: floor(262 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: faint; family: "Space Grotesk"; show: n.known and not n.active }
        text "Secured" { at: floor(262 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: faint; family: "Space Grotesk"; show: n.secure and not n.known and not n.active }
        text "Open" { at: floor(262 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: faint; family: "Space Grotesk"; show: not n.secure and not n.known and not n.active }
        on press touch { wifi_open_row = if(isopen, -1, n.index) }

        group {
            show: open_t > 0.01
            opacity: clamp(open_t, 0, 1)
            move: 0, (clamp(open_t, 0, 1) - 1) * 8 * u
            box { at: 138 * u, 30 * u; size: 240 * u, 1 * u; color: ink; opacity: 10% }
            //  A secured network never seen before: the password, right here.
            group {
                show: n.secure and not n.known and not n.active
                box { at: 106 * u, 52 * u; size: 184 * u, 26 * u; corner: 8 * u; color: ink; opacity: 8% }
                input wifi_pw { at: floor(24 * u + 0.5), floor(52 * u - 6.3 * u + 0.5); width: 164 * u; size: 11.5 * u; color: ink; family: "Space Grotesk"; secret: true; placeholder: "Password" }
                box { at: 234 * u, 52 * u; size: 56 * u, 26 * u; corner: 8 * u; color: mint; opacity: 85% + 15% * joinbtn.hover }
                text "Join" { at: floor(234 * u + 0.5), floor(52 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: onmint; family: "Space Grotesk" }
                zone box joinbtn { at: 234 * u, 52 * u; size: 56 * u, 26 * u; corner: 8 * u; cursor: pointer }
                on press joinbtn { emit joingo(n.index) }
            }
            //  Open, and never joined: nothing to type, just a way in.
            group {
                show: not n.secure and not n.known and not n.active
                box { at: 138 * u, 52 * u; size: 248 * u, 26 * u; corner: 8 * u; color: mint; opacity: 85% + 15% * connbtn.hover }
                text "Connect" { at: floor(138 * u + 0.5), floor(52 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: onmint; family: "Space Grotesk" }
                zone box connbtn { at: 138 * u, 52 * u; size: 248 * u, 26 * u; corner: 8 * u; cursor: pointer }
                on press connbtn { emit pick(n.index) }
            }
            //  Known, or the one in use: leave it, join it again, or forget it outright.
            group {
                show: n.known or n.active
                box { at: 76 * u, 52 * u; size: 120 * u, 26 * u; corner: 8 * u; color: if(n.active, ink, mint); opacity: if(n.active, 12% + 10% * primbtn.hover, 85% + 15% * primbtn.hover) }
                text "Disconnect" { at: floor(76 * u + 0.5), floor(52 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: ink; family: "Space Grotesk"; show: n.active }
                text "Connect" { at: floor(76 * u + 0.5), floor(52 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: onmint; family: "Space Grotesk"; show: not n.active }
                zone box primbtn { at: 76 * u, 52 * u; size: 120 * u, 26 * u; corner: 8 * u; cursor: pointer }
                on press primbtn { emit pick(n.index) }
                box { at: 200 * u, 52 * u; size: 120 * u, 26 * u; corner: 8 * u; color: ink; opacity: 6% + 10% * forgetbtn.hover }
                text "Forget" { at: floor(200 * u + 0.5), floor(52 * u + 0.5); anchor: center; size: 11 * u; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
                zone box forgetbtn { at: 200 * u, 52 * u; size: 120 * u, 26 * u; corner: 8 * u; cursor: pointer }
                on press forgetbtn { emit forget(n.index) }
            }
        }
    }

    //  One row of the Bluetooth window: connected (with its battery, if it says), paired, or just seen.
    //  Tapping it opens Connect/Disconnect and Forget underneath, the same as a Wi-Fi row.
    component BtRow(d: record, pick: event, forget: event) {
        //  The row grows and its buttons fade in on a spring, instead of jumping. One spring says which
        //  row is open (bt_sel, sliding between rows) and one how open (bt_extra): a row's share is how
        //  close it is to the selection.
        size: 276 * u, floor((30 + 44 * bt_extra * clamp(1 - abs(d.index - bt_sel), 0, 1)) * u + 0.5)
        let isopen = bt_open_row == d.index
        let open_t = bt_extra * clamp(1 - abs(d.index - bt_sel), 0, 1)
        //  What a tap asked for and BlueZ has not answered yet: 1 connecting, 2 disconnecting, 3 it could not.
        let working = d.busy == 1 or d.busy == 2
        let pulse = if(working, 55% + 45% * sin(time * 260), 100%)
        //  One card: the device line on top, and what opens is the same plate carrying on below it,
        //  with a hairline between, not a separate strip of buttons.
        box { from: 0, 0; size: 276 * u, (30 + 44 * open_t) * u; corner: 10 * u; color: ink; opacity: if(d.connected, 12%, 0%) + 5% * open_t + 9% * touch.hover }
        box { from: 0, 0; size: 276 * u, (30 + 44 * open_t) * u; corner: 10 * u; color: mint; opacity: if(working, 4% + 6% * pulse, 0%) }
        zone box touch { from: 0, 0; size: 276 * u, 30 * u; corner: 10 * u; cursor: pointer }
        ellipse { at: 14 * u, 15 * u; radius: 3 * u; color: mint; opacity: if(working, pulse, if(d.connected and d.busy == 0, 100%, 0%)) }
        ellipse { at: 14 * u, 15 * u; radius: 3 * u; color: #e0655a; opacity: if(d.busy == 3, 100%, 0%) }
        text d.name { at: floor(28 * u + 0.5), floor(15 * u + 0.5); anchor: left center; size: 12.5 * u; width: 150 * u; lines: 1; color: ink; family: "Space Grotesk" }
        text "Connected" { at: floor(262 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: mint; family: "Space Grotesk"; show: d.connected and d.battery < 0 and d.busy == 0 }
        text number(d.battery * 100, 0, "%") { at: floor(262 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: mint; family: "Space Grotesk"; show: d.connected and d.battery >= 0 and d.busy == 0 }
        text "Paired" { at: floor(262 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: faint; family: "Space Grotesk"; show: d.paired and not d.connected and d.busy == 0 }
        text "Not paired" { at: floor(262 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: faint; family: "Space Grotesk"; show: not d.paired and not d.connected and d.busy == 0 }
        text "Connecting…" { at: floor(262 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: mint; opacity: pulse; family: "Space Grotesk"; show: d.busy == 1 }
        text "Disconnecting…" { at: floor(262 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: faint; opacity: pulse; family: "Space Grotesk"; show: d.busy == 2 }
        text "Couldn't connect" { at: floor(262 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: #e0655a; family: "Space Grotesk"; show: d.busy == 3 }
        on press touch { bt_open_row = if(isopen, -1, d.index) }

        group {
            show: open_t > 0.01
            opacity: clamp(open_t, 0, 1)
            move: 0, (clamp(open_t, 0, 1) - 1) * 8 * u
            box { at: 138 * u, 30 * u; size: 240 * u, 1 * u; color: ink; opacity: 10% }
            group {
                show: not d.paired and not d.connected
                box { at: 138 * u, 52 * u; size: 248 * u, 26 * u; corner: 8 * u; color: mint; opacity: if(working, 30% + 20% * pulse, 85% + 15% * pairbtn.hover) }
                text "Pair & Connect" { at: floor(138 * u + 0.5), floor(52 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: onmint; family: "Space Grotesk"; show: not working }
                text "Pairing…" { at: floor(138 * u + 0.5), floor(52 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: ink; family: "Space Grotesk"; show: working }
                zone box pairbtn { at: 138 * u, 52 * u; size: 248 * u, 26 * u; corner: 8 * u; cursor: pointer; active: not working }
                on press pairbtn { emit pick(d.index) }
            }
            group {
                show: d.paired or d.connected
                box { at: 76 * u, 52 * u; size: 120 * u, 26 * u; corner: 8 * u; color: if(d.connected, ink, mint); opacity: if(working, 12% + 12% * pulse, if(d.connected, 12% + 10% * primbtn.hover, 85% + 15% * primbtn.hover)) }
                text "Disconnect" { at: floor(76 * u + 0.5), floor(52 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: ink; family: "Space Grotesk"; show: d.connected and not working }
                text "Connect" { at: floor(76 * u + 0.5), floor(52 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: onmint; family: "Space Grotesk"; show: not d.connected and not working }
                text "Connecting…" { at: floor(76 * u + 0.5), floor(52 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: ink; opacity: pulse; family: "Space Grotesk"; show: d.busy == 1 }
                text "Disconnecting…" { at: floor(76 * u + 0.5), floor(52 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: ink; opacity: pulse; family: "Space Grotesk"; show: d.busy == 2 }
                zone box primbtn { at: 76 * u, 52 * u; size: 120 * u, 26 * u; corner: 8 * u; cursor: pointer; active: not working }
                on press primbtn { emit pick(d.index) }
                box { at: 200 * u, 52 * u; size: 120 * u, 26 * u; corner: 8 * u; color: ink; opacity: 6% + 10% * forgetbtn.hover }
                text "Forget" { at: floor(200 * u + 0.5), floor(52 * u + 0.5); anchor: center; size: 11 * u; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
                zone box forgetbtn { at: 200 * u, 52 * u; size: 120 * u, 26 * u; corner: 8 * u; cursor: pointer }
                on press forgetbtn { emit forget(d.index) }
            }
        }
    }

    //  One running window, the way Synoptik's task list draws it: its app icon, its title (mint and
    //  bold if it has the keyboard), and a close button that shows while the row is under the pointer.
    //  A press gives it the keyboard; a middle press closes it.
    component TaskRow(t: record, focus: event, kill: event) {
        size: 288 * u, floor(36 * u + 0.5)          // whole pixels (with the list's gap), so the icon is not drawn between two
        zone box touch { from: 0, 0; size: 288 * u, 36 * u; corner: 12 * u; cursor: pointer }
        box { from: 0, 0; size: 288 * u, 36 * u; corner: 12 * u; color: ink; opacity: if(t.active, 11%, 5%) + 8% * touch.hover }
        image t.icon { at: floor(8 * u + 0.5), floor(7 * u + 0.5); size: floor(22 * u + 0.5), floor(22 * u + 0.5) }
        text t.title { at: floor(38 * u + 0.5), floor(18 * u + 0.5); anchor: left center; size: 12.5 * u; width: 186 * u; lines: 1; color: ink; family: "Space Grotesk"; show: not t.active }
        text t.title { at: floor(38 * u + 0.5), floor(18 * u + 0.5); anchor: left center; size: 12.5 * u; weight: 700; width: 186 * u; lines: 1; color: mint; family: "Space Grotesk"; show: t.active }
        //  Which workspace it is on, in a small pill.
        box { at: 240 * u, 18 * u; size: 24 * u, 18 * u; corner: 9 * u; color: ink; opacity: 8% }
        text t.ws { at: floor(240 * u + 0.5), floor(18 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 700; width: 24 * u; lines: 1; color: ink; opacity: 80%; family: "Space Grotesk" }
        ellipse { at: 268 * u, 18 * u; radius: 10 * u; color: if(close_z.hover, alert, ink); opacity: (if(close_z.hover, 90%, 9%)) * touch.hover }
        line { from: 264.5 * u, 14.5 * u; to: 271.5 * u, 21.5 * u; width: 1.4 * u; color: ink; opacity: 70% * touch.hover }
        line { from: 271.5 * u, 14.5 * u; to: 264.5 * u, 21.5 * u; width: 1.4 * u; color: ink; opacity: 70% * touch.hover }
        zone box close_z { at: 268 * u, 18 * u; size: 22 * u, 22 * u; corner: 11 * u; cursor: pointer }
        on press touch { emit focus(t.index); panel = none }
        on press middle touch { emit kill(t.index) }
        on press close_z { emit kill(t.index) }
    }

    //  One app in the mixer: its icon, its name, a small slider and its percentage, and a speaker that silences it.
    component MixRow(m: record, set: event, mute: event) {
        size: 288 * u, floor(28 * u + 0.5)          // whole pixels (with the list's gap), so the icon is not drawn between two
        opacity: if(m.corked, 55%, 100%)
        image m.icon { at: floor(10 * u + 0.5), floor(5 * u + 0.5); size: floor(20 * u + 0.5), floor(20 * u + 0.5) }
        text m.name { at: floor(38 * u + 0.5), floor(13 * u + 0.5); anchor: left center; size: 11 * u; width: 78 * u; lines: 1; color: ink; family: "Space Grotesk" }
        box { from: 116 * u, 11 * u; size: 100 * u, 6 * u; corner: 3 * u; color: deep; opacity: 60% }
        box { from: 116 * u, 11 * u; size: max(0.1, 100 * u * clamp(m.pct / 100, 0, 1)), 6 * u; corner: 3 * u; color: if(m.muted, faint, mint); opacity: if(m.muted, 60%, 100%) }
        zone box track { at: 166 * u, 14 * u; size: 112 * u, 24 * u; cursor: pointer }
        on press track { emit set(m.index * 4 + clamp((local.x - 116 * u) / (100 * u), 0, 1)) }
        on drag track { emit set(m.index * 4 + clamp((local.x - 116 * u) / (100 * u), 0, 1)) }
        text number(m.pct, 0, "%") { at: floor(252 * u + 0.5), floor(14 * u + 0.5); anchor: right center; align: right; size: 10.5 * u; width: 30 * u; lines: 1; color: faint; family: "Space Grotesk" }
        path { at: 264 * u, 14 * u; color: if(m.muted, faint, mint); opacity: 85% + 15% * mzone.hover; move 0, -2 * u; line 2.5 * u, -2 * u; line 5.5 * u, -5 * u; line 5.5 * u, 5 * u; line 2.5 * u, 2 * u; line 0, 2 * u; close }
        line { from: 255 * u, 8 * u; to: 271 * u, 20 * u; width: 1.5 * u; color: alert; opacity: if(m.muted, 100%, 0) }
        zone box mzone { at: 263 * u, 14 * u; size: 20 * u, 24 * u; cursor: pointer }
        on press mzone { emit mute(m.index) }
    }

    //  A result of the launcher: an icon (or a letter where there is none), its name, and a line of detail.
    //  Its width is the rows' width (`lw`): narrower where a preview sits beside the rows, and then it has no detail line.
    let lw = mix(430, 238, lpv) * u
    component LRow(t: record, pick: event) {
        size: lw, 40 * u
        zone box touch { from: 0, 0; size: lw, 40 * u; corner: 14 * u; cursor: pointer }
        box { from: 0, 0; size: lw, 40 * u; corner: 14 * u; color: if(t.sel, mint, ink); opacity: if(t.sel, 20%, 4%) + 8% * touch.hover }
        image t.icon { at: floor(10 * u + 0.5), floor(7 * u + 0.5); size: floor(26 * u + 0.5), floor(26 * u + 0.5); show: t.hasicon }
        ellipse { at: 23 * u, 20 * u; radius: 13 * u; color: mint; opacity: 16%; show: not t.hasicon }
        text t.glyph { at: floor(23 * u + 0.5), floor(20 * u + 0.5); anchor: center; align: center; size: 13 * u; weight: 700; width: 26 * u; lines: 1; color: mint; family: "Space Grotesk"; show: not t.hasicon }
        text t.title { at: floor(48 * u + 0.5), floor(if(t.hasdesc, 14, 20) * u + 0.5); anchor: left center; size: 13.5 * u; weight: 600; width: lw - (58 + 96 * (1 - lpv)) * u; lines: 1; color: if(t.sel, mint, ink); family: "Space Grotesk" }
        text t.desc { at: floor(48 * u + 0.5), floor(29 * u + 0.5); anchor: left center; size: 10 * u; width: lw - 62 * u; lines: 1; color: faint; family: "Space Grotesk"; show: t.hasdesc }
        text t.sub { at: floor(lw - 10 * u + 0.5), floor(20 * u + 0.5); anchor: right center; align: right; size: 10.5 * u; width: 90 * u; lines: 1; color: faint; opacity: 1 - lpv; family: "Space Grotesk" }
        on press touch { emit pick(t.index) }
    }

    //  One app that lives in the tray, with no window of its own: its icon and name. A press is what clicking its
    //  icon would do; the dots open its menu, and the pin keeps it on the bar.
    component TrayRow(t: record, click: event, pin: event, menu: event) {
        size: 288 * u, floor(36 * u + 0.5)          // whole pixels (with the list's gap), so the icon is not drawn between two
        zone box touch { from: 0, 0; size: 288 * u, 36 * u; corner: 12 * u; cursor: pointer }
        box { from: 0, 0; size: 288 * u, 36 * u; corner: 12 * u; color: ink; opacity: 5% + 8% * touch.hover }
        image t.icon { at: floor(8 * u + 0.5), floor(7 * u + 0.5); size: floor(22 * u + 0.5), floor(22 * u + 0.5) }
        text t.title { at: floor(38 * u + 0.5), floor(18 * u + 0.5); anchor: left center; size: 12.5 * u; width: 184 * u; lines: 1; color: ink; family: "Space Grotesk" }
        //  Its menu: three dots.
        group {
            show: t.menu
            opacity: 45% + 55% * menu_z.hover
            ellipse { at: 232 * u, 18 * u; radius: 1.4 * u; color: ink }
            ellipse { at: 238 * u, 18 * u; radius: 1.4 * u; color: ink }
            ellipse { at: 244 * u, 18 * u; radius: 1.4 * u; color: ink }
        }
        zone box menu_z { at: 238 * u, 18 * u; size: 24 * u, 28 * u; corner: 10 * u; cursor: pointer; active: t.menu }
        //  The pin: shown on the row under the pointer, and always on a pinned one.
        group {
            opacity: if(t.pinned, 100%, 55% * touch.hover + 25% * pin_z.hover)
            ellipse { at: 266 * u, 15 * u; radius: 3.6 * u; color: mint; opacity: if(t.pinned, 100%, 0%) }
            ellipse { at: 266 * u, 15 * u; radius: 3.6 * u; stroke: 1.3 * u; color: ink; opacity: if(t.pinned, 0%, 100%) }
            line { from: 266 * u, 18.5 * u; to: 266 * u, 24 * u; width: 1.4 * u; color: if(t.pinned, mint, ink) }
        }
        zone box pin_z { at: 266 * u, 18 * u; size: 22 * u, 28 * u; corner: 10 * u; cursor: pointer }
        on press touch { emit click(t.index); panel = none }
        on press menu_z { emit menu(t.index) }
        on press pin_z { emit pin(t.index) }
    }

    //  One entry of a tray app's menu: a check if it is ticked, its label (in a step for each level of submenu
    //  it is under), and an arrow if it opens more. A separator is a line.
    component TmRow(r: record, pick: event) {
        size: 288 * u, floor(if(r.sep, 10, 28) * u + 0.5)
        zone box touch { from: 0, 0; size: 288 * u, 28 * u; corner: 9 * u; cursor: pointer; active: r.enabled and not r.sep }
        box { from: 0, 0; size: 288 * u, 28 * u; corner: 9 * u; color: ink; opacity: if(r.sep, 0%, 9% * touch.hover) }
        box { at: 144 * u, 5 * u; size: 264 * u, 1 * u; color: ink; opacity: if(r.sep, 12%, 0%) }
        path { at: 15 * u, 14 * u; stroke: 1.6 * u; color: mint; opacity: if(r.checked, 100%, 0%); move -3.5 * u, 0.5 * u; line -1 * u, 3 * u; line 4 * u, -3.5 * u }
        text r.label { at: floor((30 + r.depth * 14) * u + 0.5), floor(14 * u + 0.5); anchor: left center; size: 12.5 * u; width: (226 - r.depth * 14) * u; lines: 1; color: ink; opacity: if(r.enabled, 100%, 40%); show: not r.sep; family: "Space Grotesk" }
        path { at: 274 * u, 14 * u; stroke: 1.5 * u; color: ink; rotate: if(r.open, 90deg, 0deg); opacity: if(r.kids, 60%, 0%); move -2 * u, -3.5 * u; line 2 * u, 0; line -2 * u, 3.5 * u }
        on press touch { emit pick(r.index) }
    }

    //  A tray app's icon on the bar: a left click is what clicking it would do, a right click opens its menu.
    component BarTray(t: record, click: event, menu: event) {
        size: floor(18 * u + 0.5), floor(18 * u + 0.5)
        box { at: 9 * u, 9 * u; size: 26 * u, 26 * u; corner: 8 * u; color: ink; opacity: 14% * touch.hover * bs.tray }
        image t.icon { at: 0, 0; size: floor(18 * u + 0.5), floor(18 * u + 0.5); opacity: (78% + 22% * touch.hover) * bs.tray }
        zone box touch { at: 9 * u, 9 * u; size: 24 * u, 30 * u; cursor: pointer; active: bs.tray > 0.5 }
        on press touch { emit click(t.index) }
        on press right touch { emit menu(t.index) }
    }

    //  A notification's button (Reply, Mark read…): a small pill with its label.
    component NtAct(a: record, click: event) {
        size: floor(82 * u + 0.5), floor(26 * u + 0.5)
        zone box touch { from: 0, 0; size: 82 * u, 26 * u; corner: 8 * u; cursor: pointer }
        box { from: 0, 0; size: 82 * u, 26 * u; corner: 8 * u; color: if(touch.hover, mint, ink); opacity: if(touch.hover, 100%, 8%) }
        text a.label { at: floor(41 * u + 0.5), floor(13 * u + 0.5); anchor: center; align: center; size: 12.5 * u; weight: 700; width: 74 * u; lines: 1; color: if(touch.hover, onmint, ink); family: "Space Grotesk" }
        on press touch { emit click(a.index) }
    }

    //  One wallpaper in the gallery: its picture in rounded corners, a ring when it is the one in use.
    component WpThumb(t: record, pick: event) {
        size: 96 * u, 54 * u
        zone box touch { from: 0, 0; size: 96 * u, 54 * u; corner: 8 * u; cursor: pointer }
        //  The pictures are cropped to 16:9 in a cache by the logic, so every tile is the same.
        group {
            clip inset 0 box { from: 0, 0; size: 96 * u, 54 * u; corner: 8 * u }
            image t.thumb { at: 0, 0; size: 96 * u, 54 * u }
        box { from: 0, 0; size: 96 * u, 54 * u; color: ink; opacity: 14% * touch.hover }
        }
        box { from: 0, 0; size: 96 * u, 54 * u; corner: 8 * u; stroke: 2 * u; color: mint; opacity: if(wp_sel == t.index, 100%, 0) }
        on press touch { emit pick(t.index) }
    }

    //  A weather icon, drawn from shapes (there is no icon font): `kind` 0 clear · 1 partly cloudy · 2 cloud ·
    //  3 fog · 4 rain · 5 snow · 6 storm. The cloud is `cloud`; the sun, rain, snow and bolt are `sun`.
    component WxIcon(kind: number, cloud: color = ink, sun: color = mint) {
        size: 26 * u, 20 * u
        //  clear
        group {
            show: kind == 0
            ellipse { at: 13 * u, 10 * u; radius: 4.6 * u; color: sun }
            repeat i in 0..8 {
                group {
                    pivot: 13 * u, 10 * u
                    rotate: i * 45deg
                    box { at: 13 * u, 10 * u - 7.8 * u; size: 1.7 * u, 3 * u; corner: 0.8 * u; color: sun }
                }
            }
        }
        //  partly cloudy: a small sun behind a cloud
        group {
            show: kind == 1
            ellipse { at: 8.5 * u, 7.5 * u; radius: 3.4 * u; color: sun }
            repeat i in 0..8 {
                group {
                    pivot: 8.5 * u, 7.5 * u
                    rotate: i * 45deg
                    box { at: 8.5 * u, 7.5 * u - 5.9 * u; size: 1.4 * u, 2.2 * u; corner: 0.7 * u; color: sun }
                }
            }
            ellipse { at: 10 * u, 13 * u; radius: 3.6 * u; color: cloud }
            ellipse { at: 15 * u, 11.5 * u; radius: 4.6 * u; color: cloud }
            ellipse { at: 19 * u, 13.5 * u; radius: 3.2 * u; color: cloud }
            box { at: 14.5 * u, 15.5 * u; size: 13 * u, 4.5 * u; corner: 2.2 * u; color: cloud }
        }
        //  the cloud alone, and the cloud that rain, snow and storm hang from
        group {
            show: kind == 2 or kind == 4 or kind == 5 or kind == 6
            let cy0 = if(kind == 2, 10, 7.5) * u
            ellipse { at: 9 * u, cy0 + 1 * u; radius: 4 * u; color: cloud }
            ellipse { at: 14 * u, cy0 - 1.5 * u; radius: 5 * u; color: cloud }
            ellipse { at: 18.5 * u, cy0 + 1 * u; radius: 3.6 * u; color: cloud }
            box { at: 13.5 * u, cy0 + 3 * u; size: 14 * u, 5 * u; corner: 2.5 * u; color: cloud }
        }
        //  fog
        group {
            show: kind == 3
            box { at: 13 * u, 5.5 * u; size: 17 * u, 2 * u; corner: 1 * u; color: cloud }
            box { at: 13 * u, 10 * u; size: 13 * u, 2 * u; corner: 1 * u; color: cloud }
            box { at: 13 * u, 14.5 * u; size: 17 * u, 2 * u; corner: 1 * u; color: cloud }
        }
        //  rain
        group {
            show: kind == 4
            line { from: 8.5 * u, 14 * u; to: 7 * u, 18 * u; width: 1.5 * u; color: sun }
            line { from: 13.5 * u, 14 * u; to: 12 * u, 18 * u; width: 1.5 * u; color: sun }
            line { from: 18.5 * u, 14 * u; to: 17 * u, 18 * u; width: 1.5 * u; color: sun }
        }
        //  snow
        group {
            show: kind == 5
            ellipse { at: 8 * u, 15.5 * u; radius: 1.3 * u; color: sun }
            ellipse { at: 13 * u, 17.5 * u; radius: 1.3 * u; color: sun }
            ellipse { at: 18 * u, 15.5 * u; radius: 1.3 * u; color: sun }
        }
        //  storm: a bolt
        path {
            show: kind == 6
            at: floor(13 * u + 0.5), floor(11 * u + 0.5)
            color: sun
            move 1.5 * u, 0
            line -2.5 * u, 4.5 * u
            line 0.2 * u, 4.5 * u
            line -1.2 * u, 4 * u
            line 4 * u, -5.5 * u
            line 0.5 * u, -5.5 * u
            close
        }
    }

    //  One day of the forecast: its name, its icon, its high and its low. Today is in the accent.
    component WxDay(d: record) {
        size: floor(42 * u + 0.5), floor(50 * u + 0.5)
        text d.label { at: floor(21 * u + 0.5), floor(7 * u + 0.5); anchor: center; align: center; size: 9.5 * u; weight: 700; width: 40 * u; lines: 1; color: if(d.today, mint, faint); family: "Space Grotesk" }
        column icon_col { at: 8 * u, 15 * u; WxIcon(d.kind, if(d.today, mint, ink), mint) }
        text d.hi { at: floor(12 * u + 0.5), floor(42 * u + 0.5); anchor: center; align: center; size: 10 * u; weight: 700; width: 20 * u; lines: 1; color: ink; family: "Space Grotesk" }
        text d.lo { at: floor(31 * u + 0.5), floor(42 * u + 0.5); anchor: center; align: center; size: 10 * u; width: 20 * u; lines: 1; color: faint; family: "Space Grotesk" }
    }

    //  One notification in the history: its title and when it came, and under them the app and what it said.
    //  54 px tall, so a stack of them sits on whole pixels. A cross shows on hover, in place of the time.
    component NtHistRow(h: record, del: event) {
        size: 276 * u, 54
        zone box touch { from: 0, 0; size: 276 * u, 54; corner: 12 * u }
        box { from: 0, 0; size: 276 * u, 54; corner: 12 * u; color: ink; opacity: 5% + 6% * touch.hover }
        text h.title { at: floor(12 * u + 0.5), 17; anchor: left center; size: 12.5 * u; weight: 700; width: 200 * u; lines: 1; color: ink; family: "Space Grotesk" }
        text h.sub { at: floor(12 * u + 0.5), 37; anchor: left center; size: 10.5 * u; width: 244 * u; lines: 1; color: faint; family: "Space Grotesk" }
        text h.when { at: floor(264 * u + 0.5), 17; anchor: right center; size: 10 * u; color: faint; opacity: 100% - 100% * touch.hover; family: "Space Grotesk" }
        ellipse { at: floor(258 * u + 0.5), 17; radius: 9 * u; color: if(del_z.hover, alert, ink); opacity: (if(del_z.hover, 80%, 12%)) * touch.hover }
        line { from: floor(258 * u + 0.5) - 3.2 * u, 17 - 3.2 * u; to: floor(258 * u + 0.5) + 3.2 * u, 17 + 3.2 * u; width: 1.4 * u; color: ink; opacity: 70% * touch.hover }
        line { from: floor(258 * u + 0.5) + 3.2 * u, 17 - 3.2 * u; to: floor(258 * u + 0.5) - 3.2 * u, 17 + 3.2 * u; width: 1.4 * u; color: ink; opacity: 70% * touch.hover }
        zone box del_z { at: floor(258 * u + 0.5), 17; size: 24 * u, 24 * u; corner: 12 * u; cursor: pointer }
        on press del_z { emit del(h.index) }
    }

    let cx = 450
    //  The tray's icons (the pinned apps, or all of them) are a piece of the bar like the others; the bar widens for them.
    let bar.gap = 12 * u
    let fw.tray = max(0, trn * 24 - 6) * u               // icons 18 wide, 6 apart
    let vw.tray = fw.tray * bs.tray
    let bw.tray = (fw.tray + bar.gap * min(1, trn)) * bs.tray
    let bar.w = 450 * u + bw.tray
    let bar.h = 40 * u
    let bar.y = 8 + bar.h / 2
    let bar.rad = 14 * u                 // the bar's corner when shut: the same as the plates', not a full pill
    //  The bar's pieces sit in a row in the order Settings > Bar gives them (`bo.*`), 16 in from each end and
    //  `bar.gap` apart. Each one is as wide as what it draws (`fw.*`) and takes that and a gap (`bw.*`: less while
    //  it is being hidden, and the player's only while there is something playing); the title takes none, it is
    //  the stretch between the two ends: what comes before it is laid from the left edge, what comes after it
    //  from the right, so its gap is on the side towards the title.
    //  The clock's width is measured: the hour, the minutes and, at the edge, the day over the am/pm (both about
    //  the same width, so the column is as wide as the wider).
    let clock.col = max(caw.width, cdw.width)
    let bar.l = cx - bar.w / 2 + 16 * u
    let bar.r = cx + bar.w / 2 - 16 * u
    let fw.ws = 76 * u                   // five dots 15 apart, one of them the 20-wide pill
    let fw.media = 43 * u                // previous, play, next: their bars at ±20.5
    let fw.set = 15 * u                  // the gear with its teeth
    let fw.sr = 12 * u                   // the magnifier, glass and handle
    let fw.ctl = 13 * u                  // the two sliders
    let fw.clock = chw.width + cmw.width + clock.col
    let vw.ws = fw.ws * bs.ws            // what each one draws, now
    let vw.media = fw.media * mshow * bs.media
    let vw.sr = fw.sr * bs.sr
    let vw.ctl = fw.ctl * bs.ctl
    let vw.clock = fw.clock * bs.clock
    let bw.ws = (fw.ws + bar.gap) * bs.ws
    let bw.media = (fw.media + bar.gap) * mshow * bs.media
    let bw.set = fw.set + bar.gap
    let bw.sr = (fw.sr + bar.gap) * bs.sr
    let bw.ctl = (fw.ctl + bar.gap) * bs.ctl
    let bw.clock = (fw.clock + bar.gap) * bs.clock
    //  How much of the row comes before each piece (`pre.*`) and after it (`post.*`).
    let pre.ws = if(bo.media < bo.ws, bw.media, 0) + if(bo.set < bo.ws, bw.set, 0) + if(bo.sr < bo.ws, bw.sr, 0) + if(bo.ctl < bo.ws, bw.ctl, 0) + if(bo.clock < bo.ws, bw.clock, 0) + if(bo.tray < bo.ws, bw.tray, 0)
    let post.ws = if(bo.media > bo.ws, bw.media, 0) + if(bo.set > bo.ws, bw.set, 0) + if(bo.sr > bo.ws, bw.sr, 0) + if(bo.ctl > bo.ws, bw.ctl, 0) + if(bo.clock > bo.ws, bw.clock, 0) + if(bo.tray > bo.ws, bw.tray, 0)
    let pre.media = if(bo.ws < bo.media, bw.ws, 0) + if(bo.set < bo.media, bw.set, 0) + if(bo.sr < bo.media, bw.sr, 0) + if(bo.ctl < bo.media, bw.ctl, 0) + if(bo.clock < bo.media, bw.clock, 0) + if(bo.tray < bo.media, bw.tray, 0)
    let post.media = if(bo.ws > bo.media, bw.ws, 0) + if(bo.set > bo.media, bw.set, 0) + if(bo.sr > bo.media, bw.sr, 0) + if(bo.ctl > bo.media, bw.ctl, 0) + if(bo.clock > bo.media, bw.clock, 0) + if(bo.tray > bo.media, bw.tray, 0)
    let pre.set = if(bo.ws < bo.set, bw.ws, 0) + if(bo.media < bo.set, bw.media, 0) + if(bo.sr < bo.set, bw.sr, 0) + if(bo.ctl < bo.set, bw.ctl, 0) + if(bo.clock < bo.set, bw.clock, 0) + if(bo.tray < bo.set, bw.tray, 0)
    let post.set = if(bo.ws > bo.set, bw.ws, 0) + if(bo.media > bo.set, bw.media, 0) + if(bo.sr > bo.set, bw.sr, 0) + if(bo.ctl > bo.set, bw.ctl, 0) + if(bo.clock > bo.set, bw.clock, 0) + if(bo.tray > bo.set, bw.tray, 0)
    let pre.sr = if(bo.ws < bo.sr, bw.ws, 0) + if(bo.media < bo.sr, bw.media, 0) + if(bo.set < bo.sr, bw.set, 0) + if(bo.ctl < bo.sr, bw.ctl, 0) + if(bo.clock < bo.sr, bw.clock, 0) + if(bo.tray < bo.sr, bw.tray, 0)
    let post.sr = if(bo.ws > bo.sr, bw.ws, 0) + if(bo.media > bo.sr, bw.media, 0) + if(bo.set > bo.sr, bw.set, 0) + if(bo.ctl > bo.sr, bw.ctl, 0) + if(bo.clock > bo.sr, bw.clock, 0) + if(bo.tray > bo.sr, bw.tray, 0)
    let pre.ctl = if(bo.ws < bo.ctl, bw.ws, 0) + if(bo.media < bo.ctl, bw.media, 0) + if(bo.set < bo.ctl, bw.set, 0) + if(bo.sr < bo.ctl, bw.sr, 0) + if(bo.clock < bo.ctl, bw.clock, 0) + if(bo.tray < bo.ctl, bw.tray, 0)
    let post.ctl = if(bo.ws > bo.ctl, bw.ws, 0) + if(bo.media > bo.ctl, bw.media, 0) + if(bo.set > bo.ctl, bw.set, 0) + if(bo.sr > bo.ctl, bw.sr, 0) + if(bo.clock > bo.ctl, bw.clock, 0) + if(bo.tray > bo.ctl, bw.tray, 0)
    let pre.clock = if(bo.ws < bo.clock, bw.ws, 0) + if(bo.media < bo.clock, bw.media, 0) + if(bo.set < bo.clock, bw.set, 0) + if(bo.sr < bo.clock, bw.sr, 0) + if(bo.ctl < bo.clock, bw.ctl, 0) + if(bo.tray < bo.clock, bw.tray, 0)
    let post.clock = if(bo.ws > bo.clock, bw.ws, 0) + if(bo.media > bo.clock, bw.media, 0) + if(bo.set > bo.clock, bw.set, 0) + if(bo.sr > bo.clock, bw.sr, 0) + if(bo.ctl > bo.clock, bw.ctl, 0) + if(bo.tray > bo.clock, bw.tray, 0)
    let pre.title = if(bo.ws < bo.title, bw.ws, 0) + if(bo.media < bo.title, bw.media, 0) + if(bo.set < bo.title, bw.set, 0) + if(bo.sr < bo.title, bw.sr, 0) + if(bo.ctl < bo.title, bw.ctl, 0) + if(bo.clock < bo.title, bw.clock, 0) + if(bo.tray < bo.title, bw.tray, 0)
    let post.title = if(bo.ws > bo.title, bw.ws, 0) + if(bo.media > bo.title, bw.media, 0) + if(bo.set > bo.title, bw.set, 0) + if(bo.sr > bo.title, bw.sr, 0) + if(bo.ctl > bo.title, bw.ctl, 0) + if(bo.clock > bo.title, bw.clock, 0) + if(bo.tray > bo.title, bw.tray, 0)
    let pre.tray = if(bo.ws < bo.tray, bw.ws, 0) + if(bo.media < bo.tray, bw.media, 0) + if(bo.set < bo.tray, bw.set, 0) + if(bo.sr < bo.tray, bw.sr, 0) + if(bo.ctl < bo.tray, bw.ctl, 0) + if(bo.clock < bo.tray, bw.clock, 0)
    let post.tray = if(bo.ws > bo.tray, bw.ws, 0) + if(bo.media > bo.tray, bw.media, 0) + if(bo.set > bo.tray, bw.set, 0) + if(bo.sr > bo.tray, bw.sr, 0) + if(bo.ctl > bo.tray, bw.ctl, 0) + if(bo.clock > bo.tray, bw.clock, 0)
    //  Each piece's middle: from the left edge before the title, from the right edge after it.
    let at.ws = if(bo.ws < bo.title, bar.l + pre.ws + vw.ws / 2, bar.r - post.ws - vw.ws / 2)
    let mc = if(bo.media < bo.title, bar.l + pre.media + vw.media / 2, bar.r - post.media - vw.media / 2)
    let set.x = if(bo.set < bo.title, bar.l + pre.set + fw.set / 2, bar.r - post.set - fw.set / 2)
    let sr.x = if(bo.sr < bo.title, bar.l + pre.sr + vw.sr / 2, bar.r - post.sr - vw.sr / 2)
    let ctl.x = if(bo.ctl < bo.title, bar.l + pre.ctl + vw.ctl / 2, bar.r - post.ctl - vw.ctl / 2)
    let tr.x = if(bo.tray < bo.title, bar.l + pre.tray + vw.tray / 2, bar.r - post.tray - vw.tray / 2)
    let at.clock = if(bo.clock < bo.title, bar.l + pre.clock + vw.clock / 2, bar.r - post.clock - vw.clock / 2)
    //  The clock's texts are set against its right edge: the day column, the minutes, the hour.
    let clock.r = at.clock + fw.clock / 2
    let clock.left = clock.r - clock.col - cmw.width - chw.width
    //  Where the window title starts, and how far it may reach: the stretch (the gaps are its neighbours').
    let win.x = bar.l + pre.title
    let win.w = max(0, bar.r - post.title - win.x)
    let room = 10 * u

    //  The music only moves the bar: it fades out as the panel opens (gone by a third of
    //  the way), so an open panel sits still.
    let pv = pulse * (1 - min(1, drop * 3))
    let pop = pv * 6 * u           // how far the bar swells on the beat
    //  The bounce on `dc`/`dk` (below) is free to swing past 1 on the way open - that
    //  overshoot is the spring showing - but a size can't go negative, so anything
    //  that scales a width or height reads the clamped version instead: it shrinks
    //  cleanly to nothing on the way closed rather than through it.
    let dc0 = max(0, dc)
    let dk0 = max(0, dk)
    let dm0 = max(0, dm)
    let do0 = max(0, do)
    let ds0 = max(0, ds)
    let dl0 = max(0, dl)
    let expand0 = max(0, expand)
    //  Marea's liquid: while a drawer comes out (or goes back), the neck that joins it to the bar is a bell,
    //  thickest halfway; the drawer is a little narrower there, as a falling drop is, and it is round at first
    //  and squares up as it grows (and rounds again as it goes). `*.bell` is 0 shut, 1 halfway, 0 open.
    let dk.bell = 4 * min(1, dk0) * (1 - min(1, dk0))
    let ds.bell = 4 * min(1, ds0) * (1 - min(1, ds0))
    let dl.bell = 4 * min(1, dl0) * (1 - min(1, dl0))
    let dc.bell = 4 * min(1, dc0) * (1 - min(1, dc0))
    let do.bell = 4 * min(1, do0) * (1 - min(1, do0))
    let dm.bell = 4 * min(1, dm0) * (1 - min(1, dm0))
    //  Both panels fill in their width quickly and then keep growing taller - so a
    //  plain `min(1, …)` on the width leaves it capped flat once that's done, and
    //  the bounce on the way to fully open (or the little one closing overshoots
    //  into) only ever shows up as a change in height. The `max(0, … - 1) * 0.6`
    //  term only wakes up past that cap, so the width bulges a little with the
    //  same overshoot instead of sitting there rigid while the height does all
    //  the springing.
    let card.w = bar.w * (min(1, dc0 * 3) + max(0, dc0 - 1) * 0.6)
    let card.h = 373 * u * dc0        // 303, and 70 more for the weather strip
    //  The controls drawer: as wide as its plates and their margins need (288 + 2 x 12), coming
    //  out of the bar. It starts narrow and wide-open in height last, and widens to its place.
    //  It reaches up into the bar so the two can melt; `dk.hh` is how far down it goes.
    let dk.w = (120 + 192 * (min(1, dk0 * 1.6) + max(0, dk0 - 1) * 0.6)) * u
    //  The plates stack from a shared cursor, each one naming where the one
    //  before it ended, so a plate that changes height (the media one, which
    //  shrinks to a sliver with nothing playing) pushes what is under it
    //  instead of leaving a gap or a pile-up. Unscaled: `u` is applied where
    //  each offset is finally used. Wi-Fi and Bluetooth are tiles side by side
    //  now, at the very top, so they cost one row's height between them.
    let tiles_top  = 8
    let tiles_h    = 72
    let tiles_bot  = tiles_top + tiles_h
    //  Do Not Disturb and Caffeine: a second row of tiles, the same size as the first.
    let tiles2_top = tiles_bot + 4
    let tiles2_bot = tiles2_top + tiles_h
    let bright_top = tiles2_bot + 4
    let bright_bot = bright_top + 64
    let vol_top    = bright_bot + 4
    let vol_bot    = vol_top + 64
    //  The player's plate is alone in its own panel now, at the top of it.
    let media_top  = 8
    let media_h    = mix(40, 96, media_open)
    let media_bot  = media_top + media_h
    //  Either tile can grow past the stack into its own window - as tall as its
    //  list actually is (one open row taller, while one is), up to a ceiling
    //  where the list itself starts scrolling instead of the window still
    //  growing to fit it.
    let wifi_rows_h = max(1, wifi_nets.count) * 34 - 4 + 44 * wifi_extra
    let bt_rows_h   = max(1, bt_devices.count) * 34 - 4 + 44 * bt_extra
    let list_max    = 220
    //  The notifications window has a Do Not Disturb row and its timer chips above its list (84 more), and a
    //  shorter list. Its rows are 54 px with 6 between, whole pixels.
    let nt_rows_h = (max(1, nt_hist.count) * 60 - 6) / u
    let list_view_h = min(if(showing_sub == btview, bt_rows_h, if(showing_sub == notifview, nt_rows_h, wifi_rows_h)), if(showing_sub == notifview, 150, list_max))
    //  The Caffeine window is a row and two lines of chips (91 under its title), and has no list.
    let sub_content = if(showing_sub == cafview, 91, if(showing_sub == notifview, 84, 0) + list_view_h)
    let sub_bot = tiles_top + 54 + sub_content + 16
    //  The output list drops over what is under the volume row; with more than a couple of outputs
    //  it reaches past the drawer, so the drawer grows to hold it while it is open.
    let dd.rows = clamp(outlist.count, 1, 6)
    let dd.extra = max(0, dd.rows * 30 - 28) * max(0, dd)
    //  The mixer hangs under the volume plate: a row of 32 per app (a line of words with none), and the drawer
    //  grows to hold it.
    //  The mixer is part of the volume card: the card grows by `mix.m` while it is open (a row of 32 per app, or a line of
    //  words with none, and room for the dots at the foot).
    let mix.m = if(mixer.count > 0, mixer.count * 32 + 8, 40)
    let vp.h = 64 + mix.m * clamp(vm, 0, 1)                // the volume card's height, unscaled
    let mix.extra = mix.m * max(0, vm)
    let content_bot = mix(vol_bot + max(dd.extra, mix.extra), sub_bot, expand0)
    let dk.hh = bar.h / 2 + (content_bot + 16) * u * dk0 + max(0, sag)
    //  The player's panel: the same drawer as the controls, centred on the bar, and as tall as
    //  its one plate.
    //  The calendar's drawer: it falls as a narrow drop out of the bar and widens to exactly the bar's width as it
    //  lands, with the liquid neck of the other drawers while it is narrower (see `dc.bell`). It starts at the bar's
    //  middle, as they do, so the blend has the bar to melt into; as tall as the bar's lower half plus its content.
    let dc.w = min(bar.w, (120 + 330 * (min(1, dc0 * 1.6) + max(0, dc0 - 1) * 0.6)) * u)
    let dc.hh = bar.h / 2 + card.h + max(0, sag)
    //  Once it is as wide as the bar (`f` 1) it must be a straight continuation of the bar's sides, so it moves its top up to
    //  the bar's top edge and stops blending: a blend there would puff the join out at the bar's corners.
    let dc.f = clamp((dc.w - bar.w + 24 * u) / (24 * u), 0, 1)
    let dc.top = mix(bar.y, bar.y - bar.h / 2, dc.f)
    //  The volume / notification drawer: 340 wide, as tall as its plate.
    //  The notification's plate is as tall as what is on it: the app line, the title (one line or more),
    //  the body if there is one (as many lines as it needs), and a row of buttons if it brought any,
    //  with 12 of air around. Never shorter than its icon tile. Each text measures itself once wrapped.
    let nt_th = max(24, ntt.height / u)
    let nt_bh = ntb.height / u
    let nt_content = if(nt_body_on, 39 + nt_th + nt_bh, 35 + nt_th)
    let nt_h = max(68, nt_content + if(nt_acts.count > 0, 34, 0) + 12)
    follow osd_h = if(osd_kind == note, nt_h, 64)
    //  The settings panel: 620 wide. A header (36), then the sidebar and the page side by side (352).
    //  How tall the settings page in view is (unscaled): Wallpaper, Glass, Display.
    //  The Display page: its cards down to the profiles one, which is as tall as its rows (none: a line).
    let disp.prows = max(24, disp_pn_s * 30)
    let disp.h = 460 + disp.prows + 114
    let set.h = mix(mix(mix(mix(mix(456, 262, set_pg), min(disp.h, 456), set_pgd), 330, set_pgb), 392, set_pgh), 262, set_pga)
    let need_clock = ((wifi_scanning or bt_scanning or bt_working or caf_on) and dk > 0.01) or (do > 0.01 and (osd_kind == vol or nt_urgent)) or (set_pgd > 0.01 and disp.h > 456)
    spin time by if(need_clock, 1, 0)
    let ss.w = (120 + 500 * (min(1, ds0 * 1.6) + max(0, ds0 - 1) * 0.6)) * u
    let ss.hh = bar.h / 2 + (8 + 36 + 8 + set.h + 16) * u * ds0 + max(0, sag)
    //  The launcher: a drop that widens to the bar's width as it lands, like the calendar. The search field (40), the
    //  rows (44 each, up to eight; seven where there is a preview beside them) and a line of hints.
    let dl.w = min(bar.w, (120 + 330 * (min(1, dl0 * 1.6) + max(0, dl0 - 1) * 0.6)) * u)
    let dl.hh = bar.h / 2 + (112 + lr * 44) * u * dl0 + max(0, sag)
    let dl.f = clamp((dl.w - bar.w + 24 * u) / (24 * u), 0, 1)     // as for the calendar
    let dl.top = mix(bar.y, bar.y - bar.h / 2, dl.f)
    let os.w = (120 + 220 * (min(1, do0 * 1.6) + max(0, do0 - 1) * 0.6)) * u
    let os.hh = bar.h / 2 + (8 + osd_h + 16) * u * do0 + max(0, sag)
    let dm.w = (120 + 192 * (min(1, dm0 * 1.6) + max(0, dm0 - 1) * 0.6)) * u
    //  Under the player's plate, the running windows and then the tray apps (Synoptik's "Running
    //  tasks" and "Background apps"), each a header and rows, scrolling past a few.
    let task_rows = min(max(1, tasks.count), 6)
    let tasks_top = media_bot + 8
    let tasks_list = tasks_top
    let tasks_bot = tasks_list + task_rows * 40 - 4
    let tray_rows = min(trays.count, 3)
    let tray_top = tasks_bot + 8
    let tray_list = tray_top + 26
    let panel_bot = if(trays.count > 0, tray_list + tray_rows * 40 - 4, tasks_bot)
    //  The tray menu: the app's plate (8..60), Open and Alt (66..92), then its menu from 100 (or a line saying it has none).
    let tm.list = min(tm_h, 224)
    let tm_bot = 100 + if(tm_has_menu, tm.list, 30) + 8
    let dm.hh = bar.h / 2 + (if(dm_mode == dmm_tray, tm_bot, panel_bot) + 16) * u * dm0 + max(0, sag)
    let mdx = cx
    //  Where the contents hang from: the panel's old middle, so they keep their
    //  place when the panel grows to make room for the player.
    let cy = bar.y + 26 * u + 125 * u * drop
    //  The controls' content hangs from here: 127 above `cy`, so the volume plate starts 12 under the
    //  bar and the drawer is only as tall as its two plates and their margins.
    let ck = cy - 127 * u

    //  The whole bar, glass and all, is one group so the wave can bend it as one thing.
    group {
        shader: wave, pv, clamp(ring, 0, 1), mix((mc - (cx - bar.w / 2)) / bar.w, 0.5, clamp(ring_mid, 0, 1)), 0, 2.6 * u * (1 - min(1, drop * 2)), bar.w, 0, 0
        // ── the liquid ───────────────────────────────────────────────
        body {
            color: tint
            glass: glass_frost
            opacity: glass_op
            lens: false
            rim: 10% + 14% * pv
            shine: pointer
            shadow: 0, 1 + 6 * drop + 3 * pv, 6 + 14 * drop + 8 * pv, 8% + 16% * drop + 8% * pv, deep
            //  The bar is only the bar: it swells a little on the beat and nothing else. Every panel,
            //  the calendar included, is a drawer of its own that drops from it, below.
            box shell { at: cx, bar.y - bar.h / 2 + (bar.h + pop) / 2; size: bar.w + pv * 10 * u, bar.h + pop; corner: bar.rad }
            //  The drawer is a second shape in the same glass. `blend` melts it into the bar, so where the
            //  narrow drawer meets the wide bar there is a liquid neck, not a corner. It is only there
            //  while it has size: a zero-size shape would leave a stray shadow behind.
            box drawer { at: cx, bar.y + dk.hh / 2; size: dk.w * (1 - 0.07 * dk.bell + 0.003 * wobble), dk.hh * (1 - 0.002 * wobble); corner: mix(min(dk.w, dk.hh) / 2, 26 * u, clamp(dk0 * 1.6 - 0.1, 0, 1)); blend: (16 + 20 * dk.bell) * u * min(1, dk0 * 4); show: dk0 > 0.004 }
            box cdrawer { at: cx, (dc.top + bar.y + dc.hh) / 2; size: dc.w * (1 - 0.07 * dc.bell + 0.003 * wobble), (bar.y + dc.hh - dc.top) * (1 - 0.002 * wobble); corner: mix(min(dc.w, dc.hh) / 2, 26 * u, clamp(dc0 * 1.6 - 0.1, 0, 1)); blend: (16 + 20 * dc.bell) * u * min(1, dc0 * 4) * (1 - dc.f); show: dc0 > 0.004 }
            box sdrawer { at: cx, bar.y + ss.hh / 2; size: ss.w * (1 - 0.07 * ds.bell + 0.003 * wobble), ss.hh * (1 - 0.002 * wobble); corner: mix(min(ss.w, ss.hh) / 2, 26 * u, clamp(ds0 * 1.6 - 0.1, 0, 1)); blend: (16 + 20 * ds.bell) * u * min(1, ds0 * 4); show: ds0 > 0.004 }
            box ldrawer { at: cx, (dl.top + bar.y + dl.hh) / 2; size: dl.w * (1 - 0.07 * dl.bell + 0.003 * wobble), (bar.y + dl.hh - dl.top) * (1 - 0.002 * wobble); corner: mix(min(dl.w, dl.hh) / 2, 26 * u, clamp(dl0 * 1.6 - 0.1, 0, 1)); blend: (16 + 20 * dl.bell) * u * min(1, dl0 * 4) * (1 - dl.f); show: dl0 > 0.004 }
            box odrawer { at: cx, bar.y + os.hh / 2; size: os.w * (1 - 0.07 * do.bell + 0.003 * wobble), os.hh * (1 - 0.002 * wobble); corner: mix(min(os.w, os.hh) / 2, 26 * u, clamp(do0 * 1.6 - 0.1, 0, 1)); blend: (16 + 20 * do.bell) * u * min(1, do0 * 4); show: do0 > 0.004 }
            box mdrawer { at: mdx, bar.y + dm.hh / 2; size: dm.w * (1 - 0.07 * dm.bell + 0.003 * wobble), dm.hh * (1 - 0.002 * wobble); corner: mix(min(dm.w, dm.hh) / 2, 26 * u, clamp(dm0 * 1.6 - 0.1, 0, 1)); blend: (16 + 20 * dm.bell) * u * min(1, dm0 * 4); show: dm0 > 0.004 }
        }

        // ── the bar ──────────────────────────────────────────────────
        repeat i in 1..6 {
            //  The others sit 15 apart; the ones beside the active one slide away from it by `room / 2`
            //  each, so the widening one has space, and the row flows as the amounts change.
            let wx = at.ws + (i - 3) * 15 * u + room * 0.5 * clamp(i - pill, -1, 1)
            //  One shape per workspace that morphs: a dot, a taller capsule if it has windows, and a
            //  wide mint pill while it is the active one.
            zone box ws.hit.$i { at: wx, bar.y; size: 15 * u, bar.h; cursor: pointer; active: bs.ws > 0.5 }
            on press ws.hit.$i { emit go(i) }
        }

        //  What is in front: the app in small type above, the title under it, cut
        //  with an ellipsis where the clock starts.
        //  The title gives up room to the controls while something plays.

        //  The whole title area is a button: it opens the controls panel. Declared before
        //  the little player controls below, which sit over it and win where they overlap.
        //  It is only as wide as the text it holds (never past `win.w`, never thinner than a
        //  fingertip), not the whole gap up to the clock. Unseen copies, with no width limit,
        //  only to know how wide the app name and the title really are.
        text win.class { at: floor(win.x + 0.5), floor(bar.y - 6.5 * u + 0.5); anchor: left center; size: 17 * u; weight: 600; lines: 1; measure: clsw; opacity: 0; family: "Space Grotesk" }
        text win.title { at: floor(win.x + 0.5), floor(bar.y + 8.75 * u + 0.5); anchor: left center; size: 13.5 * u; weight: 500; lines: 1; measure: titw; opacity: 0; family: "Space Grotesk" }
        let win.hw = clamp(max(clsw.width, titw.width) + 12 * u, 48 * u, win.w)
        zone box win_hit { at: win.x - 6 * u + win.hw / 2, bar.y; size: win.hw, bar.h; cursor: pointer; active: bs.title > 0.5 }
        on press win_hit { panel = if(panel == player, none, player) }

        // ── the player, small, in the bar ────────────────────────────
        //  While there is a player, playing or paused; they fade in as the title gives them room.
        group {
            opacity: mshow * bs.media
            //  Centred in the gap between where the title ends and where the clock
            //  starts (`mc`), and small: 17 between centres.
            let by = bar.y
            zone box bp.prev { at: mc - 17 * u, by; size: 17 * u, bar.h; cursor: pointer }
            zone box bp.play { at: mc, by; size: 17 * u, bar.h; cursor: pointer }
            zone box bp.next { at: mc + 17 * u, by; size: 17 * u, bar.h; cursor: pointer }
            on press bp.prev { emit mcmd(0) }
            on press bp.play { emit mcmd(1) }
            on press bp.next { emit mcmd(2) }
        }

        zone box set_hit { at: set.x, bar.y; size: 24 * u, bar.h; cursor: pointer }
        on press set_hit { panel = if(panel == settings, none, settings) }

        zone box sr_hit { at: sr.x, bar.y; size: 24 * u, bar.h; cursor: pointer; active: bs.sr > 0.5 }
        on press sr_hit { panel = if(panel == launch, none, launch) }
        zone box ctl_hit { at: ctl.x, bar.y; size: 26 * u, bar.h; cursor: pointer; active: bs.ctl > 0.5 }
        on press ctl_hit { panel = if(panel == controls, none, controls) }

        //  The calendar's button is the clock and a little around it: 4 more at each side.
        zone box bar_hit { at: at.clock, bar.y; size: fw.clock + 8 * u, bar.h; cursor: pointer; active: bs.clock > 0.5 }
        on press bar_hit { panel = if(panel == calendar, none, calendar) }
        //  Right-click closes whatever is open. It also matters for a reason that
        //  has nothing to do with the calendar: pleamar treats an unclaimed right
        //  click, anywhere in a scene that never uses the right button at all, as
        //  an emergency exit and quits outright - which is exactly what looked
        //  like "everything crashes." Claiming it here, once, disarms that for
        //  the whole scene.
        on press right bar_hit { panel = none }
    }

    //  The bar's icons are drawn here, on top of the bar and outside its wave-shader group, with a soft dark
    //  halo (a group `glow` in the palette's dark colour) so they hold up on a light wallpaper, as the text
    //  does. An effect cannot sit inside another effect's group, hence outside. The click areas and rules
    //  stay in the bar group above.
    group {
        glow: 2.4 * u, 45%, deep
        row tray_bar_row {
            at: floor(tr.x - (bartrays.count * 24 - 6) * u / 2 + 0.5), floor(bar.y - 9 * u + 0.5)
            gap: floor(6 * u + 0.5)
            for t in bartrays { BarTray(t, click: bar_tray_click, menu: bar_tray_menu) }
        }
        repeat i in 1..6 {
            let wxs = at.ws + (i - 3) * 15 * u + room * 0.5 * clamp(i - pill, -1, 1)
            box ws.dot.$i { at: wxs, bar.y; size: (6 + 14 * ws.act.$i) * u, (6 + 4 * ws.tall.$i * (1 - ws.act.$i)) * u; corner: 3 * u
                            color: mix(ink, mint, ws.act.$i); opacity: mix(28% + 62% * ws.tall.$i, 100%, ws.act.$i) * bs.ws }
        }
        //  The player's buttons.
        group {
            opacity: mshow * bs.media
            box { at: mc - 20.5 * u, bar.y; size: 1.4 * u, 7 * u; corner: 0.7 * u; color: ink; opacity: 65% + 35% * bp.prev.hover }
            path { at: mc - 17 * u, bar.y; color: ink; opacity: 65% + 35% * bp.prev.hover; move 3 * u, -3.5 * u; line -2.5 * u, 0; line 3 * u, 3.5 * u; close }
            //  Pause while it plays, play while it is paused.
            box { at: mc - 3 * u, bar.y; size: 2.6 * u, 9 * u; corner: 1 * u; color: ink; opacity: 85% + 15% * bp.play.hover; show: media.playing }
            box { at: mc + 3 * u, bar.y; size: 2.6 * u, 9 * u; corner: 1 * u; color: ink; opacity: 85% + 15% * bp.play.hover; show: media.playing }
            path { at: mc, bar.y; color: ink; opacity: 85% + 15% * bp.play.hover; show: not media.playing; move -3 * u, -4.5 * u; line 7 * u, 0; line -3 * u, 4.5 * u; close }
            path { at: mc + 17 * u, bar.y; color: ink; opacity: 65% + 35% * bp.next.hover; move -3 * u, -3.5 * u; line 2.5 * u, 0; line -3 * u, 3.5 * u; close }
            box { at: mc + 20.5 * u, bar.y; size: 1.4 * u, 7 * u; corner: 0.7 * u; color: ink; opacity: 65% + 35% * bp.next.hover }
        }
        //  The settings button: a gear, between the player's buttons and the controls button.
        group {
            opacity: 65% + 35% * max(set_hit.hover, clamp(ds, 0, 1))
            ellipse { at: set.x, bar.y; radius: 3.6 * u; stroke: 1.7 * u; color: mix(ink, mint, clamp(ds, 0, 1)) }
            repeat i in 0..8 {
                group {
                    pivot: set.x, bar.y
                    rotate: i * 45deg
                    box { at: set.x, bar.y - 6 * u; size: 2 * u, 2.6 * u; corner: 0.7 * u; color: mix(ink, mint, clamp(ds, 0, 1)) }
                }
            }
        }
        //  The launcher's button, between the settings button and the controls button: a magnifying glass.
        group {
            opacity: (65% + 35% * max(sr_hit.hover, clamp(dl, 0, 1))) * bs.sr
            ellipse { at: sr.x - 1.2 * u, bar.y - 1.2 * u; radius: 4 * u; stroke: 1.7 * u; color: mix(ink, mint, clamp(dl, 0, 1)) }
            line { from: sr.x + 1.8 * u, bar.y + 1.8 * u; to: sr.x + 5 * u, bar.y + 5 * u; width: 1.9 * u; color: mix(ink, mint, clamp(dl, 0, 1)) }
        }
        //  The controls button, between the settings button and the clock: two sliders.
        group {
            opacity: (65% + 35% * max(ctl_hit.hover, clamp(dk, 0, 1))) * bs.ctl
            box { at: ctl.x, bar.y - 3.5 * u; size: 13 * u, 1.6 * u; corner: 0.8 * u; color: mix(ink, mint, clamp(dk, 0, 1)) }
            box { at: ctl.x, bar.y + 3.5 * u; size: 13 * u, 1.6 * u; corner: 0.8 * u; color: mix(ink, mint, clamp(dk, 0, 1)) }
            ellipse { at: ctl.x + 2.5 * u, bar.y - 3.5 * u; radius: 2.6 * u; color: mix(ink, mint, clamp(dk, 0, 1)) }
            ellipse { at: ctl.x - 2.5 * u, bar.y + 3.5 * u; radius: 2.6 * u; color: mix(ink, mint, clamp(dk, 0, 1)) }
        }
    }

    //  The bar's text is drawn on top of the bar, outside its wave-shader group: inside it the letters are
    //  resampled by the shader, which blurs them and smears them whenever the music makes the wave move.
    //  The glass and the icons still bend; the words stay sharp.
    //  The clock in the bar is four texts, right-aligned and set against each other from their measured widths:
    //  the hour, oversized; the minutes with their colon, in the accent, the two digits tucked 3 px over each
    //  other (the colon is left clear: overlapped it disappears); and, at the edge, a small column: the day
    //  stacked tight over a dim am/pm, centred on each other.
    text bar_date { at: floor(clock.r - clock.col / 2 + 0.5), floor(bar.y - 8 + 0.5); anchor: center; size: 11; weight: 700; measure: cdw; color: faint; opacity: bs.clock; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text bar_ap { at: floor(clock.r - clock.col / 2 + 0.5), floor(bar.y + 7 + 0.5); anchor: center; size: 14; weight: 600; measure: caw; color: faint; opacity: bs.clock; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text clock_mm { at: floor(clock.r - clock.col - 3 + 0.5), floor(bar.y + 3 + 0.5); anchor: right center; size: 26; weight: 700; measure: cmw; letter_move: 3 * ((letters - 1 - letter) - if(letter == 0, 1, 0)), 0; color: mint; opacity: bs.clock; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text clock_h { at: floor(clock.r - clock.col - cmw.width + 0.5), floor(bar.y + 0.5); anchor: right center; size: 40; weight: 700; measure: chw; color: ink; opacity: bs.clock; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text win.class { at: floor(win.x + 0.5), floor(bar.y - 6.5 * u + 0.5); anchor: left center; size: 17 * u; weight: 600; width: win.w; lines: 1; color: faint; opacity: 55% * bs.title; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text win.title { at: floor(win.x + 0.5), floor(bar.y + 8.75 * u + 0.5); anchor: left center; size: 13.5 * u; weight: 500; width: win.w; lines: 1; color: ink; opacity: bs.title; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }

    // ── the panel ────────────────────────────────────────────────
    group {
        //  The calendar's content is clipped to the calendar's shape.
        clip inset 2 box { at: cx, bar.y + dc.hh / 2; size: dc.w, dc.hh; corner: 26 * u }
        //  ── the calendar panel ──
        //  Three plates like the volume and media ones, each 8% white and 12 from the panel's
        //  edges: the time and date, the chosen day with its reminders, and the month. The two
        //  on the left and the one on the right share a top and a bottom.
        group {
            opacity: f1
            move: 0, (1 - f1) * 12 * u + floor(68 * u + 0.5)
            box { at: cx - 130 * u, cy - 76 * u; size: 166 * u, 72 * u; corner: 14 * u; color: ink; opacity: veil }
            box { at: cx - 130 * u, cy + 43 * u; size: 166 * u, 154 * u; corner: 14 * u; color: ink; opacity: veil }
            //  The clock card: big numerals, the am/pm tucked small at their top-right in the accent, and under
            //  them, indented a little, the date as weekday | month day with the pipe in the accent.
            text clock_hm { at: floor(cx - 201 * u + 0.5), floor(cy - 88 * u + 0.5); anchor: left center; size: 56; weight: 700; measure: hmw; color: ink; family: "Space Grotesk" }
            //  The am/pm is a small pill in the accent, vertically centred on the numerals and set against their right side.
            box { at: floor(cx - 201 * u + hmw.width + 8 * u + 17 + 0.5), floor(cy - 88 * u + 0.5); size: 34, 20; corner: 10; color: mint; opacity: 20% }
            text clock_ap { at: floor(cx - 201 * u + hmw.width + 8 * u + 17 + 0.5), floor(cy - 88 * u + 0.5); anchor: center; align: center; size: 12; weight: 700; width: 34; lines: 1; color: mint; family: "Space Grotesk" }
            //  The date is right-aligned to the card's inner edge (cx - 59): the month and day first, then the pipe
            //  and the weekday laid out leftwards from it, each placed from the measured width of the one after.
            text date_md { at: floor(cx - 59 * u + 0.5), floor(cy - 55 * u + 0.5); anchor: right center; size: 12; weight: 700; measure: mdw; color: ink; family: "Space Grotesk" }
            text "|" { at: floor(cx - 59 * u - mdw.width - 8 * u + 0.5), floor(cy - 55 * u + 0.5); anchor: right center; size: 14; weight: 300; color: mint; family: "Space Grotesk" }
            text date_wd { at: floor(cx - 59 * u - mdw.width - 20 * u + 0.5), floor(cy - 55 * u + 0.5); anchor: right center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text cal.sel_title { at: floor(cx - 201 * u + 0.5), floor(cy - 14 * u + 0.5); anchor: left center; size: 13 * u; weight: 600; width: 142 * u; lines: 1; color: ink; family: "Space Grotesk" }
            text cal.sel_sub { at: floor(cx - 201 * u + 0.5), floor(cy + 1 * u + 0.5); anchor: left center; size: 10.5 * u; width: 142 * u; lines: 1; color: faint; opacity: 75%; family: "Space Grotesk" }
            column cal_list {
                at: floor(cx - 207 * u + 0.5), floor(cy + 14 * u + 0.5)
                view: 154 * u, 106 * u
                gap: 4
                for e in cal_events { CalRow(e, tick: cal_check, gone: cal_delete) }
            }
            text "Add one below" { at: floor(cx - 201 * u + 0.5), floor(cy + 28 * u + 0.5); anchor: left center; size: 11.5 * u; color: faint; opacity: 55%; family: "Space Grotesk"; show: cal_events.count < 1 }
        }
        group {
            opacity: f4
            move: 0, (1 - f4) * 12 * u
            let cal.cw = 33 * u
            let cal.ch = 27 * u
            let cal.gx = cx - 13 * u                 // the middle of the first column
            let cal.gy = cy - 42 * u                 // the middle of the first row
            group {
                move: 0, floor(68 * u + 0.5)        // the month sits 68 lower, under the weather strip (a whole number of pixels)
            box { at: cx + 86 * u, cy + 4 * u; size: 254 * u, 232 * u; corner: 14 * u; color: ink; opacity: veil }
            //  Month, and the three buttons that move it.
            text cal.month { at: floor(cx - 30 * u + 0.5), floor(cy - 92 * u + 0.5); anchor: left center; size: 15 * u; weight: 600; color: ink; family: "Space Grotesk" }
            path { at: cx + 134 * u, cy - 92 * u; color: ink; stroke: 1.6 * u; opacity: 55% + 45% * cal_prev_btn.hover; move 2.5 * u, -5 * u; line -2.5 * u, 0; line 2.5 * u, 5 * u }
            box { at: cx + 163 * u, cy - 92 * u; size: 40 * u, 20 * u; corner: 10 * u; color: ink; opacity: 8% + 10% * cal_today_btn.hover }
            text "Today" { at: floor(cx + 163 * u + 0.5), floor(cy - 92 * u + 0.5); anchor: center; size: 10 * u; weight: 600; color: ink; opacity: 80%; family: "Space Grotesk" }
            path { at: cx + 192 * u, cy - 92 * u; color: ink; stroke: 1.6 * u; opacity: 55% + 45% * cal_next_btn.hover; move -2.5 * u, -5 * u; line 2.5 * u, 0; line -2.5 * u, 5 * u }
            zone box cal_prev_btn { at: cx + 134 * u, cy - 92 * u; size: 26 * u, 26 * u; corner: 13 * u; cursor: pointer }
            zone box cal_today_btn { at: cx + 163 * u, cy - 92 * u; size: 42 * u, 24 * u; corner: 12 * u; cursor: pointer }
            zone box cal_next_btn { at: cx + 192 * u, cy - 92 * u; size: 26 * u, 26 * u; corner: 13 * u; cursor: pointer }
            on press cal_prev_btn { emit cal_prev }
            on press cal_today_btn { emit cal_today }
            on press cal_next_btn { emit cal_next }
            //  The weekdays.
            repeat w in 1..8 {
                text cal.wd.$w { at: floor(cal.gx + (w - 1) * cal.cw + 0.5), floor(cy - 66 * u + 0.5); anchor: center; size: 9.5 * u; weight: 600; color: faint; opacity: 65%; family: "Space Grotesk" }
            }
            //  The days.
            repeat k in 0..42 {
                let dx = cal.gx + mod(k, 7) * cal.cw
                let dy = cal.gy + floor(k / 7) * cal.ch
                prop cal.pick.$k = 0 ~lively
                follow cal.pick.$k = if(cal.sel == k, 1, 0)
                group {
                    opacity: 38% + 62% * if(cal.in.$k, 1, 0)
                    pivot: dx, dy
                    scale: 1 + 0.08 * cal.pick.$k
                    ellipse { at: dx, dy; radius: 12 * u; color: ink; opacity: 9% * cal_cell.$k.hover * (1 - cal.pick.$k) }
                    ellipse { at: dx, dy; radius: 12 * u; color: mint; opacity: cal.pick.$k * 100% }
                    group {
                        glow: 5 * u, 60%, mint
                        ellipse { at: dx, dy; radius: 13 * u; stroke: 1.5 * u; color: mint; show: cal.today.$k }
                    }
                    text number(cal.day.$k, 0) { at: floor(dx + 0.5), floor(dy - 0.5 * u + 0.5); anchor: center; size: 11.5 * u; weight: 500 + 200 * if(cal.today.$k, 1, 0)
                                                 color: mix(ink, onmint, cal.pick.$k); family: "Space Grotesk" }
                    ellipse { at: dx, dy + 8.5 * u; radius: 1.5 * u; color: mix(mint, onmint, cal.pick.$k); opacity: if(cal.n.$k > 0, 100%, 0) }
                }
                zone box cal_cell.$k { at: dx, dy; size: 30 * u, 26 * u; corner: 13 * u; cursor: pointer }
                on press cal_cell.$k { emit cal_pick(k) }
            }
            }
            //  The weather, at the very top: what it is now, on the left, and the week, on the right.
            box { at: cx, cy - 82 * u; size: 426 * u, 60 * u; corner: 14 * u; color: ink; opacity: veil }
            text "Loading weather…" { at: floor(cx + 0.5), floor(cy - 82 * u + 0.5); anchor: center; align: center; size: 11.5 * u; width: 300 * u; lines: 1; color: faint; family: "Space Grotesk"; show: not wx_ok }
            group {
                show: wx_ok
                group {
                    pivot: cx - 190 * u, cy - 90 * u
                    scale: 1.5
                    column wx_now { at: cx - 203 * u, cy - 100 * u; WxIcon(wx_kind) }
                }
                text wx_temp { at: floor(cx - 160 * u + 0.5), floor(cy - 92 * u + 0.5); anchor: left center; size: 19 * u; weight: 700; width: 70 * u; lines: 1; color: ink; family: "Space Grotesk" }
                text wx_desc { at: floor(cx - 160 * u + 0.5), floor(cy - 73 * u + 0.5); anchor: left center; size: 10 * u; width: 100 * u; lines: 1; color: faint; family: "Space Grotesk" }
                box { at: cx - 96 * u, cy - 82 * u; size: 1 * u, 40 * u; color: ink; opacity: 12% }
                row wx_row {
                    at: floor(cx - 90 * u + 0.5), floor(cy - 107 * u + 0.5)
                    gap: 1
                    for d in wx_days { WxDay(d) }
                }
            }

            //  Writing one: the field, and a button. Enter saves it as well.
            box { at: cx, cy + 213 * u; size: 426 * u, 34 * u; corner: 14 * u; color: ink; opacity: veil }
            ellipse { at: cx - 201 * u, cy + 213 * u; radius: 4 * u; color: mint; opacity: 85% }
            //  An input's `at` is not its middle: it is lifted 6.3 so its text sits on the row's centre.
            input cal_new { at: floor(cx - 189 * u + 0.5), floor(cy + 206.7 * u + 0.5); width: 330 * u; size: 13 * u; color: ink; family: "Space Grotesk"
                            placeholder: "New reminder: 3:30pm Call mom"; selection: mintlo }
            box { at: cx + 178 * u, cy + 213 * u; size: 46 * u, 24 * u; corner: 12 * u; color: mint; opacity: 80% + 20% * cal_add_btn.hover }
            text "Add" { at: floor(cx + 178 * u + 0.5), floor(cy + 213 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: onmint; family: "Space Grotesk" }
            zone box cal_add_btn { at: cx + 178 * u, cy + 213 * u; size: 48 * u, 28 * u; corner: 14 * u; cursor: pointer }
            on press cal_add_btn { emit cal_add }
        }
        //  Opening the calendar puts the cursor in the field and the grid back on today.
        on change panel while panel == calendar { focus cal_new; emit cal_open }
    }
    //  The controls' content is clipped to the drawer's shape.
    group {
        clip inset 2 box { at: cx, bar.y + dk.hh / 2; size: dk.w, dk.hh; corner: 26 * u }
        //  A plate is a veil, not more glass: glass does not go on glass.
        group {
            opacity: f5 * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f5) * 12 * u
            let vol_cy = ck + (vol_top + 32) * u
            box { at: cx, vol_cy + (vp.h - 64) / 2 * u; size: 288 * u, vp.h * u; corner: 14 * u; color: ink; opacity: veil }
            //  ── the slider ──
            //  The track runs from `sl.x0` for `sl.w`; the pointer is turned into a volume
            //  against those two numbers, so they are written once.
            let sl.x0 = cx - 96 * u
            let sl.w = 222 * u
            let sy = vol_cy + 11 * u
            let th = (16 + 3 * vol_hit.hover) * u          // the track thickens under the pointer
            //  A speaker on the left that says how loud it is: two waves that come and go
            //  with the level, or a slash when it is silenced.
            path { at: cx - 124 * u, sy; color: ink; opacity: 70% + 30% * mute_hit.hover; move 0, -3 * u; line 3.5 * u, -3 * u; line 8 * u, -7 * u; line 8 * u, 7 * u; line 3.5 * u, 3 * u; line 0, 3 * u; close }
            path { at: cx - 124 * u, sy; stroke: 1.5 * u; color: ink; opacity: if(audio.muted, 0, 25% + 75% * clamp(volume_level * 12, 0, 1)); move 11 * u, -3 * u; curve 11 * u, 3 * u via 14 * u, 0 }
            path { at: cx - 124 * u, sy; stroke: 1.5 * u; color: ink; opacity: if(audio.muted, 0, 20% + 80% * clamp((volume_level - 0.35) * 4, 0, 1)); move 14 * u, -6.5 * u; curve 14 * u, 6.5 * u via 20 * u, 0 }
            path { at: cx - 124 * u, sy; stroke: 1.6 * u; color: alert; opacity: if(audio.muted, 100%, 0); move 11 * u, -5 * u; line 20 * u, 5 * u }
            //  The track is a sunken pill with its own thin light on the inside.
            body {
                color: deep
                rim: 9%
                box { at: sl.x0 + sl.w / 2, sy; size: sl.w, th; corner: th / 2 }
            }
            //  The fill is a gradient laid along the whole track, so the more there is, the
            //  brighter its end. It glows a little.
            group {
                glow: 7 * u, 50%, mint
                show: not audio.muted
                body {
                    gradient: sl.x0, 0 to sl.x0 + sl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: sl.x0, sy - th / 2; size: max(0.1, sl.w * volume_level), th; corner: th / 2 }
                }
            }
            body {
                color: off
                rim: 12%
                show: audio.muted
                box { from: sl.x0, sy - th / 2; size: max(0.1, sl.w * volume_level), th; corner: th / 2 }
            }
            //  The zone that takes the click: the whole track and a little more each side
            //  and above and below, so it is easy to hit; on the press and all through a drag
            //  it turns where the pointer is into a volume.
            zone box vol_plate { at: cx, vol_cy + (vp.h - 64) / 2 * u; size: 288 * u, vp.h * u; corner: 14 * u }
            on press right vol_plate { vm_open = not vm_open; dd_open = false }
            zone box vol_hit { at: sl.x0 + sl.w / 2, sy; size: sl.w + 16 * u, 24 * u; cursor: pointer }
            on press vol_hit { emit setvol(clamp((pointer.x - sl.x0) / sl.w, 0, 1)) }
            on press right vol_hit { vm_open = not vm_open; dd_open = false }
            on drag vol_hit { emit setvol(clamp((pointer.x - sl.x0) / sl.w, 0, 1)) }
            //  Three small dots at the foot of the plate say there is more under it: the mixer. They are a button too
            //  (right-clicking the plate does the same).
            repeat i in 0..3 {
                ellipse { at: cx + (i - 1) * 6.5 * u, vol_cy + (vp.h - 36.5) * u; radius: 1.6 * u; color: ink; opacity: (35% + 55% * mix_hit.hover) * (1 - clamp(vm * 1.6, 0, 1)) * clamp(mvis, 0, 1) }
            }
            //  While it is open the dots give way to an arrow pointing up: press it to fold the mixer away.
            path { at: cx, vol_cy + (vp.h - 36.5) * u; stroke: 1.6 * u; color: mint; opacity: (55% + 40% * mix_hit.hover) * clamp(vm * 1.6 - 0.6, 0, 1) * clamp(mvis, 0, 1); move -4.5 * u, 1.8 * u; line 0, -1.8 * u; line 4.5 * u, 1.8 * u }
            zone box mix_hit { at: cx, vol_cy + (vp.h - 36.5) * u; size: 40 * u, 9 * u; corner: 4.5 * u; cursor: pointer; active: mixer.count > 0 or vm_open }
            on press mix_hit { vm_open = not vm_open; dd_open = false }
            on press right mix_hit { vm_open = not vm_open; dd_open = false }
            //  The speaker is a mute button. Declared after the track's zone, which reaches
            //  a little way under it, so the icon wins there.
            zone box mute_hit { at: cx - 114 * u, sy; size: 26 * u, 32 * u; cursor: pointer }
            on press mute_hit { emit mute }
            on press right mute_hit { vm_open = not vm_open; dd_open = false }
            //  The row above the track: which output, and how loud.
            //  Name and chevron are one button, right-aligned next to the percentage: the
            //  name ends where the chevron starts, and the zone is measured from the name.
            //  Unseen copy with no width limit, only to know how wide the name really is.
            text outname { at: floor(cx + 66 * u + 0.5), floor(vol_cy - 14 * u + 0.5); anchor: right center; size: 14 * u; lines: 1; measure: outw; opacity: 0; family: "Space Grotesk" }
            text outname { at: floor(cx + 66 * u + 0.5), floor(vol_cy - 14 * u + 0.5); anchor: right center; align: right; size: 14 * u; width: 130 * u; lines: 1; color: faint; opacity: 65% + 35% * out_hit.hover; family: "Space Grotesk" }
            //  The percentage is centred between the end of the track (cx + 74) and the plate's edge (cx + 158).
            text number(audio.volume * 100, 0, "%") { at: floor(cx + 128 * u + 0.5), floor(vol_cy - 14 * u + 0.5); anchor: right center; size: 16 * u; weight: 600; color: ink; family: "Space Grotesk"; show: not audio.muted }
            text "Muted" { at: floor(cx + 128 * u + 0.5), floor(vol_cy - 14 * u + 0.5); anchor: right center; size: 16 * u; weight: 600; color: faint; family: "Space Grotesk"; show: audio.muted }
            //  The output name is a button: it opens the list of outputs.
            path { at: cx + 76 * u, vol_cy - 14 * u; stroke: 1.4 * u; color: ink; opacity: 55% + 35% * out_hit.hover; move -3.5 * u, -2 * u; line 0, 2 * u; line 3.5 * u, -2 * u }
            let out.w = min(outw.width, 130 * u) + 30 * u
            zone box out_hit { at: cx + 86 * u - out.w / 2, vol_cy - 14 * u; size: out.w, 30 * u; cursor: pointer }
            on press out_hit { toggle dd_open; vm_open = false }
            on press right out_hit { vm_open = not vm_open; dd_open = false }
            text "Volume" { at: floor(cx - 128 * u + 0.5), floor(vol_cy - 14 * u + 0.5); anchor: left center; size: 14 * u; color: faint; family: "Space Grotesk" }
        }

        //  The mixer: every app that is playing, each with a slider of its own, inside the volume card (which grows to hold
        //  them). Right-click the card, or press its dots, to open it.
        group {
            show: vm > 0.01
            opacity: f5 * clamp(1 - expand0, 0, 1) * clamp(vm, 0, 1) * (1 - clamp(dd * 2, 0, 1))
            let mix_top = ck + (vol_top + 58) * u                   // under the slider, inside the card
            clip inset 0 box { at: cx, mix_top + (mix.m - 12) * u * clamp(vm, 0, 1) / 2; size: 288 * u, (mix.m - 12) * u * clamp(vm, 0, 1) }
            text "No app is playing sound" { at: floor(cx + 0.5), floor(mix_top + 12 * u + 0.5); anchor: center; align: center; size: 11 * u; color: faint; family: "Space Grotesk"; show: mixer.count < 1 }
            column mixcol {
                at: floor(cx - 144 * u + 0.5), floor(mix_top + 0.5)
                view: 288 * u, max(1, mixer.count * 32 - 4) * u
                gap: floor(4 * u + 0.5)
                for m in mixer { MixRow(m, set: mix_set, mute: mix_mute) }
            }
        }

        //  Brightness: the volume slider's shape again, in miniature — a sun
        //  that opens its rays as the backlight climbs. Dimmed, not hidden,
        //  on a machine with no backlight to move.
        group {
            opacity: f6 * mix(0.45, 1, brightness.present) * mix(0.45, 1, bright_avail) * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f6) * 12 * u
            let bcy = ck + (bright_top + 32) * u
            box { at: cx, bcy; size: 288 * u, 64 * u; corner: 14 * u; color: ink; opacity: veil }
            let bsl.x0 = cx - 96 * u
            let bsl.w = 222 * u
            let bsy = bcy + 14 * u
            let bth = (16 + 3 * bright_hit.hover) * u
            ellipse { at: cx - 119 * u, bsy; radius: 3 * u; color: ink; opacity: 70% + 30% * bright_hit.hover }
            path { at: cx - 119 * u, bsy; stroke: 1.3 * u; color: ink; opacity: 40% + 60% * bright_level; move -3.8 * u, -3.8 * u; line -(5.5 + 1.5 * bright_level) * u, -(5.5 + 1.5 * bright_level) * u }
            path { at: cx - 119 * u, bsy; stroke: 1.3 * u; color: ink; opacity: 40% + 60% * bright_level; move 3.8 * u, -3.8 * u; line (5.5 + 1.5 * bright_level) * u, -(5.5 + 1.5 * bright_level) * u }
            path { at: cx - 119 * u, bsy; stroke: 1.3 * u; color: ink; opacity: 40% + 60% * bright_level; move -3.8 * u, 3.8 * u; line -(5.5 + 1.5 * bright_level) * u, (5.5 + 1.5 * bright_level) * u }
            path { at: cx - 119 * u, bsy; stroke: 1.3 * u; color: ink; opacity: 40% + 60% * bright_level; move 3.8 * u, 3.8 * u; line (5.5 + 1.5 * bright_level) * u, (5.5 + 1.5 * bright_level) * u }
            body {
                color: deep
                rim: 9%
                box { at: bsl.x0 + bsl.w / 2, bsy; size: bsl.w, bth; corner: bth / 2 }
            }
            group {
                glow: 7 * u, 50%, mint
                body {
                    gradient: bsl.x0, 0 to bsl.x0 + bsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: bsl.x0, bsy - bth / 2; size: max(0.1, bsl.w * bright_level), bth; corner: bth / 2 }
                }
            }
            zone box bright_hit { at: bsl.x0 + bsl.w / 2, bsy; size: bsl.w + 28 * u, 34 * u; cursor: pointer; active: brightness.present and bright_avail }
            on press bright_hit { emit setbright(clamp((pointer.x - bsl.x0) / bsl.w, 0, 1)) }
            on drag bright_hit { emit setbright(clamp((pointer.x - bsl.x0) / bsl.w, 0, 1)) }
            text number(bright_level * 100, 0, "%") { at: floor(cx + 128 * u + 0.5), floor(bcy - 14 * u + 0.5); anchor: right center; size: 16 * u; weight: 600; color: ink; family: "Space Grotesk"; show: brightness.present and bright_avail }
            text "No backlight" { at: floor(cx + 128 * u + 0.5), floor(bcy - 14 * u + 0.5); anchor: right center; size: 13 * u; color: faint; family: "Space Grotesk"; show: not brightness.present }
            text "brightnessctl missing" { at: floor(cx + 128 * u + 0.5), floor(bcy - 14 * u + 0.5); anchor: right center; size: 12 * u; color: faint; family: "Space Grotesk"; show: brightness.present and not bright_avail }
            text "Brightness" { at: floor(cx - 128 * u + 0.5), floor(bcy - 14 * u + 0.5); anchor: left center; size: 14 * u; color: faint; family: "Space Grotesk" }
        }

        //  Wi-Fi and Bluetooth: two narrow tiles side by side, each just its
        //  name, a signal, and the toggle for its radio. Tapping the rest of
        //  the tile - the toggle has its own small zone, declared after so it
        //  wins there - grows it into its own window, below.
        group {
            opacity: f2 * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f2) * 12 * u
            let tile_cy = ck + (tiles_top + tiles_h / 2) * u
            let wtx = cx - 74 * u
            let btx = cx + 74 * u

            box { at: wtx, tile_cy; size: 140 * u, tiles_h * u; corner: 14 * u; color: ink; opacity: veil }
            box { at: wtx - 53 * u, tile_cy - 14 * u; size: 3 * u, 6 * u;  corner: 1.5 * u; color: ink; opacity: if(on_wifi, 45% + 55% * clamp(net.strength / 0.3, 0, 1), 30%) }
            box { at: wtx - 48 * u, tile_cy - 16 * u; size: 3 * u, 10 * u; corner: 1.5 * u; color: ink; opacity: if(on_wifi, 45% + 55% * clamp(net.strength / 0.65, 0, 1), 30%) }
            box { at: wtx - 43 * u, tile_cy - 18 * u; size: 3 * u, 14 * u; corner: 1.5 * u; color: ink; opacity: if(on_wifi, 45% + 55% * clamp(net.strength / 1.0, 0, 1), 30%) }
            text "Wi-Fi" { at: floor(wtx - 58 * u + 0.5), floor(tile_cy + 4 * u + 0.5); anchor: left center; size: 13 * u; color: ink; family: "Space Grotesk" }
            text net.name { at: floor(wtx - 58 * u + 0.5), floor(tile_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; width: 74 * u; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: on_wifi }
            text "Disconnected" { at: floor(wtx - 58 * u + 0.5), floor(tile_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: net.wifi and not (on_wifi) }
            text "Off" { at: floor(wtx - 58 * u + 0.5), floor(tile_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: not net.wifi }
            body {
                color: mix(off, mint, clamp(wifi_on, 0, 1))
                box { at: wtx + 40 * u, tile_cy - 18 * u; size: 38 * u, 22 * u; corner: 11 * u }
            }
            box { at: wtx + 32 * u + wifi_on * 16 * u, tile_cy - 18 * u; size: (17 + 9 * clamp(4 * wifi_on * (1 - wifi_on), 0, 1)) * u, (17 - 3 * clamp(4 * wifi_on * (1 - wifi_on), 0, 1)) * u; corner: (8.5 - 1.5 * clamp(4 * wifi_on * (1 - wifi_on), 0, 1)) * u; color: ink }
            zone box wifi_tile_hit { at: wtx, tile_cy; size: 140 * u, tiles_h * u; cursor: pointer }
            on press wifi_tile_hit { panel_sub = if(panel_sub == netview, none, netview) }
            zone box wifi_toggle_hit { at: wtx + 40 * u, tile_cy - 18 * u; size: 46 * u, 30 * u; cursor: pointer }
            on press wifi_toggle_hit { emit togglewifi(not net.wifi) }

            box { at: btx, tile_cy; size: 140 * u, tiles_h * u; corner: 14 * u; color: ink; opacity: veil }
            box { at: btx - 48 * u, tile_cy - 18 * u; size: 2.4 * u, 16 * u; corner: 1.2 * u; color: ink; opacity: 45% + 55% * bt_on }
            path { at: btx - 48 * u, tile_cy - 18 * u; stroke: 1.5 * u; color: ink; opacity: 45% + 55% * bt_on; move -4 * u, -4 * u; line 4 * u, 4 * u }
            path { at: btx - 48 * u, tile_cy - 18 * u; stroke: 1.5 * u; color: ink; opacity: 45% + 55% * bt_on; move 4 * u, -4 * u; line -4 * u, 4 * u }
            text "Bluetooth" { at: floor(btx - 58 * u + 0.5), floor(tile_cy + 4 * u + 0.5); anchor: left center; size: 13 * u; color: ink; family: "Space Grotesk" }
            text bt_name { at: floor(btx - 58 * u + 0.5), floor(tile_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; width: 74 * u; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: bt_connected }
            text "No device" { at: floor(btx - 58 * u + 0.5), floor(tile_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: bt.powered and not bt_connected }
            text "Off" { at: floor(btx - 58 * u + 0.5), floor(tile_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: not bt.powered }
            body {
                color: mix(off, mint, clamp(bt_on, 0, 1))
                box { at: btx + 40 * u, tile_cy - 18 * u; size: 38 * u, 22 * u; corner: 11 * u }
            }
            box { at: btx + 32 * u + bt_on * 16 * u, tile_cy - 18 * u; size: (17 + 9 * clamp(4 * bt_on * (1 - bt_on), 0, 1)) * u, (17 - 3 * clamp(4 * bt_on * (1 - bt_on), 0, 1)) * u; corner: (8.5 - 1.5 * clamp(4 * bt_on * (1 - bt_on), 0, 1)) * u; color: ink }
            zone box bt_tile_hit { at: btx, tile_cy; size: 140 * u, tiles_h * u; cursor: pointer }
            on press bt_tile_hit { panel_sub = if(panel_sub == btview, none, btview) }
            zone box bt_toggle_hit { at: btx + 40 * u, tile_cy - 18 * u; size: 46 * u, 30 * u; cursor: pointer }
            on press bt_toggle_hit { emit togglebt(not bt.powered) }

            //  Notifications (Do Not Disturb, with its own window) and Caffeine (the whole tile is its toggle), underneath.
            let tile2_cy = ck + (tiles2_top + tiles_h / 2) * u

            box { at: wtx, tile2_cy; size: 140 * u, tiles_h * u; corner: 14 * u; color: ink; opacity: veil + 6% * dnd_hit.hover }
            //  A bell: dome, rim and clapper, struck through while it is on.
            group {
                pivot: wtx - 48 * u, tile2_cy - 18 * u
                rotate: dnd_wobble * 14deg
                //  Solid parts, faded as one group: partial opacity per part shows the overlaps.
                opacity: 45% + 55% * dnd_pill
                ellipse { at: wtx - 48 * u, tile2_cy - 19 * u; radius: 5.5 * u; color: ink }
                box { at: wtx - 48 * u, tile2_cy - 14.5 * u; size: 14 * u, 3 * u; corner: 1.5 * u; color: ink }
                ellipse { at: wtx - 48 * u, tile2_cy - 11 * u; radius: 1.6 * u; color: ink }
            }
            path { at: wtx - 48 * u, tile2_cy - 18 * u; stroke: 1.8 * u; color: alert; opacity: dnd_pill; move -8 * u, -8 * u; line 8 * u, 8 * u }
            text "Notifications" { at: floor(wtx - 58 * u + 0.5), floor(tile2_cy + 4 * u + 0.5); anchor: left center; size: 13 * u; width: 116 * u; lines: 1; color: ink; family: "Space Grotesk" }
            text nt_tile_sub { at: floor(wtx - 58 * u + 0.5), floor(tile2_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; width: 116 * u; lines: 1; color: if(dnd_on, mint, faint); family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(dnd_pill, 0, 1))
                box { at: wtx + 40 * u, tile2_cy - 18 * u; size: 38 * u, 22 * u; corner: 11 * u }
            }
            box { at: wtx + 32 * u + dnd_pill * 16 * u, tile2_cy - 18 * u; size: (17 + 9 * clamp(4 * dnd_pill * (1 - dnd_pill), 0, 1)) * u, (17 - 3 * clamp(4 * dnd_pill * (1 - dnd_pill), 0, 1)) * u; corner: (8.5 - 1.5 * clamp(4 * dnd_pill * (1 - dnd_pill), 0, 1)) * u; color: ink }
            zone box dnd_hit { at: wtx, tile2_cy; size: 140 * u, tiles_h * u; cursor: pointer }
            on press dnd_hit { panel_sub = if(panel_sub == notifview, none, notifview) }
            zone box dnd_toggle_hit { at: wtx + 40 * u, tile2_cy - 18 * u; size: 46 * u, 30 * u; cursor: pointer }
            on press dnd_toggle_hit { emit togglednd }

            //  Caffeine: a cup that steams while the machine is being kept awake. Dimmed on a
            //  machine with no hypridle, which is what the card would be stopping.
            group {
                opacity: mix(0.45, 1, caf_avail)
                box { at: btx, tile2_cy; size: 140 * u, tiles_h * u; corner: 14 * u; color: ink; opacity: veil + 6% * caf_hit.hover * caf_avail }
                group {
                    opacity: 45% + 55% * caf_pill
                    box { at: btx - 49 * u, tile2_cy - 16 * u; size: 12 * u, 10 * u; corner: 3 * u; color: ink }
                    ellipse { at: btx - 41.5 * u, tile2_cy - 16 * u; radius: 3 * u; stroke: 1.5 * u; color: ink }
                }
                repeat i in 0..3 {
                    let sp = fract(time * 0.7 + i * 0.33)
                    box { at: btx - 52 * u + i * 3.5 * u, tile2_cy - 24 * u - sp * 6 * u; size: 1.4 * u, 5 * u; corner: 0.7 * u; color: ink; opacity: caf_pill * 55% * sin(sp * 180) }
                }
                text "Caffeine" { at: floor(btx - 58 * u + 0.5), floor(tile2_cy + 4 * u + 0.5); anchor: left center; size: 13 * u; color: ink; family: "Space Grotesk" }
                text "Awake" { at: floor(btx - 58 * u + 0.5), floor(tile2_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: mint; opacity: 90%; family: "Space Grotesk"; show: caf_on and caf_len == 0 }
                text caf_tile_sub { at: floor(btx - 58 * u + 0.5), floor(tile2_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; width: 74 * u; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: caf_on and caf_len > 0 }
                text "Off" { at: floor(btx - 58 * u + 0.5), floor(tile2_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: not caf_on and caf_avail }
                text "No hypridle" { at: floor(btx - 58 * u + 0.5), floor(tile2_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: not caf_avail }
                body {
                    color: mix(off, mint, clamp(caf_pill, 0, 1))
                    box { at: btx + 40 * u, tile2_cy - 18 * u; size: 38 * u, 22 * u; corner: 11 * u }
                }
                box { at: btx + 32 * u + caf_pill * 16 * u, tile2_cy - 18 * u; size: (17 + 9 * clamp(4 * caf_pill * (1 - caf_pill), 0, 1)) * u, (17 - 3 * clamp(4 * caf_pill * (1 - caf_pill), 0, 1)) * u; corner: (8.5 - 1.5 * clamp(4 * caf_pill * (1 - caf_pill), 0, 1)) * u; color: ink }
                zone box caf_hit { at: btx, tile2_cy; size: 140 * u, tiles_h * u; cursor: pointer; active: caf_avail }
                on press caf_hit { panel_sub = if(panel_sub == cafview, none, cafview) }
                zone box caf_toggle_hit { at: btx + 40 * u, tile2_cy - 18 * u; size: 46 * u, 30 * u; cursor: pointer; active: caf_avail }
                on press caf_toggle_hit { emit togglecaf }
            }
        }

        //  The Wi-Fi tile's own window: the networks in range, strongest first.
        //  A known or open one connects on a tap; a secured one not seen before
        //  asks for its password first.
        group {
            show: showing_sub == netview
            opacity: expand0
            let ex_top = ck + tiles_top * u
            let ex_cy = ex_top + 22 * u
            path { at: cx - 124 * u, ex_cy; color: ink; stroke: 1.6 * u; opacity: 55% + 45% * wifi_back.hover; move 4 * u, -6 * u; line -4 * u, 0; line 4 * u, 6 * u }
            zone box wifi_back { at: cx - 124 * u, ex_cy; size: 30 * u, 30 * u; cursor: pointer }
            on press wifi_back { panel_sub = none }
            text "WI-FI" { at: floor(cx - 102 * u + 0.5), floor(ex_cy + 0.5); anchor: left center; size: 15 * u; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: cx + 112 * u, ex_cy; size: 52 * u, 24 * u; corner: 12 * u; color: if(wifi_scanning, mint, ink); opacity: if(wifi_scanning, 22%, 8% + 10% * wifi_scan_hit.hover) }
            text "Scan" { at: floor(cx + 112 * u + 0.5), floor(ex_cy + 0.5); anchor: center; size: 11 * u; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk"; show: not wifi_scanning }
            //  While it runs: a ring turning where the word was, and the list says so.
            group {
                show: wifi_scanning
                pivot: cx + 112 * u, ex_cy
                rotate: time * 420deg
                arc { at: cx + 112 * u, ex_cy; radius: 6 * u; span: 260deg; width: 1.8 * u; color: mint }
            }
            zone box wifi_scan_hit { at: cx + 112 * u, ex_cy; size: 54 * u, 26 * u; corner: 13 * u; cursor: pointer }
            on press wifi_scan_hit { emit wifi_scan }
            box { at: cx, ex_top + 44 * u; size: 276 * u, 1 * u; color: ink; opacity: 8% }
            column wifi_list_col ~quick {
                at: floor(cx - 138 * u + 0.5), floor(ex_top + 54 * u + 0.5)
                view: 276 * u, list_view_h * u
                gap: 5
                for n in wifi_nets { WifiRow(n, pick: wifi_pick, forget: wifi_forget, joingo: wifi_join_go) }
            }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: cx + 141 * u, ex_top + 54 * u + wifi_list_col.scroll / max(wifi_list_col.content, 1) * (list_view_h * u); size: 3 * u, (list_view_h * u) * (list_view_h * u) / max(wifi_list_col.content, list_view_h * u); corner: 1.5 * u; color: ink; opacity: if(wifi_list_col.content > (list_view_h * u) + 1, 35%, 0%) }
            text "No networks in range" { at: floor(cx + 0.5), floor(ex_top + 54 * u + 15 * u + 0.5); anchor: center; size: 12 * u; color: faint; family: "Space Grotesk"; show: wifi_nets.count < 1 and not wifi_scanning }
            text "Scanning…" { at: floor(cx + 0.5), floor(ex_top + 54 * u + 15 * u + 0.5); anchor: center; size: 12 * u; color: mint; family: "Space Grotesk"; show: wifi_nets.count < 1 and wifi_scanning }
        }

        //  The Bluetooth tile's own window: paired and nearby devices, connected first.
        group {
            show: showing_sub == btview
            opacity: expand0
            let ex2_top = ck + tiles_top * u
            let ex2_cy = ex2_top + 22 * u
            path { at: cx - 124 * u, ex2_cy; color: ink; stroke: 1.6 * u; opacity: 55% + 45% * bt_back.hover; move 4 * u, -6 * u; line -4 * u, 0; line 4 * u, 6 * u }
            zone box bt_back { at: cx - 124 * u, ex2_cy; size: 30 * u, 30 * u; cursor: pointer }
            on press bt_back { panel_sub = none }
            text "BLUETOOTH" { at: floor(cx - 102 * u + 0.5), floor(ex2_cy + 0.5); anchor: left center; size: 15 * u; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: cx + 112 * u, ex2_cy; size: 52 * u, 24 * u; corner: 12 * u; color: if(bt_scanning, mint, ink); opacity: if(bt_scanning, 22%, 8% + 10% * bt_scan_hit.hover) }
            text "Scan" { at: floor(cx + 112 * u + 0.5), floor(ex2_cy + 0.5); anchor: center; size: 11 * u; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk"; show: not bt_scanning }
            //  While it runs: a ring turning where the word was, and the list says so.
            group {
                show: bt_scanning
                pivot: cx + 112 * u, ex2_cy
                rotate: time * 420deg
                arc { at: cx + 112 * u, ex2_cy; radius: 6 * u; span: 260deg; width: 1.8 * u; color: mint }
            }
            zone box bt_scan_hit { at: cx + 112 * u, ex2_cy; size: 54 * u, 26 * u; corner: 13 * u; cursor: pointer }
            on press bt_scan_hit { emit bt_scan }
            box { at: cx, ex2_top + 44 * u; size: 276 * u, 1 * u; color: ink; opacity: 8% }
            column bt_list_col ~quick {
                at: floor(cx - 138 * u + 0.5), floor(ex2_top + 54 * u + 0.5)
                view: 276 * u, list_view_h * u
                gap: 5
                for d in bt_devices { BtRow(d, pick: bt_pick, forget: bt_forget) }
            }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: cx + 141 * u, ex2_top + 54 * u + bt_list_col.scroll / max(bt_list_col.content, 1) * (list_view_h * u); size: 3 * u, (list_view_h * u) * (list_view_h * u) / max(bt_list_col.content, list_view_h * u); corner: 1.5 * u; color: ink; opacity: if(bt_list_col.content > (list_view_h * u) + 1, 35%, 0%) }
            text "No devices found" { at: floor(cx + 0.5), floor(ex2_top + 54 * u + 15 * u + 0.5); anchor: center; size: 12 * u; color: faint; family: "Space Grotesk"; show: bt_devices.count < 1 and not bt_scanning }
            text "Scanning…" { at: floor(cx + 0.5), floor(ex2_top + 54 * u + 15 * u + 0.5); anchor: center; size: 12 * u; color: mint; family: "Space Grotesk"; show: bt_devices.count < 1 and bt_scanning }
        }

        //  The notifications window: Do Not Disturb (a toggle, and timer chips that count down), and under them
        //  the history of what came in, newest first. Clear empties it; a row's cross removes that one.
        group {
            show: showing_sub == notifview
            opacity: expand0
            let nx_top = ck + tiles_top * u
            let nx_cy = nx_top + 22 * u
            path { at: cx - 124 * u, nx_cy; color: ink; stroke: 1.6 * u; opacity: 55% + 45% * nt_back.hover; move 4 * u, -6 * u; line -4 * u, 0; line 4 * u, 6 * u }
            zone box nt_back { at: cx - 124 * u, nx_cy; size: 30 * u, 30 * u; cursor: pointer }
            on press nt_back { panel_sub = none }
            text "NOTIFICATIONS" { at: floor(cx - 102 * u + 0.5), floor(nx_cy + 0.5); anchor: left center; size: 15 * u; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: cx + 112 * u, nx_cy; size: 52 * u, 24 * u; corner: 12 * u; color: ink; opacity: 8% + 10% * nt_clear_hit.hover }
            text "Clear" { at: floor(cx + 112 * u + 0.5), floor(nx_cy + 0.5); anchor: center; size: 11 * u; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box nt_clear_hit { at: cx + 112 * u, nx_cy; size: 54 * u, 26 * u; corner: 13 * u; cursor: pointer }
            on press nt_clear_hit { emit nt_clear }
            box { at: cx, nx_top + 44 * u; size: 276 * u, 1 * u; color: ink; opacity: 8% }

            //  Do Not Disturb: its toggle, and what state it is in.
            box { at: cx, nx_top + 66 * u; size: 276 * u, 34 * u; corner: 12 * u; color: ink; opacity: veil }
            text "Do Not Disturb" { at: floor(cx - 128 * u + 0.5), floor(nx_top + 60 * u + 0.5); anchor: left center; size: 12.5 * u; weight: 700; color: ink; family: "Space Grotesk" }
            text dnd_left { at: floor(cx - 128 * u + 0.5), floor(nx_top + 74 * u + 0.5); anchor: left center; size: 10 * u; width: 200 * u; lines: 1; color: if(dnd_on, mint, faint); family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(dnd_pill, 0, 1))
                box { at: cx + 118 * u, nx_top + 66 * u; size: 30 * u, 16 * u; corner: 8 * u }
            }
            ellipse { at: cx + 111 * u + dnd_pill * 14 * u, nx_top + 66 * u; radius: 6.2 * u; color: ink }
            zone box nt_dnd_toggle { at: cx + 118 * u, nx_top + 66 * u; size: 40 * u, 26 * u; corner: 13 * u; cursor: pointer }
            on press nt_dnd_toggle { emit togglednd }

            //  The timer: pressing a chip silences for that long; pressing the lit one again cancels it.
            repeat i in 0..4 {
                let chx = cx - 107 * u + i * 70 * u
                box { at: chx, nx_top + 100 * u; size: 62 * u, 26 * u; corner: 13 * u; color: if(dnd_len == pick(i, 15, 30, 60, 120), mint, ink); opacity: if(dnd_len == pick(i, 15, 30, 60, 120), 24%, 8% + 10% * dnd_chip.$i.hover) }
                text pick(i, "15 min", "30 min", "1 hour", "2 hours") { at: floor(chx + 0.5), floor(nx_top + 100 * u + 0.5); anchor: center; align: center; size: 11 * u; weight: 600; width: 60 * u; lines: 1; color: if(dnd_len == pick(i, 15, 30, 60, 120), mint, ink); family: "Space Grotesk" }
                zone box dnd_chip.$i { at: chx, nx_top + 100 * u; size: 64 * u, 28 * u; corner: 14 * u; cursor: pointer }
                on press dnd_chip.$i { emit dnd_for(pick(i, 15, 30, 60, 120)) }
            }

            //  The history.
            text "HISTORY" { at: floor(cx - 134 * u + 0.5), floor(nx_top + 126 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; opacity: 80%; family: "Space Grotesk" }
            column nt_hist_col {
                at: floor(cx - 138 * u + 0.5), floor(nx_top + 138 * u + 0.5)
                view: 276 * u, list_view_h * u
                gap: 6
                for h in nt_hist { NtHistRow(h, del: nt_hist_del) }
            }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: cx + 141 * u, nx_top + 138 * u + nt_hist_col.scroll / max(nt_hist_col.content, 1) * (list_view_h * u); size: 3 * u, (list_view_h * u) * (list_view_h * u) / max(nt_hist_col.content, list_view_h * u); corner: 1.5 * u; color: ink; opacity: if(nt_hist_col.content > (list_view_h * u) + 1, 35%, 0%) }
            text "No notifications yet" { at: floor(cx + 0.5), floor(nx_top + 138 * u + 20 * u + 0.5); anchor: center; size: 12 * u; color: faint; family: "Space Grotesk"; show: nt_hist.count < 1 }
        }

        //  The Caffeine window: the keep-awake switch and what state it is in, and timer chips. A chip keeps the
        //  machine awake for that long and then lets it sleep again; the lit one, pressed again, turns it off.
        group {
            show: showing_sub == cafview
            opacity: expand0
            let kx_top = ck + tiles_top * u
            let kx_cy = kx_top + 22 * u
            path { at: cx - 124 * u, kx_cy; color: ink; stroke: 1.6 * u; opacity: 55% + 45% * caf_back.hover; move 4 * u, -6 * u; line -4 * u, 0; line 4 * u, 6 * u }
            zone box caf_back { at: cx - 124 * u, kx_cy; size: 30 * u, 30 * u; cursor: pointer }
            on press caf_back { panel_sub = none }
            text "CAFFEINE" { at: floor(cx - 102 * u + 0.5), floor(kx_cy + 0.5); anchor: left center; size: 15 * u; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: cx, kx_top + 44 * u; size: 276 * u, 1 * u; color: ink; opacity: 8% }

            group {
                opacity: mix(0.45, 1, caf_avail)
                box { at: cx, kx_top + 66 * u; size: 276 * u, 34 * u; corner: 12 * u; color: ink; opacity: veil }
                text "Keep awake" { at: floor(cx - 128 * u + 0.5), floor(kx_top + 60 * u + 0.5); anchor: left center; size: 12.5 * u; weight: 700; color: ink; family: "Space Grotesk" }
                text caf_left { at: floor(cx - 128 * u + 0.5), floor(kx_top + 74 * u + 0.5); anchor: left center; size: 10 * u; width: 200 * u; lines: 1; color: if(caf_on, mint, faint); family: "Space Grotesk" }
                body {
                    color: mix(off, mint, clamp(caf_pill, 0, 1))
                    box { at: cx + 118 * u, kx_top + 66 * u; size: 30 * u, 16 * u; corner: 8 * u }
                }
                ellipse { at: cx + 111 * u + caf_pill * 14 * u, kx_top + 66 * u; radius: 6.2 * u; color: ink }
                zone box caf_toggle2 { at: cx + 118 * u, kx_top + 66 * u; size: 40 * u, 26 * u; corner: 13 * u; cursor: pointer; active: caf_avail }
                on press caf_toggle2 { emit togglecaf }

                //  Two lines of three chips.
                repeat i in 0..6 {
                    let chx = cx + (mod(i, 3) - 1) * 94 * u
                    let chy = kx_top + 100 * u + floor(i / 3) * 32 * u
                    let lit = caf_on and caf_len == pick(i, 15, 30, 60, 120, 240, 0)
                    box { at: chx, chy; size: 88 * u, 26 * u; corner: 13 * u; color: if(lit, mint, ink); opacity: if(lit, 24%, 8% + 10% * caf_chip.$i.hover) }
                    text pick(i, "15 min", "30 min", "1 hour", "2 hours", "4 hours", "Until off") { at: floor(chx + 0.5), floor(chy + 0.5); anchor: center; align: center; size: 11 * u; weight: 600; width: 84 * u; lines: 1; color: if(lit, mint, ink); opacity: if(lit, 100%, 85%); family: "Space Grotesk" }
                    zone box caf_chip.$i { at: chx, chy; size: 90 * u, 28 * u; corner: 14 * u; cursor: pointer; active: caf_avail }
                    on press caf_chip.$i { emit caf_for(pick(i, 15, 30, 60, 120, 240, 0)) }
                }
            }
        }

        //  The dropdown: a solid card that drops from the volume row over what is
        //  below it. Declared last so its rows win the press over the slider.
        group {
            opacity: dd
            move: 0, (1 - dd) * -8 * u
            let ddn = clamp(outlist.count, 1, 6)
            let ddh = ddn * 30 * u + 12 * u
            box { at: cx, ck + (vol_top + 32) * u + ddh / 2; size: 288 * u, ddh; corner: 14 * u; color: panel }
            zone box dd_block { at: cx, ck + (vol_top + 32) * u + ddh / 2; size: 288 * u, ddh; active: dd > 0.05 }
            column dd_list {
                at: floor(cx - 138 * u + 0.5), floor(ck + (vol_top + 32) * u + 6 * u + 0.5)
                gap: 3
                for o in outlist { OutRow(o, pick: pick_out) }
            }
            text "No outputs" { at: floor(cx + 0.5), floor(ck + (vol_top + 32) * u + ddh / 2 + 0.5); anchor: center; size: 12 * u; color: faint; family: "Space Grotesk"; show: outlist.count < 1 }
        }
    }
    //  The player's panel: it hangs from the window title, not from the middle of the bar, in
    //  the same glass as the bar. Its content is clipped to the drawer's shape.
    group {
        clip inset 2 box { at: mdx, bar.y + dm.hh / 2; size: dm.w, dm.hh; corner: 26 * u }
        //  The player. A sliver with nothing playing — a note and a word, the same
        //  shape as the Wi-Fi and Bluetooth rows below it — that grows into the full
        //  card (cover, song, transport, equalizer) the moment something does.
        //  `media_open` is what moves; `media_h`, above, already reads it, so every
        //  plate under this one is already where it should be.
        group {
            show: dm_mode == dmm_player
            opacity: f3
            move: 0, (1 - f3) * 12 * u
            let my = ck + (media_top + media_h / 2) * u
            let ax = mdx - 96 * u                     // the cover's centre
            let ny = my + 26 * u                     // the controls' row
            let px = mdx - 30 * u                     // previous
            let cxp = mdx + 6 * u                     // play
            let nx = mdx + 42 * u                     // next
            let sw = clamp(swap, 0, 1.12)

            //  The plate is exactly the volume plate: the same 8% veil and the same corners.
            box { at: mdx, my; size: 288 * u, media_h * u; corner: 14 * u; color: ink; opacity: veil }

            //  Idle: a note, the way Wi-Fi and Bluetooth say their own name at rest.
            group {
                opacity: 1 - media_open
                //  A note with a flag: solid parts, faded together so the overlaps do not show.
                group {
                    opacity: 70%
                    ellipse { at: mdx - 124 * u + 1.5, my + 5 * u; radius: 4.5 * u; color: ink }
                    box { at: mdx - 118.5 * u - 1.5, my - 1 * u; size: 2 * u, 18 * u; corner: 1 * u; color: ink }
                    path { at: mdx - 118.5 * u - 1.5, my - 10 * u; stroke: 2 * u; color: ink; move 0, 0.5 * u; curve 6 * u, 8 * u via 6.5 * u, 2.5 * u }
                }
                text "Media" { at: floor(mdx - 96 * u + 0.5), floor(my - 8 * u + 0.5); anchor: left center; size: 14 * u; color: ink; family: "Space Grotesk" }
                text "Nothing playing" { at: floor(mdx - 96 * u + 0.5), floor(my + 8 * u + 0.5); anchor: left center; size: 12 * u; color: faint; family: "Space Grotesk" }
            }

            //  Playing, or paused with something loaded: the full card.
            group {
                opacity: media_open

                //  No cover yet: a tile with a note on it.
                group {
                    show: not art_on
                    body {
                        gradient: ax - 36 * u, my - 36 * u to ax + 36 * u, my + 36 * u, off, deep
                        rim: 14%
                        box { at: ax, my; size: 72 * u, 72 * u; corner: 15 * u }
                    }
                    ellipse { at: ax - 6 * u, my + 11 * u; radius: 6.5 * u; color: ink; opacity: 75% }
                    box { at: ax + 1.5 * u, my - 4 * u; size: 3 * u, 30 * u; corner: 1.5 * u; color: ink; opacity: 75% }
                    path { at: ax, my; stroke: 3 * u; color: ink; opacity: 75%; move 3 * u, -19 * u; curve 15 * u, -6 * u via 13 * u, -17 * u }
                }

                //  The cover, in a rounded tile.
                group {
                    glow: 12 * u, 60%
                    saturation: 0.3 + 0.7 * playf
                    pivot: ax, my
                    scale: (0.88 + 0.12 * playf) * (0.7 + 0.3 * sw)
                    rotate: (1 - sw) * -12deg
                    opacity: art_on
                    group {
                        clip inset 0 box { at: ax, my; size: 72 * u, 72 * u; corner: 15 * u }
                        image art { at: ax - 36 * u, my - 36 * u; size: 72 * u, 72 * u }
                    }
                }

                text media.title { at: floor(mdx - 50 * u + 0.5), floor(my - 24 * u + 0.5); anchor: left center; size: 14.5 * u; weight: 700; width: 186 * u; lines: 1; color: ink; family: "Space Grotesk" }
                text media.artist { at: floor(mdx - 50 * u + 0.5), floor(my - 6 * u + 0.5); anchor: left center; size: 12 * u; width: 186 * u; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk" }

                //  previous
                box { at: px - 6 * u, ny; size: 2.2 * u, 12 * u; corner: 1.1 * u; color: ink; opacity: 75% + 25% * mp.prev.hover }
                path { at: px, ny; color: ink; opacity: 75% + 25% * mp.prev.hover; move 5 * u, -6 * u; line -4.5 * u, 0; line 5 * u, 6 * u; close }
                //  play / pause: a white disc with the mark cut out of it
                ellipse { at: cxp, ny; radius: (15 + 1.5 * mp.play.hover) * u; color: ink; opacity: 95% }
                path { at: cxp, ny; color: onmint; show: not media.playing; move -4 * u, -8 * u; line 8 * u, 0; line -4 * u, 8 * u; close }
                box { at: cxp - 4 * u, ny; size: 4 * u, 14 * u; corner: 1.5 * u; color: onmint; show: media.playing }
                box { at: cxp + 4 * u, ny; size: 4 * u, 14 * u; corner: 1.5 * u; color: onmint; show: media.playing }
                //  next
                path { at: nx, ny; color: ink; opacity: 75% + 25% * mp.next.hover; move -5 * u, -6 * u; line 4.5 * u, 0; line -5 * u, 6 * u; close }
                box { at: nx + 6 * u, ny; size: 2.2 * u, 12 * u; corner: 1.1 * u; color: ink; opacity: 75% + 25% * mp.next.hover }

                zone box mp.prev { at: px, ny; size: 30 * u, 34 * u; cursor: pointer }
                zone box mp.play { at: cxp, ny; size: 38 * u, 38 * u; cursor: pointer }
                zone box mp.next { at: nx, ny; size: 30 * u, 34 * u; cursor: pointer }
                on press mp.prev { emit mcmd(0) }
                on press mp.play { emit mcmd(1) }
                on press mp.next { emit mcmd(2) }

                //  The equalizer: six rounded bars to the right of the controls, standing on the
                //  same line as the bottom of the cover. They only show while it plays.
                repeat i in 0..6 {
                    let bx = mdx + 74 * u + i * 12 * u
                    let bh = (3.5 + 31 * spec.s.$i) * u
                    box { at: bx, my + 36 * u - bh / 2; size: 7 * u, bh; corner: 3.5 * u; color: mix(mint, ink, spec.s.$i)
                          opacity: playf * (55% + 45% * spec.s.$i) }
                }
            }

            //  A new song throws sparks off the cover.
            particles { at: ax, my; count: 36; life: 0.5s .. 1.0s; speed: 70 .. 170; direction: 0deg; spread: 360deg; gravity: 0, 40; drag: 1.2; size: 3.5, 1; colors: mint, ink; shape: spark; burst: trackchange }
        }

        //  ── the running windows ──
        group {
            show: dm_mode == dmm_player
            opacity: f3
            move: 0, (1 - f3) * 12 * u
            text "No active windows" { at: floor(mdx + 0.5), floor(ck + tasks_list * u + 16 * u + 0.5); anchor: center; size: 12 * u; color: faint; family: "Space Grotesk"; show: tasks.count < 1 }
            column task_col {
                at: floor(mdx - 144 * u + 0.5), floor(ck + tasks_list * u + 0.5)
                view: 288 * u, (task_rows * 40 - 4) * u
                gap: floor(4 * u + 0.5)
                for w in tasks { TaskRow(w, focus: task_focus, kill: task_close) }
            }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: mdx + 147 * u, ck + tasks_list * u + task_col.scroll / max(task_col.content, 1) * ((task_rows * 40 - 4) * u); size: 3 * u, ((task_rows * 40 - 4) * u) * ((task_rows * 40 - 4) * u) / max(task_col.content, (task_rows * 40 - 4) * u); corner: 1.5 * u; color: ink; opacity: if(task_col.content > ((task_rows * 40 - 4) * u) + 1, 35%, 0%) }
            //  The apps that only live in the tray: no window to list, so they get their own section.
            group {
                show: trays.count > 0
                text "BACKGROUND APPS" { at: floor(mdx - 138 * u + 0.5), floor(ck + tray_top * u + 11 * u + 0.5); anchor: left center; size: 13.5 * u; weight: 700; color: ink; family: "Space Grotesk" }
                column tray_col {
                    at: floor(mdx - 144 * u + 0.5), floor(ck + tray_list * u + 0.5)
                    view: 288 * u, (max(1, tray_rows) * 40 - 4) * u
                    gap: floor(4 * u + 0.5)
                    for a in trays { TrayRow(a, click: tray_click, pin: tray_pin, menu: tray_menu_open) }
                }
                //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
                box { from: mdx + 147 * u, ck + tray_list * u + tray_col.scroll / max(tray_col.content, 1) * ((max(1, tray_rows) * 40 - 4) * u); size: 3 * u, ((max(1, tray_rows) * 40 - 4) * u) * ((max(1, tray_rows) * 40 - 4) * u) / max(tray_col.content, (max(1, tray_rows) * 40 - 4) * u); corner: 1.5 * u; color: ink; opacity: if(tray_col.content > ((max(1, tray_rows) * 40 - 4) * u) + 1, 35%, 0%) }
                //  What the bar shows of them: every app, or only the pinned ones.
                box { at: mdx + 96 * u, ck + tray_top * u + 11 * u; size: 86 * u, 20 * u; corner: 10 * u; color: if(tray_only_pinned, mint, ink); opacity: if(tray_only_pinned, 22%, 8% + 10% * tray_mode_hit.hover) }
                text "Bar: pinned" { at: floor(mdx + 96 * u + 0.5), floor(ck + tray_top * u + 11 * u + 0.5); anchor: center; align: center; size: 10 * u; weight: 600; width: 82 * u; lines: 1; color: mint; show: tray_only_pinned; family: "Space Grotesk" }
                text "Bar: all" { at: floor(mdx + 96 * u + 0.5), floor(ck + tray_top * u + 11 * u + 0.5); anchor: center; align: center; size: 10 * u; weight: 600; width: 82 * u; lines: 1; color: ink; opacity: 85%; show: not tray_only_pinned; family: "Space Grotesk" }
                zone box tray_mode_hit { at: mdx + 96 * u, ck + tray_top * u + 11 * u; size: 88 * u, 22 * u; corner: 11 * u; cursor: pointer }
                on press tray_mode_hit { emit tray_mode }
            }
        }

        //  ── a tray app's menu ──
        group {
            show: dm_mode == dmm_tray
            opacity: f3
            move: 0, (1 - f3) * 12 * u
            let ty = ck + 34 * u                           // the app plate's middle
            box { at: mdx, ty; size: 288 * u, 52 * u; corner: 14 * u; color: ink; opacity: veil }
            image tm_icon { at: floor(mdx - 132 * u + 0.5), floor(ty - 15 * u + 0.5); size: floor(30 * u + 0.5), floor(30 * u + 0.5) }
            text tm_title { at: floor(mdx - 94 * u + 0.5), floor(ty - 8 * u + 0.5); anchor: left center; size: 13.5 * u; weight: 700; width: 170 * u; lines: 1; color: ink; family: "Space Grotesk" }
            text tm_sub { at: floor(mdx - 94 * u + 0.5), floor(ty + 9 * u + 0.5); anchor: left center; size: 10.5 * u; width: 170 * u; lines: 1; color: faint; family: "Space Grotesk" }
            //  The pin: a thumbtack, filled while the app is kept on the bar.
            ellipse { at: mdx + 122 * u, ty; radius: 14 * u; color: ink; opacity: 6% + 10% * tm_pin_hit.hover }
            ellipse { at: mdx + 122 * u, ty - 3 * u; radius: 4 * u; color: mix(ink, mint, if(tm_pinned, 1, 0)); opacity: if(tm_pinned, 100%, 0%) }
            ellipse { at: mdx + 122 * u, ty - 3 * u; radius: 4 * u; stroke: 1.4 * u; color: mix(ink, mint, if(tm_pinned, 1, 0)); opacity: if(tm_pinned, 0%, 70%) }
            line { from: mdx + 122 * u, ty + 1 * u; to: mdx + 122 * u, ty + 7 * u; width: 1.5 * u; color: mix(ink, mint, if(tm_pinned, 1, 0)); opacity: if(tm_pinned, 100%, 70%) }
            zone box tm_pin_hit { at: mdx + 122 * u, ty; size: 28 * u, 28 * u; corner: 14 * u; cursor: pointer }
            on press tm_pin_hit { emit tm_pin }
            //  Open and Alt: what a left and a middle click on its icon would do.
            box { at: mdx - 71 * u, ck + 79 * u; size: 138 * u, 26 * u; corner: 9 * u; color: ink; opacity: 8% + 10% * tm_open_hit.hover }
            text "Open" { at: floor(mdx - 71 * u + 0.5), floor(ck + 79 * u + 0.5); anchor: center; align: center; size: 11 * u; weight: 600; width: 130 * u; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box tm_open_hit { at: mdx - 71 * u, ck + 79 * u; size: 140 * u, 28 * u; corner: 9 * u; cursor: pointer }
            on press tm_open_hit { emit tm_open }
            box { at: mdx + 71 * u, ck + 79 * u; size: 138 * u, 26 * u; corner: 9 * u; color: ink; opacity: 8% + 10% * tm_alt_hit.hover }
            text "Alt" { at: floor(mdx + 71 * u + 0.5), floor(ck + 79 * u + 0.5); anchor: center; align: center; size: 11 * u; weight: 600; width: 130 * u; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box tm_alt_hit { at: mdx + 71 * u, ck + 79 * u; size: 140 * u, 28 * u; corner: 9 * u; cursor: pointer }
            on press tm_alt_hit { emit tm_alt }
            //  Its menu.
            text "This app provides no menu." { at: floor(mdx + 0.5), floor(ck + 115 * u + 0.5); anchor: center; size: 12 * u; color: faint; family: "Space Grotesk"; show: not tm_has_menu }
            column tm_col {
                at: floor(mdx - 144 * u + 0.5), floor(ck + 100 * u + 0.5)
                view: 288 * u, tm.list * u
                gap: floor(2 * u + 0.5)
                for r in tray_menu { TmRow(r, pick: tray_menu_pick) }
            }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: mdx + 147 * u, ck + 100 * u + tm_col.scroll / max(tm_col.content, 1) * (tm.list * u); size: 3 * u, (tm.list * u) * (tm.list * u) / max(tm_col.content, tm.list * u); corner: 1.5 * u; color: ink; opacity: if(tm_col.content > (tm.list * u) + 1, 35%, 0%) }
        }

    }
    //  The volume and notification drawer's content, clipped to its shape. Both sit on one plate
    //  (the same 8% veil as the others), 12 in from the drawer's edge; `osd_kind` picks which is drawn.
    group {
        clip inset 2 box { at: cx, bar.y + os.hh / 2; size: os.w, os.hh; corner: 26 * u }
        opacity: fo
        move: 0, (1 - fo) * 12 * u
        let oy = ck + (8 + osd_h / 2) * u                 // the plate's middle
        let ot = ck + 8 * u                               // and its top
        box { at: cx, oy; size: 316 * u, osd_h * u; corner: 14 * u; color: ink; opacity: veil }
        //  A press on the plate takes the drawer down (a notification is dismissed with it). Declared
        //  first, so the cross and the buttons above it win where they overlap.
        zone box os_hit { at: cx, oy; size: 316 * u, osd_h * u; corner: 14 * u; cursor: pointer }
        on press os_hit while osd_kind == vol { panel = none }
        on press os_hit while osd_kind == note { emit nt_close }

        // ── the volume ──
        group {
            opacity: okv
            show: okv > 0.01
            let vy = oy
            let vtx = cx - 128 * u                        // the face's tile
            box { at: vtx, vy; size: 44 * u, 44 * u; corner: 12 * u; color: ink; opacity: 6% }
            //  The same little face as the slider had in Synoptik: two eyes, and a mouth that opens
            //  with the level and flattens when muted. It bobs a little.
            group {
                move: 0, -1.5 * u * (0.5 + 0.5 * sin(time * 200))
                box { at: vtx - 6 * u, vy - 5 * u; size: 5 * u, if(audio.muted, 2, 5) * u; corner: 2 * u; color: if(audio.muted, faint, mint) }
                box { at: vtx + 6 * u, vy - 5 * u; size: 5 * u, if(audio.muted, 2, 5) * u; corner: 2 * u; color: if(audio.muted, faint, mint) }
                box { at: vtx, vy + 6 * u; size: if(audio.muted, 11, 7 + volume_level * 12) * u, if(audio.muted, 2, 5 + volume_level * 5) * u; corner: 2.5 * u; color: if(audio.muted, faint, mint) }
            }
            //  The level is a wave: it ripples as far as the volume goes, and the rest of the track is
            //  a flat, faint line. A tall white pill marks the end.
            let tr0 = cx - 96 * u
            let trw = 170 * u
            let span = trw * volume_level
            //  All 48 pieces of the wave are spread over the level's own length, so a short one is drawn as
            //  smoothly as a long one (spread over the whole track, only a handful would fall inside it).
            let seg = max(span, 1) / 48
            //  The wave is always the same number of S-curves (two and a half), spread over however
            //  long the level is: at 100% they are long and lazy, and as the volume drops the whole
            //  thing is squeezed toward the left, the curves getting tighter and steeper. `wf` is
            //  the ripple's frequency, in degrees a pixel (sin takes degrees), for the length it has to fit. It fades to flat over a tenth of
            //  its length at each end, so it always meets the flat line and the pill.
            let wf = 360 * 2.5 / max(span, 1)
            let wa = 4.5 * u
            let f0 = max(0.001, span * 0.1)
            let f1 = max(0.001, span * 0.12)
            repeat i in 0..48 {
                let xa = tr0 + i * seg
                let xb = xa + seg
                //  The ripple dies away to nothing at both ends, so wherever it is in its swing the wave
                //  always meets the flat line and the knob on the same centre line.
                let ea = clamp((xa - tr0) / f0, 0, 1) * clamp((tr0 + span - xa) / f1, 0, 1)
                let eb = clamp((xb - tr0) / f0, 0, 1) * clamp((tr0 + span - xb) / f1, 0, 1)
                line { from: xa, vy + wa * ea * sin((xa - tr0) * wf - time * 120); to: xb, vy + wa * eb * sin((xb - tr0) * wf - time * 120); width: 5 * u; color: if(audio.muted, faint, mint); opacity: min(1, span / (3 * u)) }
            }
            line { from: tr0 + span, vy; to: tr0 + trw, vy; width: 5 * u; color: ink; opacity: 12% }
            box { at: clamp(tr0 + span, tr0 + 4 * u, tr0 + trw - 4 * u), vy; size: 6 * u, 26 * u; corner: 3 * u; color: ink }
            text number(audio.volume * 100, 0, "%") { at: floor(cx + 116 * u + 0.5), floor(vy + 0.5); anchor: center; align: center; size: 21 * u; weight: 700; color: ink; family: "Space Grotesk"; show: not audio.muted }
            text "Muted" { at: floor(cx + 116 * u + 0.5), floor(vy + 0.5); anchor: center; align: center; size: 21 * u; weight: 700; color: faint; family: "Space Grotesk"; show: audio.muted }
        }

        // ── a notification ──
        group {
            opacity: okn
            show: okn > 0.01
            let nty = oy                                  // the tile's middle: the plate's, so it sits vertically centred
            let ntx = cx - 128 * u
            let ntl = cx - 96 * u                         // where its words start
            box { at: ntx, nty; size: 44 * u, 44 * u; corner: 12 * u; color: ink; opacity: 6% }
            //  No picture from the app: a bell, in the accent (or red, for something urgent).
            group {
                show: not nt_icon_on
                ellipse { at: ntx, nty - 2 * u; radius: 7 * u; color: if(nt_urgent, alert, mint) }
                box { at: ntx, nty + 5 * u; size: 18 * u, 3.5 * u; corner: 1.75 * u; color: if(nt_urgent, alert, mint) }
                ellipse { at: ntx, nty + 9.5 * u; radius: 2 * u; color: if(nt_urgent, alert, mint) }
            }
            group {
                show: nt_icon_on
                image nt_img { at: ntx - 22 * u, nty - 22 * u; size: 44 * u, 44 * u }
            }
            //  A ring off the tile when it arrives.
            ellipse { at: ntx, nty; radius: (24 + 22 * nt_ring) * u; stroke: 2 * u; color: if(nt_urgent, alert, mint); opacity: 90% * (1 - nt_ring) }
            ellipse { at: ntx + 20 * u, nty - 20 * u; radius: 5 * u; color: alert; opacity: if(nt_urgent, 60% + 40% * sin(time * 300), 0) }

            text nt_app { at: floor(ntl + 0.5), floor(ot + 12 * u + 9 * u + 0.5); anchor: left center; size: 13 * u; weight: 700; width: 190 * u; lines: 1; color: faint; family: "Space Grotesk" }
            text nt_title { at: floor(ntl + 0.5), floor(ot + 35 * u + 0.5); anchor: left top; size: 19 * u; weight: 700; width: 236 * u; lines: 3; measure: ntt; color: ink; family: "Space Grotesk" }
            text nt_body { at: floor(ntl + 0.5), floor(ot + (39 + nt_th) * u + 0.5); anchor: left top; size: 15.5 * u; width: 236 * u; lines: 6; measure: ntb; color: faint; family: "Space Grotesk"; show: nt_body_on }
            //  Its buttons, under the words.
            row nt_row {
                at: floor(ntl + 0.5), floor(ot + (nt_content + 8) * u + 0.5)
                gap: 8
                for a in nt_acts { NtAct(a, click: nt_act) }
            }
            //  Close.
            ellipse { at: cx + 140 * u, ot + 12 * u + 8 * u; radius: 10 * u; color: ink; opacity: 22% * nt_x.hover }
            line { from: cx + 136.5 * u, ot + 12 * u + 4.5 * u; to: cx + 143.5 * u, ot + 12 * u + 11.5 * u; width: 1.4 * u; color: ink; opacity: 55% + 45% * nt_x.hover }
            line { from: cx + 143.5 * u, ot + 12 * u + 4.5 * u; to: cx + 136.5 * u, ot + 12 * u + 11.5 * u; width: 1.4 * u; color: ink; opacity: 55% + 45% * nt_x.hover }
            zone box nt_x { at: cx + 140 * u, ot + 12 * u + 8 * u; size: 24 * u, 24 * u; corner: 12 * u; cursor: pointer }
            on press nt_x { emit nt_close }
        }
    }
    //  ── the launcher ──
    //  A search field over its results. What is typed picks the kind of search: apps, or after a first
    //  character `#` files, `>` commands, `:` emoji, `^` the clipboard, `~` wallpapers; and a sum is answered. The
    //  logic (see the Launcher section of vitreus.luau) reads the field and fills `lres`. Files, the clipboard and
    //  wallpapers have a preview beside the rows: the picture, or the text, and the file's details.
    group {
        clip inset 2 box { at: cx, bar.y + dl.hh / 2; size: dl.w, dl.hh; corner: 26 * u }
        opacity: fl
        move: 0, (1 - fl) * 12 * u
        let lx = cx - 215 * u
        let ly = ck + 8 * u
        let lry = ly + 68 * u                             // the rows start under the hints
        let lph = max(1, lr * 44 - 4) * u                 // the rows' height, and the preview's
        let lpx = lx + lw + 8 * u                         // the preview's left edge
        let lpw = 430 * u - lw - 8 * u
        box { from: lx, ly; size: 430 * u, 40 * u; corner: 20 * u; color: ink; opacity: 8% }
        ellipse { at: lx + 24 * u, ly + 19 * u; radius: 5.5 * u; stroke: 1.6 * u; color: mint }
        line { from: lx + 28 * u, ly + 23 * u; to: lx + 32.5 * u, ly + 27.5 * u; width: 1.8 * u; color: mint }
        input lq { at: floor(lx + 46 * u + 0.5), floor(ly + 12 * u + 0.5); width: 290 * u; size: 15 * u; color: ink; family: "Space Grotesk"; placeholder: "Search apps…" }
        text lmode { at: floor(lx + 412 * u + 0.5), floor(ly + 20 * u + 0.5); anchor: right center; align: right; size: 10 * u; weight: 700; width: 70 * u; lines: 1; color: mint; family: "Space Grotesk" }
        text "files" { at: 0, 0; size: 9.5 * u; lines: 1; measure: lhw0; opacity: 0; family: "Space Grotesk" }
        text "commands" { at: 0, 0; size: 9.5 * u; lines: 1; measure: lhw1; opacity: 0; family: "Space Grotesk" }
        text "emoji" { at: 0, 0; size: 9.5 * u; lines: 1; measure: lhw2; opacity: 0; family: "Space Grotesk" }
        text "clipboard" { at: 0, 0; size: 9.5 * u; lines: 1; measure: lhw3; opacity: 0; family: "Space Grotesk" }
        text "wallpapers" { at: 0, 0; size: 9.5 * u; lines: 1; measure: lhw4; opacity: 0; family: "Space Grotesk" }
        //  What the first character of the search does, in small type under the field: press one to type it. Five
        //  equal cells across the field, each pair (character, name) centred in its cell, a divider between cells.
        repeat i in 0..5 {
            let hc = lx + (i + 0.5) * 86 * u                   // the cell's middle
            let hy = ly + 54 * u
            let hx = floor(hc - (12 * u + pick(i, lhw0.width, lhw1.width, lhw2.width, lhw3.width, lhw4.width)) / 2 + 0.5)   // where the pair starts
            box { at: hc, hy; size: 82 * u, 18 * u; corner: 9 * u; color: ink; opacity: 8% * lhint_hit.$i.hover }
            text pick(i, "#", ">", ":", "^", "~") { at: hx, floor(hy + 0.5); anchor: left center; size: 11 * u; weight: 700; color: mint; family: "Space Grotesk" }
            text pick(i, "files", "commands", "emoji", "clipboard", "wallpapers") { at: hx + floor(12 * u + 0.5), floor(hy + 0.5); anchor: left center; size: 9.5 * u; color: faint; family: "Space Grotesk" }
            line { from: lx + i * 86 * u, hy - 5 * u; to: lx + i * 86 * u, hy + 5 * u; width: 1 * u; color: ink; opacity: 18%; show: i > 0 }
            zone box lhint_hit.$i { at: hc, hy; size: 84 * u, 18 * u; corner: 9 * u; cursor: pointer }
            on press lhint_hit.$i { emit launch_hint(i) }
        }
        //  The wheel over the rows scrolls the list (under the rows, so their presses still win).
        zone box lwheel { from: lx, lry; size: lw, lph }
        on scroll lwheel { emit launch_scroll(-wheel) }
        column lcol {
            at: floor(lx + 0.5), floor(lry + 0.5)     // on whole pixels, as each row's height and the gap are: an icon
            view: lw, lph                             // between two pixels picks up a sliver of its neighbour in the atlas
            gap: floor(4 * u + 0.5)
            for r in lres { LRow(r, pick: launch_pick) }
        }
        text lmsg { at: floor(lx + lw / 2 + 0.5), floor(lry + 20 * u + 0.5); anchor: center; align: center; size: 12 * u; color: faint; width: lw - 16 * u; lines: 2; family: "Space Grotesk"; show: lcount < 1 }

        //  The preview.
        group {
            opacity: lpv
            show: lpv > 0.01
            box { from: lpx, lry; size: lpw, lph; corner: 14 * u; color: ink; opacity: 5% }
            text lp_kind { at: floor(lpx + 10 * u + 0.5), floor(lry + 14 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; width: lpw - 20 * u; lines: 1; color: mint; family: "Space Grotesk" }
            group {
                show: lp_img_on
                clip inset 0 box { at: lpx + lpw / 2, lry + 28 * u + (lpw - 20 * u) / 3; size: lpw - 20 * u, (lpw - 20 * u) * 2 / 3; corner: 8 * u }
                box { from: lpx + 10 * u, lry + 28 * u; size: lpw - 20 * u, (lpw - 20 * u) * 2 / 3; corner: 8 * u; color: ink; opacity: 5% }
                image lp_img { at: lpx + 10 * u, lry + 28 * u; size: lpw - 20 * u, (lpw - 20 * u) * 2 / 3 }
            }
            let lpy = lry + 28 * u + if(lp_img_on, (lpw - 20 * u) * 2 / 3 + 8 * u, 0)
            text lp_title { at: floor(lpx + 10 * u + 0.5), floor(lpy + 8 * u + 0.5); anchor: left center; size: 12 * u; weight: 700; width: lpw - 20 * u; lines: 1; color: ink; family: "Space Grotesk" }
            text lp_path { at: floor(lpx + 10 * u + 0.5), floor(lpy + 24 * u + 0.5); anchor: left center; size: 9.5 * u; width: lpw - 20 * u; lines: 1; color: faint; family: "Space Grotesk" }
            text lp_body { at: floor(lpx + 10 * u + 0.5), floor(lpy + 40 * u + 0.5); anchor: left top; size: 11 * u; width: lpw - 20 * u; lines: 9; color: ink; family: "Space Grotesk" }
            repeat i in 0..4 {
                let ky = lpy + 44 * u + i * 16 * u
                text pick(i, lp_k1, lp_k2, lp_k3, lp_k4) { at: floor(lpx + 10 * u + 0.5), floor(ky + 0.5); anchor: left center; size: 10 * u; width: 50 * u; lines: 1; color: faint; family: "Space Grotesk" }
                text pick(i, lp_v1, lp_v2, lp_v3, lp_v4) { at: floor(lpx + 60 * u + 0.5), floor(ky + 0.5); anchor: left center; size: 10 * u; width: lpw - 70 * u; lines: 1; color: ink; family: "Space Grotesk" }
            }
        }
        text "↑↓ move   ·   Enter open   ·   Esc close" { at: floor(lx + 6 * u + 0.5), floor(lry + (lr * 44 + 4 + 9) * u + 0.5); anchor: left center; size: 10 * u; color: faint; opacity: 70%; family: "Space Grotesk" }
        text lfoot { at: floor(lx + 424 * u + 0.5), floor(lry + (lr * 44 + 4 + 9) * u + 0.5); anchor: right center; align: right; size: 10 * u; width: 120 * u; lines: 1; color: faint; opacity: 70%; family: "Space Grotesk" }
    }

    //  ── the settings panel ──
    //  Laid out the way Synoptik's is: a header with an icon badge, the title and a breadcrumb chip; under
    //  it a sidebar of sections next to the page, which is a stack of cards. The wallpaper picker is the
    //  first (and, for now, only) page.
    group {
        clip inset 2 box { at: cx, bar.y + ss.hh / 2; size: ss.w, ss.hh; corner: 26 * u }
        opacity: fs
        move: 0, (1 - fs) * 12 * u
        let hy = ck + 26 * u                              // the header's middle
        let sby = ck + 52 * u                              // the top of the sidebar and the page
        let sl = cx - 298 * u                             // their left edge
        let spx = sl + 158 * u                             // the page's left edge

        //  Header: a badge with a gear, SETTINGS, the breadcrumb, and a cross.
        box { at: sl + 16 * u, hy; size: 32 * u, 32 * u; corner: 9 * u; color: mint; opacity: 20% }
        group {
            ellipse { at: sl + 16 * u, hy; radius: 6 * u; stroke: 2.2 * u; color: mint }
            ellipse { at: sl + 16 * u, hy; radius: 2 * u; color: mint }
            repeat i in 0..8 {
                group {
                    pivot: sl + 16 * u, hy
                    rotate: i * 45deg
                    box { at: sl + 16 * u, hy - 8.5 * u; size: 3 * u, 4 * u; corner: 1 * u; color: mint }
                }
            }
        }
        text "SETTINGS" { at: floor(sl + 40 * u + 0.5), floor(hy + 0.5); anchor: left center; size: 14 * u; weight: 700; color: ink; family: "Space Grotesk" }
        box { at: sl + 178 * u, hy; size: 132 * u, 22 * u; corner: 11 * u; color: ink; opacity: 6% }
        text "VISUALS" { at: floor(sl + 122 * u + 0.5), floor(hy + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; opacity: 1 - set_pgh - set_pga; family: "Space Grotesk" }
        text "SYSTEM" { at: floor(sl + 122 * u + 0.5), floor(hy + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; opacity: set_pgh + set_pga; family: "Space Grotesk" }
        path { at: sl + 168 * u, hy; stroke: 1.3 * u; color: faint; move -2 * u, -3.5 * u; line 2 * u, 0; line -2 * u, 3.5 * u }
        text "Wallpaper" { at: floor(sl + 176 * u + 0.5), floor(hy + 0.5); anchor: left center; size: 9.5 * u; weight: 700; color: mint; opacity: 1 - set_pg - set_pgd - set_pgb - set_pgh - set_pga; family: "Space Grotesk" }
        text "Display" { at: floor(sl + 176 * u + 0.5), floor(hy + 0.5); anchor: left center; size: 9.5 * u; weight: 700; color: mint; opacity: set_pgd; family: "Space Grotesk" }
        text "Glass" { at: floor(sl + 176 * u + 0.5), floor(hy + 0.5); anchor: left center; size: 9.5 * u; weight: 700; color: mint; opacity: set_pg; family: "Space Grotesk" }
        text "Hyprland" { at: floor(sl + 176 * u + 0.5), floor(hy + 0.5); anchor: left center; size: 9.5 * u; weight: 700; color: mint; opacity: set_pgh; family: "Space Grotesk" }
        text "Bar" { at: floor(sl + 176 * u + 0.5), floor(hy + 0.5); anchor: left center; size: 9.5 * u; weight: 700; color: mint; opacity: set_pgb; family: "Space Grotesk" }
        text "About" { at: floor(sl + 176 * u + 0.5), floor(hy + 0.5); anchor: left center; size: 9.5 * u; weight: 700; color: mint; opacity: set_pga; family: "Space Grotesk" }
        ellipse { at: cx + 282 * u, hy; radius: 13 * u; color: ink; opacity: 5% + 10% * set_x.hover }
        line { from: cx + 277.5 * u, hy - 4.5 * u; to: cx + 286.5 * u, hy + 4.5 * u; width: 1.5 * u; color: ink; opacity: 60% + 40% * set_x.hover }
        line { from: cx + 286.5 * u, hy - 4.5 * u; to: cx + 277.5 * u, hy + 4.5 * u; width: 1.5 * u; color: ink; opacity: 60% + 40% * set_x.hover }
        zone box set_x { at: cx + 282 * u, hy; size: 28 * u, 28 * u; corner: 14 * u; cursor: pointer }
        on press set_x { panel = none }

        //  Sidebar: the sections, grouped. One so far.
        box { at: sl + 75 * u, sby + set.h / 2 * u; size: 150 * u, set.h * u; corner: 14 * u; color: ink; opacity: 4% }
        text "VISUALS" { at: floor(sl + 14 * u + 0.5), floor(sby + 18 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; opacity: 70%; family: "Space Grotesk" }
        box { at: sl + 75 * u, sby + mix(mix(42 + 32 * (set_pg + 2 * set_pgd + 3 * set_pgb), 194, set_pgh), 226, set_pga) * u; size: 134 * u, 28 * u; corner: 10 * u; color: mint; opacity: 16% }
        group {
            opacity: 65% + 35% * (1 - clamp(set_pg + set_pgd + set_pgb + set_pgh + set_pga, 0, 1))
            box { at: sl + 24 * u, sby + 42 * u; size: 13 * u, 10 * u; corner: 2 * u; stroke: 1.3 * u; color: mix(mint, ink, clamp(set_pg + set_pgd + set_pgb + set_pgh + set_pga, 0, 1)) }
            path { at: sl + 24 * u, sby + 42 * u; color: mix(mint, ink, clamp(set_pg + set_pgd + set_pgb + set_pgh + set_pga, 0, 1)); move -5 * u, 3 * u; line -1.5 * u, -1 * u; line 1 * u, 1.5 * u; line 2.5 * u, -1.5 * u; line 5 * u, 3 * u; close }
            ellipse { at: sl + 27 * u, sby + 39 * u; radius: 1.2 * u; color: mix(mint, ink, clamp(set_pg + set_pgd + set_pgb + set_pgh + set_pga, 0, 1)) }
        }
        text "Wallpaper" { at: floor(sl + 40 * u + 0.5), floor(sby + 42 * u + 0.5); anchor: left center; size: 12 * u; weight: 700; color: mix(mint, ink, clamp(set_pg + set_pgd + set_pgb + set_pgh + set_pga, 0, 1)); opacity: 100% - 15% * clamp(set_pg + set_pgd + set_pgb + set_pgh + set_pga, 0, 1); family: "Space Grotesk" }
        //  Glass: a pane with a highlight across its corner.
        group {
            opacity: 65% + 35% * set_pg
            box { at: sl + 24 * u, sby + 74 * u; size: 13 * u, 13 * u; corner: 3.5 * u; stroke: 1.3 * u; color: mix(ink, mint, set_pg) }
            line { from: sl + 20.5 * u, sby + 76.5 * u; to: sl + 24.5 * u, sby + 71 * u; width: 1.1 * u; color: mix(ink, mint, set_pg); opacity: 80% }
        }
        text "Glass" { at: floor(sl + 40 * u + 0.5), floor(sby + 74 * u + 0.5); anchor: left center; size: 12 * u; weight: 700; color: mix(ink, mint, set_pg); opacity: 85% + 15% * set_pg; family: "Space Grotesk" }
        //  Display: a screen on its stand.
        group {
            opacity: 65% + 35% * set_pgd
            box { at: sl + 24 * u, sby + 104 * u; size: 14 * u, 9.5 * u; corner: 2 * u; stroke: 1.3 * u; color: mix(ink, mint, set_pgd) }
            line { from: sl + 24 * u, sby + 109.5 * u; to: sl + 24 * u, sby + 112 * u; width: 1.3 * u; color: mix(ink, mint, set_pgd) }
            line { from: sl + 20.5 * u, sby + 112.5 * u; to: sl + 27.5 * u, sby + 112.5 * u; width: 1.3 * u; color: mix(ink, mint, set_pgd) }
        }
        text "Display" { at: floor(sl + 40 * u + 0.5), floor(sby + 106 * u + 0.5); anchor: left center; size: 12 * u; weight: 700; color: mix(ink, mint, set_pgd); opacity: 85% + 15% * set_pgd; family: "Space Grotesk" }
        //  Bar: a pill with its three dots, the bar itself.
        group {
            opacity: 65% + 35% * set_pgb
            box { at: sl + 24 * u, sby + 138 * u; size: 16 * u, 8 * u; corner: 4 * u; stroke: 1.3 * u; color: mix(ink, mint, set_pgb) }
            repeat k in 0..3 { ellipse { at: sl + (21 + k * 3) * u, sby + 138 * u; radius: 0.9 * u; color: mix(ink, mint, set_pgb) } }
        }
        text "Bar" { at: floor(sl + 40 * u + 0.5), floor(sby + 138 * u + 0.5); anchor: left center; size: 12 * u; weight: 700; color: mix(ink, mint, set_pgb); opacity: 85% + 15% * set_pgb; family: "Space Grotesk" }
        text "SYSTEM" { at: floor(sl + 14 * u + 0.5), floor(sby + 172 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; opacity: 70%; family: "Space Grotesk" }
        //  Hyprland: a window with its title bar.
        group {
            opacity: 65% + 35% * set_pgh
            box { at: sl + 24 * u, sby + 194 * u; size: 14 * u, 11 * u; corner: 2 * u; stroke: 1.3 * u; color: mix(ink, mint, set_pgh) }
            line { from: sl + 17 * u, sby + 192 * u; to: sl + 31 * u, sby + 192 * u; width: 1.3 * u; color: mix(ink, mint, set_pgh) }
        }
        text "Hyprland" { at: floor(sl + 40 * u + 0.5), floor(sby + 194 * u + 0.5); anchor: left center; size: 12 * u; weight: 700; color: mix(ink, mint, set_pgh); opacity: 85% + 15% * set_pgh; family: "Space Grotesk" }
        //  About: an i in a circle.
        group {
            opacity: 65% + 35% * set_pga
            ellipse { at: sl + 24 * u, sby + 226 * u; radius: 6.5 * u; stroke: 1.3 * u; color: mix(ink, mint, set_pga) }
            line { from: sl + 24 * u, sby + 226 * u; to: sl + 24 * u, sby + 229.5 * u; width: 1.3 * u; color: mix(ink, mint, set_pga) }
            ellipse { at: sl + 24 * u, sby + 222.8 * u; radius: 0.9 * u; color: mix(ink, mint, set_pga) }
        }
        text "About" { at: floor(sl + 40 * u + 0.5), floor(sby + 226 * u + 0.5); anchor: left center; size: 12 * u; weight: 700; color: mix(ink, mint, set_pga); opacity: 85% + 15% * set_pga; family: "Space Grotesk" }
        zone box side_ab { at: sl + 75 * u, sby + 226 * u; size: 134 * u, 28 * u; corner: 10 * u; cursor: pointer }
        on press side_ab { set_page = pg_about }
        zone box side_hy { at: sl + 75 * u, sby + 194 * u; size: 134 * u, 28 * u; corner: 10 * u; cursor: pointer }
        on press side_hy { set_page = pg_hypr }
        zone box side_dp { at: sl + 75 * u, sby + 106 * u; size: 134 * u, 28 * u; corner: 10 * u; cursor: pointer }
        on press side_dp { set_page = pg_disp }
        zone box side_bar { at: sl + 75 * u, sby + 138 * u; size: 134 * u, 28 * u; corner: 10 * u; cursor: pointer }
        on press side_bar { set_page = pg_bar }
        zone box side_wp { at: sl + 75 * u, sby + 42 * u; size: 134 * u, 28 * u; corner: 10 * u; cursor: pointer }
        zone box side_gl { at: sl + 75 * u, sby + 74 * u; size: 134 * u, 28 * u; corner: 10 * u; cursor: pointer }
        on press side_wp { set_page = pg_wall }
        on press side_gl { set_page = pg_glass }

        group {
            show: set_pg + set_pgd + set_pgb + set_pgh + set_pga < 0.99
            opacity: 1 - set_pg - set_pgd - set_pgb - set_pgh - set_pga
            //  The wallpaper page. Card one: the wallpaper in use, and Random.
            box { at: spx + 219 * u, sby + 46 * u; size: 438 * u, 92 * u; corner: 14 * u; color: ink; opacity: veil }
            group {
                clip inset 0 box { at: spx + 77 * u, sby + 46 * u; size: 130 * u, 73 * u; corner: 10 * u }
                image wp_cur { at: spx + 12 * u, sby + 9.5 * u; size: 130 * u, 73 * u }
            }
            text "ACTIVE WALLPAPER" { at: floor(spx + 154 * u + 0.5), floor(sby + 16 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }
            text wp_name { at: floor(spx + 154 * u + 0.5), floor(sby + 36 * u + 0.5); anchor: left center; size: 13 * u; weight: 700; width: 268 * u; lines: 1; color: ink; family: "Space Grotesk" }
            text wp_dirtext { at: floor(spx + 154 * u + 0.5), floor(sby + 53 * u + 0.5); anchor: left center; size: 10 * u; width: 268 * u; lines: 1; color: faint; family: "Space Grotesk" }
            box { at: spx + 195 * u, sby + 74 * u; size: 78 * u, 24 * u; corner: 12 * u; color: ink; opacity: 8% + 10% * wp_rand_hit.hover }
            text "Random" { at: floor(spx + 195 * u + 0.5), floor(sby + 74 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 600; width: 74 * u; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box wp_rand_hit { at: spx + 195 * u, sby + 74 * u; size: 80 * u, 26 * u; corner: 13 * u; cursor: pointer }
            on press wp_rand_hit { emit wp_random }

            //  Card two: the slideshow. A switch, and how often: a stepper along a short list of intervals.
            box { at: spx + 219 * u, sby + 122 * u; size: 438 * u, 44 * u; corner: 14 * u; color: ink; opacity: veil }
            text "Slideshow" { at: floor(spx + 14 * u + 0.5), floor(sby + 113 * u + 0.5); anchor: left center; size: 12.5 * u; weight: 700; color: ink; family: "Space Grotesk" }
            text wp_show_sub { at: floor(spx + 14 * u + 0.5), floor(sby + 130 * u + 0.5); anchor: left center; size: 10 * u; width: 190 * u; lines: 1; color: if(wp_show, mint, faint); family: "Space Grotesk" }
            group {
                opacity: 40% + 60% * wp_show_pill
                ellipse { at: spx + 250 * u, sby + 122 * u; radius: 11 * u; color: ink; opacity: 8% + 12% * wp_min_hit.hover }
                box { at: spx + 250 * u, sby + 122 * u; size: 9 * u, 1.6 * u; corner: 0.8 * u; color: ink }
                box { at: spx + 295 * u, sby + 122 * u; size: 58 * u, 24 * u; corner: 7 * u; color: ink; opacity: 8% }
                text wp_mins_text { at: floor(spx + 295 * u + 0.5), floor(sby + 122 * u + 0.5); anchor: center; align: center; size: 11 * u; weight: 700; width: 56 * u; lines: 1; color: mint; family: "Space Grotesk" }
                ellipse { at: spx + 340 * u, sby + 122 * u; radius: 11 * u; color: ink; opacity: 8% + 12% * wp_plus_hit.hover }
                box { at: spx + 340 * u, sby + 122 * u; size: 9 * u, 1.6 * u; corner: 0.8 * u; color: ink }
                box { at: spx + 340 * u, sby + 122 * u; size: 1.6 * u, 9 * u; corner: 0.8 * u; color: ink }
            }
            zone box wp_min_hit { at: spx + 250 * u, sby + 122 * u; size: 26 * u, 26 * u; corner: 13 * u; cursor: pointer }
            zone box wp_plus_hit { at: spx + 340 * u, sby + 122 * u; size: 26 * u, 26 * u; corner: 13 * u; cursor: pointer }
            on press wp_min_hit { emit wp_mins_step(-1) }
            on press wp_plus_hit { emit wp_mins_step(1) }
            body {
                color: mix(off, mint, clamp(wp_show_pill, 0, 1))
                box { at: spx + 405 * u, sby + 122 * u; size: 38 * u, 22 * u; corner: 11 * u }
            }
            box { at: spx + 397 * u + wp_show_pill * 16 * u, sby + 122 * u; size: (17 + 9 * clamp(4 * wp_show_pill * (1 - wp_show_pill), 0, 1)) * u, (17 - 3 * clamp(4 * wp_show_pill * (1 - wp_show_pill), 0, 1)) * u; corner: (8.5 - 1.5 * clamp(4 * wp_show_pill * (1 - wp_show_pill), 0, 1)) * u; color: ink }
            zone box wp_show_hit { at: spx + 405 * u, sby + 122 * u; size: 46 * u, 30 * u; cursor: pointer }
            on press wp_show_hit { emit wp_show_toggle }

            //  Card three: the colour filter. Twelve swatches: the gallery, Random and the slideshow narrow to the
            //  wallpapers whose dominant colour it is; the lit one, pressed again, clears it.
            box { at: spx + 219 * u, sby + 174 * u; size: 438 * u, 44 * u; corner: 14 * u; color: ink; opacity: veil }
            text "COLOR" { at: floor(spx + 14 * u + 0.5), floor(sby + 165 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }
            text wp_count { at: floor(spx + 14 * u + 0.5), floor(sby + 182 * u + 0.5); anchor: left center; size: 9.5 * u; width: 100 * u; lines: 1; color: if(wp_filter >= 0, mint, faint); family: "Space Grotesk" }
            repeat i in 0..12 {
                let swx = spx + 124 * u + i * 26 * u
                let lit = if(wp_filter == i, 1, 0)
                box { at: swx, sby + 174 * u; size: (18 + 3 * lit) * u, (18 + 3 * lit) * u; corner: 5 * u; color: pick(i, #e53935, #fb8c00, #fdd835, #43a047, #00acc1, #1e88e5, #8e24aa, #ec407a, #6d4c41, #f5f5f5, #9e9e9e, #212121) }
                box { at: swx, sby + 174 * u; size: (18 + 3 * lit) * u, (18 + 3 * lit) * u; corner: 5 * u; stroke: 1 * u; color: #000000; opacity: 35% }
                box { at: swx, sby + 174 * u; size: 25 * u, 25 * u; corner: 7 * u; stroke: 2 * u; color: mint; opacity: lit * 100% }
                zone box wp_sw.$i { at: swx, sby + 174 * u; size: 24 * u, 24 * u; corner: 6 * u; cursor: pointer }
                on press wp_sw.$i { emit wp_filter_set(i) }
            }

            //  Card four: the gallery, twelve at a time, with a pager.
            box { at: spx + 219 * u, sby + 330 * u; size: 438 * u, 252 * u; corner: 14 * u; color: ink; opacity: veil }
            text "WALLPAPER GALLERY" { at: floor(spx + 14 * u + 0.5), floor(sby + 220 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }
            text wp_dirtext { at: floor(spx + 424 * u + 0.5), floor(sby + 220 * u + 0.5); anchor: right center; size: 9.5 * u; width: 260 * u; lines: 1; align: right; color: faint; opacity: 70%; family: "Space Grotesk" }
            text "No wallpaper of this color" { at: floor(spx + 219 * u + 0.5), floor(sby + 330 * u + 0.5); anchor: center; size: 12 * u; color: faint; family: "Space Grotesk"; show: wps.count < 1 }
            row wp_grid {
                at: floor(spx + 15 * u + 0.5), floor(sby + 238 * u + 0.5)
                gap: 8 * u
                wrap: 4
                for w in wps { WpThumb(w, pick: wp_pick) }
            }
            path { at: spx + 40 * u, sby + 438 * u; stroke: 1.6 * u; color: ink; opacity: 55% + 45% * wp_prev_hit.hover; move 3 * u, -5 * u; line -3 * u, 0; line 3 * u, 5 * u }
            text wp_pager { at: floor(spx + 219 * u + 0.5), floor(sby + 438 * u + 0.5); anchor: center; align: center; size: 11 * u; weight: 600; width: 100 * u; lines: 1; color: faint; family: "Space Grotesk" }
            path { at: spx + 398 * u, sby + 438 * u; stroke: 1.6 * u; color: ink; opacity: 55% + 45% * wp_next_hit.hover; move -3 * u, -5 * u; line 3 * u, 0; line -3 * u, 5 * u }
            zone box wp_prev_hit { at: spx + 40 * u, sby + 438 * u; size: 30 * u, 28 * u; corner: 14 * u; cursor: pointer }
            zone box wp_next_hit { at: spx + 398 * u, sby + 438 * u; size: 30 * u, 28 * u; corner: 14 * u; cursor: pointer }
            on press wp_prev_hit { emit wp_prev }
            on press wp_next_hit { emit wp_next }
        }

        //  The Glass page. Two sliders that act on the bar and every drawer at once, as they are dragged.
        group {
            show: set_pg > 0.01
            opacity: set_pg
            let gsl.x0 = spx + 14 * u
            let gsl.w = 336 * u
            let gh = 14 * u

            //  Glass: how much of the glass effect there is. The compositor does the blur, and pleamar only asks
            //  it for one, so this is not a radius: it is how glassy the panel is (its tint, the edge light and
            //  whether the blur is asked for at all).
            box { at: spx + 219 * u, sby + 46 * u; size: 438 * u, 92 * u; corner: 14 * u; color: ink; opacity: veil }
            text "Glass" { at: floor(spx + 14 * u + 0.5), floor(sby + 16 * u + 0.5); anchor: left center; size: 13 * u; weight: 700; color: ink; family: "Space Grotesk" }
            text "How frosted the panels are: 100% is glass that blurs what is behind it, 0% is solid." { at: floor(spx + 14 * u + 0.5), floor(sby + 33 * u + 0.5); anchor: left center; size: 10 * u; color: faint; family: "Space Grotesk" }
            text "It is counted together with Opacity: once the two multiply to under 30% the blur turns off." { at: floor(spx + 14 * u + 0.5), floor(sby + 46 * u + 0.5); anchor: left center; size: 10 * u; color: faint; family: "Space Grotesk" }
            body {
                color: deep
                rim: 9%
                box { at: gsl.x0 + gsl.w / 2, sby + 74 * u; size: gsl.w, gh; corner: gh / 2 }
            }
            group {
                glow: 7 * u, 50%, mint
                body {
                    gradient: gsl.x0, 0 to gsl.x0 + gsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: gsl.x0, sby + 74 * u - gh / 2; size: max(0.1, gsl.w * glass_frost), gh; corner: gh / 2 }
                }
            }
            text glass_frost_text { at: floor(spx + 424 * u + 0.5), floor(sby + 74 * u + 0.5); anchor: right center; size: 16 * u; weight: 600; color: ink; family: "Space Grotesk" }
            zone box glass_hit { at: gsl.x0 + gsl.w / 2, sby + 74 * u; size: gsl.w + 28 * u, 34 * u; cursor: pointer }
            on press glass_hit { emit glass_frost_set(clamp((pointer.x - gsl.x0) / gsl.w, 0, 1)) }
            on drag glass_hit { emit glass_frost_set(clamp((pointer.x - gsl.x0) / gsl.w, 0, 1)) }

            //  Opacity: how solid the bar and the drawers are, from 30% (see-through) to 100%.
            box { at: spx + 219 * u, sby + 146 * u; size: 438 * u, 92 * u; corner: 14 * u; color: ink; opacity: veil }
            text "Opacity" { at: floor(spx + 14 * u + 0.5), floor(sby + 116 * u + 0.5); anchor: left center; size: 13 * u; weight: 700; color: ink; family: "Space Grotesk" }
            text "How solid the bar and the drawers are. The track starts at 30% (you can see through them)," { at: floor(spx + 14 * u + 0.5), floor(sby + 133 * u + 0.5); anchor: left center; size: 10 * u; color: faint; family: "Space Grotesk" }
            text "up to 100%. The cards inside keep their own light veil." { at: floor(spx + 14 * u + 0.5), floor(sby + 146 * u + 0.5); anchor: left center; size: 10 * u; color: faint; family: "Space Grotesk" }
            body {
                color: deep
                rim: 9%
                box { at: gsl.x0 + gsl.w / 2, sby + 174 * u; size: gsl.w, gh; corner: gh / 2 }
            }
            group {
                glow: 7 * u, 50%, mint
                body {
                    gradient: gsl.x0, 0 to gsl.x0 + gsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: gsl.x0, sby + 174 * u - gh / 2; size: max(0.1, gsl.w * glass_op), gh; corner: gh / 2 }
                }
            }
            //  The first 30 % of this track cannot be picked: it is shaded, with a tick where the range starts.
            box { from: gsl.x0, sby + 174 * u - gh / 2; size: gsl.w * 0.3, gh; corner: gh / 2; color: #000000; opacity: 38% }
            box { at: gsl.x0 + gsl.w * 0.3, sby + 174 * u; size: 1.5 * u, gh + 6 * u; corner: 0.75 * u; color: ink; opacity: 45% }
            text glass_op_text { at: floor(spx + 424 * u + 0.5), floor(sby + 174 * u + 0.5); anchor: right center; size: 16 * u; weight: 600; color: ink; family: "Space Grotesk" }
            zone box glass_op_hit { at: gsl.x0 + gsl.w / 2, sby + 174 * u; size: gsl.w + 28 * u, 34 * u; cursor: pointer }
            on press glass_op_hit { emit glass_op_set(clamp((pointer.x - gsl.x0) / gsl.w, 0, 1)) }
            on drag glass_op_hit { emit glass_op_set(clamp((pointer.x - gsl.x0) / gsl.w, 0, 1)) }

            //  Back to how it was.
            text "Changes apply right away." { at: floor(spx + 14 * u + 0.5), floor(sby + 222 * u + 0.5); anchor: left center; size: 10 * u; color: faint; opacity: 80%; family: "Space Grotesk" }
            box { at: spx + 370 * u, sby + 222 * u; size: 128 * u, 26 * u; corner: 13 * u; color: ink; opacity: 8% + 10% * glass_reset_hit.hover }
            text "Reset to defaults" { at: floor(spx + 370 * u + 0.5), floor(sby + 222 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 600; width: 124 * u; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box glass_reset_hit { at: spx + 370 * u, sby + 222 * u; size: 130 * u, 28 * u; corner: 14 * u; cursor: pointer }
            on press glass_reset_hit { emit glass_reset }
        }

        //  The Bar page: how the bar itself is set up. So far, which monitors it shows on: all of them, or one.
        //  Choosing restarts the bar there (see the Bar section of vitreus.luau).
        group {
            show: set_pgb > 0.01
            opacity: set_pgb
            box { at: spx + 219 * u, sby + 88 * u; size: 438 * u, 124 * u; corner: 14 * u; color: ink; opacity: veil }
            text "SHOW THE BAR ON" { at: floor(spx + 14 * u + 0.5), floor(sby + 13 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }

            //  All monitors: two small screens, each with the bar across its top.
            let bax = spx + 52 * u
            let balit = if(bar_scr == -1, 1, 0)
            box { at: bax, sby + 76 * u; size: 76 * u, 64 * u; corner: 12 * u; color: if(balit > 0, mint, ink); opacity: if(balit > 0, 24%, 6% + 10% * bar_all_hit.hover) }
            box { at: bax, sby + 76 * u; size: 76 * u, 64 * u; corner: 12 * u; stroke: 1.5 * u; color: mint; opacity: balit * 100% }
            repeat k in 0..2 {
                let bkx = bax + (k * 2 - 1) * 10 * u
                box { at: bkx, sby + 60 * u; size: 16 * u, 11 * u; corner: 2 * u; stroke: 1.2 * u; color: mix(ink, mint, balit) }
                box { at: bkx, sby + 56.6 * u; size: 11 * u, 1.8 * u; corner: 0.9 * u; color: mix(ink, mint, balit) }
            }
            text "All" { at: floor(bax + 0.5), floor(sby + 82 * u + 0.5); anchor: center; align: center; size: 11 * u; weight: 700; width: 70 * u; lines: 1; color: mix(ink, mint, balit); family: "Space Grotesk" }
            text "every monitor" { at: floor(bax + 0.5), floor(sby + 95 * u + 0.5); anchor: center; align: center; size: 9 * u; width: 70 * u; lines: 1; color: faint; family: "Space Grotesk" }
            zone box bar_all_hit { at: bax, sby + 76 * u; size: 76 * u, 64 * u; corner: 12 * u; cursor: pointer }
            on press bar_all_hit { emit bar_pick_scr(-1) }

            //  One tile per monitor that is plugged in: a screen with the bar across its top.
            repeat i in 0..4 {
                let bmx = spx + (52 + 83 + i * 83) * u
                let bmlit = if(bar_scr == i, 1, 0)
                group {
                    show: bar_m.$i.on
                    box { at: bmx, sby + 76 * u; size: 76 * u, 64 * u; corner: 12 * u; color: if(bmlit > 0, mint, ink); opacity: if(bmlit > 0, 24%, 6% + 10% * bar_m_hit.$i.hover) }
                    box { at: bmx, sby + 76 * u; size: 76 * u, 64 * u; corner: 12 * u; stroke: 1.5 * u; color: mint; opacity: bmlit * 100% }
                    box { at: bmx, sby + 60 * u; size: 18 * u, 12 * u; corner: 2 * u; stroke: 1.2 * u; color: mix(ink, mint, bmlit) }
                    box { at: bmx, sby + 56.2 * u; size: 12 * u, 1.8 * u; corner: 0.9 * u; color: mix(ink, mint, bmlit) }
                    text bar_m.$i.name { at: floor(bmx + 0.5), floor(sby + 82 * u + 0.5); anchor: center; align: center; size: 11 * u; weight: 700; width: 70 * u; lines: 1; color: mix(ink, mint, bmlit); family: "Space Grotesk" }
                    text bar_m.$i.sub { at: floor(bmx + 0.5), floor(sby + 95 * u + 0.5); anchor: center; align: center; size: 9 * u; width: 70 * u; lines: 1; color: faint; family: "Space Grotesk" }
                    zone box bar_m_hit.$i { at: bmx, sby + 76 * u; size: 76 * u, 64 * u; corner: 12 * u; cursor: pointer }
                    on press bar_m_hit.$i { emit bar_pick_scr(i) }
                }
            }
            text "Changing this restarts the bar for a moment." { at: floor(spx + 14 * u + 0.5), floor(sby + 121 * u + 0.5); anchor: left center; size: 10 * u; width: 410 * u; lines: 1; color: faint; family: "Space Grotesk" }
            text bar_msg { at: floor(spx + 14 * u + 0.5), floor(sby + 136 * u + 0.5); anchor: left center; size: 10 * u; width: 410 * u; lines: 1; color: mint; family: "Space Grotesk" }

            //  ── The layout: a small copy of the bar, and under it a tray for the pieces that are hidden ──
            //  Drag a piece along the bar to move it, or down into the tray to hide it (all but the settings gear,
            //  the way back here). The logic places the chips and makes room where the dragged one would land.
            let mbx = spx + 14 * u                         // the editor's origin: the small bar's top-left
            let mby = sby + 190 * u
            box { at: spx + 219 * u, sby + 244 * u; size: 438 * u, 132 * u; corner: 14 * u; color: ink; opacity: veil }
            text "BAR LAYOUT" { at: floor(spx + 14 * u + 0.5), floor(sby + 166 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }
            box { at: spx + 400 * u, sby + 166 * u; size: 48 * u, 20 * u; corner: 10 * u; color: ink; opacity: 8% + 10% * blay_reset_hit.hover }
            text "Reset" { at: floor(spx + 400 * u + 0.5), floor(sby + 166 * u + 0.5); anchor: center; align: center; size: 10 * u; weight: 600; width: 44 * u; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box blay_reset_hit { at: spx + 400 * u, sby + 166 * u; size: 50 * u, 22 * u; corner: 11 * u; cursor: pointer }
            on press blay_reset_hit { emit bar_lay_reset }
            //  The small bar, and the tray: lit while the dragged piece would land in it.
            box { from: mbx, mby; size: 410 * u, 36 * u; corner: 12 * u; color: ink; opacity: 5% }
            box { from: mbx, mby; size: 410 * u, 36 * u; corner: 12 * u; stroke: 1 * u; color: mix(ink, mint, if(bdrag >= 0 and not bdrop_tray, 1, 0)); opacity: if(bdrag >= 0 and not bdrop_tray, 60%, 14%) }
            box { from: mbx, mby + 52 * u; size: 410 * u, 36 * u; corner: 12 * u; color: ink; opacity: 3% }
            box { from: mbx, mby + 52 * u; size: 410 * u, 36 * u; corner: 12 * u; stroke: 1 * u; color: mix(ink, mint, if(bdrop_tray, 1, 0)); opacity: if(bdrag >= 0 and bdrop_tray, 60%, 10%) }
            text "Hidden: drag a piece here to take it off the bar" { at: floor(mbx + 205 * u + 0.5), floor(mby + 70 * u + 0.5); anchor: center; align: center; size: 10 * u; width: 400 * u; lines: 1; color: faint; opacity: if(btray_n < 1 and not bdrop_tray, 70%, 0%); family: "Space Grotesk" }
            text "Drag a piece along the bar to move it. The window title stretches: what is left of it hugs the left end." { at: floor(spx + 14 * u + 0.5), floor(sby + 296 * u + 0.5); anchor: left center; size: 9.5 * u; width: 410 * u; lines: 1; color: faint; family: "Space Grotesk" }

            //  The drag is followed by a zone that stays still, under the chips: a drag reaches every zone that was
            //  under the press, and one that moves itself (a chip following the pointer) loses it at the first jump.
            zone box blay_area { from: mbx - 8 * u, mby - 8 * u; size: 426 * u, 104 * u }     // the small bar and the tray, not Reset
            on drag blay_area { bdx = (pointer.x - mbx) / u; bdy = (pointer.y - mby) / u; emit bar_lay_drag }
            //  The chips' zones, apart from their drawing: pressing one takes it.
            repeat i in 0..8 {
                let zx = mbx + if(bdrag == i, bdx - bgx, bcx.$i) * u
                let zy = mby + if(bdrag == i, bdy - bgy, bcy.$i) * u
                zone box bchip.$i { from: zx, zy; size: bcw.$i * u, 28 * u; corner: 9 * u; cursor: grab }
                on press bchip.$i { bgx = (pointer.x - zx) / u; bgy = (pointer.y - zy) / u; bdx = (pointer.x - mbx) / u; bdy = (pointer.y - mby) / u; bdrag = i; emit bar_lay_grab }
                on release bchip.$i { emit bar_lay_drop }
            }
            repeat pass in 0..2 {
            repeat i in 0..8 {
                let dragging = bdrag == i
              group {
                show: (pass == 0 and not dragging) or (pass == 1 and dragging)
                let chx = mbx + if(dragging, bdx - bgx, bcx.$i) * u     // the chip's top-left and size
                let chy = mby + if(dragging, bdy - bgy, bcy.$i) * u
                let chw = bcw.$i * u
                let chh = 28 * u
                let ccx = chx + chw / 2
                let ccy = chy + chh / 2
                let lit = if(dragging, 1, 0)
                let ink2 = mix(ink, mint, lit)
                box { from: chx, chy; size: chw, chh; corner: 9 * u; color: mix(ink, mint, lit); opacity: if(lit > 0, 24%, 8% + 10% * bchip.$i.hover) }
                box { from: chx, chy; size: chw, chh; corner: 9 * u; stroke: 1.5 * u; color: mint; opacity: 100% * lit }
                //  What each one is, drawn small, as it is on the bar.
                group {
                    show: i == 0
                    box { at: ccx - 13 * u, ccy; size: 3.5 * u, 3.5 * u; corner: 1.75 * u; color: ink2; opacity: 60% }
                    box { at: ccx - 3 * u, ccy; size: 10 * u, 3.5 * u; corner: 1.75 * u; color: mix(mint, ink2, 0) }
                    box { at: ccx + 7 * u, ccy; size: 3.5 * u, 3.5 * u; corner: 1.75 * u; color: ink2; opacity: 60% }
                    box { at: ccx + 14 * u, ccy; size: 3.5 * u, 3.5 * u; corner: 1.75 * u; color: ink2; opacity: 60% }
                }
                text "Window title" { at: floor(ccx + 0.5), floor(ccy + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 600; width: max(10 * u, chw - 12 * u); lines: 1; color: ink2; opacity: 85%; show: i == 1; family: "Space Grotesk" }
                group {
                    show: i == 2
                    path { at: ccx - 12 * u, ccy; color: ink2; move 2.5 * u, -3 * u; line -2 * u, 0; line 2.5 * u, 3 * u; close }
                    path { at: ccx, ccy; color: ink2; move -2.5 * u, -3.5 * u; line 6 * u, 0; line -2.5 * u, 3.5 * u; close }
                    path { at: ccx + 12 * u, ccy; color: ink2; move -2.5 * u, -3 * u; line 2 * u, 0; line -2.5 * u, 3 * u; close }
                }
                group {
                    show: i == 3
                    ellipse { at: ccx, ccy; radius: 3.6 * u; stroke: 1.7 * u; color: ink2 }
                    repeat k in 0..8 {
                        group {
                            pivot: ccx, ccy
                            rotate: k * 45deg
                            box { at: ccx, ccy - 6 * u; size: 2 * u, 2.6 * u; corner: 0.7 * u; color: ink2 }
                        }
                    }
                }
                group {
                    show: i == 4
                    ellipse { at: ccx - 1.2 * u, ccy - 1.2 * u; radius: 4 * u; stroke: 1.6 * u; color: ink2 }
                    line { from: ccx + 1.8 * u, ccy + 1.8 * u; to: ccx + 5 * u, ccy + 5 * u; width: 1.8 * u; color: ink2 }
                }
                group {
                    show: i == 5
                    box { at: ccx, ccy - 3.5 * u; size: 13 * u, 1.5 * u; corner: 0.75 * u; color: ink2 }
                    box { at: ccx, ccy + 3.5 * u; size: 13 * u, 1.5 * u; corner: 0.75 * u; color: ink2 }
                    ellipse { at: ccx + 2.5 * u, ccy - 3.5 * u; radius: 2.4 * u; color: ink2 }
                    ellipse { at: ccx - 2.5 * u, ccy + 3.5 * u; radius: 2.4 * u; color: ink2 }
                }
                group {
                    show: i == 7
                    ellipse { at: ccx - 9 * u, ccy; radius: 3 * u; color: ink2 }
                    ellipse { at: ccx, ccy; radius: 3 * u; color: ink2 }
                    ellipse { at: ccx + 9 * u, ccy; radius: 3 * u; color: ink2 }
                }
                text "4:20" { at: floor(ccx + 0.5), floor(ccy + 0.5); anchor: center; align: center; size: 13 * u; weight: 700; width: chw; lines: 1; color: mix(mint, ink, 0.25); show: i == 6; family: "Space Grotesk" }
              }
            }
            }
        }

        //  The About page: the build (this shell's commit and pleamar's version) and the way to update it.
        //  Checking is a `git fetch`, updating a `git pull --ff-only`, and after that the shell starts again.
        group {
            show: set_pga > 0.01
            opacity: set_pga

            box { at: spx + 219 * u, sby + 70 * u; size: 438 * u, 140 * u; corner: 14 * u; color: ink; opacity: veil }
            box { at: spx + 219 * u, sby + 201 * u; size: 438 * u, 98 * u; corner: 14 * u; color: ink; opacity: veil }
            text "BUILD" { at: floor(spx + 14 * u + 0.5), floor(sby + 13 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }
            text "UPDATE" { at: floor(spx + 14 * u + 0.5), floor(sby + 165 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }

            text "Vitreus" { at: floor(spx + 14 * u + 0.5), floor(sby + 40 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            text about_commit { at: floor(spx + 424 * u + 0.5), floor(sby + 40 * u + 0.5); anchor: right center; size: 12 * u; weight: 600; width: 300 * u; lines: 1; align: right; color: ink; family: "Space Grotesk" }
            text "Committed" { at: floor(spx + 14 * u + 0.5), floor(sby + 66 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            text about_date { at: floor(spx + 424 * u + 0.5), floor(sby + 66 * u + 0.5); anchor: right center; size: 12 * u; weight: 600; width: 300 * u; lines: 1; align: right; color: ink; family: "Space Grotesk" }
            text "Last change" { at: floor(spx + 14 * u + 0.5), floor(sby + 92 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            text about_sub { at: floor(spx + 424 * u + 0.5), floor(sby + 92 * u + 0.5); anchor: right center; size: 11 * u; width: 300 * u; lines: 1; align: right; color: ink; opacity: 85%; family: "Space Grotesk" }
            text "pleamar" { at: floor(spx + 14 * u + 0.5), floor(sby + 118 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            text about_pl { at: floor(spx + 424 * u + 0.5), floor(sby + 118 * u + 0.5); anchor: right center; size: 12 * u; weight: 600; width: 300 * u; lines: 1; align: right; color: ink; family: "Space Grotesk" }

            text about_msg { at: floor(spx + 14 * u + 0.5), floor(sby + 190 * u + 0.5); anchor: left center; size: 11 * u; width: 410 * u; lines: 1; color: if(about_behind > 0, mint, faint); family: "Space Grotesk" }

            //  Check for updates.
            box { at: spx + 78 * u, sby + 226 * u; size: 128 * u, 24 * u; corner: 12 * u; color: ink; opacity: if(about_busy, 5%, 8% + 10% * about_chk_hit.hover) }
            text "Check for updates" { at: floor(spx + 78 * u + 0.5), floor(sby + 226 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 600; width: 124 * u; lines: 1; color: ink; opacity: if(about_busy, 40%, 85%); family: "Space Grotesk" }
            zone box about_chk_hit { at: spx + 78 * u, sby + 226 * u; size: 130 * u, 26 * u; corner: 13 * u; cursor: pointer; active: not about_busy }
            on press about_chk_hit { emit about_check }

            //  Update, and start again: only when there is something to pull.
            box { at: spx + 219 * u, sby + 226 * u; size: 128 * u, 24 * u; corner: 12 * u; color: mint; opacity: if(about_behind > 0 and not about_busy, 24% + 12% * about_upd_hit.hover, 6%) }
            text "Update & restart" { at: floor(spx + 219 * u + 0.5), floor(sby + 226 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 600; width: 124 * u; lines: 1; color: mint; opacity: if(about_behind > 0 and not about_busy, 100%, 35%); family: "Space Grotesk" }
            zone box about_upd_hit { at: spx + 219 * u, sby + 226 * u; size: 130 * u, 26 * u; corner: 13 * u; cursor: pointer; active: about_behind > 0 and not about_busy }
            on press about_upd_hit { emit about_update }

            //  Restart.
            box { at: spx + 360 * u, sby + 226 * u; size: 128 * u, 24 * u; corner: 12 * u; color: ink; opacity: if(about_busy, 5%, 8% + 10% * about_rst_hit.hover) }
            text "Restart shell" { at: floor(spx + 360 * u + 0.5), floor(sby + 226 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 600; width: 124 * u; lines: 1; color: ink; opacity: if(about_busy, 40%, 85%); family: "Space Grotesk" }
            zone box about_rst_hit { at: spx + 360 * u, sby + 226 * u; size: 130 * u, 26 * u; corner: 13 * u; cursor: pointer; active: not about_busy }
            on press about_rst_hit { emit about_restart }
        }

        //  The Hyprland page, after Synoptik's: layout and gaps, border resize and tearing, animations and input.
        //  Every change goes to Hyprland at once and is kept for the next start (see the Hyprland section of
        //  vitreus.luau). It fits the page, so it does not scroll.
        group {
            show: set_pgh > 0.01
            opacity: set_pgh
            let hsl.x0 = spx + 122 * u
            let hsl.w = 250 * u
            let hh = 12 * u

            box { at: spx + 219 * u, sby + 86 * u; size: 438 * u, 172 * u; corner: 14 * u; color: ink; opacity: veil }
            box { at: spx + 219 * u, sby + 213 * u; size: 438 * u, 58 * u; corner: 14 * u; color: ink; opacity: veil }
            box { at: spx + 219 * u, sby + 323 * u; size: 438 * u, 138 * u; corner: 14 * u; color: ink; opacity: veil }
            text "GENERAL & LAYOUT" { at: floor(spx + 14 * u + 0.5), floor(sby + 13 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }
            text "ANIMATIONS" { at: floor(spx + 14 * u + 0.5), floor(sby + 197 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }
            text "INPUT" { at: floor(spx + 14 * u + 0.5), floor(sby + 267 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }

            //  Layout.
            text "Layout" { at: floor(spx + 14 * u + 0.5), floor(sby + 42 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            repeat i in 0..3 {
                let lx = spx + 164 * u + i * 90 * u
                box { at: lx, sby + 42 * u; size: 84 * u, 24 * u; corner: 12 * u; color: if(hy_layout == i + 1, mint, ink); opacity: if(hy_layout == i + 1, 24%, 8% + 10% * hy_lay_hit.$i.hover) }
                text pick(i, "Dwindle", "Master", "Scrolling") { at: floor(lx + 0.5), floor(sby + 42 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 600; width: 80 * u; lines: 1; color: if(hy_layout == i + 1, mint, ink); family: "Space Grotesk" }
                zone box hy_lay_hit.$i { at: lx, sby + 42 * u; size: 86 * u, 26 * u; corner: 13 * u; cursor: pointer }
                on press hy_lay_hit.$i { emit hy_layout_set(i + 1) }
            }

            //  Gaps, 0 to 30 px.
            text "Gaps" { at: floor(spx + 14 * u + 0.5), floor(sby + 78 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            body { color: deep; rim: 9%; box { at: hsl.x0 + hsl.w / 2, sby + 78 * u; size: hsl.w, hh; corner: hh / 2 } }
            group {
                glow: 6 * u, 50%, mint
                body {
                    gradient: hsl.x0, 0 to hsl.x0 + hsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: hsl.x0, sby + 78 * u - hh / 2; size: max(0.1, hsl.w * hy_gaps / 30), hh; corner: hh / 2 }
                }
            }
            text hy_gaps_text { at: floor(spx + 424 * u + 0.5), floor(sby + 78 * u + 0.5); anchor: right center; size: 13 * u; weight: 600; color: ink; family: "Space Grotesk" }
            zone box hy_gaps_hit { at: hsl.x0 + hsl.w / 2, sby + 78 * u; size: hsl.w + 24 * u, 30 * u; cursor: pointer }
            on press hy_gaps_hit { emit hy_gaps_set(clamp((pointer.x - hsl.x0) / hsl.w, 0, 1)) }
            on drag hy_gaps_hit { emit hy_gaps_set(clamp((pointer.x - hsl.x0) / hsl.w, 0, 1)) }

            //  Sensitivity, -1 to 1.
            text "Sensitivity" { at: floor(spx + 14 * u + 0.5), floor(sby + 296 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            body { color: deep; rim: 9%; box { at: hsl.x0 + hsl.w / 2, sby + 296 * u; size: hsl.w, hh; corner: hh / 2 } }
            group {
                glow: 6 * u, 50%, mint
                body {
                    gradient: hsl.x0, 0 to hsl.x0 + hsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: hsl.x0, sby + 296 * u - hh / 2; size: max(0.1, hsl.w * (hy_sens + 1) / 2), hh; corner: hh / 2 }
                }
            }
            box { at: hsl.x0 + hsl.w / 2, sby + 296 * u; size: 1.5 * u, hh + 6 * u; corner: 0.75 * u; color: ink; opacity: 40% }
            text hy_sens_text { at: floor(spx + 424 * u + 0.5), floor(sby + 296 * u + 0.5); anchor: right center; size: 13 * u; weight: 600; color: ink; family: "Space Grotesk" }
            zone box hy_sens_hit { at: hsl.x0 + hsl.w / 2, sby + 296 * u; size: hsl.w + 24 * u, 30 * u; cursor: pointer }
            on press hy_sens_hit { emit hy_sens_set(clamp((pointer.x - hsl.x0) / hsl.w, 0, 1)) }
            on drag hy_sens_hit { emit hy_sens_set(clamp((pointer.x - hsl.x0) / hsl.w, 0, 1)) }

            //  Focus follows the mouse: off, on, loose, full.
            text "Follow mouse" { at: floor(spx + 14 * u + 0.5), floor(sby + 332 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            repeat i in 0..4 {
                let fx = spx + 152 * u + i * 66 * u
                box { at: fx, sby + 332 * u; size: 60 * u, 24 * u; corner: 12 * u; color: if(hy_follow == i, mint, ink); opacity: if(hy_follow == i, 24%, 8% + 10% * hy_fol_hit.$i.hover) }
                text pick(i, "Off", "On", "Loose", "Full") { at: floor(fx + 0.5), floor(sby + 332 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 600; width: 56 * u; lines: 1; color: if(hy_follow == i, mint, ink); family: "Space Grotesk" }
                zone box hy_fol_hit.$i { at: fx, sby + 332 * u; size: 62 * u, 26 * u; corner: 13 * u; cursor: pointer }
                on press hy_fol_hit.$i { emit hy_follow_set(i) }
            }

            //  The switches: resize from the border, tearing, animations, natural scroll.
            repeat i in 0..4 {
                let ty = sby + pick(i, 114, 148, 222, 368) * u
                let tk = pick(i, hy_k0, hy_k1, hy_k2, hy_k3)
                text pick(i, "Resize from border", "Allow screen tearing", "Window manager animations", "Natural scroll (touchpad)") { at: floor(spx + 14 * u + 0.5), floor(ty - 6 * u + 0.5); anchor: left center; size: 11.5 * u; weight: 600; color: ink; family: "Space Grotesk" }
                text pick(i, "Grab a window's edge anywhere to resize it", "Lets opted-in fullscreen apps skip vsync", "Hyprland's own window and workspace motion", "Reverses the touchpad's scroll direction") { at: floor(spx + 14 * u + 0.5), floor(ty + 8 * u + 0.5); anchor: left center; size: 9.5 * u; color: faint; family: "Space Grotesk" }
                box { at: spx + 404 * u, ty; size: 40 * u, 22 * u; corner: 11 * u; color: mix(ink, mint, tk); opacity: 14% + 34% * tk + 8% * hy_tg_hit.$i.hover }
                ellipse { at: spx + (404 - 9 + 18 * tk) * u, ty; radius: 8 * u; color: mix(ink, mint, tk); opacity: 80% + 20% * tk }
                zone box hy_tg_hit.$i { at: spx + 219 * u, ty; size: 430 * u, 32 * u; corner: 10 * u; cursor: pointer }
                on press hy_tg_hit.$i { emit hy_toggle(i) }
            }
        }

        //  The Display page, after Synoptik's: the monitors on a canvas you can drag them on, an inspector for the
        //  one that is selected (mode, refresh rate, scale, rotation, SDR levels), and saved profiles. What it
        //  edits is a draft; Apply sends it to Hyprland and the change is on trial until it is kept (see the Display
        //  section of vitreus.luau).
        group {
            show: set_pgd > 0.01
            opacity: set_pgd
            let disp.sc = clamp(disp_scroll, 0, max(0, disp.h - 456))     // how far the page is scrolled, unscaled
            let disp.off = disp.sc * u
            let cvx = spx + 19 * u
            let cvy = sby + 26 * u
            let dtop = sby + 140 * u                      // the inspector card's top
            let ptop = sby + 460 * u                      // the profiles card's top

            //  The page scrolls: everything below moves up by `disp.off` inside a viewport as tall as the Wallpaper page
            //  (456), and only the controls that are in view are live, so one scrolled out of sight catches no click
            //  (a clip does not stop a zone). The wheel is caught by the zone under everything else.
            clip box { at: spx + 224 * u, sby + 228 * u; size: 456 * u, 456 * u }
            zone box disp_wheel { at: spx + 219 * u, sby + 228 * u; size: 446 * u, 456 * u }
            on scroll disp_wheel { disp_scroll_to = clamp(disp_scroll_to + wheel * 40, 0, max(0, disp.h - 456)) }
            group {
                move: 0, -disp.off

            //  ── Card one: the monitors ──
            box { at: spx + 219 * u, sby + 66 * u; size: 438 * u, 132 * u; corner: 14 * u; color: ink; opacity: veil }
            text "MONITORS" { at: floor(spx + 14 * u + 0.5), floor(sby + 13 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }
            box { at: spx + 322 * u, sby + 13 * u; size: 92 * u, 20 * u; corner: 10 * u; color: ink; opacity: (8% + 10% * disp_arr_hit.hover) * (40% + 60% * clamp(disp_count - 1, 0, 1)) }
            text "Auto-arrange" { at: floor(spx + 322 * u + 0.5), floor(sby + 13 * u + 0.5); anchor: center; align: center; size: 10 * u; weight: 600; width: 88 * u; lines: 1; color: ink; opacity: 85% * (40% + 60% * clamp(disp_count - 1, 0, 1)); family: "Space Grotesk" }
            zone box disp_arr_hit { at: spx + 322 * u, sby + 13 * u; size: 94 * u, 22 * u; corner: 11 * u; cursor: pointer; active: (disp_count > 1) and (sby + 13 * u) - disp.off > sby and (sby + 13 * u) - disp.off < sby + 456 * u }
            on press disp_arr_hit { emit disp_arrange }
            box { at: spx + 394 * u, sby + 13 * u; size: 48 * u, 20 * u; corner: 10 * u; color: ink; opacity: (8% + 10% * disp_swap_hit.hover) * (40% + 60% * clamp(disp_count - 1, 0, 1)) }
            text "Swap" { at: floor(spx + 394 * u + 0.5), floor(sby + 13 * u + 0.5); anchor: center; align: center; size: 10 * u; weight: 600; width: 44 * u; lines: 1; color: ink; opacity: 85% * (40% + 60% * clamp(disp_count - 1, 0, 1)); family: "Space Grotesk" }
            zone box disp_swap_hit { at: spx + 394 * u, sby + 13 * u; size: 50 * u, 22 * u; corner: 11 * u; cursor: pointer; active: (disp_count > 1) and (sby + 13 * u) - disp.off > sby and (sby + 13 * u) - disp.off < sby + 456 * u }
            on press disp_swap_hit { emit disp_swap }
            box { at: cvx + 200 * u, cvy + 48 * u; size: 400 * u, 96 * u; corner: 10 * u; color: #000000; opacity: 22% }
            repeat i in 0..4 {
                let bx = cvx + disp_b.$i.x * u
                let by = cvy + disp_b.$i.y * u
                let bw = disp_b.$i.w * u
                let bh = disp_b.$i.h * u
                box { from: bx, by; size: bw, bh; corner: 6 * u; color: if(disp_b.$i.sel, mint, ink); opacity: if(disp_b.$i.on, if(disp_b.$i.sel, 26%, 12%) + 6% * disp_mz.$i.hover, 0%) }
                box { from: bx, by; size: bw, bh; corner: 6 * u; stroke: 1.5 * u; color: mint; opacity: if(disp_b.$i.on and disp_b.$i.sel, 100%, 0%) }
                ellipse { at: bx + bw - 7 * u, by + 7 * u; radius: 2.5 * u; color: mint; opacity: if(disp_b.$i.on and disp_b.$i.dirty, 100%, 0%) }
                text disp_b.$i.name { at: floor(bx + bw / 2 + 0.5), floor(by + bh / 2 - 6 * u + 0.5); anchor: center; align: center; size: 11 * u; weight: 700; width: max(10 * u, bw - 8 * u); lines: 1; color: ink; show: disp_b.$i.on; family: "Space Grotesk" }
                text disp_b.$i.mode { at: floor(bx + bw / 2 + 0.5), floor(by + bh / 2 + 7 * u + 0.5); anchor: center; align: center; size: 9 * u; width: max(10 * u, bw - 8 * u); lines: 1; color: faint; show: disp_b.$i.on and bh > 30 * u; family: "Space Grotesk" }
                zone box disp_mz.$i { from: bx, by; size: bw, bh; cursor: grab; active: (disp_b.$i.on) and (by + (bh) / 2) - disp.off > sby and (by + (bh) / 2) - disp.off < sby + 456 * u }
                on press disp_mz.$i { disp_grab_i = i; disp_px = (pointer.x - cvx) / u; disp_py = (pointer.y - (cvy - disp.off)) / u; emit disp_grab }
                on drag disp_mz.$i { disp_px = (pointer.x - cvx) / u; disp_py = (pointer.y - (cvy - disp.off)) / u; emit disp_drag }
                on release disp_mz.$i { emit disp_drop }
            }

            //  ── Card two: the inspector ──
            box { at: spx + 219 * u, dtop + 156 * u; size: 438 * u, 312 * u; corner: 14 * u; color: ink; opacity: veil }
            text "INSPECTOR" { at: floor(spx + 14 * u + 0.5), floor(dtop + 13 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }
            repeat i in 0..4 {
                let pxx = spx + 424 * u - 30 * u - i * 64 * u
                box { at: pxx, dtop + 13 * u; size: 58 * u, 20 * u; corner: 10 * u; color: if(disp_sel == 3 - i, mint, ink); opacity: if(disp_pill.$i.on, if(disp_sel == 3 - i, 24%, 8% + 10% * disp_pill_hit.$i.hover), 0%) }
                text disp_pill.$i.text { at: floor(pxx + 0.5), floor(dtop + 13 * u + 0.5); anchor: center; align: center; size: 10 * u; weight: 600; width: 54 * u; lines: 1; color: if(disp_sel == 3 - i, mint, ink); show: disp_pill.$i.on; family: "Space Grotesk" }
                zone box disp_pill_hit.$i { at: pxx, dtop + 13 * u; size: 60 * u, 22 * u; corner: 11 * u; cursor: pointer; active: (disp_pill.$i.on) and (dtop + 13 * u) - disp.off > sby and (dtop + 13 * u) - disp.off < sby + 456 * u }
                on press disp_pill_hit.$i { emit disp_pick_mon(3 - i) }
            }
            text disp_title { at: floor(spx + 14 * u + 0.5), floor(dtop + 36 * u + 0.5); anchor: left center; size: 13 * u; weight: 700; color: ink; family: "Space Grotesk" }
            text disp_desc { at: floor(spx + 14 * u + 0.5), floor(dtop + 52 * u + 0.5); anchor: left center; size: 10 * u; width: 410 * u; lines: 1; color: faint; family: "Space Grotesk" }
            text disp_cur { at: floor(spx + 14 * u + 0.5), floor(dtop + 67 * u + 0.5); anchor: left center; size: 10 * u; width: 410 * u; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk" }

            //  Resolution: a dropdown of what the monitor offers, biggest first (the list itself is drawn last, below).
            text "Resolution" { at: floor(spx + 14 * u + 0.5), floor(dtop + 98 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            let rtw = disp_rw.width + 44 * u                 // the trigger: its text and room for the chevron
            let rx0 = spx + 122 * u                          // its left edge: the one every control below starts at, like the sliders
            box { from: rx0, dtop + 85 * u; size: rtw, 26 * u; corner: 13 * u; color: ink; opacity: 8% + 8% * disp_res_hit.hover + 6% * disp_dd }
            box { from: rx0, dtop + 85 * u; size: rtw, 26 * u; corner: 13 * u; stroke: 1.2 * u; color: mint; opacity: 70% * disp_dd }
            text disp_res_text { at: floor(rx0 + 16 * u + 0.5), floor(dtop + 98 * u + 0.5); anchor: left center; size: 12 * u; weight: 700; color: ink; measure: disp_rw; family: "Space Grotesk" }
            path { at: rx0 + rtw - 17 * u, dtop + 98 * u; stroke: 1.6 * u; color: ink; opacity: 60% + 40% * disp_res_hit.hover; move -4 * u, (-2 + 4 * disp_dd) * u; line 0, (2 - 4 * disp_dd) * u; line 4 * u, (-2 + 4 * disp_dd) * u }
            zone box disp_res_hit { from: rx0, dtop + 85 * u; size: rtw, 26 * u; corner: 13 * u; cursor: pointer; active: (disp_res_count > 1) and (dtop + 85 * u + (26 * u) / 2) - disp.off > sby and (dtop + 85 * u + (26 * u) / 2) - disp.off < sby + 456 * u }
            on press disp_res_hit { toggle disp_res_open }

            //  Refresh rate: the rates this resolution has.
            text "Refresh rate" { at: floor(spx + 14 * u + 0.5), floor(dtop + 130 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            repeat i in 0..6 {
                let hx = spx + 148 * u + i * 56 * u                // 122 + half a chip: the shared left edge
                box { at: hx, dtop + 130 * u; size: 52 * u, 24 * u; corner: 12 * u; color: if(disp_hz.$i.lit, mint, ink); opacity: if(disp_hz.$i.on, if(disp_hz.$i.lit, 24%, 8% + 10% * disp_hz_hit.$i.hover), 0%) }
                text disp_hz.$i.text { at: floor(hx + 0.5), floor(dtop + 130 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 600; width: 50 * u; lines: 1; color: if(disp_hz.$i.lit, mint, ink); show: disp_hz.$i.on; family: "Space Grotesk" }
                zone box disp_hz_hit.$i { at: hx, dtop + 130 * u; size: 54 * u, 26 * u; corner: 13 * u; cursor: pointer; active: (disp_hz.$i.on) and (dtop + 130 * u) - disp.off > sby and (dtop + 130 * u) - disp.off < sby + 456 * u }
                on press disp_hz_hit.$i { emit disp_pick_hz(i) }
            }

            //  Scale.
            text "Scale" { at: floor(spx + 14 * u + 0.5), floor(dtop + 162 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            repeat i in 0..7 {
                let sx = spx + 142 * u + i * 44 * u
                box { at: sx, dtop + 162 * u; size: 40 * u, 24 * u; corner: 12 * u; color: if(disp_scale == i, mint, ink); opacity: if(disp_scale == i, 24%, 8% + 10% * disp_sc_hit.$i.hover) }
                text pick(i, "Auto", "1.0×", "1.25×", "1.33×", "1.5×", "1.75×", "2.0×") { at: floor(sx + 0.5), floor(dtop + 162 * u + 0.5); anchor: center; align: center; size: 10 * u; weight: 600; width: 38 * u; lines: 1; color: if(disp_scale == i, mint, ink); family: "Space Grotesk" }
                zone box disp_sc_hit.$i { at: sx, dtop + 162 * u; size: 42 * u, 26 * u; corner: 13 * u; cursor: pointer; active: (dtop + 162 * u) - disp.off > sby and (dtop + 162 * u) - disp.off < sby + 456 * u }
                on press disp_sc_hit.$i { emit disp_pick_scale(i) }
            }

            //  Rotation.
            text "Rotation" { at: floor(spx + 14 * u + 0.5), floor(dtop + 194 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            repeat i in 0..4 {
                let rx = spx + 152 * u + i * 66 * u
                box { at: rx, dtop + 194 * u; size: 60 * u, 24 * u; corner: 12 * u; color: if(disp_rot == i, mint, ink); opacity: if(disp_rot == i, 24%, 8% + 10% * disp_rot_hit.$i.hover) }
                text pick(i, "Normal", "90°", "180°", "270°") { at: floor(rx + 0.5), floor(dtop + 194 * u + 0.5); anchor: center; align: center; size: 10 * u; weight: 600; width: 56 * u; lines: 1; color: if(disp_rot == i, mint, ink); family: "Space Grotesk" }
                zone box disp_rot_hit.$i { at: rx, dtop + 194 * u; size: 62 * u, 26 * u; corner: 13 * u; cursor: pointer; active: (dtop + 194 * u) - disp.off > sby and (dtop + 194 * u) - disp.off < sby + 456 * u }
                on press disp_rot_hit.$i { emit disp_pick_rot(i) }
            }

            //  SDR brightness (1.00 to 2.00) and saturation (0.90 to 1.10), for HDR modes.
            let dsl.x0 = spx + 122 * u
            let dsl.w = 250 * u
            let dh = 12 * u
            text "SDR brightness" { at: floor(spx + 14 * u + 0.5), floor(dtop + 226 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            body { color: deep; rim: 9%; box { at: dsl.x0 + dsl.w / 2, dtop + 226 * u; size: dsl.w, dh; corner: dh / 2 } }
            group {
                glow: 6 * u, 50%, mint
                body { gradient: dsl.x0, 0 to dsl.x0 + dsl.w, 0, mintlo, mint 55%, minthi; rim: 22%; box { from: dsl.x0, dtop + 226 * u - dh / 2; size: max(0.1, dsl.w * clamp(disp_sdrb - 1, 0, 1)), dh; corner: dh / 2 } }
            }
            text disp_sdrb_text { at: floor(spx + 424 * u + 0.5), floor(dtop + 226 * u + 0.5); anchor: right center; size: 13 * u; weight: 600; color: ink; family: "Space Grotesk" }
            zone box disp_sdrb_hit { at: dsl.x0 + dsl.w / 2, dtop + 226 * u; size: dsl.w + 24 * u, 30 * u; cursor: pointer; active: (dtop + 226 * u) - disp.off > sby and (dtop + 226 * u) - disp.off < sby + 456 * u }
            on press disp_sdrb_hit { emit disp_sdrb_set(clamp((pointer.x - dsl.x0) / dsl.w, 0, 1)) }
            on drag disp_sdrb_hit { emit disp_sdrb_set(clamp((pointer.x - dsl.x0) / dsl.w, 0, 1)) }
            text "SDR saturation" { at: floor(spx + 14 * u + 0.5), floor(dtop + 256 * u + 0.5); anchor: left center; size: 11 * u; color: faint; family: "Space Grotesk" }
            body { color: deep; rim: 9%; box { at: dsl.x0 + dsl.w / 2, dtop + 256 * u; size: dsl.w, dh; corner: dh / 2 } }
            group {
                glow: 6 * u, 50%, mint
                body { gradient: dsl.x0, 0 to dsl.x0 + dsl.w, 0, mintlo, mint 55%, minthi; rim: 22%; box { from: dsl.x0, dtop + 256 * u - dh / 2; size: max(0.1, dsl.w * clamp((disp_sdrs - 0.9) / 0.2, 0, 1)), dh; corner: dh / 2 } }
            }
            text disp_sdrs_text { at: floor(spx + 424 * u + 0.5), floor(dtop + 256 * u + 0.5); anchor: right center; size: 13 * u; weight: 600; color: ink; family: "Space Grotesk" }
            zone box disp_sdrs_hit { at: dsl.x0 + dsl.w / 2, dtop + 256 * u; size: dsl.w + 24 * u, 30 * u; cursor: pointer; active: (dtop + 256 * u) - disp.off > sby and (dtop + 256 * u) - disp.off < sby + 456 * u }
            on press disp_sdrs_hit { emit disp_sdrs_set(clamp((pointer.x - dsl.x0) / dsl.w, 0, 1)) }
            on drag disp_sdrs_hit { emit disp_sdrs_set(clamp((pointer.x - dsl.x0) / dsl.w, 0, 1)) }

            //  The bottom row: what it says while nothing is on trial (and Reset, Apply), and while something is
            //  (and Keep, Revert): the question is here, where the eyes are after pressing Apply.
            text disp_msg { at: floor(spx + 14 * u + 0.5), floor(dtop + 286 * u + 0.5); anchor: left center; size: 10 * u; width: 250 * u; lines: 1; color: mint; show: disp_trial <= 0; family: "Space Grotesk" }
            text "HDR is experimental in Hyprland: some apps look washed out." { at: floor(spx + 14 * u + 0.5), floor(dtop + 300 * u + 0.5); anchor: left center; size: 9 * u; width: 300 * u; lines: 1; color: faint; opacity: 80%; show: disp_trial <= 0; family: "Space Grotesk" }
            box { at: spx + 314 * u, dtop + 294 * u; size: 56 * u, 24 * u; corner: 12 * u; color: ink; opacity: if(disp_trial <= 0, 8% + 10% * disp_reset_hit.hover, 0%) }
            text "Reset" { at: floor(spx + 314 * u + 0.5), floor(dtop + 294 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 600; color: ink; opacity: 85%; show: disp_trial <= 0; family: "Space Grotesk" }
            zone box disp_reset_hit { at: spx + 314 * u, dtop + 294 * u; size: 58 * u, 26 * u; corner: 13 * u; cursor: pointer; active: (disp_trial <= 0) and (dtop + 294 * u) - disp.off > sby and (dtop + 294 * u) - disp.off < sby + 456 * u }
            on press disp_reset_hit { emit disp_reset }
            box { at: spx + 384 * u, dtop + 294 * u; size: 64 * u, 24 * u; corner: 12 * u; color: mint; opacity: if(disp_trial <= 0, (35% + 65% * if(disp_dirty, 1, 0)) * (85% + 15% * disp_apply_hit.hover), 0%) }
            text "Apply" { at: floor(spx + 384 * u + 0.5), floor(dtop + 294 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 700; color: onmint; show: disp_trial <= 0; family: "Space Grotesk" }
            zone box disp_apply_hit { at: spx + 384 * u, dtop + 294 * u; size: 66 * u, 26 * u; corner: 13 * u; cursor: pointer; active: (disp_trial <= 0 and disp_dirty) and (dtop + 294 * u) - disp.off > sby and (dtop + 294 * u) - disp.off < sby + 456 * u }
            on press disp_apply_hit { emit disp_apply }
            text disp_trial_text { at: floor(spx + 14 * u + 0.5), floor(dtop + 294 * u + 0.5); anchor: left center; size: 11 * u; weight: 600; width: 250 * u; lines: 1; color: mint; show: disp_trial > 0; family: "Space Grotesk" }
            box { at: spx + 314 * u, dtop + 294 * u; size: 64 * u, 24 * u; corner: 12 * u; color: ink; opacity: if(disp_trial > 0, 8% + 12% * disp_revert_hit.hover, 0%) }
            text "Revert" { at: floor(spx + 314 * u + 0.5), floor(dtop + 294 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 600; color: ink; show: disp_trial > 0; family: "Space Grotesk" }
            zone box disp_revert_hit { at: spx + 314 * u, dtop + 294 * u; size: 66 * u, 26 * u; corner: 13 * u; cursor: pointer; active: (disp_trial > 0) and (dtop + 294 * u) - disp.off > sby and (dtop + 294 * u) - disp.off < sby + 456 * u }
            on press disp_revert_hit { emit disp_revert }
            box { at: spx + 388 * u, dtop + 294 * u; size: 64 * u, 24 * u; corner: 12 * u; color: mint; opacity: if(disp_trial > 0, 85% + 15% * disp_keep_hit.hover, 0%) }
            text "Keep" { at: floor(spx + 388 * u + 0.5), floor(dtop + 294 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 700; color: onmint; show: disp_trial > 0; family: "Space Grotesk" }
            zone box disp_keep_hit { at: spx + 388 * u, dtop + 294 * u; size: 66 * u, 26 * u; corner: 13 * u; cursor: pointer; active: (disp_trial > 0) and (dtop + 294 * u) - disp.off > sby and (dtop + 294 * u) - disp.off < sby + 456 * u }
            on press disp_keep_hit { emit disp_keep }

            //  ── Card three: the profiles ──
            box { at: spx + 219 * u, ptop + (disp.prows + 106) / 2 * u; size: 438 * u, (disp.prows + 106) * u; corner: 14 * u; color: ink; opacity: veil }
            text "PROFILES" { at: floor(spx + 14 * u + 0.5), floor(ptop + 13 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }
            text "Reapply when these displays are connected" { at: floor(spx + 350 * u + 0.5), floor(ptop + 13 * u + 0.5); anchor: right center; size: 9.5 * u; color: faint; family: "Space Grotesk" }
            body { color: mix(off, mint, disp_auto_pill); box { at: spx + 405 * u, ptop + 13 * u; size: 38 * u, 22 * u; corner: 11 * u } }
            box { at: spx + 397 * u + disp_auto_pill * 16 * u, ptop + 13 * u; size: (17 + 9 * clamp(4 * disp_auto_pill * (1 - disp_auto_pill), 0, 1)) * u, (17 - 3 * clamp(4 * disp_auto_pill * (1 - disp_auto_pill), 0, 1)) * u; corner: (8.5 - 1.5 * clamp(4 * disp_auto_pill * (1 - disp_auto_pill), 0, 1)) * u; color: ink }
            zone box disp_auto_hit { at: spx + 405 * u, ptop + 13 * u; size: 46 * u, 30 * u; cursor: pointer; active: (ptop + 13 * u) - disp.off > sby and (ptop + 13 * u) - disp.off < sby + 456 * u }
            on press disp_auto_hit { emit disp_auto_toggle }
            text "Connected now: {disp_topo}" { at: floor(spx + 14 * u + 0.5), floor(ptop + 36 * u + 0.5); anchor: left center; size: 10.5 * u; width: 410 * u; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
            text "No saved profiles yet" { at: floor(spx + 219 * u + 0.5), floor(ptop + 74 * u + 0.5); anchor: center; size: 11 * u; color: faint; opacity: 1 - clamp(disp_pn_s, 0, 1); show: disp_pcount < 1; family: "Space Grotesk" }
            repeat i in 0..4 {
                let ry = ptop + 62 * u + i * 30 * u
                let rowon = clamp(disp_pn_s - i, 0, 1)
                box { at: spx + 219 * u, ry + 13 * u; size: 410 * u, 26 * u; corner: 10 * u; color: ink; opacity: if(disp_p.$i.on, 6% + 6% * disp_p.$i.active, 0%) * rowon }
                ellipse { at: spx + 30 * u, ry + 13 * u; radius: 3 * u; color: mint; opacity: if(disp_p.$i.on and disp_p.$i.active, 100%, 0%) }
                text disp_p.$i.name { at: floor(spx + 42 * u + 0.5), floor(ry + 13 * u + 0.5); anchor: left center; size: 11.5 * u; weight: 700; width: 130 * u; lines: 1; color: ink; show: disp_p.$i.on; family: "Space Grotesk" }
                text disp_p.$i.sub { at: floor(spx + 180 * u + 0.5), floor(ry + 13 * u + 0.5); anchor: left center; size: 10 * u; width: 150 * u; lines: 1; color: faint; show: disp_p.$i.on; family: "Space Grotesk" }
                box { at: spx + 355 * u, ry + 13 * u; size: 52 * u, 20 * u; corner: 10 * u; color: mint; opacity: if(disp_p.$i.on, 16% + 14% * disp_pa_hit.$i.hover, 0%) }
                text "Apply" { at: floor(spx + 355 * u + 0.5), floor(ry + 13 * u + 0.5); anchor: center; align: center; size: 10 * u; weight: 600; color: mint; show: disp_p.$i.on; family: "Space Grotesk" }
                zone box disp_pa_hit.$i { at: spx + 355 * u, ry + 13 * u; size: 54 * u, 22 * u; corner: 11 * u; cursor: pointer; active: (disp_p.$i.on and disp_trial <= 0) and (ry + 13 * u) - disp.off > sby and (ry + 13 * u) - disp.off < sby + 456 * u }
                on press disp_pa_hit.$i { emit disp_profile_apply(i) }
                line { from: spx + 400.5 * u, ry + 9.5 * u; to: spx + 407.5 * u, ry + 16.5 * u; width: 1.4 * u; color: ink; opacity: if(disp_p.$i.on, 45% + 45% * disp_pd_hit.$i.hover, 0%) }
                line { from: spx + 407.5 * u, ry + 9.5 * u; to: spx + 400.5 * u, ry + 16.5 * u; width: 1.4 * u; color: ink; opacity: if(disp_p.$i.on, 45% + 45% * disp_pd_hit.$i.hover, 0%) }
                zone box disp_pd_hit.$i { at: spx + 404 * u, ry + 13 * u; size: 22 * u, 22 * u; corner: 11 * u; cursor: pointer; active: (disp_p.$i.on) and (ry + 13 * u) - disp.off > sby and (ry + 13 * u) - disp.off < sby + 456 * u }
                on press disp_pd_hit.$i { emit disp_profile_delete(i) }
            }
            box { at: spx + 130 * u, ptop + (62 + disp.prows + 21) * u; size: 232 * u, 26 * u; corner: 13 * u; color: ink; opacity: 8% }
            input disp_profile_name { at: spx + 26 * u, ptop + (62 + disp.prows + 15.5) * u; width: 210 * u; size: 11 * u; color: ink; family: "Space Grotesk"; placeholder: "Name for the current arrangement" }
            box { at: spx + 350 * u, ptop + (62 + disp.prows + 21) * u; size: 106 * u, 26 * u; corner: 13 * u; color: mint; opacity: 85% + 15% * disp_save_hit.hover }
            text "Save current" { at: floor(spx + 350 * u + 0.5), floor(ptop + (62 + disp.prows + 21) * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 700; color: onmint; family: "Space Grotesk" }
            zone box disp_save_hit { at: spx + 350 * u, ptop + (62 + disp.prows + 21) * u; size: 108 * u, 28 * u; corner: 14 * u; cursor: pointer; active: (ptop + (62 + disp.prows + 21) * u) - disp.off > sby and (ptop + (62 + disp.prows + 21) * u) - disp.off < sby + 456 * u }
            on press disp_save_hit { emit disp_profile_save }

            //  ── The resolution dropdown, drawn last so its rows win the press over everything under it ──
            zone box disp_res_catch { at: spx + 219 * u, dtop + 156 * u; size: 438 * u, 312 * u; active: (disp_res_open) and (dtop + 156 * u) - disp.off > sby and (dtop + 156 * u) - disp.off < sby + 456 * u }
            on press disp_res_catch { disp_res_open = false }
            group {
                show: disp_dd > 0.02
                opacity: disp_dd
                move: 0, (disp_dd - 1) * 6 * u
                let rdh = (disp_res_count * 24 + 10) * u
                let rdw = max(rtw, (disp_res_chars * 7.4 + 34) * u)   // its longest option, and never narrower than the trigger
                body {
                    color: panel
                    rim: 12%
                    shadow: 0, 6 * u, 18 * u, 40%, #000000
                    box { at: rx0 + rdw / 2, dtop + 116 * u + rdh / 2; size: rdw, rdh; corner: 14 * u }
                }
                repeat i in 0..14 {
                    let ry = dtop + 116 * u + 5 * u + i * 24 * u + 12 * u
                    box { at: rx0 + rdw / 2, ry; size: rdw - 10 * u, 22 * u; corner: 11 * u; color: if(disp_r.$i.lit, mint, ink); opacity: if(disp_r.$i.on, if(disp_r.$i.lit, 24%, 0%) + 10% * disp_rr_hit.$i.hover, 0%) }
                    text disp_r.$i.text { at: floor(rx0 + 16 * u + 0.5), floor(ry + 0.5); anchor: left center; size: 11.5 * u; weight: 600; width: rdw - 24 * u; lines: 1; color: if(disp_r.$i.lit, mint, ink); show: disp_r.$i.on; family: "Space Grotesk" }
                    zone box disp_rr_hit.$i { at: rx0 + rdw / 2, ry; size: rdw - 8 * u, 24 * u; corner: 12 * u; cursor: pointer; active: (disp_r.$i.on and disp_res_open) and (ry) - disp.off > sby and (ry) - disp.off < sby + 456 * u }
                    on press disp_rr_hit.$i { emit disp_pick_res(i); disp_res_open = false }
                }
            }
            }

            //  The scrollbar: a thumb as tall as the viewport is of the page, shown when there is something to scroll to.
            let thh = 456 * 456 / max(456, disp.h)
            let thy = thh / 2 + disp.sc / max(1, disp.h - 456) * (456 - thh)
            box { at: spx + 442 * u, sby + 228 * u; size: 3 * u, 456 * u; corner: 1.5 * u; color: ink; opacity: if(disp.h > 456, 6%, 0%) }
            box { at: spx + 442 * u, sby + thy * u; size: 3 * u, thh * u; corner: 1.5 * u; color: mint; opacity: if(disp.h > 456, 55%, 0%) }
            //  The cue that there is more below: the page fades into the panel and a small "More" pill bobs at the
            //  foot of the view. It goes away at the end of the page, and pressing it scrolls a screenful down.
            let cue = clamp((disp.h - 456 - disp.sc) / 24, 0, 1)
            let cuey = sby + (456 - 26) * u + 2.5 * u * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * u, sby + (400 + i * 3.5) * u; size: 448 * u, 3.5 * u + 0.5; color: deep; opacity: 45% * fk * fk * cue }
            }
            box { at: spx + 224 * u, cuey; size: 76 * u, 26 * u; corner: 13 * u; color: deep; opacity: 80% * cue }
            box { at: spx + 224 * u, cuey; size: 76 * u, 26 * u; corner: 13 * u; color: mint; opacity: (10% + 14% * disp_cue_hit.hover) * cue }
            path { at: spx + 204 * u, cuey - 1 * u; stroke: 1.6 * u; color: mint; opacity: cue; move -4 * u, -3 * u; line 0, 1 * u; line 4 * u, -3 * u }
            path { at: spx + 204 * u, cuey + 4 * u; stroke: 1.6 * u; color: mint; opacity: cue; move -4 * u, -3 * u; line 0, 1 * u; line 4 * u, -3 * u }
            text "More" { at: spx + 232 * u, cuey; anchor: center; size: 11 * u; weight: 700; color: ink; opacity: cue; family: "Space Grotesk" }
            zone box disp_cue_hit { at: spx + 224 * u, sby + (456 - 26) * u; size: 76 * u, 26 * u; corner: 13 * u; cursor: pointer; active: cue > 0.5 }
            on press disp_cue_hit { disp_scroll_to = clamp(disp_scroll_to + 342, 0, max(0, disp.h - 456)) }
            zone box disp_bar_hit { at: spx + 442 * u, sby + 228 * u; size: 14 * u, 456 * u; cursor: pointer; active: disp.h > 456 }
            on press disp_bar_hit { disp_scroll_to = clamp(((pointer.y - sby) / u - thh / 2) / max(1, 456 - thh) * (disp.h - 456), 0, max(0, disp.h - 456)) }
            on drag disp_bar_hit { disp_scroll_to = clamp(((pointer.y - sby) / u - thh / 2) / max(1, 456 - thh) * (disp.h - 456), 0, max(0, disp.h - 456)) }
        }
    }
    prop volume_level = 0 ~calm
    follow volume_level = if(audio.muted, 0, audio.volume)
    prop bright_level = 0 ~calm
    follow bright_level = brightness.level
    // ── dismissing the panel ─────────────────────────────────────
    //  Escape closes it. The scene only asks for the keyboard while the panel is
    //  open (see `surface`), so typing goes to your apps the rest of the time.
    on key Down while panel == launch { emit launch_move(1) }
    on key Up while panel == launch { emit launch_move(-1) }
    on key Tab while panel == launch { emit launch_move(1) }
    on key Ctrl+n while panel == launch { emit launch_move(1) }
    on key Ctrl+p while panel == launch { emit launch_move(-1) }
    on submit lq { emit launch_run }
    on key Escape while dd_open { dd_open = false }
    on key Escape while panel != none and not dd_open { panel = none }
}
