    component LRow(t: record, pick: event, del: event, ctx: event) {
        size: lw, 40 * pu
        //  How much the remove button shows (see the end of the row).
        let rm = if(t.deletable, max(max(touch.hover, rm_z.hover), if(t.sel, 0.45, 0)), 0)
        zone box touch { from: 0, 0; size: lw, 40 * pu; corner: 14 * pu; cursor: pointer }
        //  Obsidian: a row is a solid step lighter than the shell (no shadow: there are many), mint while chosen.
        body { color: mix(obsidian, if(t.sel, mint, ink), (if(t.sel, 20%, 4%) + 8% * touch.hover) * if(t.sel, 1, 1.6)); opacity: obs; show: obs > 0.004; box { from: 0, 0; size: lw, 40 * pu; corner: 14 * pu } }
        box { from: 0, 0; size: lw, 40 * pu; corner: 14 * pu; color: if(t.sel, mint, ink); opacity: (if(t.sel, 20%, 4%) + 8% * touch.hover) * (1 - obs) }
        //  The icon of the chosen row grows (a spring, `isel`) and boils like the sidebar's in Settings: it jumps a hair about five times a second, as if redrawn by hand.
        prop isel = 0 ~calm
        follow isel = if(t.sel, 1, 0)
        group {
            pivot: 23 * pu, 20 * pu
            scale: 1 + 0.28 * isel + 0.03 * isel * sin(floor(time * 5) * 47)
            move: isel * 0.6 * pu * sin(floor(time * 5) * 53 + 40), isel * 0.6 * pu * sin(floor(time * 5) * 61)
            image t.icon { at: floor(10 * pu + 0.5), floor(7 * pu + 0.5); size: floor(26 * pu + 0.5), floor(26 * pu + 0.5); show: t.hasicon }
            ellipse { at: 23 * pu, 20 * pu; radius: 13 * pu; color: mint; opacity: 16%; show: not t.hasicon }
            group { scale: rs; pivot: floor(23 * pu + 0.5), floor(20 * pu + 0.5); text t.glyph { at: floor(23 * pu + 0.5), floor(20 * pu + 0.5); anchor: center; align: center; size: 17.5; weight: 700; width: (26 * pu) / rs; lines: 1; color: mint; family: "Space Grotesk"; show: not t.hasicon } }
        }
        group { scale: rs; pivot: floor(48 * pu + 0.5), floor(if(t.hasdesc, 14, 20) * pu + 0.5); text t.title { at: floor(48 * pu + 0.5), floor(if(t.hasdesc, 14, 20) * pu + 0.5); anchor: left center; size: 18; weight: 600; width: (lw - (58 + 96 * (1 - lpv) + if(t.deletable, 24, 0)) * pu) / rs; lines: 1; color: if(t.sel, mint, ink); family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(48 * pu + 0.5), floor(29 * pu + 0.5); text t.desc { at: floor(48 * pu + 0.5), floor(29 * pu + 0.5); anchor: left center; size: 13.5; width: (lw - 62 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk"; show: t.hasdesc } }
        group { scale: rs; pivot: floor(lw - 10 * pu + 0.5), floor(20 * pu + 0.5); text t.sub { at: floor(lw - 10 * pu + 0.5), floor(20 * pu + 0.5); anchor: right center; align: right; size: 14; width: (90 * pu) / rs; lines: 1; color: faint; opacity: (1 - lpv) * (1 - rm); family: "Space Grotesk" } }
        on press touch { emit pick(t.index) }
        on press right touch { emit ctx(t.index) }
        //  A pin at the end of an app's row: solid and in the accent while the app is on the corner dock, an outline (clearer under the pointer) while it is not.
        //  A right click on the row pins it or lets it go.
        group {
            move: lw - 20 * pu, 20 * pu
            rotate: 35deg
            show: t.pinnable
            path { stroke: 1.4 * pu; color: ink; opacity: (30% + 50% * touch.hover) * (1 - t.pin); move -2.6 * pu, -6 * pu; line 2.6 * pu, -6 * pu; line 2.6 * pu, -1.6 * pu; line 4.6 * pu, 1 * pu; line -4.6 * pu, 1 * pu; line -2.6 * pu, -1.6 * pu; close }
            path { color: mint; opacity: if(t.pin, 1, 0); move -2.6 * pu, -6 * pu; line 2.6 * pu, -6 * pu; line 2.6 * pu, -1.6 * pu; line 4.6 * pu, 1 * pu; line -4.6 * pu, 1 * pu; line -2.6 * pu, -1.6 * pu; close }
            line { from: 0, 1 * pu; to: 0, 6.5 * pu; width: 1.4 * pu; color: if(t.pin, mint, ink); opacity: if(t.pin, 1, 30% + 50% * touch.hover) }
        }
        //  The clipboard's rows can be removed: a small cross where the kind ("text", "image") is, while the row is under the pointer or chosen
        //  (Shift + Delete does the same for the chosen one). Declared last, so a press on it is its own and does not paste the row.
        ellipse { at: lw - 20 * pu, 20 * pu; radius: 11 * pu; color: if(rm_z.hover, alert, ink); opacity: (if(rm_z.hover, 90%, 10%)) * rm }
        line { from: lw - 24 * pu, 16 * pu; to: lw - 16 * pu, 24 * pu; width: 1.5 * pu; color: ink; opacity: 75% * rm }
        line { from: lw - 16 * pu, 16 * pu; to: lw - 24 * pu, 24 * pu; width: 1.5 * pu; color: ink; opacity: 75% * rm }
        zone box rm_z { at: lw - 20 * pu, 20 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: t.deletable }
        on press rm_z { emit del(t.index) }
    }

    //  One app that lives in the tray, with no window of its own: its icon and name. A press is what clicking its
    //  icon would do; the dots open its menu, and the pin keeps it on the bar.
    component TrayRow(t: record, click: event, pin: event, menu: event) {
        size: 288 * cu, floor(36 * cu + 0.5)          // whole pixels (with the list's gap), so the icon is not drawn between two
        zone box touch { from: 0, 0; size: 288 * cu, 36 * cu; corner: 12 * cu; cursor: pointer }
        box { from: 0, 0; size: 288 * cu, 36 * cu; corner: 12 * cu; color: ink; opacity: 5% + 8% * touch.hover }
        image t.icon { at: floor(8 * cu + 0.5), floor(7 * cu + 0.5); size: floor(22 * cu + 0.5), floor(22 * cu + 0.5) }
        text t.title { at: floor(38 * cu + 0.5), floor(18 * cu + 0.5); anchor: left center; size: 14.5; width: 184 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        //  Its menu: three dots.
        group {
            show: t.menu
            opacity: 45% + 55% * menu_z.hover
            ellipse { at: 232 * cu, 18 * cu; radius: 1.4 * cu; color: ink }
            ellipse { at: 238 * cu, 18 * cu; radius: 1.4 * cu; color: ink }
            ellipse { at: 244 * cu, 18 * cu; radius: 1.4 * cu; color: ink }
        }
        zone box menu_z { at: 238 * cu, 18 * cu; size: 24 * cu, 28 * cu; corner: 10 * cu; cursor: pointer; active: t.menu }
        //  The pin: shown on the row under the pointer, and always on a pinned one.
        group {
            opacity: if(t.pinned, 100%, 55% * touch.hover + 25% * pin_z.hover)
            ellipse { at: 266 * cu, 15 * cu; radius: 3.6 * cu; color: mint; opacity: if(t.pinned, 100%, 0%) }
            ellipse { at: 266 * cu, 15 * cu; radius: 3.6 * cu; stroke: 1.3 * cu; color: ink; opacity: if(t.pinned, 0%, 100%) }
            line { from: 266 * cu, 18.5 * cu; to: 266 * cu, 24 * cu; width: 1.4 * cu; color: if(t.pinned, mint, ink) }
        }
        zone box pin_z { at: 266 * cu, 18 * cu; size: 22 * cu, 28 * cu; corner: 10 * cu; cursor: pointer }
        on press touch { emit click(t.index); panel = none }
        on press menu_z { emit menu(t.index) }
        on press pin_z { emit pin(t.index) }
    }

    //  One entry of a tray app's menu: a check if it is ticked, its label (in a step for each level of submenu
    //  it is under), and an arrow if it opens more. A separator is a line.
    component TmRow(r: record, pick: event) {
        size: 288 * cu, floor(if(r.sep, 10, 28) * cu + 0.5)
        zone box touch { from: 0, 0; size: 288 * cu, 28 * cu; corner: 9 * cu; cursor: pointer; active: r.enabled and not r.sep }
        //  Under the pointer a row lights in the accent: a soft wash over the usual veil, a bar growing from the left edge, a dot where the check goes, the label stepping
        //  in and the arrow leaning; on the UwU a little star twinkles at the right. All of it is the theme's own colour and corner, so each look keeps its own.
        box { from: 0, 0; size: 288 * cu, 28 * cu; corner: 9 * cu * (1 - 0.73 * sq); color: ink; opacity: if(r.sep, 0%, 6% * touch.hover) }
        box { from: 0, 0; size: 288 * cu, 28 * cu; corner: 9 * cu * (1 - 0.73 * sq); color: mint; opacity: if(r.sep, 0%, 15% * touch.hover) }
        box { at: 2.5 * cu, 14 * cu; size: 3 * cu, 16 * cu * touch.hover; corner: 1.5 * cu * (1 - 0.8 * sq); color: mint; opacity: if(r.sep, 0%, 100%) }
        ellipse { at: 15 * cu, 14 * cu; radius: 2.2 * cu * touch.hover; color: mint; opacity: if(r.checked or r.sep, 0%, 100%) }
        //  A separator is a line with a small diamond of the accent in the middle.
        box { at: 144 * cu, 5 * cu; size: 264 * cu, 1 * cu; color: ink; opacity: if(r.sep, 12%, 0%) }
        path { at: 144 * cu, 5 * cu; color: mint; opacity: if(r.sep, 70%, 0%); move 0, -3 * cu; line 3 * cu, 0; line 0, 3 * cu; line -3 * cu, 0; close }
        path { at: 15 * cu, 14 * cu; stroke: 1.6 * cu; color: mint; opacity: if(r.checked, 100%, 0%); move -3.5 * cu, 0.5 * cu; line -1 * cu, 3 * cu; line 4 * cu, -3.5 * cu }
        text r.label { at: floor((30 + r.depth * 14 + 3 * touch.hover) * cu + 0.5), floor(14 * cu + 0.5); anchor: left center; size: 14.5; width: (226 - r.depth * 14) * cu; lines: 1; color: ink; opacity: if(r.enabled, 100%, 40%); show: not r.sep; family: "Space Grotesk" }
        path { at: (274 + 2.5 * touch.hover) * cu, 14 * cu; stroke: 1.5 * cu; color: mix(ink, mint, touch.hover); rotate: if(r.open, 90deg, 0deg); opacity: if(r.kids, 60% + 40% * touch.hover, 0%); move -2 * cu, -3.5 * cu; line 2 * cu, 0; line -2 * cu, 3.5 * cu }
        path { at: 262 * cu, 14 * cu; color: #ffe27a; opacity: if(r.sep, 0%, uwu_k * touch.hover); move 0, -5 * cu * touch.hover; line 1.5 * cu * touch.hover, -1.5 * cu * touch.hover; line 5 * cu * touch.hover, 0; line 1.5 * cu * touch.hover, 1.5 * cu * touch.hover; line 0, 5 * cu * touch.hover; line -1.5 * cu * touch.hover, 1.5 * cu * touch.hover; line -5 * cu * touch.hover, 0; line -1.5 * cu * touch.hover, -1.5 * cu * touch.hover; close }
        on press touch { emit pick(r.index) }
    }

    //  A tray app's icon on the bar: a left click is what clicking it would do, a right click opens its menu.
    component BarTray(t: record, click: event, menu: event) {
        size: floor(18 * bu + 0.5), floor(18 * bu + 0.5)
        box { at: 9 * bu, 9 * bu; size: 26 * bu, 26 * bu; corner: 8 * bu; color: ink; opacity: 14% * touch.hover * bs.tray }
        group {
            pivot: 9 * bu, 9 * bu
            scale: 1 + 0.14 * touch.hover
            image t.icon { at: 0, 0; size: floor(18 * bu + 0.5), floor(18 * bu + 0.5); opacity: (78% + 22% * touch.hover) * bs.tray }
        }
        zone box touch { at: 9 * bu, 9 * bu; size: 24 * bu, 30 * bu; cursor: pointer; active: bs.tray > 0.5 }
        //  `panel_scr`: the menu opens on this monitor's copy (the logic opens the panel without saying which, so with the bar on
        //  more than one monitor it came out wherever the last panel had been). A left click opens it too, for an app that is only a menu.
        on press touch { panel_scr = screen.index; emit click(t.index) }
        on press right touch { panel_scr = screen.index; emit menu(t.index) }
    }

    //  A pinned app in the corner dock. Pressed and let go it starts; pressed and pulled (more than a few pixels) it takes the whole dock with it, which settles in
    //  the nearer of the two corners when let go. A right click unpins it.
    component CdkIcon(t: record) {
        size: floor(24 * bu + 0.5), floor(24 * bu + 0.5)
        box { at: 12 * bu, 12 * bu; size: 33 * bu, 33 * bu; corner: 10 * bu * (1 - 0.5 * sq); color: ink; opacity: 16% * touch.hover * (1 - cdk_drag) }
        group {
            pivot: 12 * bu, 12 * bu
            scale: 1 + 0.16 * touch.hover * (1 - cdk_drag)
            image t.icon { at: 0, 0; size: floor(24 * bu + 0.5), floor(24 * bu + 0.5); opacity: 88% + 12% * touch.hover }
        }
        zone box touch { at: 12 * bu, 12 * bu; size: 31 * bu, 33 * bu; cursor: pointer; active: cdk.g > 0.6 }
        on enter touch { cdk_hot = 1 }
        on leave touch { cdk_hot = 0 }
        on press touch { cdk_down = 1; cdk_drag = 0; cdk_hx = pointer.x - cdk.rcx; cdk_hy = pointer.y - cdk.rcy }
        on drag touch while cdk_down > 0.5 { cdk_px = clamp(pointer.x - cdk_hx, 0, screen.width); cdk_py = clamp(pointer.y - cdk_hy, 0, screen.height); cdk_drag = if(cdk_drag > 0.5 or abs(drag.dx) + abs(drag.dy) > 8, 1, 0) }
        on release touch while cdk_down > 0.5 and cdk_drag < 0.5 { emit cdk_go(t.index) }
        on release touch while cdk_down > 0.5 { cdk_corner = if(cdk_drag > 0.5, cdk.pick, cdk_corner); cdk_down = 0; cdk_drag = 0 }
        on press right touch { emit cdk_unpin(t.index) }
    }

    component AdkIcon(t: record) {
        size: floor(24 * bu + 0.5), floor(24 * bu + 0.5)
        box { at: 12 * bu, 12 * bu; size: 33 * bu, 33 * bu; corner: 10 * bu * (1 - 0.5 * sq); color: ink; opacity: 16% * touch.hover * (1 - adk_drag) }
        group {
            pivot: 12 * bu, 12 * bu
            scale: 1 + 0.16 * touch.hover * (1 - adk_drag)
            image t.icon { at: 0, 0; size: floor(24 * bu + 0.5), floor(24 * bu + 0.5); opacity: 88% + 12% * touch.hover }
        }
        zone box touch { at: 12 * bu, 12 * bu; size: 31 * bu, 33 * bu; cursor: pointer; active: adk.g > 0.6 }
        on enter touch { adk_hot = 1 }
        on leave touch { adk_hot = 0 }
        on press touch { adk_down = 1; adk_drag = 0; adk_hx = pointer.x - adk.rcx; adk_hy = pointer.y - adk.rcy }
        on drag touch while adk_down > 0.5 { adk_px = clamp(pointer.x - adk_hx, 0, screen.width); adk_py = clamp(pointer.y - adk_hy, 0, screen.height); adk_drag = if(adk_drag > 0.5 or abs(drag.dx) + abs(drag.dy) > 8, 1, 0) }
        on release touch while adk_down > 0.5 and adk_drag < 0.5 { ax_scr = screen.index; ax_sw = screen.width; ax_sh = screen.height; emit adk_go(t.index) }
        on release touch while adk_down > 0.5 { cdk_corner = if(adk_drag > 0.5, 1 - adk.pick, cdk_corner); adk_down = 0; adk_drag = 0 }
    }

    //  While a screen recording runs, a red dot rides the tray. Under the pointer it squares off into a stop button.
    //  A privacy light on the bar, while something uses the microphone (kind 0, amber), the camera (1, green) or shares the screen (2, blue):
    //  its icon on a soft glowing disc. Under the pointer, the apps doing it are named below it.
    component BarPriv(kind: number) {
        size: floor(18 * bu + 0.5), floor(18 * bu + 0.5)
        let beat = 0.5 + 0.5 * sin(time * 160)
        body {
            color: if(kind == 0, #f59e0b, if(kind == 1, #22c55e, #60a5fa))
            opacity: 22% + 10% * beat
            shadow: 0, 0, (3 + 3 * beat) * bu, 60%, if(kind == 0, #f59e0b, if(kind == 1, #22c55e, #60a5fa))
            ellipse { at: 9 * bu, 9 * bu; radius: 9 * bu }
        }
        //  microphone
        group {
            show: kind == 0
            box { at: 9 * bu, 7 * bu; size: 5 * bu, 8.5 * bu; corner: 2.5 * bu; color: if(kind == 0, #f59e0b, if(kind == 1, #22c55e, #60a5fa)) }
            path { at: 9 * bu, 7 * bu; stroke: 1.3 * bu; color: if(kind == 0, #f59e0b, if(kind == 1, #22c55e, #60a5fa)); move -4 * bu, 0.5 * bu; curve 0, 5.5 * bu via -4 * bu, 5.5 * bu; curve 4 * bu, 0.5 * bu via 4 * bu, 5.5 * bu }
            box { at: 9 * bu, 13.8 * bu; size: 1.3 * bu, 2.2 * bu; corner: 0.6 * bu; color: if(kind == 0, #f59e0b, if(kind == 1, #22c55e, #60a5fa)) }
        }
        //  camera
        group {
            show: kind == 1
            box { at: 7.6 * bu, 9 * bu; size: 9 * bu, 7 * bu; corner: 2 * bu; color: if(kind == 0, #f59e0b, if(kind == 1, #22c55e, #60a5fa)) }
            path { at: 12.5 * bu, 9 * bu; color: if(kind == 0, #f59e0b, if(kind == 1, #22c55e, #60a5fa)); move 0, -1.2 * bu; line 3.2 * bu, -3 * bu; line 3.2 * bu, 3 * bu; line 0, 1.2 * bu; close }
        }
        //  screen
        group {
            show: kind == 2
            box { at: 9 * bu, 7.8 * bu; size: 11 * bu, 7.6 * bu; corner: 1.6 * bu; stroke: 1.4 * bu; color: if(kind == 0, #f59e0b, if(kind == 1, #22c55e, #60a5fa)) }
            box { at: 9 * bu, 13.6 * bu; size: 6 * bu, 1.4 * bu; corner: 0.7 * bu; color: if(kind == 0, #f59e0b, if(kind == 1, #22c55e, #60a5fa)) }
        }
        zone box touch { at: 9 * bu, 9 * bu; size: 22 * bu, 26 * bu }
        text priv_mic_who { at: floor(9 * bu + 0.5), floor(30 * bu + 0.5); anchor: center; align: center; size: 12 * bz; weight: 600; color: ink; family: "Space Grotesk"; opacity: touch.hover; show: lm < 0.5 and kind == 0 }
        text priv_mic_who { at: floor(26 * bu + 0.5), floor(9 * bu + 0.5); anchor: left center; size: 12 * bz; weight: 600; color: ink; family: "Space Grotesk"; opacity: touch.hover; show: lm >= 0.5 and kind == 0 }
        text priv_cam_who { at: floor(9 * bu + 0.5), floor(30 * bu + 0.5); anchor: center; align: center; size: 12 * bz; weight: 600; color: ink; family: "Space Grotesk"; opacity: touch.hover; show: lm < 0.5 and kind == 1 }
        text priv_cam_who { at: floor(26 * bu + 0.5), floor(9 * bu + 0.5); anchor: left center; size: 12 * bz; weight: 600; color: ink; family: "Space Grotesk"; opacity: touch.hover; show: lm >= 0.5 and kind == 1 }
        text priv_scr_who { at: floor(9 * bu + 0.5), floor(30 * bu + 0.5); anchor: center; align: center; size: 12 * bz; weight: 600; color: ink; family: "Space Grotesk"; opacity: touch.hover; show: lm < 0.5 and kind == 2 }
        text priv_scr_who { at: floor(26 * bu + 0.5), floor(9 * bu + 0.5); anchor: left center; size: 12 * bz; weight: 600; color: ink; family: "Space Grotesk"; opacity: touch.hover; show: lm >= 0.5 and kind == 2 }
    }

    component BarRec(stop: event) {
        size: floor(18 * bu + 0.5), floor(18 * bu + 0.5)
        box { at: 9 * bu, 9 * bu; size: 26 * bu, 26 * bu; corner: 8 * bu; color: ink; opacity: 14% * touch.hover }
        let beat = 0.5 + 0.5 * sin(time * 300)
        let wave = fract(time * 0.83)
        ellipse { at: 9 * bu, 9 * bu; radius: (6 + 7 * wave) * bu; stroke: 1.3 * bu; color: #ef4444; opacity: 55% * (1 - wave) * (1 - touch.hover) }
        body {
            color: #ef4444
            opacity: 88% + 12% * touch.hover - (1 - touch.hover) * 0.25 * (1 - beat)
            shadow: 0, 0, (4 + 5 * beat * (1 - touch.hover)) * bu, 70%, #ef4444
            box { at: 9 * bu, 9 * bu; size: (12 + 1.5 * beat * (1 - touch.hover) - 1.5 * touch.hover) * bu, (12 + 1.5 * beat * (1 - touch.hover) - 1.5 * touch.hover) * bu; corner: (6 - 4 * touch.hover) * bu }
        }
        zone box touch { at: 9 * bu, 9 * bu; size: 24 * bu, 30 * bu; cursor: pointer; label: "Stop recording" }
        on press touch { emit stop }
    }

    //  A notification's button (Reply, Mark read…): a small pill with its label.
    component NtAct(a: record, click: event) {
        size: floor(82 * u + 0.5), floor(26 * u + 0.5)
        zone box touch { from: 0, 0; size: 82 * u, 26 * u; corner: 8 * u; cursor: pointer }
        box { from: 0, 0; size: 82 * u, 26 * u; corner: 8 * u; color: if(touch.hover, mint, ink); opacity: if(touch.hover, 100%, 8%) }
        text a.label { at: floor(41 * u + 0.5), floor(13 * u + 0.5); anchor: center; align: center; size: 12.5; weight: 700; width: 74 * u; lines: 1; color: if(touch.hover, onmint, ink); family: "Space Grotesk" }
        on press touch { emit click(a.index) }
    }

    //  One wallpaper in the gallery: its picture in rounded corners, a ring when it is the one in use.
    component WpThumb(t: record, pick: event) {
        size: 96 * pu, 54 * pu
        zone box touch { from: 0, 0; size: 96 * pu, 54 * pu; corner: 8 * pu; cursor: pointer }
        //  The pictures are cropped to 16:9 in a cache by the logic, so every tile is the same.
        group {
            clip inset 0 box { from: 0, 0; size: 96 * pu, 54 * pu; corner: 8 * pu }
            image t.thumb { at: 0, 0; size: 96 * pu, 54 * pu }
        box { from: 0, 0; size: 96 * pu, 54 * pu; color: ink; opacity: 14% * touch.hover }
        }
        box { from: 0, 0; size: 96 * pu, 54 * pu; corner: 8 * pu; stroke: 2 * pu; color: mint; opacity: if(wp_sel == t.index, 100%, 0) }
        on press touch { emit pick(t.index) }
    }

    //  A weather icon, drawn from shapes (there is no icon font): `kind` 0 clear · 1 partly cloudy · 2 cloud ·
    //  3 fog · 4 rain · 5 snow · 6 storm. The cloud is `cloud`; the sun, rain, snow and bolt are `sun`.
    component WxIcon(kind: number, cloud: color = ink, sun: color = mint) {
        size: 26 * cu, 20 * cu
        //  clear
        group {
            show: kind == 0
            ellipse { at: 13 * cu, 10 * cu; radius: 4.6 * cu; color: sun }
            repeat i in 0..8 {
                group {
                    pivot: 13 * cu, 10 * cu
                    rotate: i * 45deg
                    box { at: 13 * cu, 10 * cu - 7.8 * cu; size: 1.7 * cu, 3 * cu; corner: 0.8 * cu; color: sun }
                }
            }
        }
        //  partly cloudy: a small sun behind a cloud
        group {
            show: kind == 1
            ellipse { at: 8.5 * cu, 7.5 * cu; radius: 3.4 * cu; color: sun }
            repeat i in 0..8 {
                group {
                    pivot: 8.5 * cu, 7.5 * cu
                    rotate: i * 45deg
                    box { at: 8.5 * cu, 7.5 * cu - 5.9 * cu; size: 1.4 * cu, 2.2 * cu; corner: 0.7 * cu; color: sun }
                }
            }
            ellipse { at: 10 * cu, 13 * cu; radius: 3.6 * cu; color: cloud }
            ellipse { at: 15 * cu, 11.5 * cu; radius: 4.6 * cu; color: cloud }
            ellipse { at: 19 * cu, 13.5 * cu; radius: 3.2 * cu; color: cloud }
            box { at: 14.5 * cu, 15.5 * cu; size: 13 * cu, 4.5 * cu; corner: 2.2 * cu; color: cloud }
        }
        //  the cloud alone, and the cloud that rain, snow and storm hang from
        group {
            show: kind == 2 or kind == 4 or kind == 5 or kind == 6
            let cy0 = if(kind == 2, 10, 7.5) * cu
            ellipse { at: 9 * cu, cy0 + 1 * cu; radius: 4 * cu; color: cloud }
            ellipse { at: 14 * cu, cy0 - 1.5 * cu; radius: 5 * cu; color: cloud }
            ellipse { at: 18.5 * cu, cy0 + 1 * cu; radius: 3.6 * cu; color: cloud }
            box { at: 13.5 * cu, cy0 + 3 * cu; size: 14 * cu, 5 * cu; corner: 2.5 * cu; color: cloud }
        }
        //  fog
        group {
            show: kind == 3
            box { at: 13 * cu, 5.5 * cu; size: 17 * cu, 2 * cu; corner: 1 * cu; color: cloud }
            box { at: 13 * cu, 10 * cu; size: 13 * cu, 2 * cu; corner: 1 * cu; color: cloud }
            box { at: 13 * cu, 14.5 * cu; size: 17 * cu, 2 * cu; corner: 1 * cu; color: cloud }
        }
        //  rain
        group {
            show: kind == 4
            line { from: 8.5 * cu, 14 * cu; to: 7 * cu, 18 * cu; width: 1.5 * cu; color: sun }
            line { from: 13.5 * cu, 14 * cu; to: 12 * cu, 18 * cu; width: 1.5 * cu; color: sun }
            line { from: 18.5 * cu, 14 * cu; to: 17 * cu, 18 * cu; width: 1.5 * cu; color: sun }
        }
        //  snow
        group {
            show: kind == 5
            ellipse { at: 8 * cu, 15.5 * cu; radius: 1.3 * cu; color: sun }
            ellipse { at: 13 * cu, 17.5 * cu; radius: 1.3 * cu; color: sun }
            ellipse { at: 18 * cu, 15.5 * cu; radius: 1.3 * cu; color: sun }
        }
        //  storm: a bolt
        path {
            show: kind == 6
            at: floor(13 * cu + 0.5), floor(11 * cu + 0.5)
            color: sun
            move 1.5 * cu, 0
            line -2.5 * cu, 4.5 * cu
            line 0.2 * cu, 4.5 * cu
            line -1.2 * cu, 4 * cu
            line 4 * cu, -5.5 * cu
            line 0.5 * cu, -5.5 * cu
            close
        }
    }

    //  One day of the forecast: its name, its icon, its high and its low. Today is in the accent.
    component WxDay(d: record) {
        size: floor(42 * cu + 0.5), floor(50 * cu + 0.5)
        text d.label { at: floor(21 * cu + 0.5), floor(7 * cu + 0.5); anchor: center; align: center; size: 11; weight: 700; width: 40 * cu; lines: 1; color: if(d.today, mint, faint); family: "Space Grotesk" }
        column icon_col { at: 8 * cu, 15 * cu; WxIcon(d.kind, if(d.today, mint, ink), mint) }
        text d.hi { at: floor(12 * cu + 0.5), floor(42 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 700; width: 20 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        text d.lo { at: floor(31 * cu + 0.5), floor(42 * cu + 0.5); anchor: center; align: center; size: 11.5; width: 20 * cu; lines: 1; color: faint; family: "Space Grotesk" }
    }

    //  One notification in the history: its title and when it came, and under them the app and what it said.
    //  54 px tall, so a stack of them sits on whole pixels. A cross shows on hover, in place of the time.
    component NtHistRow(h: record, del: event) {
        size: 276 * cu, 54
        zone box touch { from: 0, 0; size: 276 * cu, 54; corner: 12 * cu }
        box { from: 0, 0; size: 276 * cu, 54; corner: 12 * cu; color: ink; opacity: 5% + 6% * touch.hover }
        text h.title { at: floor(12 * cu + 0.5), 17; anchor: left center; size: 14.5; weight: 700; width: 200 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        text h.sub { at: floor(12 * cu + 0.5), 37; anchor: left center; size: 12; width: 244 * cu; lines: 1; color: faint; family: "Space Grotesk" }
        text h.when { at: floor(264 * cu + 0.5), 17; anchor: right center; size: 11.5; color: faint; opacity: 100% - 100% * touch.hover; family: "Space Grotesk" }
        ellipse { at: floor(258 * cu + 0.5), 17; radius: 9 * cu; color: if(del_z.hover, alert, ink); opacity: (if(del_z.hover, 80%, 12%)) * touch.hover }
        line { from: floor(258 * cu + 0.5) - 3.2 * cu, 17 - 3.2 * cu; to: floor(258 * cu + 0.5) + 3.2 * cu, 17 + 3.2 * cu; width: 1.4 * cu; color: ink; opacity: 70% * touch.hover }
        line { from: floor(258 * cu + 0.5) + 3.2 * cu, 17 - 3.2 * cu; to: floor(258 * cu + 0.5) - 3.2 * cu, 17 + 3.2 * cu; width: 1.4 * cu; color: ink; opacity: 70% * touch.hover }
        zone box del_z { at: floor(258 * cu + 0.5), 17; size: 24 * cu, 24 * cu; corner: 12 * cu; cursor: pointer }
        on press del_z { emit del(h.index) }
    }

    let cx = screen.width / 2
    //  The bar down the left: a strip `lf.w` wide on the left and a frame `lf.t` thick round the other three edges, in the same glass. `lm` is how
    //  far over it is (the panels follow: `pcx` is where they are centred, with their left edge `lf.w` and a little in from the strip).
    //  Which copies are the bar's: the logic says which monitors are chosen (`bar_c0` to `bar_c3`, by copy number; two at the most, logic/bar_monitors.luau).
    //  The others are closed, or (`bar_others`) take the left layout's shapes with a strip as thin as the frame:
    //  the launcher out of the top notch, Settings out of the bottom, the desk out of the right.
    fact bar_c0 = true
    fact bar_c1 = true
    fact bar_c2 = false
    fact bar_c3 = false
    fact bar_others = false                  // the monitors without the bar keep the frame alone, with no notches (logic/bar_monitors.luau)
    let sb = if(screen.index == 0, if(bar_c0, 1, 0), if(screen.index == 1, if(bar_c1, 1, 0), if(screen.index == 2, if(bar_c2, 1, 0), if(bar_c3, 1, 0))))
    let gbm = if(screen.index == 0, if(glass_b0, 1, 0), if(screen.index == 1, if(glass_b1, 1, 0), if(screen.index == 2, if(glass_b2, 1, 0), if(glass_b3, 1, 0))))
    let lm = mix(1, clamp(bar_lm, 0, 1), sb)
    //  The strip on the right is the left one in a mirror: the glass is drawn flipped about the middle of the screen (`rt` is 1 then), and every block of
    //  content that belongs to it (the strip's pieces, the panels that come out of it or out of a frame's notch) is drawn where its mirror image falls, upright.
    let rt = if(bar_frame and bar_anchor == right, sb, 0)
    //  The frame on the top or the bottom is the same drawing with a horizontal strip: `tm` is how far over it is (`lm` is the vertical strip's share),
    //  `fm` the frame's (either), and `th.*` how thick each edge of it is, the strip's being `lf.w`.
    let bt = if(bar_frame and bar_anchor == bottom, sb, 0)         // the strip along the bottom is the top one flipped about the middle of the screen; search and settings swap their notches
    let tm = clamp(bar_tm, 0, 1) * sb
    let fm = min(1, lm + tm)
    let sg = clamp(bar_sg, 0, 1) * sb                             // the top frame in three pieces (see `sg.*`); not on a monitor with only the frame (`sb`)
    let tu = clamp(1 - lm, 0, 1)                                  // the drawers that come out of a horizontal edge: the Island's pill, and the top and bottom frames
    let lf.t = 8 * u
    let lf.w = mix(lf.t, 46 * bu, sb)
    let lf.x = lf.w / 2                                    // the strip's middle line, where its pieces sit
    let th.l = mix(lf.t, lf.w, lm)
    let th.t = mix(lf.t, lf.w, tm)
    let th.ts = mix(th.t, lf.t, sg)                                // the top edge of the glass as drawn: as thin as the others, but where the pieces are
    let th.r = lf.t
    let th.b = lf.t
    //  Down the left a panel comes out of the strip like a drop and ends up in the middle of the screen. The Settings and the launcher are larger
    //  than the rest (`pu` instead of `u`, in their shapes, the contents and the rows they use: laid out at that size, not zoomed); `ku` is the
    //  unit of the one that is open. `lp.gx0` is where its left edge leaves the strip and `lp.gxf` where it lands;
    //  its left edge travels between them (`lp.xl`, as far as `dsl` of the way: a little after it starts to open), and its contents with it. The
    //  glass melts shapes that are near each other, so as it leaves a neck stretches and breaks: the drawers' blend (below) is what makes the neck.
    //  The surface is the whole monitor (`size: full, full`, which keeps the bar's reserved strip since pleamar 0.2.9), but with the bar on
    //  more than one monitor `screen.height` is only one of them. The logic reports the monitor's real height (`mon_h`, 0 until it is known, and always 0
    //  where it cannot ask): `vh` is what to centre on (never more than the surface, which is all there is to draw on), `mh` the
    //  monitor's own, for the compositor's coordinates.
    fact mon_h = 0
    let vh = screen.height           // each copy's own monitor (`mon_h` was the focused one's: two monitors of different heights pulled it back and forth)
    let mh = screen.height
    let yo = lm * (screen.height - vh) / 2                   // down the left the surface is not anchored to the top, so it is centred on the monitor: the monitor starts `yo` down it
    let vb = yo + vh                                         // the monitor's bottom edge, on the surface
    let vc = yo + vh / 2
    let ccx = mix(cx, (th.l + screen.width - th.r) / 2, fm)         // the middle of what can be seen: inside the frame
    let vcc = mix(vc, (yo + th.t + vb - th.b) / 2, fm)              // and the middle of it down the screen
    let lmk = if(lp_k == 1 or lp_k == 2 or (lp_k == 7 or lp_k == 8 or lp_k == 9), fm, lm)           // how far over the frame's layout the open panel is: the strip's own panels follow the strip, the ones out of a notch follow the frame
    let att = if(lp_k == 3 or lp_k == 4 or lp_k == 5 or lp_k == 6 or (lp_k == 7 or lp_k == 8 or lp_k == 9), 1, 0)           // the control center, the calendar, the player and tray, the volume and the notifications: they stay joined to the strip, and are not scaled
    let rgt = if((lp_k == 7 or lp_k == 8 or lp_k == 9), 1, 0)                                    // the volume and the notifications come out of the right frame, not the strip, and grow leftwards
    let edg = if(lp_k == 1 or lp_k == 2, 1, 0)                      // Settings rises out of the bottom frame's middle, the launcher lowers out of the top frame's: not from the strip
    let dsl = max(0, dtrav * 1.3 - 0.3)
    //  With the strip along the top the launcher comes out of the LEFT frame's notch (a side drawer, like the desk's on the right): `lside` is how far over that is,
    //  `dl.cL` where the middle of what it holds is then (6.5 in from the frame's inner edge, its contents 430 wide).
    //  The add-on drawer: out of the add-on pill (the corner dock's twin, in the other corner), the glass drawn here and the content by the add-on's own scene, which is told
    //  where to draw (`ax_r*`, below). `ax_cur` is the add-on in the pill that holds it (logic/addons.luau).
    fact ax_cur = -1
    fact ax_open = false                                   // the drawer is out: like the Desk it stays until its X (or its icon) shuts it, and no other panel closes it
    fact ax_scr = 0                                        // the monitor it is on
    fact ax_rsz = false                                    // a corner is held: the panel is being resized (the content waits, as while it is pulled)
    fact ax_rk = -1
    fact ax_bw = 0                                         // its size when a corner was pressed, and the opposite corner, which stays where it is
    fact ax_bh = 0
    fact ax_fxd = 0
    fact ax_fyd = 0
    event ax_resized ->                                    // a resize ended (logic/addons.luau keeps the size)
    fact ax_sw = 0                                         // and that monitor's size: an add-on's scene numbers its copies of itself in its own order, so it is told the size, not the number
    fact ax_sh = 0
    fact ax_gx = 0                                         // pulled by its title bar: where it is being taken to (an offset from its place; in the glass's drawing)
    fact ax_gy = 0
    fact ax_bx = 0                                         // where it was when the bar was pressed
    fact ax_by = 0
    fact ax_hold = false                                   // its title bar is held
    fact ax_hx = 0                                         // where on the screen it was taken hold of
    fact ax_hy = 0
    spring ax_sp = 300, 20
    prop ax_ox = 0 ~ax_sp
    prop ax_oy = 0 ~ax_sp
    follow ax_ox = ax_gx
    follow ax_oy = ax_gy
    on change ax_open while not ax_open { ax_gx = 0; ax_gy = 0; ax_hold = false }
    fact ax_on = false                                     // an add-on that asked for a drawer is on
    fact ax_w = 0                                          // its size (0: about 40 % of the room wide, and all of its height; the manifest can say)
    fact ax_h = 0
    text ax_title = ""
    //  A field in the add-on's panel, typed through the shell (the messages are in logic/addons.luau). An add-on's scene is a surface of its own, and its `keyboard:`
    //  would be asked of every copy at once, as the shell's was before (see the surface): so the add-on only says where its field is, from the top left of its content
    //  (`axf_l`, `axf_t`, its height `axf_h` and `axf_r` from the content's right edge), and the shell lays a zone there, on the panel's copy only. Its own surface leaves
    //  the clicks there to this one (no zone of its own over the field), so a click on the field is a click on the shell, and Hyprland lends the keyboard to this copy
    //  (`on_demand`, asked for while a field is shown) as it does for the Desk's terminal: the keys go to the logic, which keeps the text and tells the add-on, which
    //  draws it. Not `focus`: a field focused from a rule takes the keyboard exclusively, and Hyprland then gives the pointer to the shell only, so the add-on's own
    //  buttons stopped answering for as long as the field held it.
    fact axf_on = false                                    // the add-on in the panel shows a field (it says so; it is put away when the panel shuts or another add-on takes it)
    fact axf_l = 0
    fact axf_t = 0
    fact axf_r = 0
    fact axf_h = 0
    text axf_q = ""                                        // what the field starts with (the add-on sets it before `axf_on`, or with `axf_set`)
    event axf_set ->
    fact axf_kb = false                                    // it is being typed in: the keys go to the logic
    event axf_esc ->
    on change ax_open while not ax_open { axf_on = false }
    on change ax_cur { axf_on = false }
    on change axf_on while not axf_on { axf_kb = false }
    on key Escape while axf_kb { axf_kb = false; emit axf_esc }
    //  Gaining the keyboard puts the writing cursor in the first field there is, and keys typed then reach that field, not the logic: taken away again, as for the
    //  Desk's terminal. Losing it (a click on a window) ends the typing; so does anything of the shell's own that takes the keys.
    on focus while axf_kb { blur }
    on blur { axf_kb = false }
    on change panel while panel != none { axf_kb = false }
    on change wp_picker_open while wp_picker_open { axf_kb = false }
    on change ov_open while ov_open { axf_kb = false }
    on change pk_open while pk_open { axf_kb = false }
    on change dash_open while dash_open { axf_kb = false }
    on change desk_kb while desk_kb { axf_kb = false }
    //  The wallpaper hook (logic/wallpaper_hook.luau): what the add-on that frames wallpapers answers with.
    text wph_out = ""
    event wph_done ->
    event wph_busy ->
    event wph_again ->
    fact ax_rx = 0                                         // where its content goes, once out: the middle and the size (the add-on is told when the drawer opens)
    fact ax_ry = 0
    fact ax_rw = 0
    fact ax_rh = 0
    event ax_toggle ->
    //  Where the add-on's content goes, as the drawer settles: kept up to date for the logic, which tells the add-on when the drawer opens.
    let lside = if(lp_k == 2, tm * (1 - bt), 0)
    let lbot = if(lp_k == 2, tm * bt, 0)                    // along the bottom (flipped, so the top on screen) the launcher comes out of the bottom notch, as Settings does otherwise
    let ssd = if(lp_k == 1, tm * bt, 0)                     // and Settings out of the left one
    let dl.cL = mix(th.l / 2, th.l + 24 * u + 231.5 * pu, dsl)        // the middle of what a left-notch drawer holds: it leaves the frame and ends 24 out from it
    let ds.cL = mix(th.l / 2, th.l + 24 * u + 316.5 * pu, dsl)
    let ku = if(lp_k == 1 or lp_k == 2, pu, if(lp_k == 9 or (lp_k >= 3 and lp_k <= 6), cu, u))                      // the unit of the panel that is open: the Settings and the launcher are larger
    let dsk_w = 340 * du                                   // the desk's width and height, once out
    let dsk_h = 460 * du
    let lp.gx0 = lf.x
    let lp.gxf = ccx - (pw_x / 2 + 6.5) * ku
    let lp.xl = mix(lp.gx0 + (lp.gxf - lp.gx0) * dsl, lf.x, att)
    let pcx0 = mix(cx, mix(mix(ccx - (lp.gxf - lp.gx0) * (1 - dsl), mix(mix(ccx, dl.cL, lside), ds.cL, ssd), edg), mix(lf.w + 6.5 * ku + pw_x * ku / 2, screen.width - th.r - 6.5 * u - pw_x * u / 2, rgt), att), lmk)
    //  Along the top or the bottom the control centre and the calendar hang from the strip's right end (where their buttons are), not from the middle as on the
    //  Island: `rtop` is how far over that is, with their right edge against the right frame.
    let rtop = if(lp_k == 3 or lp_k == 4, tm, 0)
    //  Click away. The surface is the whole screen (its input region is only what has a zone, so the rest lets clicks through), and this
    //  zone, declared before everything else so that everything else wins over it, closes the panel on a press anywhere that is not
    //  the panel or the bar. A second surface for this would take Escape away from the panel, so it is done here.
    zone box away_z { at: screen.width / 2, screen.height / 2; size: screen.width, screen.height; active: (panel != none and panel != volume and panel != notif) or wp_picker_open or ov_open or dash_open }
    on press away_z { panel = none; wp_picker_open = false; ov_open = false; dash_open = false }
    on press right away_z { panel = none; wp_picker_open = false; ov_open = false; dash_open = false }
    //  The marks are laid out along one line with the SAME empty space between every neighbouring pair, whatever their sizes: each one has a slot as long
    //  as itself (a dot, a larger square if it has windows, or the pill while it is the active one, and in between while it morphs), and the slots follow
    //  each other `ws.g` apart, the whole row centred on its place. `ws.cN` is where slot N's middle is, from the row's middle.
    let ws.U = mix(bu, bcu, lm)
    let ws.g = 9 * ws.U
    let ws.pb = 15 * ws.U                 // the pill's thickness, the same wherever it is
    let ws.pl = ws.pb + 14 * ws.U         // and its length, resting on one workspace
    let ws.s1 = mix((8 + 4.5 * ws.tall.1) * ws.U, ws.pl, ws.act.1)
    let ws.s2 = mix((8 + 4.5 * ws.tall.2) * ws.U, ws.pl, ws.act.2)
    let ws.s3 = mix((8 + 4.5 * ws.tall.3) * ws.U, ws.pl, ws.act.3)
    let ws.s4 = mix((8 + 4.5 * ws.tall.4) * ws.U, ws.pl, ws.act.4)
    let ws.s5 = mix((8 + 4.5 * ws.tall.5) * ws.U, ws.pl, ws.act.5)
    let ws.s6 = mix((8 + 4.5 * ws.tall.6) * ws.U, ws.pl, ws.act.6)
    let ws.s7 = mix((8 + 4.5 * ws.tall.7) * ws.U, ws.pl, ws.act.7)
    let ws.s8 = mix((8 + 4.5 * ws.tall.8) * ws.U, ws.pl, ws.act.8)
    let ws.s9 = mix((8 + 4.5 * ws.tall.9) * ws.U, ws.pl, ws.act.9)
    let ws.s10 = mix((8 + 4.5 * ws.tall.10) * ws.U, ws.pl, ws.act.10)
    let ws.ps = 14 * ws.U                 // the plus's slot
    let ws.sv1 = ws.s1 * ws.vis.1
    let ws.sv2 = ws.s2 * ws.vis.2
    let ws.sv3 = ws.s3 * ws.vis.3
    let ws.sv4 = ws.s4 * ws.vis.4
    let ws.sv5 = ws.s5 * ws.vis.5
    let ws.sv6 = ws.s6 * ws.vis.6
    let ws.sv7 = ws.s7 * ws.vis.7
    let ws.sv8 = ws.s8 * ws.vis.8
    let ws.sv9 = ws.s9 * ws.vis.9
    let ws.sv10 = ws.s10 * ws.vis.10
    let ws.sv11 = ws.ps * ws.pv
    //  The row starts against the overview button and runs on (left to right, or down), so a mark opening or shutting moves only what comes after it.
    //  `ws.qN` is how far the row has gone once slot N is in: its mark and the gap after it, each as open as the mark is.
    let ws.q1 = (ws.s1 + ws.g) * ws.vis.1
    let ws.q2 = ws.q1 + (ws.s2 + ws.g) * ws.vis.2
    let ws.q3 = ws.q2 + (ws.s3 + ws.g) * ws.vis.3
    let ws.q4 = ws.q3 + (ws.s4 + ws.g) * ws.vis.4
    let ws.q5 = ws.q4 + (ws.s5 + ws.g) * ws.vis.5
    let ws.q6 = ws.q5 + (ws.s6 + ws.g) * ws.vis.6
    let ws.q7 = ws.q6 + (ws.s7 + ws.g) * ws.vis.7
    let ws.q8 = ws.q7 + (ws.s8 + ws.g) * ws.vis.8
    let ws.q9 = ws.q8 + (ws.s9 + ws.g) * ws.vis.9
    let ws.q10 = ws.q9 + (ws.s10 + ws.g) * ws.vis.10
    let sg.we = max(max(max(max(max(max(max(max(max(max(ws.sv1, (ws.q1 + ws.sv2) * ws.vis.2), (ws.q2 + ws.sv3) * ws.vis.3), (ws.q3 + ws.sv4) * ws.vis.4), (ws.q4 + ws.sv5) * ws.vis.5), (ws.q5 + ws.sv6) * ws.vis.6), (ws.q6 + ws.sv7) * ws.vis.7), (ws.q7 + ws.sv8) * ws.vis.8), (ws.q8 + ws.sv9) * ws.vis.9), (ws.q9 + ws.sv10) * ws.vis.10), max(ws.q10 + ws.ps * (1 - ws.sp), 9 * ws.U * ws.sp))     //  (the room for the plus is always kept, shown or not, so the last mark never sits on the slope of the notch)  where the last mark ends (or the special workspace's star)
    //  The workspace marks decide how wide their piece is: the row (overview button, marks, plus) is measured here, and the bar widens by what it needs beyond the
    //  128 * bu it was made for (`ws.more`), so the marks never run into the title. Down the left (`lm`) the strip is the same length whatever is in it.
    let ws.row = (10 * bu + 15.5 * ws.U + sg.we) * (1 - lm)
    let ws.more = max(0, ws.row - 128 * bu)
    //  The tray's icons (the pinned apps, or all of them) are a piece of the bar like the others; the bar widens for them.
    let bar.gap = 12 * bu
    let tn = trn * bs.tray + rcn + pvn                // what the tray piece holds: the icons (as far as the piece is shown), the recording dot and the privacy lights
    let fw.tray = max(0, tn * 24 - 6) * bu               // icons 18 wide, 6 apart
    let vw.tray = fw.tray
    let bw.tray = fw.tray + bar.gap * min(1, tn)
    //  Along the top with a frame the bar is the strip: as long as the screen, as thick as the left one is wide, its pieces spread along it.
    let bar.w = mix(450 * bu + bw.tray + ws.more * bs.ws, screen.width - 24 * bu, tm)
    let bar.h = mix(40 * bu, lf.w + 10 * bu * sg, tm)               // (the top frame in pieces: the pieces are 36 * bu deep, so the middle line is 5 higher and the strip 10 taller, which leaves where the panels start where it was)
    let bar.y0 = mix(8 + 20 * bu, th.t / 2 - 5 * bu * sg, tm)
    //  Down the left the panels come out of the strip at the height of their button: `pw_y` is where the open panel's top is (see `lp.top`), and
    //  the bar's "middle line" is half a bar above it, so that the first plate keeps the 12 it has under a panel's top (`bar.y` + 32).
    let bar.y = bar.y0
    let bar.rad = 14 * bu * (1 - 0.5 * sq)                 // the bar's corner when shut: the same as the plates', not a full pill
    //  The bar's pieces sit in a row in the order Settings > Bar gives them (`bo.*`), 16 in from each end and
    //  `bar.gap` apart. Each one is as wide as what it draws (`fw.*`) and takes that and a gap (`bw.*`: less while
    //  it is being hidden, and the player's only while there is something playing); the title takes none, it is
    //  the stretch between the two ends: what comes before it is laid from the left edge, what comes after it
    //  from the right, so its gap is on the side towards the title.
    //  The clock's width is measured: the hour, the minutes and, at the edge, the day over the am/pm (both about
    //  the same width, so the column is as wide as the wider).
    let clock.col = max(caw.width, cdw.width)
    let bar.l = cx - bar.w / 2 + 16 * bu
    let bar.r = cx + bar.w / 2 - 16 * bu
    let fw.ws = 128 * bu + ws.more     // five squares 18 apart, one of them stretched out, and the overview button before them (20 more); more than that when the marks need it (`ws.more`)
    let fw.media = 0                     // previous, play, next have no slot of their own: they sit inside the window title's button, top right
    let fw.set = 15 * bu                  // the gear with its teeth
    let fw.sr = 12 * bu                   // the magnifier, glass and handle
    let fw.ctl = 13 * bu                  // the two sliders
    let fw.clock = chw.width + cmw.width + clock.col
    let vw.ws = fw.ws * bs.ws            // what each one draws, now
    let vw.media = fw.media * mshow * bs.media
    let vw.sr = fw.sr * bs.sr
    let vw.ctl = fw.ctl * bs.ctl
    let vw.clock = fw.clock * bs.clock
    let bw.ws = (fw.ws + bar.gap) * bs.ws
    let bw.media = (fw.media + bar.gap) * mshow * bs.media
    let bw.set = fw.set + bar.gap
    let bw.sr = (fw.sr + bar.gap) * bs.sr
    let bw.ctl = (fw.ctl + bar.gap) * bs.ctl
    let bw.clock = (fw.clock + bar.gap) * bs.clock
    //  How much of the row comes before each piece (`pre.*`) and after it (`post.*`).
    let pre.ws = if(bo.media < bo.ws, bw.media, 0) + if(bo.set < bo.ws, bw.set, 0) + if(bo.sr < bo.ws, bw.sr, 0) + if(bo.ctl < bo.ws, bw.ctl, 0) + if(bo.clock < bo.ws, bw.clock, 0) + if(bo.tray < bo.ws, bw.tray, 0)
    let post.ws = if(bo.media > bo.ws, bw.media, 0) + if(bo.set > bo.ws, bw.set, 0) + if(bo.sr > bo.ws, bw.sr, 0) + if(bo.ctl > bo.ws, bw.ctl, 0) + if(bo.clock > bo.ws, bw.clock, 0) + if(bo.tray > bo.ws, bw.tray, 0)
    let pre.media = if(bo.ws < bo.media, bw.ws, 0) + if(bo.set < bo.media, bw.set, 0) + if(bo.sr < bo.media, bw.sr, 0) + if(bo.ctl < bo.media, bw.ctl, 0) + if(bo.clock < bo.media, bw.clock, 0) + if(bo.tray < bo.media, bw.tray, 0)
    let post.media = if(bo.ws > bo.media, bw.ws, 0) + if(bo.set > bo.media, bw.set, 0) + if(bo.sr > bo.media, bw.sr, 0) + if(bo.ctl > bo.media, bw.ctl, 0) + if(bo.clock > bo.media, bw.clock, 0) + if(bo.tray > bo.media, bw.tray, 0)
    let pre.set = if(bo.ws < bo.set, bw.ws, 0) + if(bo.media < bo.set, bw.media, 0) + if(bo.sr < bo.set, bw.sr, 0) + if(bo.ctl < bo.set, bw.ctl, 0) + if(bo.clock < bo.set, bw.clock, 0) + if(bo.tray < bo.set, bw.tray, 0)
    let post.set = if(bo.ws > bo.set, bw.ws, 0) + if(bo.media > bo.set, bw.media, 0) + if(bo.sr > bo.set, bw.sr, 0) + if(bo.ctl > bo.set, bw.ctl, 0) + if(bo.clock > bo.set, bw.clock, 0) + if(bo.tray > bo.set, bw.tray, 0)
    let pre.sr = if(bo.ws < bo.sr, bw.ws, 0) + if(bo.media < bo.sr, bw.media, 0) + if(bo.set < bo.sr, bw.set, 0) + if(bo.ctl < bo.sr, bw.ctl, 0) + if(bo.clock < bo.sr, bw.clock, 0) + if(bo.tray < bo.sr, bw.tray, 0)
    let post.sr = if(bo.ws > bo.sr, bw.ws, 0) + if(bo.media > bo.sr, bw.media, 0) + if(bo.set > bo.sr, bw.set, 0) + if(bo.ctl > bo.sr, bw.ctl, 0) + if(bo.clock > bo.sr, bw.clock, 0) + if(bo.tray > bo.sr, bw.tray, 0)
    let pre.ctl = if(bo.ws < bo.ctl, bw.ws, 0) + if(bo.media < bo.ctl, bw.media, 0) + if(bo.set < bo.ctl, bw.set, 0) + if(bo.sr < bo.ctl, bw.sr, 0) + if(bo.clock < bo.ctl, bw.clock, 0) + if(bo.tray < bo.ctl, bw.tray, 0)
    let post.ctl = if(bo.ws > bo.ctl, bw.ws, 0) + if(bo.media > bo.ctl, bw.media, 0) + if(bo.set > bo.ctl, bw.set, 0) + if(bo.sr > bo.ctl, bw.sr, 0) + if(bo.clock > bo.ctl, bw.clock, 0) + if(bo.tray > bo.ctl, bw.tray, 0)
    let pre.clock = if(bo.ws < bo.clock, bw.ws, 0) + if(bo.media < bo.clock, bw.media, 0) + if(bo.set < bo.clock, bw.set, 0) + if(bo.sr < bo.clock, bw.sr, 0) + if(bo.ctl < bo.clock, bw.ctl, 0) + if(bo.tray < bo.clock, bw.tray, 0)
    let post.clock = if(bo.ws > bo.clock, bw.ws, 0) + if(bo.media > bo.clock, bw.media, 0) + if(bo.set > bo.clock, bw.set, 0) + if(bo.sr > bo.clock, bw.sr, 0) + if(bo.ctl > bo.clock, bw.ctl, 0) + if(bo.tray > bo.clock, bw.tray, 0)
    let pre.title = if(bo.ws < bo.title, bw.ws, 0) + if(bo.media < bo.title, bw.media, 0) + if(bo.set < bo.title, bw.set, 0) + if(bo.sr < bo.title, bw.sr, 0) + if(bo.ctl < bo.title, bw.ctl, 0) + if(bo.clock < bo.title, bw.clock, 0) + if(bo.tray < bo.title, bw.tray, 0)
    let post.title = if(bo.ws > bo.title, bw.ws, 0) + if(bo.media > bo.title, bw.media, 0) + if(bo.set > bo.title, bw.set, 0) + if(bo.sr > bo.title, bw.sr, 0) + if(bo.ctl > bo.title, bw.ctl, 0) + if(bo.clock > bo.title, bw.clock, 0) + if(bo.tray > bo.title, bw.tray, 0)
    let pre.tray = if(bo.ws < bo.tray, bw.ws, 0) + if(bo.media < bo.tray, bw.media, 0) + if(bo.set < bo.tray, bw.set, 0) + if(bo.sr < bo.tray, bw.sr, 0) + if(bo.ctl < bo.tray, bw.ctl, 0) + if(bo.clock < bo.tray, bw.clock, 0)
    let post.tray = if(bo.ws > bo.tray, bw.ws, 0) + if(bo.media > bo.tray, bw.media, 0) + if(bo.set > bo.tray, bw.set, 0) + if(bo.sr > bo.tray, bw.sr, 0) + if(bo.ctl > bo.tray, bw.ctl, 0) + if(bo.clock > bo.tray, bw.clock, 0)
    //  The top frame in three pieces (Settings > Bar > Segments): a thin frame, and glass out of it at the left (the workspaces), in the middle (the title, the clock
    //  and the tray: the clock on the middle of the screen, the title after it and the tray after that) and at the right (search, the gear and the controls, ending at the corner).
    //  `sg.*` is where each piece goes then; the glass that holds them is further down (`sg.lr`, `sg.cl0`...). The title may not grow past `sg.tw`.
    let sg.pad = 14 * bu
    let sg.in = 12 * bu
    let sg.tw = 150 * bu
    let sg.ws = sg.in + sg.pad + vw.ws / 2
    let sg.ctl = screen.width - sg.in - sg.pad - vw.ctl / 2
    let sg.set = screen.width - sg.in - sg.pad - bw.ctl - fw.set / 2
    let sg.sr = screen.width - sg.in - sg.pad - bw.ctl - bw.set - vw.sr / 2
    let sg.nw = (14 * bu + sg.tw) * bs.title + bw.tray                // what the middle piece holds after the clock: the title (always `sg.tw` wide here, so the notch does not move as the title changes) and the tray
    let sg.ck = cx - sg.nw / 2                                      // the clock's middle: the whole notch (clock, title, tray) is centred on the screen
    let sg.cl = sg.ck - fw.clock / 2                               // the clock's left and right edges
    let sg.cr = sg.ck + fw.clock / 2
    let sg.mctl = 54 * bu * mshow * bs.media * bs.title
    let sg.hw = sg.tw                                              // the title's button
    let sg.tl = sg.cr + 14 * bu * bs.title                          // where it starts, right after the clock
    let sg.te = sg.tl + sg.hw * bs.title                           // and ends
    let sg.tr = sg.te + bar.gap * min(1, tn) + vw.tray / 2
    //  Each piece's middle: from the left edge before the title, from the right edge after it.
    let at.ws = mix(if(bo.ws < bo.title, bar.l + pre.ws + vw.ws / 2, bar.r - post.ws - vw.ws / 2), sg.ws, sg)
    let mc = if(bo.media < bo.title, bar.l + pre.media + vw.media / 2, bar.r - post.media - vw.media / 2)
    let set.x = mix(if(bo.set < bo.title, bar.l + pre.set + fw.set / 2, bar.r - post.set - fw.set / 2), sg.set, sg)
    let sr.x = mix(if(bo.sr < bo.title, bar.l + pre.sr + vw.sr / 2, bar.r - post.sr - vw.sr / 2), sg.sr, sg)
    let ctl.x = mix(if(bo.ctl < bo.title, bar.l + pre.ctl + vw.ctl / 2, bar.r - post.ctl - vw.ctl / 2), sg.ctl, sg)
    let tr.x = mix(if(bo.tray < bo.title, bar.l + pre.tray + vw.tray / 2, bar.r - post.tray - vw.tray / 2), sg.tr, sg)
    let at.clock = mix(if(bo.clock < bo.title, bar.l + pre.clock + vw.clock / 2, bar.r - post.clock - vw.clock / 2), sg.ck, sg)
    //  The clock's texts are set against its right edge: the day column, the minutes, the hour.
    let clock.r = at.clock + fw.clock / 2
    let clock.left = clock.r - clock.col - cmw.width - chw.width
    //  Where the window title starts, and how far it may reach: the stretch (the gaps are its neighbours').
    let win.x = bar.l + pre.title
    let win.w = mix(max(0, bar.r - post.title - win.x), sg.tw, sg)
    //  The window title's button. On the Island it hugs the left end of the stretch the other pieces leave; along the top or the bottom with a frame it is centred on
    //  the strip, as the panels are, as near the middle as the pieces beside it allow (`win.xs` is where its text starts, `win.cm` where an empty one's dots go).
    let mctl = 54 * bu * mshow * bs.media * bs.title
    let win.hw = mix(clamp(max(clsw.width + mctl, titw.width) + 12 * bu, 48 * bu, win.w), sg.tw, sg)
    let win.xs = mix(mix(win.x, clamp(cx - win.hw / 2 + 6 * bu, win.x, max(win.x, win.x + win.w - win.hw + 6 * bu)), tm), sg.tl + 6 * bu, sg)
    let win.cm = mix(mix(win.x + win.w / 2, clamp(cx, win.x + 24 * bu, max(win.x + 24 * bu, win.x + win.w - 24 * bu)), tm), sg.tl + win.hw / 2, sg)
    //  The three pieces of glass, from the corners in (the outer ones reach `sg.r` off the screen so they are part of the edge): the left one holds the workspaces
    //  (as long as the row is: `sg.lr`, below), the middle one the clock, the title and the tray, the right one search, the gear and the controls.
    let sg.r = 12 * bu
    let sg.up = (bar.y + sg.r) * sg                                // a drawer that hangs from the top reaches up to the edge of the screen here, out of its piece (it starts at the strip's middle line elsewhere)
    let sg.hc = 36 * bu                                             // how far the two corner pieces reach down (the middle one too; only a drawer that hangs from it goes all of `th.t`)
    let sg.fl = 12 * bu                                             // room for the slope where a piece runs into the thin frame, so nothing sits on it
    let sg.c0 = sg.cl - sg.pad - sg.fl
    let sg.c1 = sg.te + bw.tray + sg.pad + sg.fl
    let sg.rl = screen.width - sg.in - sg.pad - bw.ctl - bw.set - bw.sr + bar.gap - sg.pad - sg.fl
    //  Where the panels hang from in this layout: the calendar, the window title's, the tray's and the player's from the middle of the screen, where the middle piece is; the controls
    //  from the right end as along the other top frames. (`pcx0`, `rtop` are above; the panels are drawn about `pcx`.)
    let pcx.o = mix(pcx0, screen.width - th.r - 6.5 * ku - pw_x * ku / 2, rtop)
    let pcx = mix(pcx.o, if(lp_k == 4, cx, pcx.o), sg)              // (the calendar is centred on the screen like the title and the tray, which already are)
    let room = 14 * bu
    let roomv = 14 * bcu                    // and down the left, where the dots are larger
    //  Down the left, top to bottom: the workspaces (their middle one at `lv.ws`), the title, and from the foot up the clock (its
    //  hour at `lv.clk`, the minutes, am/pm, the weekday and the date under it), the controls, search and the gear, 32 apart. Whole pixels, for the texts.
    let lv.ws = yo + lf.t + 88 * bcu
    let lv.clk = vb - lf.t - 73 * bu
    let lv.ctl = lv.clk - 34 * bu
    let lv.set = lv.ctl - 32 * bu
    let lv.sr = lv.set - 32 * bu
    let lv.tray = lv.sr - 22 * bu - max(0, tn * 24 - 6) * bu      // the tray apps sit just above the search, under the title
    //  The window title down the left, as in Synoptik's ActiveWindowCard: the app and its title turned a quarter anticlockwise (read from the foot
    //  up), centred in what the other pieces leave (`lv.tt` to `lv.bot`), with the player's buttons stacked at its top end while there is a player.
    let lv.tt = lv.ws + 52 * bcu + 14 * bu
    let lv.bot = lv.tray - 14 * bu * min(1, tn)
    let lv.mc = 62 * bcu * mshow * bs.media0            // what the player's buttons take, along the title
    let lv.none = if(max(vclw.width, vtiw.width) < 1, 1, 0)       // nothing is focused (an empty workspace): three dots take the title's place, so there is something to click
    let lv.span = clamp(max(max(vclw.width, vtiw.width), lv.none * 44 * bcu), 0, max(1, lv.bot - lv.tt - lv.mc))     // how long the text is (cut where the stretch ends)
    let lv.y0 = clamp(vc - (lv.span + lv.mc) / 2, lv.tt, max(lv.tt, lv.bot - lv.span - lv.mc))     // the top of buttons and text together, centred as one on the middle of the screen, as near as the pieces above and below let it
    let lv.mid = lv.y0 + 31 * bcu                       // the buttons' middle (previous nearest the text, 17 apart)
    let lv.tm = lv.y0 + lv.mc + lv.span / 2           // the text's middle
    let ws.c1 = ws.sv1 / 2
    let ws.c2 = ws.q1 + ws.sv2 / 2
    let ws.c3 = ws.q2 + ws.sv3 / 2
    let ws.c4 = ws.q3 + ws.sv4 / 2
    let ws.c5 = ws.q4 + ws.sv5 / 2
    let ws.c6 = ws.q5 + ws.sv6 / 2
    let ws.c7 = ws.q6 + ws.sv7 / 2
    let ws.c8 = ws.q7 + ws.sv8 / 2
    let ws.c9 = ws.q8 + ws.sv9 / 2
    let ws.c10 = ws.q9 + ws.sv10 / 2
    let ws.c11 = ws.q10 + ws.sv11 / 2
    //  The overview button, before the first mark (at the top of them down the left): its middle and its size.
    let ob.x = mix(at.ws - vw.ws / 2 + 10 * bu, lf.x, lm)
    let ob.y = mix(bar.y, yo + lf.t + 24 * bcu, lm)
    let ob.s = 18 * ws.U
    let ob.d = ob.s * (1 + 0.2 * pick(screen.index, ovp.0, ovp.1))       // as it is drawn
    let ws.o = mix(ob.x, ob.y, lm) + ob.s / 2 + 6.5 * ws.U
    let ws.a1 = ws.o + ws.c1
    let ws.a2 = ws.o + ws.c2
    let ws.a3 = ws.o + ws.c3
    let ws.a4 = ws.o + ws.c4
    let ws.a5 = ws.o + ws.c5
    let ws.a6 = ws.o + ws.c6
    let ws.a7 = ws.o + ws.c7
    let ws.a8 = ws.o + ws.c8
    let ws.a9 = ws.o + ws.c9
    let ws.a10 = ws.o + ws.c10
    let ws.a11 = ws.o + ws.c11
    let sg.lr = ws.o + sg.we + sg.pad + sg.fl - 9 * ws.U                      // where the left piece of the top frame (Segments) ends: just after the last workspace mark

    //  The music only moves the bar: it fades out as the panel opens (gone by a third of
    //  the way), so an open panel sits still.
    let pv = pulse * (1 - min(1, drop * 3)) * (1 - lm) * (1 - sg)
    let pop = pv * 6 * u           // how far the bar swells on the beat
    //  The bounce on `dc`/`dk` (below) is free to swing past 1 on the way open - that
    //  overshoot is the spring showing - but a size can't go negative, so anything
    //  that scales a width or height reads the clamped version instead: it shrinks
    //  cleanly to nothing on the way closed rather than through it.
    let pown = if(panel_scr == screen.index, 1, 0)     // this copy is the monitor the panel is on
    let dc0 = max(0, dc) * pown
    let dk0 = max(0, dk) * pown
    let dm0 = max(0, dm) * pown
    let do0 = max(0, do)
    let dz0 = max(0, dz) * pown
    let ds0 = max(0, ds) * pown
    let dl0 = max(0, dl) * pown
    let axo = if(ax_scr == screen.index, 1, 0)             // this copy is the monitor the add-on drawer is on
    let dax0 = max(0, dax) * axo
    //  The Retro's pixelation, only while a drawer opens or closes: the side of a square, from how far the drawer's spring and its slower twin (`pq.*`, below) are apart: none at rest, the biggest soon after it
    //  starts moving, and still there after it has arrived. `px.*` is each drawer's own (its contents: pixelate.wgsl), `pxa` the biggest, for the glass (wave.wgsl).
    let px.dc = cas_k * 16 * min(1, sqrt(2.4 * abs(clamp(dc, 0, 1) - pq.dc)))
    let px.dk = cas_k * 16 * min(1, sqrt(2.4 * abs(clamp(dk, 0, 1) - pq.dk)))
    let px.dm = cas_k * 16 * min(1, sqrt(2.4 * abs(clamp(dm, 0, 1) - pq.dm)))
    let px.dz = cas_k * 16 * min(1, sqrt(2.4 * abs(clamp(dz, 0, 1) - pq.dz)))
    let px.ds = cas_k * 16 * min(1, sqrt(2.4 * abs(clamp(ds, 0, 1) - pq.ds)))
    let px.dl = cas_k * 16 * min(1, sqrt(2.4 * abs(clamp(dl, 0, 1) - pq.dl)))
    let px.do = cas_k * 16 * min(1, sqrt(2.4 * abs(clamp(do, 0, 1) - pq.do)))
    let pxa = max(max(max(px.dc, px.dk), max(px.dm, px.dz)), max(max(px.ds, px.dl), px.do))
    let expand0 = max(0, expand)
    //  Marea's liquid: while a drawer comes out (or goes back), the neck that joins it to the bar is a bell,
    //  thickest halfway; the drawer is a little narrower there, as a falling drop is, and it is round at first
    //  and squares up as it grows (and rounds again as it goes). `*.bell` is 0 shut, 1 halfway, 0 open.
    let dk.bell = 4 * min(1, dk0) * (1 - min(1, dk0))
    let dk.tail = mix(1, clamp(dk0 * 16 - 0.1, 0, 1), sg)       // the three pieces: the controls' drawer shrinks away over its last few percent, instead of lingering as a nub under its piece
    let ds.bell = 4 * min(1, ds0) * (1 - min(1, ds0))
    let dl.bell = 4 * min(1, dl0) * (1 - min(1, dl0))
    let dax.bell = 4 * min(1, dax0) * (1 - min(1, dax0))
    let dc.bell = 4 * min(1, dc0) * (1 - min(1, dc0))
    let do.bell = 4 * min(1, do0) * (1 - min(1, do0))
    let dz.bell = 4 * min(1, dz0) * (1 - min(1, dz0))
    let dm.bell = 4 * min(1, dm0) * (1 - min(1, dm0))
    //  Both panels fill in their width quickly and then keep growing taller - so a
    //  plain `min(1, …)` on the width leaves it capped flat once that's done, and
    //  the bounce on the way to fully open (or the little one closing overshoots
    //  into) only ever shows up as a change in height. The `max(0, … - 1) * 0.6`
    //  term only wakes up past that cap, so the width bulges a little with the
    //  same overshoot instead of sitting there rigid while the height does all
    //  the springing.
    let card.w = bar.w * (min(1, dc0 * 3) + max(0, dc0 - 1) * 0.6)
    let card.h = 373 * cu * dc0        // 303, and 70 more for the weather strip
    //  The controls drawer: as wide as its plates and their margins need (288 + 2 x 12), coming
    //  out of the bar. It starts narrow and wide-open in height last, and widens to its place.
    //  It reaches up into the bar so the two can melt; `dk.hh` is how far down it goes.
    let dk.w = (120 + 192 * (min(1, dk0 * 1.6) + max(0, dk0 - 1) * 0.6)) * cu
    //  The plates stack from a shared cursor, each one naming where the one
    //  before it ended, so a plate that changes height (the media one, which
    //  shrinks to a sliver with nothing playing) pushes what is under it
    //  instead of leaving a gap or a pile-up. Unscaled: `u` is applied where
    //  each offset is finally used. Wi-Fi and Bluetooth are tiles side by side
    //  now, at the very top, so they cost one row's height between them.
    let tiles_top  = 8
    let tiles_h    = 72
    let tiles_bot  = tiles_top + tiles_h
    //  Do Not Disturb and Caffeine: a second row of tiles, the same size as the first.
    let tiles2_top = tiles_bot + 4
    let tiles2_bot = tiles2_top + tiles_h
    let bright_top = tiles2_bot + 4
    //  The three sliders (brightness, the microphone, the volume) are rows of ONE card, 132 tall: the rows' middles are 26, 66 and 106 from its top (`vol_top` is the volume row's top, 24
    //  above its middle), and the mixer grows the card at its foot.
    let bright_bot = bright_top + 132
    let vol_top    = bright_top + 82
    let vol_bot    = bright_bot
    //  The player's plate is alone in its own panel now, at the top of it.
    let media_top  = 8
    let mdk        = media_open * (1 - clamp(mfl, 0, 1))   // how much of the card is in the panel: none with nothing playing, none while it is floating
    let media_h    = 148 * mdk                  // the full card has the seek row under the song and the controls
    let media_bot  = media_top + media_h
    //  Either tile can grow past the stack into its own window - as tall as its
    //  list actually is (one open row taller, while one is), up to a ceiling
    //  where the list itself starts scrolling instead of the window still
    //  growing to fit it.
    let wifi_rows_h = max(1, wifi_nets.count) * 34 - 4 + (44 + wifi_pf) * wifi_extra
    let bt_rows_h   = max(30, bt_list_h) + (44 + bt_pf) * bt_extra
    let list_max    = 220
    //  The notifications window has a Do Not Disturb row and its timer chips above its list (84 more), and a
    //  shorter list. Its rows are 54 px with 6 between, whole pixels.
    let nt_rows_h = (max(1, nt_hist.count) * 60 - 6) / u
    let list_view_h = min(if(showing_sub == btview, bt_rows_h, if(showing_sub == notifview, nt_rows_h, wifi_rows_h)), if(showing_sub == notifview, 150, if(showing_sub == btview, 180, list_max)))
    //  The Caffeine window is a row and two lines of chips (91 under its title), and has no list.
    //  Every window opened from a tile is at least as tall as the stack of cards it replaces (the brightness and volume rows
    //  included), so the drawer keeps one height from one window to the next; a longer list grows it past that. The
    //  Bluetooth window has a strip of its own (this computer, and discoverable) above its list.
    let sub_min = vol_bot - tiles_top - 70
    //  The Capture and the Power windows are only as tall as they are (no minimum); the rest keep `sub_min`.
    //  The Power window lists the battery levels (this computer, then each connected device that says) between the session tiles and the profile.
    let bat_rows = (if(bat_here, 1, 0)) + bat_n
    let bat_h = if(bat_rows > 0, 20 + 56 * bat_rows, 0)
    let sub_content = if(showing_sub == capview, if(rec_on, 142, 186), if(showing_sub == powview, 151 + bat_h, max(sub_min, if(showing_sub == cafview, 38, if(showing_sub == notifview, 60, if(showing_sub == btview, 40, 0)) + list_view_h))))
    let sub_bot = tiles_top + 54 + sub_content + 16
    //  The output list drops over what is under the volume row; with more than a couple of outputs
    //  it reaches past the drawer, so the drawer grows to hold it while it is open.
    let dd.rows = clamp(outlist.count, 1, 6)
    let dd.extra = max(0, dd.rows * 30 - 28) * max(0, dd)
    //  The mixer hangs under the volume plate: a row of 32 per app (a line of words with none), and the drawer
    //  grows to hold it.
    //  The mixer is part of the volume card: the card grows by `mix.m` while it is open (a row of 32 per app, or a line of
    //  words with none, and room for the dots at the foot).
    let mix.m = if(mixer.count > 0, mixer.count * 32 + 8, 40)
    let vp.h = 132 + mix.m * clamp(vm, 0, 1)                // the volume card's height, unscaled
    let mix.extra = mix.m * max(0, vm)
    let content_bot = mix(vol_bot + max(dd.extra, mix.extra), sub_bot, expand0)
    let dk.hh = bar.h / 2 + (content_bot + 16) * cu * dk0 + 13 * cu * tm * dk0 + max(0, sag)      // (the 13 is `lp.dd`: along the top or bottom the margins are made 18.5 all round here too)
    //  The player's panel: the same drawer as the controls, centred on the bar, and as tall as
    //  its one plate.
    //  The calendar's drawer: it falls as a narrow drop out of the bar and widens to exactly the bar's width as it
    //  lands, with the liquid neck of the other drawers while it is narrower (see `dc.bell`). It starts at the bar's
    //  middle, as they do, so the blend has the bar to melt into; as tall as the bar's lower half plus its content.
    let dc.w = (120 + 330 * (min(1, dc0 * 1.6) + max(0, dc0 - 1) * 0.6)) * cu
    let dc.neck = 0.5 + 0.5 * sg                // how much of the others' liquid neck the calendar's join to the bar has: 0 is a sharp angle, 1 the same as Settings (it sticks out less, so all of it is too soft; in the top frame in pieces it hangs from the middle piece like the title panel, and has all of it)
    let dc.hh = bar.h / 2 + card.h + 6 * cu * tm * dc0 + max(0, sag)
    //  Once it is as wide as the bar (`f` 1) it must be a straight continuation of the bar's sides, so it moves its top up to
    //  the bar's top edge and stops blending: a blend there would puff the join out at the bar's corners.
    let dc.f = clamp((dc.w - bar.w + 24 * u) / (24 * u), 0, 1)
    let dc.top = mix(bar.y, bar.y - bar.h / 2, dc.f)
    //  The volume / notification drawer: 340 wide, as tall as its plate.
    //  The notification's plate is as tall as what is on it: the app line, the title (one line or more),
    //  the body if there is one (as many lines as it needs), and a row of buttons if it brought any,
    //  with 12 of air around. Never shorter than its icon tile. Each text measures itself once wrapped.
    let nt_th = max(24, ntt.height / u)
    let nt_bh = ntb.height / u
    let nt_content = if(nt_body_on, 39 + nt_th + nt_bh, 35 + nt_th)
    let nt_h = max(68, nt_content + if(nt_acts.count > 0, 34, 0) + 12)
    follow osd_h = if(osd_kind == note, nt_h, if(osd_kind == shot, 248, 64 + 72 * max(0, if(osd_v, 1, 0) + if(osd_b, 1, 0) + if(osd_m, 1, 0) - 1)))
    //  The settings panel: 620 wide. A header (36), then the sidebar and the page side by side (352).
    //  How tall the settings page in view is (unscaled): Wallpaper, Glass, Display.
    //  The Display page: its cards down to the profiles one, which is as tall as its rows (none: a line).
    let disp.prows = max(24, disp_pn_s * 30)
    let disp.h = 554 + disp.prows + 114
    //  The System monitor page: the storage card has a row for each drive and the temperature card one for each sensor, and what is under
    //  them slides up as they shrink (see the page, which is generated: sm.ds and sm.dt are how much each has given back).
    //  The sidebar, top to bottom: LOOK (Wallpaper, Theme, Glass), SHELL (Bar, Widgets, Add-ons, Notifications, Lock screen), SCREEN (Display, Night mode) and SYSTEM
    //  (the window manager, Keybinds, VPN, System monitor, About). `side.hN` are the headings. To add a section, give it a row here (the previous row + 32), draw its
    //  item like the others, and move `side.last` to its row: About is always the row after `side.last`, so it stays the final one, and Settings' minimum height
    //  follows it (see `set.h`).
    let side.h1 = 18
    let side.wp = 42
    let side.th = 70
    let side.gl = 98
    let side.h2 = 132
    let side.bar = 156
    let side.ck = 184                  // the Widgets row
    let side.ao = 212                  // the Add-ons row
    let side.nt = 240
    let side.lk = 268
    let side.h3 = 302
    let side.dp = 326
    let side.nm = 354                  // the Night mode row
    let side.h4 = 388
    let side.hy = 412
    let side.wm = side.hy + if(wm_hypr or wm_niri, 28, 0)    // the Hyprland row is only there on Hyprland (and the niri one on niri), and the Pleamar-WM one only under pleamar-wm
    let side.ky = side.wm + if(wm_pwm, 28, 0)              // the Keybinds row
    let side.vpn = side.ky + 28
    let side.mon = side.vpn + 28
    let side.last = side.mon
    let side.ab = side.last + 28
    let sm.ds = (4 - clamp(sm_mnt.count, 1, 4)) * 38
    let sm.dt = (8 - clamp(sm_tmp.count, 1, 8)) * 24
    let sm.h = 1536 - sm.ds - sm.dt
    //  The VPN page: the profiles card is as tall as its rows, and the add card as its form (WireGuard 5 rows, OpenVPN 4, a file 1 and a line).
    let vpn.pb = 84
    let vpn.pbh = 34 + max(1, vpn_count) * 32 + 6
    let vpn.ab = vpn.pb + vpn.pbh + 12
    let vpn.fh = if(vpn_mode == vpm_wg, 180, if(vpn_mode == vpm_ovpn, 144, 276))
    let wm.h = 946                     // the Pleamar-WM page: to the bottom of its last card
    let ad.h = 36 + max(1, addons.count) * 92 + 52                 // the Add-ons page: a card each (92 apart), and the line under them
    let ck.h = 1208                    // the Widgets page: the clock's cards, then the system monitor's, to the bottom of the last
    let gl.h = 862                     // the Glass page: to the bottom of its last card
    let lk.h = 806                     // the Lock screen page: its cards, to the bottom of the last
    //  The Notifications page: the apps card has a row for each app (up to 14), and the rules card is there while one is open.
    let nt.ds = (14 - clamp(nta_count, 1, 14)) * 36
    let nt.h = 246 + 146 + 552 - nt.ds + 8 + if(nta_sel >= 0, 456, 0) + 12              // 146 of it the quiet hours card on top
    //  A fixed height, whatever the page: the panel used to follow the page in view (262 to 456), so it resized, and moved what hangs from it, with
    //  every click in the sidebar. A page taller than this scrolls inside it (they have their scroll thumb and "More" cue); a shorter one has
    //  empty glass at its foot. It never goes below the sidebar's last row.
    let set.h = max(side.ab + 40, 456)
    let ss.w = (120 + 500 * (min(1, ds0 * 1.6) + max(0, ds0 - 1) * 0.6)) * pu
    let ss.hh = bar.h / 2 + (8 + 36 + 8 + set.h + 16) * pu * ds0 + max(0, sag)
    //  The launcher: a drop that widens to the bar's width as it lands, like the calendar. The search field (40), the
    //  rows (44 each, up to eight; seven where there is a preview beside them) and a line of hints.
    let dl.w = (120 + 330 * (min(1, dl0 * 1.6) + max(0, dl0 - 1) * 0.6)) * pu
    let dl.hh = bar.h / 2 + (172 + lr * 44) * pu * dl0 + max(0, sag)
    let dl.f = clamp((dl.w - bar.w + 24 * u) / (24 * u), 0, 1)     // as for the calendar
    let dl.top = mix(bar.y, bar.y - bar.h / 2, dl.f)
    let dm.w = (120 + 208 * (min(1, dm0 * 1.6) + max(0, dm0 - 1) * 0.6)) * cu
    //  Under the player's plate, the running windows and then the tray apps, each a header and rows, scrolling past a few.
    let task_rows = min(max(1, tasks.count), 6)
    let tasks_top = media_bot + 8 * mdk
    let tasks_list = tasks_top
    let tasks_bot = tasks_list + task_rows * 40 - 4
    let tray_rows = min(trays.count, 3)
    let tray_top = tasks_bot + 8
    let tray_list = tray_top + 26
    let panel_bot = if(trays.count > 0, tray_list + tray_rows * 40 - 4, tasks_bot)
    let dm_foot = 11.5                              // the room under the last row: the same as at its sides (about 19.5), not 16, which came out a few more
    //  The tray menu: the app's plate (8..60), Open and Alt (66..92), then its menu from 100 (or a line saying it has none).
    let tm.list = min(tm_h, 224)
    let tm_bot = 100 + if(tm_has_menu, tm.list, 30) + 8
    let dm.hh = bar.h / 2 + (if(dm_mode == dmm_tray, tm_bot + 16, panel_bot + dm_foot)) * cu * dm0 + 13 * cu * tm * dm0 + max(0, sag)
    let mdx = pcx
    //  Down the left, where the open panel is (`lp_k`: which was opened last), in its own coordinates: it ends up in the middle of the screen,
    //  except the volume, which is low, and the notification, which is high. It leaves the strip at the height of its button (`lp.btn`; the volume
    //  and the notification leave at their own height) and its middle travels from there to its place with the drop (`lp.cy`). `pw_y` follows its top.
    let lp.btn = if(lp_k == 1, mix(vb - th.b / 2, vcc, ssd), if(lp_k == 2, mix(mix(yo + th.t / 2, vcc, lside), vb - th.b / 2, lbot), if(lp_k == 3, lv.ctl, if(lp_k == 4, lv.clk + 30 * u, if(lp_k == 5, lv.tray + 9 * u, if(lp_k == 6, lv.tm, 0))))))
    //  Margins: the plates are 12 in from a drawer's top and bottom in their own layouts and 18.5 in from its sides, so a panel's content is moved by
    //  `lp.dy` and the drawer made `lp.dd` taller to make them 18.5 all round (Settings included).
    let lpm = max(lmk, tm * att)                  // the corrections apply to the strip's own panels on a top or bottom frame as well as on a side one
    let lp.dy = if(lp_k == 1, 4.5, if(lp_k == 2 or lp_k == 3 or lp_k == 7 or lp_k == 8, 6.5, if(lp_k == 4, -0.5, 0))) * ku * lpm
    let lp.dd = if(lp_k == 1, 11, if(lp_k == 2, 11, if(lp_k == 3 or lp_k == 7 or lp_k == 8, 13, if(lp_k == 4, 6, 0)))) * ku * lpm
    let lp.hd = (if(lp_k == 1, (8 + 36 + 8 + set.h + 16) * pu, if(lp_k == 2, (172 + lr * 44) * pu, if(lp_k == 3, (content_bot + 16) * cu, if(lp_k == 4, 373 * cu, if(lp_k == 5 or lp_k == 6, (if(dm_mode == dmm_tray, tm_bot + 16, panel_bot + dm_foot)) * cu, if(lp_k == 9, dsk_h, (8 + osd_h + 16) * u))))))) + lp.dd
    //  Where it settles, as drawn (`ty`): Settings low, the launcher high, a good way from the middle, and clear of the frame; then back to the panel's
    //  own coordinates (the contents are scaled about the middle of the screen).
    let lp.ty = if(lp_k == 1, mix(min(vc + 190 * u, vb - th.b - 24 * u - lp.hd / 2), vcc, ssd), mix(mix(max(vc - 210 * u, yo + th.t + 24 * u + lp.hd / 2), vcc, lside), vb - th.b - 24 * u - lp.hd / 2, lbot))
    let lp.yf = if(lp_k == 1 or lp_k == 2, lp.ty, if(lp_k == 3 or lp_k == 4, clamp(lp.btn, yo + lf.t + 24 * u + lp.hd / 2, vb - lf.t - lp.hd / 2), if(lp_k == 5 or lp_k == 6, clamp(lp.btn, yo + lf.t + 24 * u + lp.hd / 2, vb - lf.t - 24 * u - lp.hd / 2), if(lp_k == 7, vb - lf.t - 24 * u - lp.hd / 2, if(lp_k == 8, yo + lf.t + 24 * u + lp.hd / 2, vc)))))
    let lp.sy0 = if((lp_k == 7 or lp_k == 8 or lp_k == 9), lp.yf, lp.btn)
    let lp.gy0 = if(att > 0.5, lp.yf, lp.btn)
    let lp.cy = lp.gy0 + (lp.yf - lp.gy0) * dsl
    //  The controls and the calendar can sit against the bottom frame, and melt into it; the others keep 24 off it.
    let lp.top = lp.cy - lp.hd / 2
    //  Sitting on the bottom frame the glass reaches 14 into it, so the two are one piece and not two edges side by side (the content stays where it was).
    let lp.ext = 14 * u * lmk * clamp((lp.cy + lp.hd / 2 - (vb - th.b - 14 * u)) / (14 * u), 0, 1)
    on change panel {
        pq_sw = fm > 0.5 and pcur != none and panel != none and panel != pcur
        pending = if(pq_sw, panel, if(panel != none and panel != pending, none, pending))
        panel = if(pq_sw, none, panel)
        pcur = panel
        //  Which panel was opened last, and how wide it is: where the panels sit down the left follows it (see `lp.top`, `pcx`). Here, in the
        //  scene, not in the logic (its own popups, volume and notifications, set `panel` itself and nothing told it), and only once the panel
        //  is really being opened: a switch from one to another leaves the open one in its own shape until it has gone.
        lp_w = if(panel == settings, 620, if(panel == controls, 312, if(panel == player or panel == tray, 328, if(panel == volume or panel == notif, 340, if(panel == calendar or panel == launch, 450, if(panel == desk, 340, lp_w))))))
        lp_k = if(panel == settings, 1, if(panel == launch, 2, if(panel == controls, 3, if(panel == calendar, 4, if(panel == tray, 5, if(panel == player, 6, if(panel == volume, 7, if(panel == notif, 8, if(panel == desk, 9, lp_k)))))))))
    }
    //  Whatever happened on the way (a hover that bounced between the two), the drawer that is coming out is the one whose shape and width the strip uses.
    on change dk > 0.5 while dk > 0.5 { lp_k = 3; lp_w = 312 }
    on change dc > 0.5 while dc > 0.5 { lp_k = 4; lp_w = 450 }
    //  ...and the waiting one opens once the drop of the one before has gone back in (its `dtrav` is back to nothing). It is the compound that is
    //  watched, so that it also fires when the wait begins with the strip already at rest.
    //  `pq.at` is how far back in the closing drop has to be: 0 would wait until it is gone, 1 would not wait at all. Half way, the next panel
    //  starts while the old one is still folding in, and the glass turns round smoothly from where it is (`dtrav` follows `panel`, so it reverses
    //  instead of restarting). If the shape snaps where they meet, lower it; for a closer overlap, raise it.
    let pq.at = 0.5
    on change dtrav < pq.at and pending != none while dtrav < pq.at and pending != none { panel = pending; pending = none }
    //  What a drop out of the strip is made of, as in Marea's (marea.plm, "the body"): the strip's edge bulges towards the drop while it holds it
    //  (`dj.sag`, most halfway), the neck is a bell that ends at nothing so that the thread breaks by itself (`dj.neck`), when it breaks two crests
    //  run along the edge (`dj.ripx`, `dj.riph`) and a small drop is left hanging from it for a moment (`dj.stray`), and the drop stretches with its
    //  speed (`dj.stretch`) and shakes (`wobble`) when it lets go. `dj.y0` is where it comes out: the panel's own vertical middle.
    let dj.out = clamp(dsl, 0, 1)
    let dj.tension = 4 * dj.out * (1 - dj.out)
    let dj.sag = max((26 * dj.tension + pbounce) * u * lmk * (1 - att), 0.3)
    let dj.neck = 52 * u * 4 * dj.out * (1 - dj.out)
    let dj.ripx = (12 + 90 * prip) * u
    let dj.riph = 20 * u * (1 - prip) * clamp(prip * 6, 0, 1) * lmk * (1 - att) * (1 - uwu_k)
    let dj.stray = 10 * u * pstray * lmk * (1 - att)
    let dj.stretch = clamp(vel(dtrav) * 0.07, 0, 0.5) * lmk * (1 - cas_k)
    let dj.y0 = lp.sy0
    let dj.ey = if(lp_k == 1 or lbot > 0.5, vb - th.b / 2, yo + th.t / 2)     // the frame edge a drop comes out of (bottom for Settings, top for the launcher)
    let dj.es = if(lp_k == 1 or lbot > 0.5, -1, 1)                                  // and which way the small stray drop hangs from it: up, or down
    //  Those four shapes are never zero-size (a floor of 0.3 keeps them valid), so left in place they are a sliver on the strip's edge at the height of
    //  the panel last opened. They are only in play while a panel that drips is on its way or just after it (its ripples and stray drop), and
    //  off the screen the rest of the time (`show:` does not take a shape off the glass).
    let dj.act = if(cas_k < 0.5 and lmk > 0.5 and att < 0.5 and lside < 0.5 and ssd < 0.5 and pown > 0.5 and (dtrav > 0.02 or prip < 0.98 or pstray > 0.01 or abs(pbounce) > 0.2), 1, 0)
    let dj.px = if(dj.act > 0.5, 0, 30000)
    //  A drawer out of a left notch (search with the strip along the top, Settings along the bottom) drips sideways: the same four shapes, turned a quarter, along the left frame.
    let dj.sideact = if(cas_k < 0.5 and lmk > 0.5 and lside + ssd > 0.5 and pown > 0.5 and (dtrav > 0.02 or prip < 0.98 or pstray > 0.01 or abs(pbounce) > 0.2), 1, 0)
    let dj.spx = if(dj.sideact > 0.5, 0, 30000)
    //  Each drawer's shape as it is drawn (`*.ex`, `*.ey` its middle, `*.ew`, `*.eh` its size). From the top bar it is the drawer above: it falls,
    //  widening on the way. Down the left it comes out sideways from the strip instead: it starts small and grows in both ways (`*.lf`, the same quick
    //  rise the width has above) around the panel's own vertical middle, and to the right, from the strip's middle to where the panel ends (`*.rt`, 6.5 past the plates' side: with the 6.5 in `pcx` it makes the margin all round (strip side, right, top) the same, 18.5; the calendar's and the launcher's are 450 wide here, not the bar's width, which grows with the tray icons). Its contents stay where
    //  they will end up, and the drawer's shape uncovers them (they are clipped to it).
    let dk.gl = mix(min(dtrav, dk0), dk0, att)
    let dk.lf = min(1, dk.gl * 1.6) + max(0, dk.gl - 1) * 0.6
    let dk.rt = mix(2 * (156 + 6.5) * cu, (lf.w - lf.x) + 325 * cu, att)
    let dk.gw = max(0.1, dk.rt * dk.lf)
    let dk.gh = (((content_bot + 16) * cu) + lp.dd + max(0, sag)) * dk.lf
    let dk.gx = mix(lp.xl + dk.gw / 2, ccx, edg)
    //  Close to the right frame the glass reaches into that too (as at the bottom, `lp.ext`), so the panel's corner is the frame's.
    //  Along the top or the bottom the drawers come out of the strip as they do down the sides, turned a quarter: a small blob at the strip's edge, in the panel's
    //  middle, that grows both ways (`*.lf`). `*.tR` is how far it reaches from the strip's middle line when it is out; its top is that line.
    let dk.tR = bar.h / 2 + (content_bot + 16) * cu + 13 * cu * tm + max(0, sag)
    let dk.teh = dk.tR * dk.lf
    let dk.tey = bar.y + dk.teh / 2
    let dk.tew = (312 * cu + (13 * cu + 14 * u * if(lp_k == 3, 1, 0)) * tm) * dk.lf
    let dk.tex = pcx + 7 * u * if(lp_k == 3, 1, 0) * dk.lf * tm
    let dk.er = if(lp_k == 3, 14 * u * lm * clamp((dk.gx + dk.gw / 2 - (screen.width - th.r - 14 * u)) / (14 * u), 0, 1), 0) * dk.lf
    let dk.ew = mix(mix(dk.w, dk.gw + dk.er, lm), dk.tew, tu)
    let dk.eh = mix(mix(dk.hh, dk.gh + if(lp_k == 3, lp.ext * dk.lf, 0), lm), dk.teh, tu)
    let dk.ex = mix(mix(pcx, dk.gx + dk.er / 2, lm), dk.tex, tu)
    let dk.ey = mix(mix(bar.y + dk.hh / 2, lp.cy + if(lp_k == 3, lp.ext * dk.lf, 0) / 2, lm), dk.tey, tu)
    let dc.gl = mix(min(dtrav, dc0), dc0, att)
    let dc.lf = min(1, dc.gl * 1.6) + max(0, dc.gl - 1) * 0.6
    let dc.rt = mix(2 * (225 + 6.5) * cu, (lf.w - lf.x) + 463 * cu, att)
    let dc.gw = max(0.1, dc.rt * dc.lf)
    let dc.gh = ((373 * cu) + lp.dd + max(0, sag)) * dc.lf
    let dc.gx = mix(lp.xl + dc.gw / 2, ccx, edg)
    let dc.tR = bar.h / 2 + 373 * cu + 6 * cu * tm + max(0, sag)
    let dc.teh = dc.tR * dc.lf
    let dc.tey = bar.y + dc.teh / 2
    let dc.mf = if(lp_k == 4, clamp((pcx + 238.5 * cu - (screen.width - th.r - 14 * u)) / (14 * u), 0, 1), 0)    // how far the calendar's glass reaches into the right frame: only when it sits against it, so a centred one is even on both sides
    let dc.tew = (450 * cu + (13 * cu + 14 * u * dc.mf) * tm) * dc.lf
    let dc.tex = pcx + 7 * u * dc.mf * dc.lf * tm
    let dc.er = if(lp_k == 4, 14 * u * lm * clamp((dc.gx + dc.gw / 2 - (screen.width - th.r - 14 * u)) / (14 * u), 0, 1), 0) * dc.lf
    let dc.ew = mix(mix(dc.w, dc.gw + dc.er, lm), dc.tew, tu)
    let dc.eh = mix(mix((bar.y + dc.hh - dc.top), dc.gh + if(lp_k == 4, lp.ext * dc.lf, 0), lm), dc.teh, tu)
    let dc.ex = mix(mix(pcx, dc.gx + dc.er / 2, lm), dc.tex, tu)
    let dc.ey = mix(mix((dc.top + bar.y + dc.hh) / 2, lp.cy + if(lp_k == 4, lp.ext * dc.lf, 0) / 2, lm), dc.tey, tu)
    let ds.gl = min(dtrav, ds0)
    let ds.lf = mix(min(1, ds0 * 1.6) + max(0, ds0 - 1) * 0.6, min(1, ds.gl * 1.6) + max(0, ds.gl - 1) * 0.6, fm)
    let ds.rt = 2 * (310 + 6.5) * pu
    let ds.gw = max(0.1, ds.rt * ds.lf)
    let ds.gh = (((8 + 36 + 8 + set.h + 16) * pu) + lp.dd + max(0, sag)) * ds.lf
    let ds.gx = mix(mix(lp.xl + ds.gw / 2, ccx, edg), ds.cL, ssd)
    let ds.ew = mix(ss.w, ds.gw, fm)
    let ds.eh = mix(ss.hh, ds.gh, fm)
    let ds.ex = mix(pcx, ds.gx, fm)
    let ds.ey = mix(bar.y + ss.hh / 2, lp.cy, fm)
    let dl.gl = min(dtrav, dl0)
    let dl.lf = mix(min(1, dl0 * 1.6) + max(0, dl0 - 1) * 0.6, min(1, dl.gl * 1.6) + max(0, dl.gl - 1) * 0.6, fm)
    let dl.rt = 2 * (225 + 6.5) * pu
    let dl.gw = max(0.1, dl.rt * dl.lf)
    let dl.gh = (((172 + lr * 44) * pu) + lp.dd + max(0, sag)) * dl.lf
    let dl.gx = mix(mix(lp.xl + dl.gw / 2, ccx, edg), dl.cL, lside)
    let dl.ew = mix(dl.w, dl.gw, fm)
    let dl.eh = mix((bar.y + dl.hh - dl.top), dl.gh, fm)
    let dl.ex = mix(pcx, dl.gx, fm)
    let dl.ey = mix((dl.top + bar.y + dl.hh) / 2, lp.cy, fm)
    //  The add-on drawer's box: out of its notch with the side drip (`lside`), growing as it travels, standing 24 off the frame.
    //  The volume's and the notifications' drawer has its own place, whatever else is open: out of the right frame, the volume low and the
    //  notification high (down the left); from the bar, as before (along the top). Its content hangs from `os.ck` and is centred on `os.px`.
    //  A notification's drawer at its size (`nt_size`), the volume's and a screenshot's always whole: the glass is made smaller here, from its top right corner (the
    //  top stays 24 under the frame, the right edge in it), and what it holds is scaled about the same corner (pages/osd_drawer.plm), so the margins shrink with it.
    let nk = if(osd_kind == note, clamp(nt_size, 0.5, 1), 1)
    let os.hd = (8 + osd_h + 16 + 13) * u * nk
    let os.cy = if(if(osd_kind == vol or osd_kind == shot, 1, 0) + bt == 1, vb - th.b - 24 * u - os.hd / 2, yo + th.t + 24 * u + os.hd / 2)
    //  The same two places in both layouts (the left layout's): the volume low and the notification high, out of the right edge of the screen. Along the top there
    //  is no frame there, so they come out of the edge of the screen itself. Content hangs from `os.ck`, centred on `os.px`.
    let os.stop = bar.y - bar.h / 2                           // the bar's top edge (the desk's island placement hangs from it)
    let os.px = screen.width - th.r - 176.5 * u
    let os.ck = os.cy - (8 + osd_h / 2) * u
    let do.lf = min(1, do0 * 1.6) + max(0, do0 - 1) * 0.6
    let do.rt = th.r + (26 + 353 * nk) * u
    let do.gw = max(0.1, do.rt * do.lf)
    let do.gh = (os.hd + max(0, sag)) * do.lf
    let do.gx = screen.width + 26 * u * do.lf - do.gw / 2
    let do.ew = do.gw
    let do.eh = do.gh
    let do.ex = do.gx
    let do.ey = os.cy
    let do.iw = max(0.1, 352 * u * nk * do.lf)                       // along the top the panel is wholly on screen (the right frame's 8 in from the edge), so its corners are all rounded
    let do.ix = screen.width - th.r - do.iw / 2
    let do.bl = (26 + 20 * do.bell) * u * min(1, do0 * 4)         // how much the drawer melts into what it joins
    let do.stretch = clamp(vel(do) * 0.07, 0, 0.5)
    let dm.gl = mix(min(dtrav, dm0), dm0, att)
    let dm.lf = min(1, dm.gl * 1.6) + max(0, dm.gl - 1) * 0.6
    let dm.rt = mix(2 * (164 + 6.5) * cu, (lf.w - lf.x) + 341 * cu, att)
    let dm.gw = max(0.1, dm.rt * dm.lf)
    let dm.gh = (((if(dm_mode == dmm_tray, tm_bot + 16, panel_bot + dm_foot)) * cu) + lp.dd + max(0, sag)) * dm.lf
    let dm.gx = mix(lp.xl + dm.gw / 2, ccx, edg)
    let dm.tR = bar.h / 2 + (if(dm_mode == dmm_tray, tm_bot + 16, panel_bot + dm_foot)) * cu + 13 * cu * tm + max(0, sag)
    let dm.teh = dm.tR * dm.lf
    let dm.tey = bar.y + dm.teh / 2
    let dm.tew = 328 * cu * dm.lf
    let dm.tex = pcx
    let dm.ew = mix(mix(dm.w, dm.gw, lm), dm.tew, tu)
    let dm.eh = mix(mix(dm.hh, dm.gh, lm), dm.teh, tu)
    let dm.ex = mix(mix(pcx, dm.gx, lm), dm.tex, tu)
    //  The middle piece of the top frame in pieces, once a drawer hangs from it: it is at least as wide as the drawer, so that the two are one shape with the same flare on both sides
    //  (otherwise the piece's own slope is on one side of the drawer and the drawer's wall on the other).
    let sg.cen = if(lp_k == 4 or lp_k == 5 or lp_k == 6, 1, 0)      // the calendar, the tray and the player hang from the middle piece; the controls from the right one
    let sg.x0 = min(min(if(dk0 > 0.004, dk.ex - dk.ew / 2, 99999), if(dc0 > 0.004, dc.ex - dc.ew / 2, 99999)), if(dm0 > 0.004, dm.ex - dm.ew / 2, 99999))
    let sg.x1 = max(max(if(dk0 > 0.004, dk.ex + dk.ew / 2, -99999), if(dc0 > 0.004, dc.ex + dc.ew / 2, -99999)), if(dm0 > 0.004, dm.ex + dm.ew / 2, -99999))
    //  The middle piece once a panel hangs from it: as wide as the panel (wider, or narrower: the piece has room for slopes that the panel's walls do not need), but never
    //  narrower than what it holds, so that there is no ledge where the two meet. It changes over as the panel nears the piece's width.
    let sg.pw = sg.c1 - sg.c0
    let sg.dt = clamp(((if(sg.x0 > 90000, 0, sg.x1 - sg.x0)) - 0.6 * sg.pw) / (0.25 * sg.pw), 0, 1) * sg.cen
    let sg.q0 = sg.c0                                              // the notch stays as wide as it is on its own: a wider panel carries the wings itself, with its full blend, as the desk does against the frame
    let sg.q1 = sg.c1
    let sg.rq = sg.rl                                               // and the right piece stays as wide as it is on its own: the controls carry their wing themselves
    let sg.wd = clamp(((sg.q1 - sg.q0) - (sg.c1 - sg.c0)) / (30 * u), 0, 1)     // how far a panel has outgrown the middle piece, and the controls the right one: the melt into the thin frame
    let sg.wr = clamp((sg.rl - sg.rq) / (30 * u), 0, 1)                         // is then only a small fillet (a panel's top corners are not a trumpet)
    let dm.ey = mix(mix(bar.y + dm.hh / 2, lp.cy, lm), dm.tey, tu)
    //  The desk's drawer: the volume's out of the right frame, with its own size (see `do.*`).
    //  The desk: out of the right frame, in the middle of it (the Frame layout); or, in the Island layout, hanging from the top right corner of the
    //  screen, its first row level with the bar's, from the icon that opens it. `dsk_*` is where its contents are laid out, once out.
    let dsk_ri = mix(14 * du, th.r, fm)                        // the gap between the panel and the screen's right edge
    //  It can be pulled off its place by the grip along its top (`desk_ox`, `desk_oy`: how far it is from where it sits attached) and put back
    //  by dragging it near that place again. `dsk_h*` is that place, `dsk_x0`, `dsk_y0` where it is: everything in it is laid out from them.
    let dsk_hx0 = screen.width - dsk_ri - dsk_w                // its inner left edge, attached
    let dsk_hy0 = vcc - dsk_h / 2                              // vertically centred on the right edge, in both layouts
    //  `dox`, `doy`: the carry in the drawing's own directions. On the right and the bottom the glass is a mirror image, so a carry to the right is a
    //  carry to the left there; `desk_ox`, `desk_oy` (and `desk_gx`, `desk_gy`) stay as the pointer moves.
    let dox = desk_ox * (1 - 2 * rt)
    let doy = desk_oy * (1 - 2 * bt)
    let dsk_x0 = dsk_hx0 + dox
    let dsk_xc = dsk_x0 + dsk_w / 2
    let dsk_y0 = dsk_hy0 + doy
    //  Where the contents of the panels are drawn is slid across on a mirrored strip (see `rt`, `bt`): a rule that reads the pointer takes that slide off
    //  to get the point it means in the panel's own coordinates. `tx.pnl`, `ty.set`, `ty.att` are the panels'; `tx.dsk`, `ty.dsk` the desk's, which
    //  is also scaled about the corner `dsk_pvx`, `dsk_pvy`.
    let tx.pnl = rt * (screen.width - 2 * pcx)
    let ty.set = bt * (yo + vb - 2 * lp.cy)
    let ty.att = bt * (yo + vb - 2 * (th.t + lp.hd / 2))
    let tx.dsk = rt * (screen.width - 2 * dsk_xc)
    let ty.dsk = bt * (yo + vb - 2 * (dsk_y0 + dsk_h / 2))
    let dsk_pvx = dsk_x0 + rt * dsk_w
    let dsk_pvy = dsk_y0 + bt * dsk_h
    //  How far it can be carried: against the frame's inner edge on every side (8 from the screen's edge along the top), and no further right than home.
    let desk_xlo = th.l * fm + 8 * du * (1 - fm)
    let desk_ylo = yo + th.t * fm + 8 * du * (1 - fm)
    let desk_yhi = vb - th.b * fm - 8 * du * (1 - fm)
    let desk_xhi = screen.width - dsk_ri
    let desk_xmin = -(dsk_hx0 - desk_xlo)
    let desk_ymin = -(dsk_hy0 - desk_ylo)
    let desk_ymax = desk_yhi - dsk_hy0 - dsk_h * desk_s
    let desk_smax = max(0.5, min(1, min((desk_yhi - dsk_y0) / dsk_h, (desk_xhi - dsk_x0) / dsk_w)))     // how big it can be made where it is
    let dz.lf = min(1, dz0 * 1.6) + max(0, dz0 - 1) * 0.6
    let dz.rt = dsk_ri + dsk_w + 32.5 * du
    //  Pulled off the frame, the glass stays joined to it by a neck that stretches (the blend of its shape in the frame's glass) while its far side
    //  lets go of the frame: `dz.det` is 0 until it has been pulled a little way and 1 once it is a panel of its own, 6.5 wider than its contents all round.
    let dz.det = clamp((abs(dox + (desk_s - 1) * dsk_w) - 14 * du) / (50 * du), 0, 1) * fm
    let dz.gl = screen.width + 26 * du * dz.lf - max(0.1, dz.rt * dz.lf) + dox
    let dz.gr = mix(screen.width + 26 * du * dz.lf, dz.gl + (dsk_w + 13 * du) * dz.lf, dz.det)
    let dz.gw = max(0.1, dz.gr - dz.gl)
    let dz.gh = dsk_h * dz.lf
    let dz.ex = (dz.gl + dz.gr) / 2
    //  The frame's edge while it is pulled (`dz.sag`, most halfway), the two ripples (`dz.ripx`, `dz.riph`) and the small drop (`dz.stray`). They are
    //  never zero-size, and off the screen when nothing is happening (`show:` does not take a shape off the glass).
    let dz.sag = max((24 * 4 * dz.det * (1 - dz.det) * (1 - 0.5 * dz.det) + dbounce) * u * fm, 0.3)
    let dz.ripx = (12 + 90 * dprip) * u
    let dz.riph = 20 * u * (1 - dprip) * clamp(dprip * 6, 0, 1) * fm * (1 - uwu_k)
    let dz.stray = 10 * u * dpstray * fm
    let dz.act = if(cas_k < 0.5 and fm > 0.5 and desk_open and (abs(dox + (desk_s - 1) * dsk_w) > 4 * du or dprip < 0.98 or dpstray > 0.01 or abs(dbounce) > 0.2), 1, 0)
    let dz.px = if(dz.act > 0.5, 0, 30000)
    //  The ripples alone also run after the desk has closed (`dz.act` needs it open): they are the closing ripple, as the title's panel has (`tprip`).
    let dz.rpx = if(cas_k < 0.5 and fm > 0.5 and dprip < 0.98, 0, 30000)
    let dz.fy = mix(vcc + doy, desk_ry, dz.det)       // along the frame: where the neck is, then where it broke
    let dz.ey = vcc + doy
    //  What the glass is when the desk is scaled (about its top left corner, which `dsk_x0`, `dsk_y0` is): the contents are scaled by a group and take
    //  the unscaled shapes above for their clip, so the glass has its own. (`dz.s*` in the frame, `dz.i*` along the top.)
    //  Its right side is the exception: attached, it reaches into the frame, and that reach is not scaled with the rest (it would fall short of the contents).
    let dz.sgl = dsk_x0 + (dz.gl - dsk_x0) * desk_s
    let dz.sgr = mix(screen.width + 26 * du * dz.lf, dsk_x0 + (dz.gl + (dsk_w + 13 * du) * dz.lf - dsk_x0) * desk_s, dz.det)
    let dz.sex = (dz.sgl + dz.sgr) / 2
    let dz.sew = max(0.1, dz.sgr - dz.sgl)
    //  The contents are clipped inside the scaled group, so their clip is that glass at unscaled size.
    let dz.cgr = dsk_x0 + (dz.sgr - dsk_x0) / desk_s
    let dz.cx = (dz.gl + dz.cgr) / 2
    let dz.cw = max(0.1, dz.cgr - dz.gl)
    let dz.sey = dsk_y0 + (dz.ey - dsk_y0) * desk_s
    let dz.seh = dz.gh * desk_s
    //  Touching the frame anywhere melts into it the way the right edge does: each side that is near the frame's inner edge (`dz.d*` 0 against it, 1 once
    //  it is 64 away) reaches into the frame instead of ending, and the blend makes the wings. The right side is `dz.det` (above).
    let dz.dl = clamp((dsk_x0 - desk_xlo - 14 * du) / (50 * du), 0, 1)
    let dz.dt = clamp((dsk_y0 - desk_ylo - 14 * du) / (50 * du), 0, 1)
    let dz.db = clamp((desk_yhi - dsk_y0 - dsk_h * desk_s - 14 * du) / (50 * du), 0, 1)
    let dz.fl = mix(-26 * du, dz.sex - dz.sew / 2, dz.dl)
    let dz.fr = dz.sex + dz.sew / 2
    let dz.ft = mix(yo - 26 * du, dz.sey - dz.seh / 2, dz.dt)
    let dz.fb = mix(vb + 26 * du, dz.sey + dz.seh / 2, dz.db)
    let dz.fx = (dz.fl + dz.fr) / 2
    let dz.fw = max(0.1, dz.fr - dz.fl)
    let dz.fcy = (dz.ft + dz.fb) / 2
    let dz.fh = max(0.1, dz.fb - dz.ft)
    let dz.free = max(max(dz.det, 1 - fm), clamp((1 - desk_s) * 20, 0, 1))         // off the frame, along the top (no frame to be joined to), or smaller than it was: the corner handles are there
    //  Along the top it is wholly on screen and centred, as in the left layout: its right edge 7.5 in from the screen's, all four corners show.
    let dz.iw = (dsk_w + 13 * du) * dz.lf
    let dz.ih = dsk_h * dz.lf
    let dz.ix = screen.width - 7.5 * du - dz.iw / 2 + dox
    let dz.iy = vcc + doy
    let dz.six = dsk_x0 + (dz.ix - dsk_x0) * desk_s
    let dz.siw = dz.iw * desk_s
    let dz.siy = dsk_y0 + (dz.iy - dsk_y0) * desk_s
    let dz.sih = dz.ih * desk_s
    let dz.stretch = clamp(vel(dz) * 0.07, 0, 0.5) * (1 - cas_k)
    //  The notches (Frame layout only). Touch the middle of the top frame and a small tab grows out of it, with the three dots the volume
    //  card has under its plate; touch the bottom frame's middle and one grows up out of it. Pressing the tab opens the panel that
    //  comes out of that edge (the launcher from the top, Settings from the bottom), and pressing it again closes it. Hovering only
    //  brings the tab out. They sit in the middle of what can be seen (`ccx`), where those panels come out, whatever the resolution.
    //  The zones are declared here, before the bar and the panels, so theirs still win.
    let nt_w = 52 * cu                                     // the tab's width
    let nt_d = 15 * cu                                     // how far it hangs out of the frame
    zone box ntz_t { at: mix(ccx, screen.width - ccx, rt), yo + (lf.t + 6 * cu) / 2; size: nt_w + 24 * cu, lf.t + 6 * cu; active: sb > 0.5 and lm > 0.5 }
    zone box ntz_b { at: mix(ccx, screen.width - ccx, rt), mix(vb - (th.b + 6 * cu) / 2, yo + (th.b + 6 * cu) / 2, bt); size: nt_w + 24 * cu, th.b + 6 * cu; active: sb > 0.5 and fm > 0.5 }
    zone box ntn_t { at: mix(ccx, screen.width - ccx, rt), yo + (lf.t + nt_d) / 2; size: nt_w, lf.t + nt_d; cursor: pointer; active: lm > 0.5 and nt_vis_t.$screen > 0.5 }
    zone box ntn_b { at: mix(ccx, screen.width - ccx, rt), mix(vb - (th.b + nt_d) / 2, yo + (th.b + nt_d) / 2, bt); size: nt_w, th.b + nt_d; cursor: pointer; active: fm > 0.5 and nt_vis_b.$screen > 0.5 }
    zone box ntz_l { at: (th.l + 6 * cu) / 2, mix(vcc, yo + vb - vcc, bt); size: th.l + 6 * cu, nt_w + 24 * cu; active: sb > 0.5 and tm > 0.5 }
    zone box ntn_l { at: (th.l + nt_d) / 2, mix(vcc, yo + vb - vcc, bt); size: th.l + nt_d, nt_w; cursor: pointer; active: tm > 0.5 and nt_vis_l.$screen > 0.5 }
    zone box ax_body { at: mix(dax.ex, screen.width - dax.ex, rt), mix(dax.ey, yo + vb - dax.ey, bt); size: dax.ew, dax.eh; active: ax_open and axo > 0.5 }
    zone box ntp_t { at: mix(dl.ex, screen.width - dl.ex, rt), mix(dl.ey, yo + vb - dl.ey, bt); size: dl.ew + 8, dl.eh + 8; active: fm > 0.5 and panel == launch }
    zone box ntp_b { at: mix(ds.ex, screen.width - ds.ex, rt), mix(ds.ey, yo + vb - ds.ey, bt); size: ds.ew + 8, ds.eh + 8; active: fm > 0.5 and panel == settings }
    prop nt_vis_t.0 = 0 ~calm                                // how far the tab is out
    prop nt_vis_t.1 = 0 ~calm
    prop nt_vis_t.2 = 0 ~calm
    prop nt_vis_t.3 = 0 ~calm
    prop nt_vis_b.0 = 0 ~calm
    prop nt_vis_b.1 = 0 ~calm
    prop nt_vis_b.2 = 0 ~calm
    prop nt_vis_b.3 = 0 ~calm
    prop nt_hold_l.0 = 0 ~280ms
    prop nt_hold_l.1 = 0 ~280ms
    prop nt_hold_l.2 = 0 ~280ms
    prop nt_hold_l.3 = 0 ~280ms
    prop nt_hold_t.0 = 0 ~280ms                              // on the edge, the tab or the panel: until the tab goes back and the panel closes
    prop nt_hold_t.1 = 0 ~280ms
    prop nt_hold_t.2 = 0 ~280ms
    prop nt_hold_t.3 = 0 ~280ms
    prop nt_hold_b.0 = 0 ~280ms
    prop nt_hold_b.1 = 0 ~280ms
    prop nt_hold_b.2 = 0 ~280ms
    prop nt_hold_b.3 = 0 ~280ms
    follow nt_hold_t.$screen = if(max(ntz_t.hover, max(ntn_t.hover, ntp_t.hover)) > 0.5, 1, 0)
    follow nt_hold_l.$screen = if(max(ntz_l.hover, max(ntn_l.hover, if(bt > 0.5, ntp_b.hover, ntp_t.hover))) > 0.5, 1, 0)
    follow nt_vis_l.$screen = if(nt_hold_l.$screen > 0.3, 1, 0)
    follow nt_hold_b.$screen = if(max(ntz_b.hover, max(ntn_b.hover, if(bt > 0.5, ntp_t.hover, ntp_b.hover))) > 0.5, 1, 0)
    follow nt_vis_t.$screen = if(nt_hold_t.$screen > 0.3, 1, 0)
    follow nt_vis_b.$screen = if(nt_hold_b.$screen > 0.3, 1, 0)
    //  The corner dock: the pinned apps in one row, in one of the two corners of the edge opposite the bar (the bottom for the Island and the top strip, the
    //  right edge for the left strip; the right and the bottom are the same drawing mirrored, like everything else). Along the bottom the corners are the left
    //  and the right; down the right edge they are the top and the bottom, and the row still lies along the screen's horizontal edge. It is a pill of the frame's glass
    //  that melts into the frame: `cdk.r` is how far it reaches into it (or off the screen, with no frame), so the two are one piece. Everything here is in the glass's
    //  own (unmirrored) drawing; the icons are drawn where the mirror image falls. `cdk_cx.$screen`, `cdk_cy.$screen` is where its middle is: carried to the pointer while it is
    //  pulled, to its corner otherwise.
    let cdk.g = cdk_ga * sb                                        // how far out it is on this monitor: only where the bar is (`sb`)
    let cdk.s = 24 * bu
    let cdk.p = cdk.s + 6 * bu
    let cdk.t = cdk.s + 10 * bu
    let cdk.r = 12 * bu
    let cdk.L = cdk_pins.count * cdk.p + 8 * bu
    let cdk.ye = vb - th.b * fm
    let cdk.yt = yo + th.t * fm
    let cdk.xe = screen.width - th.r * fm
    let cdk.xs = th.l * fm
    let adk.g = adk_ga * sb
    //  The corner nearer the pill's middle (not the pointer: it may have taken hold of the pill by one end), when it is let go (in the glass's drawing: down the right edge the two are the top and the bottom, otherwise the left and the right).
    let cdk.pick = if(lm > 0.5, if(mix(cdk_py, yo + vb - cdk_py, bt) > vc, 1, 0), if(mix(cdk_px, screen.width - cdk_px, rt) > screen.width / 2, 1, 0))
    let adk.pick = if(lm > 0.5, if(mix(adk_py, yo + vb - adk_py, bt) > vc, 1, 0), if(mix(adk_px, screen.width - adk_px, rt) > screen.width / 2, 1, 0))
    //  Where each rests: the other is in the opposite corner, and it goes there as soon as the one pulled is nearer the far one (the swap).
    let cdk.cor = if(adk_drag > 0.5, 1 - adk.pick, cdk_corner)
    let adk.cor = if(cdk_drag > 0.5, 1 - cdk.pick, 1 - cdk_corner)
    let cdk.sr = if(lm > 0.5, 1, cdk.cor)                       // against the right edge (1) or the left (0)
    let cdk.sb = if(lm > 0.5, cdk.cor, 1)                       // against the bottom (1) or the top (0)
    let cdk.restx = mix(cdk.xs + cdk.L / 2, cdk.xe - cdk.L / 2, cdk.sr)
    let cdk.resty = mix(cdk.yt + cdk.t / 2, cdk.ye - cdk.t / 2, cdk.sb)
    let cdk.rcx = mix(pick(screen.index, cdk_cx.0, cdk_cx.1), screen.width - pick(screen.index, cdk_cx.0, cdk_cx.1), rt)           // where its middle is on the screen
    let cdk.rcy = mix(pick(screen.index, cdk_cy.0, cdk_cy.1), yo + vb - pick(screen.index, cdk_cy.0, cdk_cy.1), bt)
    follow cdk_cx.$screen = if(cdk_drag > 0.5, mix(cdk_px, screen.width - cdk_px, rt), cdk.restx)
    follow cdk_cy.$screen = if(cdk_drag > 0.5, mix(cdk_py, yo + vb - cdk_py, bt), cdk.resty)
    follow cdk_ax.$screen = if(cdk_drag > 0.5, 0, cdk.sr * 2 - 1)
    follow cdk_ay.$screen = if(cdk_drag > 0.5, 0, cdk.sb * 2 - 1)
    let cdk.bx = pick(screen.index, cdk_cx.0, cdk_cx.1) + pick(screen.index, cdk_ax.0, cdk_ax.1) * cdk.r / 2
    let cdk.by = pick(screen.index, cdk_cy.0, cdk_cy.1) + pick(screen.index, cdk_ay.0, cdk_ay.1) * cdk.r / 2
    let cdk.bw = cdk.L * cdk.g + cdk.r * abs(pick(screen.index, cdk_ax.0, cdk_ax.1))
    let cdk.bh = cdk.t + cdk.r * abs(pick(screen.index, cdk_ay.0, cdk_ay.1))
    let cdk.cr = min(cdk.t / 2, rc)
    let adk.L = adk_pins.count * cdk.p + 8 * bu
    let adk.sr = if(lm > 0.5, 1, adk.cor)
    let adk.sb = if(lm > 0.5, adk.cor, 1)
    let adk.restx = mix(cdk.xs + adk.L / 2, cdk.xe - adk.L / 2, adk.sr)
    let adk.resty = mix(cdk.yt + cdk.t / 2, cdk.ye - cdk.t / 2, adk.sb)
    let adk.rcx = mix(pick(screen.index, adk_cx.0, adk_cx.1), screen.width - pick(screen.index, adk_cx.0, adk_cx.1), rt)
    let adk.rcy = mix(pick(screen.index, adk_cy.0, adk_cy.1), yo + vb - pick(screen.index, adk_cy.0, adk_cy.1), bt)
    follow adk_cx.$screen = if(adk_drag > 0.5, mix(adk_px, screen.width - adk_px, rt), adk.restx)
    follow adk_cy.$screen = if(adk_drag > 0.5, mix(adk_py, yo + vb - adk_py, bt), adk.resty)
    follow adk_ax.$screen = if(adk_drag > 0.5, 0, adk.sr * 2 - 1)
    follow adk_ay.$screen = if(adk_drag > 0.5, 0, adk.sb * 2 - 1)
    let adk.bx = pick(screen.index, adk_cx.0, adk_cx.1) + pick(screen.index, adk_ax.0, adk_ax.1) * cdk.r / 2
    let adk.by = pick(screen.index, adk_cy.0, adk_cy.1) + pick(screen.index, adk_ay.0, adk_ay.1) * cdk.r / 2
    let adk.bw = adk.L * adk.g + cdk.r * abs(pick(screen.index, adk_ax.0, adk_ax.1))
    let adk.bh = cdk.t + cdk.r * abs(pick(screen.index, adk_ay.0, adk_ay.1))
    //  The add-on drawer (`ax_open`): out of the add-on pill, standing in its corner, as wide and tall as the add-on asked, against the frame and on the pill. It grows from the pill as it opens.
    let axs.x0 = cdk.xs                                    // flush with the frame, as the Desk is: it is part of it until it is pulled away
    let axs.x1 = cdk.xe
    let axs.w = clamp(if(ax_w > 0, ax_w, 300 * cu), 240, max(240, axs.x1 - axs.x0))
    let axs.y0 = cdk.yt                                    // against the frame's bottom edge, as the Desk's top is (not under the pieces that hang from it)
    let axs.y1 = mix(vb - th.b, cdk.ye, adk.sb)
    let axs.h = clamp(if(ax_h > 0, ax_h, 280 * cu), 160, max(160, axs.y1 - axs.y0))
    let axs.fx = mix(axs.x0 + axs.w / 2, axs.x1 - axs.w / 2, adk.sr)
    let axs.fy = mix(axs.y0 + axs.h / 2, axs.y1 - axs.h / 2, adk.sb)
    let dax.lf = min(1, dax0 * 1.6) + max(0, dax0 - 1) * 0.6
    let dax.ew = max(0.1, axs.w * dax.lf)
    let dax.eh = max(0.1, axs.h * dax.lf)
    let dax.ex = mix(adk.restx, axs.fx, dax.lf) + ax_ox * dax.lf
    let dax.ey = mix(adk.resty, axs.fy, dax.lf) + ax_oy * dax.lf
    //  Like the control centre and the Desk, it is one piece with a frame it stands against: wherever one of its edges is within a hand of the frame's, the glass runs on into the
    //  frame (`dax.bl`, `dax.br`, `dax.bt`, `dax.bb`) so the two melt and the join is a fillet. It lets go of the frame as it is pulled away, and takes hold of another it comes to.
    let axs.top = cdk.yt                                    // the top of the room: the frame, as for the Desk
    //  As the Desk's: a side within 64 of the frame's inner edge (`dax.n*` 1 against it, 0 once it is 64 away) reaches on into the frame, up to 26 past the screen's edge, instead of
    //  ending, and the blend makes the wings. The reach (`dax.b*`) is how far that side moves out.
    let dax.nl = clamp(1 - (dax.ex - dax.ew / 2 - cdk.xs - 14 * cu) / (50 * cu), 0, 1)
    let dax.nr = clamp(1 - (cdk.xe - dax.ex - dax.ew / 2 - 14 * cu) / (50 * cu), 0, 1)
    let dax.nt = clamp(1 - (dax.ey - dax.eh / 2 - axs.top - 14 * cu) / (50 * cu), 0, 1)
    let dax.nb = clamp(1 - (cdk.ye - dax.ey - dax.eh / 2 - 14 * cu) / (50 * cu), 0, 1)
    let dax.k = min(1, dax0 * 3)
    let dax.bl = dax.k * dax.nl * max(0, dax.ex - dax.ew / 2 + 26 * cu)
    let dax.br = dax.k * dax.nr * max(0, screen.width - dax.ex - dax.ew / 2 + 26 * cu)
    let dax.bt = dax.k * dax.nt * max(0, dax.ey - dax.eh / 2 - yo + 26 * cu)
    let dax.bb = dax.k * dax.nb * max(0, vb - dax.ey - dax.eh / 2 + 26 * cu)
    let axs.hh = 66 * cu                                   // the shell's title bar across the top of the panel (title, grip, X): the content is below it
    let axs.rt = axs.hh + cdk.t * (1 - adk.sb)             // what the content leaves free: the title bar, and the pill's strip when the pill is at the top
    let axs.rb = cdk.t * adk.sb                            // ... and the pill's strip along the bottom (the pill is in the panel's corner, its icons showing)
    //  How far it may be pulled (offsets from its place, in the glass's drawing): anywhere inside the frame, right up against it, as the Desk can be.
    let axs.xmin = cdk.xs - (axs.fx - axs.w / 2)
    let axs.xmax = cdk.xe - (axs.fx + axs.w / 2)
    let axs.ymin = axs.top - (axs.fy - axs.h / 2)
    let axs.ymax = cdk.ye - (axs.fy + axs.h / 2)
    //  Where the add-on's content goes, as it settles, on the screen (the glass is drawn unmirrored; the screen is not): kept for the logic, which tells the add-on.
    //  Worked out on the copy the panel is on only (`axo`): a rule runs on every copy, and with two monitors the last copy's own width won, so the content was
    //  told a place on the other monitor's terms (beside the panel, or off it).
    on change ax_open while axo > 0.5 { ax_rx = mix(axs.fx + ax_gx, screen.width - (axs.fx + ax_gx), rt); ax_ry = mix(axs.fy + ax_gy, yo + vb - (axs.fy + ax_gy), bt) + (axs.rt - axs.rb) / 2; ax_rw = axs.w; ax_rh = axs.h - axs.rt - axs.rb }
    on change ax_cur while axo > 0.5 { ax_rx = mix(axs.fx + ax_gx, screen.width - (axs.fx + ax_gx), rt); ax_ry = mix(axs.fy + ax_gy, yo + vb - (axs.fy + ax_gy), bt) + (axs.rt - axs.rb) / 2; ax_rw = axs.w; ax_rh = axs.h - axs.rt - axs.rb }
    on change ax_hold while axo > 0.5 { ax_rx = mix(axs.fx + ax_gx, screen.width - (axs.fx + ax_gx), rt); ax_ry = mix(axs.fy + ax_gy, yo + vb - (axs.fy + ax_gy), bt) + (axs.rt - axs.rb) / 2; ax_rw = axs.w; ax_rh = axs.h - axs.rt - axs.rb }
    on change ax_rsz while axo > 0.5 { ax_rx = mix(axs.fx + ax_gx, screen.width - (axs.fx + ax_gx), rt); ax_ry = mix(axs.fy + ax_gy, yo + vb - (axs.fy + ax_gy), bt) + (axs.rt - axs.rb) / 2; ax_rw = axs.w; ax_rh = axs.h - axs.rt - axs.rb }
    //  The right notch opens the desk: a panel out of the right frame with a few small tools, in tabs. It is not one of the values of `panel`, so it
    //  stays open while the calendar, the controls, the volume or a notification come and go. It is drawn like the volume's and the title panel's
    //  drawers (`dz.*`: the same springs and shape) but with its own geometry, which does not depend on whichever of those is out.
    fact desk_open = false
    event desk_toggle ->                                   // from a key bind (SUPER + D)
    //  desk_toggle: in the logic (logic/panel_monitor.luau), which opens the desk on the focused monitor.
    fact desk_tab = 3                                      // 0 Pad, 1 Shelf, 2 Clip, 3 Focus, 4 Term, 5 Ask
    prop desk_sel = 3 ~slide                               // which tab the thumb is on
    //  Carrying the desk: `desk_gx`, `desk_gy` is where it is being taken to (an offset from its place in the frame), `desk_ox`, `desk_oy` where it
    //  is, on a loose spring, so it trails the pointer like a drop and lands past its place when it is let go near it and snaps back.
    fact desk_gx = 0
    fact desk_gy = 0
    fact desk_bx = 0                                       // where it was when the grip was pressed
    fact desk_by = 0
    fact desk_hold = false                                 // the grip is held: its zone stays where it was pressed, it would lose the drag if it moved with the panel
    fact desk_hx = 0
    fact desk_hy = 0
    //  Detached, it can also be made smaller by the handle in its bottom corner (`desk_s`, 0.5 to 1; everything in it scales about its top left corner,
    //  `desk_gs` is where the scale is going). Put back in its place it is full size again.
    fact desk_gs = 1
    fact desk_bs = 1                                       // the scale when the handle was pressed
    fact desk_rk = -1                                      // which corner's handle is held (0 top left, 1 top right, 2 bottom left, 3 bottom right)
    fact desk_fcx = 0                                      // the corner across from it, which stays where it is
    fact desk_fcy = 0
    fact desk_rhold = false                                // the handle is held: its zone stays where the pointer is, as the grip's does
    fact desk_qx = 0
    fact desk_qy = 0
    spring desk_sp = 300, 20
    prop desk_s = 1 ~desk_sp
    follow desk_s = desk_gs
    prop desk_ox = 0 ~desk_sp
    prop desk_oy = 0 ~desk_sp
    follow desk_ox = desk_gx
    follow desk_oy = desk_gy
    on change desk_open while not desk_open { desk_gx = 0; desk_gy = 0; desk_gs = 1; desk_hold = false; desk_rhold = false; desk_rk = -1 }
    //  The frame's side of the liquid, as the drip down the left has it (`dj.*`): while the desk is pulled the frame's edge bulges towards it; when
    //  the neck breaks the edge jumps and bounces, two ripples run along it and a small drop is left hanging; put back, the edge closes over it.
    prop dbounce = 0 ~splash
    prop dprip = 1 ~1100ms
    prop dpstray = 0 ~700ms
    fact desk_ry = 0                                       // where along the frame the neck broke
    on change dz.det > 0.7 while dz.det > 0.7 { desk_ry = vcc + doy; impulse dbounce -280; impulse wobble -300; dprip: 0 ~16ms; dprip: 1 ~1100ms after 30ms; dpstray: 1 ~16ms; dpstray: 0 ~700ms after 60ms }
    on change dz.det < 0.7 while dz.det < 0.7 and desk_open { desk_ry = vcc + doy; impulse dbounce 80; impulse wobble 200 }
    on change dz.det < 0.05 while dz.det < 0.05 and desk_open { desk_ry = vcc + doy; impulse dbounce -200; impulse wobble -120; dprip: 0 ~16ms; dprip: 1 ~600ms after 30ms }
    on change dz0 < 0.06 while dz0 < 0.06 and not desk_open and fm > 0.5 { dprip: 0 ~16ms; dprip: 1 ~600ms after 30ms }
    follow desk_sel = desk_tab
    zone box ntz_r { at: mix(screen.width - (th.r + 6 * cu) / 2, (th.r + 6 * cu) / 2, rt), mix(vcc, yo + vb - vcc, bt); size: th.r + 6 * cu, nt_w + 24 * cu; active: sb > 0.5 and fm > 0.5 and not desk_open }
    zone box ntn_r { at: mix(screen.width - (th.r + nt_d) / 2, (th.r + nt_d) / 2, rt), mix(vcc, yo + vb - vcc, bt); size: th.r + nt_d, nt_w; cursor: pointer; active: fm > 0.5 and nt_vis_r.$screen > 0.5 and not desk_open }
    prop nt_vis_r.0 = 0 ~calm
    prop nt_vis_r.1 = 0 ~calm
    prop nt_vis_r.2 = 0 ~calm
    prop nt_vis_r.3 = 0 ~calm
    prop nt_vis_l.0 = 0 ~calm                                // the left notch (with the strip along the top: it opens the launcher)
    prop nt_vis_l.1 = 0 ~calm
    prop nt_vis_l.2 = 0 ~calm
    prop nt_vis_l.3 = 0 ~calm
    prop nt_hold_r.0 = 0 ~280ms
    prop nt_hold_r.1 = 0 ~280ms
    prop nt_hold_r.2 = 0 ~280ms
    prop nt_hold_r.3 = 0 ~280ms
    follow nt_hold_r.$screen = if(max(ntz_r.hover, ntn_r.hover) > 0.5, 1, 0)
    follow nt_vis_r.$screen = if(nt_hold_r.$screen > 0.3 and not desk_open, 1, 0)
    on press ntn_r { panel_scr = screen.index; desk_open = true }
    //  The focus timer (see the Focus section of vitreus.luau).
    event ft_toggle ->                                      // start, pause or resume; carries the minutes
    event ft_reset ->
    event ft_set ->                                         // a preset was chosen while idle
    fact ft_len = 30
    fact ft_state = 0                                       // 0 ready, 1 running, 2 paused, 3 done
    fact ft_prog = 1.0                                      // the fraction left
    fact desk_kb = false                                    // typing in the desk (the task field, the terminal): only then does it take the keyboard
    on change desk_tab { desk_kb = false; term_armed = false }
    on change desk_open while not desk_open { desk_kb = false; term_armed = false }
    //  Settings and the launcher are wide (316.5 * pu each side of the middle), so on a smaller screen they reach the desk's side and the two glasses
    //  melt into each other. Whichever of the two was opened last stays; the other one goes.
    let desk_clash = if(fm > 0.5 and ccx + 316.5 * pu > dsk_hx0 - 8 * du, 1, 0)
    on change desk_open while desk_open and desk_clash > 0.5 and (panel == settings or panel == launch) { panel = none }
    on change panel while (panel == settings or panel == launch) and desk_open and desk_clash > 0.5 { desk_open = false }
    //  The terminal follows the mouse, as Hyprland's windows do here: once it has been clicked, the pointer coming back over the desk
    //  gives it the keyboard again, and leaving lets it go (`desk_band`), until the desk shuts or another tab is chosen.
    fact term_armed = false
    //  The terminal (Term tab; see the Terminal section of vitreus.luau). bin/vitreus-term runs the shell and keeps its screen; the logic
    //  hands each stretch of one colour to `term_runs` (row, column, text, colours) and the cursor to `term_c*`. It is 64 by 35 cells of
    //  Space Mono (the monospaced sibling of Space Grotesk, as the Nerd Font build so prompts keep their icons) at 11.75 px, 7.19 by 16
    //  px each, which is what fits the desk's card; the logic starts the shell at that size.
    model term_runs max 256 { t: text; x: number; y: number; n: number; fg: bool; r: number; g: number; b: number; hasbg: bool; br: number; bg: number; bb: number; bold: bool }
    fact term_cx = 0
    fact term_cy = 0
    fact term_cur = false                                   // the cursor is to be drawn (a program can hide it; scrolled back it is not where you type)
    fact term_scrolled = 0                                  // how many lines back in the history the view is
    fact term_state = 0                                     // 0 not started, 1 running, 2 the shell has ended, 3 it cannot run (`term_msg` says why)
    text term_msg = ""
    event term_scroll ->                                    // the wheel over the terminal: carries `wheel`
    //  Keys typed in the terminal reach the logic only if no input has the writing cursor, and gaining the keyboard gives it to the
    //  first input there is (the task field, even hidden). So when it is the terminal that takes the keyboard, the cursor is taken
    //  away again; only then: the desk stays on Term while the search or another panel opens, and theirs must keep it.
    on focus while desk_open and desk_tab == 4 and desk_kb and panel == none { blur }
    fact ft_dnd = true                                      // silence notifications while it runs
    fact ft_caf = true                                      // keep the machine awake while it runs
    text ft_time = "30:00"
    prop ft_ring = 1 ~gentle
    prop ft_press = 0 ~pop
    //  The desk's contents come in one after another once the drawer is out, like the title panel's (`f3`) and the controls' (`f5`..`f7`):
    //  each section fades in and rises a little, on a longer spring than the one before.
    prop fd0 = 0 ~380ms                                     // the tabs
    prop fd1 = 0 ~560ms
    prop fd2 = 0 ~680ms
    prop fd3 = 0 ~780ms
    prop fd4 = 0 ~880ms
    on change desk_open while desk_open { fd0: 1 after 200ms; fd1: 1 after 200ms; fd2: 1 after 200ms; fd3: 1 after 200ms; fd4: 1 after 200ms }
    on change desk_open while not desk_open { fd0: 0 ~80ms; fd1: 0 ~80ms; fd2: 0 ~80ms; fd3: 0 ~80ms; fd4: 0 ~80ms }
    //  The shelf: up to eight things dropped on it (files, links, text), each draggable back out to another program.
    repeat k in 0..8 {
        text shelf.$k.name = ""
        text shelf.$k.path = ""
        text shelf.$k.tag = ""
        fact shelf.$k.has = false
        fact shelf.$k.askable = false
        text shelf.$k.thumb = ""                       // a picture of what it is (an image's, or a video's first moments), once the logic has made it
        image shelf.$k.im = from shelf.$k.thumb, 104, 104
        fact shelf.$k.thumbed = false
        //  The same for the shelf's cards: one that is dismissed slides off and fades, and the ones after it glide into its place.
        fact shelf.$k.gone = false
        prop shelf.$k.out = 0 ~180ms
        prop shelf.$k.dx = 0 ~220ms
        prop shelf.$k.dy = 0 ~220ms
        on change shelf.$k.gone while shelf.$k.gone { shelf.$k.out: 1 ~180ms }
        on change shelf.$k.gone while not shelf.$k.gone { shelf.$k.out: 0 ~0ms }
        on shelf_shifted(v) while k >= v { shelf.$k.dx: (mod(k + 1, 3) - mod(k, 3)) * 110 * du ~0ms; shelf.$k.dy: (floor((k + 1) / 3) - floor(k / 3)) * 102 * du ~0ms; shelf.$k.dx: 0 ~220ms after 40ms; shelf.$k.dy: 0 ~220ms after 40ms }
    }
    fact shelf_n = 0
    //  The shelf as a locker: with the box ticked, what is on it stays hidden (the logic does not even put it in the scene) until your login password is given.
    fact shelf_lock_on = false          // the box
    fact shelf_locked = false           // shut now
    text shelf_locked_txt = ""          // "3 things inside", while it is shut
    text shelf_pw = ""                  // the field
    fact shelf_authing = false
    fact shelf_bad = false              // the last try was wrong
    text shelf_warn = ""                // after two wrong tries: the system (faillock) locks password checks after the third, for everything that asks for it
    prop shelf_lock_f = 0 ~quick
    follow shelf_lock_f = if(shelf_lock_on, 1, 0)
    event shelf_lock_toggle ->
    event shelf_unlock ->
    event shelf_lock_now ->
    event shelf_del ->
    event shelf_open ->                 // a tile clicked (pressed and let go in place): open it with the default app, or copy a text
    fact shelf_px = 0                   // where the press was, to tell a click from the start of a drag out
    fact shelf_py = 0
    event shelf_clear ->
    event shelf_ask ->
    prop desk_drag = 0 ~120ms                               // 1 while something from another program is being carried over the desk
    follow desk_drag = drag.over
    prop shelf_flash = 0 ~calm                              // the glow of a drop that has just landed
    //  The task list: nine lines with a check each.
    repeat k in 0..9 {
        text task.$k.text = ""
        fact task.$k.has = false
        fact task.$k.done = false
        prop task.$k.p = 0 ~pop
        follow task.$k.p = if(task.$k.done, 1, 0)
        //  Dismissed: the line slides off to the right and fades (the logic marks it `gone`, waits a moment, then removes it), and the
        //  lines under it glide up into the gap (`task_shifted` says from which one; each starts where its text was and settles).
        fact task.$k.gone = false
        prop task.$k.out = 0 ~180ms
        prop task.$k.dy = 0 ~220ms
        on change task.$k.gone while task.$k.gone { task.$k.out: 1 ~180ms }
        on change task.$k.gone while not task.$k.gone { task.$k.out: 0 ~0ms }
        on task_shifted(v) while k >= v { task.$k.dy: 29 * du ~0ms; task.$k.dy: 0 ~220ms after 40ms }
    }
    fact task_n = 0
    //  The drawing board in the Pad tab: the logic keeps the strokes as short segments (half units, from the board's corner) and gives
    //  them back here to draw, up to 768 in three lists of 256. A point is reported as one number: x * 1000 + y, in half units.
    fact pad_mode = 0                                       // 0 tasks, 1 draw
    prop pad_sel = 0 ~slide
    follow pad_sel = pad_mode
    fact dr_col = 0                                         // the pen: a colour out of five
    fact dr_thick = 0                                       // and one of three sizes (also the eraser's)
    fact dr_tool = 0                                        // 0 pen, 1 eraser
    fact dr_held = false                                    // the pointer is down on the board
    fact dr_px = 0                                          // and where, for the eraser's ring
    fact dr_py = 0
    model dr_segs0 max 256 { x0: number; y0: number; x1: number; y1: number; c: number; w: number }
    model dr_segs1 max 256 { x0: number; y0: number; x1: number; y1: number; c: number; w: number }
    model dr_segs2 max 256 { x0: number; y0: number; x1: number; y1: number; c: number; w: number }
    event dr_down ->
    event dr_pt ->
    event dr_up ->
    event dr_undo ->
    event dr_clear ->
    text task_in = ""
    //  The Ask tab (logic/ask.luau): which assistant, which of them are installed, the conversation as one text, and where it is scrolled.
    fact ask_backend = 0                                   // 0 Claude, 1 Ollama, 2 Codex, 3 Gemini
    prop ask_sel = 0 ~slide                                // which assistant the Ask tab's thumb is on
    follow ask_sel = ask_backend
    repeat k in 0..4 { fact ask_have.$k = false }
    fact ask_ok = false                                    // the chosen one can answer
    fact ask_busy = false
    fact ask_nmodels = 0                                   // how many Ollama models there are to choose from
    fact ask_n = 0
    text ask_in = ""
    model ask_rows max 60 { kind: number; who: text; body: text; lang: text; first: bool }     // 0 you, 1 answer, 2 code, 3 note
    event ask_copy ->
    //  The Clip tab (logic/clipboard.luau): the clipboard history, pinned entries first.
    model clip_rows max 48 { label: text; sub: text; pinned: bool; image: bool; hasthumb: bool; thumb: image 96, 64 }
    event clip_copy ->
    event clip_pin ->
    event clip_ask ->
    event clip_del ->
    event clip_refresh ->
    event clip_clear ->
    fact clip_n = 0
    text clip_msg = ""
    fact clip_confirm = false                                 // the Clear control has been pressed once and asks again
    fact clip_flash = false                                   // `clip_msg` is showing (a moment, after a copy)
    event ask_attach ->                                       // something to ask about, from elsewhere: `ask_attach_in` is the text, `ask_attach_src` what it is
    event ask_att_clear ->
    event ask_attached ->
    text ask_attach_in = ""
    text ask_attach_src = ""
    text ask_att_label = ""
    fact ask_att = 0                                          // how many characters wait to go with the next question; 0 for none
    text ask_status = ""
    measure ask_clr                                        // the width of "Clear", so its underline is exactly as long
    event ask_pick ->
    event ask_new ->
    event ask_stop ->
    event ask_cycle ->
    //  Claude's plan usage (the five-hour and seven-day windows, 0 to 1, -1 until an answer has said), as two thin bars under the status row, and
    //  when each resets. The bars take 33 off the conversation's card (`ask_dy`) while Claude is the one chosen and has said.
    fact ask_u5 = -1
    fact ask_u7 = -1
    text ask_r5 = ""
    text ask_r7 = ""
    prop ask_us = 0 ~calm
    follow ask_us = if(ask_backend == 0 and ask_u5 >= 0, 1, 0)
    prop ask_f5 = 0 ~calm
    prop ask_f7 = 0 ~calm
    follow ask_f5 = max(0, ask_u5)
    follow ask_f7 = max(0, ask_u7)
    let ask_dy = 33 * du * ask_us
    prop ask_atts = 0 ~calm
    follow ask_atts = if(ask_att > 0, 1, 0)
    let ask_db = 26 * du * ask_atts                          // and 26 off its foot while something waits to go with the next question
    on ask_attached { desk_open = true; desk_tab = 5; focus ask_in; desk_kb = true }
    fact ask_follow = true                                   // the conversation follows its end while an answer comes in, until the wheel takes it back up
    on change desk_open while not desk_open { ask_follow = true }
    event task_toggle ->
    event task_del ->
    event task_clear ->
    event task_shifted                                      // from the logic: lines from this one on have moved up
    event shelf_shifted
    prop ft_dnd_p = 1 ~pop
    prop ft_caf_p = 1 ~pop
    follow ft_dnd_p = if(ft_dnd, 1, 0)
    follow ft_caf_p = if(ft_caf, 1, 0)
    prop ft_sel = 1 ~slide
    follow ft_ring = ft_prog
    follow ft_sel = if(ft_len == 15, 0, if(ft_len == 30, 1, if(ft_len == 45, 2, 3)))
    on press ntn_t { panel_scr = screen.index; panel = if(panel == launch, none, launch) }
    on press ntn_l { panel_scr = screen.index; panel = if(bt > 0.5, if(panel == settings, none, settings), if(panel == launch, none, launch)) }
    on press ntn_b { panel_scr = screen.index; panel = if(bt > 0.5, if(panel == launch, none, launch), if(panel == settings, none, settings)) }
    //  Declared here, before the bar and the panels, so that every zone of theirs drawn over them still takes its own presses.
    //  The control centre and the calendar open on a click, from the strip's icon and its clock; a click on either again, a click anywhere else or Esc closes them.
    group {
        show: sb > 0.5
        move: rt * (screen.width - 2 * lf.x), 0
    zone box ctl_btn_z { at: lf.w / 2, lv.ctl; size: lf.w, 36 * u; cursor: pointer; active: lm > 0.5 }
    on press ctl_btn_z { panel_scr = screen.index; panel = if(panel == controls, none, controls) }
    zone box cal_btn_z { at: lf.w / 2, lv.clk + 30 * u; size: lf.w, 104 * u; cursor: pointer; active: lm > 0.5 }
    on press cal_btn_z { panel_scr = screen.index; panel = if(panel == calendar, none, calendar) }
    //  The window title (and the player's buttons over it) the same way: a click on it opens the player's panel.
    //  At least as long as an edge notch (`nt_w`), so a short title ("Signal") is still easy to find and to hit, and an empty workspace (no title at all) still opens the list of windows.
    zone box pl_btn_z { at: lf.w / 2, lv.tm; size: lf.w, max(52 * cu, lv.span); cursor: pointer; active: lm > 0.5 and bv.title }
    }
    on press pl_btn_z { panel_scr = screen.index; panel = if(panel == player, none, player) }
    //  A small tab out of the strip's right edge beside the title, while the pointer is on it: the edge notches' way of
    //  saying "this opens", only a few pixels. It tucks back in when the player's panel comes out of the same place.
    let ptab_h = max(52 * cu, lv.span)             // as long as what can be clicked (`pl_btn_z`): the title text only, not the player's buttons
    let ptab_d = 3.5 * u                                     // how far out it comes
    //  Along the top the same tab hangs from the pill's bottom edge, under the title button (`win_hit`): as wide as the title, or a short stub when there is none.
    let ptab_iw = clamp(max(clsw.width, titw.width) + 12 * u, 52 * u, max(52 * u, win.w - 12 * u))
    let ptab_ix = mix(win.cm, win.xs - 6 * u + ptab_iw / 2, clamp(max(clsw.width, titw.width) / (6 * u), 0, 1))
    prop ptab_vis.0 = 0 ~calm                        // the same spring as the edge notches (`nt_vis_*`)
    prop ptab_vis.1 = 0 ~calm
    prop ptab_vis.2 = 0 ~calm
    prop ptab_vis.3 = 0 ~calm
    prop ptab_hold.0 = 0 ~280ms                      // the notches' short wait before coming out, and grace before going back
    prop ptab_hold.1 = 0 ~280ms
    prop ptab_hold.2 = 0 ~280ms
    prop ptab_hold.3 = 0 ~280ms
    follow ptab_vis.$screen = if(ptab_hold.$screen > 0.3, 1, 0)
    //  The calendar's and the control center's panels, being joined to the strip too, have the same ripple (opening and closing).
    //  The title's panel (the player, the tray's menu) is joined to the strip, so the drop's ripple (`prip`, scaled by `1 - att`) skips it. It has its own, the same
    //  crests (size, speed, time) as the Settings' and the launcher's: when it has come out and when it has gone back in. Frame layouts only, like theirs.
    prop tprip = 1 ~1100ms
    on change dm > 0.84 while dm > 0.84 and fm > 0.5 { tprip: 0 ~16ms; tprip: 1 ~1100ms after 30ms }
    on change dm < 0.06 while dm < 0.06 and fm > 0.5 { tprip: 0 ~16ms; tprip: 1 ~600ms after 30ms }
    on change dc > 0.84 while dc > 0.84 and fm > 0.5 { tprip: 0 ~16ms; tprip: 1 ~1100ms after 30ms }
    on change dc < 0.06 while dc < 0.06 and fm > 0.5 { tprip: 0 ~16ms; tprip: 1 ~600ms after 30ms }
    on change dk > 0.84 while dk > 0.84 and fm > 0.5 and bar_sg < 0.5 { tprip: 0 ~16ms; tprip: 1 ~1100ms after 30ms }
    on change dk < 0.06 while dk < 0.06 and fm > 0.5 and bar_sg < 0.5 { tprip: 0 ~16ms; tprip: 1 ~600ms after 30ms }
    let tq.x = (12 + 90 * tprip) * u
    let tq.h = max(20 * u * (1 - tprip) * clamp(tprip * 6, 0, 1) * fm * (1 - uwu_k), 0.3)
    let tq.act = if(cas_k < 0.5 and lm > 0.5 and tprip < 0.98 and pown > 0.5 and sg < 0.5, 1, 0)
    let tq.actt = if(cas_k < 0.5 and tm > 0.5 and tprip < 0.98 and pown > 0.5 and sg < 0.5, 1, 0)       // along the top or bottom: the same two crests, turned a quarter
