    //  island layout, it has glass of its own, below.)
    let mf.g  = clamp(mfl, 0, 1) * mf.mine * media_open                        // how much of its glass there is
    let mf.hw = 154 * cu * mf.k
    let mf.hh = 84 * cu * mf.k
    //  How far it can be carried, in screen terms: the desk's bounds are the drawing's, so on the right and the bottom they swap sides.
    let mfb.l = mix(desk_xlo, screen.width - desk_xhi, rt)
