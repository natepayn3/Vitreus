            path { at: cx, cy; stroke: 1.5 * cu; color: ink; opacity: (w1); move 11 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 63 + 4876), -3 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 68 + 4936); curve 11 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 70 + 4973), 3 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 44 + 5033) via 14 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 48 + 9823), 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 53 + 9883); }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: ink; opacity: (w1) * 0.28; move 11 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 47 + 5247), -3 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 52 + 5307); curve 11 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 54 + 5344), 3 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 59 + 5404) via 14 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 63 + 10194), 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 68 + 10254); }
            path { at: cx, cy; stroke: 1.5 * cu; color: ink; opacity: (w2); move 14 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 43 + 4929), -6.5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 48 + 4989); curve 14 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 50 + 5026), 6.5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 55 + 5086) via 20 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 59 + 9876), 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 64 + 9936); }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: ink; opacity: (w2) * 0.28; move 14 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 58 + 5300), -6.5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 63 + 5360); curve 14 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 65 + 5397), 6.5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 70 + 5457) via 20 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 43 + 10247), 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 48 + 10307); }
            path { at: cx, cy; stroke: 1.5 * cu; color: alert; opacity: (msl); move 11 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 54 + 4982), -5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 59 + 5042); line 20 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 61 + 5079), 5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 66 + 5139); }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: alert; opacity: (msl) * 0.28; move 11 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 69 + 5353), -5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 43 + 5413); line 20 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 45 + 5450), 5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 50 + 5510); }
        }
    }

    component PMic(cx: number, cy: number, hot: number, m: number, hv: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        group {
            pivot: cx, cy
