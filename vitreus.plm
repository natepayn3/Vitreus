    let fwh_0 = if(0 < fw.nuse, min(1, pow(mix(pick(fwl_0, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(fwl_0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), clamp(fwb_0 - fwl_0, 0, 1)), 1.4) * fw.sm) * if(fw_lay == 1, 1, clamp(min(0 + 0.5, fw.n - 0 - 0.5) / (0.05 * fw.n), 0, 1)) * fw.hm * u * fw_on, 0)
