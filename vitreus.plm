    //  bar and the drawer is only as tall as its two plates and their margins.
    let ck = cy - 127 * ku

    //  The media card's middle: its place in the panel (the card's full height, whatever the panel is doing), or where it floats; and how much of it shows.
    //  Docked, its place is where the panel's contents are drawn on the screen: on the right (and along the bottom) that is the mirror image of where the
    //  panel is laid out, so the card starts from there and does not jump when it is picked up.
    let mf.mine = if(mf_scr == screen.index, 1, 0)             // this copy is the monitor the floating card is on
    let mf.cx = mix(mdx + rt * (screen.width - 2 * pcx), mf_px, mfl)
