language 0.1

import "palette.plm"

//  Vitreus: a bar of liquid glass. The glass only blurs what is behind it (the
//  compositor does it; `lens: false`), and the panel is not stuck under the
//  bar: it is the same silhouette, melted, so it hangs from it like a drop.

scene Vitreus {
    surface { size: 900, 800; anchor: top; margin: 0; reserve: 68; keyboard: exclusive while panel != none and panel != volume and panel != notif }
    permissions { services: "files", "files.write", "clock", "audio", "audio.*", "window", "media", "media.*", "workspaces", "workspaces.focus", "brightness", "brightness.*", "network", "network.*", "bluetooth", "bluetooth.*", "apps", "tray", "tray.*", "notifications", "notifications.*"
                  run: "cava", "playerctl", "curl", "notify-send", "which", "pgrep", "pkill", "systemctl", "hyprctl", "printenv", "awww", "iris", "cp", "ls", "xdg-user-dir", "magick", "mkdir", "bluetoothctl", "nmcli" }

    model wifi_nets max 8 { ssid: text; strength: number; secure: bool; known: bool; active: bool }
    model bt_devices max 24 { name: text; address: text; paired: bool; connected: bool; battery: number }

    service clock as now { time: text = "--:--"; date: text }
    service audio { volume: number; muted: bool }
    service window as win { title: text; class: text }
    service media { playing: bool; title: text; artist: text; player: text }
    service brightness { present: bool; level: number }
    service network as net { online: bool; wifi: bool; name: text; strength: number; networks: wifi_nets }
    service bluetooth as bt { present: bool; powered: bool }        // the list itself is built by the logic

    text clock12 = "--:--"
    text clock_h = ""              // the bar clock in three parts: the hour (oversized), the minutes (in the accent), am/pm
    text clock_mm = ""
    text bar_ap = ""
    text bar_date = ""              // the short day stacked above the am/pm: MON
    text datelong = ""
    //  The clock card's pieces: the numerals, the am/pm tucked beside them, and the date as weekday | month day.
    text clock_hm = "--:--"
    text clock_ap = ""
    text date_wd = ""
    text date_md = ""
    measure hmw                    // how wide the big numerals are, to tuck the am/pm against them
    measure mdw                    // and the month and day, the date being right-aligned from them
    text arturl = ""               // the cover: a path to an image file, from the logic
    fact art_on = false            // is there one
    image art = from arturl, 200, 200
    event trackchange              // the logic says the song changed
    //  The calendar: 42 days in the grid (six weeks), what the logic says of each, and the
    //  chosen day's reminders. The logic keeps them in `calendar.json` and paints these.
    event cal_pick ->              // a day of the grid, by its place
    event cal_prev ->
    event cal_next ->
    event cal_today ->
    event cal_open ->              // the calendar panel just opened: back to today
    event cal_add ->               // the Add button (Enter in the field does the same)
    event cal_check ->             // a reminder of the chosen day, by its row: done / not done
    event cal_delete ->
    fact cal.sel = 0               // which place of the grid is chosen
    text cal.month = ""
    text cal.sel_title = ""
    text cal.sel_sub = ""
    text cal_new = ""              // what is being typed in the field
    model cal_events max 4 { time: text; title: text; done: bool }
    repeat k in 0..42 {
        fact cal.day.$k = 0
        fact cal.in.$k = false
        fact cal.today.$k = false
        fact cal.n.$k = 0
    }
    repeat w in 1..8 { text cal.wd.$w = "" }
    text outname = ""              // where the sound is going: the default output
    measure outw                   // how wide that name really is
    measure clsw                   // how wide the focused app's name really is
    measure titw                   // and its window title
    measure chw                    // the bar clock's hour, minutes and am/pm: how wide each really is; the bar's
    measure cmw                    // buttons and the calendar's click area are placed from them
    measure caw
    measure cdw
    //  Which panel hangs from the bar: the clock and calendar (click the clock), or the
    //  controls (click the window title).
    fact panel: none | calendar | controls | player | volume | notif | settings = none
    fact media_on = false          // is there a player at all
    fact bass = 0
    //  The six bars cava reports, 0..1 each, for the equalizer in the media card. Each one
    //  has its own quick spring, so they rise and fall smoothly instead of stepping.
    repeat i in 0..6 {
        fact spec.$i = 0
        prop spec.s.$i = 0 ~quick
        follow spec.s.$i = spec.$i
    }                  // 0..1, from cava: how hard the low end is hitting
    model outlist max 6 { name: text; current: bool }   // every place the sound can go
    //  The running windows (asked of Hyprland by the logic: the window service has no list there) and
    //  the apps that live in the tray, for the panel that hangs from the window title. Icons are named
    //  by the logic, which matches each window's class to an app.
    model tasks max 12 { title: text; ws: text; active: bool; icon: image 22, 22 }
    fact tasks_watch = false       // the panel is open: keep the list fresh
    model trays max 8 { title: text; icon: image 22, 22 }
    //  The two transient panels (volume, and a notification arriving) share one drawer. `osd_kind` is
    //  which one it draws; unlike `panel` it stays put while the drawer closes, so it fades out
    //  showing what it was showing.
    fact osd_kind: vol | note = vol
    text nt_app = ""
    text nt_title = ""
    text nt_body = ""
    measure ntt                    // how tall the notification's title really is once wrapped
    measure ntb                    // and its body
    text nt_iconpath = ""          // the app's icon, or the picture it brought: a name or a path
    image nt_img = from nt_iconpath, 44, 44
    fact nt_icon_on = false
    fact nt_body_on = false
    fact nt_urgent = false
    model nt_acts max 3 { label: text }
    event ntnew                    // a notification just arrived: ripple the tile
    event nt_close ->              // its cross, or a press on the plate
    event nt_act ->                // one of its buttons, by position
    //  Settings: a panel of pages, the wallpaper picker first. The logic lists the folder and keeps one
    //  page of twelve thumbnails at a time (the folder can hold hundreds of full-size images).
    model wps max 12 { thumb: image 260, 146 }
    fact wp_sel = -1                // which thumbnail of this page is the wallpaper in use, or -1
    text wp_curpath = ""            // the wallpaper in use: a path
    image wp_cur = from wp_curpath, 320, 180
    text wp_name = ""
    text wp_dirtext = ""
    text wp_pager = ""
    event wp_pick ->                // a thumbnail, by position on the page
    event wp_prev ->
    event wp_next ->
    event wp_random ->
    //  Weather, for the calendar panel: what it is now, and the week ahead. The logic fetches it (Open-Meteo)
    //  and gives each day a `kind`: 0 clear, 1 partly cloudy, 2 cloud, 3 fog, 4 rain, 5 snow, 6 storm.
    fact wx_ok = false
    fact wx_kind = 2
    text wx_temp = ""
    text wx_desc = ""
    model wx_days max 7 { label: text; kind: number; hi: text; lo: text; today: bool }
    event task_focus ->            // a window's row, by position: give it the keyboard
    event task_close ->            // its close button, or a middle click
    event tray_click ->            // a tray app's row
    fact dd_open = false           // the output dropdown
    event pick_out ->              // a row of it, by position
    event mute ->                  // the speaker icon
    event setvol ->                // the volume slider: 0..1
    event mcmd ->                  // 0 previous · 1 play/pause · 2 next
    event setbright ->             // the brightness slider: 0..1
    event togglewifi ->            // the wifi row: flips the radio
    event togglebt ->              // the bluetooth row: flips the radio
    fact bt_connected = false      // a device is paired and connected
    text bt_name = ""              // its name, from the logic
    fact bright_avail = true       // brightnessctl is installed: the slider can actually be dragged
    //  Tapping the rest of a tile (not its toggle) grows it into its own window.
    //  `showing_sub` only follows `panel_sub` on the way in - see its rule below -
    //  so the window it drew stays up, fading out, while it closes.
    fact panel_sub: none | netview | btview | notifview = none
    fact showing_sub: none | netview | btview | notifview = none
    //  Which row is open, in each list - its password field or its
    //  Connect/Disconnect/Forget, right underneath it. -1 is none.
    fact wifi_open_row = -1
    fact bt_open_row = -1
    event wifi_pick ->              // a network row's own button: connect, or leave it
    event wifi_forget ->            // a network row's Forget
    event wifi_scan ->              // the rescan button
    fact wifi_scanning = false      // a scan is running: the logic holds it up for a few seconds
    fact bt_scanning = false
    text wifi_pw = ""               // the password field open under a row
    event wifi_join_go ->           // its Join button, or Enter in the field
    event bt_pick ->                // a device row's own button: connect, or leave it
    event bt_forget ->              // a device row's Forget
    event bt_scan ->                // the rescan button
    //  Do Not Disturb is a preference the logic keeps in `dnd.json`; Caffeine is whether hypridle
    //  has been stopped, which the logic asks the system rather than remembering.
    fact dnd_on = false
    fact caf_on = false
    fact caf_avail = true          // hypridle is installed: there is something to hold off
    event togglednd ->
    //  The notifications module: Do Not Disturb with a timer, and the history of what came in.
    model nt_hist max 30 { title: text; sub: text; when: text }
    text nt_tile_sub = ""          // the tile's second line: Silenced · 23:41, 12 in history, All clear
    text dnd_left = ""             // the window's DND row: 23:41 left, On until turned off, Off
    fact dnd_len = 0               // minutes of the timer that is running (which chip is lit), 0 for none
    event dnd_for ->               // a timer chip: minutes
    event nt_clear ->              // the Clear button
    event nt_hist_del ->           // a history row's cross, by position
    event togglecaf ->
    fact ws.active = 1
    repeat i in 1..6 { fact ws.$i.busy = false }
    event go ->

    //  The colours live in palette.plm (ink, faint, mint, tint…); only the veil is the scene's.
    let veil  = 8%

    shader wave = file "wave.wgsl"
    spring drip = 170, 18         // underdamped: it overshoots and settles back, like a real drop landing
    spring pop  = 300, 12         // snappier and much less damped: a toggle knob popping past where it lands

    prop drop  = 0 ~drip          // the panel, 0 to 1: it hangs from the bar and falls
    //  The settle: the panel hangs a few px lower when it lands and eases back. Critically damped, so it is one slow hump and never a bounce.
    spring hang = 260, 32
    prop sag   = 0 ~hang
    prop hot   = 0 ~quick         // the bar, when the pointer is on it
    prop f1    = 0 ~200ms        // what is inside, arriving one after another
    prop f2    = 0 ~380ms
    prop f3    = 0 ~520ms
    prop f4    = 0 ~380ms          // the calendar's second stage
    prop f5    = 0 ~620ms          // the controls drawer, third in: brightness
    prop f6    = 0 ~700ms          // fourth: wifi
    prop f7    = 0 ~780ms          // fifth: bluetooth
    prop wifi_on = 0 ~pop         // the wifi toggle pill, popping past where it lands
    prop bt_on   = 0 ~pop         // the bluetooth toggle pill, popping past where it lands
    prop media_open = 0 ~drip      // the media plate: a sliver with nothing playing, a full card with something to show
    //  Each panel has its own amount, 0 shut .. 1 open. Each one is a drawer that comes out of the
    //  bar and melts into it; the calendar is as wide as the bar, the others are narrower.
    prop dc    = 0 ~drip
    prop dk    = 0 ~drip
    prop dm    = 0 ~drip          // the player's panel, hanging from the window title
    prop do    = 0 ~drip          // the volume / notification drawer
    prop ds    = 0 ~drip          // the settings panel
    prop fs    = 0 ~300ms         // what is in it, fading in
    prop fo    = 0 ~300ms         // what is in it, fading in
    prop okv   = 0 ~calm          // 1 while it is the volume that is drawn
    prop okn   = 0 ~calm          // 1 while it is a notification
    prop osd_h = 64 ~calm         // the height of its plate: a notification is taller with text and buttons
    prop nt_ring = 1 ~900ms       // a ripple off the notification's tile: 0 born, 1 gone
    prop expand = 0 ~drip          // a tile growing into its own window, 0 tile .. 1 full window
    //  The music: fast, and a little loose, so the bar bounces on the beat.
    spring beat = 480, 15
    prop pulse = 0 ~beat
    prop ring  = 1 ~900ms          // a ripple crossing the bar: 0 born, 1 gone
    prop dd    = 0 ~calm           // the output dropdown, 0 shut .. 1 open
    prop swap  = 1 ~700ms          // the cover popping in on a new song: 0 just changed, 1 settled
    prop playf = 0 ~calm           // 1 while playing: the cover is full and colourful
    prop mshow = 0 ~calm          // the bar's player controls: there while a player exists, paused or not

    follow drop = if(panel != none, 1, 0)
    follow hot  = if(panel != none, 1, 0)
    follow dc   = if(panel == calendar, 1, 0)
    follow dk   = if(panel == controls, 1, 0)
    follow dm   = if(panel == player, 1, 0)
    follow do   = if(panel == volume or panel == notif, 1, 0)
    follow ds   = if(panel == settings, 1, 0)
    follow okv  = if(osd_kind == vol, 1, 0)
    follow okn  = if(osd_kind == note, 1, 0)
    on ntnew {
        nt_ring: 0 ~16ms
        nt_ring: 1 ~800ms after 30ms
    }
    follow expand = if(panel_sub != none, 1, 0)
    //  Which window to actually draw. It jumps to match `panel_sub` the moment
    //  that becomes something - opening one, or switching straight to the other
    //  - but not back to `none`: closing is `expand` fading the same window out,
    //  so it has to stay named while that happens.
    on change panel_sub while panel_sub != none { showing_sub = panel_sub }
    on change panel_sub { wifi_open_row = -1; bt_open_row = -1 }
    //  Each workspace's indicator has its own amount of «active», 0..1, and morphs by it: the one that
    //  becomes active widens and turns mint in place while the one that stops shrinks back. Nothing
    //  travels. The speed is one with no overshoot: a morph, not a bounce.
    prop ws.act.1 = 0 ~260ms
    prop ws.act.2 = 0 ~260ms
    prop ws.act.3 = 0 ~260ms
    prop ws.act.4 = 0 ~260ms
    prop ws.act.5 = 0 ~260ms
    follow ws.act.1 = if(ws.active == 1, 1, 0)
    follow ws.act.2 = if(ws.active == 2, 1, 0)
    follow ws.act.3 = if(ws.active == 3, 1, 0)
    follow ws.act.4 = if(ws.active == 4, 1, 0)
    follow ws.act.5 = if(ws.active == 5, 1, 0)
    //  Where the active one is, as a number that moves smoothly between slots while two are morphing
    //  (the amounts of the two add up to 1, so this is their weighted middle).
    let pill = ws.act.1 * 1 + ws.act.2 * 2 + ws.act.3 * 3 + ws.act.4 * 4 + ws.act.5 * 5
    //  Occupied but not active: the dot stretches up into a capsule.
    repeat i in 1..6 { prop ws.tall.$i = 0 ~lively }
    repeat i in 1..6 { follow ws.tall.$i = if(ws.$i.busy, 1, 0) }

    on change drop > 0.97 while drop > 0.97 { impulse sag 220 }
    //  What is inside a panel arrives after the drawer has come down, not with it (it was showing while the
    //  drawer was still a sliver under the bar, over the bar's lower half), and leaves at once when the panel
    //  closes, so nothing is left hanging over the bar as it shuts. Each keeps its own spring, so the
    //  controls' plates still arrive one after another.
    on change panel while panel == calendar   { f1: 1 after 220ms; f4: 1 after 300ms }
    on change panel while panel != calendar   { f1: 0 ~80ms; f4: 0 ~80ms }
    on change panel while panel == controls   { f2: 1 after 200ms; f5: 1 after 200ms; f6: 1 after 200ms; f7: 1 after 200ms }
    on change panel while panel != controls   { f2: 0 ~80ms; f5: 0 ~80ms; f6: 0 ~80ms; f7: 0 ~80ms }
    on change panel while panel == player     { f3: 1 after 200ms }
    on change panel while panel != player     { f3: 0 ~80ms }
    on change panel while panel == settings   { fs: 1 after 220ms }
    on change panel while panel != settings   { fs: 0 ~80ms }
    on change panel while panel == volume or panel == notif { fo: 1 after 140ms }
    on change panel while panel != volume and panel != notif { fo: 0 ~80ms }
    follow wifi_on = if(net.wifi, 1, 0)
    follow bt_on   = if(bt.powered, 1, 0)
    prop dnd_pill = 0 ~pop
    prop caf_pill = 0 ~pop
    prop dnd_wobble = 0 ~pop       // the bell, swung when DND flips
    follow dnd_pill = if(dnd_on, 1, 0)
    follow caf_pill = if(caf_on, 1, 0)
    on change dnd_on {
        dnd_wobble: -1 ~30ms
        dnd_wobble: 0 ~400ms after 60ms
    }
    follow mshow = if(media_on, 1, 0)
    follow media_open = if(media_on, 1, 0)
    follow playf = if(media.playing, 1, 0)
    on trackchange {
        swap: 0 ~16ms
        swap: 1 ~700ms after 30ms
    }
    follow dd = if(dd_open and panel == controls, 1, 0)
    on change panel { dd_open = false; panel_sub = none }
    on change panel { tasks_watch = panel == player }
    on pick_out { dd_open = false }
    follow pulse = bass
    //  Every time the bass hits hard, a wave is born at the player controls (the
    //  bar's shader reads `ring` as how far it has travelled). It
    //  has to fall back below the threshold before the next one can be born.
    on change bass > 0.6 while bass > 0.6 {
        ring: 0 ~16ms
        ring: 1 ~1100ms after 30ms
    }

    //  One number scales the whole shell. The exclusive zone (`reserve` above) is
    //  the bar and a little air: 8 + bar.h + 6.
    let u = 1.35
    //  One reminder of the chosen day: a circle to tick it off, its time, its words, a cross.
    component CalRow(e: record, tick: event, gone: event) {
        //  30 px tall at least, and as tall as its title needs: a reminder wraps onto more lines rather
        //  than being cut short with an ellipsis. Whole pixels (a row at 22 units, x 1.35, sits on a
        //  fraction of a pixel, and text drawn between pixels comes out soft), and the text and the
        //  ring are put on whole pixels too. The ring, time and cross stay level with the first line.
        size: 154 * u, max(30, floor(14 + wrap.height + 0.5))
        let rowh = max(30, floor(14 + wrap.height + 0.5))
        zone box touch { from: 0, 0; size: 154 * u, rowh; corner: 8 * u }
        box { from: 0, 0; size: 154 * u, rowh; corner: 8 * u; color: ink; opacity: 6% + 7% * touch.hover }
        ellipse { at: 15, 15; radius: 5.5 * u; stroke: 1.3 * u; color: mint; opacity: if(e.done, 0, 85%) }
        ellipse { at: 15, 15; radius: 5.5 * u; color: mint; opacity: if(e.done, 100%, 0) }
        path { at: 15, 15; stroke: 1.4 * u; color: onmint; opacity: if(e.done, 100%, 0); move -2.5 * u, 0; line -0.5 * u, 2.2 * u; line 3 * u, -2.4 * u }
        text e.time { at: floor(22 * u + 0.5), 15; anchor: left center; size: 10 * u; weight: 600; width: 34 * u; lines: 1; color: mint; opacity: if(e.done, 40%, 100%); family: "Space Grotesk" }
        column wrap {
            at: floor(56 * u + 0.5), 7
            text e.title { size: 11.5 * u; width: 74 * u; lines: 5; color: ink; opacity: if(e.done, 40%, 100%); family: "Space Grotesk" }
        }
        line { from: 137 * u, 15 - 3 * u; to: 143 * u, 15 + 3 * u; width: 1.4 * u; color: ink; opacity: 22% + 60% * touch.hover }
        line { from: 143 * u, 15 - 3 * u; to: 137 * u, 15 + 3 * u; width: 1.4 * u; color: ink; opacity: 22% + 60% * touch.hover }
        zone box check_z { at: 15, 15; size: 22 * u, 30; corner: 11 * u; cursor: pointer }
        zone box gone_z { at: 140 * u, 15; size: 20 * u, 30; corner: 10 * u; cursor: pointer }
        on press check_z { emit tick(e.index) }
        on press gone_z { emit gone(e.index) }
    }

    //  One row of the output dropdown: a dot if it is the current one, its name.
    component OutRow(f: record, pick: event) {
        size: 276 * u, floor(28 * u + 0.5)
        zone box touch { from: 0, 0; size: 276 * u, 28 * u; corner: 10 * u; cursor: pointer }
        box { from: 0, 0; size: 276 * u, 28 * u; corner: 10 * u; color: ink
              opacity: if(f.current, 12%, 0%) + 9% * touch.hover }
        ellipse { at: 14 * u, 14 * u; radius: 3 * u; color: mint; opacity: if(f.current, 100%, 0%) }
        text f.name { at: floor(28 * u + 0.5), floor(14 * u + 0.5); anchor: left center; size: 13.5 * u; width: 236 * u; lines: 1
                      color: ink; family: "Space Grotesk" }
        on press touch { emit pick(f.index) }
    }

    //  One row of the Wi-Fi window: a dot if it's the one in use, its name, and
    //  what tapping it means right now. A secured network no password is known
    //  for yet opens the join field instead of trying to connect outright.
    //  Tapping a row never acts by itself - it only opens what's underneath it,
    //  right there: a password field for a secured network not seen before, or
    //  Connect/Disconnect and Forget for anything else. `wifi_open_row` is the
    //  one index that's open at a time, so opening another closes the last one.
    component WifiRow(n: record, pick: event, forget: event, joingo: event) {
        size: 264 * u, floor((30 + if(wifi_open_row == n.index, 44, 0)) * u + 0.5)
        let isopen = wifi_open_row == n.index
        zone box touch { from: 0, 0; size: 264 * u, 30 * u; corner: 10 * u; cursor: pointer }
        box { from: 0, 0; size: 264 * u, 30 * u; corner: 10 * u; color: ink; opacity: if(n.active, 12%, 0%) + 9% * touch.hover }
        ellipse { at: 14 * u, 15 * u; radius: 3 * u; color: mint; opacity: if(n.active, 100%, 0%) }
        text n.ssid { at: floor(28 * u + 0.5), floor(15 * u + 0.5); anchor: left center; size: 12.5 * u; width: 150 * u; lines: 1; color: ink; family: "Space Grotesk" }
        text "Connected" { at: floor(250 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: mint; family: "Space Grotesk"; show: n.active }
        text "Saved" { at: floor(250 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: faint; family: "Space Grotesk"; show: n.known and not n.active }
        text "Secured" { at: floor(250 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: faint; family: "Space Grotesk"; show: n.secure and not n.known and not n.active }
        text "Open" { at: floor(250 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: faint; family: "Space Grotesk"; show: not n.secure and not n.known and not n.active }
        on press touch { wifi_open_row = if(isopen, -1, n.index) }

        group {
            show: isopen
            opacity: if(isopen, 1, 0)
            //  A secured network never seen before: the password, right here.
            group {
                show: n.secure and not n.known and not n.active
                input wifi_pw { at: floor(14 * u + 0.5), floor(45 * u - 6.3 * u + 0.5); width: 150 * u; size: 11.5 * u; color: ink; family: "Space Grotesk"; secret: true; placeholder: "Password" }
                box { at: 224 * u, 45 * u; size: 40 * u, 24 * u; corner: 12 * u; color: mint; opacity: 80% + 20% * joinbtn.hover }
                text "Join" { at: floor(224 * u + 0.5), floor(45 * u + 0.5); anchor: center; size: 10.5 * u; weight: 700; color: onmint; family: "Space Grotesk" }
                zone box joinbtn { at: 224 * u, 45 * u; size: 44 * u, 28 * u; corner: 14 * u; cursor: pointer }
                on press joinbtn { emit joingo(n.index) }
            }
            //  Open, and never joined: nothing to type, just a way in.
            group {
                show: not n.secure and not n.known and not n.active
                box { at: 132 * u, 45 * u; size: 110 * u, 24 * u; corner: 12 * u; color: mint; opacity: 80% + 20% * connbtn.hover }
                text "Connect" { at: floor(132 * u + 0.5), floor(45 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: onmint; family: "Space Grotesk" }
                zone box connbtn { at: 132 * u, 45 * u; size: 114 * u, 28 * u; corner: 14 * u; cursor: pointer }
                on press connbtn { emit pick(n.index) }
            }
            //  Known, or the one in use: leave it, join it again, or forget it outright.
            group {
                show: n.known or n.active
                box { at: 90 * u, 45 * u; size: 96 * u, 24 * u; corner: 12 * u; color: if(n.active, off, mint); opacity: 80% + 20% * primbtn.hover }
                text "Disconnect" { at: floor(90 * u + 0.5), floor(45 * u + 0.5); anchor: center; size: 10.5 * u; weight: 700; color: ink; family: "Space Grotesk"; show: n.active }
                text "Connect" { at: floor(90 * u + 0.5), floor(45 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: onmint; family: "Space Grotesk"; show: not n.active }
                zone box primbtn { at: 90 * u, 45 * u; size: 100 * u, 28 * u; corner: 14 * u; cursor: pointer }
                on press primbtn { emit pick(n.index) }
                box { at: 194 * u, 45 * u; size: 76 * u, 24 * u; corner: 12 * u; color: ink; opacity: 8% + 10% * forgetbtn.hover }
                text "Forget" { at: floor(194 * u + 0.5), floor(45 * u + 0.5); anchor: center; size: 10.5 * u; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
                zone box forgetbtn { at: 194 * u, 45 * u; size: 80 * u, 28 * u; corner: 14 * u; cursor: pointer }
                on press forgetbtn { emit forget(n.index) }
            }
        }
    }

    //  One row of the Bluetooth window: connected (with its battery, if it says), paired, or just seen.
    //  Tapping it opens Connect/Disconnect and Forget underneath, the same as a Wi-Fi row.
    component BtRow(d: record, pick: event, forget: event) {
        size: 264 * u, floor((30 + if(bt_open_row == d.index, 44, 0)) * u + 0.5)
        let isopen = bt_open_row == d.index
        zone box touch { from: 0, 0; size: 264 * u, 30 * u; corner: 10 * u; cursor: pointer }
        box { from: 0, 0; size: 264 * u, 30 * u; corner: 10 * u; color: ink; opacity: if(d.connected, 12%, 0%) + 9% * touch.hover }
        ellipse { at: 14 * u, 15 * u; radius: 3 * u; color: mint; opacity: if(d.connected, 100%, 0%) }
        text d.name { at: floor(28 * u + 0.5), floor(15 * u + 0.5); anchor: left center; size: 12.5 * u; width: 150 * u; lines: 1; color: ink; family: "Space Grotesk" }
        text "Connected" { at: floor(250 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: mint; family: "Space Grotesk"; show: d.connected and d.battery < 0 }
        text number(d.battery * 100, 0, "%") { at: floor(250 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: mint; family: "Space Grotesk"; show: d.connected and d.battery >= 0 }
        text "Paired" { at: floor(250 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: faint; family: "Space Grotesk"; show: d.paired and not d.connected }
        text "Not paired" { at: floor(250 * u + 0.5), floor(15 * u + 0.5); anchor: right center; size: 10 * u; color: faint; family: "Space Grotesk"; show: not d.paired and not d.connected }
        on press touch { bt_open_row = if(isopen, -1, d.index) }

        group {
            show: isopen
            opacity: if(isopen, 1, 0)
            group {
                show: not d.paired and not d.connected
                box { at: 132 * u, 45 * u; size: 130 * u, 24 * u; corner: 12 * u; color: mint; opacity: 80% + 20% * pairbtn.hover }
                text "Pair & Connect" { at: floor(132 * u + 0.5), floor(45 * u + 0.5); anchor: center; size: 10.5 * u; weight: 700; color: onmint; family: "Space Grotesk" }
                zone box pairbtn { at: 132 * u, 45 * u; size: 134 * u, 28 * u; corner: 14 * u; cursor: pointer }
                on press pairbtn { emit pick(d.index) }
            }
            group {
                show: d.paired or d.connected
                box { at: 90 * u, 45 * u; size: 96 * u, 24 * u; corner: 12 * u; color: if(d.connected, off, mint); opacity: 80% + 20% * primbtn.hover }
                text "Disconnect" { at: floor(90 * u + 0.5), floor(45 * u + 0.5); anchor: center; size: 10.5 * u; weight: 700; color: ink; family: "Space Grotesk"; show: d.connected }
                text "Connect" { at: floor(90 * u + 0.5), floor(45 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: onmint; family: "Space Grotesk"; show: not d.connected }
                zone box primbtn { at: 90 * u, 45 * u; size: 100 * u, 28 * u; corner: 14 * u; cursor: pointer }
                on press primbtn { emit pick(d.index) }
                box { at: 194 * u, 45 * u; size: 76 * u, 24 * u; corner: 12 * u; color: ink; opacity: 8% + 10% * forgetbtn.hover }
                text "Forget" { at: floor(194 * u + 0.5), floor(45 * u + 0.5); anchor: center; size: 10.5 * u; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
                zone box forgetbtn { at: 194 * u, 45 * u; size: 80 * u, 28 * u; corner: 14 * u; cursor: pointer }
                on press forgetbtn { emit forget(d.index) }
            }
        }
    }

    //  One running window, the way Synoptik's task list draws it: its app icon, its title (mint and
    //  bold if it has the keyboard), and a close button that shows while the row is under the pointer.
    //  A press gives it the keyboard; a middle press closes it.
    component TaskRow(t: record, focus: event, kill: event) {
        size: 288 * u, 36 * u
        zone box touch { from: 0, 0; size: 288 * u, 36 * u; corner: 12 * u; cursor: pointer }
        box { from: 0, 0; size: 288 * u, 36 * u; corner: 12 * u; color: ink; opacity: if(t.active, 11%, 5%) + 8% * touch.hover }
        image t.icon { at: floor(8 * u + 0.5), floor(7 * u + 0.5); size: floor(22 * u + 0.5), floor(22 * u + 0.5) }
        text t.title { at: floor(38 * u + 0.5), floor(18 * u + 0.5); anchor: left center; size: 12.5 * u; width: 186 * u; lines: 1; color: ink; family: "Space Grotesk"; show: not t.active }
        text t.title { at: floor(38 * u + 0.5), floor(18 * u + 0.5); anchor: left center; size: 12.5 * u; weight: 700; width: 186 * u; lines: 1; color: mint; family: "Space Grotesk"; show: t.active }
        //  Which workspace it is on, in a small pill.
        box { at: 240 * u, 18 * u; size: 24 * u, 18 * u; corner: 9 * u; color: ink; opacity: 8% }
        text t.ws { at: floor(240 * u + 0.5), floor(18 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 700; width: 24 * u; lines: 1; color: ink; opacity: 80%; family: "Space Grotesk" }
        ellipse { at: 268 * u, 18 * u; radius: 10 * u; color: if(close_z.hover, alert, ink); opacity: (if(close_z.hover, 90%, 9%)) * touch.hover }
        line { from: 264.5 * u, 14.5 * u; to: 271.5 * u, 21.5 * u; width: 1.4 * u; color: ink; opacity: 70% * touch.hover }
        line { from: 271.5 * u, 14.5 * u; to: 264.5 * u, 21.5 * u; width: 1.4 * u; color: ink; opacity: 70% * touch.hover }
        zone box close_z { at: 268 * u, 18 * u; size: 22 * u, 22 * u; corner: 11 * u; cursor: pointer }
        on press touch { emit focus(t.index); panel = none }
        on press middle touch { emit kill(t.index) }
        on press close_z { emit kill(t.index) }
    }

    //  One app that lives in the tray, with no window of its own: its icon and name. A press is what
    //  clicking its icon would do.
    component TrayRow(t: record, click: event) {
        size: 288 * u, 36 * u
        zone box touch { from: 0, 0; size: 288 * u, 36 * u; corner: 12 * u; cursor: pointer }
        box { from: 0, 0; size: 288 * u, 36 * u; corner: 12 * u; color: ink; opacity: 5% + 8% * touch.hover }
        image t.icon { at: floor(8 * u + 0.5), floor(7 * u + 0.5); size: floor(22 * u + 0.5), floor(22 * u + 0.5) }
        text t.title { at: floor(38 * u + 0.5), floor(18 * u + 0.5); anchor: left center; size: 12.5 * u; width: 240 * u; lines: 1; color: ink; family: "Space Grotesk" }
        on press touch { emit click(t.index); panel = none }
    }

    //  A notification's button (Reply, Mark read…): a small pill with its label.
    component NtAct(a: record, click: event) {
        size: floor(82 * u + 0.5), floor(26 * u + 0.5)
        zone box touch { from: 0, 0; size: 82 * u, 26 * u; corner: 8 * u; cursor: pointer }
        box { from: 0, 0; size: 82 * u, 26 * u; corner: 8 * u; color: if(touch.hover, mint, ink); opacity: if(touch.hover, 100%, 8%) }
        text a.label { at: floor(41 * u + 0.5), floor(13 * u + 0.5); anchor: center; align: center; size: 12.5 * u; weight: 700; width: 74 * u; lines: 1; color: if(touch.hover, onmint, ink); family: "Space Grotesk" }
        on press touch { emit click(a.index) }
    }

    //  One wallpaper in the gallery: its picture in rounded corners, a ring when it is the one in use.
    component WpThumb(t: record, pick: event) {
        size: 96 * u, 54 * u
        zone box touch { from: 0, 0; size: 96 * u, 54 * u; corner: 8 * u; cursor: pointer }
        //  The pictures are cropped to 16:9 in a cache by the logic, so every tile is the same.
        group {
            clip inset 0 box { from: 0, 0; size: 96 * u, 54 * u; corner: 8 * u }
            image t.thumb { at: 0, 0; size: 96 * u, 54 * u }
        box { from: 0, 0; size: 96 * u, 54 * u; color: ink; opacity: 14% * touch.hover }
        }
        box { from: 0, 0; size: 96 * u, 54 * u; corner: 8 * u; stroke: 2 * u; color: mint; opacity: if(wp_sel == t.index, 100%, 0) }
        on press touch { emit pick(t.index) }
    }

    //  A weather icon, drawn from shapes (there is no icon font): `kind` 0 clear · 1 partly cloudy · 2 cloud ·
    //  3 fog · 4 rain · 5 snow · 6 storm. The cloud is `cloud`; the sun, rain, snow and bolt are `sun`.
    component WxIcon(kind: number, cloud: color = ink, sun: color = mint) {
        size: 26 * u, 20 * u
        //  clear
        group {
            show: kind == 0
            ellipse { at: 13 * u, 10 * u; radius: 4.6 * u; color: sun }
            repeat i in 0..8 {
                group {
                    pivot: 13 * u, 10 * u
                    rotate: i * 45deg
                    box { at: 13 * u, 10 * u - 7.8 * u; size: 1.7 * u, 3 * u; corner: 0.8 * u; color: sun }
                }
            }
        }
        //  partly cloudy: a small sun behind a cloud
        group {
            show: kind == 1
            ellipse { at: 8.5 * u, 7.5 * u; radius: 3.4 * u; color: sun }
            repeat i in 0..8 {
                group {
                    pivot: 8.5 * u, 7.5 * u
                    rotate: i * 45deg
                    box { at: 8.5 * u, 7.5 * u - 5.9 * u; size: 1.4 * u, 2.2 * u; corner: 0.7 * u; color: sun }
                }
            }
            ellipse { at: 10 * u, 13 * u; radius: 3.6 * u; color: cloud }
            ellipse { at: 15 * u, 11.5 * u; radius: 4.6 * u; color: cloud }
            ellipse { at: 19 * u, 13.5 * u; radius: 3.2 * u; color: cloud }
            box { at: 14.5 * u, 15.5 * u; size: 13 * u, 4.5 * u; corner: 2.2 * u; color: cloud }
        }
        //  the cloud alone, and the cloud that rain, snow and storm hang from
        group {
            show: kind == 2 or kind == 4 or kind == 5 or kind == 6
            let cy0 = if(kind == 2, 10, 7.5) * u
            ellipse { at: 9 * u, cy0 + 1 * u; radius: 4 * u; color: cloud }
            ellipse { at: 14 * u, cy0 - 1.5 * u; radius: 5 * u; color: cloud }
            ellipse { at: 18.5 * u, cy0 + 1 * u; radius: 3.6 * u; color: cloud }
            box { at: 13.5 * u, cy0 + 3 * u; size: 14 * u, 5 * u; corner: 2.5 * u; color: cloud }
        }
        //  fog
        group {
            show: kind == 3
            box { at: 13 * u, 5.5 * u; size: 17 * u, 2 * u; corner: 1 * u; color: cloud }
            box { at: 13 * u, 10 * u; size: 13 * u, 2 * u; corner: 1 * u; color: cloud }
            box { at: 13 * u, 14.5 * u; size: 17 * u, 2 * u; corner: 1 * u; color: cloud }
        }
        //  rain
        group {
            show: kind == 4
            line { from: 8.5 * u, 14 * u; to: 7 * u, 18 * u; width: 1.5 * u; color: sun }
            line { from: 13.5 * u, 14 * u; to: 12 * u, 18 * u; width: 1.5 * u; color: sun }
            line { from: 18.5 * u, 14 * u; to: 17 * u, 18 * u; width: 1.5 * u; color: sun }
        }
        //  snow
        group {
            show: kind == 5
            ellipse { at: 8 * u, 15.5 * u; radius: 1.3 * u; color: sun }
            ellipse { at: 13 * u, 17.5 * u; radius: 1.3 * u; color: sun }
            ellipse { at: 18 * u, 15.5 * u; radius: 1.3 * u; color: sun }
        }
        //  storm: a bolt
        path {
            show: kind == 6
            at: floor(13 * u + 0.5), floor(11 * u + 0.5)
            color: sun
            move 1.5 * u, 0
            line -2.5 * u, 4.5 * u
            line 0.2 * u, 4.5 * u
            line -1.2 * u, 4 * u
            line 4 * u, -5.5 * u
            line 0.5 * u, -5.5 * u
            close
        }
    }

    //  One day of the forecast: its name, its icon, its high and its low. Today is in the accent.
    component WxDay(d: record) {
        size: floor(42 * u + 0.5), floor(50 * u + 0.5)
        text d.label { at: floor(21 * u + 0.5), floor(7 * u + 0.5); anchor: center; align: center; size: 9.5 * u; weight: 700; width: 40 * u; lines: 1; color: if(d.today, mint, faint); family: "Space Grotesk" }
        column icon_col { at: 8 * u, 15 * u; WxIcon(d.kind, if(d.today, mint, ink), mint) }
        text d.hi { at: floor(12 * u + 0.5), floor(42 * u + 0.5); anchor: center; align: center; size: 10 * u; weight: 700; width: 20 * u; lines: 1; color: ink; family: "Space Grotesk" }
        text d.lo { at: floor(31 * u + 0.5), floor(42 * u + 0.5); anchor: center; align: center; size: 10 * u; width: 20 * u; lines: 1; color: faint; family: "Space Grotesk" }
    }

    //  One notification in the history: its title and when it came, and under them the app and what it said.
    //  54 px tall, so a stack of them sits on whole pixels. A cross shows on hover, in place of the time.
    component NtHistRow(h: record, del: event) {
        size: 276 * u, 54
        zone box touch { from: 0, 0; size: 276 * u, 54; corner: 12 * u }
        box { from: 0, 0; size: 276 * u, 54; corner: 12 * u; color: ink; opacity: 5% + 6% * touch.hover }
        text h.title { at: floor(12 * u + 0.5), 17; anchor: left center; size: 12.5 * u; weight: 700; width: 200 * u; lines: 1; color: ink; family: "Space Grotesk" }
        text h.sub { at: floor(12 * u + 0.5), 37; anchor: left center; size: 10.5 * u; width: 244 * u; lines: 1; color: faint; family: "Space Grotesk" }
        text h.when { at: floor(264 * u + 0.5), 17; anchor: right center; size: 10 * u; color: faint; opacity: 100% - 100% * touch.hover; family: "Space Grotesk" }
        ellipse { at: floor(258 * u + 0.5), 17; radius: 9 * u; color: if(del_z.hover, alert, ink); opacity: (if(del_z.hover, 80%, 12%)) * touch.hover }
        line { from: floor(258 * u + 0.5) - 3.2 * u, 17 - 3.2 * u; to: floor(258 * u + 0.5) + 3.2 * u, 17 + 3.2 * u; width: 1.4 * u; color: ink; opacity: 70% * touch.hover }
        line { from: floor(258 * u + 0.5) + 3.2 * u, 17 - 3.2 * u; to: floor(258 * u + 0.5) - 3.2 * u, 17 + 3.2 * u; width: 1.4 * u; color: ink; opacity: 70% * touch.hover }
        zone box del_z { at: floor(258 * u + 0.5), 17; size: 24 * u, 24 * u; corner: 12 * u; cursor: pointer }
        on press del_z { emit del(h.index) }
    }

    let cx = 450
    let bar.w = 450 * u
    let bar.h = 40 * u
    let bar.y = 8 + bar.h / 2
    let bar.rad = 14 * u                 // the bar's corner when shut: the same as the plates', not a full pill
    //  The middle of the gap between the title and the clock, 126 from the right edge.
    //  The bar's buttons hug the clock: it is measured, and the controls button sits just left of it, the
    //  settings button left of that, and the player's buttons left of those. Nothing is left in between
    //  whatever the time reads, and the window title gets what is left.
    //  The right-hand column is the day over the am/pm; both are about the same width now, so it is as wide as
    //  the wider and the minutes are set tight against it.
    let clock.col = max(caw.width, cdw.width)
    let clock.left = cx + bar.w / 2 - 20 * u - clock.col - 3 - cmw.width + 3 - chw.width
    let ctl.x = clock.left - 20 * u
    let set.x = ctl.x - 24 * u
    let mc = set.x - 44 * u
    //  Where the window title starts, and how far it may reach (it gives way to the player's buttons).
    let win.x = cx - bar.w / 2 + 116 * u
    let win.w = mix(set.x - 22 * u, mc - 32 * u, mshow) - win.x
    let room = 10 * u

    //  The music only moves the bar: it fades out as the panel opens (gone by a third of
    //  the way), so an open panel sits still.
    let pv = pulse * (1 - min(1, drop * 3))
    let pop = pv * 6 * u           // how far the bar swells on the beat
    //  The bounce on `dc`/`dk` (below) is free to swing past 1 on the way open - that
    //  overshoot is the spring showing - but a size can't go negative, so anything
    //  that scales a width or height reads the clamped version instead: it shrinks
    //  cleanly to nothing on the way closed rather than through it.
    let dc0 = max(0, dc)
    let dk0 = max(0, dk)
    let dm0 = max(0, dm)
    let do0 = max(0, do)
    let ds0 = max(0, ds)
    let expand0 = max(0, expand)
    //  Both panels fill in their width quickly and then keep growing taller - so a
    //  plain `min(1, …)` on the width leaves it capped flat once that's done, and
    //  the bounce on the way to fully open (or the little one closing overshoots
    //  into) only ever shows up as a change in height. The `max(0, … - 1) * 0.6`
    //  term only wakes up past that cap, so the width bulges a little with the
    //  same overshoot instead of sitting there rigid while the height does all
    //  the springing.
    let card.w = bar.w * (min(1, dc0 * 3) + max(0, dc0 - 1) * 0.6)
    let card.h = 373 * u * dc0        // 303, and 70 more for the weather strip
    //  The controls drawer: as wide as its plates and their margins need (288 + 2 x 12), coming
    //  out of the bar. It starts narrow and wide-open in height last, and widens to its place.
    //  It reaches up into the bar so the two can melt; `dk.hh` is how far down it goes.
    let dk.w = (120 + 192 * (min(1, dk0 * 1.6) + max(0, dk0 - 1) * 0.6)) * u
    //  The plates stack from a shared cursor, each one naming where the one
    //  before it ended, so a plate that changes height (the media one, which
    //  shrinks to a sliver with nothing playing) pushes what is under it
    //  instead of leaving a gap or a pile-up. Unscaled: `u` is applied where
    //  each offset is finally used. Wi-Fi and Bluetooth are tiles side by side
    //  now, at the very top, so they cost one row's height between them.
    let tiles_top  = 8
    let tiles_h    = 72
    let tiles_bot  = tiles_top + tiles_h
    //  Do Not Disturb and Caffeine: a second row of tiles, the same size as the first.
    let tiles2_top = tiles_bot + 4
    let tiles2_bot = tiles2_top + tiles_h
    let bright_top = tiles2_bot + 4
    let bright_bot = bright_top + 64
    let vol_top    = bright_bot + 4
    let vol_bot    = vol_top + 64
    //  The player's plate is alone in its own panel now, at the top of it.
    let media_top  = 8
    let media_h    = mix(40, 96, media_open)
    let media_bot  = media_top + media_h
    //  Either tile can grow past the stack into its own window - as tall as its
    //  list actually is (one open row taller, while one is), up to a ceiling
    //  where the list itself starts scrolling instead of the window still
    //  growing to fit it.
    let wifi_rows_h = max(1, wifi_nets.count) * 34 - 4 + if(wifi_open_row >= 0, 44, 0)
    let bt_rows_h   = max(1, bt_devices.count) * 34 - 4 + if(bt_open_row >= 0, 44, 0)
    let list_max    = 220
    //  The notifications window has a Do Not Disturb row and its timer chips above its list (84 more), and a
    //  shorter list. Its rows are 54 px with 6 between, whole pixels.
    let nt_rows_h = (max(1, nt_hist.count) * 60 - 6) / u
    let list_view_h = min(if(showing_sub == btview, bt_rows_h, if(showing_sub == notifview, nt_rows_h, wifi_rows_h)), if(showing_sub == notifview, 150, list_max))
    let sub_bot = tiles_top + 54 + if(showing_sub == notifview, 84, 0) + list_view_h + 16
    //  The output list drops over what is under the volume row; with more than a couple of outputs
    //  it reaches past the drawer, so the drawer grows to hold it while it is open.
    let dd.rows = clamp(outlist.count, 1, 6)
    let dd.extra = max(0, dd.rows * 30 - 28) * max(0, dd)
    let content_bot = mix(vol_bot + dd.extra, sub_bot, expand0)
    let dk.hh = bar.h / 2 + (content_bot + 16) * u * dk0 + max(0, sag)
    //  The player's panel: the same drawer as the controls, centred on the bar, and as tall as
    //  its one plate.
    //  The calendar's drawer: exactly as wide as the bar, starting at the bar's top edge so its
    //  straight sides carry on from the bar's own (a drawer starting lower leaves a notch on each
    //  side that a blend would fill outward, as a bulge), and as tall as the bar plus its content.
    let dc.w = bar.w * min(1, dc0 * 3)
    let dc.hh = bar.h + card.h + max(0, sag)
    //  The volume / notification drawer: 340 wide, as tall as its plate.
    //  The notification's plate is as tall as what is on it: the app line, the title (one line or more),
    //  the body if there is one (as many lines as it needs), and a row of buttons if it brought any,
    //  with 12 of air around. Never shorter than its icon tile. Each text measures itself once wrapped.
    let nt_th = max(24, ntt.height / u)
    let nt_bh = ntb.height / u
    let nt_content = if(nt_body_on, 39 + nt_th + nt_bh, 35 + nt_th)
    let nt_h = max(68, nt_content + if(nt_acts.count > 0, 34, 0) + 12)
    follow osd_h = if(osd_kind == note, nt_h, 64)
    //  The settings panel: 620 wide. A header (36), then the sidebar and the page side by side (352).
    let ss.w = (120 + 500 * (min(1, ds0 * 1.6) + max(0, ds0 - 1) * 0.6)) * u
    let ss.hh = bar.h / 2 + (8 + 36 + 8 + 352 + 16) * u * ds0 + max(0, sag)
    let os.w = (120 + 220 * (min(1, do0 * 1.6) + max(0, do0 - 1) * 0.6)) * u
    let os.hh = bar.h / 2 + (8 + osd_h + 16) * u * do0 + max(0, sag)
    let dm.w = (120 + 192 * (min(1, dm0 * 1.6) + max(0, dm0 - 1) * 0.6)) * u
    //  Under the player's plate, the running windows and then the tray apps (Synoptik's "Running
    //  tasks" and "Background apps"), each a header and rows, scrolling past a few.
    let task_rows = min(max(1, tasks.count), 6)
    let tasks_top = media_bot + 8
    let tasks_list = tasks_top
    let tasks_bot = tasks_list + task_rows * 40 - 4
    let tray_rows = min(trays.count, 3)
    let tray_top = tasks_bot + 8
    let tray_list = tray_top + 26
    let panel_bot = if(trays.count > 0, tray_list + tray_rows * 40 - 4, tasks_bot)
    let dm.hh = bar.h / 2 + (panel_bot + 16) * u * dm0 + max(0, sag)
    let mdx = cx
    //  Where the contents hang from: the panel's old middle, so they keep their
    //  place when the panel grows to make room for the player.
    let cy = bar.y + 26 * u + 125 * u * drop
    //  The controls' content hangs from here: 127 above `cy`, so the volume plate starts 12 under the
    //  bar and the drawer is only as tall as its two plates and their margins.
    let ck = cy - 127 * u

    //  The whole bar, glass and all, is one group so the wave can bend it as one thing.
    group {
        shader: wave, pv, clamp(ring, 0, 1), (mc - (cx - bar.w / 2)) / bar.w, 0, 2.6 * u * (1 - min(1, drop * 2)), bar.w, 0, 0
        // ── the liquid ───────────────────────────────────────────────
        body {
            color: tint
            glass: 100%
            lens: false
            rim: 10% + 14% * pv
            shine: pointer
            shadow: 0, 1 + 6 * drop + 3 * pv, 6 + 14 * drop + 8 * pv, 8% + 16% * drop + 8% * pv, deep
            //  The bar is only the bar: it swells a little on the beat and nothing else. Every panel,
            //  the calendar included, is a drawer of its own that drops from it, below.
            box shell { at: cx, bar.y - bar.h / 2 + (bar.h + pop) / 2; size: bar.w + pv * 10 * u, bar.h + pop; corner: bar.rad }
            //  The drawer is a second shape in the same glass. `blend` melts it into the bar, so where the
            //  narrow drawer meets the wide bar there is a liquid neck, not a corner. It is only there
            //  while it has size: a zero-size shape would leave a stray shadow behind.
            box drawer { at: cx, bar.y + dk.hh / 2; size: dk.w, dk.hh; corner: 26 * u; blend: 16 * u * min(1, dk0 * 4); show: dk0 > 0.004 }
            box cdrawer { at: cx, bar.y - bar.h / 2 + dc.hh / 2; size: dc.w, dc.hh; corner: 26 * u; show: dc0 > 0.004 }
            box sdrawer { at: cx, bar.y + ss.hh / 2; size: ss.w, ss.hh; corner: 26 * u; blend: 16 * u * min(1, ds0 * 4); show: ds0 > 0.004 }
            box odrawer { at: cx, bar.y + os.hh / 2; size: os.w, os.hh; corner: 26 * u; blend: 16 * u * min(1, do0 * 4); show: do0 > 0.004 }
            box mdrawer { at: mdx, bar.y + dm.hh / 2; size: dm.w, dm.hh; corner: 26 * u; blend: 16 * u * min(1, dm0 * 4); show: dm0 > 0.004 }
        }

        // ── the bar ──────────────────────────────────────────────────
        repeat i in 1..6 {
            //  The others sit 15 apart; the ones beside the active one slide away from it by `room / 2`
            //  each, so the widening one has space, and the row flows as the amounts change.
            let wx = cx - bar.w / 2 + 26 * u + (i - 1) * 15 * u + room * 0.5 * clamp(i - pill, -1, 1)
            //  One shape per workspace that morphs: a dot, a taller capsule if it has windows, and a
            //  wide mint pill while it is the active one.
            zone box ws.hit.$i { at: wx, bar.y; size: 15 * u, bar.h; cursor: pointer }
            on press ws.hit.$i { emit go(i) }
        }

        //  What is in front: the app in small type above, the title under it, cut
        //  with an ellipsis where the clock starts.
        //  The title gives up room to the controls while something plays.

        //  The whole title area is a button: it opens the controls panel. Declared before
        //  the little player controls below, which sit over it and win where they overlap.
        //  It is only as wide as the text it holds (never past `win.w`, never thinner than a
        //  fingertip), not the whole gap up to the clock. Unseen copies, with no width limit,
        //  only to know how wide the app name and the title really are.
        text win.class { at: floor(win.x + 0.5), floor(bar.y - 6.5 * u + 0.5); anchor: left center; size: 17 * u; weight: 600; lines: 1; measure: clsw; opacity: 0; family: "Space Grotesk" }
        text win.title { at: floor(win.x + 0.5), floor(bar.y + 8.75 * u + 0.5); anchor: left center; size: 13.5 * u; weight: 500; lines: 1; measure: titw; opacity: 0; family: "Space Grotesk" }
        let win.hw = clamp(max(clsw.width, titw.width) + 12 * u, 48 * u, win.w)
        zone box win_hit { at: win.x - 6 * u + win.hw / 2, bar.y; size: win.hw, bar.h; cursor: pointer }
        on press win_hit { panel = if(panel == player, none, player) }

        // ── the player, small, in the bar ────────────────────────────
        //  While there is a player, playing or paused; they fade in as the title gives them room.
        group {
            opacity: mshow
            //  Centred in the gap between where the title ends and where the clock
            //  starts (`mc`), and small: 17 between centres.
            let by = bar.y
            zone box bp.prev { at: mc - 17 * u, by; size: 17 * u, bar.h; cursor: pointer }
            zone box bp.play { at: mc, by; size: 17 * u, bar.h; cursor: pointer }
            zone box bp.next { at: mc + 17 * u, by; size: 17 * u, bar.h; cursor: pointer }
            on press bp.prev { emit mcmd(0) }
            on press bp.play { emit mcmd(1) }
            on press bp.next { emit mcmd(2) }
        }

        zone box set_hit { at: set.x, bar.y; size: 24 * u, bar.h; cursor: pointer }
        on press set_hit { panel = if(panel == settings, none, settings) }

        zone box ctl_hit { at: ctl.x, bar.y; size: 26 * u, bar.h; cursor: pointer }
        on press ctl_hit { panel = if(panel == controls, none, controls) }

        //  The calendar's button is the clock and a little around it: from just left of the measured clock to
        //  near the bar's right edge, so it stops where the controls button begins.
        zone box bar_hit { at: (clock.left - 4 * u + cx + bar.w / 2 - 6 * u) / 2, bar.y; size: (cx + bar.w / 2 - 6 * u) - (clock.left - 4 * u), bar.h; cursor: pointer }
        on press bar_hit { panel = if(panel == calendar, none, calendar) }
        //  Right-click closes whatever is open. It also matters for a reason that
        //  has nothing to do with the calendar: pleamar treats an unclaimed right
        //  click, anywhere in a scene that never uses the right button at all, as
        //  an emergency exit and quits outright - which is exactly what looked
        //  like "everything crashes." Claiming it here, once, disarms that for
        //  the whole scene.
        on press right bar_hit { panel = none }
    }

    //  The bar's icons are drawn here, on top of the bar and outside its wave-shader group, with a soft dark
    //  halo (a group `glow` in the palette's dark colour) so they hold up on a light wallpaper, as the text
    //  does. An effect cannot sit inside another effect's group, hence outside. The click areas and rules
    //  stay in the bar group above.
    group {
        glow: 2.4 * u, 45%, deep
        repeat i in 1..6 {
            let wxs = cx - bar.w / 2 + 26 * u + (i - 1) * 15 * u + room * 0.5 * clamp(i - pill, -1, 1)
            box ws.dot.$i { at: wxs, bar.y; size: (6 + 14 * ws.act.$i) * u, (6 + 4 * ws.tall.$i * (1 - ws.act.$i)) * u; corner: 3 * u
                            color: mix(ink, mint, ws.act.$i); opacity: mix(28% + 62% * ws.tall.$i, 100%, ws.act.$i) }
        }
        //  The player's buttons.
        group {
            opacity: mshow
            box { at: mc - 20.5 * u, bar.y; size: 1.4 * u, 7 * u; corner: 0.7 * u; color: ink; opacity: 65% + 35% * bp.prev.hover }
            path { at: mc - 17 * u, bar.y; color: ink; opacity: 65% + 35% * bp.prev.hover; move 3 * u, -3.5 * u; line -2.5 * u, 0; line 3 * u, 3.5 * u; close }
            //  Pause while it plays, play while it is paused.
            box { at: mc - 3 * u, bar.y; size: 2.6 * u, 9 * u; corner: 1 * u; color: ink; opacity: 85% + 15% * bp.play.hover; show: media.playing }
            box { at: mc + 3 * u, bar.y; size: 2.6 * u, 9 * u; corner: 1 * u; color: ink; opacity: 85% + 15% * bp.play.hover; show: media.playing }
            path { at: mc, bar.y; color: ink; opacity: 85% + 15% * bp.play.hover; show: not media.playing; move -3 * u, -4.5 * u; line 7 * u, 0; line -3 * u, 4.5 * u; close }
            path { at: mc + 17 * u, bar.y; color: ink; opacity: 65% + 35% * bp.next.hover; move -3 * u, -3.5 * u; line 2.5 * u, 0; line -3 * u, 3.5 * u; close }
            box { at: mc + 20.5 * u, bar.y; size: 1.4 * u, 7 * u; corner: 0.7 * u; color: ink; opacity: 65% + 35% * bp.next.hover }
        }
        //  The settings button: a gear, between the player's buttons and the controls button.
        group {
            opacity: 65% + 35% * max(set_hit.hover, clamp(ds, 0, 1))
            ellipse { at: set.x, bar.y; radius: 3.6 * u; stroke: 1.7 * u; color: mix(ink, mint, clamp(ds, 0, 1)) }
            repeat i in 0..8 {
                group {
                    pivot: set.x, bar.y
                    rotate: i * 45deg
                    box { at: set.x, bar.y - 6 * u; size: 2 * u, 2.6 * u; corner: 0.7 * u; color: mix(ink, mint, clamp(ds, 0, 1)) }
                }
            }
        }
        //  The controls button, between the settings button and the clock: two sliders.
        group {
            opacity: 65% + 35% * max(ctl_hit.hover, clamp(dk, 0, 1))
            box { at: ctl.x, bar.y - 3.5 * u; size: 13 * u, 1.6 * u; corner: 0.8 * u; color: mix(ink, mint, clamp(dk, 0, 1)) }
            box { at: ctl.x, bar.y + 3.5 * u; size: 13 * u, 1.6 * u; corner: 0.8 * u; color: mix(ink, mint, clamp(dk, 0, 1)) }
            ellipse { at: ctl.x + 2.5 * u, bar.y - 3.5 * u; radius: 2.6 * u; color: mix(ink, mint, clamp(dk, 0, 1)) }
            ellipse { at: ctl.x - 2.5 * u, bar.y + 3.5 * u; radius: 2.6 * u; color: mix(ink, mint, clamp(dk, 0, 1)) }
        }
    }

    //  The bar's text is drawn on top of the bar, outside its wave-shader group: inside it the letters are
    //  resampled by the shader, which blurs them and smears them whenever the music makes the wave move.
    //  The glass and the icons still bend; the words stay sharp.
    //  The clock in the bar is four texts, right-aligned and set against each other from their measured widths:
    //  the hour, oversized; the minutes with their colon, in the accent, the two digits tucked 3 px over each
    //  other (the colon is left clear: overlapped it disappears); and, at the edge, a small column: the day
    //  stacked tight over a dim am/pm, centred on each other.
    text bar_date { at: floor(cx + bar.w / 2 - 20 * u - clock.col / 2 + 0.5), floor(bar.y - 8 + 0.5); anchor: center; size: 11; weight: 700; measure: cdw; color: faint; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text bar_ap { at: floor(cx + bar.w / 2 - 20 * u - clock.col / 2 + 0.5), floor(bar.y + 7 + 0.5); anchor: center; size: 14; weight: 600; measure: caw; color: faint; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text clock_mm { at: floor(cx + bar.w / 2 - 20 * u - clock.col - 3 + 0.5), floor(bar.y + 3 + 0.5); anchor: right center; size: 26; weight: 700; measure: cmw; letter_move: 3 * ((letters - 1 - letter) - if(letter == 0, 1, 0)), 0; color: mint; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text clock_h { at: floor(cx + bar.w / 2 - 20 * u - clock.col - 3 - cmw.width + 3 + 0.5), floor(bar.y + 0.5); anchor: right center; size: 40; weight: 700; measure: chw; color: ink; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text win.class { at: floor(win.x + 0.5), floor(bar.y - 6.5 * u + 0.5); anchor: left center; size: 17 * u; weight: 600; width: win.w; lines: 1; color: faint; opacity: 55%; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text win.title { at: floor(win.x + 0.5), floor(bar.y + 8.75 * u + 0.5); anchor: left center; size: 13.5 * u; weight: 500; width: win.w; lines: 1; color: ink; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }

    // ── the panel ────────────────────────────────────────────────
    group {
        //  The calendar's content is clipped to the calendar's shape.
        clip inset 2 box { at: cx, bar.y - bar.h / 2 + dc.hh / 2; size: dc.w, dc.hh; corner: 26 * u }
        //  ── the calendar panel ──
        //  Three plates like the volume and media ones, each 8% white and 12 from the panel's
        //  edges: the time and date, the chosen day with its reminders, and the month. The two
        //  on the left and the one on the right share a top and a bottom.
        group {
            opacity: f1
            move: 0, (1 - f1) * 12 * u + floor(68 * u + 0.5)
            box { at: cx - 130 * u, cy - 76 * u; size: 166 * u, 72 * u; corner: 14 * u; color: ink; opacity: veil }
            box { at: cx - 130 * u, cy + 43 * u; size: 166 * u, 154 * u; corner: 14 * u; color: ink; opacity: veil }
            //  The clock card: big numerals, the am/pm tucked small at their top-right in the accent, and under
            //  them, indented a little, the date as weekday | month day with the pipe in the accent.
            text clock_hm { at: floor(cx - 201 * u + 0.5), floor(cy - 88 * u + 0.5); anchor: left center; size: 56; weight: 700; measure: hmw; color: ink; family: "Space Grotesk" }
            //  The am/pm is a small pill in the accent, vertically centred on the numerals and set against their right side.
            box { at: floor(cx - 201 * u + hmw.width + 8 * u + 17 + 0.5), floor(cy - 88 * u + 0.5); size: 34, 20; corner: 10; color: mint; opacity: 20% }
            text clock_ap { at: floor(cx - 201 * u + hmw.width + 8 * u + 17 + 0.5), floor(cy - 88 * u + 0.5); anchor: center; align: center; size: 12; weight: 700; width: 34; lines: 1; color: mint; family: "Space Grotesk" }
            //  The date is right-aligned to the card's inner edge (cx - 59): the month and day first, then the pipe
            //  and the weekday laid out leftwards from it, each placed from the measured width of the one after.
            text date_md { at: floor(cx - 59 * u + 0.5), floor(cy - 55 * u + 0.5); anchor: right center; size: 12; weight: 700; measure: mdw; color: ink; family: "Space Grotesk" }
            text "|" { at: floor(cx - 59 * u - mdw.width - 8 * u + 0.5), floor(cy - 55 * u + 0.5); anchor: right center; size: 14; weight: 300; color: mint; family: "Space Grotesk" }
            text date_wd { at: floor(cx - 59 * u - mdw.width - 20 * u + 0.5), floor(cy - 55 * u + 0.5); anchor: right center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text cal.sel_title { at: floor(cx - 201 * u + 0.5), floor(cy - 14 * u + 0.5); anchor: left center; size: 13 * u; weight: 600; width: 142 * u; lines: 1; color: ink; family: "Space Grotesk" }
            text cal.sel_sub { at: floor(cx - 201 * u + 0.5), floor(cy + 1 * u + 0.5); anchor: left center; size: 10.5 * u; width: 142 * u; lines: 1; color: faint; opacity: 75%; family: "Space Grotesk" }
            column cal_list {
                at: floor(cx - 207 * u + 0.5), floor(cy + 14 * u + 0.5)
                view: 154 * u, 106 * u
                gap: 4
                for e in cal_events { CalRow(e, tick: cal_check, gone: cal_delete) }
            }
            text "Add one below" { at: floor(cx - 201 * u + 0.5), floor(cy + 28 * u + 0.5); anchor: left center; size: 11.5 * u; color: faint; opacity: 55%; family: "Space Grotesk"; show: cal_events.count < 1 }
        }
        group {
            opacity: f4
            move: 0, (1 - f4) * 12 * u
            let cal.cw = 33 * u
            let cal.ch = 27 * u
            let cal.gx = cx - 13 * u                 // the middle of the first column
            let cal.gy = cy - 42 * u                 // the middle of the first row
            group {
                move: 0, floor(68 * u + 0.5)        // the month sits 68 lower, under the weather strip (a whole number of pixels)
            box { at: cx + 86 * u, cy + 4 * u; size: 254 * u, 232 * u; corner: 14 * u; color: ink; opacity: veil }
            //  Month, and the three buttons that move it.
            text cal.month { at: floor(cx - 30 * u + 0.5), floor(cy - 92 * u + 0.5); anchor: left center; size: 15 * u; weight: 600; color: ink; family: "Space Grotesk" }
            path { at: cx + 134 * u, cy - 92 * u; color: ink; stroke: 1.6 * u; opacity: 55% + 45% * cal_prev_btn.hover; move 2.5 * u, -5 * u; line -2.5 * u, 0; line 2.5 * u, 5 * u }
            box { at: cx + 163 * u, cy - 92 * u; size: 40 * u, 20 * u; corner: 10 * u; color: ink; opacity: 8% + 10% * cal_today_btn.hover }
            text "Today" { at: floor(cx + 163 * u + 0.5), floor(cy - 92 * u + 0.5); anchor: center; size: 10 * u; weight: 600; color: ink; opacity: 80%; family: "Space Grotesk" }
            path { at: cx + 192 * u, cy - 92 * u; color: ink; stroke: 1.6 * u; opacity: 55% + 45% * cal_next_btn.hover; move -2.5 * u, -5 * u; line 2.5 * u, 0; line -2.5 * u, 5 * u }
            zone box cal_prev_btn { at: cx + 134 * u, cy - 92 * u; size: 26 * u, 26 * u; corner: 13 * u; cursor: pointer }
            zone box cal_today_btn { at: cx + 163 * u, cy - 92 * u; size: 42 * u, 24 * u; corner: 12 * u; cursor: pointer }
            zone box cal_next_btn { at: cx + 192 * u, cy - 92 * u; size: 26 * u, 26 * u; corner: 13 * u; cursor: pointer }
            on press cal_prev_btn { emit cal_prev }
            on press cal_today_btn { emit cal_today }
            on press cal_next_btn { emit cal_next }
            //  The weekdays.
            repeat w in 1..8 {
                text cal.wd.$w { at: floor(cal.gx + (w - 1) * cal.cw + 0.5), floor(cy - 66 * u + 0.5); anchor: center; size: 9.5 * u; weight: 600; color: faint; opacity: 65%; family: "Space Grotesk" }
            }
            //  The days.
            repeat k in 0..42 {
                let dx = cal.gx + mod(k, 7) * cal.cw
                let dy = cal.gy + floor(k / 7) * cal.ch
                prop cal.pick.$k = 0 ~lively
                follow cal.pick.$k = if(cal.sel == k, 1, 0)
                group {
                    opacity: 38% + 62% * if(cal.in.$k, 1, 0)
                    pivot: dx, dy
                    scale: 1 + 0.08 * cal.pick.$k
                    ellipse { at: dx, dy; radius: 12 * u; color: ink; opacity: 9% * cal_cell.$k.hover * (1 - cal.pick.$k) }
                    ellipse { at: dx, dy; radius: 12 * u; color: mint; opacity: cal.pick.$k * 100% }
                    group {
                        glow: 5 * u, 60%, mint
                        ellipse { at: dx, dy; radius: 13 * u; stroke: 1.5 * u; color: mint; show: cal.today.$k }
                    }
                    text number(cal.day.$k, 0) { at: floor(dx + 0.5), floor(dy - 0.5 * u + 0.5); anchor: center; size: 11.5 * u; weight: 500 + 200 * if(cal.today.$k, 1, 0)
                                                 color: mix(ink, onmint, cal.pick.$k); family: "Space Grotesk" }
                    ellipse { at: dx, dy + 8.5 * u; radius: 1.5 * u; color: mix(mint, onmint, cal.pick.$k); opacity: if(cal.n.$k > 0, 100%, 0) }
                }
                zone box cal_cell.$k { at: dx, dy; size: 30 * u, 26 * u; corner: 13 * u; cursor: pointer }
                on press cal_cell.$k { emit cal_pick(k) }
            }
            }
            //  The weather, at the very top: what it is now, on the left, and the week, on the right.
            box { at: cx, cy - 82 * u; size: 426 * u, 60 * u; corner: 14 * u; color: ink; opacity: veil }
            text "Loading weather…" { at: floor(cx + 0.5), floor(cy - 82 * u + 0.5); anchor: center; align: center; size: 11.5 * u; width: 300 * u; lines: 1; color: faint; family: "Space Grotesk"; show: not wx_ok }
            group {
                show: wx_ok
                group {
                    pivot: cx - 190 * u, cy - 90 * u
                    scale: 1.5
                    column wx_now { at: cx - 203 * u, cy - 100 * u; WxIcon(wx_kind) }
                }
                text wx_temp { at: floor(cx - 160 * u + 0.5), floor(cy - 92 * u + 0.5); anchor: left center; size: 19 * u; weight: 700; width: 70 * u; lines: 1; color: ink; family: "Space Grotesk" }
                text wx_desc { at: floor(cx - 160 * u + 0.5), floor(cy - 73 * u + 0.5); anchor: left center; size: 10 * u; width: 100 * u; lines: 1; color: faint; family: "Space Grotesk" }
                box { at: cx - 96 * u, cy - 82 * u; size: 1 * u, 40 * u; color: ink; opacity: 12% }
                row wx_row {
                    at: floor(cx - 90 * u + 0.5), floor(cy - 107 * u + 0.5)
                    gap: 1
                    for d in wx_days { WxDay(d) }
                }
            }

            //  Writing one: the field, and a button. Enter saves it as well.
            box { at: cx, cy + 213 * u; size: 426 * u, 34 * u; corner: 14 * u; color: ink; opacity: veil }
            ellipse { at: cx - 201 * u, cy + 213 * u; radius: 4 * u; color: mint; opacity: 85% }
            //  An input's `at` is not its middle: it is lifted 6.3 so its text sits on the row's centre.
            input cal_new { at: floor(cx - 189 * u + 0.5), floor(cy + 206.7 * u + 0.5); width: 330 * u; size: 13 * u; color: ink; family: "Space Grotesk"
                            placeholder: "New reminder: 3:30pm Call mom"; selection: mintlo }
            box { at: cx + 178 * u, cy + 213 * u; size: 46 * u, 24 * u; corner: 12 * u; color: mint; opacity: 80% + 20% * cal_add_btn.hover }
            text "Add" { at: floor(cx + 178 * u + 0.5), floor(cy + 213 * u + 0.5); anchor: center; size: 11 * u; weight: 700; color: onmint; family: "Space Grotesk" }
            zone box cal_add_btn { at: cx + 178 * u, cy + 213 * u; size: 48 * u, 28 * u; corner: 14 * u; cursor: pointer }
            on press cal_add_btn { emit cal_add }
        }
        //  Opening the calendar puts the cursor in the field and the grid back on today.
        on change panel while panel == calendar { focus cal_new; emit cal_open }
    }
    //  The controls' content is clipped to the drawer's shape.
    group {
        clip inset 2 box { at: cx, bar.y + dk.hh / 2; size: dk.w, dk.hh; corner: 26 * u }
        //  A plate is a veil, not more glass: glass does not go on glass.
        group {
            opacity: f5 * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f5) * 12 * u
            let vol_cy = ck + (vol_top + 32) * u
            box { at: cx, vol_cy; size: 288 * u, 64 * u; corner: 14 * u; color: ink; opacity: veil }
            //  ── the slider ──
            //  The track runs from `sl.x0` for `sl.w`; the pointer is turned into a volume
            //  against those two numbers, so they are written once.
            let sl.x0 = cx - 96 * u
            let sl.w = 222 * u
            let sy = vol_cy + 14 * u
            let th = (16 + 3 * vol_hit.hover) * u          // the track thickens under the pointer
            //  A speaker on the left that says how loud it is: two waves that come and go
            //  with the level, or a slash when it is silenced.
            path { at: cx - 124 * u, sy; color: ink; opacity: 70% + 30% * mute_hit.hover; move 0, -3 * u; line 3.5 * u, -3 * u; line 8 * u, -7 * u; line 8 * u, 7 * u; line 3.5 * u, 3 * u; line 0, 3 * u; close }
            path { at: cx - 124 * u, sy; stroke: 1.5 * u; color: ink; opacity: if(audio.muted, 0, 25% + 75% * clamp(volume_level * 12, 0, 1)); move 11 * u, -3 * u; curve 11 * u, 3 * u via 14 * u, 0 }
            path { at: cx - 124 * u, sy; stroke: 1.5 * u; color: ink; opacity: if(audio.muted, 0, 20% + 80% * clamp((volume_level - 0.35) * 4, 0, 1)); move 14 * u, -6.5 * u; curve 14 * u, 6.5 * u via 20 * u, 0 }
            path { at: cx - 124 * u, sy; stroke: 1.6 * u; color: alert; opacity: if(audio.muted, 100%, 0); move 11 * u, -5 * u; line 20 * u, 5 * u }
            //  The track is a sunken pill with its own thin light on the inside.
            body {
                color: deep
                rim: 9%
                box { at: sl.x0 + sl.w / 2, sy; size: sl.w, th; corner: th / 2 }
            }
            //  The fill is a gradient laid along the whole track, so the more there is, the
            //  brighter its end. It glows a little.
            group {
                glow: 7 * u, 50%, mint
                show: not audio.muted
                body {
                    gradient: sl.x0, 0 to sl.x0 + sl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: sl.x0, sy - th / 2; size: max(0.1, sl.w * volume_level), th; corner: th / 2 }
                }
            }
            body {
                color: off
                rim: 12%
                show: audio.muted
                box { from: sl.x0, sy - th / 2; size: max(0.1, sl.w * volume_level), th; corner: th / 2 }
            }
            //  The zone that takes the click: the whole track and a little more each side
            //  and above and below, so it is easy to hit; on the press and all through a drag
            //  it turns where the pointer is into a volume.
            zone box vol_hit { at: sl.x0 + sl.w / 2, sy; size: sl.w + 28 * u, 34 * u; cursor: pointer }
            on press vol_hit { emit setvol(clamp((pointer.x - sl.x0) / sl.w, 0, 1)) }
            on drag vol_hit { emit setvol(clamp((pointer.x - sl.x0) / sl.w, 0, 1)) }
            //  The speaker is a mute button. Declared after the track's zone, which reaches
            //  a little way under it, so the icon wins there.
            zone box mute_hit { at: cx - 114 * u, sy; size: 26 * u, 32 * u; cursor: pointer }
            on press mute_hit { emit mute }
            //  The row above the track: which output, and how loud.
            //  Name and chevron are one button, right-aligned next to the percentage: the
            //  name ends where the chevron starts, and the zone is measured from the name.
            //  Unseen copy with no width limit, only to know how wide the name really is.
            text outname { at: floor(cx + 66 * u + 0.5), floor(vol_cy - 14 * u + 0.5); anchor: right center; size: 14 * u; lines: 1; measure: outw; opacity: 0; family: "Space Grotesk" }
            text outname { at: floor(cx + 66 * u + 0.5), floor(vol_cy - 14 * u + 0.5); anchor: right center; align: right; size: 14 * u; width: 130 * u; lines: 1; color: faint; opacity: 65% + 35% * out_hit.hover; family: "Space Grotesk" }
            //  The percentage is centred between the end of the track (cx + 74) and the plate's edge (cx + 158).
            text number(audio.volume * 100, 0, "%") { at: floor(cx + 128 * u + 0.5), floor(vol_cy - 14 * u + 0.5); anchor: right center; size: 16 * u; weight: 600; color: ink; family: "Space Grotesk"; show: not audio.muted }
            text "Muted" { at: floor(cx + 128 * u + 0.5), floor(vol_cy - 14 * u + 0.5); anchor: right center; size: 16 * u; weight: 600; color: faint; family: "Space Grotesk"; show: audio.muted }
            //  The output name is a button: it opens the list of outputs.
            path { at: cx + 76 * u, vol_cy - 14 * u; stroke: 1.4 * u; color: ink; opacity: 55% + 35% * out_hit.hover; move -3.5 * u, -2 * u; line 0, 2 * u; line 3.5 * u, -2 * u }
            let out.w = min(outw.width, 130 * u) + 30 * u
            zone box out_hit { at: cx + 86 * u - out.w / 2, vol_cy - 14 * u; size: out.w, 30 * u; cursor: pointer }
            on press out_hit { toggle dd_open }
            text "Volume" { at: floor(cx - 128 * u + 0.5), floor(vol_cy - 14 * u + 0.5); anchor: left center; size: 14 * u; color: faint; family: "Space Grotesk" }
        }

        //  Brightness: the volume slider's shape again, in miniature — a sun
        //  that opens its rays as the backlight climbs. Dimmed, not hidden,
        //  on a machine with no backlight to move.
        group {
            opacity: f6 * mix(0.45, 1, brightness.present) * mix(0.45, 1, bright_avail) * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f6) * 12 * u
            let bcy = ck + (bright_top + 32) * u
            box { at: cx, bcy; size: 288 * u, 64 * u; corner: 14 * u; color: ink; opacity: veil }
            let bsl.x0 = cx - 96 * u
            let bsl.w = 222 * u
            let bsy = bcy + 14 * u
            let bth = (16 + 3 * bright_hit.hover) * u
            ellipse { at: cx - 119 * u, bsy; radius: 3 * u; color: ink; opacity: 70% + 30% * bright_hit.hover }
            path { at: cx - 119 * u, bsy; stroke: 1.3 * u; color: ink; opacity: 40% + 60% * bright_level; move -3.8 * u, -3.8 * u; line -(5.5 + 1.5 * bright_level) * u, -(5.5 + 1.5 * bright_level) * u }
            path { at: cx - 119 * u, bsy; stroke: 1.3 * u; color: ink; opacity: 40% + 60% * bright_level; move 3.8 * u, -3.8 * u; line (5.5 + 1.5 * bright_level) * u, -(5.5 + 1.5 * bright_level) * u }
            path { at: cx - 119 * u, bsy; stroke: 1.3 * u; color: ink; opacity: 40% + 60% * bright_level; move -3.8 * u, 3.8 * u; line -(5.5 + 1.5 * bright_level) * u, (5.5 + 1.5 * bright_level) * u }
            path { at: cx - 119 * u, bsy; stroke: 1.3 * u; color: ink; opacity: 40% + 60% * bright_level; move 3.8 * u, 3.8 * u; line (5.5 + 1.5 * bright_level) * u, (5.5 + 1.5 * bright_level) * u }
            body {
                color: deep
                rim: 9%
                box { at: bsl.x0 + bsl.w / 2, bsy; size: bsl.w, bth; corner: bth / 2 }
            }
            group {
                glow: 7 * u, 50%, mint
                body {
                    gradient: bsl.x0, 0 to bsl.x0 + bsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: bsl.x0, bsy - bth / 2; size: max(0.1, bsl.w * bright_level), bth; corner: bth / 2 }
                }
            }
            zone box bright_hit { at: bsl.x0 + bsl.w / 2, bsy; size: bsl.w + 28 * u, 34 * u; cursor: pointer; active: brightness.present and bright_avail }
            on press bright_hit { emit setbright(clamp((pointer.x - bsl.x0) / bsl.w, 0, 1)) }
            on drag bright_hit { emit setbright(clamp((pointer.x - bsl.x0) / bsl.w, 0, 1)) }
            text number(bright_level * 100, 0, "%") { at: floor(cx + 128 * u + 0.5), floor(bcy - 14 * u + 0.5); anchor: right center; size: 16 * u; weight: 600; color: ink; family: "Space Grotesk"; show: brightness.present and bright_avail }
            text "No backlight" { at: floor(cx + 128 * u + 0.5), floor(bcy - 14 * u + 0.5); anchor: right center; size: 13 * u; color: faint; family: "Space Grotesk"; show: not brightness.present }
            text "brightnessctl missing" { at: floor(cx + 128 * u + 0.5), floor(bcy - 14 * u + 0.5); anchor: right center; size: 12 * u; color: faint; family: "Space Grotesk"; show: brightness.present and not bright_avail }
            text "Brightness" { at: floor(cx - 128 * u + 0.5), floor(bcy - 14 * u + 0.5); anchor: left center; size: 14 * u; color: faint; family: "Space Grotesk" }
        }

        //  Wi-Fi and Bluetooth: two narrow tiles side by side, each just its
        //  name, a signal, and the toggle for its radio. Tapping the rest of
        //  the tile - the toggle has its own small zone, declared after so it
        //  wins there - grows it into its own window, below.
        group {
            opacity: f2 * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f2) * 12 * u
            let tile_cy = ck + (tiles_top + tiles_h / 2) * u
            let wtx = cx - 74 * u
            let btx = cx + 74 * u

            box { at: wtx, tile_cy; size: 140 * u, tiles_h * u; corner: 14 * u; color: ink; opacity: veil }
            box { at: wtx - 53 * u, tile_cy - 14 * u; size: 3 * u, 6 * u;  corner: 1.5 * u; color: ink; opacity: if(net.wifi, 45% + 55% * clamp(net.strength / 0.3, 0, 1), 30%) }
            box { at: wtx - 48 * u, tile_cy - 16 * u; size: 3 * u, 10 * u; corner: 1.5 * u; color: ink; opacity: if(net.wifi, 45% + 55% * clamp(net.strength / 0.65, 0, 1), 30%) }
            box { at: wtx - 43 * u, tile_cy - 18 * u; size: 3 * u, 14 * u; corner: 1.5 * u; color: ink; opacity: if(net.wifi, 45% + 55% * clamp(net.strength / 1.0, 0, 1), 30%) }
            text "Wi-Fi" { at: floor(wtx - 58 * u + 0.5), floor(tile_cy + 4 * u + 0.5); anchor: left center; size: 13 * u; color: ink; family: "Space Grotesk" }
            text net.name { at: floor(wtx - 58 * u + 0.5), floor(tile_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; width: 74 * u; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: net.online }
            text "Disconnected" { at: floor(wtx - 58 * u + 0.5), floor(tile_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: net.wifi and not net.online }
            text "Off" { at: floor(wtx - 58 * u + 0.5), floor(tile_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: not net.wifi }
            body {
                color: mix(off, mint, clamp(wifi_on, 0, 1))
                box { at: wtx + 46 * u, tile_cy - 18 * u; size: 26 * u, 14 * u; corner: 7 * u }
            }
            ellipse { at: wtx + 40 * u + wifi_on * 12 * u, tile_cy - 18 * u; radius: 5.5 * u; color: ink }
            zone box wifi_tile_hit { at: wtx, tile_cy; size: 140 * u, tiles_h * u; cursor: pointer }
            on press wifi_tile_hit { panel_sub = if(panel_sub == netview, none, netview) }
            zone box wifi_toggle_hit { at: wtx + 46 * u, tile_cy - 18 * u; size: 34 * u, 22 * u; cursor: pointer }
            on press wifi_toggle_hit { emit togglewifi(not net.wifi) }

            box { at: btx, tile_cy; size: 140 * u, tiles_h * u; corner: 14 * u; color: ink; opacity: veil }
            box { at: btx - 48 * u, tile_cy - 18 * u; size: 2.4 * u, 16 * u; corner: 1.2 * u; color: ink; opacity: 45% + 55% * bt_on }
            path { at: btx - 48 * u, tile_cy - 18 * u; stroke: 1.5 * u; color: ink; opacity: 45% + 55% * bt_on; move -4 * u, -4 * u; line 4 * u, 4 * u }
            path { at: btx - 48 * u, tile_cy - 18 * u; stroke: 1.5 * u; color: ink; opacity: 45% + 55% * bt_on; move 4 * u, -4 * u; line -4 * u, 4 * u }
            text "Bluetooth" { at: floor(btx - 58 * u + 0.5), floor(tile_cy + 4 * u + 0.5); anchor: left center; size: 13 * u; color: ink; family: "Space Grotesk" }
            text bt_name { at: floor(btx - 58 * u + 0.5), floor(tile_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; width: 74 * u; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: bt_connected }
            text "No device" { at: floor(btx - 58 * u + 0.5), floor(tile_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: bt.powered and not bt_connected }
            text "Off" { at: floor(btx - 58 * u + 0.5), floor(tile_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: not bt.powered }
            body {
                color: mix(off, mint, clamp(bt_on, 0, 1))
                box { at: btx + 46 * u, tile_cy - 18 * u; size: 26 * u, 14 * u; corner: 7 * u }
            }
            ellipse { at: btx + 40 * u + bt_on * 12 * u, tile_cy - 18 * u; radius: 5.5 * u; color: ink }
            zone box bt_tile_hit { at: btx, tile_cy; size: 140 * u, tiles_h * u; cursor: pointer }
            on press bt_tile_hit { panel_sub = if(panel_sub == btview, none, btview) }
            zone box bt_toggle_hit { at: btx + 46 * u, tile_cy - 18 * u; size: 34 * u, 22 * u; cursor: pointer }
            on press bt_toggle_hit { emit togglebt(not bt.powered) }

            //  Notifications (Do Not Disturb, with its own window) and Caffeine (the whole tile is its toggle), underneath.
            let tile2_cy = ck + (tiles2_top + tiles_h / 2) * u

            box { at: wtx, tile2_cy; size: 140 * u, tiles_h * u; corner: 14 * u; color: ink; opacity: veil + 6% * dnd_hit.hover }
            //  A bell: dome, rim and clapper, struck through while it is on.
            group {
                pivot: wtx - 48 * u, tile2_cy - 18 * u
                rotate: dnd_wobble * 14deg
                //  Solid parts, faded as one group: partial opacity per part shows the overlaps.
                opacity: 45% + 55% * dnd_pill
                ellipse { at: wtx - 48 * u, tile2_cy - 19 * u; radius: 5.5 * u; color: ink }
                box { at: wtx - 48 * u, tile2_cy - 14.5 * u; size: 14 * u, 3 * u; corner: 1.5 * u; color: ink }
                ellipse { at: wtx - 48 * u, tile2_cy - 11 * u; radius: 1.6 * u; color: ink }
            }
            path { at: wtx - 48 * u, tile2_cy - 18 * u; stroke: 1.8 * u; color: alert; opacity: dnd_pill; move -8 * u, -8 * u; line 8 * u, 8 * u }
            text "Notifications" { at: floor(wtx - 58 * u + 0.5), floor(tile2_cy + 4 * u + 0.5); anchor: left center; size: 13 * u; width: 116 * u; lines: 1; color: ink; family: "Space Grotesk" }
            text nt_tile_sub { at: floor(wtx - 58 * u + 0.5), floor(tile2_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; width: 116 * u; lines: 1; color: if(dnd_on, mint, faint); family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(dnd_pill, 0, 1))
                box { at: wtx + 46 * u, tile2_cy - 18 * u; size: 26 * u, 14 * u; corner: 7 * u }
            }
            ellipse { at: wtx + 40 * u + dnd_pill * 12 * u, tile2_cy - 18 * u; radius: 5.5 * u; color: ink }
            zone box dnd_hit { at: wtx, tile2_cy; size: 140 * u, tiles_h * u; cursor: pointer }
            on press dnd_hit { panel_sub = if(panel_sub == notifview, none, notifview) }
            zone box dnd_toggle_hit { at: wtx + 46 * u, tile2_cy - 18 * u; size: 34 * u, 22 * u; cursor: pointer }
            on press dnd_toggle_hit { emit togglednd }

            //  Caffeine: a cup that steams while the machine is being kept awake. Dimmed on a
            //  machine with no hypridle, which is what the card would be stopping.
            group {
                opacity: mix(0.45, 1, caf_avail)
                box { at: btx, tile2_cy; size: 140 * u, tiles_h * u; corner: 14 * u; color: ink; opacity: veil + 6% * caf_hit.hover * caf_avail }
                group {
                    opacity: 45% + 55% * caf_pill
                    box { at: btx - 49 * u, tile2_cy - 16 * u; size: 12 * u, 10 * u; corner: 3 * u; color: ink }
                    ellipse { at: btx - 41.5 * u, tile2_cy - 16 * u; radius: 3 * u; stroke: 1.5 * u; color: ink }
                }
                repeat i in 0..3 {
                    let sp = fract(time * 0.7 + i * 0.33)
                    box { at: btx - 52 * u + i * 3.5 * u, tile2_cy - 24 * u - sp * 6 * u; size: 1.4 * u, 5 * u; corner: 0.7 * u; color: ink; opacity: caf_pill * 55% * sin(sp * 180) }
                }
                text "Caffeine" { at: floor(btx - 58 * u + 0.5), floor(tile2_cy + 4 * u + 0.5); anchor: left center; size: 13 * u; color: ink; family: "Space Grotesk" }
                text "Awake" { at: floor(btx - 58 * u + 0.5), floor(tile2_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: mint; opacity: 90%; family: "Space Grotesk"; show: caf_on }
                text "Off" { at: floor(btx - 58 * u + 0.5), floor(tile2_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: not caf_on and caf_avail }
                text "No hypridle" { at: floor(btx - 58 * u + 0.5), floor(tile2_cy + 19 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: not caf_avail }
                body {
                    color: mix(off, mint, clamp(caf_pill, 0, 1))
                    box { at: btx + 46 * u, tile2_cy - 18 * u; size: 26 * u, 14 * u; corner: 7 * u }
                }
                ellipse { at: btx + 40 * u + caf_pill * 12 * u, tile2_cy - 18 * u; radius: 5.5 * u; color: ink }
                zone box caf_hit { at: btx, tile2_cy; size: 140 * u, tiles_h * u; cursor: pointer; active: caf_avail }
                on press caf_hit { emit togglecaf }
            }
        }

        //  The Wi-Fi tile's own window: the networks in range, strongest first.
        //  A known or open one connects on a tap; a secured one not seen before
        //  asks for its password first.
        group {
            show: showing_sub == netview
            opacity: expand0
            let ex_top = ck + tiles_top * u
            let ex_cy = ex_top + 22 * u
            path { at: cx - 124 * u, ex_cy; color: ink; stroke: 1.6 * u; opacity: 55% + 45% * wifi_back.hover; move 4 * u, -6 * u; line -4 * u, 0; line 4 * u, 6 * u }
            zone box wifi_back { at: cx - 124 * u, ex_cy; size: 30 * u, 30 * u; cursor: pointer }
            on press wifi_back { panel_sub = none }
            text "WI-FI" { at: floor(cx - 102 * u + 0.5), floor(ex_cy + 0.5); anchor: left center; size: 15 * u; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: cx + 112 * u, ex_cy; size: 52 * u, 24 * u; corner: 12 * u; color: if(wifi_scanning, mint, ink); opacity: if(wifi_scanning, 22%, 8% + 10% * wifi_scan_hit.hover) }
            text "Scan" { at: floor(cx + 112 * u + 0.5), floor(ex_cy + 0.5); anchor: center; size: 11 * u; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk"; show: not wifi_scanning }
            //  While it runs: a ring turning where the word was, and the list says so.
            group {
                show: wifi_scanning
                pivot: cx + 112 * u, ex_cy
                rotate: time * 420deg
                arc { at: cx + 112 * u, ex_cy; radius: 6 * u; span: 260deg; width: 1.8 * u; color: mint }
            }
            zone box wifi_scan_hit { at: cx + 112 * u, ex_cy; size: 54 * u, 26 * u; corner: 13 * u; cursor: pointer }
            on press wifi_scan_hit { emit wifi_scan }
            box { at: cx, ex_top + 44 * u; size: 276 * u, 1 * u; color: ink; opacity: 8% }
            column wifi_list_col ~quick {
                at: floor(cx - 138 * u + 0.5), floor(ex_top + 54 * u + 0.5)
                view: 276 * u, list_view_h * u
                gap: 5
                for n in wifi_nets { WifiRow(n, pick: wifi_pick, forget: wifi_forget, joingo: wifi_join_go) }
            }
            text "No networks in range" { at: floor(cx + 0.5), floor(ex_top + 54 * u + 15 * u + 0.5); anchor: center; size: 12 * u; color: faint; family: "Space Grotesk"; show: wifi_nets.count < 1 and not wifi_scanning }
            text "Scanning…" { at: floor(cx + 0.5), floor(ex_top + 54 * u + 15 * u + 0.5); anchor: center; size: 12 * u; color: mint; family: "Space Grotesk"; show: wifi_nets.count < 1 and wifi_scanning }
        }

        //  The Bluetooth tile's own window: paired and nearby devices, connected first.
        group {
            show: showing_sub == btview
            opacity: expand0
            let ex2_top = ck + tiles_top * u
            let ex2_cy = ex2_top + 22 * u
            path { at: cx - 124 * u, ex2_cy; color: ink; stroke: 1.6 * u; opacity: 55% + 45% * bt_back.hover; move 4 * u, -6 * u; line -4 * u, 0; line 4 * u, 6 * u }
            zone box bt_back { at: cx - 124 * u, ex2_cy; size: 30 * u, 30 * u; cursor: pointer }
            on press bt_back { panel_sub = none }
            text "BLUETOOTH" { at: floor(cx - 102 * u + 0.5), floor(ex2_cy + 0.5); anchor: left center; size: 15 * u; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: cx + 112 * u, ex2_cy; size: 52 * u, 24 * u; corner: 12 * u; color: if(bt_scanning, mint, ink); opacity: if(bt_scanning, 22%, 8% + 10% * bt_scan_hit.hover) }
            text "Scan" { at: floor(cx + 112 * u + 0.5), floor(ex2_cy + 0.5); anchor: center; size: 11 * u; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk"; show: not bt_scanning }
            //  While it runs: a ring turning where the word was, and the list says so.
            group {
                show: bt_scanning
                pivot: cx + 112 * u, ex2_cy
                rotate: time * 420deg
                arc { at: cx + 112 * u, ex2_cy; radius: 6 * u; span: 260deg; width: 1.8 * u; color: mint }
            }
            zone box bt_scan_hit { at: cx + 112 * u, ex2_cy; size: 54 * u, 26 * u; corner: 13 * u; cursor: pointer }
            on press bt_scan_hit { emit bt_scan }
            box { at: cx, ex2_top + 44 * u; size: 276 * u, 1 * u; color: ink; opacity: 8% }
            column bt_list_col ~quick {
                at: floor(cx - 138 * u + 0.5), floor(ex2_top + 54 * u + 0.5)
                view: 276 * u, list_view_h * u
                gap: 5
                for d in bt_devices { BtRow(d, pick: bt_pick, forget: bt_forget) }
            }
            text "No devices found" { at: floor(cx + 0.5), floor(ex2_top + 54 * u + 15 * u + 0.5); anchor: center; size: 12 * u; color: faint; family: "Space Grotesk"; show: bt_devices.count < 1 and not bt_scanning }
            text "Scanning…" { at: floor(cx + 0.5), floor(ex2_top + 54 * u + 15 * u + 0.5); anchor: center; size: 12 * u; color: mint; family: "Space Grotesk"; show: bt_devices.count < 1 and bt_scanning }
        }

        //  The notifications window: Do Not Disturb (a toggle, and timer chips that count down), and under them
        //  the history of what came in, newest first. Clear empties it; a row's cross removes that one.
        group {
            show: showing_sub == notifview
            opacity: expand0
            let nx_top = ck + tiles_top * u
            let nx_cy = nx_top + 22 * u
            path { at: cx - 124 * u, nx_cy; color: ink; stroke: 1.6 * u; opacity: 55% + 45% * nt_back.hover; move 4 * u, -6 * u; line -4 * u, 0; line 4 * u, 6 * u }
            zone box nt_back { at: cx - 124 * u, nx_cy; size: 30 * u, 30 * u; cursor: pointer }
            on press nt_back { panel_sub = none }
            text "NOTIFICATIONS" { at: floor(cx - 102 * u + 0.5), floor(nx_cy + 0.5); anchor: left center; size: 15 * u; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: cx + 112 * u, nx_cy; size: 52 * u, 24 * u; corner: 12 * u; color: ink; opacity: 8% + 10% * nt_clear_hit.hover }
            text "Clear" { at: floor(cx + 112 * u + 0.5), floor(nx_cy + 0.5); anchor: center; size: 11 * u; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box nt_clear_hit { at: cx + 112 * u, nx_cy; size: 54 * u, 26 * u; corner: 13 * u; cursor: pointer }
            on press nt_clear_hit { emit nt_clear }
            box { at: cx, nx_top + 44 * u; size: 276 * u, 1 * u; color: ink; opacity: 8% }

            //  Do Not Disturb: its toggle, and what state it is in.
            box { at: cx, nx_top + 66 * u; size: 276 * u, 34 * u; corner: 12 * u; color: ink; opacity: veil }
            text "Do Not Disturb" { at: floor(cx - 128 * u + 0.5), floor(nx_top + 60 * u + 0.5); anchor: left center; size: 12.5 * u; weight: 700; color: ink; family: "Space Grotesk" }
            text dnd_left { at: floor(cx - 128 * u + 0.5), floor(nx_top + 74 * u + 0.5); anchor: left center; size: 10 * u; width: 200 * u; lines: 1; color: if(dnd_on, mint, faint); family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(dnd_pill, 0, 1))
                box { at: cx + 118 * u, nx_top + 66 * u; size: 30 * u, 16 * u; corner: 8 * u }
            }
            ellipse { at: cx + 111 * u + dnd_pill * 14 * u, nx_top + 66 * u; radius: 6.2 * u; color: ink }
            zone box nt_dnd_toggle { at: cx + 118 * u, nx_top + 66 * u; size: 40 * u, 26 * u; corner: 13 * u; cursor: pointer }
            on press nt_dnd_toggle { emit togglednd }

            //  The timer: pressing a chip silences for that long; pressing the lit one again cancels it.
            repeat i in 0..4 {
                let chx = cx - 107 * u + i * 70 * u
                box { at: chx, nx_top + 100 * u; size: 62 * u, 26 * u; corner: 13 * u; color: if(dnd_len == pick(i, 15, 30, 60, 120), mint, ink); opacity: if(dnd_len == pick(i, 15, 30, 60, 120), 24%, 8% + 10% * dnd_chip.$i.hover) }
                text pick(i, "15 min", "30 min", "1 hour", "2 hours") { at: floor(chx + 0.5), floor(nx_top + 100 * u + 0.5); anchor: center; align: center; size: 11 * u; weight: 600; width: 60 * u; lines: 1; color: if(dnd_len == pick(i, 15, 30, 60, 120), mint, ink); family: "Space Grotesk" }
                zone box dnd_chip.$i { at: chx, nx_top + 100 * u; size: 64 * u, 28 * u; corner: 14 * u; cursor: pointer }
                on press dnd_chip.$i { emit dnd_for(pick(i, 15, 30, 60, 120)) }
            }

            //  The history.
            text "HISTORY" { at: floor(cx - 134 * u + 0.5), floor(nx_top + 126 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; opacity: 80%; family: "Space Grotesk" }
            column nt_hist_col {
                at: floor(cx - 138 * u + 0.5), floor(nx_top + 138 * u + 0.5)
                view: 276 * u, list_view_h * u
                gap: 6
                for h in nt_hist { NtHistRow(h, del: nt_hist_del) }
            }
            text "No notifications yet" { at: floor(cx + 0.5), floor(nx_top + 138 * u + 20 * u + 0.5); anchor: center; size: 12 * u; color: faint; family: "Space Grotesk"; show: nt_hist.count < 1 }
        }

        //  The dropdown: a solid card that drops from the volume row over what is
        //  below it. Declared last so its rows win the press over the slider.
        group {
            opacity: dd
            move: 0, (1 - dd) * -8 * u
            let ddn = clamp(outlist.count, 1, 6)
            let ddh = ddn * 30 * u + 12 * u
            box { at: cx, ck + (vol_top + 32) * u + ddh / 2; size: 288 * u, ddh; corner: 14 * u; color: panel }
            zone box dd_block { at: cx, ck + (vol_top + 32) * u + ddh / 2; size: 288 * u, ddh }
            column dd_list {
                at: floor(cx - 138 * u + 0.5), floor(ck + (vol_top + 32) * u + 6 * u + 0.5)
                gap: 3
                for o in outlist { OutRow(o, pick: pick_out) }
            }
            text "No outputs" { at: floor(cx + 0.5), floor(ck + (vol_top + 32) * u + ddh / 2 + 0.5); anchor: center; size: 12 * u; color: faint; family: "Space Grotesk"; show: outlist.count < 1 }
        }
    }
    //  The player's panel: it hangs from the window title, not from the middle of the bar, in
    //  the same glass as the bar. Its content is clipped to the drawer's shape.
    group {
        clip inset 2 box { at: mdx, bar.y + dm.hh / 2; size: dm.w, dm.hh; corner: 26 * u }
        //  The player. A sliver with nothing playing — a note and a word, the same
        //  shape as the Wi-Fi and Bluetooth rows below it — that grows into the full
        //  card (cover, song, transport, equalizer) the moment something does.
        //  `media_open` is what moves; `media_h`, above, already reads it, so every
        //  plate under this one is already where it should be.
        group {
            opacity: f3
            move: 0, (1 - f3) * 12 * u
            let my = ck + (media_top + media_h / 2) * u
            let ax = mdx - 96 * u                     // the cover's centre
            let ny = my + 26 * u                     // the controls' row
            let px = mdx - 30 * u                     // previous
            let cxp = mdx + 6 * u                     // play
            let nx = mdx + 42 * u                     // next
            let sw = clamp(swap, 0, 1.12)

            //  The plate is exactly the volume plate: the same 8% veil and the same corners.
            box { at: mdx, my; size: 288 * u, media_h * u; corner: 14 * u; color: ink; opacity: veil }

            //  Idle: a note, the way Wi-Fi and Bluetooth say their own name at rest.
            group {
                opacity: 1 - media_open
                //  A note with a flag: solid parts, faded together so the overlaps do not show.
                group {
                    opacity: 70%
                    ellipse { at: mdx - 124 * u + 1.5, my + 5 * u; radius: 4.5 * u; color: ink }
                    box { at: mdx - 118.5 * u - 1.5, my - 1 * u; size: 2 * u, 18 * u; corner: 1 * u; color: ink }
                    path { at: mdx - 118.5 * u - 1.5, my - 10 * u; stroke: 2 * u; color: ink; move 0, 0.5 * u; curve 6 * u, 8 * u via 6.5 * u, 2.5 * u }
                }
                text "Media" { at: floor(mdx - 96 * u + 0.5), floor(my - 8 * u + 0.5); anchor: left center; size: 14 * u; color: ink; family: "Space Grotesk" }
                text "Nothing playing" { at: floor(mdx - 96 * u + 0.5), floor(my + 8 * u + 0.5); anchor: left center; size: 12 * u; color: faint; family: "Space Grotesk" }
            }

            //  Playing, or paused with something loaded: the full card.
            group {
                opacity: media_open

                //  No cover yet: a tile with a note on it.
                group {
                    show: not art_on
                    body {
                        gradient: ax - 36 * u, my - 36 * u to ax + 36 * u, my + 36 * u, off, deep
                        rim: 14%
                        box { at: ax, my; size: 72 * u, 72 * u; corner: 15 * u }
                    }
                    ellipse { at: ax - 6 * u, my + 11 * u; radius: 6.5 * u; color: ink; opacity: 75% }
                    box { at: ax + 1.5 * u, my - 4 * u; size: 3 * u, 30 * u; corner: 1.5 * u; color: ink; opacity: 75% }
                    path { at: ax, my; stroke: 3 * u; color: ink; opacity: 75%; move 3 * u, -19 * u; curve 15 * u, -6 * u via 13 * u, -17 * u }
                }

                //  The cover, in a rounded tile.
                group {
                    glow: 12 * u, 60%
                    saturation: 0.3 + 0.7 * playf
                    pivot: ax, my
                    scale: (0.88 + 0.12 * playf) * (0.7 + 0.3 * sw)
                    rotate: (1 - sw) * -12deg
                    opacity: art_on
                    group {
                        clip inset 0 box { at: ax, my; size: 72 * u, 72 * u; corner: 15 * u }
                        image art { at: ax - 36 * u, my - 36 * u; size: 72 * u, 72 * u }
                    }
                }

                text media.title { at: floor(mdx - 50 * u + 0.5), floor(my - 24 * u + 0.5); anchor: left center; size: 14.5 * u; weight: 700; width: 186 * u; lines: 1; color: ink; family: "Space Grotesk" }
                text media.artist { at: floor(mdx - 50 * u + 0.5), floor(my - 6 * u + 0.5); anchor: left center; size: 12 * u; width: 186 * u; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk" }

                //  previous
                box { at: px - 6 * u, ny; size: 2.2 * u, 12 * u; corner: 1.1 * u; color: ink; opacity: 75% + 25% * mp.prev.hover }
                path { at: px, ny; color: ink; opacity: 75% + 25% * mp.prev.hover; move 5 * u, -6 * u; line -4.5 * u, 0; line 5 * u, 6 * u; close }
                //  play / pause: a white disc with the mark cut out of it
                ellipse { at: cxp, ny; radius: (15 + 1.5 * mp.play.hover) * u; color: ink; opacity: 95% }
                path { at: cxp, ny; color: onmint; show: not media.playing; move -4 * u, -8 * u; line 8 * u, 0; line -4 * u, 8 * u; close }
                box { at: cxp - 4 * u, ny; size: 4 * u, 14 * u; corner: 1.5 * u; color: onmint; show: media.playing }
                box { at: cxp + 4 * u, ny; size: 4 * u, 14 * u; corner: 1.5 * u; color: onmint; show: media.playing }
                //  next
                path { at: nx, ny; color: ink; opacity: 75% + 25% * mp.next.hover; move -5 * u, -6 * u; line 4.5 * u, 0; line -5 * u, 6 * u; close }
                box { at: nx + 6 * u, ny; size: 2.2 * u, 12 * u; corner: 1.1 * u; color: ink; opacity: 75% + 25% * mp.next.hover }

                zone box mp.prev { at: px, ny; size: 30 * u, 34 * u; cursor: pointer }
                zone box mp.play { at: cxp, ny; size: 38 * u, 38 * u; cursor: pointer }
                zone box mp.next { at: nx, ny; size: 30 * u, 34 * u; cursor: pointer }
                on press mp.prev { emit mcmd(0) }
                on press mp.play { emit mcmd(1) }
                on press mp.next { emit mcmd(2) }

                //  The equalizer: six rounded bars to the right of the controls, standing on the
                //  same line as the bottom of the cover. They only show while it plays.
                repeat i in 0..6 {
                    let bx = mdx + 74 * u + i * 12 * u
                    let bh = (3.5 + 31 * spec.s.$i) * u
                    box { at: bx, my + 36 * u - bh / 2; size: 7 * u, bh; corner: 3.5 * u; color: mix(mint, ink, spec.s.$i)
                          opacity: playf * (55% + 45% * spec.s.$i) }
                }
            }

            //  A new song throws sparks off the cover.
            particles { at: ax, my; count: 36; life: 0.5s .. 1.0s; speed: 70 .. 170; direction: 0deg; spread: 360deg; gravity: 0, 40; drag: 1.2; size: 3.5, 1; colors: mint, ink; shape: spark; burst: trackchange }
        }

        //  ── the running windows ──
        group {
            opacity: f3
            move: 0, (1 - f3) * 12 * u
            text "No active windows" { at: floor(mdx + 0.5), floor(ck + tasks_list * u + 16 * u + 0.5); anchor: center; size: 12 * u; color: faint; family: "Space Grotesk"; show: tasks.count < 1 }
            column task_col {
                at: floor(mdx - 144 * u + 0.5), floor(ck + tasks_list * u + 0.5)
                view: 288 * u, (task_rows * 40 - 4) * u
                gap: 4 * u
                for w in tasks { TaskRow(w, focus: task_focus, kill: task_close) }
            }
            //  The apps that only live in the tray: no window to list, so they get their own section.
            group {
                show: trays.count > 0
                text "BACKGROUND APPS" { at: floor(mdx - 138 * u + 0.5), floor(ck + tray_top * u + 11 * u + 0.5); anchor: left center; size: 13.5 * u; weight: 700; color: ink; family: "Space Grotesk" }
                column tray_col {
                    at: floor(mdx - 144 * u + 0.5), floor(ck + tray_list * u + 0.5)
                    view: 288 * u, (max(1, tray_rows) * 40 - 4) * u
                    gap: 4 * u
                    for a in trays { TrayRow(a, click: tray_click) }
                }
            }
        }

    }
    //  The volume and notification drawer's content, clipped to its shape. Both sit on one plate
    //  (the same 8% veil as the others), 12 in from the drawer's edge; `osd_kind` picks which is drawn.
    group {
        clip inset 2 box { at: cx, bar.y + os.hh / 2; size: os.w, os.hh; corner: 26 * u }
        opacity: fo
        move: 0, (1 - fo) * 12 * u
        let oy = ck + (8 + osd_h / 2) * u                 // the plate's middle
        let ot = ck + 8 * u                               // and its top
        box { at: cx, oy; size: 316 * u, osd_h * u; corner: 14 * u; color: ink; opacity: veil }
        //  A press on the plate takes the drawer down (a notification is dismissed with it). Declared
        //  first, so the cross and the buttons above it win where they overlap.
        zone box os_hit { at: cx, oy; size: 316 * u, osd_h * u; corner: 14 * u; cursor: pointer }
        on press os_hit while osd_kind == vol { panel = none }
        on press os_hit while osd_kind == note { emit nt_close }

        // ── the volume ──
        group {
            opacity: okv
            show: okv > 0.01
            let vy = oy
            let vtx = cx - 128 * u                        // the face's tile
            box { at: vtx, vy; size: 44 * u, 44 * u; corner: 12 * u; color: ink; opacity: 6% }
            //  The same little face as the slider had in Synoptik: two eyes, and a mouth that opens
            //  with the level and flattens when muted. It bobs a little.
            group {
                move: 0, -1.5 * u * (0.5 + 0.5 * sin(time * 200))
                box { at: vtx - 6 * u, vy - 5 * u; size: 5 * u, if(audio.muted, 2, 5) * u; corner: 2 * u; color: if(audio.muted, faint, mint) }
                box { at: vtx + 6 * u, vy - 5 * u; size: 5 * u, if(audio.muted, 2, 5) * u; corner: 2 * u; color: if(audio.muted, faint, mint) }
                box { at: vtx, vy + 6 * u; size: if(audio.muted, 11, 7 + volume_level * 12) * u, if(audio.muted, 2, 5 + volume_level * 5) * u; corner: 2.5 * u; color: if(audio.muted, faint, mint) }
            }
            //  The level is a wave: it ripples as far as the volume goes, and the rest of the track is
            //  a flat, faint line. A tall white pill marks the end.
            let tr0 = cx - 96 * u
            let trw = 170 * u
            let span = trw * volume_level
            //  All 48 pieces of the wave are spread over the level's own length, so a short one is drawn as
            //  smoothly as a long one (spread over the whole track, only a handful would fall inside it).
            let seg = max(span, 1) / 48
            //  The wave is always the same number of S-curves (two and a half), spread over however
            //  long the level is: at 100% they are long and lazy, and as the volume drops the whole
            //  thing is squeezed toward the left, the curves getting tighter and steeper. `wf` is
            //  the ripple's frequency, in degrees a pixel (sin takes degrees), for the length it has to fit. It fades to flat over a tenth of
            //  its length at each end, so it always meets the flat line and the pill.
            let wf = 360 * 2.5 / max(span, 1)
            let wa = 4.5 * u
            let f0 = max(0.001, span * 0.1)
            let f1 = max(0.001, span * 0.12)
            repeat i in 0..48 {
                let xa = tr0 + i * seg
                let xb = xa + seg
                //  The ripple dies away to nothing at both ends, so wherever it is in its swing the wave
                //  always meets the flat line and the knob on the same centre line.
                let ea = clamp((xa - tr0) / f0, 0, 1) * clamp((tr0 + span - xa) / f1, 0, 1)
                let eb = clamp((xb - tr0) / f0, 0, 1) * clamp((tr0 + span - xb) / f1, 0, 1)
                line { from: xa, vy + wa * ea * sin((xa - tr0) * wf - time * 120); to: xb, vy + wa * eb * sin((xb - tr0) * wf - time * 120); width: 5 * u; color: if(audio.muted, faint, mint); opacity: min(1, span / (3 * u)) }
            }
            line { from: tr0 + span, vy; to: tr0 + trw, vy; width: 5 * u; color: ink; opacity: 12% }
            box { at: clamp(tr0 + span, tr0 + 4 * u, tr0 + trw - 4 * u), vy; size: 6 * u, 26 * u; corner: 3 * u; color: ink }
            text number(audio.volume * 100, 0, "%") { at: floor(cx + 116 * u + 0.5), floor(vy + 0.5); anchor: center; align: center; size: 21 * u; weight: 700; color: ink; family: "Space Grotesk"; show: not audio.muted }
            text "Muted" { at: floor(cx + 116 * u + 0.5), floor(vy + 0.5); anchor: center; align: center; size: 21 * u; weight: 700; color: faint; family: "Space Grotesk"; show: audio.muted }
        }

        // ── a notification ──
        group {
            opacity: okn
            show: okn > 0.01
            let nty = oy                                  // the tile's middle: the plate's, so it sits vertically centred
            let ntx = cx - 128 * u
            let ntl = cx - 96 * u                         // where its words start
            box { at: ntx, nty; size: 44 * u, 44 * u; corner: 12 * u; color: ink; opacity: 6% }
            //  No picture from the app: a bell, in the accent (or red, for something urgent).
            group {
                show: not nt_icon_on
                ellipse { at: ntx, nty - 2 * u; radius: 7 * u; color: if(nt_urgent, alert, mint) }
                box { at: ntx, nty + 5 * u; size: 18 * u, 3.5 * u; corner: 1.75 * u; color: if(nt_urgent, alert, mint) }
                ellipse { at: ntx, nty + 9.5 * u; radius: 2 * u; color: if(nt_urgent, alert, mint) }
            }
            group {
                show: nt_icon_on
                image nt_img { at: ntx - 22 * u, nty - 22 * u; size: 44 * u, 44 * u }
            }
            //  A ring off the tile when it arrives.
            ellipse { at: ntx, nty; radius: (24 + 22 * nt_ring) * u; stroke: 2 * u; color: if(nt_urgent, alert, mint); opacity: 90% * (1 - nt_ring) }
            ellipse { at: ntx + 20 * u, nty - 20 * u; radius: 5 * u; color: alert; opacity: if(nt_urgent, 60% + 40% * sin(time * 300), 0) }

            text nt_app { at: floor(ntl + 0.5), floor(ot + 12 * u + 9 * u + 0.5); anchor: left center; size: 13 * u; weight: 700; width: 190 * u; lines: 1; color: faint; family: "Space Grotesk" }
            text nt_title { at: floor(ntl + 0.5), floor(ot + 35 * u + 0.5); anchor: left top; size: 19 * u; weight: 700; width: 236 * u; lines: 3; measure: ntt; color: ink; family: "Space Grotesk" }
            text nt_body { at: floor(ntl + 0.5), floor(ot + (39 + nt_th) * u + 0.5); anchor: left top; size: 15.5 * u; width: 236 * u; lines: 6; measure: ntb; color: faint; family: "Space Grotesk"; show: nt_body_on }
            //  Its buttons, under the words.
            row nt_row {
                at: floor(ntl + 0.5), floor(ot + (nt_content + 8) * u + 0.5)
                gap: 8
                for a in nt_acts { NtAct(a, click: nt_act) }
            }
            //  Close.
            ellipse { at: cx + 140 * u, ot + 12 * u + 8 * u; radius: 10 * u; color: ink; opacity: 22% * nt_x.hover }
            line { from: cx + 136.5 * u, ot + 12 * u + 4.5 * u; to: cx + 143.5 * u, ot + 12 * u + 11.5 * u; width: 1.4 * u; color: ink; opacity: 55% + 45% * nt_x.hover }
            line { from: cx + 143.5 * u, ot + 12 * u + 4.5 * u; to: cx + 136.5 * u, ot + 12 * u + 11.5 * u; width: 1.4 * u; color: ink; opacity: 55% + 45% * nt_x.hover }
            zone box nt_x { at: cx + 140 * u, ot + 12 * u + 8 * u; size: 24 * u, 24 * u; corner: 12 * u; cursor: pointer }
            on press nt_x { emit nt_close }
        }
    }
    //  ── the settings panel ──
    //  Laid out the way Synoptik's is: a header with an icon badge, the title and a breadcrumb chip; under
    //  it a sidebar of sections next to the page, which is a stack of cards. The wallpaper picker is the
    //  first (and, for now, only) page.
    group {
        clip inset 2 box { at: cx, bar.y + ss.hh / 2; size: ss.w, ss.hh; corner: 26 * u }
        opacity: fs
        move: 0, (1 - fs) * 12 * u
        let hy = ck + 26 * u                              // the header's middle
        let sby = ck + 52 * u                              // the top of the sidebar and the page
        let sl = cx - 298 * u                             // their left edge

        //  Header: a badge with a gear, SETTINGS, the breadcrumb, and a cross.
        box { at: sl + 16 * u, hy; size: 32 * u, 32 * u; corner: 9 * u; color: mint; opacity: 20% }
        group {
            ellipse { at: sl + 16 * u, hy; radius: 6 * u; stroke: 2.2 * u; color: mint }
            ellipse { at: sl + 16 * u, hy; radius: 2 * u; color: mint }
            repeat i in 0..8 {
                group {
                    pivot: sl + 16 * u, hy
                    rotate: i * 45deg
                    box { at: sl + 16 * u, hy - 8.5 * u; size: 3 * u, 4 * u; corner: 1 * u; color: mint }
                }
            }
        }
        text "SETTINGS" { at: floor(sl + 40 * u + 0.5), floor(hy + 0.5); anchor: left center; size: 14 * u; weight: 700; color: ink; family: "Space Grotesk" }
        box { at: sl + 178 * u, hy; size: 132 * u, 22 * u; corner: 11 * u; color: ink; opacity: 6% }
        text "VISUALS" { at: floor(sl + 122 * u + 0.5), floor(hy + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }
        path { at: sl + 168 * u, hy; stroke: 1.3 * u; color: faint; move -2 * u, -3.5 * u; line 2 * u, 0; line -2 * u, 3.5 * u }
        text "Wallpaper" { at: floor(sl + 176 * u + 0.5), floor(hy + 0.5); anchor: left center; size: 9.5 * u; weight: 700; color: mint; family: "Space Grotesk" }
        ellipse { at: cx + 282 * u, hy; radius: 13 * u; color: ink; opacity: 5% + 10% * set_x.hover }
        line { from: cx + 277.5 * u, hy - 4.5 * u; to: cx + 286.5 * u, hy + 4.5 * u; width: 1.5 * u; color: ink; opacity: 60% + 40% * set_x.hover }
        line { from: cx + 286.5 * u, hy - 4.5 * u; to: cx + 277.5 * u, hy + 4.5 * u; width: 1.5 * u; color: ink; opacity: 60% + 40% * set_x.hover }
        zone box set_x { at: cx + 282 * u, hy; size: 28 * u, 28 * u; corner: 14 * u; cursor: pointer }
        on press set_x { panel = none }

        //  Sidebar: the sections, grouped. One so far.
        box { at: sl + 75 * u, sby + 176 * u; size: 150 * u, 352 * u; corner: 14 * u; color: ink; opacity: 4% }
        text "VISUALS" { at: floor(sl + 14 * u + 0.5), floor(sby + 18 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; opacity: 70%; family: "Space Grotesk" }
        box { at: sl + 75 * u, sby + 42 * u; size: 134 * u, 28 * u; corner: 10 * u; color: mint; opacity: 16% }
        group {
            opacity: 100%
            box { at: sl + 24 * u, sby + 42 * u; size: 13 * u, 10 * u; corner: 2 * u; stroke: 1.3 * u; color: mint }
            path { at: sl + 24 * u, sby + 42 * u; color: mint; move -5 * u, 3 * u; line -1.5 * u, -1 * u; line 1 * u, 1.5 * u; line 2.5 * u, -1.5 * u; line 5 * u, 3 * u; close }
            ellipse { at: sl + 27 * u, sby + 39 * u; radius: 1.2 * u; color: mint }
        }
        text "Wallpaper" { at: floor(sl + 40 * u + 0.5), floor(sby + 42 * u + 0.5); anchor: left center; size: 12 * u; weight: 700; color: mint; family: "Space Grotesk" }

        //  The page. Card one: the wallpaper in use, and Random.
        let spx = sl + 158 * u                             // the page's left edge
        box { at: spx + 219 * u, sby + 46 * u; size: 438 * u, 92 * u; corner: 14 * u; color: ink; opacity: veil }
        group {
            clip inset 0 box { at: spx + 77 * u, sby + 46 * u; size: 130 * u, 73 * u; corner: 10 * u }
            image wp_cur { at: spx + 12 * u, sby + 9.5 * u; size: 130 * u, 73 * u }
        }
        text "ACTIVE WALLPAPER" { at: floor(spx + 154 * u + 0.5), floor(sby + 16 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }
        text wp_name { at: floor(spx + 154 * u + 0.5), floor(sby + 36 * u + 0.5); anchor: left center; size: 13 * u; weight: 700; width: 268 * u; lines: 1; color: ink; family: "Space Grotesk" }
        text wp_dirtext { at: floor(spx + 154 * u + 0.5), floor(sby + 53 * u + 0.5); anchor: left center; size: 10 * u; width: 268 * u; lines: 1; color: faint; family: "Space Grotesk" }
        box { at: spx + 195 * u, sby + 74 * u; size: 78 * u, 24 * u; corner: 12 * u; color: ink; opacity: 8% + 10% * wp_rand_hit.hover }
        text "Random" { at: floor(spx + 195 * u + 0.5), floor(sby + 74 * u + 0.5); anchor: center; align: center; size: 10.5 * u; weight: 600; width: 74 * u; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
        zone box wp_rand_hit { at: spx + 195 * u, sby + 74 * u; size: 80 * u, 26 * u; corner: 13 * u; cursor: pointer }
        on press wp_rand_hit { emit wp_random }

        //  Card two: the gallery, twelve at a time, with a pager.
        box { at: spx + 219 * u, sby + 226 * u; size: 438 * u, 252 * u; corner: 14 * u; color: ink; opacity: veil }
        text "WALLPAPER GALLERY" { at: floor(spx + 14 * u + 0.5), floor(sby + 116 * u + 0.5); anchor: left center; size: 9 * u; weight: 700; color: faint; family: "Space Grotesk" }
        text wp_dirtext { at: floor(spx + 424 * u + 0.5), floor(sby + 116 * u + 0.5); anchor: right center; size: 9.5 * u; width: 260 * u; lines: 1; align: right; color: faint; opacity: 70%; family: "Space Grotesk" }
        row wp_grid {
            at: floor(spx + 15 * u + 0.5), floor(sby + 134 * u + 0.5)
            gap: 8 * u
            wrap: 4
            for w in wps { WpThumb(w, pick: wp_pick) }
        }
        path { at: spx + 40 * u, sby + 334 * u; stroke: 1.6 * u; color: ink; opacity: 55% + 45% * wp_prev_hit.hover; move 3 * u, -5 * u; line -3 * u, 0; line 3 * u, 5 * u }
        text wp_pager { at: floor(spx + 219 * u + 0.5), floor(sby + 334 * u + 0.5); anchor: center; align: center; size: 11 * u; weight: 600; width: 100 * u; lines: 1; color: faint; family: "Space Grotesk" }
        path { at: spx + 398 * u, sby + 334 * u; stroke: 1.6 * u; color: ink; opacity: 55% + 45% * wp_next_hit.hover; move -3 * u, -5 * u; line 3 * u, 0; line -3 * u, 5 * u }
        zone box wp_prev_hit { at: spx + 40 * u, sby + 334 * u; size: 30 * u, 28 * u; corner: 14 * u; cursor: pointer }
        zone box wp_next_hit { at: spx + 398 * u, sby + 334 * u; size: 30 * u, 28 * u; corner: 14 * u; cursor: pointer }
        on press wp_prev_hit { emit wp_prev }
        on press wp_next_hit { emit wp_next }
    }
    prop volume_level = 0 ~calm
    follow volume_level = if(audio.muted, 0, audio.volume)
    prop bright_level = 0 ~calm
    follow bright_level = brightness.level
    // ── dismissing the panel ─────────────────────────────────────
    //  Escape closes it. The scene only asks for the keyboard while the panel is
    //  open (see `surface`), so typing goes to your apps the rest of the time.
    on key Escape while dd_open { dd_open = false }
    on key Escape while panel != none and not dd_open { panel = none }
}
