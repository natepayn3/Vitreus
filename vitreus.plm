        path { at: cx + 0.4 * u, cy + 0.3 * u; stroke: 0.7 * sw; color: ink; opacity: (o3) * 0.34; move -0.25 * k + jt * sin(fr * 53 + 23797), -0.01 * k + jt * sin(fr * 58 + 23857); line 0.41 * k + jt * sin(fr * 60 + 23894), -0.01 * k + jt * sin(fr * 65 + 23954); }
