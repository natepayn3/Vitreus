            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: mix(ink, alert, m); opacity: (if(m > 0.5, 1, 0.6 + 0.4 * hv)) * 0.28; move -2.75 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 53 + 5724), -1 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 58 + 5784); line -2.75 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 60 + 5821), -5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 65 + 5881); line -1.5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 67 + 5918), -7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 72 + 5978); line 1.5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 43 + 6015), -7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 48 + 6075); line 2.75 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 50 + 6112), -5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 55 + 6172); line 2.75 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 57 + 6209), -1 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 62 + 6269); line 1.5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 64 + 6306), 2 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 69 + 6366); line -1.5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 71 + 6403), 2 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 45 + 6463); close }
