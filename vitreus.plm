    let mf.fcy = (mf.ft + mf.fb) / 2
    let mf.fh = max(0.1, mf.fb - mf.ft)
    let mf.vis = media_open * mix(if(dm_mode == dmm_player, f3, 0), mf.mine, clamp(mfl, 0, 1))
    //  A held Power button counts its second on this clock, and a recording pulses on it, so they need it too. So does the dashboard's wavy progress bar while a song is playing in it.
    //  The Cyber's terminal readouts (bar_glass.plm) flicker and blink on this clock, so it runs while one of them can be seen: only while a drawer is out (`cy_on`).
    let cy_on = clamp(max(max(dk0, dc0), max(max(ds0, dl0), max(dm0, max(dz0, do0)))) * 50, 0, 1) * cy_k
    //  The player's card (docked in its panel or floating) has the same wavy progress line, so it runs the clock while a song plays in it.
