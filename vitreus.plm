language 0.1

import "palette.plm"

//  Vitreus: a bar of liquid glass. The glass only blurs what is behind it (the
//  compositor does it; `lens: false`), and the panel is not stuck under the
//  bar: it is the same silhouette, melted, so it hangs from it like a drop.

scene Vitreus {
    surface { size: full, 1440; anchor: bar_anchor; margin: 0; reserve: 68; screens: all; keyboard: exclusive while (panel != none and panel != volume and panel != notif) or wp_picker_open or ov_open or pk_open }
    permissions { services: "files", "files.write", "clock", "audio", "audio.*", "window", "media", "media.*", "workspaces", "workspaces.focus", "brightness", "brightness.*", "battery", "network", "network.*", "bluetooth", "bluetooth.*", "apps", "tray", "tray.*", "notifications", "notifications.*"
                  run: "git", "pleamar", "cava", "playerctl", "curl", "notify-send", "which", "pgrep", "pkill", "systemctl", "hyprctl", "printenv", "awww", "iris", "cp", "ls", "xdg-user-dir", "magick", "grim", "mkdir", "bluetoothctl", "nmcli", "wl-copy", "find", "cliphist", "stat", "file", "vitreus-clipimg", "grep", "pactl", "sed", "setsid", "powerprofilesctl", "loginctl", "vitreus-polkit-agent", "vitreus-sysmon", "pw-play" }

    model wifi_nets max 8 { ssid: text; strength: number; secure: bool; known: bool; active: bool }
    model bt_devices max 24 { name: text; address: text; paired: bool; connected: bool; battery: number; busy: number }

    service clock as now { time: text = "--:--"; date: text }
    service audio { volume: number; muted: bool }
    service window as win { title: text; class: text }
    service media { playing: bool; title: text; artist: text; player: text }
    service brightness { present: bool; level: number }
    service battery as pwr { present: bool; percent: number; charging: bool }     // the bar is its gauge (see `batt_*`)
    service network as net { online: bool; wifi: bool; name: text; strength: number; networks: wifi_nets }
    service bluetooth as bt { present: bool; powered: bool }        // the list itself is built by the logic

    text clock12 = "--:--"
    text clock_h = ""              // the bar clock in three parts: the hour (oversized), the minutes (in the accent), am/pm
    text clock_mm = ""
    text clock_mn = ""             // the minutes alone, for the bar down the left
    text bar_ap = ""
    text bar_date = ""              // the short day stacked above the am/pm: MON
    text datelong = ""
    //  The clock card's pieces: the numerals, the am/pm tucked beside them, and the date as weekday | month day.
    text clock_hm = "--:--"
    text clock_ap = ""
    text date_wd = ""
    text date_md = ""
    measure hmw                    // how wide the big numerals are, to tuck the am/pm against them
    measure mdw                    // and the month and day, the date being right-aligned from them
    text arturl = ""               // the cover: a path to an image file, from the logic
    fact art_on = false            // is there one
    image art = from arturl, 200, 200
    event trackchange              // the logic says the song changed
    //  The calendar: 42 days in the grid (six weeks), what the logic says of each, and the
    //  chosen day's reminders. The logic keeps them in `calendar.json` and paints these.
    event cal_pick ->              // a day of the grid, by its place
    event cal_prev ->
    event cal_next ->
    event cal_today ->
    event cal_open ->              // the calendar panel just opened: back to today
    event cal_add ->               // the Add button (Enter in the field does the same)
    event cal_check ->             // a reminder of the chosen day, by its row: done / not done
    event cal_delete ->
    fact cal.sel = 0               // which place of the grid is chosen
    text cal.month = ""
    text cal.sel_title = ""
    text cal.sel_sub = ""
    text cal_new = ""              // what is being typed in the field
    model cal_events max 4 { time: text; title: text; done: bool }
    repeat k in 0..42 {
        fact cal.day.$k = 0
        fact cal.in.$k = false
        fact cal.today.$k = false
        fact cal.n.$k = 0
    }
    repeat w in 1..8 { text cal.wd.$w = "" }
    text outname = ""              // where the sound is going: the default output
    measure outw                   // how wide that name really is
    measure clsw                   // how wide the focused app's name really is
    measure lhw0                   // how wide the launcher's five hints are, to centre each in its cell
    measure lhw1
    measure lhw2
    measure lhw3
    measure lhw4
    measure titw                   // and its window title
    measure vclw                   // the same two, at the size they are drawn down the left bar
    measure vtiw
    measure chw                    // the bar clock's hour, minutes and am/pm: how wide each really is; the bar's
    measure cmw                    // buttons and the calendar's click area are placed from them
    measure caw
    measure cdw
    //  Which panel hangs from the bar: the clock and calendar (click the clock), or the
    //  controls (click the window title).
    fact panel: none | calendar | controls | player | volume | notif | settings | launch | tray = none
    fact media_on = false          // is there a player at all
    fact bass = 0
    //  The six bars cava reports, 0..1 each, for the equalizer in the media card. Each one
    //  has its own quick spring, so they rise and fall smoothly instead of stepping.
    repeat i in 0..6 {
        fact spec.$i = 0
        prop spec.s.$i = 0 ~quick
        follow spec.s.$i = spec.$i
    }                  // 0..1, from cava: how hard the low end is hitting
    model outlist max 6 { name: text; current: bool }   // every place the sound can go
    //  The mixer under the volume slider (right-click it): one row per app that is playing sound.
    model mixer max 6 { name: text; pct: number; muted: bool; corked: bool; icon: image 27, 27 }
    event mix_set ->                // a row's slider: the row times 4, plus 0..1 along its track (one number)
    event mix_mute ->               // a row's speaker
    //  The running windows (asked of Hyprland by the logic: the window service has no list there) and
    //  the apps that live in the tray, for the panel that hangs from the window title. Icons are named
    //  by the logic, which matches each window's class to an app.
    model tasks max 12 { title: text; ws: text; active: bool; icon: image 30, 30 }
    fact tasks_watch = false       // the panel is open: keep the list fresh
    model trays max 16 { title: text; icon: image 30, 30; pinned: bool; menu: bool }
    model bartrays max 8 { icon: image 36, 36 }          // the tray apps that ride the bar
    //  One entry of a tray app's menu, flattened: an open submenu is followed by its own entries, `depth` deeper.
    model tray_menu max 40 { label: text; enabled: bool; sep: bool; checked: bool; kids: bool; open: bool; depth: number }
    //  The tray menu panel (it hangs from the window title, like the player's) is about one app.
    text tm_title = ""
    text tm_sub = ""
    text tm_iconurl = ""
    image tm_icon = from tm_iconurl, 44, 44
    fact tm_pinned = false
    fact tm_has_menu = false
    fact tm_h = 0                       // how tall the menu's rows are, unscaled
    fact tray_only_pinned = false       // the bar shows only the pinned apps
    fact dm_mode: dmm_player | dmm_tray = dmm_player      // what the window-title panel holds
    event tray_pin ->
    event tray_menu_open ->
    event bar_tray_click ->
    event bar_tray_menu ->
    event tray_menu_pick ->
    event tm_pin ->
    event tm_open ->
    event tm_alt ->
    event tray_mode ->
    //  The two transient panels (volume, and a notification arriving) share one drawer. `osd_kind` is
    //  which one it draws; unlike `panel` it stays put while the drawer closes, so it fades out
    //  showing what it was showing.
    fact osd_kind: vol | note = vol
    text nt_app = ""
    text nt_title = ""
    text nt_body = ""
    measure ntt                    // how tall the notification's title really is once wrapped
    measure ntb                    // and its body
    text nt_iconpath = ""          // the app's icon, or the picture it brought: a name or a path
    image nt_img = from nt_iconpath, 59, 59       // drawn at 44 * u = 59: declared at that, or it is made at 44 and stretched (soft, with a jagged edge)
    fact nt_icon_on = false
    fact nt_body_on = false
    fact nt_urgent = false
    model nt_acts max 3 { label: text }
    event ntnew                    // a notification just arrived: ripple the tile
    event nt_close ->              // its cross, or a press on the plate
    event nt_act ->                // one of its buttons, by position
    //  Settings: a panel of pages, the wallpaper picker first. The logic lists the folder and keeps one
    //  page of twelve thumbnails at a time (the folder can hold hundreds of full-size images).
    model wps max 12 { thumb: image 260, 146 }
    fact wp_sel = -1                // which thumbnail of this page is the wallpaper in use, or -1
    text wp_curpath = ""            // the wallpaper in use: a path
    image wp_cur = from wp_curpath, 320, 180
    text wp_name = ""
    text wp_dirtext = ""
    text wp_pager = ""
    event wp_pick ->                // a thumbnail, by position on the page
    event wp_prev ->
    event wp_next ->
    event wp_random ->
    //  The colour filter (twelve swatches; the lit one is `wp_filter`, -1 for none) and the slideshow.
    fact wp_filter = -1
    //  The glass of the bar and every drawer: how much of the glass effect it has (tint, edge light, and the blur
    //  the compositor puts behind it), and how opaque it is. Set from the Glass page of the settings.
    fact glass_frost = 1
    fact glass_op = 1
    text glass_frost_text = "100%"
    text glass_op_text = "100%"
    event glass_frost_set ->        // the Glass slider: 0..1 along its track
    event glass_op_set ->           // the Opacity slider: 0..1 along its track
    event hy_layout_set ->
    event hy_gaps_set ->
    event hy_round_set ->
    event hy_sens_set ->
    event hy_follow_set ->
    event hy_toggle ->
    event hy_refresh ->
    event wm_layout_set ->
    event wm_share_set ->
    event wm_gap_set ->
    event wm_toggle ->
    event wm_input_set ->
    event wm_style_set ->
    event wm_refresh ->
    //  The launcher (SUPER + Space): what is typed, the results, and which one is chosen.
    event launch_toggle ->          // from a key bind (hypr_vitreus.lua)
    event launch_open ->
    event launch_move ->            // -1 up, +1 down
    event launch_pick ->            // a row, by place
    event launch_scroll ->          // the wheel over the rows: notches, positive is down
    event launch_run ->             // Enter
    event launch_del ->             // a row's remove button, by place (the clipboard's)
    event launch_delsel ->          // Shift + Delete: remove the chosen row
    event launch_hint ->            // a hint under the field: type its first character
    text lq = ""                    // the search field
    text lmode = "Apps"             // which kind of search the text asks for
    text lmsg = ""                  // what to say when there is no row: "No results", "Searching…"
    text lfoot = ""                 // "3 / 20"
    fact lcount = 0
    fact lp_on = false               // this kind of search has a preview beside its rows
    prop lpv = 0 ~calm               // 0..1: how far the preview is in
    follow lpv = if(lp_on, 1, 0)
    text lp_kind = ""                // FILE, IMAGE, TEXT, WALLPAPER
    text lp_title = ""
    text lp_path = ""
    text lp_body = ""                // the text of a text entry
    text lp_k1 = ""
    text lp_v1 = ""
    text lp_k2 = ""
    text lp_v2 = ""
    text lp_k3 = ""
    text lp_v3 = ""
    text lp_k4 = ""
    text lp_v4 = ""
    text lp_imgpath = ""             // a small copy of the picture, at a fixed path with a version on the end
    fact lp_img_on = false
    image lp_img = from lp_imgpath, 480, 320
    model lres max 6 { title: text; sub: text; desc: text; hasdesc: bool; glyph: text; sel: bool; hasicon: bool; deletable: bool; icon: image 35, 35 }
    event settings_toggle ->        // from a key bind (hypr_vitreus.lua): open or close Settings
    event glass_reset ->
    //  The pages of the settings panel, and how far the second is in (for the sidebar's highlight and the
    //  panel's height, which follows the page).
    fact set_page: pg_wall | pg_glass | pg_disp | pg_bar | pg_night | pg_hypr | pg_about | pg_sys | pg_nt | pg_lock | pg_wm = pg_wall
    //  The Bar page: which monitors the bar is on (see the Bar section of vitreus.luau). `bar_scr` is -1 for all
    //  of them, or which monitor tile is chosen.
    fact bar_scr = -1
    //  The bar's position (Settings > Bar): along the top, or down the left edge with a frame round the screen (see the Bar section of
    //  vitreus.luau). The surface's anchor follows it; `bar_lm` is how far over to the left it has got, and the panels still hang from the top
    //  edge, `lp_w` wide (the one last opened), their left edge by the strip.
    fact bar_anchor: top | left = top
    //  Down the left a panel never turns into another: asking for one while another is open closes the open one first, and the new one
    //  opens when it has gone (see the rule after `lp.top`). `pcur` is the panel as the rule last saw it, `pending` the one that is waiting.
    fact pcur: none | calendar | controls | player | volume | notif | settings | launch | tray = none
    fact pending: none | calendar | controls | player | volume | notif | settings | launch | tray = none
    fact pq_sw = false
    event bar_pick_pos ->
    fact lp_w = 450
    fact lp_k = 0                   // which panel was opened last: 1 settings, 2 launcher, 3 controls, 4 calendar, 5 tray, 6 player, 7 volume, 8 notification
    repeat i in 0..4 {
        fact bar_m.$i.on = false
        text bar_m.$i.name = ""
        text bar_m.$i.sub = ""
    }
    text bar_msg = ""
    event bar_pick_scr ->
    //  The bar's layout (Settings > Bar): each piece's place in the row, 0 leftmost, and whether it is shown. The
    //  title is the stretch: what comes before it hugs the left, what comes after it the right.
    fact bo.ws = 0
    fact bo.title = 1
    fact bo.media = 2
    fact bo.tray = 3
    fact bo.set = 4
    fact bo.sr = 5
    fact bo.ctl = 6
    fact bo.clock = 7
    fact bv.ws = true
    fact bv.title = true
    fact bv.media = true
    fact bv.sr = true
    fact bv.ctl = true
    fact bv.clock = true
    fact bv.tray = true
    //  The layout editor on the Bar page: a chip per piece (0 workspaces, 1 title, 2 player, 3 settings, 4 search,
    //  5 controls, 6 clock, 7 tray), where the logic puts it (`bc.$i`, top-left and width, in the editor's unscaled units:
    //  the bar row starts at y 4, the hidden tray at 56), and the one being dragged, which follows the pointer.
    repeat i in 0..8 {
        fact bc.$i.x = 0
        fact bc.$i.y = 4
        fact bc.$i.w = 34
    }
    fact bdrag = -1                 // the chip being dragged, -1 none
    fact bdx = 0                    // the pointer, in the editor's units
    fact bdy = 0
    fact bgx = 0                    // where in the chip it was taken
    fact bgy = 0
    fact bdrop_tray = false         // the dragged chip would go to the hidden tray
    fact btray_n = 0                // how many pieces are hidden
    event bar_lay_grab ->
    event bar_lay_drag ->
    event bar_lay_drop ->
    event bar_lay_reset ->
    //  The Display page: what the logic reads from Hyprland and the draft the page edits (see the Display
    //  section of vitreus.luau). `disp_boxes` is the canvas, one box per monitor, in canvas units.
    //  The canvas's boxes, the refresh-rate chips, the monitor pills and the profile rows are numbered slots.
    repeat i in 0..4 {
        fact disp_b.$i.on = false
        fact disp_b.$i.x = 0
        fact disp_b.$i.y = 0
        fact disp_b.$i.w = 0
        fact disp_b.$i.h = 0
        fact disp_b.$i.sel = false
        fact disp_b.$i.dirty = false
        text disp_b.$i.name = ""
        text disp_b.$i.mode = ""
        fact disp_pill.$i.on = false
        text disp_pill.$i.text = ""
        fact disp_p.$i.on = false
        fact disp_p.$i.active = false
        text disp_p.$i.name = ""
        text disp_p.$i.sub = ""
    }
    repeat i in 0..6 {
        fact disp_hz.$i.on = false
        fact disp_hz.$i.lit = false
        text disp_hz.$i.text = ""
    }
    text disp_res_text = ""
    measure disp_rw                 // how wide the resolution's text is: the dropdown is as wide as that needs
    fact disp_res_open = false      // the resolution dropdown is open
    fact disp_scroll_to = 0         // where the Display page is scrolled to (unscaled units, from the top)
    fact disp_res_chars = 10        // how many characters the longest resolution in the list has
    fact disp_res_count = 0         // how many resolutions it lists
    fact disp_pcount = 0            // how many saved profiles there are (the card is as tall as they need)
    repeat i in 0..14 {
        fact disp_r.$i.on = false
        fact disp_r.$i.lit = false
        text disp_r.$i.text = ""
    }
    fact disp_count = 0
    fact disp_sel = 0               // which monitor the inspector is about
    fact disp_dirty = false         // the draft is not what the screens are
    fact disp_scale = 0             // which of the seven scale choices is the draft's
    fact disp_rot = 0               // 0..3, or -1 for a flipped one
    fact disp_sdrb = 1
    fact disp_sdrs = 1
    fact disp_auto = true           // reapply a saved profile when its set of displays is connected
    fact disp_trial = 0             // seconds left of a change on trial; 0 for none
    fact disp_grab_i = 0
    fact disp_px = 0
    fact disp_py = 0
    text disp_title = ""
    text disp_desc = ""
    text disp_cur = ""
    text disp_topo = ""
    text disp_msg = ""
    text disp_trial_text = ""
    text disp_sdrb_text = "1"
    text disp_sdrs_text = "1"
    text disp_profile_name = ""
    event disp_pick_mon ->
    event disp_pick_res ->
    event disp_pick_hz ->
    event disp_pick_scale ->
    event disp_pick_rot ->
    event disp_sdrb_set ->
    event disp_sdrs_set ->
    event disp_apply ->
    event disp_keep ->
    event disp_revert ->
    event disp_reset ->
    event disp_refresh ->
    event disp_grab ->
    event disp_drag ->
    event disp_drop ->
    event disp_arrange ->
    event disp_swap ->
    event disp_profile_save ->
    event disp_profile_apply ->
    event disp_profile_delete ->
    event disp_auto_toggle ->
    text wp_count = ""              // 57 wallpapers, or 12 of 57 with a colour picked
    event wp_filter_set ->          // a swatch, by position
    fact wp_show = false            // the slideshow is on
    text wp_show_sub = ""           // Next change in 4:31
    text wp_mins_text = ""          // 5 min
    event wp_show_toggle ->
    fact rand_turn = 0              // how many times Random has been pressed: the die turns once for each
    fact iris_on = true             // Iris, the palette from the wallpaper, is on; off, the shell is monochrome
    event iris_toggle ->
    event wp_mins_step ->           // the stepper: -1 or 1 along a short list of intervals
    //  Weather, for the calendar panel: what it is now, and the week ahead. The logic fetches it (Open-Meteo)
    //  and gives each day a `kind`: 0 clear, 1 partly cloudy, 2 cloud, 3 fog, 4 rain, 5 snow, 6 storm.
    fact wx_ok = false
    fact wx_kind = 2
    text wx_temp = ""
    text wx_desc = ""
    model wx_days max 7 { label: text; kind: number; hi: text; lo: text; today: bool }
    event task_focus ->            // a window's row, by position: give it the keyboard
    event task_close ->            // its close button, or a middle click
    event tray_click ->            // a tray app's row
    fact dd_open = false           // the output dropdown
    fact vm_open = false           // the per-app mixer under the volume slider
    event pick_out ->              // a row of it, by position
    event mute ->                  // the speaker icon
    event setvol ->                // the volume slider: 0..1
    event mcmd ->                  // 0 previous · 1 play/pause · 2 next
    event setbright ->             // the brightness slider: 0..1
    event togglewifi ->            // the wifi row: flips the radio
    event togglebt ->              // the bluetooth row: flips the radio
    fact bt_connected = false      // a device is paired and connected
    text bt_name = ""              // its name, from the logic
    fact bright_avail = true       // brightnessctl is installed: the slider can actually be dragged
    //  Tapping the rest of a tile (not its toggle) grows it into its own window.
    //  `showing_sub` only follows `panel_sub` on the way in - see its rule below -
    //  so the window it drew stays up, fading out, while it closes.
    fact panel_sub: none | netview | btview | notifview | cafview | capview | powview = none
    fact showing_sub: none | netview | btview | notifview | cafview | capview | powview = none
    //  Which row is open, in each list - its password field or its
    //  Connect/Disconnect/Forget, right underneath it. -1 is none.
    fact on_wifi = false            // the connection in use is Wi-Fi (not wired): the logic reads network.kind
    fact wifi_open_row = -1
    fact bt_open_row = -1
    //  The open Bluetooth row's audio profiles (High Fidelity, Headset, Off...), the way PipeWire offers them for that device: up to six, each a
    //  label and whether it is the one in use (`bt_po`: there is one in this place). `bt_pf_h` is how tall the pills are, 0 when there is nothing to choose.
    fact bt_pf_h = 0
    event bt_prof_set ->
    repeat i in 0..6 { text bt_pl.$i = "" }
    repeat i in 0..6 { fact bt_pa.$i = false }
    repeat i in 0..6 { fact bt_po.$i = false }
    event wifi_pick ->              // a network row's own button: connect, or leave it
    event wifi_forget ->            // a network row's Forget
    event wifi_scan ->              // the rescan button
    fact wifi_scanning = false      // a scan is running: the logic holds it up for a few seconds
    fact bt_scanning = false
    fact bt_working = false         // a device is being connected or disconnected (its row pulses)
    text wifi_pw = ""               // the password field open under a row
    event wifi_join_go ->           // its Join button, or Enter in the field
    event bt_pick ->                // a device row's own button: connect, or leave it
    event bt_forget ->              // a device row's Forget
    event bt_scan ->                // the rescan button
    //  Do Not Disturb is a preference the logic keeps in `dnd.json`; Caffeine is whether hypridle
    //  has been stopped, which the logic asks the system rather than remembering.
    fact dnd_on = false
    fact caf_on = false
    fact caf_avail = true          // hypridle is installed: there is something to hold off
    event togglednd ->
    //  The notifications module: Do Not Disturb with a timer, and the history of what came in.
    model nt_hist max 30 { title: text; sub: text; when: text }
    text nt_tile_sub = ""          // the tile's second line: Silenced · 23:41, 12 in history, All clear
    text dnd_left = ""             // the window's DND row: 23:41 left, On until turned off, Off
    fact dnd_len = 0               // minutes of the timer that is running (which chip is lit), 0 for none
    event dnd_for ->               // a timer chip: minutes
    event nt_clear ->              // the Clear button
    event nt_hist_del ->           // a history row's cross, by position
    fact caf_len = 0               // minutes of the Caffeine timer that is running (which chip is lit), 0 for none
    text caf_left = ""             // the Caffeine window's row: 23:41 left, On until turned off, Off
    text caf_tile_sub = ""         // the tile's second line while a timer runs: Awake · 23:41
    event togglecaf ->
    event caf_for ->               // a timer chip: minutes, or 0 for until it is turned off
    //  Capture and Power, the third row of tiles: screenshots and screen recording, the session and the power profile.
    fact rec_on = false            // wf-recorder is running
    text rec_time = ""             // how long, 1:23
    fact pow_prof = -1             // 0 power saver, 1 balanced, 2 performance, -1 no power-profiles-daemon
    event shot ->                  // 0 a region, 1 the whole screen
    event rec_start ->             // the same
    event rec_stop ->
    event rec_toggle ->            // the tile's button
    event pow_press ->             // a session button held for one second: 0 lock, 1 sleep, 2 log out, 3 restart, 4 power off
    event pow_prof_set ->          // 0, 1 or 2
    fact ws.active = 1
    repeat i in 1..6 { fact ws.$i.busy = false }
    event go ->
    event ov_go ->                     // a click on a workspace in the overview: it closes, then the switch

    //  The colours live in palette.plm (ink, faint, mint, tint…); only the veil is the scene's.
    let veil  = 8%

    shader wave = file "wave.wgsl"
    spring dripl = 46, 8          // the drip down the left: slow enough to see the neck stretch, thin and snap, and loose enough to swing past where it lands
    spring drip = 170, 18         // underdamped: it overshoots and settles back, like a real drop landing
    spring pop  = 300, 12         // snappier and much less damped: a toggle knob popping past where it lands

    prop drop  = 0 ~drip          // the panel, 0 to 1: it hangs from the bar and falls
    //  The settle: the panel hangs a few px lower when it lands and eases back. Critically damped, so it is one slow hump and never a bounce.
    spring hang = 260, 32
    prop sag   = 0 ~hang
    //  The water's own spring, from Marea: a quarter of a second of period and two bounces you can see. A drawer
    //  that lands shakes on it for a moment, as a drop does when it comes to rest.
    spring splash = 420, 13
    prop wobble = 0 ~splash
    //  Where the ripple that crosses the bar is born: 0 at the player controls (the music), 1 in the middle
    //  (a drawer that has just closed, the surface closing over it).
    prop ring_mid = 0 ~30ms
    prop hot   = 0 ~quick         // the bar, when the pointer is on it
    prop f1    = 0 ~200ms        // what is inside, arriving one after another
    prop f2    = 0 ~380ms
    prop f3    = 0 ~520ms
    prop f4    = 0 ~380ms          // the calendar's second stage
    prop f5    = 0 ~620ms          // the controls drawer, third in: brightness
    prop f6    = 0 ~700ms          // fourth: wifi
    prop f7    = 0 ~780ms          // fifth: bluetooth
    prop wifi_on = 0 ~pop         // the wifi toggle pill, popping past where it lands
    prop wifi_extra = 0 ~calm     // 0..1: whether a Wi-Fi row is open
    prop wifi_sel = 0 ~calm       // which row, as a position: slides from one row to the next
    prop bt_extra = 0 ~calm       // 0..1: whether a Bluetooth row is open
    prop bt_pf = 0 ~calm          // the room its audio profiles take, once open
    prop bt_sel  = 0 ~calm        // which row, as a position: slides from one row to the next
    prop bt_on   = 0 ~pop         // the bluetooth toggle pill, popping past where it lands
    prop media_open = 0 ~drip      // the media plate: a sliver with nothing playing, a full card with something to show
    //  Each panel has its own amount, 0 shut .. 1 open. Each one is a drawer that comes out of the
    //  bar and melts into it; the calendar is as wide as the bar, the others are narrower.
    prop dc    = 0 ~drip
    prop dk    = 0 ~drip
    prop dm    = 0 ~drip          // the player's panel, hanging from the window title
    prop do    = 0 ~drip          // the volume / notification drawer
    prop ds    = 0 ~drip          // the settings panel
    prop fs    = 0 ~300ms         // what is in it, fading in
    prop dl    = 0 ~drip          // the launcher
    prop fl    = 0 ~300ms         // what is in it, fading in
    prop lr    = 1 ~calm          // how many rows it has room for
    prop fo    = 0 ~300ms         // what is in it, fading in
    prop okv   = 0 ~calm          // 1 while it is the volume that is drawn
    prop okn   = 0 ~calm          // 1 while it is a notification
    prop osd_h = 64 ~calm         // the height of its plate: a notification is taller with text and buttons
    prop nt_ring = 1 ~900ms       // a ripple off the notification's tile: 0 born, 1 gone
    prop expand = 0 ~drip          // a tile growing into its own window, 0 tile .. 1 full window
    //  The music: fast, and a little loose, so the bar bounces on the beat.
    spring beat = 480, 15
    prop pulse = 0 ~beat
    prop ring  = 1 ~900ms          // a ripple crossing the bar: 0 born, 1 gone
    prop dd    = 0 ~calm           // the output dropdown, 0 shut .. 1 open
    prop vm    = 0 ~calm           // the per-app mixer, 0 shut .. 1 open
    prop mvis  = 0 ~calm           // 1 while there is an app playing sound (or the mixer is open): the dots show
    prop swap  = 1 ~700ms          // the cover popping in on a new song: 0 just changed, 1 settled
    prop playf = 0 ~calm           // 1 while playing: the cover is full and colourful
    prop mshow = 0 ~calm          // the bar's player controls: there while a player exists, paused or not

    follow drop = if(panel != none, 1, 0)
    follow dtrav = if(panel != none, 1, 0)
    follow hot  = if(panel != none, 1, 0)
    follow dc   = if(panel == calendar, 1, 0)
    follow dk   = if(panel == controls, 1, 0)
    follow dm   = if(panel == player or panel == tray, 1, 0)
    follow do   = if(panel == volume or panel == notif, 1, 0)
    follow ds   = if(panel == settings, 1, 0)
    follow dl   = if(panel == launch, 1, 0)
    follow lr   = max(1, lcount, if(lp_on, 6, 1))
    follow okv  = if(osd_kind == vol, 1, 0)
    follow okn  = if(osd_kind == note, 1, 0)
    on ntnew {
        nt_ring: 0 ~16ms
        nt_ring: 1 ~800ms after 30ms
    }
    follow expand = if(panel_sub != none, 1, 0)
    //  Which window to actually draw. It jumps to match `panel_sub` the moment
    //  that becomes something - opening one, or switching straight to the other
    //  - but not back to `none`: closing is `expand` fading the same window out,
    //  so it has to stay named while that happens.
    on change panel_sub while panel_sub != none { showing_sub = panel_sub }
    on change panel_sub { wifi_open_row = -1; bt_open_row = -1 }
    //  Each workspace's indicator has its own amount of «active», 0..1, and morphs by it: the one that
    //  becomes active widens and turns mint in place while the one that stops shrinks back. Nothing
    //  travels. The speed is one with no overshoot: a morph, not a bounce.
    prop ws.act.1 = 0 ~260ms
    prop ws.act.2 = 0 ~260ms
    prop ws.act.3 = 0 ~260ms
    prop ws.act.4 = 0 ~260ms
    prop ws.act.5 = 0 ~260ms
    follow ws.act.1 = if(ws.active == 1, 1, 0)
    follow ws.act.2 = if(ws.active == 2, 1, 0)
    follow ws.act.3 = if(ws.active == 3, 1, 0)
    follow ws.act.4 = if(ws.active == 4, 1, 0)
    follow ws.act.5 = if(ws.active == 5, 1, 0)
    //  Where the active one is, as a number that moves smoothly between slots while two are morphing
    //  (the amounts of the two add up to 1, so this is their weighted middle).
    let pill = ws.act.1 * 1 + ws.act.2 * 2 + ws.act.3 * 3 + ws.act.4 * 4 + ws.act.5 * 5
    //  Occupied but not active: the dot stretches up into a capsule.
    repeat i in 1..6 { prop ws.tall.$i = 0 ~lively }
    repeat i in 1..6 { follow ws.tall.$i = if(ws.$i.busy, 1, 0) }

    on change drop > 0.97 while drop > 0.97 { impulse sag 220; impulse wobble -260 }
    //  The same moments as in Marea, for the left layout's drop: it lets go (the edge jumps and bounces, two ripples set off, a small drop stays
    //  hanging and is swallowed), it is grabbed on its way back, and the edge closes over it once it has gone in.
    on change dsl > 0.84 while dsl > 0.84 and lm > 0.5 { impulse pbounce -280; impulse wobble -520; prip: 0 ~16ms; prip: 1 ~1100ms after 30ms; pstray: 1 ~16ms; pstray: 0 ~700ms after 60ms }
    on change dsl < 0.84 while dsl < 0.84 and lm > 0.5 { impulse wobble 300; impulse pbounce 80 }
    on change dsl < 0.06 while dsl < 0.06 and lm > 0.5 { impulse pbounce -200; impulse wobble -160; prip: 0 ~16ms; prip: 1 ~900ms after 30ms }
    //  A drawer that has gone back into the bar: the surface closes over it, and a ripple runs out from the
    //  middle of the bar (the same wave the music makes, from another place).
    on change drop < 0.08 while drop < 0.08 and panel == none {
        impulse wobble 90
        ring_mid: 1 ~0ms
        ring: 0 ~16ms
        ring: 1 ~900ms after 30ms
    }
    //  What is inside a panel arrives after the drawer has come down, not with it (it was showing while the
    //  drawer was still a sliver under the bar, over the bar's lower half), and leaves at once when the panel
    //  closes, so nothing is left hanging over the bar as it shuts. Each keeps its own spring, so the
    //  controls' plates still arrive one after another.
    on change panel while panel == calendar   { f1: 1 after 220ms; f4: 1 after 300ms }
    on change panel while panel != calendar   { f1: 0 ~80ms; f4: 0 ~80ms }
    on change panel while panel == controls   { f2: 1 after 200ms; f5: 1 after 200ms; f6: 1 after 200ms; f7: 1 after 200ms }
    on change panel while panel != controls   { f2: 0 ~80ms; f5: 0 ~80ms; f6: 0 ~80ms; f7: 0 ~80ms }
    on change panel while panel == player     { dm_mode = dmm_player }
    on change panel while panel == tray       { dm_mode = dmm_tray }
    on change panel while panel == player or panel == tray { f3: 1 after 200ms }
    on change panel while panel != player and panel != tray { f3: 0 ~80ms }
    on change panel while panel == settings   { fs: 1 after 220ms }
    on change panel while panel == launch     { fl: 1 after 200ms; focus lq; emit launch_open }
    on change panel while panel != launch     { fl: 0 ~80ms }
    on change panel while panel != settings   { fs: 0 ~80ms }
    on change panel while panel == volume or panel == notif { fo: 1 after 140ms }
    on change panel while panel != volume and panel != notif { fo: 0 ~80ms }
    follow wifi_on = if(net.wifi, 1, 0)
    follow wifi_extra = if(wifi_open_row >= 0, 1, 0)
    on change wifi_open_row while wifi_open_row >= 0 and wifi_extra < 0.05 { wifi_sel: wifi_open_row ~0ms }
    on change wifi_open_row while wifi_open_row >= 0 and wifi_extra >= 0.05 { wifi_sel: wifi_open_row }
    follow bt_extra = if(bt_open_row >= 0, 1, 0)
    follow bt_pf = bt_pf_h
    on change bt_open_row while bt_open_row >= 0 and bt_extra < 0.05 { bt_sel: bt_open_row ~0ms }
    on change bt_open_row while bt_open_row >= 0 and bt_extra >= 0.05 { bt_sel: bt_open_row }
    follow bt_on   = if(bt.powered, 1, 0)
    prop dnd_pill = 0 ~pop
    prop caf_pill = 0 ~pop
    prop rec_pill = 0 ~pop
    fact pw_s0 = 0                   // when the Lock button was pressed (`time`)
    prop pw_hp0 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d0 = false               // it is being held
    follow pw_hp0 = if(pw_d0, clamp((time - pw_s0) / 1, 0, 1), 0)
    fact pw_s1 = 0                   // when the Sleep button was pressed (`time`)
    prop pw_hp1 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d1 = false               // it is being held
    follow pw_hp1 = if(pw_d1, clamp((time - pw_s1) / 1, 0, 1), 0)
    fact pw_s2 = 0                   // when the Log out button was pressed (`time`)
    prop pw_hp2 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d2 = false               // it is being held
    follow pw_hp2 = if(pw_d2, clamp((time - pw_s2) / 1, 0, 1), 0)
    fact pw_s3 = 0                   // when the Restart button was pressed (`time`)
    prop pw_hp3 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d3 = false               // it is being held
    follow pw_hp3 = if(pw_d3, clamp((time - pw_s3) / 1, 0, 1), 0)
    fact pw_s4 = 0                   // when the Power off button was pressed (`time`)
    prop pw_hp4 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d4 = false               // it is being held
    follow pw_hp4 = if(pw_d4, clamp((time - pw_s4) / 1, 0, 1), 0)
    prop pow_th = 1 ~pop                // where the power-profile thumb is: 0 saver, 1 balanced, 2 performance
    prop wp_show_pill = 0 ~pop
    prop iris_pill = 0 ~pop
    prop bar_lm = 0 ~calm
    prop pw_x = 450 ~90ms
    prop dtrav = 0 ~dripl             // how far a panel has come out of the strip, 0 to 1 (the left layout's own, slow, drop)
    prop pbounce = 0 ~splash          // the strip's edge bouncing when the thread breaks
    prop prip = 1 ~1100ms              // the ripple that runs along the strip's edge, 0 just born, 1 gone
    prop pstray = 0 ~700ms            // the small drop that is left hanging from the edge
    prop pw_y = 20 ~90ms
    prop rand_spin = 0 ~pop
    prop set_pg = 0 ~calm
    prop set_pgd = 0 ~calm
    prop set_pgh = 0 ~calm
    prop set_pga = 0 ~calm
    prop set_pgn = 0 ~calm
    prop set_pgs = 0 ~calm
    prop set_pgt = 0 ~calm
    prop set_pgl = 0 ~calm
    prop set_pgw = 0 ~calm
    prop set_pgb = 0 ~calm
    prop bs.ws = 1 ~calm              // each piece of the bar, 1 shown .. 0 hidden: its room and its opacity
    prop bs.title = 1 ~calm
    prop bs.media0 = 1 ~calm
    prop bs.title0 = 1 ~calm
    prop bs.media = 1 ~calm
    prop bs.sr = 1 ~calm
    prop bs.ctl = 1 ~calm
    prop bs.clock = 1 ~calm
    prop bs.tray = 1 ~calm
    //  The scene's own `time`. If a scene only names `time`, pleamar makes one that never stops, and a scene with a
    //  clock that never stops never rests: it paints every frame for as long as it lives. This one turns only while
    //  something on screen is using it (the scan rings, the pulse of a device being connected, the volume drawer's
    //  face and ripple, the caffeine steam, the urgent dot, the "More" cue), and the scene sleeps the rest of the time.
    prop time = 0
    //  The battery: the bar itself is the gauge. A soft fill grows from its left edge as far as the charge goes, and
    //  goes red below 20 % while it is draining. A machine with no battery (a desktop) draws nothing.
    prop batt_fill = 0 ~calm            // 0..1, the charge, smoothly
    prop batt_on = 0 ~calm              // 1 when there is a battery
    prop batt_low = 0 ~calm             // 1 while below 20 % and not charging
    //  The gauge is not there at rest. It appears (grows a little and fades in) while the pointer is on the bar (any of
    //  its zones: a zone is only hovered while it is the topmost one under the pointer, so it is the most of them all),
    //  and stays while the charge is under 20 %, whatever the pointer does.
    prop batt_open = 0 ~calm
    //  While the charger is filling the battery, a soft glint crosses the bar every 5 seconds (and once as soon as it
    //  is plugged in): `charge_sweep` goes from 0 to 1 over 0.9 s and then rests at 1. It is a timer that wakes the
    //  scene for that second and lets it sleep for the other four. A battery that says "charging" at 98 % or more is
    //  full and only being held there, so it does not glint.
    prop charge_sweep = 1 ~calm
    every 5s while pwr.charging and pwr.percent < 98 { charge_sweep: 0 ~0ms; charge_sweep: 1 ~900ms after 40ms }
    on change pwr.charging while pwr.charging and pwr.percent < 98 { charge_sweep: 0 ~0ms; charge_sweep: 1 ~900ms after 40ms }
    repeat i in 1..6 { prop wsh.$i = 0 ~quick }         // each workspace dot's hover, brought out of its `repeat`
    follow batt_fill = clamp(pwr.percent / 100, 0, 1)
    follow batt_on = if(pwr.present, 1, 0)
    follow batt_low = if(pwr.percent < 20 and not pwr.charging, 1, 0)
    prop trn = 0 ~calm                // how many tray icons the bar holds, smoothly: the bar widens with it
    prop disp_auto_pill = 0 ~pop
    prop disp_dd = 0 ~calm            // the resolution dropdown, 0 shut .. 1 open
    prop disp_scroll = 0 ~quick       // the page's scroll, following disp_scroll_to
    prop disp_pn_s = 0 ~calm          // the profiles card's rows, smoothed: it grows and shrinks with them
    prop dnd_wobble = 0 ~pop       // the bell, swung when DND flips
    follow dnd_pill = if(dnd_on, 1, 0)
    follow caf_pill = if(caf_on, 1, 0)
    follow rec_pill = if(rec_on, 1, 0)
    follow pow_th = if(pow_prof < 0, 1, pow_prof)
    follow wp_show_pill = if(wp_show, 1, 0)
    follow iris_pill = if(iris_on, 1, 0)
    follow bar_lm = if(bar_anchor == left, 1, 0)
    follow pw_x = lp_w
    follow rand_spin = rand_turn
    follow set_pg = if(set_page == pg_glass, 1, 0)
    follow set_pgd = if(set_page == pg_disp, 1, 0)
    follow set_pgh = if(set_page == pg_hypr, 1, 0)
    follow set_pgb = if(set_page == pg_bar, 1, 0)
    follow set_pga = if(set_page == pg_about, 1, 0)
    follow set_pgn = if(set_page == pg_night, 1, 0)
    follow set_pgs = if(set_page == pg_sys, 1, 0)
    follow set_pgt = if(set_page == pg_nt, 1, 0)
    follow set_pgl = if(set_page == pg_lock, 1, 0)
    follow set_pgw = if(set_page == pg_wm, 1, 0)
    follow bs.ws = if(bv.ws, 1, 0)
    follow bs.title = if(bv.title and bar_anchor == top, 1, 0)
    follow bs.media = if(bv.media and bar_anchor == top, 1, 0)
    follow bs.media0 = if(bv.media, 1, 0)
    follow bs.title0 = if(bv.title, 1, 0)
    follow bs.sr = if(bv.sr, 1, 0)
    follow bs.ctl = if(bv.ctl, 1, 0)
    follow bs.clock = if(bv.clock, 1, 0)
    follow bs.tray = if(bv.tray, 1, 0)
    follow trn = bartrays.count
    repeat i in 0..8 {
        prop bcx.$i = 0 ~quick
        prop bcy.$i = 4 ~quick
        prop bcw.$i = 34 ~quick
        follow bcx.$i = bc.$i.x
        follow bcy.$i = bc.$i.y
        follow bcw.$i = bc.$i.w
    }
    //  Settings > Hyprland: what Hyprland has now (see the logic), and the toggles' knobs.
    fact hy_layout = 3
    fact hy_gaps = 5
    fact hy_round = 10
    fact hy_sens = 0
    fact hy_follow = 1
    fact hy_resize = false
    fact hy_tear = false
    fact hy_anim = true
    fact hy_nat = false
    //  Settings > Pleamar-WM: what the window manager has now (see the logic). The window manager's own facts are set live; the
    //  input lines go to session.conf and apply at the next login.
    fact wm_layout = 0
    fact wm_share = 0.56
    fact wm_gap = 12
    fact wm_free = false
    fact wm_rain = false
    fact wm_snow = false
    fact wm_ms = 0
    fact wm_ts = 0
    fact wm_nat = false
    fact wm_tap = false
    fact wm_idle = 7
    fact wm_bw = 1.5
    fact wm_ba = 70
    fact wm_iris = true
    fact wm_rad = 12
    fact wm_shd = 100
    fact wm_tb = 22
    fact wm_tbo = 72
    fact wm_wa = 100
    fact wm_wi = 100
    fact wm_fr = 80
    text wm_fr_text = "80%"
    text wm_wa_text = "100%"
    text wm_wi_text = "100%"
    text wm_bw_text = "1.5 px"
    text wm_ba_text = "70%"
    text wm_rad_text = "12 px"
    text wm_shd_text = "100%"
    text wm_tb_text = "22 px"
    text wm_tbo_text = "72%"
    prop wm_k5 = 0 ~quick
    follow wm_k5 = if(wm_iris, 1, 0)
    fact wm_scroll_to = 0
    prop wm_scroll = 0 ~quick
    follow wm_scroll = wm_scroll_to
    text wm_share_text = "56%"
    text wm_gap_text = "12 px"
    text wm_ms_text = "0.00"
    text wm_ts_text = "0.00"
    text wm_idle_text = "7 min"
    prop wm_k0 = 0 ~quick
    prop wm_k1 = 0 ~quick
    prop wm_k2 = 0 ~quick
    prop wm_k3 = 0 ~quick
    follow wm_k0 = if(wm_free, 1, 0)
    follow wm_k1 = if(wm_rain, 1, 0)
    follow wm_k2 = if(wm_snow, 1, 0)
    follow wm_k3 = if(wm_nat, 1, 0)
    prop wm_k4 = 0 ~quick
    follow wm_k4 = if(wm_tap, 1, 0)
    //  The About page (Settings > System): what this shell is built from, and how to update it.
    text about_commit = "…"
    text about_date = ""
    text about_sub = ""
    text about_pl = ""
    text about_msg = ""
    fact about_behind = -1              // commits waiting upstream; -1 not known yet
    fact about_busy = false
    fact about_restarting = false   // Restart was pressed: the shell is about to be replaced (the only reason to grey the button out)
    //  Night mode (Settings > Night mode): a warm tint over the whole screen, made by Hyprland's screen shader (see the
    //  logic), by hand or on a schedule.
    fact night_on = false               // the shader is on now
    fact night_auto = false             // it switches itself on and off on the schedule
    fact night_t = 0.65                 // how warm, 0 (6500 K) to 1 (2500 K), along the slider
    text night_temp_text = "3900 K"
    text night_start_text = "9:00 PM"
    text night_end_text = "6:00 AM"
    text night_status = "Off"
    prop night_pill = 0 ~pop
    prop night_auto_pill = 0 ~pop
    follow night_pill = if(night_on, 1, 0)
    follow night_auto_pill = if(night_auto, 1, 0)
    //  Settings > Lock screen: what the lock screen scene holds. The logic asks it when the page opens (`lk_ok` is false if it did not
    //  answer) and tells it what is changed; the lock screen keeps them in its own lockscreen.json.
    fact lk_blur = 36                  // pixels at 1920 wide: 18, 36 or 60 are the chips
    fact lk_12h = true
    fact lk_ampm = true
    fact lk_media = true
    fact lk_date: lkd_long | lkd_std | lkd_day | lkd_iso = lkd_long
    fact lk_ok = true
    prop lk_pill_am = 0 ~pop
    prop lk_pill_md = 0 ~pop
    follow lk_pill_am = if(lk_ampm, 1, 0)
    follow lk_pill_md = if(lk_media, 1, 0)
    event lk_blur_set ->               // 0 light, 1 medium, 2 heavy
    event lk_12h_set ->                // 1 twelve hours, 0 twenty-four
    event lk_ampm_toggle ->
    event lk_media_toggle ->
    event lk_date_set ->               // 0 long, 1 standard, 2 day first, 3 ISO
    //  The password bar on that page: what a typed character becomes, in what colours, and the example bar that is typed into (nothing typed
    //  is kept). They are the lock screen's own mask_style and shape_palette.
    fact lk_mask: lkm_shapes | lkm_dots | lkm_stars | lkm_special = lkm_shapes
    fact lk_pal: lkc_vibrant | lkc_accent | lkc_neon | lkc_pastel | lkc_mono = lkc_accent
    event lk_mask_set ->               // 0 shapes, 1 dots, 2 asterisks, 3 special
    event lk_pal_set ->                // 0 vibrant, 1 accent, 2 neon, 3 pastel, 4 monochrome
    text lb_pw = ""
    model lb max 16 { idx: number; rot: number; outline: bool; ci: number; sym: text }
    fact lb_ok = false                 // the example's pretend "unlocked"
    prop lb_okt = 0 ~calm
    follow lb_okt = if(lb_ok, 1, 0)
    event lb_submit ->
    figure lkshp = file "lockscreen/shapes.svg"
    fact lk_px = 200                   // the lock screen's clock size: 100, 150 or 200
    fact lk_secs = false               // seconds on its clock
    fact lk_power = true               // the sleep, restart and power off buttons on it
    prop lk_pill_sec = 0 ~pop
    follow lk_pill_sec = if(lk_secs, 1, 0)
    prop lk_pill_pw = 0 ~pop
    follow lk_pill_pw = if(lk_power, 1, 0)
    event lk_size_set ->               // 0 → 100, 1 → 150, 2 → 200
    event lk_secs_toggle ->
    event lk_power_toggle ->
    event lk_test ->                   // lock now, as a test: Esc or a minute opens it
    fact lk_scroll_to = 0              // the page scrolls like System monitor's
    prop lk_scroll = 0 ~quick
    follow lk_scroll = lk_scroll_to
    event night_toggle ->
    event night_auto_toggle ->
    event night_temp_set ->             // the slider: 0..1
    event night_start_step ->           // -1 or 1, a half hour
    event night_end_step ->
    //  The wallpaper picker (SUPER + B): glass hexagons centred on the screen, drawn at the end of this scene. Every wallpaper is one
    //  hexagon (its picture already cut to the hexagon by the logic); how many there are sets how big they are, so that they always fill
    //  the tray. The logic makes the pictures (`wp_picker`), orders them by colour and does the awww side of a pick.
    model wp_picker max 200 { img: image 104, 120; hue: number; cur: bool; dim: bool; name: text }       // the picture is 124 x 143 (120 x 139 and two transparent pixels all round), and the cell is declared smaller, 104 x 120, in the same shape (the picture is fitted inside it; the resting tiles are drawn at about that size): every image takes its whole cell from the atlas (one 2048 x 2048 texture, shared with the text), and at 186 x 215 only about a hundred of the hundred and thirty-seven tiles fitted, the rest were drawn empty
    fact wp_picker_open = false
    text wp_picker_status = ""                // "Reading your wallpapers… 42 of 137" while the first analysis runs
    text wp_picker_hero_name = ""             // the name of the hexagon under the pointer
    fact wp_picker_hero_cur = false           // the one under the pointer is the wallpaper in use
    fact wp_picker_hot = -1                   // the hexagon under the pointer, -1 none
    fact wp_picker_px = 0                     // where a pick was, for awww: pixels from the bottom left
    fact wp_picker_py = 0
    event wp_picker_toggle ->
    event wp_picker_pick ->
    event wp_picker_random ->
    fact wp_picker_leaving = false            // a wallpaper was picked: the tray fades so the desktop's own transition shows
    prop wp_picker_veil = 1 ~calm             // 1 normal, 0 while it is leaving
    follow wp_picker_veil = if(wp_picker_leaving, 0, 1)
    prop wp_picker_show = 0 ~calm             // 0 shut, 1 open
    follow wp_picker_show = if(wp_picker_open, 1, 0)
    //  The hexagon under the pointer is drawn again, on top, as a piece of liquid glass (see the end of the scene): it swells
    //  with a spring that overshoots, glides from one hexagon to the next, has a light sweep across it each time the pointer
    //  arrives, and its edge ripples (`liquid.wgsl`).
    shader liquid = file "liquid.wgsl"
    spring wp_picker_pop = 240, 14             // a spring that overshoots (about 17%): the snap out to the large size bounces
    text wp_picker_hex_img = ""               // the hovered hexagon's picture, from the logic
    image wp_picker_lens = from wp_picker_hex_img, 124, 143
    fact wp_picker_hx = 0                     // where the hovered hexagon is
    fact wp_picker_hy = 0
    prop wp_picker_hs = 0 ~wp_picker_pop            // 0 at rest, 1 hovered (it overshoots)
    prop wp_picker_lx = 0 ~quick
    prop wp_picker_ly = 0 ~quick
    prop wp_picker_sw = 0 ~calm               // the light sweep's progress, 0 to 1
    prop wp_picker_tx = 0 ~quick              // where the pointer is on the hovered tile, -0.5 to 0.5 across and down: the tilt follows it
    prop wp_picker_ty = 0 ~quick
    //  Every tile has its own spring for how hovered it is, so each one morphs from small to large (and back) with a bounce.
    repeat i in 0..200 {
        prop gt.$i = 0 ~wp_picker_pop
        follow gt.$i = if(wp_picker_hot == i and wp_picker_open, 1, 0)
    }
    follow wp_picker_hs = if(wp_picker_hot >= 0 and wp_picker_open, 1, 0)
    follow wp_picker_lx = wp_picker_hx
    follow wp_picker_ly = wp_picker_hy
    on change wp_picker_hot while wp_picker_hot >= 0 { wp_picker_sw: 0 ~40ms }
    on change wp_picker_hot while wp_picker_hot >= 0 { wp_picker_sw: 1 ~700ms after 60ms }
    on change wp_picker_open while not wp_picker_open { wp_picker_hot = -1 }
    on key Escape while wp_picker_open { wp_picker_open = false }
    //  The workspace overview (right-click the bar's workspace dots, or the launcher): a card for each of the five workspaces,
    //  listing the windows on it. The logic fills `ovw` a slot at a time (nine to a workspace, in order) from `hyprctl clients`, each with a
    //  picture of the window taken while its workspace was in front.
    model ovw max 45 { gx: number; gy: number; gc: number; gr: number; title: text; active: bool; used: bool; snap: bool; icon: image 37, 37; thumb: image 456, 257 }
    repeat i in 0..5 { fact ov_cnt.$i = 0 }   // how many windows each workspace has 
    fact ov_else = 0                          // windows that are not on one of the five (special workspaces)
    fact ov_open = false
    event ov_toggle ->
    event ov_move ->                          // a window dropped on another workspace: its slot (and `ov_col`, the column)
    fact ov_drag = -1                         // the tile being held
    fact ov_col = 0                           // the column it was dropped on
    fact ov_dx = 0                            // how far it has been dragged
    fact ov_dy = 0
    fact ov_hot = -1                          // the tile under the pointer
    event ov_focus ->
    prop ov_show = 0 ~calm
    follow ov_show = if(ov_open, 1, 0)
    on key Escape while ov_open { ov_open = false }
    on change ov_open while not ov_open { ov_drag = -1; ov_dx = 0; ov_dy = 0; ov_hot = -1 }
    //  The authentication dialog. Vitreus is this session's polkit agent (bin/vitreus-polkit-agent, which the logic starts): when
    //  something asks for admin rights, the agent sets `pk_open` and the texts below; when Authenticate is pressed it reads the
    //  password out of `pk_pw` itself and clears the field.
    fact pk_open = false
    fact pk_busy = false            // polkit's helper is checking the password
    fact pk_shake = false           // the last password was wrong (and, with it, `pk_error` is showing)
    text pk_message = ""            // what polkit says: "Authentication is required to ..."
    text pk_user = ""               // whose password it asks for
    text pk_error = ""
    text pk_pw = ""                 // the password field
    fact pk_go = false              // Enter or Authenticate was pressed: the agent sees it, reads the field, and puts this back
    prop pk_show = 0 ~calm
    prop pk_sk = 0 ~pop             // the card's shake when the password is wrong
    follow pk_show = if(pk_open, 1, 0)
    on change pk_open while pk_open { focus pk_pw }
    on change pk_shake while pk_shake { pk_sk: -1 ~30ms }
    on change pk_shake while pk_shake { pk_sk: 0 ~450ms after 70ms }
    //  Everything here is the scene's own, so the dialog can always be put away: closing it (`pk_open` false) is what cancels the
    //  request, which the agent notices by asking; nothing has to get through the logic.
    on key Escape while pk_open { pk_open = false }
    on submit pk_pw { pk_go = true }
    //  Settings > System monitor. While that page is showing the logic runs bin/vitreus-sysmon, which prints what the machine is doing once a
    //  second; the logic turns it into the facts, texts and models below (nothing runs while the page is shut). The numbers that draw
    //  something are 0 to 1; the `*_p` springs smooth them so a gauge glides between readings.
    fact sm_scroll_to = 0
    prop sm_scroll = 0 ~quick
    follow sm_scroll = sm_scroll_to
    fact sm_cpu = 0                     // total CPU load, 0..1
    fact sm_mem_f = 0                   // memory in use
    fact sm_cache_f = 0                 // and in caches (which can be given back)
    fact sm_swap_f = 0
    fact sm_gpu_on = false              // a GPU that reports itself
    fact sm_gpu_f = 0                   // its load
    fact sm_vram_f = 0                  // its memory
    fact sm_pw_f = 0                    // its power draw against its limit
    prop sm_cpu_p = 0 ~calm
    prop sm_mem_p = 0 ~calm
    prop sm_cache_p = 0 ~calm
    prop sm_swap_p = 0 ~calm
    prop sm_gpu_p = 0 ~calm
    prop sm_vram_p = 0 ~calm
    prop sm_pw_p = 0 ~calm
    follow sm_cpu_p = sm_cpu
    follow sm_mem_p = sm_mem_f
    follow sm_cache_p = sm_cache_f
    follow sm_swap_p = sm_swap_f
    follow sm_gpu_p = sm_gpu_f
    follow sm_vram_p = sm_vram_f
    follow sm_pw_p = sm_pw_f
    text sm_host = ""
    text sm_cpu_name = ""
    text sm_kernel = ""
    text sm_uptime = ""
    text sm_load = ""
    text sm_cpu_txt = "0%"
    text sm_cpu_meta = ""               // 3.2 GHz · 46°C
    text sm_threads = ""
    text sm_mem_pct = "0%"
    text sm_mem_total = ""
    text sm_mem_used = ""
    text sm_mem_cache = ""
    text sm_mem_free = ""
    text sm_swap_txt = ""
    text sm_gpu_name = ""
    text sm_gpu_txt = "0%"
    text sm_gpu_vram = ""
    text sm_gpu_power = ""
    text sm_gpu_temp = ""
    text sm_gpu_fan = ""
    text sm_gpu_clock = ""
    text sm_iface = ""
    text sm_rx_txt = ""
    text sm_tx_txt = ""
    text sm_rx_total = ""
    text sm_tx_total = ""
    text sm_dr_txt = ""
    text sm_dw_txt = ""
    text sm_fans = ""
    model sm_core max 32 { pct: number }
    model sm_hist max 60 { cpu: number; mem: number; gpu: number; rx: number; tx: number; dr: number; dw: number }
    model sm_mnt max 6 { name: text; info: text; pct: number }
    model sm_tmp max 8 { label: text; txt: text; f: number; heat: number }
    model sm_proc max 8 { name: text; cpu_txt: text; mem_txt: text; cpu: number }
    //  Settings > Notifications (see "Notification rules and sounds" in vitreus.luau): the global switches and default sound, the apps that
    //  have sent something, and the rules of the one that is open.
    fact nt_scroll_to = 0
    prop nt_scroll = 0 ~quick
    follow nt_scroll = nt_scroll_to
    fact ntg_sounds = true             // a sound when one is shown
    fact ntg_crit = true               // critical ones ignore Do Not Disturb
    fact ntg_snd = 0                  // the default sound, 0..7
    fact nta_sel = -1                 // the app whose rules are open (its row), -1 none
    fact nta_count = 0
    fact nta_mute = false
    fact nta_silent = false
    fact nta_bypass = false
    fact nta_hide = false
    fact nta_urg = 0                  // 0 as the app sent it, 1 low, 2 normal, 3 critical
    fact nta_to = 0                   // 0 the usual, 1 4 s, 2 8 s, 3 15 s, 4 until dismissed
    fact nta_snd = 0                  // 0 the default sound, else 1..8
    fact nta_has_rule = false
    text nta_name = ""
    text nta_explain = ""
    model nta_apps max 14 { name: text; info: text; rule: bool }
    event nta_pick ->
    event nta_flag ->
    event nta_urgency ->
    event nta_timeout ->
    event nta_sound ->
    event nta_reset ->
    event ntg_flag ->
    event ntg_sound ->
    event nt_test ->
    prop ntk0 = 0 ~quick
    prop ntk1 = 0 ~quick
    prop ntk2 = 0 ~quick
    prop ntk3 = 0 ~quick
    prop ntk4 = 0 ~quick
    prop ntk5 = 0 ~quick
    follow ntk0 = if(ntg_sounds, 1, 0)
    follow ntk1 = if(ntg_crit, 1, 0)
    follow ntk2 = if(nta_mute, 1, 0)
    follow ntk3 = if(nta_silent, 1, 0)
    follow ntk4 = if(nta_bypass, 1, 0)
    follow ntk5 = if(nta_hide, 1, 0)
    event about_check ->
    event about_update ->
    event about_restart ->
    text hy_gaps_text = "5 px"
    text hy_round_text = "10 px"
    text hy_sens_text = "0.00"
    prop hy_k0 = 0 ~quick
    prop hy_k1 = 0 ~quick
    prop hy_k2 = 1 ~quick
    prop hy_k3 = 0 ~quick
    follow hy_k0 = if(hy_resize, 1, 0)
    follow hy_k1 = if(hy_tear, 1, 0)
    follow hy_k2 = if(hy_anim, 1, 0)
    follow hy_k3 = if(hy_nat, 1, 0)
    follow disp_auto_pill = if(disp_auto, 1, 0)
    follow disp_dd = if(disp_res_open, 1, 0)
    follow disp_scroll = disp_scroll_to
    follow disp_pn_s = disp_pcount
    on change dnd_on {
        dnd_wobble: -1 ~30ms
        dnd_wobble: 0 ~400ms after 60ms
    }
    follow mshow = if(media_on, 1, 0)
    follow media_open = if(media_on, 1, 0)
    follow playf = if(media.playing, 1, 0)
    on trackchange {
        swap: 0 ~16ms
        swap: 1 ~700ms after 30ms
    }
    follow dd = if(dd_open and panel == controls, 1, 0)
    follow vm = if(vm_open and panel == controls, 1, 0)
    follow mvis = if(mixer.count > 0 or vm_open, 1, 0)
    on launch_toggle { panel = if(panel == launch, none, launch) }
    on settings_toggle { panel = if(panel == settings, none, settings) }
    on change panel { dd_open = false; vm_open = false; panel_sub = none; disp_res_open = false; disp_scroll_to = 0; sm_scroll_to = 0; nt_scroll_to = 0; lk_scroll_to = 0; wm_scroll_to = 0 }
    on change set_page { disp_res_open = false; disp_scroll_to = 0; sm_scroll_to = 0; nt_scroll_to = 0; lk_scroll_to = 0; wm_scroll_to = 0; emit hy_refresh; emit wm_refresh }
    on change panel { tasks_watch = panel == player }
    on pick_out { dd_open = false }
    follow pulse = bass
    //  Every time the bass hits hard, a wave is born at the player controls (the
    //  bar's shader reads `ring` as how far it has travelled). It
    //  has to fall back below the threshold before the next one can be born.
    on change bass > 0.6 while bass > 0.6 {
        ring_mid: 0 ~0ms
        ring: 0 ~16ms
        ring: 1 ~1100ms after 30ms
    }

    //  One number scales the whole shell. The exclusive zone (`reserve` above) is
    //  the bar and a little air: 8 + bar.h + 6.
    let u = 1.35                    // (the icon models are declared at their size times this: 20 → 27, 22 → 30, 26 → 35)
    let cu = 1.5525                  // u * 1.15: the control center, the calendar and the player and tray are laid out 15% larger than the rest
    let pu = 1.6875                  // u * 1.25: the Settings and the launcher are laid out 25% larger than the rest, at real size (not zoomed)
    //  One reminder of the chosen day: a circle to tick it off, its time, its words, a cross.
    component CalRow(e: record, tick: event, gone: event) {
        //  30 px tall at least, and as tall as its title needs: a reminder wraps onto more lines rather
        //  than being cut short with an ellipsis. Whole pixels (a row at 22 units, x 1.35, sits on a
        //  fraction of a pixel, and text drawn between pixels comes out soft), and the text and the
        //  ring are put on whole pixels too. The ring, time and cross stay level with the first line.
        size: 154 * cu, max(30, floor(14 + wrap.height + 0.5))
        let rowh = max(30, floor(14 + wrap.height + 0.5))
        zone box touch { from: 0, 0; size: 154 * cu, rowh; corner: 8 * cu }
        box { from: 0, 0; size: 154 * cu, rowh; corner: 8 * cu; color: ink; opacity: 6% + 7% * touch.hover }
        ellipse { at: 15, 15; radius: 5.5 * cu; stroke: 1.3 * cu; color: mint; opacity: if(e.done, 0, 85%) }
        ellipse { at: 15, 15; radius: 5.5 * cu; color: mint; opacity: if(e.done, 100%, 0) }
        path { at: 15, 15; stroke: 1.4 * cu; color: onmint; opacity: if(e.done, 100%, 0); move -2.5 * cu, 0; line -0.5 * cu, 2.2 * cu; line 3 * cu, -2.4 * cu }
        text e.time { at: floor(22 * cu + 0.5), 15; anchor: left center; size: 11.5; weight: 600; width: 34 * cu; lines: 1; color: mint; opacity: if(e.done, 40%, 100%); family: "Space Grotesk" }
        column wrap {
            at: floor(56 * cu + 0.5), 7
            text e.title { size: 13; width: 74 * cu; lines: 5; color: ink; opacity: if(e.done, 40%, 100%); family: "Space Grotesk" }
        }
        line { from: 137 * cu, 15 - 3 * cu; to: 143 * cu, 15 + 3 * cu; width: 1.4 * cu; color: ink; opacity: 22% + 60% * touch.hover }
        line { from: 143 * cu, 15 - 3 * cu; to: 137 * cu, 15 + 3 * cu; width: 1.4 * cu; color: ink; opacity: 22% + 60% * touch.hover }
        zone box check_z { at: 15, 15; size: 22 * cu, 30; corner: 11 * cu; cursor: pointer }
        zone box gone_z { at: 140 * cu, 15; size: 20 * cu, 30; corner: 10 * cu; cursor: pointer }
        on press check_z { emit tick(e.index) }
        on press gone_z { emit gone(e.index) }
    }

    //  One row of the output dropdown: a dot if it is the current one, its name.
    component OutRow(f: record, pick: event) {
        size: 276 * cu, floor(28 * cu + 0.5)
        zone box touch { from: 0, 0; size: 276 * cu, 28 * cu; corner: 10 * cu; cursor: pointer; active: dd > 0.05 }
        box { from: 0, 0; size: 276 * cu, 28 * cu; corner: 10 * cu; color: ink
              opacity: if(f.current, 12%, 0%) + 9% * touch.hover }
        ellipse { at: 14 * cu, 14 * cu; radius: 3 * cu; color: mint; opacity: if(f.current, 100%, 0%) }
        text f.name { at: floor(28 * cu + 0.5), floor(14 * cu + 0.5); anchor: left center; size: 15.5; width: 236 * cu; lines: 1
                      color: ink; family: "Space Grotesk" }
        on press touch { emit pick(f.index) }
    }

    //  One row of the Wi-Fi window: a dot if it's the one in use, its name, and
    //  what tapping it means right now. A secured network no password is known
    //  for yet opens the join field instead of trying to connect outright.
    //  Tapping a row never acts by itself - it only opens what's underneath it,
    //  right there: a password field for a secured network not seen before, or
    //  Connect/Disconnect and Forget for anything else. `wifi_open_row` is the
    //  one index that's open at a time, so opening another closes the last one.
    component WifiRow(n: record, pick: event, forget: event, joingo: event) {
        //  Grows on a spring like the Bluetooth rows: wifi_sel slides between rows, wifi_extra is how open.
        size: 276 * cu, floor((30 + 44 * wifi_extra * clamp(1 - abs(n.index - wifi_sel), 0, 1)) * cu + 0.5)
        let isopen = wifi_open_row == n.index
        let open_t = wifi_extra * clamp(1 - abs(n.index - wifi_sel), 0, 1)
        //  One card: the network line on top, and what opens is the same plate carrying on below it.
        box { from: 0, 0; size: 276 * cu, (30 + 44 * open_t) * cu; corner: 10 * cu; color: ink; opacity: if(n.active, 12%, 0%) + 5% * open_t + 9% * touch.hover }
        zone box touch { from: 0, 0; size: 276 * cu, 30 * cu; corner: 10 * cu; cursor: pointer }
        ellipse { at: 14 * cu, 15 * cu; radius: 3 * cu; color: mint; opacity: if(n.active, 100%, 0%) }
        text n.ssid { at: floor(28 * cu + 0.5), floor(15 * cu + 0.5); anchor: left center; size: 14.5; width: 150 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        text "Connected" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: mint; family: "Space Grotesk"; show: n.active }
        text "Saved" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; family: "Space Grotesk"; show: n.known and not n.active }
        text "Secured" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; family: "Space Grotesk"; show: n.secure and not n.known and not n.active }
        text "Open" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; family: "Space Grotesk"; show: not n.secure and not n.known and not n.active }
        on press touch { wifi_open_row = if(isopen, -1, n.index) }

        group {
            show: open_t > 0.01
            opacity: clamp(open_t, 0, 1)
            move: 0, (clamp(open_t, 0, 1) - 1) * 8 * cu
            box { at: 138 * cu, 30 * cu; size: 240 * cu, 1 * cu; color: ink; opacity: 10% }
            //  A secured network never seen before: the password, right here.
            group {
                show: n.secure and not n.known and not n.active
                box { at: 106 * cu, 52 * cu; size: 184 * cu, 26 * cu; corner: 8 * cu; color: ink; opacity: 8% }
                input wifi_pw { at: floor(24 * cu + 0.5), floor(52 * cu - 6.3 * cu + 0.5); width: 164 * cu; size: 13; color: ink; family: "Space Grotesk"; secret: true; placeholder: "Password" }
                box { at: 234 * cu, 52 * cu; size: 56 * cu, 26 * cu; corner: 8 * cu; color: mint; opacity: 85% + 15% * joinbtn.hover }
                text "Join" { at: floor(234 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk" }
                zone box joinbtn { at: 234 * cu, 52 * cu; size: 56 * cu, 26 * cu; corner: 8 * cu; cursor: pointer }
                on press joinbtn { emit joingo(n.index) }
            }
            //  Open, and never joined: nothing to type, just a way in.
            group {
                show: not n.secure and not n.known and not n.active
                box { at: 138 * cu, 52 * cu; size: 248 * cu, 26 * cu; corner: 8 * cu; color: mint; opacity: 85% + 15% * connbtn.hover }
                text "Connect" { at: floor(138 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk" }
                zone box connbtn { at: 138 * cu, 52 * cu; size: 248 * cu, 26 * cu; corner: 8 * cu; cursor: pointer }
                on press connbtn { emit pick(n.index) }
            }
            //  Known, or the one in use: leave it, join it again, or forget it outright.
            group {
                show: n.known or n.active
                box { at: 76 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; color: if(n.active, ink, mint); opacity: if(n.active, 12% + 10% * primbtn.hover, 85% + 15% * primbtn.hover) }
                text "Disconnect" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; family: "Space Grotesk"; show: n.active }
                text "Connect" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk"; show: not n.active }
                zone box primbtn { at: 76 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; cursor: pointer }
                on press primbtn { emit pick(n.index) }
                box { at: 200 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; color: ink; opacity: 6% + 10% * forgetbtn.hover }
                text "Forget" { at: floor(200 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
                zone box forgetbtn { at: 200 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; cursor: pointer }
                on press forgetbtn { emit forget(n.index) }
            }
        }
    }

    //  One row of the Bluetooth window: connected (with its battery, if it says), paired, or just seen.
    //  Tapping it opens Connect/Disconnect and Forget underneath, the same as a Wi-Fi row.
    component BtRow(d: record, pick: event, forget: event) {
        //  The row grows and its buttons fade in on a spring, instead of jumping. One spring says which
        //  row is open (bt_sel, sliding between rows) and one how open (bt_extra): a row's share is how
        //  close it is to the selection.
        size: 276 * cu, floor((30 + (44 + bt_pf) * bt_extra * clamp(1 - abs(d.index - bt_sel), 0, 1)) * cu + 0.5)
        let isopen = bt_open_row == d.index
        let open_t = bt_extra * clamp(1 - abs(d.index - bt_sel), 0, 1)
        //  What a tap asked for and BlueZ has not answered yet: 1 connecting, 2 disconnecting, 3 it could not.
        let working = d.busy == 1 or d.busy == 2
        let pulse = if(working, 55% + 45% * sin(time * 260), 100%)
        //  One card: the device line on top, and what opens is the same plate carrying on below it,
        //  with a hairline between, not a separate strip of buttons.
        box { from: 0, 0; size: 276 * cu, (30 + (44 + bt_pf) * open_t) * cu; corner: 10 * cu; color: ink; opacity: if(d.connected, 12%, 0%) + 5% * open_t + 9% * touch.hover }
        box { from: 0, 0; size: 276 * cu, (30 + (44 + bt_pf) * open_t) * cu; corner: 10 * cu; color: mint; opacity: if(working, 4% + 6% * pulse, 0%) }
        zone box touch { from: 0, 0; size: 276 * cu, 30 * cu; corner: 10 * cu; cursor: pointer }
        ellipse { at: 14 * cu, 15 * cu; radius: 3 * cu; color: mint; opacity: if(working, pulse, if(d.connected and d.busy == 0, 100%, 0%)) }
        ellipse { at: 14 * cu, 15 * cu; radius: 3 * cu; color: #e0655a; opacity: if(d.busy == 3, 100%, 0%) }
        text d.name { at: floor(28 * cu + 0.5), floor(15 * cu + 0.5); anchor: left center; size: 14.5; width: 150 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        text "Connected" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: mint; family: "Space Grotesk"; show: d.connected and d.battery < 0 and d.busy == 0 }
        text number(d.battery * 100, 0, "%") { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: mint; family: "Space Grotesk"; show: d.connected and d.battery >= 0 and d.busy == 0 }
        text "Paired" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; family: "Space Grotesk"; show: d.paired and not d.connected and d.busy == 0 }
        text "Not paired" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; family: "Space Grotesk"; show: not d.paired and not d.connected and d.busy == 0 }
        text "Connecting…" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: mint; opacity: pulse; family: "Space Grotesk"; show: d.busy == 1 }
        text "Disconnecting…" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; opacity: pulse; family: "Space Grotesk"; show: d.busy == 2 }
        text "Couldn't connect" { at: floor(262 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: #e0655a; family: "Space Grotesk"; show: d.busy == 3 }
        on press touch { bt_open_row = if(isopen, -1, d.index) }

        group {
            show: open_t > 0.01
            opacity: clamp(open_t, 0, 1)
            move: 0, (clamp(open_t, 0, 1) - 1) * 8 * cu
            box { at: 138 * cu, 30 * cu; size: 240 * cu, 1 * cu; color: ink; opacity: 10% }
            group {
                show: not d.paired and not d.connected
                box { at: 138 * cu, 52 * cu; size: 248 * cu, 26 * cu; corner: 8 * cu; color: mint; opacity: if(working, 30% + 20% * pulse, 85% + 15% * pairbtn.hover) }
                text "Pair & Connect" { at: floor(138 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk"; show: not working }
                text "Pairing…" { at: floor(138 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; family: "Space Grotesk"; show: working }
                zone box pairbtn { at: 138 * cu, 52 * cu; size: 248 * cu, 26 * cu; corner: 8 * cu; cursor: pointer; active: not working }
                on press pairbtn { emit pick(d.index) }
            }
            group {
                show: d.paired or d.connected
                box { at: 76 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; color: if(d.connected, ink, mint); opacity: if(working, 12% + 12% * pulse, if(d.connected, 12% + 10% * primbtn.hover, 85% + 15% * primbtn.hover)) }
                text "Disconnect" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; family: "Space Grotesk"; show: d.connected and not working }
                text "Connect" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk"; show: not d.connected and not working }
                text "Connecting…" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; opacity: pulse; family: "Space Grotesk"; show: d.busy == 1 }
                text "Disconnecting…" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; opacity: pulse; family: "Space Grotesk"; show: d.busy == 2 }
                zone box primbtn { at: 76 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; cursor: pointer; active: not working }
                on press primbtn { emit pick(d.index) }
                box { at: 200 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; color: ink; opacity: 6% + 10% * forgetbtn.hover }
                text "Forget" { at: floor(200 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
                zone box forgetbtn { at: 200 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; cursor: pointer }
                on press forgetbtn { emit forget(d.index) }
            }
            //  What the connected device does with sound: a headset drops to the telephone profile (mono, mic on) on a call and nothing puts it back.
            //  Not more buttons: its own heading under a hairline, and a choice of radio dots, two to a line, so it reads as a setting of the device.
            group {
                show: d.connected and isopen and bt_pf_h > 0
                box { at: 138 * cu, 74 * cu; size: 240 * cu, 1 * cu; color: ink; opacity: 10% }
                text "AUDIO PROFILE" { at: floor(14 * cu + 0.5), floor(88 * cu + 0.5); anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }
                repeat i in 0..6 {
                    let px = (14 + mod(i, 2) * 128) * cu
                    let py = (108 + floor(i / 2) * 26) * cu
                    box { from: px, py - 12 * cu; size: 124 * cu, 24 * cu; corner: 8 * cu; color: ink; opacity: if(bt_po.$i, 7% * bt_pz.$i.hover, 0%) }
                    ellipse { at: px + 11 * cu, py; radius: 5 * cu; stroke: 1.3 * cu; color: if(bt_pa.$i, mint, ink); opacity: if(bt_po.$i, if(bt_pa.$i, 100%, 45%), 0%) }
                    ellipse { at: px + 11 * cu, py; radius: 2.6 * cu; color: mint; opacity: if(bt_pa.$i, 100%, 0%) }
                    text bt_pl.$i { at: floor(px + 23 * cu + 0.5), floor(py + 0.5); anchor: left center; size: 12; weight: 600; width: 98 * cu; lines: 1; color: if(bt_pa.$i, mint, ink); opacity: if(bt_pa.$i, 100%, 80%); family: "Space Grotesk"; show: bt_po.$i }
                    zone box bt_pz.$i { from: px, py - 12 * cu; size: 124 * cu, 24 * cu; corner: 8 * cu; cursor: pointer; active: bt_po.$i }
                    on press bt_pz.$i { emit bt_prof_set(i) }
                }
            }
        }
    }

    //  One running window: its app icon, its title (mint and
    //  bold if it has the keyboard), and a close button that shows while the row is under the pointer.
    //  A press gives it the keyboard; a middle press closes it.
    component TaskRow(t: record, focus: event, kill: event) {
        size: 288 * cu, floor(36 * cu + 0.5)          // whole pixels (with the list's gap), so the icon is not drawn between two
        zone box touch { from: 0, 0; size: 288 * cu, 36 * cu; corner: 12 * cu; cursor: pointer }
        box { from: 0, 0; size: 288 * cu, 36 * cu; corner: 12 * cu; color: ink; opacity: if(t.active, 11%, 5%) + 8% * touch.hover }
        image t.icon { at: floor(8 * cu + 0.5), floor(7 * cu + 0.5); size: floor(22 * cu + 0.5), floor(22 * cu + 0.5) }
        text t.title { at: floor(38 * cu + 0.5), floor(18 * cu + 0.5); anchor: left center; size: 14.5; width: 186 * cu; lines: 1; color: ink; family: "Space Grotesk"; show: not t.active }
        text t.title { at: floor(38 * cu + 0.5), floor(18 * cu + 0.5); anchor: left center; size: 14.5; weight: 700; width: 186 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: t.active }
        //  Which workspace it is on, in a small pill.
        box { at: 240 * cu, 18 * cu; size: 24 * cu, 18 * cu; corner: 9 * cu; color: ink; opacity: 8% }
        text t.ws { at: floor(240 * cu + 0.5), floor(18 * cu + 0.5); anchor: center; align: center; size: 12; weight: 700; width: 24 * cu; lines: 1; color: ink; opacity: 80%; family: "Space Grotesk" }
        ellipse { at: 268 * cu, 18 * cu; radius: 10 * cu; color: if(close_z.hover, alert, ink); opacity: (if(close_z.hover, 90%, 9%)) * touch.hover }
        line { from: 264.5 * cu, 14.5 * cu; to: 271.5 * cu, 21.5 * cu; width: 1.4 * cu; color: ink; opacity: 70% * touch.hover }
        line { from: 271.5 * cu, 14.5 * cu; to: 264.5 * cu, 21.5 * cu; width: 1.4 * cu; color: ink; opacity: 70% * touch.hover }
        zone box close_z { at: 268 * cu, 18 * cu; size: 22 * cu, 22 * cu; corner: 11 * cu; cursor: pointer }
        on press touch { emit focus(t.index); panel = none }
        on press middle touch { emit kill(t.index) }
        on press close_z { emit kill(t.index) }
    }

    //  One app in the mixer: its icon, its name, a small slider and its percentage, and a speaker that silences it.
    component MixRow(m: record, set: event, mute: event) {
        size: 288 * cu, floor(28 * cu + 0.5)          // whole pixels (with the list's gap), so the icon is not drawn between two
        opacity: if(m.corked, 55%, 100%)
        image m.icon { at: floor(10 * cu + 0.5), floor(5 * cu + 0.5); size: floor(20 * cu + 0.5), floor(20 * cu + 0.5) }
        text m.name { at: floor(38 * cu + 0.5), floor(13 * cu + 0.5); anchor: left center; size: 12.5; width: 78 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        box { from: 116 * cu, 11 * cu; size: 100 * cu, 6 * cu; corner: 3 * cu; color: deep; opacity: 60% }
        box { from: 116 * cu, 11 * cu; size: max(0.1, 100 * cu * clamp(m.pct / 100, 0, 1)), 6 * cu; corner: 3 * cu; color: if(m.muted, faint, mint); opacity: if(m.muted, 60%, 100%) }
        zone box track { at: 166 * cu, 14 * cu; size: 112 * cu, 24 * cu; cursor: pointer }
        on press track { emit set(m.index * 4 + clamp((local.x - 116 * cu) / (100 * cu), 0, 1)) }
        on drag track { emit set(m.index * 4 + clamp((local.x - 116 * cu) / (100 * cu), 0, 1)) }
        text number(m.pct, 0, "%") { at: floor(252 * cu + 0.5), floor(14 * cu + 0.5); anchor: right center; align: right; size: 12; width: 30 * cu; lines: 1; color: faint; family: "Space Grotesk" }
        path { at: 264 * cu, 14 * cu; color: if(m.muted, faint, mint); opacity: 85% + 15% * mzone.hover; move 0, -2 * cu; line 2.5 * cu, -2 * cu; line 5.5 * cu, -5 * cu; line 5.5 * cu, 5 * cu; line 2.5 * cu, 2 * cu; line 0, 2 * cu; close }
        line { from: 255 * cu, 8 * cu; to: 271 * cu, 20 * cu; width: 1.5 * cu; color: alert; opacity: if(m.muted, 100%, 0) }
        zone box mzone { at: 263 * cu, 14 * cu; size: 20 * cu, 24 * cu; cursor: pointer }
        on press mzone { emit mute(m.index) }
    }

    //  A result of the launcher: an icon (or a letter where there is none), its name, and a line of detail.
    //  Its width is the rows' width (`lw`): narrower where a preview sits beside the rows, and then it has no detail line.
    let lw = mix(430, 238, lpv) * pu
    component LRow(t: record, pick: event, del: event) {
        size: lw, 40 * pu
        //  How much the remove button shows (see the end of the row).
        let rm = if(t.deletable, max(max(touch.hover, rm_z.hover), if(t.sel, 0.45, 0)), 0)
        zone box touch { from: 0, 0; size: lw, 40 * pu; corner: 14 * pu; cursor: pointer }
        box { from: 0, 0; size: lw, 40 * pu; corner: 14 * pu; color: if(t.sel, mint, ink); opacity: if(t.sel, 20%, 4%) + 8% * touch.hover }
        image t.icon { at: floor(10 * pu + 0.5), floor(7 * pu + 0.5); size: floor(26 * pu + 0.5), floor(26 * pu + 0.5); show: t.hasicon }
        ellipse { at: 23 * pu, 20 * pu; radius: 13 * pu; color: mint; opacity: 16%; show: not t.hasicon }
        text t.glyph { at: floor(23 * pu + 0.5), floor(20 * pu + 0.5); anchor: center; align: center; size: 17.5; weight: 700; width: 26 * pu; lines: 1; color: mint; family: "Space Grotesk"; show: not t.hasicon }
        text t.title { at: floor(48 * pu + 0.5), floor(if(t.hasdesc, 14, 20) * pu + 0.5); anchor: left center; size: 18; weight: 600; width: lw - (58 + 96 * (1 - lpv) + if(t.deletable, 24, 0)) * pu; lines: 1; color: if(t.sel, mint, ink); family: "Space Grotesk" }
        text t.desc { at: floor(48 * pu + 0.5), floor(29 * pu + 0.5); anchor: left center; size: 13.5; width: lw - 62 * pu; lines: 1; color: faint; family: "Space Grotesk"; show: t.hasdesc }
        text t.sub { at: floor(lw - 10 * pu + 0.5), floor(20 * pu + 0.5); anchor: right center; align: right; size: 14; width: 90 * pu; lines: 1; color: faint; opacity: (1 - lpv) * (1 - rm); family: "Space Grotesk" }
        on press touch { emit pick(t.index) }
        //  The clipboard's rows can be removed: a small cross where the kind ("text", "image") is, while the row is under the pointer or chosen
        //  (Shift + Delete does the same for the chosen one). Declared last, so a press on it is its own and does not paste the row.
        ellipse { at: lw - 20 * pu, 20 * pu; radius: 11 * pu; color: if(rm_z.hover, alert, ink); opacity: (if(rm_z.hover, 90%, 10%)) * rm }
        line { from: lw - 24 * pu, 16 * pu; to: lw - 16 * pu, 24 * pu; width: 1.5 * pu; color: ink; opacity: 75% * rm }
        line { from: lw - 16 * pu, 16 * pu; to: lw - 24 * pu, 24 * pu; width: 1.5 * pu; color: ink; opacity: 75% * rm }
        zone box rm_z { at: lw - 20 * pu, 20 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: t.deletable }
        on press rm_z { emit del(t.index) }
    }

    //  One app that lives in the tray, with no window of its own: its icon and name. A press is what clicking its
    //  icon would do; the dots open its menu, and the pin keeps it on the bar.
    component TrayRow(t: record, click: event, pin: event, menu: event) {
        size: 288 * cu, floor(36 * cu + 0.5)          // whole pixels (with the list's gap), so the icon is not drawn between two
        zone box touch { from: 0, 0; size: 288 * cu, 36 * cu; corner: 12 * cu; cursor: pointer }
        box { from: 0, 0; size: 288 * cu, 36 * cu; corner: 12 * cu; color: ink; opacity: 5% + 8% * touch.hover }
        image t.icon { at: floor(8 * cu + 0.5), floor(7 * cu + 0.5); size: floor(22 * cu + 0.5), floor(22 * cu + 0.5) }
        text t.title { at: floor(38 * cu + 0.5), floor(18 * cu + 0.5); anchor: left center; size: 14.5; width: 184 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        //  Its menu: three dots.
        group {
            show: t.menu
            opacity: 45% + 55% * menu_z.hover
            ellipse { at: 232 * cu, 18 * cu; radius: 1.4 * cu; color: ink }
            ellipse { at: 238 * cu, 18 * cu; radius: 1.4 * cu; color: ink }
            ellipse { at: 244 * cu, 18 * cu; radius: 1.4 * cu; color: ink }
        }
        zone box menu_z { at: 238 * cu, 18 * cu; size: 24 * cu, 28 * cu; corner: 10 * cu; cursor: pointer; active: t.menu }
        //  The pin: shown on the row under the pointer, and always on a pinned one.
        group {
            opacity: if(t.pinned, 100%, 55% * touch.hover + 25% * pin_z.hover)
            ellipse { at: 266 * cu, 15 * cu; radius: 3.6 * cu; color: mint; opacity: if(t.pinned, 100%, 0%) }
            ellipse { at: 266 * cu, 15 * cu; radius: 3.6 * cu; stroke: 1.3 * cu; color: ink; opacity: if(t.pinned, 0%, 100%) }
            line { from: 266 * cu, 18.5 * cu; to: 266 * cu, 24 * cu; width: 1.4 * cu; color: if(t.pinned, mint, ink) }
        }
        zone box pin_z { at: 266 * cu, 18 * cu; size: 22 * cu, 28 * cu; corner: 10 * cu; cursor: pointer }
        on press touch { emit click(t.index); panel = none }
        on press menu_z { emit menu(t.index) }
        on press pin_z { emit pin(t.index) }
    }

    //  One entry of a tray app's menu: a check if it is ticked, its label (in a step for each level of submenu
    //  it is under), and an arrow if it opens more. A separator is a line.
    component TmRow(r: record, pick: event) {
        size: 288 * cu, floor(if(r.sep, 10, 28) * cu + 0.5)
        zone box touch { from: 0, 0; size: 288 * cu, 28 * cu; corner: 9 * cu; cursor: pointer; active: r.enabled and not r.sep }
        box { from: 0, 0; size: 288 * cu, 28 * cu; corner: 9 * cu; color: ink; opacity: if(r.sep, 0%, 9% * touch.hover) }
        box { at: 144 * cu, 5 * cu; size: 264 * cu, 1 * cu; color: ink; opacity: if(r.sep, 12%, 0%) }
        path { at: 15 * cu, 14 * cu; stroke: 1.6 * cu; color: mint; opacity: if(r.checked, 100%, 0%); move -3.5 * cu, 0.5 * cu; line -1 * cu, 3 * cu; line 4 * cu, -3.5 * cu }
        text r.label { at: floor((30 + r.depth * 14) * cu + 0.5), floor(14 * cu + 0.5); anchor: left center; size: 14.5; width: (226 - r.depth * 14) * cu; lines: 1; color: ink; opacity: if(r.enabled, 100%, 40%); show: not r.sep; family: "Space Grotesk" }
        path { at: 274 * cu, 14 * cu; stroke: 1.5 * cu; color: ink; rotate: if(r.open, 90deg, 0deg); opacity: if(r.kids, 60%, 0%); move -2 * cu, -3.5 * cu; line 2 * cu, 0; line -2 * cu, 3.5 * cu }
        on press touch { emit pick(r.index) }
    }

    //  A tray app's icon on the bar: a left click is what clicking it would do, a right click opens its menu.
    component BarTray(t: record, click: event, menu: event) {
        size: floor(18 * u + 0.5), floor(18 * u + 0.5)
        box { at: 9 * u, 9 * u; size: 26 * u, 26 * u; corner: 8 * u; color: ink; opacity: 14% * touch.hover * bs.tray }
        image t.icon { at: 0, 0; size: floor(18 * u + 0.5), floor(18 * u + 0.5); opacity: (78% + 22% * touch.hover) * bs.tray }
        zone box touch { at: 9 * u, 9 * u; size: 24 * u, 30 * u; cursor: pointer; active: bs.tray > 0.5 }
        on press touch { emit click(t.index) }
        on press right touch { emit menu(t.index) }
    }

    //  A notification's button (Reply, Mark read…): a small pill with its label.
    component NtAct(a: record, click: event) {
        size: floor(82 * u + 0.5), floor(26 * u + 0.5)
        zone box touch { from: 0, 0; size: 82 * u, 26 * u; corner: 8 * u; cursor: pointer }
        box { from: 0, 0; size: 82 * u, 26 * u; corner: 8 * u; color: if(touch.hover, mint, ink); opacity: if(touch.hover, 100%, 8%) }
        text a.label { at: floor(41 * u + 0.5), floor(13 * u + 0.5); anchor: center; align: center; size: 12.5 * u; weight: 700; width: 74 * u; lines: 1; color: if(touch.hover, onmint, ink); family: "Space Grotesk" }
        on press touch { emit click(a.index) }
    }

    //  One wallpaper in the gallery: its picture in rounded corners, a ring when it is the one in use.
    component WpThumb(t: record, pick: event) {
        size: 96 * pu, 54 * pu
        zone box touch { from: 0, 0; size: 96 * pu, 54 * pu; corner: 8 * pu; cursor: pointer }
        //  The pictures are cropped to 16:9 in a cache by the logic, so every tile is the same.
        group {
            clip inset 0 box { from: 0, 0; size: 96 * pu, 54 * pu; corner: 8 * pu }
            image t.thumb { at: 0, 0; size: 96 * pu, 54 * pu }
        box { from: 0, 0; size: 96 * pu, 54 * pu; color: ink; opacity: 14% * touch.hover }
        }
        box { from: 0, 0; size: 96 * pu, 54 * pu; corner: 8 * pu; stroke: 2 * pu; color: mint; opacity: if(wp_sel == t.index, 100%, 0) }
        on press touch { emit pick(t.index) }
    }

    //  A weather icon, drawn from shapes (there is no icon font): `kind` 0 clear · 1 partly cloudy · 2 cloud ·
    //  3 fog · 4 rain · 5 snow · 6 storm. The cloud is `cloud`; the sun, rain, snow and bolt are `sun`.
    component WxIcon(kind: number, cloud: color = ink, sun: color = mint) {
        size: 26 * cu, 20 * cu
        //  clear
        group {
            show: kind == 0
            ellipse { at: 13 * cu, 10 * cu; radius: 4.6 * cu; color: sun }
            repeat i in 0..8 {
                group {
                    pivot: 13 * cu, 10 * cu
                    rotate: i * 45deg
                    box { at: 13 * cu, 10 * cu - 7.8 * cu; size: 1.7 * cu, 3 * cu; corner: 0.8 * cu; color: sun }
                }
            }
        }
        //  partly cloudy: a small sun behind a cloud
        group {
            show: kind == 1
            ellipse { at: 8.5 * cu, 7.5 * cu; radius: 3.4 * cu; color: sun }
            repeat i in 0..8 {
                group {
                    pivot: 8.5 * cu, 7.5 * cu
                    rotate: i * 45deg
                    box { at: 8.5 * cu, 7.5 * cu - 5.9 * cu; size: 1.4 * cu, 2.2 * cu; corner: 0.7 * cu; color: sun }
                }
            }
            ellipse { at: 10 * cu, 13 * cu; radius: 3.6 * cu; color: cloud }
            ellipse { at: 15 * cu, 11.5 * cu; radius: 4.6 * cu; color: cloud }
            ellipse { at: 19 * cu, 13.5 * cu; radius: 3.2 * cu; color: cloud }
            box { at: 14.5 * cu, 15.5 * cu; size: 13 * cu, 4.5 * cu; corner: 2.2 * cu; color: cloud }
        }
        //  the cloud alone, and the cloud that rain, snow and storm hang from
        group {
            show: kind == 2 or kind == 4 or kind == 5 or kind == 6
            let cy0 = if(kind == 2, 10, 7.5) * cu
            ellipse { at: 9 * cu, cy0 + 1 * cu; radius: 4 * cu; color: cloud }
            ellipse { at: 14 * cu, cy0 - 1.5 * cu; radius: 5 * cu; color: cloud }
            ellipse { at: 18.5 * cu, cy0 + 1 * cu; radius: 3.6 * cu; color: cloud }
            box { at: 13.5 * cu, cy0 + 3 * cu; size: 14 * cu, 5 * cu; corner: 2.5 * cu; color: cloud }
        }
        //  fog
        group {
            show: kind == 3
            box { at: 13 * cu, 5.5 * cu; size: 17 * cu, 2 * cu; corner: 1 * cu; color: cloud }
            box { at: 13 * cu, 10 * cu; size: 13 * cu, 2 * cu; corner: 1 * cu; color: cloud }
            box { at: 13 * cu, 14.5 * cu; size: 17 * cu, 2 * cu; corner: 1 * cu; color: cloud }
        }
        //  rain
        group {
            show: kind == 4
            line { from: 8.5 * cu, 14 * cu; to: 7 * cu, 18 * cu; width: 1.5 * cu; color: sun }
            line { from: 13.5 * cu, 14 * cu; to: 12 * cu, 18 * cu; width: 1.5 * cu; color: sun }
            line { from: 18.5 * cu, 14 * cu; to: 17 * cu, 18 * cu; width: 1.5 * cu; color: sun }
        }
        //  snow
        group {
            show: kind == 5
            ellipse { at: 8 * cu, 15.5 * cu; radius: 1.3 * cu; color: sun }
            ellipse { at: 13 * cu, 17.5 * cu; radius: 1.3 * cu; color: sun }
            ellipse { at: 18 * cu, 15.5 * cu; radius: 1.3 * cu; color: sun }
        }
        //  storm: a bolt
        path {
            show: kind == 6
            at: floor(13 * cu + 0.5), floor(11 * cu + 0.5)
            color: sun
            move 1.5 * cu, 0
            line -2.5 * cu, 4.5 * cu
            line 0.2 * cu, 4.5 * cu
            line -1.2 * cu, 4 * cu
            line 4 * cu, -5.5 * cu
            line 0.5 * cu, -5.5 * cu
            close
        }
    }

    //  One day of the forecast: its name, its icon, its high and its low. Today is in the accent.
    component WxDay(d: record) {
        size: floor(42 * cu + 0.5), floor(50 * cu + 0.5)
        text d.label { at: floor(21 * cu + 0.5), floor(7 * cu + 0.5); anchor: center; align: center; size: 11; weight: 700; width: 40 * cu; lines: 1; color: if(d.today, mint, faint); family: "Space Grotesk" }
        column icon_col { at: 8 * cu, 15 * cu; WxIcon(d.kind, if(d.today, mint, ink), mint) }
        text d.hi { at: floor(12 * cu + 0.5), floor(42 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 700; width: 20 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        text d.lo { at: floor(31 * cu + 0.5), floor(42 * cu + 0.5); anchor: center; align: center; size: 11.5; width: 20 * cu; lines: 1; color: faint; family: "Space Grotesk" }
    }

    //  One notification in the history: its title and when it came, and under them the app and what it said.
    //  54 px tall, so a stack of them sits on whole pixels. A cross shows on hover, in place of the time.
    component NtHistRow(h: record, del: event) {
        size: 276 * cu, 54
        zone box touch { from: 0, 0; size: 276 * cu, 54; corner: 12 * cu }
        box { from: 0, 0; size: 276 * cu, 54; corner: 12 * cu; color: ink; opacity: 5% + 6% * touch.hover }
        text h.title { at: floor(12 * cu + 0.5), 17; anchor: left center; size: 14.5; weight: 700; width: 200 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        text h.sub { at: floor(12 * cu + 0.5), 37; anchor: left center; size: 12; width: 244 * cu; lines: 1; color: faint; family: "Space Grotesk" }
        text h.when { at: floor(264 * cu + 0.5), 17; anchor: right center; size: 11.5; color: faint; opacity: 100% - 100% * touch.hover; family: "Space Grotesk" }
        ellipse { at: floor(258 * cu + 0.5), 17; radius: 9 * cu; color: if(del_z.hover, alert, ink); opacity: (if(del_z.hover, 80%, 12%)) * touch.hover }
        line { from: floor(258 * cu + 0.5) - 3.2 * cu, 17 - 3.2 * cu; to: floor(258 * cu + 0.5) + 3.2 * cu, 17 + 3.2 * cu; width: 1.4 * cu; color: ink; opacity: 70% * touch.hover }
        line { from: floor(258 * cu + 0.5) + 3.2 * cu, 17 - 3.2 * cu; to: floor(258 * cu + 0.5) - 3.2 * cu, 17 + 3.2 * cu; width: 1.4 * cu; color: ink; opacity: 70% * touch.hover }
        zone box del_z { at: floor(258 * cu + 0.5), 17; size: 24 * cu, 24 * cu; corner: 12 * cu; cursor: pointer }
        on press del_z { emit del(h.index) }
    }

    let cx = screen.width / 2
    //  The bar down the left: a strip `lf.w` wide on the left and a frame `lf.t` thick round the other three edges, in the same glass. `lm` is how
    //  far over it is (the panels follow: `pcx` is where they are centred, with their left edge `lf.w` and a little in from the strip).
    let lm = clamp(bar_lm, 0, 1)
    let lf.t = 8 * u
    let lf.w = 46 * u
    let lf.x = lf.w / 2                                    // the strip's middle line, where its pieces sit
    //  Down the left a panel comes out of the strip like a drop and ends up in the middle of the screen. The Settings and the launcher are larger
    //  than the rest (`pu` instead of `u`, in their shapes, the contents and the rows they use: laid out at that size, not zoomed); `ku` is the
    //  unit of the one that is open. `lp.gx0` is where its left edge leaves the strip and `lp.gxf` where it lands;
    //  its left edge travels between them (`lp.xl`, as far as `dsl` of the way: a little after it starts to open), and its contents with it. The
    //  glass melts shapes that are near each other, so as it leaves a neck stretches and breaks: the drawers' blend (below) is what makes the neck.
    //  The surface is a fixed 1440 tall (`size: full, full` would lose the bar's reserved strip), so on a monitor of another height
    //  `screen.height` is not the screen. The logic reports the monitor's real height (`mon_h`, 0 until it is known, and always 0
    //  where it cannot ask): `vh` is what to centre on (never more than the surface, which is all there is to draw on), `mh` the
    //  monitor's own, for the compositor's coordinates.
    fact mon_h = 0
    let vh = if(mon_h > 0, min(mon_h, screen.height), screen.height)
    let mh = if(mon_h > 0, mon_h, screen.height)
    let yo = lm * (screen.height - vh) / 2                   // down the left the surface is not anchored to the top, so it is centred on the monitor: the monitor starts `yo` down it
    let vb = yo + vh                                         // the monitor's bottom edge, on the surface
    let vc = yo + vh / 2
    let ccx = mix(cx, (lf.w + screen.width - lf.t) / 2, lm)         // the middle of what can be seen: right of the strip, inside the frame
    let att = if(lp_k == 3 or lp_k == 4 or lp_k == 6 or lp_k > 6, 1, 0)           // the control center, the calendar, the volume and the notifications: they stay joined to the strip, and are not scaled
    let rgt = if(lp_k > 6, 1, 0)                                    // the volume and the notifications come out of the right frame, not the strip, and grow leftwards
    let edg = if(lp_k == 1 or lp_k == 2, 1, 0)                      // Settings rises out of the bottom frame's middle, the launcher lowers out of the top frame's: not from the strip
    let dsl = max(0, dtrav * 1.3 - 0.3)
    let ku = if(lp_k == 1 or lp_k == 2, pu, if(lp_k >= 3 and lp_k <= 6, cu, u))                      // the unit of the panel that is open: the Settings and the launcher are larger
    let lp.gx0 = lf.x
    let lp.gxf = ccx - (pw_x / 2 + 6.5) * ku
    let lp.xl = mix(lp.gx0 + (lp.gxf - lp.gx0) * dsl, lf.x, att)
    let pcx = mix(cx, mix(mix(ccx - (lp.gxf - lp.gx0) * (1 - dsl), ccx, edg), mix(lf.w + 6.5 * ku + pw_x * ku / 2, screen.width - lf.t - 6.5 * u - pw_x * u / 2, rgt), att), lm)
    //  Click away. The surface is the whole screen (its input region is only what has a zone, so the rest lets clicks through), and this
    //  zone, declared before everything else so that everything else wins over it, closes the panel on a press anywhere that is not
    //  the panel or the bar. A second surface for this would take Escape away from the panel, so it is done here.
    zone box away_z { at: screen.width / 2, screen.height / 2; size: screen.width, screen.height; active: (panel != none and panel != volume and panel != notif) or wp_picker_open or ov_open }
    on press away_z { panel = none; wp_picker_open = false; ov_open = false }
    on press right away_z { panel = none; wp_picker_open = false; ov_open = false }
    //  The tray's icons (the pinned apps, or all of them) are a piece of the bar like the others; the bar widens for them.
    let bar.gap = 12 * u
    let fw.tray = max(0, trn * 24 - 6) * u               // icons 18 wide, 6 apart
    let vw.tray = fw.tray * bs.tray
    let bw.tray = (fw.tray + bar.gap * min(1, trn)) * bs.tray
    let bar.w = 450 * u + bw.tray
    let bar.h = 40 * u
    let bar.y0 = 8 + bar.h / 2
    //  Down the left the panels come out of the strip at the height of their button: `pw_y` is where the open panel's top is (see `lp.top`), and
    //  the bar's "middle line" is half a bar above it, so that the first plate keeps the 12 it has under a panel's top (`bar.y` + 32).
    let bar.y = mix(bar.y0, pw_y - bar.h / 2, lm)
    let bar.rad = 14 * u                 // the bar's corner when shut: the same as the plates', not a full pill
    //  The bar's pieces sit in a row in the order Settings > Bar gives them (`bo.*`), 16 in from each end and
    //  `bar.gap` apart. Each one is as wide as what it draws (`fw.*`) and takes that and a gap (`bw.*`: less while
    //  it is being hidden, and the player's only while there is something playing); the title takes none, it is
    //  the stretch between the two ends: what comes before it is laid from the left edge, what comes after it
    //  from the right, so its gap is on the side towards the title.
    //  The clock's width is measured: the hour, the minutes and, at the edge, the day over the am/pm (both about
    //  the same width, so the column is as wide as the wider).
    let clock.col = max(caw.width, cdw.width)
    let bar.l = pcx - bar.w / 2 + 16 * u
    let bar.r = pcx + bar.w / 2 - 16 * u
    let fw.ws = 76 * u                   // five dots 15 apart, one of them the 20-wide pill
    let fw.media = 0                     // previous, play, next have no slot of their own: they sit inside the window title's button, top right
    let fw.set = 15 * u                  // the gear with its teeth
    let fw.sr = 12 * u                   // the magnifier, glass and handle
    let fw.ctl = 13 * u                  // the two sliders
    let fw.clock = chw.width + cmw.width + clock.col
    let vw.ws = fw.ws * bs.ws            // what each one draws, now
    let vw.media = fw.media * mshow * bs.media
    let vw.sr = fw.sr * bs.sr
    let vw.ctl = fw.ctl * bs.ctl
    let vw.clock = fw.clock * bs.clock
    let bw.ws = (fw.ws + bar.gap) * bs.ws
    let bw.media = (fw.media + bar.gap) * mshow * bs.media
    let bw.set = fw.set + bar.gap
    let bw.sr = (fw.sr + bar.gap) * bs.sr
    let bw.ctl = (fw.ctl + bar.gap) * bs.ctl
    let bw.clock = (fw.clock + bar.gap) * bs.clock
    //  How much of the row comes before each piece (`pre.*`) and after it (`post.*`).
    let pre.ws = if(bo.media < bo.ws, bw.media, 0) + if(bo.set < bo.ws, bw.set, 0) + if(bo.sr < bo.ws, bw.sr, 0) + if(bo.ctl < bo.ws, bw.ctl, 0) + if(bo.clock < bo.ws, bw.clock, 0) + if(bo.tray < bo.ws, bw.tray, 0)
    let post.ws = if(bo.media > bo.ws, bw.media, 0) + if(bo.set > bo.ws, bw.set, 0) + if(bo.sr > bo.ws, bw.sr, 0) + if(bo.ctl > bo.ws, bw.ctl, 0) + if(bo.clock > bo.ws, bw.clock, 0) + if(bo.tray > bo.ws, bw.tray, 0)
    let pre.media = if(bo.ws < bo.media, bw.ws, 0) + if(bo.set < bo.media, bw.set, 0) + if(bo.sr < bo.media, bw.sr, 0) + if(bo.ctl < bo.media, bw.ctl, 0) + if(bo.clock < bo.media, bw.clock, 0) + if(bo.tray < bo.media, bw.tray, 0)
    let post.media = if(bo.ws > bo.media, bw.ws, 0) + if(bo.set > bo.media, bw.set, 0) + if(bo.sr > bo.media, bw.sr, 0) + if(bo.ctl > bo.media, bw.ctl, 0) + if(bo.clock > bo.media, bw.clock, 0) + if(bo.tray > bo.media, bw.tray, 0)
    let pre.set = if(bo.ws < bo.set, bw.ws, 0) + if(bo.media < bo.set, bw.media, 0) + if(bo.sr < bo.set, bw.sr, 0) + if(bo.ctl < bo.set, bw.ctl, 0) + if(bo.clock < bo.set, bw.clock, 0) + if(bo.tray < bo.set, bw.tray, 0)
    let post.set = if(bo.ws > bo.set, bw.ws, 0) + if(bo.media > bo.set, bw.media, 0) + if(bo.sr > bo.set, bw.sr, 0) + if(bo.ctl > bo.set, bw.ctl, 0) + if(bo.clock > bo.set, bw.clock, 0) + if(bo.tray > bo.set, bw.tray, 0)
    let pre.sr = if(bo.ws < bo.sr, bw.ws, 0) + if(bo.media < bo.sr, bw.media, 0) + if(bo.set < bo.sr, bw.set, 0) + if(bo.ctl < bo.sr, bw.ctl, 0) + if(bo.clock < bo.sr, bw.clock, 0) + if(bo.tray < bo.sr, bw.tray, 0)
    let post.sr = if(bo.ws > bo.sr, bw.ws, 0) + if(bo.media > bo.sr, bw.media, 0) + if(bo.set > bo.sr, bw.set, 0) + if(bo.ctl > bo.sr, bw.ctl, 0) + if(bo.clock > bo.sr, bw.clock, 0) + if(bo.tray > bo.sr, bw.tray, 0)
    let pre.ctl = if(bo.ws < bo.ctl, bw.ws, 0) + if(bo.media < bo.ctl, bw.media, 0) + if(bo.set < bo.ctl, bw.set, 0) + if(bo.sr < bo.ctl, bw.sr, 0) + if(bo.clock < bo.ctl, bw.clock, 0) + if(bo.tray < bo.ctl, bw.tray, 0)
    let post.ctl = if(bo.ws > bo.ctl, bw.ws, 0) + if(bo.media > bo.ctl, bw.media, 0) + if(bo.set > bo.ctl, bw.set, 0) + if(bo.sr > bo.ctl, bw.sr, 0) + if(bo.clock > bo.ctl, bw.clock, 0) + if(bo.tray > bo.ctl, bw.tray, 0)
    let pre.clock = if(bo.ws < bo.clock, bw.ws, 0) + if(bo.media < bo.clock, bw.media, 0) + if(bo.set < bo.clock, bw.set, 0) + if(bo.sr < bo.clock, bw.sr, 0) + if(bo.ctl < bo.clock, bw.ctl, 0) + if(bo.tray < bo.clock, bw.tray, 0)
    let post.clock = if(bo.ws > bo.clock, bw.ws, 0) + if(bo.media > bo.clock, bw.media, 0) + if(bo.set > bo.clock, bw.set, 0) + if(bo.sr > bo.clock, bw.sr, 0) + if(bo.ctl > bo.clock, bw.ctl, 0) + if(bo.tray > bo.clock, bw.tray, 0)
    let pre.title = if(bo.ws < bo.title, bw.ws, 0) + if(bo.media < bo.title, bw.media, 0) + if(bo.set < bo.title, bw.set, 0) + if(bo.sr < bo.title, bw.sr, 0) + if(bo.ctl < bo.title, bw.ctl, 0) + if(bo.clock < bo.title, bw.clock, 0) + if(bo.tray < bo.title, bw.tray, 0)
    let post.title = if(bo.ws > bo.title, bw.ws, 0) + if(bo.media > bo.title, bw.media, 0) + if(bo.set > bo.title, bw.set, 0) + if(bo.sr > bo.title, bw.sr, 0) + if(bo.ctl > bo.title, bw.ctl, 0) + if(bo.clock > bo.title, bw.clock, 0) + if(bo.tray > bo.title, bw.tray, 0)
    let pre.tray = if(bo.ws < bo.tray, bw.ws, 0) + if(bo.media < bo.tray, bw.media, 0) + if(bo.set < bo.tray, bw.set, 0) + if(bo.sr < bo.tray, bw.sr, 0) + if(bo.ctl < bo.tray, bw.ctl, 0) + if(bo.clock < bo.tray, bw.clock, 0)
    let post.tray = if(bo.ws > bo.tray, bw.ws, 0) + if(bo.media > bo.tray, bw.media, 0) + if(bo.set > bo.tray, bw.set, 0) + if(bo.sr > bo.tray, bw.sr, 0) + if(bo.ctl > bo.tray, bw.ctl, 0) + if(bo.clock > bo.tray, bw.clock, 0)
    //  Each piece's middle: from the left edge before the title, from the right edge after it.
    let at.ws = if(bo.ws < bo.title, bar.l + pre.ws + vw.ws / 2, bar.r - post.ws - vw.ws / 2)
    let mc = if(bo.media < bo.title, bar.l + pre.media + vw.media / 2, bar.r - post.media - vw.media / 2)
    let set.x = if(bo.set < bo.title, bar.l + pre.set + fw.set / 2, bar.r - post.set - fw.set / 2)
    let sr.x = if(bo.sr < bo.title, bar.l + pre.sr + vw.sr / 2, bar.r - post.sr - vw.sr / 2)
    let ctl.x = if(bo.ctl < bo.title, bar.l + pre.ctl + vw.ctl / 2, bar.r - post.ctl - vw.ctl / 2)
    let tr.x = if(bo.tray < bo.title, bar.l + pre.tray + vw.tray / 2, bar.r - post.tray - vw.tray / 2)
    let at.clock = if(bo.clock < bo.title, bar.l + pre.clock + vw.clock / 2, bar.r - post.clock - vw.clock / 2)
    //  The clock's texts are set against its right edge: the day column, the minutes, the hour.
    let clock.r = at.clock + fw.clock / 2
    let clock.left = clock.r - clock.col - cmw.width - chw.width
    //  Where the window title starts, and how far it may reach: the stretch (the gaps are its neighbours').
    let win.x = bar.l + pre.title
    let win.w = max(0, bar.r - post.title - win.x)
    let room = 10 * u
    let roomv = 10 * cu                    // and down the left, where the dots are larger
    //  Down the left, top to bottom: the workspaces (their middle one at `lv.ws`), the tray apps, and from the foot up the clock (its
    //  hour at `lv.clk`, the minutes, am/pm, the weekday and the date under it), the controls, search and the gear, 32 apart. Whole pixels, for the texts.
    let lv.ws = yo + lf.t + 50 * cu
    let lv.tray = lv.ws + 30 * cu + 22 * cu
    let lv.clk = vb - lf.t - 91 * u
    let lv.ctl = lv.clk - 46 * u
    let lv.set = lv.ctl - 32 * u
    let lv.sr = lv.set - 32 * u
    //  The window title down the left, as in Synoptik's ActiveWindowCard: the app and its title turned a quarter anticlockwise (read from the foot
    //  up), centred in what the other pieces leave (`lv.tt` to `lv.bot`), with the player's buttons stacked at its top end while there is a player.
    let lv.tt = lv.tray + max(0, trn * 24 - 6) * u + 14 * u
    let lv.bot = lv.sr - 22 * u
    let lv.mc = 62 * cu * mshow * bs.media0            // what the player's buttons take, along the title
    let lv.span = clamp(max(vclw.width, vtiw.width), 0, max(1, lv.bot - lv.tt - lv.mc))     // how long the text is (cut where the stretch ends)
    let lv.y0 = clamp(vc - (lv.span + lv.mc) / 2, lv.tt, max(lv.tt, lv.bot - lv.span - lv.mc))     // the top of buttons and text together, centred as one on the middle of the screen, as near as the pieces above and below let it
    let lv.mid = lv.y0 + 31 * cu                       // the buttons' middle (previous nearest the text, 17 apart)
    let lv.tm = lv.y0 + lv.mc + lv.span / 2           // the text's middle

    //  The music only moves the bar: it fades out as the panel opens (gone by a third of
    //  the way), so an open panel sits still.
    let pv = pulse * (1 - min(1, drop * 3)) * (1 - lm)
    let pop = pv * 6 * u           // how far the bar swells on the beat
    //  The bounce on `dc`/`dk` (below) is free to swing past 1 on the way open - that
    //  overshoot is the spring showing - but a size can't go negative, so anything
    //  that scales a width or height reads the clamped version instead: it shrinks
    //  cleanly to nothing on the way closed rather than through it.
    let dc0 = max(0, dc)
    let dk0 = max(0, dk)
    let dm0 = max(0, dm)
    let do0 = max(0, do)
    let ds0 = max(0, ds)
    let dl0 = max(0, dl)
    let expand0 = max(0, expand)
    //  Marea's liquid: while a drawer comes out (or goes back), the neck that joins it to the bar is a bell,
    //  thickest halfway; the drawer is a little narrower there, as a falling drop is, and it is round at first
    //  and squares up as it grows (and rounds again as it goes). `*.bell` is 0 shut, 1 halfway, 0 open.
    let dk.bell = 4 * min(1, dk0) * (1 - min(1, dk0))
    let ds.bell = 4 * min(1, ds0) * (1 - min(1, ds0))
    let dl.bell = 4 * min(1, dl0) * (1 - min(1, dl0))
    let dc.bell = 4 * min(1, dc0) * (1 - min(1, dc0))
    let do.bell = 4 * min(1, do0) * (1 - min(1, do0))
    let dm.bell = 4 * min(1, dm0) * (1 - min(1, dm0))
    //  Both panels fill in their width quickly and then keep growing taller - so a
    //  plain `min(1, …)` on the width leaves it capped flat once that's done, and
    //  the bounce on the way to fully open (or the little one closing overshoots
    //  into) only ever shows up as a change in height. The `max(0, … - 1) * 0.6`
    //  term only wakes up past that cap, so the width bulges a little with the
    //  same overshoot instead of sitting there rigid while the height does all
    //  the springing.
    let card.w = bar.w * (min(1, dc0 * 3) + max(0, dc0 - 1) * 0.6)
    let card.h = 373 * cu * dc0        // 303, and 70 more for the weather strip
    //  The controls drawer: as wide as its plates and their margins need (288 + 2 x 12), coming
    //  out of the bar. It starts narrow and wide-open in height last, and widens to its place.
    //  It reaches up into the bar so the two can melt; `dk.hh` is how far down it goes.
    let dk.w = (120 + 192 * (min(1, dk0 * 1.6) + max(0, dk0 - 1) * 0.6)) * cu
    //  The plates stack from a shared cursor, each one naming where the one
    //  before it ended, so a plate that changes height (the media one, which
    //  shrinks to a sliver with nothing playing) pushes what is under it
    //  instead of leaving a gap or a pile-up. Unscaled: `u` is applied where
    //  each offset is finally used. Wi-Fi and Bluetooth are tiles side by side
    //  now, at the very top, so they cost one row's height between them.
    let tiles_top  = 8
    let tiles_h    = 72
    let tiles_bot  = tiles_top + tiles_h
    //  Do Not Disturb and Caffeine: a second row of tiles, the same size as the first.
    let tiles2_top = tiles_bot + 4
    let tiles2_bot = tiles2_top + tiles_h
    let bright_top = tiles2_bot + 4
    let bright_bot = bright_top + 64
    let vol_top    = bright_bot + 4
    let vol_bot    = vol_top + 64
    //  The player's plate is alone in its own panel now, at the top of it.
    let media_top  = 8
    let media_h    = mix(40, 96, media_open)
    let media_bot  = media_top + media_h
    //  Either tile can grow past the stack into its own window - as tall as its
    //  list actually is (one open row taller, while one is), up to a ceiling
    //  where the list itself starts scrolling instead of the window still
    //  growing to fit it.
    let wifi_rows_h = max(1, wifi_nets.count) * 34 - 4 + 44 * wifi_extra
    let bt_rows_h   = max(1, bt_devices.count) * 34 - 4 + (44 + bt_pf) * bt_extra
    let list_max    = 220
    //  The notifications window has a Do Not Disturb row and its timer chips above its list (84 more), and a
    //  shorter list. Its rows are 54 px with 6 between, whole pixels.
    let nt_rows_h = (max(1, nt_hist.count) * 60 - 6) / u
    let list_view_h = min(if(showing_sub == btview, bt_rows_h, if(showing_sub == notifview, nt_rows_h, wifi_rows_h)), if(showing_sub == notifview, 150, list_max))
    //  The Caffeine window is a row and two lines of chips (91 under its title), and has no list.
    let sub_content = if(showing_sub == cafview, 91, if(showing_sub == capview, 142, if(showing_sub == powview, 151, if(showing_sub == notifview, 84, 0) + list_view_h)))
    let sub_bot = tiles_top + 54 + sub_content + 16
    //  The output list drops over what is under the volume row; with more than a couple of outputs
    //  it reaches past the drawer, so the drawer grows to hold it while it is open.
    let dd.rows = clamp(outlist.count, 1, 6)
    let dd.extra = max(0, dd.rows * 30 - 28) * max(0, dd)
    //  The mixer hangs under the volume plate: a row of 32 per app (a line of words with none), and the drawer
    //  grows to hold it.
    //  The mixer is part of the volume card: the card grows by `mix.m` while it is open (a row of 32 per app, or a line of
    //  words with none, and room for the dots at the foot).
    let mix.m = if(mixer.count > 0, mixer.count * 32 + 8, 40)
    let vp.h = 64 + mix.m * clamp(vm, 0, 1)                // the volume card's height, unscaled
    let mix.extra = mix.m * max(0, vm)
    let content_bot = mix(vol_bot + max(dd.extra, mix.extra), sub_bot, expand0)
    let dk.hh = bar.h / 2 + (content_bot + 16) * cu * dk0 + max(0, sag)
    //  The player's panel: the same drawer as the controls, centred on the bar, and as tall as
    //  its one plate.
    //  The calendar's drawer: it falls as a narrow drop out of the bar and widens to exactly the bar's width as it
    //  lands, with the liquid neck of the other drawers while it is narrower (see `dc.bell`). It starts at the bar's
    //  middle, as they do, so the blend has the bar to melt into; as tall as the bar's lower half plus its content.
    let dc.w = (120 + 330 * (min(1, dc0 * 1.6) + max(0, dc0 - 1) * 0.6)) * cu
    let dc.hh = bar.h / 2 + card.h + max(0, sag)
    //  Once it is as wide as the bar (`f` 1) it must be a straight continuation of the bar's sides, so it moves its top up to
    //  the bar's top edge and stops blending: a blend there would puff the join out at the bar's corners.
    let dc.f = clamp((dc.w - bar.w + 24 * u) / (24 * u), 0, 1)
    let dc.top = mix(bar.y, bar.y - bar.h / 2, dc.f)
    //  The volume / notification drawer: 340 wide, as tall as its plate.
    //  The notification's plate is as tall as what is on it: the app line, the title (one line or more),
    //  the body if there is one (as many lines as it needs), and a row of buttons if it brought any,
    //  with 12 of air around. Never shorter than its icon tile. Each text measures itself once wrapped.
    let nt_th = max(24, ntt.height / u)
    let nt_bh = ntb.height / u
    let nt_content = if(nt_body_on, 39 + nt_th + nt_bh, 35 + nt_th)
    let nt_h = max(68, nt_content + if(nt_acts.count > 0, 34, 0) + 12)
    follow osd_h = if(osd_kind == note, nt_h, 64)
    //  The settings panel: 620 wide. A header (36), then the sidebar and the page side by side (352).
    //  How tall the settings page in view is (unscaled): Wallpaper, Glass, Display.
    //  The Display page: its cards down to the profiles one, which is as tall as its rows (none: a line).
    let disp.prows = max(24, disp_pn_s * 30)
    let disp.h = 460 + disp.prows + 114
    //  The System monitor page: the storage card has a row for each drive and the temperature card one for each sensor, and what is under
    //  them slides up as they shrink (see the page, which is generated: sm.ds and sm.dt are how much each has given back).
    //  The sidebar's SYSTEM group, top to bottom. To add a section, give it a row here (`side.NAME = previous row + 32`), draw its item
    //  like the others, and move `side.last` to its row: About is always the row after `side.last`, so it stays the final one, and
    //  Settings' minimum height follows it (see `set.h`).
    let side.hy = 226
    let side.wm = side.hy + 32
    let side.mon = side.wm + 32
    let side.nt = side.mon + 32
    let side.lk = side.nt + 32
    let side.last = side.lk
    let side.ab = side.last + 32
    let sm.ds = (4 - clamp(sm_mnt.count, 1, 4)) * 38
    let sm.dt = (8 - clamp(sm_tmp.count, 1, 8)) * 24
    let sm.h = 1536 - sm.ds - sm.dt
    let wm.h = 812                     // the Pleamar-WM page: to the bottom of its last card
    let lk.h = 728                     // the Lock screen page: its cards, to the bottom of the last
    //  The Notifications page: the apps card has a row for each app (up to 14), and the rules card is there while one is open.
    let nt.ds = (14 - clamp(nta_count, 1, 14)) * 36
    let nt.h = 246 + 552 - nt.ds + 8 + if(nta_sel >= 0, 456, 0) + 12
    //  A fixed height, whatever the page: the panel used to follow the page in view (262 to 456), so it resized, and moved what hangs from it, with
    //  every click in the sidebar. A page taller than this scrolls inside it (they have their scroll thumb and "More" cue); a shorter one has
    //  empty glass at its foot. It never goes below the sidebar's last row.
    let set.h = max(side.ab + 40, 456)
    //  A held Power button counts its second on this clock, and a recording pulses on it, so they need it too.
    let need_clock = ((wifi_scanning or bt_scanning or bt_working or caf_on or rec_on or pw_d0 or pw_d1 or pw_d2 or pw_d3 or pw_d4) and dk > 0.01) or (do > 0.01 and (osd_kind == vol or nt_urgent)) or (set_pgd > 0.01 and disp.h > 456)
    spin time by if(need_clock, 1, 0)
    let ss.w = (120 + 500 * (min(1, ds0 * 1.6) + max(0, ds0 - 1) * 0.6)) * pu
    let ss.hh = bar.h / 2 + (8 + 36 + 8 + set.h + 16) * pu * ds0 + max(0, sag)
    //  The launcher: a drop that widens to the bar's width as it lands, like the calendar. The search field (40), the
    //  rows (44 each, up to eight; seven where there is a preview beside them) and a line of hints.
    let dl.w = (120 + 330 * (min(1, dl0 * 1.6) + max(0, dl0 - 1) * 0.6)) * pu
    let dl.hh = bar.h / 2 + (112 + lr * 44) * pu * dl0 + max(0, sag)
    let dl.f = clamp((dl.w - bar.w + 24 * u) / (24 * u), 0, 1)     // as for the calendar
    let dl.top = mix(bar.y, bar.y - bar.h / 2, dl.f)
    let os.w = (120 + 220 * (min(1, do0 * 1.6) + max(0, do0 - 1) * 0.6)) * u
    let os.hh = bar.h / 2 + (8 + osd_h + 16) * u * do0 + max(0, sag)
    let dm.w = (120 + 192 * (min(1, dm0 * 1.6) + max(0, dm0 - 1) * 0.6)) * cu
    //  Under the player's plate, the running windows and then the tray apps, each a header and rows, scrolling past a few.
    let task_rows = min(max(1, tasks.count), 6)
    let tasks_top = media_bot + 8
    let tasks_list = tasks_top
    let tasks_bot = tasks_list + task_rows * 40 - 4
    let tray_rows = min(trays.count, 3)
    let tray_top = tasks_bot + 8
    let tray_list = tray_top + 26
    let panel_bot = if(trays.count > 0, tray_list + tray_rows * 40 - 4, tasks_bot)
    //  The tray menu: the app's plate (8..60), Open and Alt (66..92), then its menu from 100 (or a line saying it has none).
    let tm.list = min(tm_h, 224)
    let tm_bot = 100 + if(tm_has_menu, tm.list, 30) + 8
    let dm.hh = bar.h / 2 + (if(dm_mode == dmm_tray, tm_bot, panel_bot) + 16) * cu * dm0 + max(0, sag)
    let mdx = pcx
    //  Down the left, where the open panel is (`lp_k`: which was opened last), in its own coordinates: it ends up in the middle of the screen,
    //  except the volume, which is low, and the notification, which is high. It leaves the strip at the height of its button (`lp.btn`; the volume
    //  and the notification leave at their own height) and its middle travels from there to its place with the drop (`lp.cy`). `pw_y` follows its top.
    let lp.btn = if(lp_k == 1, vb - lf.t / 2, if(lp_k == 2, yo + lf.t / 2, if(lp_k == 3, lv.ctl, if(lp_k == 4, lv.clk + 30 * u, if(lp_k == 5, lv.tray + 9 * u, if(lp_k == 6, lv.tm, 0))))))
    //  Margins: the plates are 12 in from a drawer's top and bottom in their own layouts and 18.5 in from its sides, so a panel's content is moved by
    //  `lp.dy` and the drawer made `lp.dd` taller to make them 18.5 all round (Settings included).
    let lp.dy = if(lp_k == 1, 4.5, if(lp_k == 2 or lp_k == 3 or lp_k == 5 or lp_k == 6 or lp_k == 7 or lp_k == 8, 6.5, if(lp_k == 4, -0.5, 0))) * ku * lm
    let lp.dd = if(lp_k == 1, 11, if(lp_k == 2, 11, if(lp_k == 3 or lp_k == 5 or lp_k == 6 or lp_k == 7 or lp_k == 8, 13, if(lp_k == 4, 6, 0)))) * ku * lm
    let lp.hd = (if(lp_k == 1, (8 + 36 + 8 + set.h + 16) * pu, if(lp_k == 2, (112 + lr * 44) * pu, if(lp_k == 3, (content_bot + 16) * cu, if(lp_k == 4, 373 * cu, if(lp_k == 5 or lp_k == 6, (if(dm_mode == dmm_tray, tm_bot, panel_bot) + 16) * cu, (8 + osd_h + 16) * u)))))) + lp.dd
    //  Where it settles, as drawn (`ty`): Settings low, the launcher high, a good way from the middle, and clear of the frame; then back to the panel's
    //  own coordinates (the contents are scaled about the middle of the screen).
    let lp.ty = if(lp_k == 1, min(vc + 190 * u, vb - lf.t - 24 * u - lp.hd / 2), max(vc - 210 * u, yo + lf.t + 24 * u + lp.hd / 2))
    let lp.yf = if(lp_k == 1 or lp_k == 2, lp.ty, if(lp_k == 3 or lp_k == 4 or lp_k == 6, clamp(lp.btn, yo + lf.t + 24 * u + lp.hd / 2, vb - lf.t - 24 * u - lp.hd / 2), if(lp_k == 7, vb - lf.t - 24 * u - lp.hd / 2, if(lp_k == 8, yo + lf.t + 24 * u + lp.hd / 2, vc))))
    let lp.sy0 = if(lp_k > 6, lp.yf, lp.btn)
    let lp.gy0 = if(att > 0.5, lp.yf, lp.btn)
    let lp.cy = lp.gy0 + (lp.yf - lp.gy0) * dsl
    let lp.top = lp.cy - lp.hd / 2
    follow pw_y = lp.top
    on change panel {
        pq_sw = lm > 0.5 and pcur != none and panel != none and panel != pcur
        pending = if(pq_sw, panel, if(panel != none and panel != pending, none, pending))
        panel = if(pq_sw, none, panel)
        pcur = panel
        //  Which panel was opened last, and how wide it is: where the panels sit down the left follows it (see `lp.top`, `pcx`). Here, in the
        //  scene, not in the logic (its own popups, volume and notifications, set `panel` itself and nothing told it), and only once the panel
        //  is really being opened: a switch from one to another leaves the open one in its own shape until it has gone.
        lp_w = if(panel == settings, 620, if(panel == controls or panel == player or panel == tray, 312, if(panel == volume or panel == notif, 340, if(panel == calendar or panel == launch, 450, lp_w))))
        lp_k = if(panel == settings, 1, if(panel == launch, 2, if(panel == controls, 3, if(panel == calendar, 4, if(panel == tray, 5, if(panel == player, 6, if(panel == volume, 7, if(panel == notif, 8, lp_k))))))))
    }
    //  ...and the waiting one opens once the drop of the one before has gone back in (its `dtrav` is back to nothing). It is the compound that is
    //  watched, so that it also fires when the wait begins with the strip already at rest.
    on change dtrav < 0.03 and pending != none while dtrav < 0.03 and pending != none { panel = pending; pending = none }
    //  What a drop out of the strip is made of, as in Marea's (marea.plm, "the body"): the strip's edge bulges towards the drop while it holds it
    //  (`dj.sag`, most halfway), the neck is a bell that ends at nothing so that the thread breaks by itself (`dj.neck`), when it breaks two crests
    //  run along the edge (`dj.ripx`, `dj.riph`) and a small drop is left hanging from it for a moment (`dj.stray`), and the drop stretches with its
    //  speed (`dj.stretch`) and shakes (`wobble`) when it lets go. `dj.y0` is where it comes out: the panel's own vertical middle.
    let dj.out = clamp(dsl, 0, 1)
    let dj.tension = 4 * dj.out * (1 - dj.out)
    let dj.sag = max((26 * dj.tension + pbounce) * u * lm * (1 - att), 0.3)
    let dj.neck = 52 * u * 4 * dj.out * (1 - dj.out)
    let dj.ripx = (12 + 90 * prip) * u
    let dj.riph = 20 * u * (1 - prip) * clamp(prip * 6, 0, 1) * lm * (1 - att)
    let dj.stray = 10 * u * pstray * lm * (1 - att)
    let dj.stretch = clamp(vel(dtrav) * 0.07, 0, 0.5) * lm
    let dj.y0 = lp.sy0
    let dj.ey = if(lp_k == 1, vb - lf.t / 2, yo + lf.t / 2)     // the frame edge a drop comes out of (bottom for Settings, top for the launcher)
    let dj.es = if(lp_k == 1, -1, 1)                                  // and which way the small stray drop hangs from it: up, or down
    //  Those four shapes are never zero-size (a floor of 0.3 keeps them valid), so left in place they are a sliver on the strip's edge at the height of
    //  the panel last opened. They are only in play while a panel that drips is on its way or just after it (its ripples and stray drop), and
    //  off the screen the rest of the time (`show:` does not take a shape off the glass).
    let dj.act = if(lm > 0.5 and att < 0.5 and (dtrav > 0.02 or prip < 0.98 or pstray > 0.01 or abs(pbounce) > 0.2), 1, 0)
    let dj.px = if(dj.act > 0.5, 0, 30000)
    //  Each drawer's shape as it is drawn (`*.ex`, `*.ey` its middle, `*.ew`, `*.eh` its size). From the top bar it is the drawer above: it falls,
    //  widening on the way. Down the left it comes out sideways from the strip instead: it starts small and grows in both ways (`*.lf`, the same quick
    //  rise the width has above) around the panel's own vertical middle, and to the right, from the strip's middle to where the panel ends (`*.rt`, 6.5 past the plates' side: with the 6.5 in `pcx` it makes the margin all round (strip side, right, top) the same, 18.5; the calendar's and the launcher's are 450 wide here, not the bar's width, which grows with the tray icons). Its contents stay where
    //  they will end up, and the drawer's shape uncovers them (they are clipped to it).
    let dk.gl = mix(min(dtrav, dk0), dk0, att)
    let dk.lf = mix(min(1, dk0 * 1.6) + max(0, dk0 - 1) * 0.6, min(1, dk.gl * 1.6) + max(0, dk.gl - 1) * 0.6, lm)
    let dk.rt = mix(2 * (156 + 6.5) * cu, (lf.w - lf.x) + 325 * cu, att)
    let dk.gw = max(0.1, dk.rt * dk.lf)
    let dk.gh = (((content_bot + 16) * cu) + lp.dd + max(0, sag)) * dk.lf
    let dk.gx = mix(lp.xl + dk.gw / 2, ccx, edg)
    let dk.ew = mix(dk.w, dk.gw, lm)
    let dk.eh = mix(dk.hh, dk.gh, lm)
    let dk.ex = mix(pcx, dk.gx, lm)
    let dk.ey = mix(bar.y + dk.hh / 2, lp.cy, lm)
    let dc.gl = mix(min(dtrav, dc0), dc0, att)
    let dc.lf = mix(min(1, dc0 * 1.6) + max(0, dc0 - 1) * 0.6, min(1, dc.gl * 1.6) + max(0, dc.gl - 1) * 0.6, lm)
    let dc.rt = mix(2 * (225 + 6.5) * cu, (lf.w - lf.x) + 463 * cu, att)
    let dc.gw = max(0.1, dc.rt * dc.lf)
    let dc.gh = ((373 * cu) + lp.dd + max(0, sag)) * dc.lf
    let dc.gx = mix(lp.xl + dc.gw / 2, ccx, edg)
    let dc.ew = mix(dc.w, dc.gw, lm)
    let dc.eh = mix((bar.y + dc.hh - dc.top), dc.gh, lm)
    let dc.ex = mix(pcx, dc.gx, lm)
    let dc.ey = mix((dc.top + bar.y + dc.hh) / 2, lp.cy, lm)
    let ds.gl = min(dtrav, ds0)
    let ds.lf = mix(min(1, ds0 * 1.6) + max(0, ds0 - 1) * 0.6, min(1, ds.gl * 1.6) + max(0, ds.gl - 1) * 0.6, lm)
    let ds.rt = 2 * (310 + 6.5) * pu
    let ds.gw = max(0.1, ds.rt * ds.lf)
    let ds.gh = (((8 + 36 + 8 + set.h + 16) * pu) + lp.dd + max(0, sag)) * ds.lf
    let ds.gx = mix(lp.xl + ds.gw / 2, ccx, edg)
    let ds.ew = mix(ss.w, ds.gw, lm)
    let ds.eh = mix(ss.hh, ds.gh, lm)
    let ds.ex = mix(pcx, ds.gx, lm)
    let ds.ey = mix(bar.y + ss.hh / 2, lp.cy, lm)
    let dl.gl = min(dtrav, dl0)
    let dl.lf = mix(min(1, dl0 * 1.6) + max(0, dl0 - 1) * 0.6, min(1, dl.gl * 1.6) + max(0, dl.gl - 1) * 0.6, lm)
    let dl.rt = 2 * (225 + 6.5) * pu
    let dl.gw = max(0.1, dl.rt * dl.lf)
    let dl.gh = (((112 + lr * 44) * pu) + lp.dd + max(0, sag)) * dl.lf
    let dl.gx = mix(lp.xl + dl.gw / 2, ccx, edg)
    let dl.ew = mix(dl.w, dl.gw, lm)
    let dl.eh = mix((bar.y + dl.hh - dl.top), dl.gh, lm)
    let dl.ex = mix(pcx, dl.gx, lm)
    let dl.ey = mix((dl.top + bar.y + dl.hh) / 2, lp.cy, lm)
    let do.gl = mix(min(dtrav, do0), do0, att)
    let do.lf = mix(min(1, do0 * 1.6) + max(0, do0 - 1) * 0.6, min(1, do.gl * 1.6) + max(0, do.gl - 1) * 0.6, lm)
    let do.rt = mix(2 * (170 + 6.5) * u, mix((lf.w - lf.x) + 353 * u, lf.t + 379 * u, rgt), att)
    let do.gw = max(0.1, do.rt * do.lf)
    let do.gh = (((8 + osd_h + 16) * u) + lp.dd + max(0, sag)) * do.lf
    let do.gx = mix(mix(lp.xl + do.gw / 2, ccx, edg), screen.width + 26 * u * do.lf - do.gw / 2, rgt)
    let do.ew = mix(os.w, do.gw, lm)
    let do.eh = mix(os.hh, do.gh, lm)
    let do.ex = mix(pcx, do.gx, lm)
    let do.ey = mix(bar.y + os.hh / 2, lp.cy, lm)
    let dm.gl = mix(min(dtrav, dm0), dm0, att)
    let dm.lf = mix(min(1, dm0 * 1.6) + max(0, dm0 - 1) * 0.6, min(1, dm.gl * 1.6) + max(0, dm.gl - 1) * 0.6, lm)
    let dm.rt = mix(2 * (156 + 6.5) * cu, (lf.w - lf.x) + 325 * cu, att)
    let dm.gw = max(0.1, dm.rt * dm.lf)
    let dm.gh = (((if(dm_mode == dmm_tray, tm_bot, panel_bot) + 16) * cu) + lp.dd + max(0, sag)) * dm.lf
    let dm.gx = mix(lp.xl + dm.gw / 2, ccx, edg)
    let dm.ew = mix(dm.w, dm.gw, lm)
    let dm.eh = mix(dm.hh, dm.gh, lm)
    let dm.ex = mix(pcx, dm.gx, lm)
    let dm.ey = mix(bar.y + dm.hh / 2, lp.cy, lm)
    //  The control center opens when the pointer rests on its button, and closes when it has left the button and the drawer (a moment's grace, so
    //  that crossing the gap does not close it). It is quick launch, so it stays joined to the strip instead of dropping out of it.
    //  `cursor` is the mouse wherever it is, in the scene's coordinates.
    let ctl.onbtn = if(lm > 0.5 and cursor.x > 0 and cursor.x < lf.w and abs(cursor.y - lv.ctl) < 18 * u, 1, 0)
    //  What keeps it open is a fixed band, not the drawer as it is drawn: the drawer is as tall as what it holds (a sub-view, the mixer or the
    //  output list opening or closing) and sits where its height lets the frame clamp it, so what the pointer was on can end up outside the drawn
    //  one, and it closed under the pointer. The band is the drawer at its tallest (`ctl.cmax`: the main view with the larger of the output list and the
    //  mixer under the volume card, or the tallest sub-view, 312). It is placed the way the drawer is, and the drawer at its tallest covers it at any
    //  shorter height: its top only goes up and its foot only down as it grows. So it depends on how many outputs and apps there are, never on what is open.
    let ctl.cmax = max(vol_bot + max(dd.rows * 30 - 28, mix.m), 312)
    let ctl.zh = (ctl.cmax + 16) * cu + 13 * cu
    let ctl.zc = clamp(lv.ctl, yo + lf.t + 24 * u + ctl.zh / 2, vb - lf.t - 24 * u - ctl.zh / 2)
    let ctl.ondraw = if(lm > 0.5 and panel == controls and cursor.x > dk.ex - dk.ew / 2 - 4 and cursor.x < dk.ex + dk.ew / 2 + 4 and cursor.y > ctl.zc - ctl.zh / 2 - 4 and cursor.y < ctl.zc + ctl.zh / 2 + 4, 1, 0)
    prop ctl_arm = 0 ~120ms
    follow ctl_arm = ctl.onbtn
    prop ctl_hold = 0 ~280ms
    follow ctl_hold = max(ctl.onbtn, ctl.ondraw)
    on change ctl_arm > 0.9 while ctl_arm > 0.9 { panel = controls }
    on change ctl_hold < 0.05 while ctl_hold < 0.05 and panel == controls and lm > 0.5 { panel = none }
    //  The calendar the same way, from the clock.
    let cal.onbtn = if(lm > 0.5 and cursor.x > 0 and cursor.x < lf.w and abs(cursor.y - (lv.clk + 30 * u)) < 52 * u, 1, 0)
    let cal.ondraw = if(lm > 0.5 and panel == calendar and cursor.x > dc.ex - dc.ew / 2 - 4 and cursor.x < dc.ex + dc.ew / 2 + 4 and cursor.y > dc.ey - dc.eh / 2 - 4 and cursor.y < dc.ey + dc.eh / 2 + 4, 1, 0)
    prop cal_arm = 0 ~120ms
    follow cal_arm = cal.onbtn
    prop cal_hold = 0 ~280ms
    follow cal_hold = max(cal.onbtn, cal.ondraw)
    on change cal_arm > 0.9 while cal_arm > 0.9 { panel = calendar }
    on change cal_hold < 0.05 while cal_hold < 0.05 and panel == calendar and lm > 0.5 { panel = none }
    //  Where the contents hang from: the panel's old middle, so they keep their
    //  place when the panel grows to make room for the player.
    let cy = bar.y + bar.h / 2 + (6 + 125 * mix(drop, 1, lm)) * ku + lp.dy
    //  The controls' content hangs from here: 127 above `cy`, so the volume plate starts 12 under the
    //  bar and the drawer is only as tall as its two plates and their margins.
    let ck = cy - 127 * ku

    //  The whole bar, glass and all, is one group so the wave can bend it as one thing.
    group {
        shader: wave, pv, mix(clamp(ring, 0, 1), 1, lm), mix((mc - (pcx - bar.w / 2)) / bar.w, 0.5, clamp(ring_mid, 0, 1)), 0, 2.6 * u * (1 - min(1, drop * 2)) * (1 - lm), bar.w, 0, 0
        // ── the liquid ───────────────────────────────────────────────
        body {
            color: tint
            glass: glass_frost
            opacity: glass_op
            lens: false
            rim: 10% + 14% * pv
            shine: pointer
            shadow: 0, 1 + 6 * drop + 3 * pv, 6 + 14 * drop + 8 * pv, 8% + 16% * drop + 8% * pv, deep
            //  The bar is only the bar: it swells a little on the beat and nothing else. Every panel,
            //  the calendar included, is a drawer of its own that drops from it, below.
            box shell { at: mix(pcx, cx, lm), mix(bar.y0 + pop / 2, yo + lf.t / 2, lm); size: mix(bar.w + pv * 10 * u, screen.width, lm), mix(bar.h + pop, lf.t, lm); corner: mix(bar.rad, 0, lm) }
            //  Down the left: the strip, and the frame's other two edges, plain rectangles. The inside corners are rounded by a ring: a rounded
            //  rectangle drawn as an outline as thick as the frame, whose inner edge is the opening (its left side lies in the strip), so the corners
            //  are exact curves and the glass's edge light runs round them unbroken. The ring has NO NAME on purpose: a named shape takes clicks across
            //  its whole bounding box, and the ring's is the whole screen. The ring is 50 * u thicker than the frame, outwards, so that its outer curve is off
            //  the screen: inside the screen it made a one-pixel speck of edge light at the corners. When the left layout is not in it is moved 30000 px away
            //  (`show:` does not take it off the glass, and a ring thinned to a hair counts as a filled box and frosts the whole screen).
            //  The strip's side of the drip (see `dj.*`): all melted into the strip and the drawers, so that the neck and the bulge are not drawn, they are
            //  what the distances between the shapes make. Moved off the screen outside the left layout (`show:` does not take a shape off the glass).
            ellipse { at: mix(lf.w, ccx, edg) + dj.px, mix(dj.y0, dj.ey, edg); radius: 30 * u; scale: mix(dj.sag / (30 * u), 1, edg), mix(1, dj.sag / (30 * u), edg); blend: 16 * u * clamp(dj.sag / (6 * u), 0, 1) }
            ellipse { at: mix(lf.w, ccx - dj.ripx, edg) + dj.px, mix(dj.y0 - dj.ripx, dj.ey, edg); radius: 9 * u; scale: mix(max(dj.riph, 0.3) / (9 * u), 1, edg), mix(1, max(dj.riph, 0.3) / (9 * u), edg); blend: 8 * u * clamp(dj.riph / (3 * u), 0, 1) }
            ellipse { at: mix(lf.w, ccx + dj.ripx, edg) + dj.px, mix(dj.y0 + dj.ripx, dj.ey, edg); radius: 9 * u; scale: mix(max(dj.riph, 0.3) / (9 * u), 1, edg), mix(1, max(dj.riph, 0.3) / (9 * u), edg); blend: 8 * u * clamp(dj.riph / (3 * u), 0, 1) }
            ellipse { at: mix(lf.w + dj.stray * 0.7, ccx, edg) + dj.px, mix(dj.y0, dj.ey + dj.es * dj.stray * 0.7, edg); radius: max(dj.stray, 0.3); blend: 7 * u * clamp(dj.stray / (3 * u), 0, 1) }
            box lf_left { at: lf.w * lm / 2, vc; size: lf.w * lm, vh; show: lm > 0.004 }
            box lf_right { at: screen.width - lf.t * lm / 2, vc; size: lf.t * lm, vh; show: lm > 0.004 }
            box lf_bottom { at: cx, vb - lf.t * lm / 2; size: screen.width, lf.t * lm; show: lm > 0.004 }
            box { from: lf.w - (lf.t + 50 * u) / 2 + if(lm > 0.35, 0, 30000), yo + lf.t - (lf.t + 50 * u) / 2 + if(lm > 0.35, 0, 30000); size: screen.width - lf.t - lf.w + lf.t + 50 * u, vh - 2 * lf.t + lf.t + 50 * u; corner: 12 * u + (lf.t + 50 * u) / 2; stroke: lf.t * max(lm, 0.35) + 50 * u * lm }
            //  The drawer is a second shape in the same glass. `blend` melts it into the bar, so where the
            //  narrow drawer meets the wide bar there is a liquid neck, not a corner. It is only there
            //  while it has size: a zero-size shape would leave a stray shadow behind.
            box drawer { at: dk.ex, dk.ey; size: dk.ew * (1 + dj.stretch - 0.07 * dk.bell + 0.003 * wobble), dk.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble); corner: mix(min(dk.ew, dk.eh) / 2, 26 * u, clamp(dk0 * 1.6 - 0.1, 0, 1)); blend: mix((16 + 20 * dk.bell) * u * min(1, dk0 * 4), mix(dj.neck, (16 + 20 * dk.bell) * u * min(1, dk0 * 4), att), lm); show: dk0 > 0.004 }
            box cdrawer { at: dc.ex, dc.ey; size: dc.ew * (1 + dj.stretch - 0.07 * dc.bell + 0.003 * wobble), dc.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble); corner: mix(min(dc.ew, dc.eh) / 2, 26 * u, clamp(dc0 * 1.6 - 0.1, 0, 1)); blend: mix((16 + 20 * dc.bell) * u * min(1, dc0 * 4) * (1 - dc.f * (1 - lm)), mix(dj.neck, (16 + 20 * dc.bell) * u * min(1, dc0 * 4) * (1 - dc.f * (1 - lm)), att), lm); show: dc0 > 0.004 }
            box sdrawer { at: ds.ex, ds.ey; size: ds.ew * (1 + dj.stretch - 0.07 * ds.bell + 0.003 * wobble), ds.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble); corner: mix(min(ds.ew, ds.eh) / 2, 26 * u, clamp(ds0 * 1.6 - 0.1, 0, 1)); blend: mix((16 + 20 * ds.bell) * u * min(1, ds0 * 4), dj.neck, lm); show: ds0 > 0.004 }
            box ldrawer { at: dl.ex, dl.ey; size: dl.ew * (1 + dj.stretch - 0.07 * dl.bell + 0.003 * wobble), dl.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble); corner: mix(min(dl.ew, dl.eh) / 2, 26 * u, clamp(dl0 * 1.6 - 0.1, 0, 1)); blend: mix((16 + 20 * dl.bell) * u * min(1, dl0 * 4) * (1 - dl.f * (1 - lm)), dj.neck, lm); show: dl0 > 0.004 }
            box odrawer { at: do.ex, do.ey; size: do.ew * (1 + dj.stretch - 0.07 * do.bell + 0.003 * wobble), do.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble); corner: mix(min(do.ew, do.eh) / 2, 26 * u, clamp(do0 * 1.6 - 0.1, 0, 1)); blend: mix((16 + 20 * do.bell) * u * min(1, do0 * 4), mix(dj.neck, (16 + 20 * do.bell) * u * min(1, do0 * 4), att), lm); show: do0 > 0.004 }
            box mdrawer { at: dm.ex, dm.ey; size: dm.ew * (1 + dj.stretch - 0.07 * dm.bell + 0.003 * wobble), dm.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble); corner: mix(min(dm.ew, dm.eh) / 2, 26 * u, clamp(dm0 * 1.6 - 0.1, 0, 1)); blend: mix((16 + 20 * dm.bell) * u * min(1, dm0 * 4), mix(dj.neck, (16 + 20 * dm.bell) * u * min(1, dm0 * 4), att), lm); show: dm0 > 0.004 }
        }
        //  The battery gauge, inside the bar with a thick margin of empty glass round it (`bf.m`). It is only there
        //  while `batt_open` (the pointer is on the bar, or the charge is under 20 %): it fades in and grows a little
        //  from its middle line. It is a tint of the accent that brightens towards its front (a red one while it is
        //  draining below 20 %), and its own rim gives it an edge. It follows the bar's shape (which swells with the
        //  beat) and never moves by itself: an animation here would keep the scene painting, and most of all when
        //  the battery is low.
        group {
            let bf.m = 7 * u                                        // the margin between the gauge and the bar's edge
            let bf.x = pcx - (bar.w + pv * 10 * u) / 2 + bf.m
            let bf.mid = bar.y - bar.h / 2 + (bar.h + pop) / 2      // the pill's middle line
            let bf.full = bar.w + pv * 10 * u - 2 * bf.m           // the gauge's length at 100 %
            let bf.tall = bar.h + pop - 2 * bf.m                   // the pill's height
            let bf.show = clamp(batt_open, 0, 1) * (1 - lm)
            let bf.hh = bf.tall * (0.7 + 0.3 * bf.show)
            let bf.len = max(0.1, bf.full * batt_fill)
            let bf.c = mix(mint, #e0655a, batt_low)
            body {
                gradient: bf.x, 0 to bf.x + max(1, bf.len), 0, mix(tint, bf.c, 0.28), bf.c
                rim: 18%
                opacity: (19% + 9% * batt_low) * bf.show * batt_on
                box { from: bf.x, bf.mid - bf.hh / 2; size: bf.len, bf.hh; corner: min(bf.hh / 2, max(0.5, bar.rad - bf.m)) }
            }
        }

        //  Down the left the strip is the gauge: it fills from the foot up, with the same margin of empty glass round it, the same colours, and
        //  the same rule for when it shows (the pointer on the strip, or a charge under 20 %).
        group {
            let bl.m = 7 * u
            let bl.show = clamp(batt_open, 0, 1) * lm
            let bl.w = lf.w - 2 * bl.m
            let bl.bot = vb - lf.t - bl.m
            let bl.full = vh - 2 * (lf.t + bl.m)
            let bl.len = max(0.1, bl.full * batt_fill)
            let bl.c = mix(mint, #e0655a, batt_low)
            body {
                gradient: lf.x, bl.bot to lf.x, bl.bot - max(1, bl.len), mix(tint, bl.c, 0.28), bl.c
                rim: 18%
                opacity: (19% + 9% * batt_low) * bl.show * batt_on
                box { from: bl.m, bl.bot - bl.len; size: bl.w, bl.len; corner: min(bl.w / 2, max(0.5, bar.rad - bl.m)); show: lm > 0.004 }
            }
        }

        //  The charging glint: a soft band of the accent that crosses the bar from left to right, inside its shape. Built
        //  of thin slices whose strength follows a bell, so it has no hard edge; it is strongest in the middle of the
        //  crossing and gone (opacity 0) whenever `charge_sweep` rests at 1.
        group {
            clip inset 0 box { at: pcx, bar.y - bar.h / 2 + (bar.h + pop) / 2; size: bar.w + pv * 10 * u, bar.h + pop; corner: bar.rad }
            let cg.w = 130 * u                                                   // the band's width
            let cg.x = mix(pcx - bar.w / 2 - cg.w / 2, pcx + bar.w / 2 + cg.w / 2, clamp(charge_sweep, 0, 1))
            let cg.a = sin(clamp(charge_sweep, 0, 1) * 180) * batt_on * (1 - lm)           // fades in and out over the crossing
            repeat k in 0..14 {
                box { at: cg.x + (k - 6.5) * cg.w / 14, bar.y; size: cg.w / 14 + 1, bar.h + pop; color: mint; opacity: 15% * cg.a * sin((k + 0.5) / 14 * 180) }
            }
        }

        // ── the bar ──────────────────────────────────────────────────
        //  Under everything else on the bar (declared first, so the pieces win their presses): it only says that the
        //  pointer is over the bar, in the gaps between them.
        zone box bar_hover { at: pcx, bar.y; size: bar.w, bar.h; active: lm < 0.5 }
        zone box lf_hover { at: lf.x, vc; size: lf.w, vh; active: lm > 0.5 }
        repeat i in 1..6 {
            //  The others sit 15 apart; the ones beside the active one slide away from it by `room / 2`
            //  each, so the widening one has space, and the row flows as the amounts change.
            let wx = at.ws + (i - 3) * 15 * u + room * 0.5 * clamp(i - pill, -1, 1)
            //  One shape per workspace that morphs: a dot, a taller capsule if it has windows, and a
            //  wide mint pill while it is the active one.
            let wy = lv.ws + (i - 3) * 15 * cu + roomv * 0.5 * clamp(i - pill, -1, 1)
            zone box ws.hit.$i { at: mix(wx, lf.x, lm), mix(bar.y, wy, lm); size: mix(15 * u, 40 * u, lm), mix(bar.h, 15 * cu, lm); cursor: pointer; active: bs.ws > 0.5 }
            on press ws.hit.$i { emit go(i) }
            on press right ws.hit.$i { emit ov_toggle }
            follow wsh.$i = ws.hit.$i.hover
        }

        //  What is in front: the app in small type above, the title under it, cut
        //  with an ellipsis where the clock starts.
        //  The title gives up room to the controls while something plays.

        //  The whole title area is a button: it opens the controls panel. Declared before
        //  the little player controls below, which sit over it and win where they overlap.
        //  It is only as wide as the text it holds (never past `win.w`, never thinner than a
        //  fingertip), not the whole gap up to the clock. Unseen copies, with no width limit,
        //  only to know how wide the app name and the title really are.
        text win.class { at: 0, 0; anchor: left center; size: 15; weight: 600; lines: 1; measure: vclw; opacity: 0; family: "Space Grotesk" }
    text win.title { at: 0, 0; anchor: left center; size: 14; weight: 500; lines: 1; measure: vtiw; opacity: 0; family: "Space Grotesk" }
    text win.class { at: floor(win.x + 0.5), floor(bar.y - 6.5 * u + 0.5); anchor: left center; size: 17 * u; weight: 600; lines: 1; measure: clsw; opacity: 0; family: "Space Grotesk" }
        text win.title { at: floor(win.x + 0.5), floor(bar.y + 8.75 * u + 0.5); anchor: left center; size: 13.5 * u; weight: 500; lines: 1; measure: titw; opacity: 0; family: "Space Grotesk" }
        //  While a player exists its buttons (previous, play, next: 48 wide) sit in this button's top right, beside the app name.
        let mctl = 54 * u * mshow * bs.media * bs.title
        let win.hw = clamp(max(clsw.width + mctl, titw.width) + 12 * u, 48 * u, win.w)
        //  With a name in front (`win.have` 1) the button is as wide as the name, with the player's buttons in its top right. With no window
        //  the texts are empty, and the button would be a narrow strip at the left: it then takes most of the gap and is centred in it, with the
        //  player's buttons in the middle.
        let win.have = clamp(max(clsw.width, titw.width) / (6 * u), 0, 1)
        let win.zc = mix(win.x + win.w / 2, win.x - 6 * u + win.hw / 2, win.have)
        let win.zw = mix(max(48 * u, win.w - 12 * u), win.hw, win.have)
        let mcx = mix(win.x + win.w / 2, win.x - 6 * u + win.hw - 27.5 * u, win.have)
        let mcy = mix(bar.y, bar.y - 6.5 * u, win.have)
        zone box win_hit { at: win.zc, bar.y; size: win.zw, bar.h; cursor: pointer; active: bs.title > 0.5 }
        on press win_hit { panel = if(panel == player, none, player) }

        // ── the player, small, in the bar ────────────────────────────
        //  While there is a player, playing or paused; they fade in as the title gives them room.
        group {
            opacity: mshow * bs.media
            //  In the title button's top right (`mcx`, `mcy`), and small: 17 between centres.
            zone box bp.prev { at: mcx - 17 * u, mcy; size: 17 * u, 18 * u; cursor: pointer }
            zone box bp.play { at: mcx, mcy; size: 17 * u, 18 * u; cursor: pointer }
            zone box bp.next { at: mcx + 17 * u, mcy; size: 17 * u, 18 * u; cursor: pointer }
            on press bp.prev { emit mcmd(0) }
            on press bp.play { emit mcmd(1) }
            on press bp.next { emit mcmd(2) }
        }

        zone box vt_hit { at: lf.x, lv.tm; size: lf.w - 6 * u, max(1, lv.span); cursor: pointer; active: lm > 0.5 and bv.title and lv.span > 20 * u }
        on press vt_hit { panel = if(panel == player, none, player) }
        zone box vm_prev { at: lf.x, lv.mid + 17 * cu; size: 30 * cu, 17 * cu; cursor: pointer; active: lm > 0.5 and bv.media and mshow > 0.5 }
        zone box vm_play { at: lf.x, lv.mid; size: 30 * cu, 17 * cu; cursor: pointer; active: lm > 0.5 and bv.media and mshow > 0.5 }
        zone box vm_next { at: lf.x, lv.mid - 17 * cu; size: 30 * cu, 17 * cu; cursor: pointer; active: lm > 0.5 and bv.media and mshow > 0.5 }
        on press vm_prev { emit mcmd(0) }
        on press vm_play { emit mcmd(1) }
        on press vm_next { emit mcmd(2) }
        zone box set_hit { at: mix(set.x, lf.x, lm), mix(bar.y, lv.set, lm); size: mix(24 * u, 36 * u, lm), mix(bar.h, 30 * u, lm); cursor: pointer }
        on press set_hit { panel = if(panel == settings, none, settings) }

        zone box sr_hit { at: mix(sr.x, lf.x, lm), mix(bar.y, lv.sr, lm); size: mix(24 * u, 36 * u, lm), mix(bar.h, 30 * u, lm); cursor: pointer; active: bs.sr > 0.5 }
        on press sr_hit { panel = if(panel == launch, none, launch) }
        zone box ctl_hit { at: mix(ctl.x, lf.x, lm), mix(bar.y, lv.ctl, lm); size: mix(26 * u, 36 * u, lm), mix(bar.h, 30 * u, lm); cursor: pointer; active: bs.ctl > 0.5 }
        on press ctl_hit { panel = if(lm > 0.5, controls, if(panel == controls, none, controls)) }

        //  The calendar's button is the clock and a little around it: 4 more at each side.
        zone box bar_hit { at: mix(at.clock, lf.x, lm), mix(bar.y, lv.clk + 30 * u, lm); size: mix(fw.clock + 8 * u, lf.w - 4 * u, lm), mix(bar.h, 100 * u, lm); cursor: pointer; active: bs.clock > 0.5 }
        on press bar_hit { panel = if(lm > 0.5, calendar, if(panel == calendar, none, calendar)) }
        //  Right-click closes whatever is open. It also matters for a reason that
        //  has nothing to do with the calendar: pleamar treats an unclaimed right
        //  click, anywhere in a scene that never uses the right button at all, as
        //  an emergency exit and quits outright - which is exactly what looked
        //  like "everything crashes." Claiming it here, once, disarms that for
        //  the whole scene.
        on press right bar_hit { panel = none }
        //  How open the battery gauge is (see `batt_open`): it lives here, where the bar's zones are, to read their hover.
        follow batt_open = if(max(max(max(max(max(max(max(max(max(max(max(max(max(max(bar_hover.hover, wsh.1), wsh.2), wsh.3), wsh.4), wsh.5), win_hit.hover), bp.prev.hover), bp.play.hover), bp.next.hover), set_hit.hover), sr_hit.hover), ctl_hit.hover), bar_hit.hover), lf_hover.hover) > 0.15 or (pwr.percent < 20 and pwr.present), 1, 0)
    }

    //  The bar's icons are drawn here, on top of the bar and outside its wave-shader group, with a soft dark
    //  halo (a group `glow` in the palette's dark colour) so they hold up on a light wallpaper, as the text
    //  does. An effect cannot sit inside another effect's group, hence outside. The click areas and rules
    //  stay in the bar group above.
    group {
        glow: 2.4 * u, 110%, deep
        row tray_bar_row {
            at: floor(tr.x - (bartrays.count * 24 - 6) * u / 2 + 0.5), floor(bar.y - 9 * u + 0.5)
            gap: floor(6 * u + 0.5)
            show: lm < 0.5
            for t in bartrays { BarTray(t, click: bar_tray_click, menu: bar_tray_menu) }
        }
        column tray_bar_col {
            at: floor(lf.x - 9 * u + 0.5), floor(lv.tray + 0.5)
            gap: floor(6 * u + 0.5)
            show: lm >= 0.5
            for t in bartrays { BarTray(t, click: bar_tray_click, menu: bar_tray_menu) }
        }
        repeat i in 1..6 {
            let wxs = at.ws + (i - 3) * 15 * u + room * 0.5 * clamp(i - pill, -1, 1)
            let wys = lv.ws + (i - 3) * 15 * cu + roomv * 0.5 * clamp(i - pill, -1, 1)
            box ws.dot.$i { at: mix(wxs, lf.x, lm), mix(bar.y, wys, lm); size: mix((6 + 14 * ws.act.$i) * u, (6 + 4 * ws.tall.$i * (1 - ws.act.$i)) * cu, lm), mix((6 + 4 * ws.tall.$i * (1 - ws.act.$i)) * u, (6 + 14 * ws.act.$i) * cu, lm); corner: mix(3 * u, 3 * cu, lm)
                            color: mix(ink, mint, ws.act.$i); opacity: mix(28% + 62% * ws.tall.$i, 100%, ws.act.$i) * bs.ws }
        }
        //  The player's buttons.
        group {
            opacity: mshow * bs.media * bs.title
            box { at: mcx - 20.5 * u, mcy; size: 1.4 * u, 7 * u; corner: 0.7 * u; color: ink; opacity: 65% + 35% * bp.prev.hover }
            path { at: mcx - 17 * u, mcy; color: ink; opacity: 65% + 35% * bp.prev.hover; move 3 * u, -3.5 * u; line -2.5 * u, 0; line 3 * u, 3.5 * u; close }
            //  Pause while it plays, play while it is paused.
            box { at: mcx - 3 * u, mcy; size: 2.6 * u, 9 * u; corner: 1 * u; color: ink; opacity: 85% + 15% * bp.play.hover; show: media.playing }
            box { at: mcx + 3 * u, mcy; size: 2.6 * u, 9 * u; corner: 1 * u; color: ink; opacity: 85% + 15% * bp.play.hover; show: media.playing }
            path { at: mcx, mcy; color: ink; opacity: 85% + 15% * bp.play.hover; show: not media.playing; move -3 * u, -4.5 * u; line 7 * u, 0; line -3 * u, 4.5 * u; close }
            path { at: mcx + 17 * u, mcy; color: ink; opacity: 65% + 35% * bp.next.hover; move -3 * u, -3.5 * u; line 2.5 * u, 0; line -3 * u, 3.5 * u; close }
            box { at: mcx + 20.5 * u, mcy; size: 1.4 * u, 7 * u; corner: 0.7 * u; color: ink; opacity: 65% + 35% * bp.next.hover }
        }
        //  Down the left the player's buttons are the top bar's own, turned with the title (a quarter anticlockwise, so they read from the foot up:
        //  previous nearest the text, next at the far end), at the top end of it.
        group {
            opacity: mshow * bs.media0 * lm
            pivot: lf.x, lv.mid
            rotate: -90deg
            box { at: lf.x - 20.5 * cu, lv.mid; size: 1.4 * cu, 7 * cu; corner: 0.7 * cu; color: ink; opacity: 65% + 35% * vm_prev.hover }
            path { at: lf.x - 17 * cu, lv.mid; color: ink; opacity: 65% + 35% * vm_prev.hover; move 3 * cu, -3.5 * cu; line -2.5 * cu, 0; line 3 * cu, 3.5 * cu; close }
            box { at: lf.x - 3 * cu, lv.mid; size: 2.6 * cu, 9 * cu; corner: 1 * cu; color: ink; opacity: 85% + 15% * vm_play.hover; show: media.playing }
            box { at: lf.x + 3 * cu, lv.mid; size: 2.6 * cu, 9 * cu; corner: 1 * cu; color: ink; opacity: 85% + 15% * vm_play.hover; show: media.playing }
            path { at: lf.x, lv.mid; color: ink; opacity: 85% + 15% * vm_play.hover; show: not media.playing; move -3 * cu, -4.5 * cu; line 7 * cu, 0; line -3 * cu, 4.5 * cu; close }
            path { at: lf.x + 17 * cu, lv.mid; color: ink; opacity: 65% + 35% * vm_next.hover; move -3 * cu, -3.5 * cu; line 2.5 * cu, 0; line -3 * cu, 3.5 * cu; close }
            box { at: lf.x + 20.5 * cu, lv.mid; size: 1.4 * cu, 7 * cu; corner: 0.7 * cu; color: ink; opacity: 65% + 35% * vm_next.hover }
        }
        //  The settings button: a gear, between the player's buttons and the controls button.
        group {
            opacity: 65% + 35% * max(set_hit.hover, clamp(ds, 0, 1))
            move: (lf.x - set.x) * lm, (lv.set - bar.y) * lm
            ellipse { at: set.x, bar.y; radius: 3.6 * u; stroke: 1.7 * u; color: mix(ink, mint, clamp(ds, 0, 1)) }
            ellipse { at: set.x, bar.y; radius: 1.2 * u; color: mix(ink, mint, clamp(ds, 0, 1)) }
            repeat i in 0..8 {
                group {
                    pivot: set.x, bar.y
                    rotate: i * 45deg
                    box { at: set.x, bar.y - 6 * u; size: 2 * u, 2.6 * u; corner: 0.7 * u; color: mix(ink, mint, clamp(ds, 0, 1)) }
                }
            }
        }
        //  The launcher's button, between the settings button and the controls button: a magnifying glass.
        group {
            opacity: (65% + 35% * max(sr_hit.hover, clamp(dl, 0, 1))) * bs.sr
            move: (lf.x - sr.x) * lm, (lv.sr - bar.y) * lm
            ellipse { at: sr.x - 1.2 * u, bar.y - 1.2 * u; radius: 4 * u; stroke: 1.7 * u; color: mix(ink, mint, clamp(dl, 0, 1)) }
            line { from: sr.x + 1.8 * u, bar.y + 1.8 * u; to: sr.x + 5 * u, bar.y + 5 * u; width: 1.9 * u; color: mix(ink, mint, clamp(dl, 0, 1)) }
        }
        //  The controls button, between the settings button and the clock: two sliders.
        group {
            opacity: (65% + 35% * max(ctl_hit.hover, clamp(dk, 0, 1))) * bs.ctl
            move: (lf.x - ctl.x) * lm, (lv.ctl - bar.y) * lm
            box { at: ctl.x, bar.y - 3.5 * u; size: 13 * u, 1.6 * u; corner: 0.8 * u; color: mix(ink, mint, clamp(dk, 0, 1)) }
            box { at: ctl.x, bar.y + 3.5 * u; size: 13 * u, 1.6 * u; corner: 0.8 * u; color: mix(ink, mint, clamp(dk, 0, 1)) }
            ellipse { at: ctl.x + 2.5 * u, bar.y - 3.5 * u; radius: 2.6 * u; color: mix(ink, mint, clamp(dk, 0, 1)) }
            ellipse { at: ctl.x - 2.5 * u, bar.y + 3.5 * u; radius: 2.6 * u; color: mix(ink, mint, clamp(dk, 0, 1)) }
        }
    }

    //  The bar's text is drawn on top of the bar, outside its wave-shader group: inside it the letters are
    //  resampled by the shader, which blurs them and smears them whenever the music makes the wave move.
    //  The glass and the icons still bend; the words stay sharp.
    //  The clock in the bar is four texts, right-aligned and set against each other from their measured widths:
    //  the hour, oversized; the minutes with their colon, in the accent, the two digits tucked 3 px over each
    //  other (the colon is left clear: overlapped it disappears); and, at the edge, a small column: the day
    //  stacked tight over a dim am/pm, centred on each other.
    text bar_date { at: floor(clock.r - clock.col / 2 + 0.5), floor(bar.y - 8 + 0.5); anchor: center; size: 11; weight: 700; measure: cdw; color: faint; opacity: bs.clock * (1 - lm); shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text bar_ap { at: floor(clock.r - clock.col / 2 + 0.5), floor(bar.y + 7 + 0.5); anchor: center; size: 14; weight: 600; measure: caw; color: faint; opacity: bs.clock * (1 - lm); shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text clock_mm { at: floor(clock.r - clock.col - 3 + 0.5), floor(bar.y + 3 + 0.5); anchor: right center; size: 26; weight: 700; measure: cmw; letter_move: 3 * ((letters - 1 - letter) - if(letter == 0, 1, 0)), 0; color: mint; opacity: bs.clock * (1 - lm); shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text clock_h { at: floor(clock.r - clock.col - cmw.width + 0.5), floor(bar.y + 0.5); anchor: right center; size: 40; weight: 700; measure: chw; color: ink; opacity: bs.clock * (1 - lm); shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    //  Down the left the clock is stacked in the strip: the hour, the minutes under it in the accent, and the am/pm.
    text clock_h { at: floor(lf.x + 0.5), floor(lv.clk + 0.5); anchor: center; align: center; size: 30; weight: 700; color: ink; opacity: bs.clock * lm; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text clock_mn { at: floor(lf.x + 0.5), floor(lv.clk + 24 * u + 0.5); anchor: center; align: center; size: 22; weight: 700; color: mint; opacity: bs.clock * lm; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text bar_ap { at: floor(lf.x + 0.5), floor(lv.clk + 41 * u + 0.5); anchor: center; align: center; size: 12; weight: 600; color: faint; opacity: bs.clock * lm; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    //  Under them, past a short rule, the day of the week and the date.
    box { at: lf.x, lv.clk + 51 * u; size: 22 * u, 1.2 * u; corner: 0.6 * u; color: ink; opacity: 18% * bs.clock * lm }
    text bar_date { at: floor(lf.x + 0.5), floor(lv.clk + 59 * u + 0.5); anchor: center; align: center; size: 11; weight: 700; color: faint; opacity: bs.clock * lm; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text date_md { at: floor(lf.x + 0.5), floor(lv.clk + 73 * u + 0.5); anchor: center; align: center; size: 14; weight: 700; color: ink; opacity: bs.clock * lm; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    //  The window title down the left: the app, and under it (to its right once turned) the title, turned a quarter anticlockwise so that it reads
    //  from the foot up, each centred on the strip's middle line and on the stretch `lv.tm` and cut with an ellipsis where that ends.
    group {
        pivot: lf.x - 9 * cu, lv.tm
        rotate: -90deg
        opacity: lm * bs.title0
        text win.class { at: floor(lf.x - 9 * cu + 0.5), floor(lv.tm + 0.5); anchor: center; align: center; size: 15; weight: 600; width: max(1, lv.span); lines: 1; color: faint; opacity: 70%; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    }
    group {
        pivot: lf.x + 9 * cu, lv.tm
        rotate: -90deg
        opacity: lm * bs.title0
        text win.title { at: floor(lf.x + 9 * cu + 0.5), floor(lv.tm + 0.5); anchor: center; align: center; size: 14; weight: 500; width: max(1, lv.span); lines: 1; color: ink; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    }
    text win.class { at: floor(win.x + 0.5), floor(bar.y - 6.5 * u + 0.5); anchor: left center; size: 17 * u; weight: 600; width: max(0, win.hw - 12 * u - mctl); lines: 1; color: faint; opacity: 55% * bs.title; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text win.title { at: floor(win.x + 0.5), floor(bar.y + 8.75 * u + 0.5); anchor: left center; size: 13.5 * u; weight: 500; width: max(0, win.hw - 12 * u); lines: 1; color: ink; opacity: bs.title; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }

    // ── the panel ────────────────────────────────────────────────
    group {
        //  The calendar's content is clipped to the calendar's shape.
        clip inset 2 box { at: mix(pcx, dc.gx, lm), mix(bar.y + dc.hh / 2, lp.cy, lm); size: mix(dc.w, dc.gw, lm), mix(dc.hh, dc.gh, lm); corner: 26 * cu }
        //  Down the left it comes out of the strip: what is inside grows with the drawer's shape (`dc.lf`), from the strip's edge at the panel's middle, instead of waiting still under the clip.
        group {
            pivot: lp.xl, lp.cy
            scale: mix(1, max(dc.lf, 0.05), lm * att)
        //  ── the calendar panel ──
        //  Three plates like the volume and media ones, each 8% white and 12 from the panel's
        //  edges: the time and date, the chosen day with its reminders, and the month. The two
        //  on the left and the one on the right share a top and a bottom.
        group {
            opacity: f1
            move: 0, (1 - f1) * 12 * cu + floor(68 * cu + 0.5)
            box { at: pcx - 130 * cu, cy - 76 * cu; size: 166 * cu, 72 * cu; corner: 14 * cu; color: ink; opacity: veil }
            box { at: pcx - 130 * cu, cy + 43 * cu; size: 166 * cu, 154 * cu; corner: 14 * cu; color: ink; opacity: veil }
            //  The clock card: big numerals, the am/pm tucked small at their top-right in the accent, and under
            //  them, indented a little, the date as weekday | month day with the pipe in the accent.
            text clock_hm { at: floor(pcx - 201 * cu + 0.5), floor(cy - 88 * cu + 0.5); anchor: left center; size: 64.5; weight: 700; measure: hmw; color: ink; family: "Space Grotesk" }
            //  The am/pm is a small pill in the accent, vertically centred on the numerals and set against their right side.
            box { at: floor(pcx - 201 * cu + hmw.width + 8 * cu + 17 + 0.5), floor(cy - 88 * cu + 0.5); size: 34, 20; corner: 10; color: mint; opacity: 20% }
            text clock_ap { at: floor(pcx - 201 * cu + hmw.width + 8 * cu + 17 + 0.5), floor(cy - 88 * cu + 0.5); anchor: center; align: center; size: 14; weight: 700; width: 34; lines: 1; color: mint; family: "Space Grotesk" }
            //  The date is right-aligned to the card's inner edge (pcx - 59): the month and day first, then the pipe
            //  and the weekday laid out leftwards from it, each placed from the measured width of the one after.
            text date_md { at: floor(pcx - 59 * cu + 0.5), floor(cy - 55 * cu + 0.5); anchor: right center; size: 14; weight: 700; measure: mdw; color: ink; family: "Space Grotesk" }
            text "|" { at: floor(pcx - 59 * cu - mdw.width - 8 * cu + 0.5), floor(cy - 55 * cu + 0.5); anchor: right center; size: 16; weight: 300; color: mint; family: "Space Grotesk" }
            text date_wd { at: floor(pcx - 59 * cu - mdw.width - 20 * cu + 0.5), floor(cy - 55 * cu + 0.5); anchor: right center; size: 14; weight: 700; color: faint; family: "Space Grotesk" }
            text cal.sel_title { at: floor(pcx - 201 * cu + 0.5), floor(cy - 14 * cu + 0.5); anchor: left center; size: 15; weight: 600; width: 142 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            text cal.sel_sub { at: floor(pcx - 201 * cu + 0.5), floor(cy + 1 * cu + 0.5); anchor: left center; size: 12; width: 142 * cu; lines: 1; color: faint; opacity: 75%; family: "Space Grotesk" }
            column cal_list {
                at: floor(pcx - 207 * cu + 0.5), floor(cy + 14 * cu + 0.5)
                view: 154 * cu, 106 * cu
                gap: 4
                for e in cal_events { CalRow(e, tick: cal_check, gone: cal_delete) }
            }
            text "Add one below" { at: floor(pcx - 201 * cu + 0.5), floor(cy + 28 * cu + 0.5); anchor: left center; size: 13; color: faint; opacity: 55%; family: "Space Grotesk"; show: cal_events.count < 1 }
        }
        group {
            opacity: f4
            move: 0, (1 - f4) * 12 * cu
            let cal.cw = 33 * cu
            let cal.ch = 27 * cu
            let cal.gx = pcx - 13 * cu                 // the middle of the first column
            let cal.gy = cy - 42 * cu                 // the middle of the first row
            group {
                move: 0, floor(68 * cu + 0.5)        // the month sits 68 lower, under the weather strip (a whole number of pixels)
            box { at: pcx + 86 * cu, cy + 4 * cu; size: 254 * cu, 232 * cu; corner: 14 * cu; color: ink; opacity: veil }
            //  Month, and the three buttons that move it.
            text cal.month { at: floor(pcx - 30 * cu + 0.5), floor(cy - 92 * cu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            path { at: pcx + 134 * cu, cy - 92 * cu; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * cal_prev_btn.hover; move 2.5 * cu, -5 * cu; line -2.5 * cu, 0; line 2.5 * cu, 5 * cu }
            box { at: pcx + 163 * cu, cy - 92 * cu; size: 40 * cu, 20 * cu; corner: 10 * cu; color: ink; opacity: 8% + 10% * cal_today_btn.hover }
            text "Today" { at: floor(pcx + 163 * cu + 0.5), floor(cy - 92 * cu + 0.5); anchor: center; size: 11.5; weight: 600; color: ink; opacity: 80%; family: "Space Grotesk" }
            path { at: pcx + 192 * cu, cy - 92 * cu; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * cal_next_btn.hover; move -2.5 * cu, -5 * cu; line 2.5 * cu, 0; line -2.5 * cu, 5 * cu }
            zone box cal_prev_btn { at: pcx + 134 * cu, cy - 92 * cu; size: 26 * cu, 26 * cu; corner: 13 * cu; cursor: pointer }
            zone box cal_today_btn { at: pcx + 163 * cu, cy - 92 * cu; size: 42 * cu, 24 * cu; corner: 12 * cu; cursor: pointer }
            zone box cal_next_btn { at: pcx + 192 * cu, cy - 92 * cu; size: 26 * cu, 26 * cu; corner: 13 * cu; cursor: pointer }
            on press cal_prev_btn { emit cal_prev }
            on press cal_today_btn { emit cal_today }
            on press cal_next_btn { emit cal_next }
            //  The weekdays.
            repeat w in 1..8 {
                text cal.wd.$w { at: floor(cal.gx + (w - 1) * cal.cw + 0.5), floor(cy - 66 * cu + 0.5); anchor: center; size: 11; weight: 600; color: faint; opacity: 65%; family: "Space Grotesk" }
            }
            //  The days.
            repeat k in 0..42 {
                let dx = cal.gx + mod(k, 7) * cal.cw
                let dy = cal.gy + floor(k / 7) * cal.ch
                prop cal.pick.$k = 0 ~lively
                follow cal.pick.$k = if(cal.sel == k, 1, 0)
                group {
                    opacity: 38% + 62% * if(cal.in.$k, 1, 0)
                    pivot: dx, dy
                    scale: 1 + 0.08 * cal.pick.$k
                    ellipse { at: dx, dy; radius: 12 * cu; color: ink; opacity: 9% * cal_cell.$k.hover * (1 - cal.pick.$k) }
                    ellipse { at: dx, dy; radius: 12 * cu; color: mint; opacity: cal.pick.$k * 100% }
                    group {
                        glow: 5 * cu, 60%, mint
                        ellipse { at: dx, dy; radius: 13 * cu; stroke: 1.5 * cu; color: mint; show: cal.today.$k }
                    }
                    ellipse { at: dx, dy + 8.5 * cu; radius: 1.5 * cu; color: mix(mint, onmint, cal.pick.$k); opacity: if(cal.n.$k > 0, 100%, 0) }
                }
                //  The day's number is not inside the group that grows when it is picked: a scaled text is resampled and comes out soft, so it
                //  stays its size (a text's `size` takes plain numbers only: a prop or a `let` in it counts as 1), and is drawn on whole pixels.
                text number(cal.day.$k, 0) { at: floor(dx + 0.5), floor(dy - 0.5 * cu + 0.5); anchor: center; size: 13; weight: 500 + 200 * if(cal.today.$k, 1, 0)
                                             color: mix(ink, onmint, cal.pick.$k); opacity: 38% + 62% * if(cal.in.$k, 1, 0); family: "Space Grotesk" }
                zone box cal_cell.$k { at: dx, dy; size: 30 * cu, 26 * cu; corner: 13 * cu; cursor: pointer }
                on press cal_cell.$k { emit cal_pick(k) }
            }
            }
            //  The weather, at the very top: what it is now, on the left, and the week, on the right.
            box { at: pcx, cy - 82 * cu; size: 426 * cu, 60 * cu; corner: 14 * cu; color: ink; opacity: veil }
            text "Loading weather…" { at: floor(pcx + 0.5), floor(cy - 82 * cu + 0.5); anchor: center; align: center; size: 13; width: 300 * cu; lines: 1; color: faint; family: "Space Grotesk"; show: not wx_ok }
            group {
                show: wx_ok
                group {
                    pivot: pcx - 190 * cu, cy - 90 * cu
                    scale: 1.5
                    column wx_now { at: pcx - 203 * cu, cy - 100 * cu; WxIcon(wx_kind) }
                }
                text wx_temp { at: floor(pcx - 160 * cu + 0.5), floor(cy - 92 * cu + 0.5); anchor: left center; size: 22; weight: 700; width: 70 * cu; lines: 1; color: ink; family: "Space Grotesk" }
                text wx_desc { at: floor(pcx - 160 * cu + 0.5), floor(cy - 73 * cu + 0.5); anchor: left center; size: 11.5; width: 100 * cu; lines: 1; color: faint; family: "Space Grotesk" }
                box { at: pcx - 96 * cu, cy - 82 * cu; size: 1 * cu, 40 * cu; color: ink; opacity: 12% }
                row wx_row {
                    at: floor(pcx - 90 * cu + 0.5), floor(cy - 107 * cu + 0.5)
                    gap: 1
                    for d in wx_days { WxDay(d) }
                }
            }

            //  Writing one: the field, and a button. Enter saves it as well.
            box { at: pcx, cy + 213 * cu; size: 426 * cu, 34 * cu; corner: 14 * cu; color: ink; opacity: veil }
            ellipse { at: pcx - 201 * cu, cy + 213 * cu; radius: 4 * cu; color: mint; opacity: 85% }
            //  An input's `at` is not its middle: it is lifted 6.3 so its text sits on the row's centre.
            input cal_new { at: floor(pcx - 189 * cu + 0.5), floor(cy + 206.7 * cu + 0.5); width: 330 * cu; size: 15; color: ink; family: "Space Grotesk"
                            placeholder: "New reminder: 3:30pm Call mom"; selection: mintlo }
            box { at: pcx + 178 * cu, cy + 213 * cu; size: 46 * cu, 24 * cu; corner: 12 * cu; color: mint; opacity: 80% + 20% * cal_add_btn.hover }
            text "Add" { at: floor(pcx + 178 * cu + 0.5), floor(cy + 213 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk" }
            zone box cal_add_btn { at: pcx + 178 * cu, cy + 213 * cu; size: 48 * cu, 28 * cu; corner: 14 * cu; cursor: pointer }
            on press cal_add_btn { emit cal_add }
        }
        //  Opening the calendar puts the cursor in the field and the grid back on today.
        on change panel while panel == calendar { focus cal_new; emit cal_open }
        }
    }
    //  The controls' content is clipped to the drawer's shape.
    group {
        clip inset 2 box { at: mix(pcx, dk.gx, lm), mix(bar.y + dk.hh / 2, lp.cy, lm); size: mix(dk.w, dk.gw, lm), mix(dk.hh, dk.gh, lm); corner: 26 * cu }
        //  Down the left it comes out of the strip: what is inside grows with the drawer's shape (`dk.lf`), from the strip's edge at the panel's middle, instead of waiting still under the clip.
        group {
            pivot: lp.xl, lp.cy
            scale: mix(1, max(dk.lf, 0.05), lm * att)
        //  A plate is a veil, not more glass: glass does not go on glass.
        group {
            opacity: f5 * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f5) * 12 * cu
            let vol_cy = ck + (vol_top + 32) * cu
            box { at: pcx, vol_cy + (vp.h - 64) / 2 * cu; size: 288 * cu, vp.h * cu; corner: 14 * cu; color: ink; opacity: veil }
            //  ── the slider ──
            //  The track runs from `sl.x0` for `sl.w`; the pointer is turned into a volume
            //  against those two numbers, so they are written once.
            let sl.x0 = pcx - 96 * cu
            let sl.w = 222 * cu
            let sy = vol_cy + 11 * cu
            let th = (16 + 3 * vol_hit.hover) * cu          // the track thickens under the pointer
            //  A speaker on the left that says how loud it is: two waves that come and go
            //  with the level, or a slash when it is silenced.
            path { at: pcx - 124 * cu, sy; color: ink; opacity: 70% + 30% * mute_hit.hover; move 0, -3 * cu; line 3.5 * cu, -3 * cu; line 8 * cu, -7 * cu; line 8 * cu, 7 * cu; line 3.5 * cu, 3 * cu; line 0, 3 * cu; close }
            path { at: pcx - 124 * cu, sy; stroke: 1.5 * cu; color: ink; opacity: if(audio.muted, 0, 25% + 75% * clamp(volume_level * 12, 0, 1)); move 11 * cu, -3 * cu; curve 11 * cu, 3 * cu via 14 * cu, 0 }
            path { at: pcx - 124 * cu, sy; stroke: 1.5 * cu; color: ink; opacity: if(audio.muted, 0, 20% + 80% * clamp((volume_level - 0.35) * 4, 0, 1)); move 14 * cu, -6.5 * cu; curve 14 * cu, 6.5 * cu via 20 * cu, 0 }
            path { at: pcx - 124 * cu, sy; stroke: 1.6 * cu; color: alert; opacity: if(audio.muted, 100%, 0); move 11 * cu, -5 * cu; line 20 * cu, 5 * cu }
            //  The track is a sunken pill with its own thin light on the inside.
            body {
                color: deep
                rim: 9%
                box { at: sl.x0 + sl.w / 2, sy; size: sl.w, th; corner: th / 2 }
            }
            //  The fill is a gradient laid along the whole track, so the more there is, the
            //  brighter its end. It glows a little.
            group {
                glow: 7 * cu, 50%, mint
                show: not audio.muted
                body {
                    gradient: sl.x0, 0 to sl.x0 + sl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: sl.x0, sy - th / 2; size: max(0.1, sl.w * volume_level), th; corner: th / 2 }
                }
            }
            body {
                color: off
                rim: 12%
                show: audio.muted
                box { from: sl.x0, sy - th / 2; size: max(0.1, sl.w * volume_level), th; corner: th / 2 }
            }
            //  The zone that takes the click: the whole track and a little more each side
            //  and above and below, so it is easy to hit; on the press and all through a drag
            //  it turns where the pointer is into a volume.
            zone box vol_plate { at: pcx, vol_cy + (vp.h - 64) / 2 * cu; size: 288 * cu, vp.h * cu; corner: 14 * cu }
            on press right vol_plate { vm_open = not vm_open; dd_open = false }
            zone box vol_hit { at: sl.x0 + sl.w / 2, sy; size: sl.w + 16 * cu, 24 * cu; cursor: pointer }
            on press vol_hit { emit setvol(clamp((pointer.x - sl.x0) / sl.w, 0, 1)) }
            on press right vol_hit { vm_open = not vm_open; dd_open = false }
            on drag vol_hit { emit setvol(clamp((pointer.x - sl.x0) / sl.w, 0, 1)) }
            //  Three small dots at the foot of the plate say there is more under it: the mixer. They are a button too
            //  (right-clicking the plate does the same).
            repeat i in 0..3 {
                ellipse { at: pcx + (i - 1) * 6.5 * cu, vol_cy + (vp.h - 36.5) * cu; radius: 1.6 * cu; color: ink; opacity: (35% + 55% * mix_hit.hover) * (1 - clamp(vm * 1.6, 0, 1)) * clamp(mvis, 0, 1) }
            }
            //  While it is open the dots give way to an arrow pointing up: press it to fold the mixer away.
            path { at: pcx, vol_cy + (vp.h - 36.5) * cu; stroke: 1.6 * cu; color: mint; opacity: (55% + 40% * mix_hit.hover) * clamp(vm * 1.6 - 0.6, 0, 1) * clamp(mvis, 0, 1); move -4.5 * cu, 1.8 * cu; line 0, -1.8 * cu; line 4.5 * cu, 1.8 * cu }
            zone box mix_hit { at: pcx, vol_cy + (vp.h - 36.5) * cu; size: 40 * cu, 9 * cu; corner: 4.5 * cu; cursor: pointer; active: mixer.count > 0 or vm_open }
            on press mix_hit { vm_open = not vm_open; dd_open = false }
            on press right mix_hit { vm_open = not vm_open; dd_open = false }
            //  The speaker is a mute button. Declared after the track's zone, which reaches
            //  a little way under it, so the icon wins there.
            zone box mute_hit { at: pcx - 114 * cu, sy; size: 26 * cu, 32 * cu; cursor: pointer }
            on press mute_hit { emit mute }
            on press right mute_hit { vm_open = not vm_open; dd_open = false }
            //  The row above the track: which output, and how loud.
            //  Name and chevron are one button, right-aligned next to the percentage: the
            //  name ends where the chevron starts, and the zone is measured from the name.
            //  Unseen copy with no width limit, only to know how wide the name really is.
            text outname { at: floor(pcx + 66 * cu + 0.5), floor(vol_cy - 14 * cu + 0.5); anchor: right center; size: 16; lines: 1; measure: outw; opacity: 0; family: "Space Grotesk" }
            text outname { at: floor(pcx + 66 * cu + 0.5), floor(vol_cy - 14 * cu + 0.5); anchor: right center; align: right; size: 16; width: 130 * cu; lines: 1; color: faint; opacity: 65% + 35% * out_hit.hover; family: "Space Grotesk" }
            //  The percentage is centred between the end of the track (pcx + 74) and the plate's edge (pcx + 158).
            text number(audio.volume * 100, 0, "%") { at: floor(pcx + 128 * cu + 0.5), floor(vol_cy - 14 * cu + 0.5); anchor: right center; size: 18.5; weight: 600; color: ink; family: "Space Grotesk"; show: not audio.muted }
            text "Muted" { at: floor(pcx + 128 * cu + 0.5), floor(vol_cy - 14 * cu + 0.5); anchor: right center; size: 18.5; weight: 600; color: faint; family: "Space Grotesk"; show: audio.muted }
            //  The output name is a button: it opens the list of outputs.
            path { at: pcx + 76 * cu, vol_cy - 14 * cu; stroke: 1.4 * cu; color: ink; opacity: 55% + 35% * out_hit.hover; move -3.5 * cu, -2 * cu; line 0, 2 * cu; line 3.5 * cu, -2 * cu }
            let out.w = min(outw.width, 130 * cu) + 30 * cu
            zone box out_hit { at: pcx + 86 * cu - out.w / 2, vol_cy - 14 * cu; size: out.w, 30 * cu; cursor: pointer }
            on press out_hit { toggle dd_open; vm_open = false }
            on press right out_hit { vm_open = not vm_open; dd_open = false }
            text "Volume" { at: floor(pcx - 128 * cu + 0.5), floor(vol_cy - 14 * cu + 0.5); anchor: left center; size: 16; color: faint; family: "Space Grotesk" }
        }

        //  The mixer: every app that is playing, each with a slider of its own, inside the volume card (which grows to hold
        //  them). Right-click the card, or press its dots, to open it.
        group {
            show: vm > 0.01
            opacity: f5 * clamp(1 - expand0, 0, 1) * clamp(vm, 0, 1) * (1 - clamp(dd * 2, 0, 1))
            let mix_top = ck + (vol_top + 58) * cu                   // under the slider, inside the card
            clip inset 0 box { at: pcx, mix_top + (mix.m - 12) * cu * clamp(vm, 0, 1) / 2; size: 288 * cu, (mix.m - 12) * cu * clamp(vm, 0, 1) }
            text "No app is playing sound" { at: floor(pcx + 0.5), floor(mix_top + 12 * cu + 0.5); anchor: center; align: center; size: 12.5; color: faint; family: "Space Grotesk"; show: mixer.count < 1 }
            column mixcol {
                at: floor(pcx - 144 * cu + 0.5), floor(mix_top + 0.5)
                view: 288 * cu, max(1, mixer.count * 32 - 4) * cu
                gap: floor(4 * cu + 0.5)
                for m in mixer { MixRow(m, set: mix_set, mute: mix_mute) }
            }
        }

        //  Brightness: the volume slider's shape again, in miniature — a sun
        //  that opens its rays as the backlight climbs. Dimmed, not hidden,
        //  on a machine with no backlight to move.
        group {
            opacity: f6 * mix(0.45, 1, brightness.present) * mix(0.45, 1, bright_avail) * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f6) * 12 * cu
            let bcy = ck + (bright_top + 32) * cu
            box { at: pcx, bcy; size: 288 * cu, 64 * cu; corner: 14 * cu; color: ink; opacity: veil }
            let bsl.x0 = pcx - 96 * cu
            let bsl.w = 222 * cu
            let bsy = bcy + 14 * cu
            let bth = (16 + 3 * bright_hit.hover) * cu
            ellipse { at: pcx - 119 * cu, bsy; radius: 3 * cu; color: ink; opacity: 70% + 30% * bright_hit.hover }
            path { at: pcx - 119 * cu, bsy; stroke: 1.3 * cu; color: ink; opacity: 40% + 60% * bright_level; move -3.8 * cu, -3.8 * cu; line -(5.5 + 1.5 * bright_level) * cu, -(5.5 + 1.5 * bright_level) * cu }
            path { at: pcx - 119 * cu, bsy; stroke: 1.3 * cu; color: ink; opacity: 40% + 60% * bright_level; move 3.8 * cu, -3.8 * cu; line (5.5 + 1.5 * bright_level) * cu, -(5.5 + 1.5 * bright_level) * cu }
            path { at: pcx - 119 * cu, bsy; stroke: 1.3 * cu; color: ink; opacity: 40% + 60% * bright_level; move -3.8 * cu, 3.8 * cu; line -(5.5 + 1.5 * bright_level) * cu, (5.5 + 1.5 * bright_level) * cu }
            path { at: pcx - 119 * cu, bsy; stroke: 1.3 * cu; color: ink; opacity: 40% + 60% * bright_level; move 3.8 * cu, 3.8 * cu; line (5.5 + 1.5 * bright_level) * cu, (5.5 + 1.5 * bright_level) * cu }
            body {
                color: deep
                rim: 9%
                box { at: bsl.x0 + bsl.w / 2, bsy; size: bsl.w, bth; corner: bth / 2 }
            }
            group {
                glow: 7 * cu, 50%, mint
                body {
                    gradient: bsl.x0, 0 to bsl.x0 + bsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: bsl.x0, bsy - bth / 2; size: max(0.1, bsl.w * bright_level), bth; corner: bth / 2 }
                }
            }
            zone box bright_hit { at: bsl.x0 + bsl.w / 2, bsy; size: bsl.w + 28 * cu, 34 * cu; cursor: pointer; active: brightness.present and bright_avail }
            on press bright_hit { emit setbright(clamp((pointer.x - bsl.x0) / bsl.w, 0, 1)) }
            on drag bright_hit { emit setbright(clamp((pointer.x - bsl.x0) / bsl.w, 0, 1)) }
            text number(bright_level * 100, 0, "%") { at: floor(pcx + 128 * cu + 0.5), floor(bcy - 14 * cu + 0.5); anchor: right center; size: 18.5; weight: 600; color: ink; family: "Space Grotesk"; show: brightness.present and bright_avail }
            text "No backlight" { at: floor(pcx + 128 * cu + 0.5), floor(bcy - 14 * cu + 0.5); anchor: right center; size: 15; color: faint; family: "Space Grotesk"; show: not brightness.present }
            text "brightnessctl missing" { at: floor(pcx + 128 * cu + 0.5), floor(bcy - 14 * cu + 0.5); anchor: right center; size: 14; color: faint; family: "Space Grotesk"; show: brightness.present and not bright_avail }
            text "Brightness" { at: floor(pcx - 128 * cu + 0.5), floor(bcy - 14 * cu + 0.5); anchor: left center; size: 16; color: faint; family: "Space Grotesk" }
        }

        //  Wi-Fi and Bluetooth: two narrow tiles side by side, each just its
        //  name, a signal, and the toggle for its radio. Tapping the rest of
        //  the tile - the toggle has its own small zone, declared after so it
        //  wins there - grows it into its own window, below.
        group {
            opacity: f2 * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f2) * 12 * cu
            let tile_cy = ck + (tiles_top + tiles_h / 2) * cu
            let tile2_cy = ck + (tiles2_top + tiles_h / 2) * cu
            //  Six tiles, three across and two down. Each one hangs its content from a `base` 21 right of its middle: tile 1's middle
            //  is 97 left of the drawer's, tile 3's 97 right of it.
            let tb1 = pcx - 76 * cu
            let tb2 = pcx + 21 * cu
            let tb3 = pcx + 118 * cu

            box { at: tb1 - 21 * cu, tile_cy; size: 94 * cu, tiles_h * cu; corner: 14 * cu; color: ink; opacity: veil }
            box { at: tb1 - 53 * cu, tile_cy - 14 * cu; size: 3 * cu, 6 * cu;  corner: 1.5 * cu; color: ink; opacity: if(on_wifi, 45% + 55% * clamp(net.strength / 0.3, 0, 1), 30%) }
            box { at: tb1 - 48 * cu, tile_cy - 16 * cu; size: 3 * cu, 10 * cu; corner: 1.5 * cu; color: ink; opacity: if(on_wifi, 45% + 55% * clamp(net.strength / 0.65, 0, 1), 30%) }
            box { at: tb1 - 43 * cu, tile_cy - 18 * cu; size: 3 * cu, 14 * cu; corner: 1.5 * cu; color: ink; opacity: if(on_wifi, 45% + 55% * clamp(net.strength / 1.0, 0, 1), 30%) }
            text "Wi-Fi" { at: floor(tb1 - 58 * cu + 0.5), floor(tile_cy + 4 * cu + 0.5); anchor: left center; size: 13; color: ink; family: "Space Grotesk" }
            text net.name { at: floor(tb1 - 58 * cu + 0.5), floor(tile_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: on_wifi }
            text "Disconnected" { at: floor(tb1 - 58 * cu + 0.5), floor(tile_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; color: faint; family: "Space Grotesk"; show: net.wifi and not (on_wifi) }
            text "Off" { at: floor(tb1 - 58 * cu + 0.5), floor(tile_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; color: faint; family: "Space Grotesk"; show: not net.wifi }
            body {
                color: mix(off, mint, clamp(wifi_on, 0, 1))
                box { at: tb1 + 5 * cu, tile_cy - 18 * cu; size: 38 * cu, 22 * cu; corner: 11 * cu }
            }
            box { at: tb1 - 3 * cu + wifi_on * 16 * cu, tile_cy - 18 * cu; size: (17 + 9 * clamp(4 * wifi_on * (1 - wifi_on), 0, 1)) * cu, (17 - 3 * clamp(4 * wifi_on * (1 - wifi_on), 0, 1)) * cu; corner: (8.5 - 1.5 * clamp(4 * wifi_on * (1 - wifi_on), 0, 1)) * cu; color: ink }
            zone box wifi_tile_hit { at: tb1 - 21 * cu, tile_cy; size: 94 * cu, tiles_h * cu; cursor: pointer }
            on press wifi_tile_hit { panel_sub = if(panel_sub == netview, none, netview) }
            zone box wifi_toggle_hit { at: tb1 + 5 * cu, tile_cy - 18 * cu; size: 46 * cu, 30 * cu; cursor: pointer }
            on press wifi_toggle_hit { emit togglewifi(not net.wifi) }

            box { at: tb1 - 21 * cu, tile2_cy; size: 94 * cu, tiles_h * cu; corner: 14 * cu; color: ink; opacity: veil }
            box { at: tb1 - 48 * cu, tile2_cy - 18 * cu; size: 2.4 * cu, 16 * cu; corner: 1.2 * cu; color: ink; opacity: 45% + 55% * bt_on }
            path { at: tb1 - 48 * cu, tile2_cy - 18 * cu; stroke: 1.5 * cu; color: ink; opacity: 45% + 55% * bt_on; move -4 * cu, -4 * cu; line 4 * cu, 4 * cu }
            path { at: tb1 - 48 * cu, tile2_cy - 18 * cu; stroke: 1.5 * cu; color: ink; opacity: 45% + 55% * bt_on; move 4 * cu, -4 * cu; line -4 * cu, 4 * cu }
            text "Bluetooth" { at: floor(tb1 - 58 * cu + 0.5), floor(tile2_cy + 4 * cu + 0.5); anchor: left center; size: 13; color: ink; family: "Space Grotesk" }
            text bt_name { at: floor(tb1 - 58 * cu + 0.5), floor(tile2_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: bt_connected }
            text "No device" { at: floor(tb1 - 58 * cu + 0.5), floor(tile2_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; color: faint; family: "Space Grotesk"; show: bt.powered and not bt_connected }
            text "Off" { at: floor(tb1 - 58 * cu + 0.5), floor(tile2_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; color: faint; family: "Space Grotesk"; show: not bt.powered }
            body {
                color: mix(off, mint, clamp(bt_on, 0, 1))
                box { at: tb1 + 5 * cu, tile2_cy - 18 * cu; size: 38 * cu, 22 * cu; corner: 11 * cu }
            }
            box { at: tb1 - 3 * cu + bt_on * 16 * cu, tile2_cy - 18 * cu; size: (17 + 9 * clamp(4 * bt_on * (1 - bt_on), 0, 1)) * cu, (17 - 3 * clamp(4 * bt_on * (1 - bt_on), 0, 1)) * cu; corner: (8.5 - 1.5 * clamp(4 * bt_on * (1 - bt_on), 0, 1)) * cu; color: ink }
            zone box bt_tile_hit { at: tb1 - 21 * cu, tile2_cy; size: 94 * cu, tiles_h * cu; cursor: pointer }
            on press bt_tile_hit { panel_sub = if(panel_sub == btview, none, btview) }
            zone box bt_toggle_hit { at: tb1 + 5 * cu, tile2_cy - 18 * cu; size: 46 * cu, 30 * cu; cursor: pointer }
            on press bt_toggle_hit { emit togglebt(not bt.powered) }

            //  Notifications (Do Not Disturb, with its own window) and Caffeine (the whole tile is its toggle), underneath.

            box { at: tb3 - 21 * cu, tile_cy; size: 94 * cu, tiles_h * cu; corner: 14 * cu; color: ink; opacity: veil + 6% * dnd_hit.hover }
            //  A bell: dome, rim and clapper, struck through while it is on.
            group {
                pivot: tb3 - 48 * cu, tile_cy - 18 * cu
                rotate: dnd_wobble * 14deg
                //  Solid parts, faded as one group: partial opacity per part shows the overlaps.
                opacity: 45% + 55% * dnd_pill
                ellipse { at: tb3 - 48 * cu, tile_cy - 19 * cu; radius: 5.5 * cu; color: ink }
                box { at: tb3 - 48 * cu, tile_cy - 14.5 * cu; size: 14 * cu, 3 * cu; corner: 1.5 * cu; color: ink }
                ellipse { at: tb3 - 48 * cu, tile_cy - 11 * cu; radius: 1.6 * cu; color: ink }
            }
            path { at: tb3 - 48 * cu, tile_cy - 18 * cu; stroke: 1.8 * cu; color: alert; opacity: dnd_pill; move -8 * cu, -8 * cu; line 8 * cu, 8 * cu }
            text "Notifications" { at: floor(tb3 - 58 * cu + 0.5), floor(tile_cy + 4 * cu + 0.5); anchor: left center; size: 13; width: 74 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            text nt_tile_sub { at: floor(tb3 - 58 * cu + 0.5), floor(tile_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: if(dnd_on, mint, faint); family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(dnd_pill, 0, 1))
                box { at: tb3 + 5 * cu, tile_cy - 18 * cu; size: 38 * cu, 22 * cu; corner: 11 * cu }
            }
            box { at: tb3 - 3 * cu + dnd_pill * 16 * cu, tile_cy - 18 * cu; size: (17 + 9 * clamp(4 * dnd_pill * (1 - dnd_pill), 0, 1)) * cu, (17 - 3 * clamp(4 * dnd_pill * (1 - dnd_pill), 0, 1)) * cu; corner: (8.5 - 1.5 * clamp(4 * dnd_pill * (1 - dnd_pill), 0, 1)) * cu; color: ink }
            zone box dnd_hit { at: tb3 - 21 * cu, tile_cy; size: 94 * cu, tiles_h * cu; cursor: pointer }
            on press dnd_hit { panel_sub = if(panel_sub == notifview, none, notifview) }
            zone box dnd_toggle_hit { at: tb3 + 5 * cu, tile_cy - 18 * cu; size: 46 * cu, 30 * cu; cursor: pointer }
            on press dnd_toggle_hit { emit togglednd }

            //  Caffeine: a cup that steams while the machine is being kept awake. Dimmed on a
            //  machine with no hypridle, which is what the card would be stopping.
            group {
                opacity: mix(0.45, 1, caf_avail)
                box { at: tb2 - 21 * cu, tile_cy; size: 94 * cu, tiles_h * cu; corner: 14 * cu; color: ink; opacity: veil + 6% * caf_hit.hover * caf_avail }
                group {
                    opacity: 45% + 55% * caf_pill
                    box { at: tb2 - 49 * cu, tile_cy - 16 * cu; size: 12 * cu, 10 * cu; corner: 3 * cu; color: ink }
                    ellipse { at: tb2 - 41.5 * cu, tile_cy - 16 * cu; radius: 3 * cu; stroke: 1.5 * cu; color: ink }
                }
                repeat i in 0..3 {
                    let sp = fract(time * 0.7 + i * 0.33)
                    box { at: tb2 - 52 * cu + i * 3.5 * cu, tile_cy - 24 * cu - sp * 6 * cu; size: 1.4 * cu, 5 * cu; corner: 0.7 * cu; color: ink; opacity: caf_pill * 55% * sin(sp * 180) }
                }
                text "Caffeine" { at: floor(tb2 - 58 * cu + 0.5), floor(tile_cy + 4 * cu + 0.5); anchor: left center; size: 13; color: ink; family: "Space Grotesk" }
                text "Awake" { at: floor(tb2 - 58 * cu + 0.5), floor(tile_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; color: mint; opacity: 90%; family: "Space Grotesk"; show: caf_on and caf_len == 0 }
                text caf_tile_sub { at: floor(tb2 - 58 * cu + 0.5), floor(tile_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: caf_on and caf_len > 0 }
                text "Off" { at: floor(tb2 - 58 * cu + 0.5), floor(tile_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; color: faint; family: "Space Grotesk"; show: not caf_on and caf_avail }
                text "No hypridle" { at: floor(tb2 - 58 * cu + 0.5), floor(tile_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; color: faint; family: "Space Grotesk"; show: not caf_avail }
                body {
                    color: mix(off, mint, clamp(caf_pill, 0, 1))
                    box { at: tb2 + 5 * cu, tile_cy - 18 * cu; size: 38 * cu, 22 * cu; corner: 11 * cu }
                }
                box { at: tb2 - 3 * cu + caf_pill * 16 * cu, tile_cy - 18 * cu; size: (17 + 9 * clamp(4 * caf_pill * (1 - caf_pill), 0, 1)) * cu, (17 - 3 * clamp(4 * caf_pill * (1 - caf_pill), 0, 1)) * cu; corner: (8.5 - 1.5 * clamp(4 * caf_pill * (1 - caf_pill), 0, 1)) * cu; color: ink }
                zone box caf_hit { at: tb2 - 21 * cu, tile_cy; size: 94 * cu, tiles_h * cu; cursor: pointer; active: caf_avail }
                on press caf_hit { panel_sub = if(panel_sub == cafview, none, cafview) }
                zone box caf_toggle_hit { at: tb2 + 5 * cu, tile_cy - 18 * cu; size: 46 * cu, 30 * cu; cursor: pointer; active: caf_avail }
                on press caf_toggle_hit { emit togglecaf }
            }

            //  Capture and Power: a third row. Capture's button starts and stops a recording; the rest of the tile opens its window
            //  (screenshots, and a recording of the whole screen). Power has no switch: the whole tile opens its window.

            box { at: tb2 - 21 * cu, tile2_cy; size: 94 * cu, tiles_h * cu; corner: 14 * cu; color: ink; opacity: veil + 6% * cap_hit.hover }
            box { at: tb2 - 48 * cu, tile2_cy - 17 * cu; size: 16 * cu, 12 * cu; corner: 3 * cu; stroke: 1.5 * cu; color: ink; opacity: 45% + 55% * rec_pill }
            ellipse { at: tb2 - 48 * cu, tile2_cy - 17 * cu; radius: 2.6 * cu; stroke: 1.4 * cu; color: ink; opacity: 45% + 55% * rec_pill }
            text "Capture" { at: floor(tb2 - 58 * cu + 0.5), floor(tile2_cy + 4 * cu + 0.5); anchor: left center; size: 13; color: ink; family: "Space Grotesk" }
            text rec_time { at: floor(tb2 - 58 * cu + 0.5), floor(tile2_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: rec_on }
            text "Shot · Record" { at: floor(tb2 - 58 * cu + 0.5), floor(tile2_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: faint; family: "Space Grotesk"; show: not rec_on }
            //  The record button: a ring with a dot in it, which becomes a square (and beats) while it records.
            ellipse { at: tb2 + 5 * cu, tile2_cy - 18 * cu; radius: 10 * cu; stroke: 1.5 * cu; color: mint; opacity: 55% + 45% * rec_pill }
            box { at: tb2 + 5 * cu, tile2_cy - 18 * cu; size: (10 - 2 * rec_pill) * cu, (10 - 2 * rec_pill) * cu; corner: (5 - 3 * rec_pill) * cu; color: mint; opacity: 65% + 35% * rec_pill - rec_pill * 0.25 * (0.5 + 0.5 * sin(time * 300)) }
            zone box cap_hit { at: tb2 - 21 * cu, tile2_cy; size: 94 * cu, tiles_h * cu; cursor: pointer }
            on press cap_hit { panel_sub = if(panel_sub == capview, none, capview) }
            zone box cap_rec_hit { at: tb2 + 5 * cu, tile2_cy - 18 * cu; size: 34 * cu, 30 * cu; corner: 15 * cu; cursor: pointer }
            on press cap_rec_hit { emit rec_toggle }

            box { at: tb3 - 21 * cu, tile2_cy; size: 94 * cu, tiles_h * cu; corner: 14 * cu; color: ink; opacity: veil + 6% * pow_hit.hover }
            //  A power symbol: a ring open at the top, and the bar through the gap.
            path { at: tb3 - 48 * cu, tile2_cy - 17 * cu; stroke: 1.6 * cu; color: ink; opacity: 75%; move 3.73 * cu, -5.32 * cu; line 5.32 * cu, -3.73 * cu; line 6.28 * cu, -1.68 * cu; line 6.48 * cu, 0.57 * cu; line 5.89 * cu, 2.75 * cu; line 4.60 * cu, 4.60 * cu; line 2.75 * cu, 5.89 * cu; line 0.57 * cu, 6.48 * cu; line -1.68 * cu, 6.28 * cu; line -3.73 * cu, 5.32 * cu; line -5.32 * cu, 3.73 * cu; line -6.28 * cu, 1.68 * cu; line -6.48 * cu, -0.57 * cu; line -5.89 * cu, -2.75 * cu; line -4.60 * cu, -4.60 * cu }
            box { at: tb3 - 48 * cu, tile2_cy - 21.5 * cu; size: 1.6 * cu, 8 * cu; corner: 0.8 * cu; color: ink; opacity: 75% }
            text "Power" { at: floor(tb3 - 58 * cu + 0.5), floor(tile2_cy + 4 * cu + 0.5); anchor: left center; size: 13; color: ink; family: "Space Grotesk" }
            text "Power saver" { at: floor(tb3 - 58 * cu + 0.5), floor(tile2_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: pow_prof == 0 }
            text "Balanced" { at: floor(tb3 - 58 * cu + 0.5), floor(tile2_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: pow_prof == 1 }
            text "Performance" { at: floor(tb3 - 58 * cu + 0.5), floor(tile2_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: pow_prof == 2 }
            text "Lock · Sleep · Off" { at: floor(tb3 - 58 * cu + 0.5), floor(tile2_cy + 19 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: faint; family: "Space Grotesk"; show: pow_prof < 0 }
            zone box pow_hit { at: tb3 - 21 * cu, tile2_cy; size: 94 * cu, tiles_h * cu; cursor: pointer }
            on press pow_hit { panel_sub = if(panel_sub == powview, none, powview) }
        }

        //  The Wi-Fi tile's own window: the networks in range, strongest first.
        //  A known or open one connects on a tap; a secured one not seen before
        //  asks for its password first.
        group {
            show: showing_sub == netview
            opacity: expand0
            let ex_top = ck + tiles_top * cu
            let ex_cy = ex_top + 22 * cu
            path { at: pcx - 124 * cu, ex_cy; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * wifi_back.hover; move 4 * cu, -6 * cu; line -4 * cu, 0; line 4 * cu, 6 * cu }
            zone box wifi_back { at: pcx - 124 * cu, ex_cy; size: 30 * cu, 30 * cu; cursor: pointer }
            on press wifi_back { panel_sub = none }
            text "WI-FI" { at: floor(pcx - 102 * cu + 0.5), floor(ex_cy + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: pcx + 112 * cu, ex_cy; size: 52 * cu, 24 * cu; corner: 12 * cu; color: if(wifi_scanning, mint, ink); opacity: if(wifi_scanning, 22%, 8% + 10% * wifi_scan_hit.hover) }
            text "Scan" { at: floor(pcx + 112 * cu + 0.5), floor(ex_cy + 0.5); anchor: center; size: 12.5; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk"; show: not wifi_scanning }
            //  While it runs: a ring turning where the word was, and the list says so.
            group {
                show: wifi_scanning
                pivot: pcx + 112 * cu, ex_cy
                rotate: time * 420deg
                arc { at: pcx + 112 * cu, ex_cy; radius: 6 * cu; span: 260deg; width: 1.8 * cu; color: mint }
            }
            zone box wifi_scan_hit { at: pcx + 112 * cu, ex_cy; size: 54 * cu, 26 * cu; corner: 13 * cu; cursor: pointer }
            on press wifi_scan_hit { emit wifi_scan }
            box { at: pcx, ex_top + 44 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }
            column wifi_list_col ~quick {
                at: floor(pcx - 138 * cu + 0.5), floor(ex_top + 54 * cu + 0.5)
                view: 276 * cu, list_view_h * cu
                gap: 5
                for n in wifi_nets { WifiRow(n, pick: wifi_pick, forget: wifi_forget, joingo: wifi_join_go) }
            }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: pcx + 141 * cu, ex_top + 54 * cu + wifi_list_col.scroll / max(wifi_list_col.content, 1) * (list_view_h * cu); size: 3 * cu, (list_view_h * cu) * (list_view_h * cu) / max(wifi_list_col.content, list_view_h * cu); corner: 1.5 * cu; color: ink; opacity: if(wifi_list_col.content > (list_view_h * cu) + 1, 35%, 0%) }
            text "No networks in range" { at: floor(pcx + 0.5), floor(ex_top + 54 * cu + 15 * cu + 0.5); anchor: center; size: 14; color: faint; family: "Space Grotesk"; show: wifi_nets.count < 1 and not wifi_scanning }
            text "Scanning…" { at: floor(pcx + 0.5), floor(ex_top + 54 * cu + 15 * cu + 0.5); anchor: center; size: 14; color: mint; family: "Space Grotesk"; show: wifi_nets.count < 1 and wifi_scanning }
        }

        //  The Bluetooth tile's own window: paired and nearby devices, connected first.
        group {
            show: showing_sub == btview
            opacity: expand0
            let ex2_top = ck + tiles_top * cu
            let ex2_cy = ex2_top + 22 * cu
            path { at: pcx - 124 * cu, ex2_cy; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * bt_back.hover; move 4 * cu, -6 * cu; line -4 * cu, 0; line 4 * cu, 6 * cu }
            zone box bt_back { at: pcx - 124 * cu, ex2_cy; size: 30 * cu, 30 * cu; cursor: pointer }
            on press bt_back { panel_sub = none }
            text "BLUETOOTH" { at: floor(pcx - 102 * cu + 0.5), floor(ex2_cy + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: pcx + 112 * cu, ex2_cy; size: 52 * cu, 24 * cu; corner: 12 * cu; color: if(bt_scanning, mint, ink); opacity: if(bt_scanning, 22%, 8% + 10% * bt_scan_hit.hover) }
            text "Scan" { at: floor(pcx + 112 * cu + 0.5), floor(ex2_cy + 0.5); anchor: center; size: 12.5; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk"; show: not bt_scanning }
            //  While it runs: a ring turning where the word was, and the list says so.
            group {
                show: bt_scanning
                pivot: pcx + 112 * cu, ex2_cy
                rotate: time * 420deg
                arc { at: pcx + 112 * cu, ex2_cy; radius: 6 * cu; span: 260deg; width: 1.8 * cu; color: mint }
            }
            zone box bt_scan_hit { at: pcx + 112 * cu, ex2_cy; size: 54 * cu, 26 * cu; corner: 13 * cu; cursor: pointer }
            on press bt_scan_hit { emit bt_scan }
            box { at: pcx, ex2_top + 44 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }
            column bt_list_col ~quick {
                at: floor(pcx - 138 * cu + 0.5), floor(ex2_top + 54 * cu + 0.5)
                view: 276 * cu, list_view_h * cu
                gap: 5
                for d in bt_devices { BtRow(d, pick: bt_pick, forget: bt_forget) }
            }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: pcx + 141 * cu, ex2_top + 54 * cu + bt_list_col.scroll / max(bt_list_col.content, 1) * (list_view_h * cu); size: 3 * cu, (list_view_h * cu) * (list_view_h * cu) / max(bt_list_col.content, list_view_h * cu); corner: 1.5 * cu; color: ink; opacity: if(bt_list_col.content > (list_view_h * cu) + 1, 35%, 0%) }
            text "No devices found" { at: floor(pcx + 0.5), floor(ex2_top + 54 * cu + 15 * cu + 0.5); anchor: center; size: 14; color: faint; family: "Space Grotesk"; show: bt_devices.count < 1 and not bt_scanning }
            text "Scanning…" { at: floor(pcx + 0.5), floor(ex2_top + 54 * cu + 15 * cu + 0.5); anchor: center; size: 14; color: mint; family: "Space Grotesk"; show: bt_devices.count < 1 and bt_scanning }
        }

        //  The notifications window: Do Not Disturb (a toggle, and timer chips that count down), and under them
        //  the history of what came in, newest first. Clear empties it; a row's cross removes that one.
        group {
            show: showing_sub == notifview
            opacity: expand0
            let nx_top = ck + tiles_top * cu
            let nx_cy = nx_top + 22 * cu
            path { at: pcx - 124 * cu, nx_cy; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * nt_back.hover; move 4 * cu, -6 * cu; line -4 * cu, 0; line 4 * cu, 6 * cu }
            zone box nt_back { at: pcx - 124 * cu, nx_cy; size: 30 * cu, 30 * cu; cursor: pointer }
            on press nt_back { panel_sub = none }
            text "NOTIFICATIONS" { at: floor(pcx - 102 * cu + 0.5), floor(nx_cy + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: pcx + 112 * cu, nx_cy; size: 52 * cu, 24 * cu; corner: 12 * cu; color: ink; opacity: 8% + 10% * nt_clear_hit.hover }
            text "Clear" { at: floor(pcx + 112 * cu + 0.5), floor(nx_cy + 0.5); anchor: center; size: 12.5; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box nt_clear_hit { at: pcx + 112 * cu, nx_cy; size: 54 * cu, 26 * cu; corner: 13 * cu; cursor: pointer }
            on press nt_clear_hit { emit nt_clear }
            box { at: pcx, nx_top + 44 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }

            //  Do Not Disturb: its toggle, and what state it is in.
            box { at: pcx, nx_top + 66 * cu; size: 276 * cu, 34 * cu; corner: 12 * cu; color: ink; opacity: veil }
            text "Do Not Disturb" { at: floor(pcx - 128 * cu + 0.5), floor(nx_top + 60 * cu + 0.5); anchor: left center; size: 14.5; weight: 700; color: ink; family: "Space Grotesk" }
            text dnd_left { at: floor(pcx - 128 * cu + 0.5), floor(nx_top + 74 * cu + 0.5); anchor: left center; size: 11.5; width: 200 * cu; lines: 1; color: if(dnd_on, mint, faint); family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(dnd_pill, 0, 1))
                box { at: pcx + 118 * cu, nx_top + 66 * cu; size: 30 * cu, 16 * cu; corner: 8 * cu }
            }
            ellipse { at: pcx + 111 * cu + dnd_pill * 14 * cu, nx_top + 66 * cu; radius: 6.2 * cu; color: ink }
            zone box nt_dnd_toggle { at: pcx + 118 * cu, nx_top + 66 * cu; size: 40 * cu, 26 * cu; corner: 13 * cu; cursor: pointer }
            on press nt_dnd_toggle { emit togglednd }

            //  The timer: pressing a chip silences for that long; pressing the lit one again cancels it.
            repeat i in 0..4 {
                let chx = pcx - 107 * cu + i * 70 * cu
                box { at: chx, nx_top + 100 * cu; size: 62 * cu, 26 * cu; corner: 13 * cu; color: if(dnd_len == pick(i, 15, 30, 60, 120), mint, ink); opacity: if(dnd_len == pick(i, 15, 30, 60, 120), 24%, 8% + 10% * dnd_chip.$i.hover) }
                text pick(i, "15 min", "30 min", "1 hour", "2 hours") { at: floor(chx + 0.5), floor(nx_top + 100 * cu + 0.5); anchor: center; align: center; size: 12.5; weight: 600; width: 60 * cu; lines: 1; color: if(dnd_len == pick(i, 15, 30, 60, 120), mint, ink); family: "Space Grotesk" }
                zone box dnd_chip.$i { at: chx, nx_top + 100 * cu; size: 64 * cu, 28 * cu; corner: 14 * cu; cursor: pointer }
                on press dnd_chip.$i { emit dnd_for(pick(i, 15, 30, 60, 120)) }
            }

            //  The history.
            text "HISTORY" { at: floor(pcx - 134 * cu + 0.5), floor(nx_top + 126 * cu + 0.5); anchor: left center; size: 10.5; weight: 700; color: faint; opacity: 80%; family: "Space Grotesk" }
            column nt_hist_col {
                at: floor(pcx - 138 * cu + 0.5), floor(nx_top + 138 * cu + 0.5)
                view: 276 * cu, list_view_h * cu
                gap: 6
                for h in nt_hist { NtHistRow(h, del: nt_hist_del) }
            }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: pcx + 141 * cu, nx_top + 138 * cu + nt_hist_col.scroll / max(nt_hist_col.content, 1) * (list_view_h * cu); size: 3 * cu, (list_view_h * cu) * (list_view_h * cu) / max(nt_hist_col.content, list_view_h * cu); corner: 1.5 * cu; color: ink; opacity: if(nt_hist_col.content > (list_view_h * cu) + 1, 35%, 0%) }
            text "No notifications yet" { at: floor(pcx + 0.5), floor(nx_top + 138 * cu + 20 * cu + 0.5); anchor: center; size: 14; color: faint; family: "Space Grotesk"; show: nt_hist.count < 1 }
        }

        //  The Caffeine window: the keep-awake switch and what state it is in, and timer chips. A chip keeps the
        //  machine awake for that long and then lets it sleep again; the lit one, pressed again, turns it off.
        group {
            show: showing_sub == cafview
            opacity: expand0
            let kx_top = ck + tiles_top * cu
            let kx_cy = kx_top + 22 * cu
            path { at: pcx - 124 * cu, kx_cy; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * caf_back.hover; move 4 * cu, -6 * cu; line -4 * cu, 0; line 4 * cu, 6 * cu }
            zone box caf_back { at: pcx - 124 * cu, kx_cy; size: 30 * cu, 30 * cu; cursor: pointer }
            on press caf_back { panel_sub = none }
            text "CAFFEINE" { at: floor(pcx - 102 * cu + 0.5), floor(kx_cy + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: pcx, kx_top + 44 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }

            group {
                opacity: mix(0.45, 1, caf_avail)
                box { at: pcx, kx_top + 66 * cu; size: 276 * cu, 34 * cu; corner: 12 * cu; color: ink; opacity: veil }
                text "Keep awake" { at: floor(pcx - 128 * cu + 0.5), floor(kx_top + 60 * cu + 0.5); anchor: left center; size: 14.5; weight: 700; color: ink; family: "Space Grotesk" }
                text caf_left { at: floor(pcx - 128 * cu + 0.5), floor(kx_top + 74 * cu + 0.5); anchor: left center; size: 11.5; width: 200 * cu; lines: 1; color: if(caf_on, mint, faint); family: "Space Grotesk" }
                body {
                    color: mix(off, mint, clamp(caf_pill, 0, 1))
                    box { at: pcx + 118 * cu, kx_top + 66 * cu; size: 30 * cu, 16 * cu; corner: 8 * cu }
                }
                ellipse { at: pcx + 111 * cu + caf_pill * 14 * cu, kx_top + 66 * cu; radius: 6.2 * cu; color: ink }
                zone box caf_toggle2 { at: pcx + 118 * cu, kx_top + 66 * cu; size: 40 * cu, 26 * cu; corner: 13 * cu; cursor: pointer; active: caf_avail }
                on press caf_toggle2 { emit togglecaf }

                //  Two lines of three chips.
                repeat i in 0..6 {
                    let chx = pcx + (mod(i, 3) - 1) * 94 * cu
                    let chy = kx_top + 100 * cu + floor(i / 3) * 32 * cu
                    let lit = caf_on and caf_len == pick(i, 15, 30, 60, 120, 240, 0)
                    box { at: chx, chy; size: 88 * cu, 26 * cu; corner: 13 * cu; color: if(lit, mint, ink); opacity: if(lit, 24%, 8% + 10% * caf_chip.$i.hover) }
                    text pick(i, "15 min", "30 min", "1 hour", "2 hours", "4 hours", "Until off") { at: floor(chx + 0.5), floor(chy + 0.5); anchor: center; align: center; size: 12.5; weight: 600; width: 84 * cu; lines: 1; color: if(lit, mint, ink); opacity: if(lit, 100%, 85%); family: "Space Grotesk" }
                    zone box caf_chip.$i { at: chx, chy; size: 90 * cu, 28 * cu; corner: 14 * cu; cursor: pointer; active: caf_avail }
                    on press caf_chip.$i { emit caf_for(pick(i, 15, 30, 60, 120, 240, 0)) }
                }
            }
        }

        //  The Capture window: a screenshot of a region or of the whole screen (kept in ~/Pictures/Screenshots and copied), and
        //  a screen recording (kept in ~/Videos), with a Stop while one is running. Big tiles with an icon each.
        group {
            show: showing_sub == capview
            opacity: expand0
            let qx_top = ck + tiles_top * cu
            let qx_cy = qx_top + 22 * cu
            path { at: pcx - 124 * cu, qx_cy; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * qx_back.hover; move 4 * cu, -6 * cu; line -4 * cu, 0; line 4 * cu, 6 * cu }
            zone box qx_back { at: pcx - 124 * cu, qx_cy; size: 30 * cu, 30 * cu; cursor: pointer }
            on press qx_back { panel_sub = none }
            text "CAPTURE" { at: floor(pcx - 102 * cu + 0.5), floor(qx_cy + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: pcx, qx_top + 44 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }
            text "SCREENSHOT" { at: floor(pcx - 138 * cu + 0.5), floor(qx_top + 62 * cu + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
            box { at: pcx - 70 * cu, qx_top + 92 * cu; size: 134 * cu, 52 * cu; corner: 14 * cu; color: ink; opacity: 8% + 9% * cap_s0.hover }
            box { at: pcx - 70 * cu, qx_top + 92 * cu; size: 134 * cu, 52 * cu; corner: 14 * cu; color: mint; opacity: 16% * cap_s0.hover }
            path { at: pcx - 70 * cu - 37.0 * cu, qx_top + 92 * cu; stroke: 1.6 * cu; color: mix(ink, mint, cap_s0.hover); opacity: 100%; move -7 * cu, -3 * cu; line -7 * cu, -7 * cu; line -3 * cu, -7 * cu }
            path { at: pcx - 70 * cu - 37.0 * cu, qx_top + 92 * cu; stroke: 1.6 * cu; color: mix(ink, mint, cap_s0.hover); opacity: 100%; move -7 * cu, 3 * cu; line -7 * cu, 7 * cu; line -3 * cu, 7 * cu }
            path { at: pcx - 70 * cu - 37.0 * cu, qx_top + 92 * cu; stroke: 1.6 * cu; color: mix(ink, mint, cap_s0.hover); opacity: 100%; move 7 * cu, -3 * cu; line 7 * cu, -7 * cu; line 3 * cu, -7 * cu }
            path { at: pcx - 70 * cu - 37.0 * cu, qx_top + 92 * cu; stroke: 1.6 * cu; color: mix(ink, mint, cap_s0.hover); opacity: 100%; move 7 * cu, 3 * cu; line 7 * cu, 7 * cu; line 3 * cu, 7 * cu }
            ellipse { at: pcx - 70 * cu - 37.0 * cu, qx_top + 92 * cu; radius: 1.5 * cu; color: mix(ink, mint, cap_s0.hover); opacity: 100% }
            text "Region" { at: floor(pcx - 70 * cu - 17.0 * cu + 0.5), floor(qx_top + 92 * cu + 0.5); anchor: left center; size: 14; weight: 600; width: 72 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            zone box cap_s0 { at: pcx - 70 * cu, qx_top + 92 * cu; size: 136 * cu, 54 * cu; corner: 15 * cu; cursor: pointer }
            on press cap_s0 { emit shot(0) }
            box { at: pcx + 70 * cu, qx_top + 92 * cu; size: 134 * cu, 52 * cu; corner: 14 * cu; color: ink; opacity: 8% + 9% * cap_s1.hover }
            box { at: pcx + 70 * cu, qx_top + 92 * cu; size: 134 * cu, 52 * cu; corner: 14 * cu; color: mint; opacity: 16% * cap_s1.hover }
            box { at: pcx + 70 * cu - 37.0 * cu, qx_top + 92 * cu - 1 * cu; size: 17 * cu, 11.5 * cu; corner: 2.5 * cu; stroke: 1.6 * cu; color: mix(ink, mint, cap_s1.hover); opacity: 100% }
            path { at: pcx + 70 * cu - 37.0 * cu, qx_top + 92 * cu; stroke: 1.6 * cu; color: mix(ink, mint, cap_s1.hover); opacity: 100%; move -3 * cu, 7.5 * cu; line 3 * cu, 7.5 * cu }
            text "Full screen" { at: floor(pcx + 70 * cu - 17.0 * cu + 0.5), floor(qx_top + 92 * cu + 0.5); anchor: left center; size: 14; weight: 600; width: 72 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            zone box cap_s1 { at: pcx + 70 * cu, qx_top + 92 * cu; size: 136 * cu, 54 * cu; corner: 15 * cu; cursor: pointer }
            on press cap_s1 { emit shot(1) }
            text "SCREEN RECORDING" { at: floor(pcx - 138 * cu + 0.5), floor(qx_top + 134 * cu + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
            text rec_time { at: floor(pcx + 138 * cu + 0.5), floor(qx_top + 134 * cu + 0.5); anchor: right center; size: 12; weight: 600; color: mint; family: "Space Grotesk"; show: rec_on }
            group {
                show: not rec_on
                box { at: pcx - 70 * cu, qx_top + 164 * cu; size: 134 * cu, 52 * cu; corner: 14 * cu; color: ink; opacity: 8% + 9% * cap_r0.hover }
                box { at: pcx - 70 * cu, qx_top + 164 * cu; size: 134 * cu, 52 * cu; corner: 14 * cu; color: mint; opacity: 14% * cap_r0.hover }
                path { at: pcx - 70 * cu - 37 * cu, qx_top + 164 * cu; stroke: 1.6 * cu; color: mix(ink, mint, cap_r0.hover); opacity: 100%; move -7 * cu, -3 * cu; line -7 * cu, -7 * cu; line -3 * cu, -7 * cu }
                path { at: pcx - 70 * cu - 37 * cu, qx_top + 164 * cu; stroke: 1.6 * cu; color: mix(ink, mint, cap_r0.hover); opacity: 100%; move -7 * cu, 3 * cu; line -7 * cu, 7 * cu; line -3 * cu, 7 * cu }
                path { at: pcx - 70 * cu - 37 * cu, qx_top + 164 * cu; stroke: 1.6 * cu; color: mix(ink, mint, cap_r0.hover); opacity: 100%; move 7 * cu, -3 * cu; line 7 * cu, -7 * cu; line 3 * cu, -7 * cu }
                path { at: pcx - 70 * cu - 37 * cu, qx_top + 164 * cu; stroke: 1.6 * cu; color: mix(ink, mint, cap_r0.hover); opacity: 100%; move 7 * cu, 3 * cu; line 7 * cu, 7 * cu; line 3 * cu, 7 * cu }
                ellipse { at: pcx - 70 * cu - 37 * cu, qx_top + 164 * cu; radius: 1.5 * cu; color: mix(ink, mint, cap_r0.hover); opacity: 100% }
                ellipse { at: pcx - 70 * cu - 37 * cu + 10 * cu, qx_top + 164 * cu - 10 * cu; radius: 2.8 * cu; color: mint }
                text "Region" { at: floor(pcx - 70 * cu - 17 * cu + 0.5), floor(qx_top + 164 * cu + 0.5); anchor: left center; size: 14; weight: 600; width: 72 * cu; lines: 1; color: ink; family: "Space Grotesk" }
                zone box cap_r0 { at: pcx - 70 * cu, qx_top + 164 * cu; size: 136 * cu, 54 * cu; corner: 15 * cu; cursor: pointer }
                on press cap_r0 { emit rec_start(0) }
                box { at: pcx + 70 * cu, qx_top + 164 * cu; size: 134 * cu, 52 * cu; corner: 14 * cu; color: ink; opacity: 8% + 9% * cap_r1.hover }
                box { at: pcx + 70 * cu, qx_top + 164 * cu; size: 134 * cu, 52 * cu; corner: 14 * cu; color: mint; opacity: 14% * cap_r1.hover }
                box { at: pcx + 70 * cu - 37 * cu, qx_top + 164 * cu - 1 * cu; size: 17 * cu, 11.5 * cu; corner: 2.5 * cu; stroke: 1.6 * cu; color: mix(ink, mint, cap_r1.hover); opacity: 100% }
                path { at: pcx + 70 * cu - 37 * cu, qx_top + 164 * cu; stroke: 1.6 * cu; color: mix(ink, mint, cap_r1.hover); opacity: 100%; move -3 * cu, 7.5 * cu; line 3 * cu, 7.5 * cu }
                ellipse { at: pcx + 70 * cu - 37 * cu + 10 * cu, qx_top + 164 * cu - 10 * cu; radius: 2.8 * cu; color: mint }
                text "Full screen" { at: floor(pcx + 70 * cu - 17 * cu + 0.5), floor(qx_top + 164 * cu + 0.5); anchor: left center; size: 14; weight: 600; width: 72 * cu; lines: 1; color: ink; family: "Space Grotesk" }
                zone box cap_r1 { at: pcx + 70 * cu, qx_top + 164 * cu; size: 136 * cu, 54 * cu; corner: 15 * cu; cursor: pointer }
                on press cap_r1 { emit rec_start(1) }
            }
            group {
                show: rec_on
                box { at: pcx, qx_top + 164 * cu; size: 276 * cu, 52 * cu; corner: 14 * cu; color: mint; opacity: 14% + 8% * cap_stop.hover }
                ellipse { at: pcx - 104 * cu, qx_top + 164 * cu; radius: (9 + 2 * sin(time * 300)) * cu; color: mint; opacity: 30% }
                box { at: pcx - 104 * cu, qx_top + 164 * cu; size: 11 * cu, 11 * cu; corner: 2.5 * cu; color: mint }
                text "Stop recording" { at: floor(pcx - 80 * cu + 0.5), floor(qx_top + 164 * cu + 0.5); anchor: left center; size: 14.5; weight: 700; width: 150 * cu; lines: 1; color: mint; family: "Space Grotesk" }
                text rec_time { at: floor(pcx + 128 * cu + 0.5), floor(qx_top + 164 * cu + 0.5); anchor: right center; size: 14; weight: 600; color: mint; family: "Space Grotesk" }
                zone box cap_stop { at: pcx, qx_top + 164 * cu; size: 278 * cu, 54 * cu; corner: 15 * cu; cursor: pointer }
                on press cap_stop { emit rec_stop }
            }
        }

        //  The Power window: the session as five icon tiles, each of which has to be held for one second (it fills from the bottom and
        //  counts down while it is held, and lets go if you do), and the power profile as a track with a glass thumb that slides, on a
        //  spring that overshoots, to the one in use.
        group {
            show: showing_sub == powview
            opacity: expand0
            let px_top = ck + tiles_top * cu
            let px_cy = px_top + 22 * cu
            path { at: pcx - 124 * cu, px_cy; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * px_back.hover; move 4 * cu, -6 * cu; line -4 * cu, 0; line 4 * cu, 6 * cu }
            zone box px_back { at: pcx - 124 * cu, px_cy; size: 30 * cu, 30 * cu; cursor: pointer }
            on press px_back { panel_sub = none }
            text "POWER" { at: floor(pcx - 102 * cu + 0.5), floor(px_cy + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: pcx, px_top + 44 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }
            text "SESSION" { at: floor(pcx - 138 * cu + 0.5), floor(px_top + 62 * cu + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
            box { at: pcx + -113.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu; color: ink; opacity: 8% + 9% * pw_t0.hover }
            box { at: pcx + -113.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu; color: mint; opacity: 12% * pw_t0.hover }
            group {
                clip inset 0 box { at: pcx + -113.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu }
                box { at: pcx + -113.0 * cu, px_top + 96 * cu + 29 * cu - 29 * cu * clamp(pw_hp0, 0, 1); size: 52 * cu, 58 * cu * clamp(pw_hp0, 0, 1); color: mint; opacity: 34% }
                box { at: pcx + -113.0 * cu, px_top + 96 * cu + 29 * cu - 58 * cu * clamp(pw_hp0, 0, 1); size: 52 * cu, 2 * cu; color: mint; opacity: 70% * clamp(pw_hp0 * 8, 0, 1) }
            }
            path { at: pcx + -113.0 * cu, px_top + 96 * cu - 8 * cu; stroke: 1.6 * cu; color: mix(ink, mint, max(pw_t0.hover, clamp(pw_hp0 * 3, 0, 1))); opacity: 100%; move -3.5 * cu, -1 * cu; line -3.5 * cu, -4 * cu; curve 3.5 * cu, -4 * cu via 0 * cu, -10.5 * cu; line 3.5 * cu, -1 * cu }
            box { at: pcx + -113.0 * cu, px_top + 96 * cu - 8 * cu + 3.5 * cu; size: 13 * cu, 9.5 * cu; corner: 2.5 * cu; stroke: 1.6 * cu; color: mix(ink, mint, max(pw_t0.hover, clamp(pw_hp0 * 3, 0, 1))); opacity: 100% }
            text "Lock" { at: floor(pcx + -113.0 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 600; width: 50 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk"; show: pw_hp0 < 0.03 }
            text number(1 - clamp(pw_hp0, 0, 1), 1, "s") { at: floor(pcx + -113.0 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 700; width: 50 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: pw_hp0 >= 0.03 }
            zone box pw_t0 { at: pcx + -113.0 * cu, px_top + 96 * cu; size: 54 * cu, 60 * cu; corner: 15 * cu; cursor: pointer }
            on press pw_t0 { pw_s0 = time; pw_d0 = true }
            on release pw_t0 { pw_d0 = false }
            on hold pw_t0 for 1000ms { pw_d0 = false; emit pow_press(0) }
            box { at: pcx + -56.5 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu; color: ink; opacity: 8% + 9% * pw_t1.hover }
            box { at: pcx + -56.5 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu; color: mint; opacity: 12% * pw_t1.hover }
            group {
                clip inset 0 box { at: pcx + -56.5 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu }
                box { at: pcx + -56.5 * cu, px_top + 96 * cu + 29 * cu - 29 * cu * clamp(pw_hp1, 0, 1); size: 52 * cu, 58 * cu * clamp(pw_hp1, 0, 1); color: mint; opacity: 34% }
                box { at: pcx + -56.5 * cu, px_top + 96 * cu + 29 * cu - 58 * cu * clamp(pw_hp1, 0, 1); size: 52 * cu, 2 * cu; color: mint; opacity: 70% * clamp(pw_hp1 * 8, 0, 1) }
            }
            path { at: pcx + -56.5 * cu, px_top + 96 * cu - 8 * cu; stroke: 1.6 * cu; color: mix(ink, mint, max(pw_t1.hover, clamp(pw_hp1 * 3, 0, 1))); opacity: 100%; move 8.29 * cu, 3.17 * cu; line 7.76 * cu, 4.27 * cu; line 7.08 * cu, 5.28 * cu; line 6.26 * cu, 6.18 * cu; line 5.33 * cu, 6.97 * cu; line 4.29 * cu, 7.61 * cu; line 3.18 * cu, 8.10 * cu; line 2.00 * cu, 8.42 * cu; line 0.79 * cu, 8.58 * cu; line -0.42 * cu, 8.56 * cu; line -1.63 * cu, 8.38 * cu; line -2.79 * cu, 8.02 * cu; line -3.90 * cu, 7.50 * cu; line -4.92 * cu, 6.84 * cu; line -5.83 * cu, 6.03 * cu; line -6.62 * cu, 5.11 * cu; line -7.28 * cu, 4.08 * cu; line -7.78 * cu, 2.97 * cu; line -8.12 * cu, 1.80 * cu; line -8.29 * cu, 0.59 * cu; line -8.28 * cu, -0.63 * cu; line -8.11 * cu, -1.83 * cu; line -7.77 * cu, -3.00 * cu; line -7.26 * cu, -4.11 * cu; line -6.61 * cu, -5.14 * cu; line -5.81 * cu, -6.06 * cu; line -4.90 * cu, -6.86 * cu; line -3.87 * cu, -7.53 * cu; line -2.77 * cu, -8.04 * cu; line -1.60 * cu, -8.39 * cu; line -0.40 * cu, -8.58 * cu; line -0.97 * cu, -7.92 * cu; line -1.46 * cu, -7.20 * cu; line -1.86 * cu, -6.43 * cu; line -2.17 * cu, -5.62 * cu; line -2.38 * cu, -4.78 * cu; line -2.49 * cu, -3.91 * cu; line -2.50 * cu, -3.05 * cu; line -2.40 * cu, -2.18 * cu; line -2.21 * cu, -1.33 * cu; line -1.92 * cu, -0.52 * cu; line -1.53 * cu, 0.26 * cu; line -1.06 * cu, 0.99 * cu; line -0.50 * cu, 1.66 * cu; line 0.13 * cu, 2.26 * cu; line 0.83 * cu, 2.78 * cu; line 1.58 * cu, 3.21 * cu; line 2.38 * cu, 3.55 * cu; line 3.21 * cu, 3.80 * cu; line 4.07 * cu, 3.95 * cu; line 4.94 * cu, 3.99 * cu; line 5.81 * cu, 3.94 * cu; line 6.66 * cu, 3.78 * cu; line 7.49 * cu, 3.52 * cu; line 8.29 * cu, 3.17 * cu; line 8.29 * cu, 3.17 * cu }
            text "Sleep" { at: floor(pcx + -56.5 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 600; width: 50 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk"; show: pw_hp1 < 0.03 }
            text number(1 - clamp(pw_hp1, 0, 1), 1, "s") { at: floor(pcx + -56.5 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 700; width: 50 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: pw_hp1 >= 0.03 }
            zone box pw_t1 { at: pcx + -56.5 * cu, px_top + 96 * cu; size: 54 * cu, 60 * cu; corner: 15 * cu; cursor: pointer }
            on press pw_t1 { pw_s1 = time; pw_d1 = true }
            on release pw_t1 { pw_d1 = false }
            on hold pw_t1 for 1000ms { pw_d1 = false; emit pow_press(1) }
            box { at: pcx + 0.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu; color: ink; opacity: 8% + 9% * pw_t2.hover }
            box { at: pcx + 0.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu; color: mint; opacity: 12% * pw_t2.hover }
            group {
                clip inset 0 box { at: pcx + 0.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu }
                box { at: pcx + 0.0 * cu, px_top + 96 * cu + 29 * cu - 29 * cu * clamp(pw_hp2, 0, 1); size: 52 * cu, 58 * cu * clamp(pw_hp2, 0, 1); color: mint; opacity: 34% }
                box { at: pcx + 0.0 * cu, px_top + 96 * cu + 29 * cu - 58 * cu * clamp(pw_hp2, 0, 1); size: 52 * cu, 2 * cu; color: mint; opacity: 70% * clamp(pw_hp2 * 8, 0, 1) }
            }
            path { at: pcx + 0.0 * cu, px_top + 96 * cu - 8 * cu; stroke: 1.6 * cu; color: mix(ink, mint, max(pw_t2.hover, clamp(pw_hp2 * 3, 0, 1))); opacity: 100%; move 1 * cu, -7.5 * cu; line -5.5 * cu, -7.5 * cu; line -5.5 * cu, 7.5 * cu; line 1 * cu, 7.5 * cu }
            path { at: pcx + 0.0 * cu, px_top + 96 * cu - 8 * cu; stroke: 1.6 * cu; color: mix(ink, mint, max(pw_t2.hover, clamp(pw_hp2 * 3, 0, 1))); opacity: 100%; move -2 * cu, 0 * cu; line 7 * cu, 0 * cu }
            path { at: pcx + 0.0 * cu, px_top + 96 * cu - 8 * cu; stroke: 1.6 * cu; color: mix(ink, mint, max(pw_t2.hover, clamp(pw_hp2 * 3, 0, 1))); opacity: 100%; move 4 * cu, -3.2 * cu; line 7.2 * cu, 0 * cu; line 4 * cu, 3.2 * cu }
            text "Log out" { at: floor(pcx + 0.0 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 600; width: 50 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk"; show: pw_hp2 < 0.03 }
            text number(1 - clamp(pw_hp2, 0, 1), 1, "s") { at: floor(pcx + 0.0 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 700; width: 50 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: pw_hp2 >= 0.03 }
            zone box pw_t2 { at: pcx + 0.0 * cu, px_top + 96 * cu; size: 54 * cu, 60 * cu; corner: 15 * cu; cursor: pointer }
            on press pw_t2 { pw_s2 = time; pw_d2 = true }
            on release pw_t2 { pw_d2 = false }
            on hold pw_t2 for 1000ms { pw_d2 = false; emit pow_press(2) }
            box { at: pcx + 56.5 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu; color: ink; opacity: 8% + 9% * pw_t3.hover }
            box { at: pcx + 56.5 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu; color: mint; opacity: 12% * pw_t3.hover }
            group {
                clip inset 0 box { at: pcx + 56.5 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu }
                box { at: pcx + 56.5 * cu, px_top + 96 * cu + 29 * cu - 29 * cu * clamp(pw_hp3, 0, 1); size: 52 * cu, 58 * cu * clamp(pw_hp3, 0, 1); color: mint; opacity: 34% }
                box { at: pcx + 56.5 * cu, px_top + 96 * cu + 29 * cu - 58 * cu * clamp(pw_hp3, 0, 1); size: 52 * cu, 2 * cu; color: mint; opacity: 70% * clamp(pw_hp3 * 8, 0, 1) }
            }
            path { at: pcx + 56.5 * cu, px_top + 96 * cu - 8 * cu; stroke: 1.6 * cu; color: mix(ink, mint, max(pw_t3.hover, clamp(pw_hp3 * 3, 0, 1))); opacity: 100%; move 5.3 * cu, -5.3 * cu; line 6.8 * cu, -3.17 * cu; line 7.47 * cu, -0.65 * cu; line 7.24 * cu, 1.94 * cu; line 6.14 * cu, 4.3 * cu; line 4.3 * cu, 6.14 * cu; line 1.94 * cu, 7.24 * cu; line -0.65 * cu, 7.47 * cu; line -3.17 * cu, 6.8 * cu; line -5.3 * cu, 5.3 * cu; line -6.8 * cu, 3.17 * cu; line -7.47 * cu, 0.65 * cu; line -7.24 * cu, -1.94 * cu; line -6.14 * cu, -4.3 * cu; line -4.3 * cu, -6.14 * cu }
            path { at: pcx + 56.5 * cu, px_top + 96 * cu - 8 * cu; stroke: 1.6 * cu; color: mix(ink, mint, max(pw_t3.hover, clamp(pw_hp3 * 3, 0, 1))); opacity: 100%; move -6.75 * cu, -8.04 * cu; line -2.17 * cu, -7.63 * cu; line -3.36 * cu, -3.19 * cu }
            text "Restart" { at: floor(pcx + 56.5 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 600; width: 50 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk"; show: pw_hp3 < 0.03 }
            text number(1 - clamp(pw_hp3, 0, 1), 1, "s") { at: floor(pcx + 56.5 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 700; width: 50 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: pw_hp3 >= 0.03 }
            zone box pw_t3 { at: pcx + 56.5 * cu, px_top + 96 * cu; size: 54 * cu, 60 * cu; corner: 15 * cu; cursor: pointer }
            on press pw_t3 { pw_s3 = time; pw_d3 = true }
            on release pw_t3 { pw_d3 = false }
            on hold pw_t3 for 1000ms { pw_d3 = false; emit pow_press(3) }
            box { at: pcx + 113.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu; color: ink; opacity: 8% + 9% * pw_t4.hover }
            box { at: pcx + 113.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu; color: mint; opacity: 12% * pw_t4.hover }
            group {
                clip inset 0 box { at: pcx + 113.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: 14 * cu }
                box { at: pcx + 113.0 * cu, px_top + 96 * cu + 29 * cu - 29 * cu * clamp(pw_hp4, 0, 1); size: 52 * cu, 58 * cu * clamp(pw_hp4, 0, 1); color: mint; opacity: 34% }
                box { at: pcx + 113.0 * cu, px_top + 96 * cu + 29 * cu - 58 * cu * clamp(pw_hp4, 0, 1); size: 52 * cu, 2 * cu; color: mint; opacity: 70% * clamp(pw_hp4 * 8, 0, 1) }
            }
            path { at: pcx + 113.0 * cu, px_top + 96 * cu - 8 * cu; stroke: 1.6 * cu; color: mix(ink, mint, max(pw_t4.hover, clamp(pw_hp4 * 3, 0, 1))); opacity: 100%; move 4.43 * cu, -5.67 * cu; line 6.11 * cu, -3.82 * cu; line 7.04 * cu, -1.5 * cu; line 7.13 * cu, 1 * cu; line 6.36 * cu, 3.38 * cu; line 4.82 * cu, 5.35 * cu; line 2.7 * cu, 6.68 * cu; line 0.25 * cu, 7.2 * cu; line -2.22 * cu, 6.85 * cu; line -4.43 * cu, 5.67 * cu; line -6.11 * cu, 3.82 * cu; line -7.04 * cu, 1.5 * cu; line -7.13 * cu, -1 * cu; line -6.36 * cu, -3.38 * cu; line -4.82 * cu, -5.35 * cu; line -4.43 * cu, -5.67 * cu }
            box { at: pcx + 113.0 * cu, px_top + 96 * cu - 8 * cu - 5.5 * cu; size: 1.6 * cu, 9 * cu; corner: 0.8 * cu; color: mix(ink, mint, max(pw_t4.hover, clamp(pw_hp4 * 3, 0, 1))); opacity: 100% }
            text "Power off" { at: floor(pcx + 113.0 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 600; width: 50 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk"; show: pw_hp4 < 0.03 }
            text number(1 - clamp(pw_hp4, 0, 1), 1, "s") { at: floor(pcx + 113.0 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 700; width: 50 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: pw_hp4 >= 0.03 }
            zone box pw_t4 { at: pcx + 113.0 * cu, px_top + 96 * cu; size: 54 * cu, 60 * cu; corner: 15 * cu; cursor: pointer }
            on press pw_t4 { pw_s4 = time; pw_d4 = true }
            on release pw_t4 { pw_d4 = false }
            on hold pw_t4 for 1000ms { pw_d4 = false; emit pow_press(4) }
            text "POWER PROFILE" { at: floor(pcx - 138 * cu + 0.5), floor(px_top + 142 * cu + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
            group { opacity: mix(0.45, 1, clamp(pow_prof + 1, 0, 1))
                box { at: pcx, px_top + 176 * cu; size: 276 * cu, 46 * cu; corner: 16 * cu; color: ink; opacity: 8% }
                body {
                    color: mint
                    opacity: 24%
                    rim: 40%
                    shadow: 0, 2 * cu, 8 * cu, 25%, #000000
                    box { at: pcx + (pow_th - 1) * 92 * cu, px_top + 176 * cu; size: (90 + 8 * abs(pow_th - if(pow_prof < 0, 1, pow_prof))) * cu, 40 * cu; corner: 14 * cu }
                }
                path { at: pcx + -92 * cu, px_top + 176 * cu - 8 * cu; stroke: 1.6 * cu; color: mix(ink, mint, clamp(1 - abs(pow_th - 0), 0, 1)); opacity: 55% + 45% * max(clamp(1 - abs(pow_th - 0), 0, 1), pw_p0.hover); move -6.5 * cu, 6.5 * cu; curve 6.5 * cu, -6.5 * cu via -8 * cu, -6 * cu; curve -6.5 * cu, 6.5 * cu via 8 * cu, 6 * cu }
                path { at: pcx + -92 * cu, px_top + 176 * cu - 8 * cu; stroke: 1.3 * cu; color: mix(ink, mint, clamp(1 - abs(pow_th - 0), 0, 1)); opacity: 55% + 45% * max(clamp(1 - abs(pow_th - 0), 0, 1), pw_p0.hover); move -6.5 * cu, 6.5 * cu; line 1 * cu, -1 * cu }
                text "Saver" { at: floor(pcx + -92 * cu + 0.5), floor(px_top + 176 * cu + 12 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 88 * cu; lines: 1; color: mix(ink, mint, clamp(1 - abs(pow_th - 0), 0, 1)); opacity: 60% + 40% * max(clamp(1 - abs(pow_th - 0), 0, 1), pw_p0.hover); family: "Space Grotesk" }
                zone box pw_p0 { at: pcx + -92 * cu, px_top + 176 * cu; size: 90 * cu, 44 * cu; corner: 15 * cu; cursor: pointer; active: pow_prof >= 0 }
                on press pw_p0 { emit pow_prof_set(0) }
                box { at: pcx + 0 * cu, px_top + 176 * cu - 8 * cu - 3 * cu; size: 13 * cu, 1.7 * cu; corner: 0.85 * cu; color: mix(ink, mint, clamp(1 - abs(pow_th - 1), 0, 1)); opacity: 55% + 45% * max(clamp(1 - abs(pow_th - 1), 0, 1), pw_p1.hover) }
                box { at: pcx + 0 * cu, px_top + 176 * cu - 8 * cu + 3 * cu; size: 13 * cu, 1.7 * cu; corner: 0.85 * cu; color: mix(ink, mint, clamp(1 - abs(pow_th - 1), 0, 1)); opacity: 55% + 45% * max(clamp(1 - abs(pow_th - 1), 0, 1), pw_p1.hover) }
                text "Balanced" { at: floor(pcx + 0 * cu + 0.5), floor(px_top + 176 * cu + 12 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 88 * cu; lines: 1; color: mix(ink, mint, clamp(1 - abs(pow_th - 1), 0, 1)); opacity: 60% + 40% * max(clamp(1 - abs(pow_th - 1), 0, 1), pw_p1.hover); family: "Space Grotesk" }
                zone box pw_p1 { at: pcx + 0 * cu, px_top + 176 * cu; size: 90 * cu, 44 * cu; corner: 15 * cu; cursor: pointer; active: pow_prof >= 0 }
                on press pw_p1 { emit pow_prof_set(1) }
                path { at: pcx + 92 * cu, px_top + 176 * cu - 8 * cu; stroke: 1.5 * cu; color: mix(ink, mint, clamp(1 - abs(pow_th - 2), 0, 1)); opacity: 55% + 45% * max(clamp(1 - abs(pow_th - 2), 0, 1), pw_p2.hover); move 1.5 * cu, -8.5 * cu; line -5 * cu, 1.5 * cu; line -0.6 * cu, 1.5 * cu; line -1.6 * cu, 8.5 * cu; line 5 * cu, -1.5 * cu; line 0.6 * cu, -1.5 * cu; line 1.5 * cu, -8.5 * cu }
                text "Performance" { at: floor(pcx + 92 * cu + 0.5), floor(px_top + 176 * cu + 12 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 88 * cu; lines: 1; color: mix(ink, mint, clamp(1 - abs(pow_th - 2), 0, 1)); opacity: 60% + 40% * max(clamp(1 - abs(pow_th - 2), 0, 1), pw_p2.hover); family: "Space Grotesk" }
                zone box pw_p2 { at: pcx + 92 * cu, px_top + 176 * cu; size: 90 * cu, 44 * cu; corner: 15 * cu; cursor: pointer; active: pow_prof >= 0 }
                on press pw_p2 { emit pow_prof_set(2) }
            }
        }

        //  The dropdown: a solid card that drops from the volume row over what is
        //  below it. Declared last so its rows win the press over the slider.
        group {
            opacity: dd
            move: 0, (1 - dd) * -8 * cu
            let ddn = clamp(outlist.count, 1, 6)
            let ddh = ddn * 30 * cu + 12 * cu
            box { at: pcx, ck + (vol_top + 32) * cu + ddh / 2; size: 288 * cu, ddh; corner: 14 * cu; color: panel }
            zone box dd_block { at: pcx, ck + (vol_top + 32) * cu + ddh / 2; size: 288 * cu, ddh; active: dd > 0.05 }
            column dd_list {
                at: floor(pcx - 138 * cu + 0.5), floor(ck + (vol_top + 32) * cu + 6 * cu + 0.5)
                gap: 3
                for o in outlist { OutRow(o, pick: pick_out) }
            }
            text "No outputs" { at: floor(pcx + 0.5), floor(ck + (vol_top + 32) * cu + ddh / 2 + 0.5); anchor: center; size: 14; color: faint; family: "Space Grotesk"; show: outlist.count < 1 }
        }
        }
    }
    //  The player's panel: it hangs from the window title, not from the middle of the bar, in
    //  the same glass as the bar. Its content is clipped to the drawer's shape.
    group {
        clip inset 2 box { at: mix(pcx, dm.gx, lm), mix(bar.y + dm.hh / 2, lp.cy, lm); size: mix(dm.w, dm.gw, lm), mix(dm.hh, dm.gh, lm); corner: 26 * cu }
        //  The player. A sliver with nothing playing — a note and a word, the same
        //  shape as the Wi-Fi and Bluetooth rows below it — that grows into the full
        //  card (cover, song, transport, equalizer) the moment something does.
        //  `media_open` is what moves; `media_h`, above, already reads it, so every
        //  plate under this one is already where it should be.
        group {
            show: dm_mode == dmm_player
            opacity: f3
            move: 0, (1 - f3) * 12 * cu
            let my = ck + (media_top + media_h / 2) * cu
            let ax = mdx - 96 * cu                     // the cover's centre
            let ny = my + 26 * cu                     // the controls' row
            let px = mdx - 30 * cu                     // previous
            let cxp = mdx + 6 * cu                     // play
            let nx = mdx + 42 * cu                     // next
            let sw = clamp(swap, 0, 1.12)

            //  The plate is exactly the volume plate: the same 8% veil and the same corners.
            box { at: mdx, my; size: 288 * cu, media_h * cu; corner: 14 * cu; color: ink; opacity: veil }

            //  Idle: a note, the way Wi-Fi and Bluetooth say their own name at rest.
            group {
                opacity: 1 - media_open
                //  A note with a flag: solid parts, faded together so the overlaps do not show.
                group {
                    opacity: 70%
                    ellipse { at: mdx - 124 * cu + 1.5, my + 5 * cu; radius: 4.5 * cu; color: ink }
                    box { at: mdx - 118.5 * cu - 1.5, my - 1 * cu; size: 2 * cu, 18 * cu; corner: 1 * cu; color: ink }
                    path { at: mdx - 118.5 * cu - 1.5, my - 10 * cu; stroke: 2 * cu; color: ink; move 0, 0.5 * cu; curve 6 * cu, 8 * cu via 6.5 * cu, 2.5 * cu }
                }
                text "Media" { at: floor(mdx - 96 * cu + 0.5), floor(my - 8 * cu + 0.5); anchor: left center; size: 16; color: ink; family: "Space Grotesk" }
                text "Nothing playing" { at: floor(mdx - 96 * cu + 0.5), floor(my + 8 * cu + 0.5); anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            }

            //  Playing, or paused with something loaded: the full card.
            group {
                opacity: media_open

                //  No cover yet: a tile with a note on it.
                group {
                    show: not art_on
                    body {
                        gradient: ax - 36 * cu, my - 36 * cu to ax + 36 * cu, my + 36 * cu, off, deep
                        rim: 14%
                        box { at: ax, my; size: 72 * cu, 72 * cu; corner: 15 * cu }
                    }
                    ellipse { at: ax - 6 * cu, my + 11 * cu; radius: 6.5 * cu; color: ink; opacity: 75% }
                    box { at: ax + 1.5 * cu, my - 4 * cu; size: 3 * cu, 30 * cu; corner: 1.5 * cu; color: ink; opacity: 75% }
                    path { at: ax, my; stroke: 3 * cu; color: ink; opacity: 75%; move 3 * cu, -19 * cu; curve 15 * cu, -6 * cu via 13 * cu, -17 * cu }
                }

                //  The cover, in a rounded tile.
                group {
                    glow: 12 * cu, 60%
                    saturation: 0.3 + 0.7 * playf
                    pivot: ax, my
                    scale: (0.88 + 0.12 * playf) * (0.7 + 0.3 * sw)
                    rotate: (1 - sw) * -12deg
                    opacity: art_on
                    group {
                        clip inset 0 box { at: ax, my; size: 72 * cu, 72 * cu; corner: 15 * cu }
                        image art { at: ax - 36 * cu, my - 36 * cu; size: 72 * cu, 72 * cu }
                    }
                }

                text media.title { at: floor(mdx - 50 * cu + 0.5), floor(my - 24 * cu + 0.5); anchor: left center; size: 16.5; weight: 700; width: 186 * cu; lines: 1; color: ink; family: "Space Grotesk" }
                text media.artist { at: floor(mdx - 50 * cu + 0.5), floor(my - 6 * cu + 0.5); anchor: left center; size: 14; width: 186 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk" }

                //  previous
                box { at: px - 6 * cu, ny; size: 2.2 * cu, 12 * cu; corner: 1.1 * cu; color: ink; opacity: 75% + 25% * mp.prev.hover }
                path { at: px, ny; color: ink; opacity: 75% + 25% * mp.prev.hover; move 5 * cu, -6 * cu; line -4.5 * cu, 0; line 5 * cu, 6 * cu; close }
                //  play / pause: a white disc with the mark cut out of it
                ellipse { at: cxp, ny; radius: (15 + 1.5 * mp.play.hover) * cu; color: ink; opacity: 95% }
                path { at: cxp, ny; color: onmint; show: not media.playing; move -4 * cu, -8 * cu; line 8 * cu, 0; line -4 * cu, 8 * cu; close }
                box { at: cxp - 4 * cu, ny; size: 4 * cu, 14 * cu; corner: 1.5 * cu; color: onmint; show: media.playing }
                box { at: cxp + 4 * cu, ny; size: 4 * cu, 14 * cu; corner: 1.5 * cu; color: onmint; show: media.playing }
                //  next
                path { at: nx, ny; color: ink; opacity: 75% + 25% * mp.next.hover; move -5 * cu, -6 * cu; line 4.5 * cu, 0; line -5 * cu, 6 * cu; close }
                box { at: nx + 6 * cu, ny; size: 2.2 * cu, 12 * cu; corner: 1.1 * cu; color: ink; opacity: 75% + 25% * mp.next.hover }

                zone box mp.prev { at: px, ny; size: 30 * cu, 34 * cu; cursor: pointer }
                zone box mp.play { at: cxp, ny; size: 38 * cu, 38 * cu; cursor: pointer }
                zone box mp.next { at: nx, ny; size: 30 * cu, 34 * cu; cursor: pointer }
                on press mp.prev { emit mcmd(0) }
                on press mp.play { emit mcmd(1) }
                on press mp.next { emit mcmd(2) }

                //  The equalizer: six rounded bars to the right of the controls, standing on the
                //  same line as the bottom of the cover. They only show while it plays.
                repeat i in 0..6 {
                    let bx = mdx + 74 * cu + i * 12 * cu
                    let bh = (3.5 + 31 * spec.s.$i) * cu
                    box { at: bx, my + 36 * cu - bh / 2; size: 7 * cu, bh; corner: 3.5 * cu; color: mix(mint, ink, spec.s.$i)
                          opacity: playf * (55% + 45% * spec.s.$i) }
                }
            }

            //  A new song throws sparks off the cover.
            particles { at: ax, my; count: 36; life: 0.5s .. 1.0s; speed: 70 .. 170; direction: 0deg; spread: 360deg; gravity: 0, 40; drag: 1.2; size: 3.5, 1; colors: mint, ink; shape: spark; burst: trackchange }
        }

        //  ── the running windows ──
        group {
            show: dm_mode == dmm_player
            opacity: f3
            move: 0, (1 - f3) * 12 * cu
            text "No active windows" { at: floor(mdx + 0.5), floor(ck + tasks_list * cu + 16 * cu + 0.5); anchor: center; size: 14; color: faint; family: "Space Grotesk"; show: tasks.count < 1 }
            column task_col {
                at: floor(mdx - 144 * cu + 0.5), floor(ck + tasks_list * cu + 0.5)
                view: 288 * cu, (task_rows * 40 - 4) * cu
                gap: floor(4 * cu + 0.5)
                for w in tasks { TaskRow(w, focus: task_focus, kill: task_close) }
            }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: mdx + 147 * cu, ck + tasks_list * cu + task_col.scroll / max(task_col.content, 1) * ((task_rows * 40 - 4) * cu); size: 3 * cu, ((task_rows * 40 - 4) * cu) * ((task_rows * 40 - 4) * cu) / max(task_col.content, (task_rows * 40 - 4) * cu); corner: 1.5 * cu; color: ink; opacity: if(task_col.content > ((task_rows * 40 - 4) * cu) + 1, 35%, 0%) }
            //  The apps that only live in the tray: no window to list, so they get their own section.
            group {
                show: trays.count > 0
                text "BACKGROUND APPS" { at: floor(mdx - 138 * cu + 0.5), floor(ck + tray_top * cu + 11 * cu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" }
                column tray_col {
                    at: floor(mdx - 144 * cu + 0.5), floor(ck + tray_list * cu + 0.5)
                    view: 288 * cu, (max(1, tray_rows) * 40 - 4) * cu
                    gap: floor(4 * cu + 0.5)
                    for a in trays { TrayRow(a, click: tray_click, pin: tray_pin, menu: tray_menu_open) }
                }
                //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
                box { from: mdx + 147 * cu, ck + tray_list * cu + tray_col.scroll / max(tray_col.content, 1) * ((max(1, tray_rows) * 40 - 4) * cu); size: 3 * cu, ((max(1, tray_rows) * 40 - 4) * cu) * ((max(1, tray_rows) * 40 - 4) * cu) / max(tray_col.content, (max(1, tray_rows) * 40 - 4) * cu); corner: 1.5 * cu; color: ink; opacity: if(tray_col.content > ((max(1, tray_rows) * 40 - 4) * cu) + 1, 35%, 0%) }
                //  What the bar shows of them: every app, or only the pinned ones.
                box { at: mdx + 96 * cu, ck + tray_top * cu + 11 * cu; size: 86 * cu, 20 * cu; corner: 10 * cu; color: if(tray_only_pinned, mint, ink); opacity: if(tray_only_pinned, 22%, 8% + 10% * tray_mode_hit.hover) }
                text "Bar: pinned" { at: floor(mdx + 96 * cu + 0.5), floor(ck + tray_top * cu + 11 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 82 * cu; lines: 1; color: mint; show: tray_only_pinned; family: "Space Grotesk" }
                text "Bar: all" { at: floor(mdx + 96 * cu + 0.5), floor(ck + tray_top * cu + 11 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 82 * cu; lines: 1; color: ink; opacity: 85%; show: not tray_only_pinned; family: "Space Grotesk" }
                zone box tray_mode_hit { at: mdx + 96 * cu, ck + tray_top * cu + 11 * cu; size: 88 * cu, 22 * cu; corner: 11 * cu; cursor: pointer }
                on press tray_mode_hit { emit tray_mode }
            }
        }

        //  ── a tray app's menu ──
        group {
            show: dm_mode == dmm_tray
            opacity: f3
            move: 0, (1 - f3) * 12 * cu
            let ty = ck + 34 * cu                           // the app plate's middle
            box { at: mdx, ty; size: 288 * cu, 52 * cu; corner: 14 * cu; color: ink; opacity: veil }
            image tm_icon { at: floor(mdx - 132 * cu + 0.5), floor(ty - 15 * cu + 0.5); size: floor(30 * cu + 0.5), floor(30 * cu + 0.5) }
            text tm_title { at: floor(mdx - 94 * cu + 0.5), floor(ty - 8 * cu + 0.5); anchor: left center; size: 15.5; weight: 700; width: 170 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            text tm_sub { at: floor(mdx - 94 * cu + 0.5), floor(ty + 9 * cu + 0.5); anchor: left center; size: 12; width: 170 * cu; lines: 1; color: faint; family: "Space Grotesk" }
            //  The pin: a thumbtack, filled while the app is kept on the bar.
            ellipse { at: mdx + 122 * cu, ty; radius: 14 * cu; color: ink; opacity: 6% + 10% * tm_pin_hit.hover }
            ellipse { at: mdx + 122 * cu, ty - 3 * cu; radius: 4 * cu; color: mix(ink, mint, if(tm_pinned, 1, 0)); opacity: if(tm_pinned, 100%, 0%) }
            ellipse { at: mdx + 122 * cu, ty - 3 * cu; radius: 4 * cu; stroke: 1.4 * cu; color: mix(ink, mint, if(tm_pinned, 1, 0)); opacity: if(tm_pinned, 0%, 70%) }
            line { from: mdx + 122 * cu, ty + 1 * cu; to: mdx + 122 * cu, ty + 7 * cu; width: 1.5 * cu; color: mix(ink, mint, if(tm_pinned, 1, 0)); opacity: if(tm_pinned, 100%, 70%) }
            zone box tm_pin_hit { at: mdx + 122 * cu, ty; size: 28 * cu, 28 * cu; corner: 14 * cu; cursor: pointer }
            on press tm_pin_hit { emit tm_pin }
            //  Open and Alt: what a left and a middle click on its icon would do.
            box { at: mdx - 71 * cu, ck + 79 * cu; size: 138 * cu, 26 * cu; corner: 9 * cu; color: ink; opacity: 8% + 10% * tm_open_hit.hover }
            text "Open" { at: floor(mdx - 71 * cu + 0.5), floor(ck + 79 * cu + 0.5); anchor: center; align: center; size: 12.5; weight: 600; width: 130 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box tm_open_hit { at: mdx - 71 * cu, ck + 79 * cu; size: 140 * cu, 28 * cu; corner: 9 * cu; cursor: pointer }
            on press tm_open_hit { emit tm_open }
            box { at: mdx + 71 * cu, ck + 79 * cu; size: 138 * cu, 26 * cu; corner: 9 * cu; color: ink; opacity: 8% + 10% * tm_alt_hit.hover }
            text "Alt" { at: floor(mdx + 71 * cu + 0.5), floor(ck + 79 * cu + 0.5); anchor: center; align: center; size: 12.5; weight: 600; width: 130 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box tm_alt_hit { at: mdx + 71 * cu, ck + 79 * cu; size: 140 * cu, 28 * cu; corner: 9 * cu; cursor: pointer }
            on press tm_alt_hit { emit tm_alt }
            //  Its menu.
            text "This app provides no menu." { at: floor(mdx + 0.5), floor(ck + 115 * cu + 0.5); anchor: center; size: 14; color: faint; family: "Space Grotesk"; show: not tm_has_menu }
            column tm_col {
                at: floor(mdx - 144 * cu + 0.5), floor(ck + 100 * cu + 0.5)
                view: 288 * cu, tm.list * cu
                gap: floor(2 * cu + 0.5)
                for r in tray_menu { TmRow(r, pick: tray_menu_pick) }
            }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: mdx + 147 * cu, ck + 100 * cu + tm_col.scroll / max(tm_col.content, 1) * (tm.list * cu); size: 3 * cu, (tm.list * cu) * (tm.list * cu) / max(tm_col.content, tm.list * cu); corner: 1.5 * cu; color: ink; opacity: if(tm_col.content > (tm.list * cu) + 1, 35%, 0%) }
        }

    }
    //  The volume and notification drawer's content, clipped to its shape. Both sit on one plate
    //  (the same 8% veil as the others), 12 in from the drawer's edge; `osd_kind` picks which is drawn.
    group {
        clip inset 2 box { at: mix(pcx, do.gx, lm), mix(bar.y + os.hh / 2, lp.cy, lm); size: mix(os.w, do.gw, lm), mix(os.hh, do.gh, lm); corner: 26 * u }
        opacity: fo
        move: 0, (1 - fo) * 12 * u
        //  The same as the calendar's: what is inside grows with the drawer, from the edge it comes out of (the strip's, or the right frame's for the volume and the notifications, which grow leftwards).
        group {
            pivot: mix(lp.xl, screen.width + 26 * u, rgt), lp.cy
            scale: mix(1, max(do.lf, 0.05), lm * att)
        let oy = ck + (8 + osd_h / 2) * u                 // the plate's middle
        let ot = ck + 8 * u                               // and its top
        box { at: pcx, oy; size: 316 * u, osd_h * u; corner: 14 * u; color: ink; opacity: veil }
        //  A press on the plate takes the drawer down (a notification is dismissed with it). Declared
        //  first, so the cross and the buttons above it win where they overlap.
        zone box os_hit { at: pcx, oy; size: 316 * u, osd_h * u; corner: 14 * u; cursor: pointer }
        on press os_hit while osd_kind == vol { panel = none }
        on press os_hit while osd_kind == note { emit nt_close }

        // ── the volume ──
        group {
            opacity: okv
            show: okv > 0.01
            let vy = oy
            let vtx = pcx - 128 * u                        // the face's tile
            box { at: vtx, vy; size: 44 * u, 44 * u; corner: 12 * u; color: ink; opacity: 6% }
            //  A little face on the slider: two eyes, and a mouth that opens
            //  with the level and flattens when muted. It bobs a little.
            group {
                move: 0, -1.5 * u * (0.5 + 0.5 * sin(time * 200))
                box { at: vtx - 6 * u, vy - 5 * u; size: 5 * u, if(audio.muted, 2, 5) * u; corner: 2 * u; color: if(audio.muted, faint, mint) }
                box { at: vtx + 6 * u, vy - 5 * u; size: 5 * u, if(audio.muted, 2, 5) * u; corner: 2 * u; color: if(audio.muted, faint, mint) }
                box { at: vtx, vy + 6 * u; size: if(audio.muted, 11, 7 + volume_level * 12) * u, if(audio.muted, 2, 5 + volume_level * 5) * u; corner: 2.5 * u; color: if(audio.muted, faint, mint) }
            }
            //  The level is a wave: it ripples as far as the volume goes, and the rest of the track is
            //  a flat, faint line. A tall white pill marks the end.
            let tr0 = pcx - 96 * u
            let trw = 170 * u
            let span = trw * volume_level
            //  All 48 pieces of the wave are spread over the level's own length, so a short one is drawn as
            //  smoothly as a long one (spread over the whole track, only a handful would fall inside it).
            let seg = max(span, 1) / 48
            //  The wave is always the same number of S-curves (two and a half), spread over however
            //  long the level is: at 100% they are long and lazy, and as the volume drops the whole
            //  thing is squeezed toward the left, the curves getting tighter and steeper. `wf` is
            //  the ripple's frequency, in degrees a pixel (sin takes degrees), for the length it has to fit. It fades to flat over a tenth of
            //  its length at each end, so it always meets the flat line and the pill.
            let wf = 360 * 2.5 / max(span, 1)
            let wa = 4.5 * u
            let f0 = max(0.001, span * 0.1)
            let f1 = max(0.001, span * 0.12)
            repeat i in 0..48 {
                let xa = tr0 + i * seg
                let xb = xa + seg
                //  The ripple dies away to nothing at both ends, so wherever it is in its swing the wave
                //  always meets the flat line and the knob on the same centre line.
                let ea = clamp((xa - tr0) / f0, 0, 1) * clamp((tr0 + span - xa) / f1, 0, 1)
                let eb = clamp((xb - tr0) / f0, 0, 1) * clamp((tr0 + span - xb) / f1, 0, 1)
                line { from: xa, vy + wa * ea * sin((xa - tr0) * wf - time * 120); to: xb, vy + wa * eb * sin((xb - tr0) * wf - time * 120); width: 5 * u; color: if(audio.muted, faint, mint); opacity: min(1, span / (3 * u)) }
            }
            line { from: tr0 + span, vy; to: tr0 + trw, vy; width: 5 * u; color: ink; opacity: 12% }
            box { at: clamp(tr0 + span, tr0 + 4 * u, tr0 + trw - 4 * u), vy; size: 6 * u, 26 * u; corner: 3 * u; color: ink }
            text number(audio.volume * 100, 0, "%") { at: floor(pcx + 116 * u + 0.5), floor(vy + 0.5); anchor: center; align: center; size: 21 * u; weight: 700; color: ink; family: "Space Grotesk"; show: not audio.muted }
            text "Muted" { at: floor(pcx + 116 * u + 0.5), floor(vy + 0.5); anchor: center; align: center; size: 21 * u; weight: 700; color: faint; family: "Space Grotesk"; show: audio.muted }
        }

        // ── a notification ──
        group {
            opacity: okn
            show: okn > 0.01
            let nty = oy                                  // the tile's middle: the plate's, so it sits vertically centred
            let ntx = pcx - 128 * u
            let ntl = pcx - 96 * u                         // where its words start
            box { at: ntx, nty; size: 44 * u, 44 * u; corner: 12 * u; color: ink; opacity: 6% }
            //  No picture from the app: a bell, in the accent (or red, for something urgent).
            group {
                show: not nt_icon_on
                ellipse { at: ntx, nty - 2 * u; radius: 7 * u; color: if(nt_urgent, alert, mint) }
                box { at: ntx, nty + 5 * u; size: 18 * u, 3.5 * u; corner: 1.75 * u; color: if(nt_urgent, alert, mint) }
                ellipse { at: ntx, nty + 9.5 * u; radius: 2 * u; color: if(nt_urgent, alert, mint) }
            }
            group {
                show: nt_icon_on
                image nt_img { at: floor(ntx - 22 * u + 0.5), floor(nty - 22 * u + 0.5); size: floor(44 * u + 0.5), floor(44 * u + 0.5) }
            }
            //  A ring off the tile when it arrives.
            ellipse { at: ntx, nty; radius: (24 + 22 * nt_ring) * u; stroke: 2 * u; color: if(nt_urgent, alert, mint); opacity: 90% * (1 - nt_ring) }
            ellipse { at: ntx + 20 * u, nty - 20 * u; radius: 5 * u; color: alert; opacity: if(nt_urgent, 60% + 40% * sin(time * 300), 0) }

            text nt_app { at: floor(ntl + 0.5), floor(ot + 12 * u + 9 * u + 0.5); anchor: left center; size: 13 * u; weight: 700; width: 190 * u; lines: 1; color: faint; family: "Space Grotesk" }
            text nt_title { at: floor(ntl + 0.5), floor(ot + 35 * u + 0.5); anchor: left top; size: 19 * u; weight: 700; width: 236 * u; lines: 3; measure: ntt; color: ink; family: "Space Grotesk" }
            text nt_body { at: floor(ntl + 0.5), floor(ot + (39 + nt_th) * u + 0.5); anchor: left top; size: 15.5 * u; width: 236 * u; lines: 6; measure: ntb; color: faint; family: "Space Grotesk"; show: nt_body_on }
            //  Its buttons, under the words.
            row nt_row {
                at: floor(ntl + 0.5), floor(ot + (nt_content + 8) * u + 0.5)
                gap: 8
                for a in nt_acts { NtAct(a, click: nt_act) }
            }
            //  Close.
            ellipse { at: pcx + 140 * u, ot + 12 * u + 8 * u; radius: 10 * u; color: ink; opacity: 22% * nt_x.hover }
            line { from: pcx + 136.5 * u, ot + 12 * u + 4.5 * u; to: pcx + 143.5 * u, ot + 12 * u + 11.5 * u; width: 1.4 * u; color: ink; opacity: 55% + 45% * nt_x.hover }
            line { from: pcx + 143.5 * u, ot + 12 * u + 4.5 * u; to: pcx + 136.5 * u, ot + 12 * u + 11.5 * u; width: 1.4 * u; color: ink; opacity: 55% + 45% * nt_x.hover }
            zone box nt_x { at: pcx + 140 * u, ot + 12 * u + 8 * u; size: 24 * u, 24 * u; corner: 12 * u; cursor: pointer }
            on press nt_x { emit nt_close }
        }
        }
    }
    //  ── the launcher ──
    //  A search field over its results. What is typed picks the kind of search: apps, or after a first
    //  character `#` files, `>` commands, `:` emoji, `^` the clipboard, `~` wallpapers; and a sum is answered. The
    //  logic (see the Launcher section of vitreus.luau) reads the field and fills `lres`. Files, the clipboard and
    //  wallpapers have a preview beside the rows: the picture, or the text, and the file's details.
    group {
        clip inset 2 box { at: mix(pcx, dl.gx, lm), mix(bar.y + dl.hh / 2, lp.cy, lm); size: mix(dl.w, dl.gw, lm), mix(dl.hh, dl.gh, lm); corner: 26 * pu }
        opacity: fl
        move: 0, (1 - fl) * 12 * pu
        let lx = pcx - 215 * pu
        let ly = ck + 8 * pu
        let lry = ly + 68 * pu                             // the rows start under the hints
        let lph = max(1, lr * 44 - 4) * pu                 // the rows' height, and the preview's
        let lpx = lx + lw + 8 * pu                         // the preview's left edge
        let lpw = 430 * pu - lw - 8 * pu
        box { from: lx, ly; size: 430 * pu, 40 * pu; corner: 20 * pu; color: ink; opacity: 8% }
        ellipse { at: lx + 24 * pu, ly + 19 * pu; radius: 5.5 * pu; stroke: 1.6 * pu; color: mint }
        line { from: lx + 28 * pu, ly + 23 * pu; to: lx + 32.5 * pu, ly + 27.5 * pu; width: 1.8 * pu; color: mint }
        input lq { at: floor(lx + 46 * pu + 0.5), floor(ly + 12 * pu + 0.5); width: 290 * pu; size: 20; color: ink; family: "Space Grotesk"; placeholder: "Search apps…" }
        text lmode { at: floor(lx + 412 * pu + 0.5), floor(ly + 20 * pu + 0.5); anchor: right center; align: right; size: 13.5; weight: 700; width: 70 * pu; lines: 1; color: mint; family: "Space Grotesk" }
        text "files" { at: 0, 0; size: 13; lines: 1; measure: lhw0; opacity: 0; family: "Space Grotesk" }
        text "commands" { at: 0, 0; size: 13; lines: 1; measure: lhw1; opacity: 0; family: "Space Grotesk" }
        text "emoji" { at: 0, 0; size: 13; lines: 1; measure: lhw2; opacity: 0; family: "Space Grotesk" }
        text "clipboard" { at: 0, 0; size: 13; lines: 1; measure: lhw3; opacity: 0; family: "Space Grotesk" }
        text "wallpapers" { at: 0, 0; size: 13; lines: 1; measure: lhw4; opacity: 0; family: "Space Grotesk" }
        //  What the first character of the search does, in small type under the field: press one to type it. Five
        //  equal cells across the field, each pair (character, name) centred in its cell, a divider between cells.
        repeat i in 0..5 {
            let hc = lx + (i + 0.5) * 86 * pu                   // the cell's middle
            let hy = ly + 54 * pu
            let hx = floor(hc - (12 * pu + pick(i, lhw0.width, lhw1.width, lhw2.width, lhw3.width, lhw4.width)) / 2 + 0.5)   // where the pair starts
            box { at: hc, hy; size: 82 * pu, 18 * pu; corner: 9 * pu; color: ink; opacity: 8% * lhint_hit.$i.hover }
            text pick(i, "#", ">", ":", "^", "~") { at: hx, floor(hy + 0.5); anchor: left center; size: 15; weight: 700; color: mint; family: "Space Grotesk" }
            text pick(i, "files", "commands", "emoji", "clipboard", "wallpapers") { at: hx + floor(12 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; color: faint; family: "Space Grotesk" }
            line { from: lx + i * 86 * pu, hy - 5 * pu; to: lx + i * 86 * pu, hy + 5 * pu; width: 1 * pu; color: ink; opacity: 18%; show: i > 0 }
            zone box lhint_hit.$i { at: hc, hy; size: 84 * pu, 18 * pu; corner: 9 * pu; cursor: pointer }
            on press lhint_hit.$i { emit launch_hint(i) }
        }
        //  The wheel over the rows scrolls the list (under the rows, so their presses still win).
        zone box lwheel { from: lx, lry; size: lw, lph }
        on scroll lwheel { emit launch_scroll(-wheel) }
        column lcol {
            at: floor(lx + 0.5), floor(lry + 0.5)     // on whole pixels, as each row's height and the gap are: an icon
            view: lw, lph                             // between two pixels picks up a sliver of its neighbour in the atlas
            gap: floor(4 * pu + 0.5)
            for r in lres { LRow(r, pick: launch_pick, del: launch_del) }
        }
        text lmsg { at: floor(lx + lw / 2 + 0.5), floor(lry + 20 * pu + 0.5); anchor: center; align: center; size: 16; color: faint; width: lw - 16 * pu; lines: 2; family: "Space Grotesk"; show: lcount < 1 }

        //  The preview.
        group {
            opacity: lpv
            show: lpv > 0.01
            box { from: lpx, lry; size: lpw, lph; corner: 14 * pu; color: ink; opacity: 5% }
            text lp_kind { at: floor(lpx + 10 * pu + 0.5), floor(lry + 14 * pu + 0.5); anchor: left center; size: 12; weight: 700; width: lpw - 20 * pu; lines: 1; color: mint; family: "Space Grotesk" }
            group {
                show: lp_img_on
                clip inset 0 box { at: lpx + lpw / 2, lry + 28 * pu + (lpw - 20 * pu) / 3; size: lpw - 20 * pu, (lpw - 20 * pu) * 2 / 3; corner: 8 * pu }
                box { from: lpx + 10 * pu, lry + 28 * pu; size: lpw - 20 * pu, (lpw - 20 * pu) * 2 / 3; corner: 8 * pu; color: ink; opacity: 5% }
                image lp_img { at: lpx + 10 * pu, lry + 28 * pu; size: lpw - 20 * pu, (lpw - 20 * pu) * 2 / 3 }
            }
            let lpy = lry + 28 * pu + if(lp_img_on, (lpw - 20 * pu) * 2 / 3 + 8 * pu, 0)
            text lp_title { at: floor(lpx + 10 * pu + 0.5), floor(lpy + 8 * pu + 0.5); anchor: left center; size: 16; weight: 700; width: lpw - 20 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            text lp_path { at: floor(lpx + 10 * pu + 0.5), floor(lpy + 24 * pu + 0.5); anchor: left center; size: 13; width: lpw - 20 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            text lp_body { at: floor(lpx + 10 * pu + 0.5), floor(lpy + 40 * pu + 0.5); anchor: left top; size: 15; width: lpw - 20 * pu; lines: 9; color: ink; family: "Space Grotesk" }
            repeat i in 0..4 {
                let ky = lpy + 44 * pu + i * 16 * pu
                text pick(i, lp_k1, lp_k2, lp_k3, lp_k4) { at: floor(lpx + 10 * pu + 0.5), floor(ky + 0.5); anchor: left center; size: 13.5; width: 50 * pu; lines: 1; color: faint; family: "Space Grotesk" }
                text pick(i, lp_v1, lp_v2, lp_v3, lp_v4) { at: floor(lpx + 60 * pu + 0.5), floor(ky + 0.5); anchor: left center; size: 13.5; width: lpw - 70 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            }
        }
        text "↑↓ move   ·   Enter open   ·   Esc close" { at: floor(lx + 6 * pu + 0.5), floor(lry + (lr * 44 + 4 + 9) * pu + 0.5); anchor: left center; size: 13.5; color: faint; opacity: 70%; family: "Space Grotesk" }
        text lfoot { at: floor(lx + 424 * pu + 0.5), floor(lry + (lr * 44 + 4 + 9) * pu + 0.5); anchor: right center; align: right; size: 13.5; width: 120 * pu; lines: 1; color: faint; opacity: 70%; family: "Space Grotesk" }
    }

    //  ── the settings panel ──
    //  Laid out as a header with an icon badge, the title and a breadcrumb chip; under
    //  it a sidebar of sections next to the page, which is a stack of cards. The wallpaper picker is the
    //  first (and, for now, only) page.
    group {
        clip inset 2 box { at: mix(pcx, ds.gx, lm), mix(bar.y + ss.hh / 2, lp.cy, lm); size: mix(ss.w, ds.gw, lm), mix(ss.hh, ds.gh, lm); corner: 26 * pu }
        opacity: fs
        move: 0, (1 - fs) * 12 * pu
        let hy = ck + 26 * pu                              // the header's middle
        let sby = ck + 52 * pu                              // the top of the sidebar and the page
        let sl = pcx - 298 * pu                             // their left edge
        let spx = sl + 158 * pu                             // the page's left edge

        //  Header: a badge with a gear, SETTINGS, the breadcrumb, and a cross.
        box { at: sl + 16 * pu, hy; size: 32 * pu, 32 * pu; corner: 9 * pu; color: mint; opacity: 20% }
        group {
            ellipse { at: sl + 16 * pu, hy; radius: 6 * pu; stroke: 2.2 * pu; color: mint }
            ellipse { at: sl + 16 * pu, hy; radius: 2 * pu; color: mint }
            repeat i in 0..8 {
                group {
                    pivot: sl + 16 * pu, hy
                    rotate: i * 45deg
                    box { at: sl + 16 * pu, hy - 8.5 * pu; size: 3 * pu, 4 * pu; corner: 1 * pu; color: mint }
                }
            }
        }
        text "SETTINGS" { at: floor(sl + 40 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" }
        box { at: sl + 178 * pu, hy; size: 132 * pu, 22 * pu; corner: 11 * pu; color: ink; opacity: 6% }
        text "VISUALS" { at: floor(sl + 122 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 12; weight: 700; color: faint; opacity: 1 - set_pgh - set_pga - set_pgs - set_pgt - set_pgl - set_pgw; family: "Space Grotesk" }
        text "SYSTEM" { at: floor(sl + 122 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 12; weight: 700; color: faint; opacity: set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw; family: "Space Grotesk" }
        path { at: sl + 168 * pu, hy; stroke: 1.3 * pu; color: faint; move -2 * pu, -3.5 * pu; line 2 * pu, 0; line -2 * pu, 3.5 * pu }
        text "Wallpaper" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; weight: 700; color: mint; opacity: 1 - set_pg - set_pgd - set_pgb - set_pgn - set_pgh - set_pga - set_pgs - set_pgt - set_pgl - set_pgw; family: "Space Grotesk" }
        text "Display" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; weight: 700; color: mint; opacity: set_pgd; family: "Space Grotesk" }
        text "Glass" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; weight: 700; color: mint; opacity: set_pg; family: "Space Grotesk" }
        text "Hyprland" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; weight: 700; color: mint; opacity: set_pgh; family: "Space Grotesk" }
        text "Pleamar-WM" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; weight: 700; color: mint; opacity: set_pgw; family: "Space Grotesk" }
        text "Bar" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; weight: 700; color: mint; opacity: set_pgb; family: "Space Grotesk" }
        text "About" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; weight: 700; color: mint; opacity: set_pga; family: "Space Grotesk" }
        text "Night mode" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; weight: 700; color: mint; opacity: set_pgn; family: "Space Grotesk" }
        text "System monitor" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; weight: 700; color: mint; opacity: set_pgs; family: "Space Grotesk" }
        text "Notifications" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; weight: 700; color: mint; opacity: set_pgt; family: "Space Grotesk" }
        text "Lock screen" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; weight: 700; color: mint; opacity: set_pgl; family: "Space Grotesk" }
        ellipse { at: pcx + 282 * pu, hy; radius: 13 * pu; color: ink; opacity: 5% + 10% * set_x.hover }
        line { from: pcx + 277.5 * pu, hy - 4.5 * pu; to: pcx + 286.5 * pu, hy + 4.5 * pu; width: 1.5 * pu; color: ink; opacity: 60% + 40% * set_x.hover }
        line { from: pcx + 286.5 * pu, hy - 4.5 * pu; to: pcx + 277.5 * pu, hy + 4.5 * pu; width: 1.5 * pu; color: ink; opacity: 60% + 40% * set_x.hover }
        zone box set_x { at: pcx + 282 * pu, hy; size: 28 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
        on press set_x { panel = none }

        //  Sidebar: the sections, grouped. One so far.
        box { at: sl + 75 * pu, sby + set.h / 2 * pu; size: 150 * pu, set.h * pu; corner: 14 * pu; color: ink; opacity: 4% }
        text "VISUALS" { at: floor(sl + 14 * pu + 0.5), floor(sby + 18 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; opacity: 70%; family: "Space Grotesk" }
        //  The highlight's place is each page's own selection (a spring, 0 or 1) times its row, summed: a straight line from one row to the next.
        //  (Nested `mix`es bent it: the old row's value falling while the new one rises dragged it back towards the top row and down again.)
        box { at: sl + 75 * pu, sby + (42 + 32 * (set_pg + 2 * set_pgd + 3 * set_pgb + 4 * set_pgn) + (side.hy - 42) * set_pgh + (side.wm - 42) * set_pgw + (side.mon - 42) * set_pgs + (side.nt - 42) * set_pgt + (side.lk - 42) * set_pgl + (side.ab - 42) * set_pga) * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; color: mint; opacity: 16% }
        group {
            opacity: 65% + 35% * (1 - clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw, 0, 1))
            box { at: sl + 24 * pu, sby + 42 * pu; size: 13 * pu, 10 * pu; corner: 2 * pu; stroke: 1.3 * pu; color: mix(mint, ink, clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw, 0, 1)) }
            path { at: sl + 24 * pu, sby + 42 * pu; color: mix(mint, ink, clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw, 0, 1)); move -5 * pu, 3 * pu; line -1.5 * pu, -1 * pu; line 1 * pu, 1.5 * pu; line 2.5 * pu, -1.5 * pu; line 5 * pu, 3 * pu; close }
            ellipse { at: sl + 27 * pu, sby + 39 * pu; radius: 1.2 * pu; color: mix(mint, ink, clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw, 0, 1)) }
        }
        text "Wallpaper" { at: floor(sl + 40 * pu + 0.5), floor(sby + 42 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: mix(mint, ink, clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw, 0, 1)); opacity: 100% - 15% * clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw, 0, 1); family: "Space Grotesk" }
        //  Glass: a pane with a highlight across its corner.
        group {
            opacity: 65% + 35% * set_pg
            box { at: sl + 24 * pu, sby + 74 * pu; size: 13 * pu, 13 * pu; corner: 3.5 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pg) }
            line { from: sl + 20.5 * pu, sby + 76.5 * pu; to: sl + 24.5 * pu, sby + 71 * pu; width: 1.1 * pu; color: mix(ink, mint, set_pg); opacity: 80% }
        }
        text "Glass" { at: floor(sl + 40 * pu + 0.5), floor(sby + 74 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: mix(ink, mint, set_pg); opacity: 85% + 15% * set_pg; family: "Space Grotesk" }
        //  Display: a screen on its stand.
        group {
            opacity: 65% + 35% * set_pgd
            box { at: sl + 24 * pu, sby + 104 * pu; size: 14 * pu, 9.5 * pu; corner: 2 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgd) }
            line { from: sl + 24 * pu, sby + 109.5 * pu; to: sl + 24 * pu, sby + 112 * pu; width: 1.3 * pu; color: mix(ink, mint, set_pgd) }
            line { from: sl + 20.5 * pu, sby + 112.5 * pu; to: sl + 27.5 * pu, sby + 112.5 * pu; width: 1.3 * pu; color: mix(ink, mint, set_pgd) }
        }
        text "Display" { at: floor(sl + 40 * pu + 0.5), floor(sby + 106 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: mix(ink, mint, set_pgd); opacity: 85% + 15% * set_pgd; family: "Space Grotesk" }
        //  Bar: a pill with its three dots, the bar itself.
        group {
            opacity: 65% + 35% * set_pgb
            box { at: sl + 24 * pu, sby + 138 * pu; size: 16 * pu, 8 * pu; corner: 4 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgb) }
            repeat k in 0..3 { ellipse { at: sl + (21 + k * 3) * pu, sby + 138 * pu; radius: 0.9 * pu; color: mix(ink, mint, set_pgb) } }
        }
        text "Bar" { at: floor(sl + 40 * pu + 0.5), floor(sby + 138 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: mix(ink, mint, set_pgb); opacity: 85% + 15% * set_pgb; family: "Space Grotesk" }
        //  Night mode: the same crescent as the Power window's Sleep button, a little smaller.
        group {
            opacity: 65% + 35% * set_pgn
            path { at: sl + 24 * pu, sby + 170 * pu; stroke: 1.6 * pu; color: mix(ink, mint, set_pgn); move 5.97 * pu, 2.28 * pu; line 5.59 * pu, 3.07 * pu; line 5.10 * pu, 3.80 * pu; line 4.51 * pu, 4.45 * pu; line 3.84 * pu, 5.02 * pu; line 3.09 * pu, 5.48 * pu; line 2.29 * pu, 5.83 * pu; line 1.44 * pu, 6.06 * pu; line 0.57 * pu, 6.18 * pu; line -0.30 * pu, 6.16 * pu; line -1.17 * pu, 6.03 * pu; line -2.01 * pu, 5.77 * pu; line -2.81 * pu, 5.40 * pu; line -3.54 * pu, 4.92 * pu; line -4.20 * pu, 4.34 * pu; line -4.77 * pu, 3.68 * pu; line -5.24 * pu, 2.94 * pu; line -5.60 * pu, 2.14 * pu; line -5.85 * pu, 1.30 * pu; line -5.97 * pu, 0.42 * pu; line -5.96 * pu, -0.45 * pu; line -5.84 * pu, -1.32 * pu; line -5.59 * pu, -2.16 * pu; line -5.23 * pu, -2.96 * pu; line -4.76 * pu, -3.70 * pu; line -4.18 * pu, -4.36 * pu; line -3.53 * pu, -4.94 * pu; line -2.79 * pu, -5.42 * pu; line -1.99 * pu, -5.79 * pu; line -1.15 * pu, -6.04 * pu; line -0.29 * pu, -6.18 * pu; line -0.70 * pu, -5.70 * pu; line -1.05 * pu, -5.18 * pu; line -1.34 * pu, -4.63 * pu; line -1.56 * pu, -4.05 * pu; line -1.71 * pu, -3.44 * pu; line -1.79 * pu, -2.82 * pu; line -1.80 * pu, -2.20 * pu; line -1.73 * pu, -1.57 * pu; line -1.59 * pu, -0.96 * pu; line -1.38 * pu, -0.37 * pu; line -1.10 * pu, 0.19 * pu; line -0.76 * pu, 0.71 * pu; line -0.36 * pu, 1.20 * pu; line 0.09 * pu, 1.63 * pu; line 0.60 * pu, 2.00 * pu; line 1.14 * pu, 2.31 * pu; line 1.71 * pu, 2.56 * pu; line 2.31 * pu, 2.74 * pu; line 2.93 * pu, 2.84 * pu; line 3.56 * pu, 2.87 * pu; line 4.18 * pu, 2.84 * pu; line 4.80 * pu, 2.72 * pu; line 5.39 * pu, 2.53 * pu; line 5.97 * pu, 2.28 * pu; line 5.97 * pu, 2.28 * pu }
        }
        text "Night mode" { at: floor(sl + 40 * pu + 0.5), floor(sby + 170 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: mix(ink, mint, set_pgn); opacity: 85% + 15% * set_pgn; family: "Space Grotesk" }
        zone box side_nt { at: sl + 75 * pu, sby + 170 * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_nt { set_page = pg_night }
        text "SYSTEM" { at: floor(sl + 14 * pu + 0.5), floor(sby + 204 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; opacity: 70%; family: "Space Grotesk" }
        //  Hyprland: a window with its title bar.
        group {
            opacity: 65% + 35% * set_pgh
            box { at: sl + 24 * pu, sby + side.hy * pu; size: 14 * pu, 11 * pu; corner: 2 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgh) }
            line { from: sl + 17 * pu, sby + (side.hy - 2) * pu; to: sl + 31 * pu, sby + (side.hy - 2) * pu; width: 1.3 * pu; color: mix(ink, mint, set_pgh) }
        }
        text "Hyprland" { at: floor(sl + 40 * pu + 0.5), floor(sby + side.hy * pu + 0.5); anchor: left center; size: 16; weight: 700; color: mix(ink, mint, set_pgh); opacity: 85% + 15% * set_pgh; family: "Space Grotesk" }
        //  Pleamar-WM: two tiles side by side.
        group {
            opacity: 65% + 35% * set_pgw
            box { at: sl + 24 * pu, sby + side.wm * pu; size: 14 * pu, 11 * pu; corner: 2 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgw) }
            line { from: sl + 26 * pu, sby + (side.wm - 5.5) * pu; to: sl + 26 * pu, sby + (side.wm + 5.5) * pu; width: 1.3 * pu; color: mix(ink, mint, set_pgw) }
        }
        text "Pleamar-WM" { at: floor(sl + 40 * pu + 0.5), floor(sby + side.wm * pu + 0.5); anchor: left center; size: 16; weight: 700; width: 108 * pu; lines: 1; color: mix(ink, mint, set_pgw); opacity: 85% + 15% * set_pgw; family: "Space Grotesk" }
        zone box side_wm { at: sl + 75 * pu, sby + side.wm * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_wm { set_page = pg_wm }
        //  About: an i in a circle.
        group {
            opacity: 65% + 35% * set_pga
            ellipse { at: sl + 24 * pu, sby + side.ab * pu; radius: 6.5 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pga) }
            line { from: sl + 24 * pu, sby + side.ab * pu; to: sl + 24 * pu, sby + (side.ab + 3.5) * pu; width: 1.3 * pu; color: mix(ink, mint, set_pga) }
            ellipse { at: sl + 24 * pu, sby + (side.ab - 3.2) * pu; radius: 0.9 * pu; color: mix(ink, mint, set_pga) }
        }
        text "About" { at: floor(sl + 40 * pu + 0.5), floor(sby + side.ab * pu + 0.5); anchor: left center; size: 16; weight: 700; color: mix(ink, mint, set_pga); opacity: 85% + 15% * set_pga; family: "Space Grotesk" }
        //  System monitor: a pulse line.
        group {
            opacity: 65% + 35% * set_pgs
            path { at: sl + 24 * pu, sby + side.mon * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgs); move -7 * pu, 1 * pu; line -3.5 * pu, 1 * pu; line -1.5 * pu, -5 * pu; line 1.5 * pu, 5 * pu; line 3.5 * pu, -1 * pu; line 7 * pu, -1 * pu }
        }
        text "System monitor" { at: floor(sl + 40 * pu + 0.5), floor(sby + side.mon * pu + 0.5); anchor: left center; size: 16; weight: 700; width: 108 * pu; lines: 1; color: mix(ink, mint, set_pgs); opacity: 85% + 15% * set_pgs; family: "Space Grotesk" }
        //  Notifications: a bell.
        group {
            opacity: 65% + 35% * set_pgt
            path { at: sl + 24 * pu, sby + side.nt * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgt); move -5.5 * pu, 4 * pu; line -5.5 * pu, 3 * pu; line -4 * pu, 1.5 * pu; line -4 * pu, -2.5 * pu; curve 4 * pu, -2.5 * pu via 0, -9 * pu; line 4 * pu, 1.5 * pu; line 5.5 * pu, 3 * pu; line 5.5 * pu, 4 * pu; close }
            ellipse { at: sl + 24 * pu, sby + (side.nt + 6.5) * pu; radius: 1.6 * pu; color: mix(ink, mint, set_pgt) }
        }
        text "Notifications" { at: floor(sl + 40 * pu + 0.5), floor(sby + side.nt * pu + 0.5); anchor: left center; size: 16; weight: 700; width: 108 * pu; lines: 1; color: mix(ink, mint, set_pgt); opacity: 85% + 15% * set_pgt; family: "Space Grotesk" }
        //  Lock screen: a padlock.
        group {
            opacity: 65% + 35% * set_pgl
            path { at: sl + 24 * pu, sby + side.lk * pu - 2.5 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgl); move -3.5 * pu, -1 * pu; line -3.5 * pu, -4 * pu; curve 3.5 * pu, -4 * pu via 0 * pu, -10.5 * pu; line 3.5 * pu, -1 * pu }
            box { at: sl + 24 * pu, sby + side.lk * pu + 2 * pu; size: 12 * pu, 8.5 * pu; corner: 2.2 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgl) }
        }
        text "Lock screen" { at: floor(sl + 40 * pu + 0.5), floor(sby + side.lk * pu + 0.5); anchor: left center; size: 16; weight: 700; width: 108 * pu; lines: 1; color: mix(ink, mint, set_pgl); opacity: 85% + 15% * set_pgl; family: "Space Grotesk" }
        zone box side_lk { at: sl + 75 * pu, sby + side.lk * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_lk { set_page = pg_lock }
        zone box side_nt2 { at: sl + 75 * pu, sby + side.nt * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_nt2 { set_page = pg_nt }
        zone box side_sy { at: sl + 75 * pu, sby + side.mon * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_sy { set_page = pg_sys }
        zone box side_ab { at: sl + 75 * pu, sby + side.ab * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_ab { set_page = pg_about }
        zone box side_hy { at: sl + 75 * pu, sby + side.hy * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_hy { set_page = pg_hypr }
        zone box side_dp { at: sl + 75 * pu, sby + 106 * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_dp { set_page = pg_disp }
        zone box side_bar { at: sl + 75 * pu, sby + 138 * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_bar { set_page = pg_bar }
        zone box side_wp { at: sl + 75 * pu, sby + 42 * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        zone box side_gl { at: sl + 75 * pu, sby + 74 * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_wp { set_page = pg_wall }
        on press side_gl { set_page = pg_glass }

        group {
            show: set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw < 0.99
            opacity: 1 - set_pg - set_pgd - set_pgb - set_pgn - set_pgh - set_pga - set_pgs - set_pgt - set_pgl - set_pgw
            //  The wallpaper page. Card one: the wallpaper in use, and Random.
            box { at: spx + 219 * pu, sby + 46 * pu; size: 438 * pu, 92 * pu; corner: 14 * pu; color: ink; opacity: veil }
            group {
                clip inset 0 box { at: spx + 77 * pu, sby + 46 * pu; size: 130 * pu, 73 * pu; corner: 10 * pu }
                image wp_cur { at: spx + 12 * pu, sby + 9.5 * pu; size: 130 * pu, 73 * pu }
            }
            text "ACTIVE WALLPAPER" { at: floor(spx + 154 * pu + 0.5), floor(sby + 27 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text wp_name { at: floor(spx + 154 * pu + 0.5), floor(sby + 46 * pu + 0.5); anchor: left center; size: 17.5; weight: 700; width: 150 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            text wp_dirtext { at: floor(spx + 154 * pu + 0.5), floor(sby + 63 * pu + 0.5); anchor: left center; size: 13.5; width: 150 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            //  One row, centred on the card: the wallpaper's name, Random, and Iris. Random is a hexagon with softened corners, like the
            //  picker's tiles, with a die in it.
            let rhx = spx + 331 * pu
            let rhy = sby + 46 * pu
            let rhr = 18 * pu
            //  On a press it grows as the die turns and throbs back as it settles: `rth` is 0 at rest, 1 half way through the turn
            //  (how far `rand_spin` has come of the way to `rand_turn`), and dips under 0 where the spring overshoots.
            let rth = sin(clamp(1 - (rand_turn - rand_spin), 0, 1.3) * 180)
            group {
                pivot: rhx, rhy
                scale: 1 + 0.22 * rth
                path { at: rhx, rhy; color: mint; opacity: 16% + 16% * wp_rand_hit.hover + 22% * rth; move -0.260 * rhr, -0.850 * rhr; curve 0.260 * rhr, -0.850 * rhr via 0.000 * rhr, -1.000 * rhr; line 0.606 * rhr, -0.650 * rhr; curve 0.866 * rhr, -0.200 * rhr via 0.866 * rhr, -0.500 * rhr; line 0.866 * rhr, 0.200 * rhr; curve 0.606 * rhr, 0.650 * rhr via 0.866 * rhr, 0.500 * rhr; line 0.260 * rhr, 0.850 * rhr; curve -0.260 * rhr, 0.850 * rhr via 0.000 * rhr, 1.000 * rhr; line -0.606 * rhr, 0.650 * rhr; curve -0.866 * rhr, 0.200 * rhr via -0.866 * rhr, 0.500 * rhr; line -0.866 * rhr, -0.200 * rhr; curve -0.606 * rhr, -0.650 * rhr via -0.866 * rhr, -0.500 * rhr; close }
                path { at: rhx, rhy; stroke: 1.2 * pu; color: mint; opacity: 45% + 35% * wp_rand_hit.hover + 20% * rth; move -0.260 * rhr, -0.850 * rhr; curve 0.260 * rhr, -0.850 * rhr via 0.000 * rhr, -1.000 * rhr; line 0.606 * rhr, -0.650 * rhr; curve 0.866 * rhr, -0.200 * rhr via 0.866 * rhr, -0.500 * rhr; line 0.866 * rhr, 0.200 * rhr; curve 0.606 * rhr, 0.650 * rhr via 0.866 * rhr, 0.500 * rhr; line 0.260 * rhr, 0.850 * rhr; curve -0.260 * rhr, 0.850 * rhr via 0.000 * rhr, 1.000 * rhr; line -0.606 * rhr, 0.650 * rhr; curve -0.866 * rhr, 0.200 * rhr via -0.866 * rhr, 0.500 * rhr; line -0.866 * rhr, -0.200 * rhr; curve -0.606 * rhr, -0.650 * rhr via -0.866 * rhr, -0.500 * rhr; close }
                group {
                    pivot: rhx, rhy
                    rotate: rand_spin * 360deg
                    box { at: rhx, rhy; size: 12 * pu, 12 * pu; corner: 3 * pu; stroke: 1.3 * pu; color: mint }
                    ellipse { at: rhx - 2.6 * pu, rhy - 2.6 * pu; radius: 1.05 * pu; color: mint }
                    ellipse { at: rhx, rhy; radius: 1.05 * pu; color: mint }
                    ellipse { at: rhx + 2.6 * pu, rhy + 2.6 * pu; radius: 1.05 * pu; color: mint }
                }
            }
            zone box wp_rand_hit { at: rhx, rhy; size: 38 * pu, 38 * pu; corner: 14 * pu; cursor: pointer }
            on press wp_rand_hit { emit wp_random; rand_turn = rand_turn + 1 }

            //  Iris, the palette from the wallpaper: a switch, as for the slideshow below. Off, the shell is monochrome. The window borders in
            //  Hyprland follow it too.
            text "Iris" { at: floor(spx + 378 * pu + 0.5), floor(sby + 46 * pu + 0.5); anchor: right center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(iris_pill, 0, 1))
                box { at: spx + 405 * pu, sby + 46 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu }
            }
            box { at: spx + 397 * pu + iris_pill * 16 * pu, sby + 46 * pu; size: (17 + 9 * clamp(4 * iris_pill * (1 - iris_pill), 0, 1)) * pu, (17 - 3 * clamp(4 * iris_pill * (1 - iris_pill), 0, 1)) * pu; corner: (8.5 - 1.5 * clamp(4 * iris_pill * (1 - iris_pill), 0, 1)) * pu; color: ink }
            zone box wp_iris_hit { at: spx + 405 * pu, sby + 46 * pu; size: 46 * pu, 30 * pu; cursor: pointer }
            on press wp_iris_hit { emit iris_toggle }

            //  Card two: the slideshow. A switch, and how often: a stepper along a short list of intervals.
            box { at: spx + 219 * pu, sby + 122 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Slideshow" { at: floor(spx + 14 * pu + 0.5), floor(sby + 113 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text wp_show_sub { at: floor(spx + 14 * pu + 0.5), floor(sby + 130 * pu + 0.5); anchor: left center; size: 13.5; width: 190 * pu; lines: 1; color: if(wp_show, mint, faint); family: "Space Grotesk" }
            group {
                opacity: 40% + 60% * wp_show_pill
                ellipse { at: spx + 250 * pu, sby + 122 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * wp_min_hit.hover }
                box { at: spx + 250 * pu, sby + 122 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 295 * pu, sby + 122 * pu; size: 58 * pu, 24 * pu; corner: 7 * pu; color: ink; opacity: 8% }
                text wp_mins_text { at: floor(spx + 295 * pu + 0.5), floor(sby + 122 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: 56 * pu; lines: 1; color: mint; family: "Space Grotesk" }
                ellipse { at: spx + 340 * pu, sby + 122 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * wp_plus_hit.hover }
                box { at: spx + 340 * pu, sby + 122 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 340 * pu, sby + 122 * pu; size: 1.6 * pu, 9 * pu; corner: 0.8 * pu; color: ink }
            }
            zone box wp_min_hit { at: spx + 250 * pu, sby + 122 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            zone box wp_plus_hit { at: spx + 340 * pu, sby + 122 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            on press wp_min_hit { emit wp_mins_step(-1) }
            on press wp_plus_hit { emit wp_mins_step(1) }
            body {
                color: mix(off, mint, clamp(wp_show_pill, 0, 1))
                box { at: spx + 405 * pu, sby + 122 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu }
            }
            box { at: spx + 397 * pu + wp_show_pill * 16 * pu, sby + 122 * pu; size: (17 + 9 * clamp(4 * wp_show_pill * (1 - wp_show_pill), 0, 1)) * pu, (17 - 3 * clamp(4 * wp_show_pill * (1 - wp_show_pill), 0, 1)) * pu; corner: (8.5 - 1.5 * clamp(4 * wp_show_pill * (1 - wp_show_pill), 0, 1)) * pu; color: ink }
            zone box wp_show_hit { at: spx + 405 * pu, sby + 122 * pu; size: 46 * pu, 30 * pu; cursor: pointer }
            on press wp_show_hit { emit wp_show_toggle }

            //  Card three: the colour filter. Twelve swatches: the gallery, Random and the slideshow narrow to the
            //  wallpapers whose dominant colour it is; the lit one, pressed again, clears it.
            box { at: spx + 219 * pu, sby + 174 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "COLOR" { at: floor(spx + 14 * pu + 0.5), floor(sby + 165 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text wp_count { at: floor(spx + 14 * pu + 0.5), floor(sby + 182 * pu + 0.5); anchor: left center; size: 13; width: 100 * pu; lines: 1; color: if(wp_filter >= 0, mint, faint); family: "Space Grotesk" }
            repeat i in 0..12 {
                let swx = spx + 124 * pu + i * 26 * pu
                let lit = if(wp_filter == i, 1, 0)
                box { at: swx, sby + 174 * pu; size: (18 + 3 * lit) * pu, (18 + 3 * lit) * pu; corner: 5 * pu; color: pick(i, #e53935, #fb8c00, #fdd835, #43a047, #00acc1, #1e88e5, #8e24aa, #ec407a, #6d4c41, #f5f5f5, #9e9e9e, #212121) }
                box { at: swx, sby + 174 * pu; size: (18 + 3 * lit) * pu, (18 + 3 * lit) * pu; corner: 5 * pu; stroke: 1 * pu; color: #000000; opacity: 35% }
                box { at: swx, sby + 174 * pu; size: 25 * pu, 25 * pu; corner: 7 * pu; stroke: 2 * pu; color: mint; opacity: lit * 100% }
                zone box wp_sw.$i { at: swx, sby + 174 * pu; size: 24 * pu, 24 * pu; corner: 6 * pu; cursor: pointer }
                on press wp_sw.$i { emit wp_filter_set(i) }
            }

            //  Card four: the gallery, twelve at a time, with a pager.
            box { at: spx + 219 * pu, sby + 330 * pu; size: 438 * pu, 252 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "WALLPAPER GALLERY" { at: floor(spx + 14 * pu + 0.5), floor(sby + 220 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text wp_dirtext { at: floor(spx + 424 * pu + 0.5), floor(sby + 220 * pu + 0.5); anchor: right center; size: 13; width: 260 * pu; lines: 1; align: right; color: faint; opacity: 70%; family: "Space Grotesk" }
            text "No wallpaper of this color" { at: floor(spx + 219 * pu + 0.5), floor(sby + 330 * pu + 0.5); anchor: center; size: 16; color: faint; family: "Space Grotesk"; show: wps.count < 1 }
            row wp_grid {
                at: floor(spx + 15 * pu + 0.5), floor(sby + 238 * pu + 0.5)
                gap: 8 * pu
                wrap: 4
                for w in wps { WpThumb(w, pick: wp_pick) }
            }
            path { at: spx + 40 * pu, sby + 438 * pu; stroke: 1.6 * pu; color: ink; opacity: 55% + 45% * wp_prev_hit.hover; move 3 * pu, -5 * pu; line -3 * pu, 0; line 3 * pu, 5 * pu }
            text wp_pager { at: floor(spx + 219 * pu + 0.5), floor(sby + 438 * pu + 0.5); anchor: center; align: center; size: 15; weight: 600; width: 100 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            path { at: spx + 398 * pu, sby + 438 * pu; stroke: 1.6 * pu; color: ink; opacity: 55% + 45% * wp_next_hit.hover; move -3 * pu, -5 * pu; line 3 * pu, 0; line -3 * pu, 5 * pu }
            zone box wp_prev_hit { at: spx + 40 * pu, sby + 438 * pu; size: 30 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            zone box wp_next_hit { at: spx + 398 * pu, sby + 438 * pu; size: 30 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press wp_prev_hit { emit wp_prev }
            on press wp_next_hit { emit wp_next }
        }

        //  The Glass page. Two sliders that act on the bar and every drawer at once, as they are dragged.
        group {
            show: set_pg > 0.01
            opacity: set_pg
            let gsl.x0 = spx + 14 * pu
            let gsl.w = 336 * pu
            let gh = 14 * pu

            //  Glass: how much of the glass effect there is. The compositor does the blur, and pleamar only asks
            //  it for one, so this is not a radius: it is how glassy the panel is (its tint, the edge light and
            //  whether the blur is asked for at all).
            box { at: spx + 219 * pu, sby + 46 * pu; size: 438 * pu, 92 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Glass" { at: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: left center; size: 17.5; weight: 700; color: ink; family: "Space Grotesk" }
            text "How frosted the panels are: 100% is glass that blurs what is behind it, 0% is solid." { at: floor(spx + 14 * pu + 0.5), floor(sby + 33 * pu + 0.5); anchor: left center; size: 13.5; color: faint; family: "Space Grotesk" }
            text "It is counted together with Opacity: once the two multiply to under 30% the blur turns off." { at: floor(spx + 14 * pu + 0.5), floor(sby + 46 * pu + 0.5); anchor: left center; size: 13.5; color: faint; family: "Space Grotesk" }
            body {
                color: deep
                rim: 9%
                box { at: gsl.x0 + gsl.w / 2, sby + 74 * pu; size: gsl.w, gh; corner: gh / 2 }
            }
            group {
                glow: 7 * pu, 50%, mint
                body {
                    gradient: gsl.x0, 0 to gsl.x0 + gsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: gsl.x0, sby + 74 * pu - gh / 2; size: max(0.1, gsl.w * glass_frost), gh; corner: gh / 2 }
                }
            }
            text glass_frost_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 74 * pu + 0.5); anchor: right center; size: 21.5; weight: 600; color: ink; family: "Space Grotesk" }
            zone box glass_hit { at: gsl.x0 + gsl.w / 2, sby + 74 * pu; size: gsl.w + 28 * pu, 34 * pu; cursor: pointer }
            on press glass_hit { emit glass_frost_set(clamp((pointer.x - gsl.x0) / gsl.w, 0, 1)) }
            on drag glass_hit { emit glass_frost_set(clamp((pointer.x - gsl.x0) / gsl.w, 0, 1)) }

            //  Opacity: how solid the bar and the drawers are, from 30% (see-through) to 100%.
            box { at: spx + 219 * pu, sby + 146 * pu; size: 438 * pu, 92 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Opacity" { at: floor(spx + 14 * pu + 0.5), floor(sby + 116 * pu + 0.5); anchor: left center; size: 17.5; weight: 700; color: ink; family: "Space Grotesk" }
            text "How solid the bar and the drawers are. The track starts at 30% (you can see through them)," { at: floor(spx + 14 * pu + 0.5), floor(sby + 133 * pu + 0.5); anchor: left center; size: 13.5; color: faint; family: "Space Grotesk" }
            text "up to 100%. The cards inside keep their own light veil." { at: floor(spx + 14 * pu + 0.5), floor(sby + 146 * pu + 0.5); anchor: left center; size: 13.5; color: faint; family: "Space Grotesk" }
            body {
                color: deep
                rim: 9%
                box { at: gsl.x0 + gsl.w / 2, sby + 174 * pu; size: gsl.w, gh; corner: gh / 2 }
            }
            group {
                glow: 7 * pu, 50%, mint
                body {
                    gradient: gsl.x0, 0 to gsl.x0 + gsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: gsl.x0, sby + 174 * pu - gh / 2; size: max(0.1, gsl.w * glass_op), gh; corner: gh / 2 }
                }
            }
            //  The first 30 % of this track cannot be picked: it is shaded, with a tick where the range starts.
            box { from: gsl.x0, sby + 174 * pu - gh / 2; size: gsl.w * 0.3, gh; corner: gh / 2; color: #000000; opacity: 38% }
            box { at: gsl.x0 + gsl.w * 0.3, sby + 174 * pu; size: 1.5 * pu, gh + 6 * pu; corner: 0.75 * pu; color: ink; opacity: 45% }
            text glass_op_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 174 * pu + 0.5); anchor: right center; size: 21.5; weight: 600; color: ink; family: "Space Grotesk" }
            zone box glass_op_hit { at: gsl.x0 + gsl.w / 2, sby + 174 * pu; size: gsl.w + 28 * pu, 34 * pu; cursor: pointer }
            on press glass_op_hit { emit glass_op_set(clamp((pointer.x - gsl.x0) / gsl.w, 0, 1)) }
            on drag glass_op_hit { emit glass_op_set(clamp((pointer.x - gsl.x0) / gsl.w, 0, 1)) }

            //  Back to how it was.
            text "Changes apply right away." { at: floor(spx + 14 * pu + 0.5), floor(sby + 222 * pu + 0.5); anchor: left center; size: 13.5; color: faint; opacity: 80%; family: "Space Grotesk" }
            box { at: spx + 370 * pu, sby + 222 * pu; size: 128 * pu, 26 * pu; corner: 13 * pu; color: ink; opacity: 8% + 10% * glass_reset_hit.hover }
            text "Reset to defaults" { at: floor(spx + 370 * pu + 0.5), floor(sby + 222 * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 124 * pu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box glass_reset_hit { at: spx + 370 * pu, sby + 222 * pu; size: 130 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press glass_reset_hit { emit glass_reset }
        }

        //  The Bar page: how the bar itself is set up. So far, which monitors it shows on: all of them, or one.
        //  Choosing restarts the bar there (see the Bar section of vitreus.luau).
        group {
            show: set_pgb > 0.01
            opacity: set_pgb
            box { at: spx + 219 * pu, sby + 88 * pu; size: 438 * pu, 124 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "SHOW THE BAR ON" { at: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }

            //  All monitors: two small screens, each with the bar across its top.
            let bax = spx + 52 * pu
            let balit = if(bar_scr == -1, 1, 0)
            box { at: bax, sby + 76 * pu; size: 76 * pu, 64 * pu; corner: 12 * pu; color: if(balit > 0, mint, ink); opacity: if(balit > 0, 24%, 6% + 10% * bar_all_hit.hover) }
            box { at: bax, sby + 76 * pu; size: 76 * pu, 64 * pu; corner: 12 * pu; stroke: 1.5 * pu; color: mint; opacity: balit * 100% }
            repeat k in 0..2 {
                let bkx = bax + (k * 2 - 1) * 10 * pu
                box { at: bkx, sby + 60 * pu; size: 16 * pu, 11 * pu; corner: 2 * pu; stroke: 1.2 * pu; color: mix(ink, mint, balit) }
                box { at: bkx, sby + 56.6 * pu; size: 11 * pu, 1.8 * pu; corner: 0.9 * pu; color: mix(ink, mint, balit) }
            }
            text "All" { at: floor(bax + 0.5), floor(sby + 82 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: 70 * pu; lines: 1; color: mix(ink, mint, balit); family: "Space Grotesk" }
            text "every monitor" { at: floor(bax + 0.5), floor(sby + 95 * pu + 0.5); anchor: center; align: center; size: 12; width: 70 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            zone box bar_all_hit { at: bax, sby + 76 * pu; size: 76 * pu, 64 * pu; corner: 12 * pu; cursor: pointer }
            on press bar_all_hit { emit bar_pick_scr(-1) }

            //  One tile per monitor that is plugged in: a screen with the bar across its top.
            repeat i in 0..4 {
                let bmx = spx + (52 + 83 + i * 83) * pu
                let bmlit = if(bar_scr == i, 1, 0)
                group {
                    show: bar_m.$i.on
                    box { at: bmx, sby + 76 * pu; size: 76 * pu, 64 * pu; corner: 12 * pu; color: if(bmlit > 0, mint, ink); opacity: if(bmlit > 0, 24%, 6% + 10% * bar_m_hit.$i.hover) }
                    box { at: bmx, sby + 76 * pu; size: 76 * pu, 64 * pu; corner: 12 * pu; stroke: 1.5 * pu; color: mint; opacity: bmlit * 100% }
                    box { at: bmx, sby + 60 * pu; size: 18 * pu, 12 * pu; corner: 2 * pu; stroke: 1.2 * pu; color: mix(ink, mint, bmlit) }
                    box { at: bmx, sby + 56.2 * pu; size: 12 * pu, 1.8 * pu; corner: 0.9 * pu; color: mix(ink, mint, bmlit) }
                    text bar_m.$i.name { at: floor(bmx + 0.5), floor(sby + 82 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: 70 * pu; lines: 1; color: mix(ink, mint, bmlit); family: "Space Grotesk" }
                    text bar_m.$i.sub { at: floor(bmx + 0.5), floor(sby + 95 * pu + 0.5); anchor: center; align: center; size: 12; width: 70 * pu; lines: 1; color: faint; family: "Space Grotesk" }
                    zone box bar_m_hit.$i { at: bmx, sby + 76 * pu; size: 76 * pu, 64 * pu; corner: 12 * pu; cursor: pointer }
                    on press bar_m_hit.$i { emit bar_pick_scr(i) }
                }
            }
            text "Changing this restarts the bar for a moment." { at: floor(spx + 14 * pu + 0.5), floor(sby + 121 * pu + 0.5); anchor: left center; size: 13.5; width: 410 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            text bar_msg { at: floor(spx + 14 * pu + 0.5), floor(sby + 136 * pu + 0.5); anchor: left center; size: 13.5; width: 410 * pu; lines: 1; color: mint; family: "Space Grotesk" }

            //  ── Where the bar is: along the top (the default), or down the left edge with a frame round the screen ──
            box { at: spx + 219 * pu, sby + 360 * pu; size: 438 * pu, 96 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "BAR POSITION" { at: floor(spx + 14 * pu + 0.5), floor(sby + 322 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            repeat k in 0..2 {
                let bpx = spx + (52 + k * 83) * pu
                let bpy = sby + 369 * pu
                let bplit = if((k == 0 and bar_anchor == top) or (k == 1 and bar_anchor == left), 1, 0)
                box { at: bpx, bpy; size: 76 * pu, 64 * pu; corner: 12 * pu; color: if(bplit > 0, mint, ink); opacity: if(bplit > 0, 24%, 6% + 10% * bar_pos_hit.$k.hover) }
                box { at: bpx, bpy; size: 76 * pu, 64 * pu; corner: 12 * pu; stroke: 1.5 * pu; color: mint; opacity: bplit * 100% }
                //  A small screen. With the bar along the top: a bar across its top. Down the left: a strip, and the frame round the rest.
                box { at: bpx, bpy - 12 * pu; size: 36 * pu, 24 * pu; corner: 3 * pu; stroke: 1.2 * pu; color: mix(ink, mint, bplit) }
                box { at: bpx, bpy - 21 * pu; size: 28 * pu, 3.2 * pu; corner: 1.6 * pu; color: mix(ink, mint, bplit); show: k == 0 }
                box { at: bpx - 14 * pu, bpy - 12 * pu; size: 3.6 * pu, 20 * pu; corner: 1.8 * pu; color: mix(ink, mint, bplit); show: k == 1 }
                box { at: bpx + 2 * pu, bpy - 12 * pu; size: 28 * pu, 17 * pu; corner: 3 * pu; stroke: 0.9 * pu; color: mix(ink, mint, bplit); opacity: 60%; show: k == 1 }
                text pick(k, "Top", "Left") { at: floor(bpx + 0.5), floor(bpy + 13 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: 70 * pu; lines: 1; color: mix(ink, mint, bplit); family: "Space Grotesk" }
                text pick(k, "along the top", "with a frame") { at: floor(bpx + 0.5), floor(bpy + 26 * pu + 0.5); anchor: center; align: center; size: 12; width: 70 * pu; lines: 1; color: faint; family: "Space Grotesk" }
                zone box bar_pos_hit.$k { at: bpx, bpy; size: 76 * pu, 64 * pu; corner: 12 * pu; cursor: pointer }
                on press bar_pos_hit.$k { emit bar_pick_pos(k) }
            }
            text "It moves at once; windows make room for the strip." { at: floor(spx + 14 * pu + 0.5), floor(sby + 418 * pu + 0.5); anchor: left center; size: 13.5; width: 410 * pu; lines: 1; color: faint; family: "Space Grotesk" }

            //  ── The layout: a small copy of the bar, and under it a tray for the pieces that are hidden ──
            //  Drag a piece along the bar to move it, or down into the tray to hide it (all but the settings gear,
            //  the way back here). The logic places the chips and makes room where the dragged one would land.
            let mbx = spx + 14 * pu                         // the editor's origin: the small bar's top-left
            let mby = sby + 190 * pu
            box { at: spx + 219 * pu, sby + 244 * pu; size: 438 * pu, 132 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "BAR LAYOUT" { at: floor(spx + 14 * pu + 0.5), floor(sby + 166 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            box { at: spx + 400 * pu, sby + 166 * pu; size: 48 * pu, 20 * pu; corner: 10 * pu; color: ink; opacity: 8% + 10% * blay_reset_hit.hover }
            text "Reset" { at: floor(spx + 400 * pu + 0.5), floor(sby + 166 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 600; width: 44 * pu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box blay_reset_hit { at: spx + 400 * pu, sby + 166 * pu; size: 50 * pu, 22 * pu; corner: 11 * pu; cursor: pointer }
            on press blay_reset_hit { emit bar_lay_reset }
            //  The small bar, and the tray: lit while the dragged piece would land in it.
            box { from: mbx, mby; size: 410 * pu, 36 * pu; corner: 12 * pu; color: ink; opacity: 5% }
            box { from: mbx, mby; size: 410 * pu, 36 * pu; corner: 12 * pu; stroke: 1 * pu; color: mix(ink, mint, if(bdrag >= 0 and not bdrop_tray, 1, 0)); opacity: if(bdrag >= 0 and not bdrop_tray, 60%, 14%) }
            box { from: mbx, mby + 52 * pu; size: 410 * pu, 36 * pu; corner: 12 * pu; color: ink; opacity: 3% }
            box { from: mbx, mby + 52 * pu; size: 410 * pu, 36 * pu; corner: 12 * pu; stroke: 1 * pu; color: mix(ink, mint, if(bdrop_tray, 1, 0)); opacity: if(bdrag >= 0 and bdrop_tray, 60%, 10%) }
            text "Hidden: drag a piece here to take it off the bar" { at: floor(mbx + 205 * pu + 0.5), floor(mby + 70 * pu + 0.5); anchor: center; align: center; size: 13.5; width: 400 * pu; lines: 1; color: faint; opacity: if(btray_n < 1 and not bdrop_tray, 70%, 0%); family: "Space Grotesk" }
            text "Drag a piece along the bar to move it. The window title stretches: what is left of it hugs the left end." { at: floor(spx + 14 * pu + 0.5), floor(sby + 296 * pu + 0.5); anchor: left center; size: 13; width: 410 * pu; lines: 1; color: faint; family: "Space Grotesk" }

            //  The drag is followed by a zone that stays still, under the chips: a drag reaches every zone that was
            //  under the press, and one that moves itself (a chip following the pointer) loses it at the first jump.
            zone box blay_area { from: mbx - 8 * pu, mby - 8 * pu; size: 426 * pu, 104 * pu }     // the small bar and the tray, not Reset
            on drag blay_area { bdx = (pointer.x - mbx) / pu; bdy = (pointer.y - mby) / pu; emit bar_lay_drag }
            //  The chips' zones, apart from their drawing: pressing one takes it.
            repeat i in 0..8 {
                let zx = mbx + if(bdrag == i, bdx - bgx, bcx.$i) * pu
                let zy = mby + if(bdrag == i, bdy - bgy, bcy.$i) * pu
                zone box bchip.$i { from: zx, zy; size: bcw.$i * pu, 28 * pu; corner: 9 * pu; cursor: grab }
                on press bchip.$i { bgx = (pointer.x - zx) / pu; bgy = (pointer.y - zy) / pu; bdx = (pointer.x - mbx) / pu; bdy = (pointer.y - mby) / pu; bdrag = i; emit bar_lay_grab }
                on release bchip.$i { emit bar_lay_drop }
            }
            repeat pass in 0..2 {
            repeat i in 0..8 {
                let dragging = bdrag == i
              group {
                show: (pass == 0 and not dragging) or (pass == 1 and dragging)
                let chx = mbx + if(dragging, bdx - bgx, bcx.$i) * pu     // the chip's top-left and size
                let chy = mby + if(dragging, bdy - bgy, bcy.$i) * pu
                let chw = bcw.$i * pu
                let chh = 28 * pu
                let ccx = chx + chw / 2
                let ccy = chy + chh / 2
                let lit = if(dragging, 1, 0)
                let ink2 = mix(ink, mint, lit)
                box { from: chx, chy; size: chw, chh; corner: 9 * pu; color: mix(ink, mint, lit); opacity: if(lit > 0, 24%, 8% + 10% * bchip.$i.hover) }
                box { from: chx, chy; size: chw, chh; corner: 9 * pu; stroke: 1.5 * pu; color: mint; opacity: 100% * lit }
                //  What each one is, drawn small, as it is on the bar.
                group {
                    show: i == 0
                    box { at: ccx - 13 * pu, ccy; size: 3.5 * pu, 3.5 * pu; corner: 1.75 * pu; color: ink2; opacity: 60% }
                    box { at: ccx - 3 * pu, ccy; size: 10 * pu, 3.5 * pu; corner: 1.75 * pu; color: mix(mint, ink2, 0) }
                    box { at: ccx + 7 * pu, ccy; size: 3.5 * pu, 3.5 * pu; corner: 1.75 * pu; color: ink2; opacity: 60% }
                    box { at: ccx + 14 * pu, ccy; size: 3.5 * pu, 3.5 * pu; corner: 1.75 * pu; color: ink2; opacity: 60% }
                }
                text "Window title" { at: floor(ccx + 0.5), floor(ccy + 0.5); anchor: center; align: center; size: 14; weight: 600; width: max(10 * pu, chw - 12 * pu); lines: 1; color: ink2; opacity: 85%; show: i == 1; family: "Space Grotesk" }
                group {
                    show: i == 2
                    path { at: ccx - 12 * pu, ccy; color: ink2; move 2.5 * pu, -3 * pu; line -2 * pu, 0; line 2.5 * pu, 3 * pu; close }
                    path { at: ccx, ccy; color: ink2; move -2.5 * pu, -3.5 * pu; line 6 * pu, 0; line -2.5 * pu, 3.5 * pu; close }
                    path { at: ccx + 12 * pu, ccy; color: ink2; move -2.5 * pu, -3 * pu; line 2 * pu, 0; line -2.5 * pu, 3 * pu; close }
                }
                group {
                    show: i == 3
                    ellipse { at: ccx, ccy; radius: 3.6 * pu; stroke: 1.7 * pu; color: ink2 }
                    repeat k in 0..8 {
                        group {
                            pivot: ccx, ccy
                            rotate: k * 45deg
                            box { at: ccx, ccy - 6 * pu; size: 2 * pu, 2.6 * pu; corner: 0.7 * pu; color: ink2 }
                        }
                    }
                }
                group {
                    show: i == 4
                    ellipse { at: ccx - 1.2 * pu, ccy - 1.2 * pu; radius: 4 * pu; stroke: 1.6 * pu; color: ink2 }
                    line { from: ccx + 1.8 * pu, ccy + 1.8 * pu; to: ccx + 5 * pu, ccy + 5 * pu; width: 1.8 * pu; color: ink2 }
                }
                group {
                    show: i == 5
                    box { at: ccx, ccy - 3.5 * pu; size: 13 * pu, 1.5 * pu; corner: 0.75 * pu; color: ink2 }
                    box { at: ccx, ccy + 3.5 * pu; size: 13 * pu, 1.5 * pu; corner: 0.75 * pu; color: ink2 }
                    ellipse { at: ccx + 2.5 * pu, ccy - 3.5 * pu; radius: 2.4 * pu; color: ink2 }
                    ellipse { at: ccx - 2.5 * pu, ccy + 3.5 * pu; radius: 2.4 * pu; color: ink2 }
                }
                group {
                    show: i == 7
                    ellipse { at: ccx - 9 * pu, ccy; radius: 3 * pu; color: ink2 }
                    ellipse { at: ccx, ccy; radius: 3 * pu; color: ink2 }
                    ellipse { at: ccx + 9 * pu, ccy; radius: 3 * pu; color: ink2 }
                }
                text "4:20" { at: floor(ccx + 0.5), floor(ccy + 0.5); anchor: center; align: center; size: 17.5; weight: 700; width: chw; lines: 1; color: mix(mint, ink, 0.25); show: i == 6; family: "Space Grotesk" }
              }
            }
            }
        }

        //  The Lock screen page (System): an example of the password bar, what a typed character becomes and its colours, then how blurred the
        //  wallpaper is, the clock, the date and the player. These are the lock screen scene's own settings (`lockscreen.json`): the logic asks
        //  it for them when this page opens and tells it each change. The page scrolls like System monitor's, and its zones are only live
        //  while they are in the window.
        group {
            show: set_pgl > 0.01
            opacity: set_pgl
            let lk.sc = clamp(lk_scroll, 0, max(0, lk.h - 456))
            let lk.off = floor(lk.sc * pu + 0.5)        // whole pixels: text that is shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pu, sby + 228 * pu; size: 456 * pu, 456 * pu }
            zone box lk_wheel { at: spx + 219 * pu, sby + 228 * pu; size: 446 * pu, 456 * pu }
            on scroll lk_wheel { lk_scroll_to = clamp(lk_scroll_to + wheel * 44, 0, max(0, lk.h - 456)) }
            group {
            move: 0, -lk.off
            let lkb0 = if(lk_blur < 27, 1, 0)
            let lkb1 = if(lk_blur >= 27 and lk_blur < 48, 1, 0)
            let lkb2 = if(lk_blur >= 48, 1, 0)
            let lkt12 = if(lk_12h, 1, 0)
            let lkt24 = 1 - lkt12
            let lkd0 = if(lk_date == lkd_long, 1, 0)
            let lkd1 = if(lk_date == lkd_std, 1, 0)
            let lkd2 = if(lk_date == lkd_day, 1, 0)
            let lkd3 = if(lk_date == lkd_iso, 1, 0)
            let lkm0 = if(lk_mask == lkm_shapes, 1, 0)
            let lkm1 = if(lk_mask == lkm_dots, 1, 0)
            let lkm2 = if(lk_mask == lkm_stars, 1, 0)
            let lkm3 = if(lk_mask == lkm_special, 1, 0)
            let lksz0 = if(lk_px < 125, 1, 0)
            let lksz1 = if(lk_px >= 125 and lk_px < 175, 1, 0)
            let lksz2 = if(lk_px >= 175, 1, 0)
            let lkc0 = if(lk_pal == lkc_vibrant, 1, 0)
            let lkc1 = if(lk_pal == lkc_accent, 1, 0)
            let lkc2 = if(lk_pal == lkc_neon, 1, 0)
            let lkc3 = if(lk_pal == lkc_pastel, 1, 0)
            let lkc4 = if(lk_pal == lkc_mono, 1, 0)

            //  Card one: the example bar. Type into it; Enter pretends the password was right.
            box { at: spx + 219 * pu, sby + 48 * pu; size: 438 * pu, 96 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Example bar" { at: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            //  Test lock: locks now, in the lock screen's safe mode, so Esc on an empty bar (or a minute) opens it. It is only a test of one lock.
            box { at: spx + 388 * pu, sby + 18 * pu; size: 90 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: 16% + 16% * lk_test_hit.hover }
            text "Test lock" { at: floor(spx + 388 * pu + 0.5), floor(sby + 18 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 84 * pu; lines: 1; color: mint; family: "Space Grotesk" }
            zone box lk_test_hit { at: spx + 388 * pu, sby + 18 * pu; size: 90 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (sby + 18 * pu) - lk.off > sby and (sby + 18 * pu) - lk.off < sby + 456 * pu }
            on press lk_test_hit { emit lk_test }
            text "Type to see your glyphs. Enter pretends to unlock." { at: floor(spx + 14 * pu + 0.5), floor(sby + 35 * pu + 0.5); anchor: left center; size: 13.5; width: 260 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            box { at: spx + 219 * pu, sby + 68 * pu; size: 410 * pu, 38 * pu; corner: 19 * pu; color: ink; opacity: 8% }
            box { at: spx + 219 * pu, sby + 68 * pu; size: 410 * pu, 38 * pu; corner: 19 * pu; stroke: 1.2 * pu; color: mix(mint, #10b981, lb_okt); opacity: 40% }
            text "Type to try the bar…" { at: floor(spx + 36 * pu + 0.5), floor(sby + 68 * pu + 0.5); anchor: left center; size: 16; color: faint; opacity: 70%; family: "Space Grotesk"; show: lb.count < 1 }
            //  Only while the bar is in the window: a field above the window would be over the bar.
            group {
                show: lk.off < 96 * pu
                input lb_pw { at: spx + 30 * pu, sby + 59 * pu; width: 380 * pu; size: 19; color: ink; opacity: 0; secret: true; family: "Space Grotesk" }
                on submit lb_pw { emit lb_submit }
            }
            group {
                clip box { from: spx + 26 * pu, sby + 52 * pu; size: 386 * pu, 32 * pu }
                row lb_row {
                    at: spx + 30 * pu - max(0, lb_row.width - 378 * pu), sby + 55 * pu
                    gap: 8 * pu
                    for s in lb {
                        group {
                            size: 26 * pu, 26 * pu
                            let gc5 = mod(s.ci, 5)
                            let gc4 = mod(s.ci, 4)
                            let gv = mix(mix(mix(mix(#00f0ff, #7000ff, if(gc5 == 1, 1, 0)), #ff0055, if(gc5 == 2, 1, 0)), #00ff66, if(gc5 == 3, 1, 0)), #ffcc00, if(gc5 == 4, 1, 0))
                            let gn = mix(mix(mix(#ff0055, #00ffff, if(gc4 == 1, 1, 0)), #ffff00, if(gc4 == 2, 1, 0)), #ff00ff, if(gc4 == 3, 1, 0))
                            let gp = mix(mix(mix(#c4b5fd, #93c5fd, if(gc4 == 1, 1, 0)), #fbcfe8, if(gc4 == 2, 1, 0)), #fed7aa, if(gc4 == 3, 1, 0))
                            let gcol = mix(mix(mix(mix(gv, mint, if(lk_pal == lkc_accent, 1, 0)), gn, if(lk_pal == lkc_neon, 1, 0)), gp, if(lk_pal == lkc_pastel, 1, 0)), #ffffff, if(lk_pal == lkc_mono, 1, 0))
                            let tint = mix(gcol, #10b981, lb_okt)
                                figure lkshp.s0 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 0 and not s.outline }
                                figure lkshp.s0 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 0 and s.outline }
                                figure lkshp.s1 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 1 and not s.outline }
                                figure lkshp.s1 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 1 and s.outline }
                                figure lkshp.s2 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 2 and not s.outline }
                                figure lkshp.s2 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 2 and s.outline }
                                figure lkshp.s3 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 3 and not s.outline }
                                figure lkshp.s3 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 3 and s.outline }
                                figure lkshp.s4 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 4 and not s.outline }
                                figure lkshp.s4 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 4 and s.outline }
                                figure lkshp.s5 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 5 and not s.outline }
                                figure lkshp.s5 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 5 and s.outline }
                                figure lkshp.s6 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 6 and not s.outline }
                                figure lkshp.s6 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 6 and s.outline }
                                figure lkshp.s7 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 7 and not s.outline }
                                figure lkshp.s7 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 7 and s.outline }
                                figure lkshp.s8 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 8 and not s.outline }
                                figure lkshp.s8 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 8 and s.outline }
                                figure lkshp.s9 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 9 and not s.outline }
                                figure lkshp.s9 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 9 and s.outline }
                                figure lkshp.s10 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 10 and not s.outline }
                                figure lkshp.s10 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 10 and s.outline }
                                figure lkshp.s11 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 11 and not s.outline }
                                figure lkshp.s11 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 11 and s.outline }
                                figure lkshp.s12 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 12 and not s.outline }
                                figure lkshp.s12 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 12 and s.outline }
                                figure lkshp.s13 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 13 and not s.outline }
                                figure lkshp.s13 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 13 and s.outline }
                                figure lkshp.s14 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 14 and not s.outline }
                                figure lkshp.s14 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 14 and s.outline }
                                figure lkshp.s15 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 15 and not s.outline }
                                figure lkshp.s15 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 15 and s.outline }
                            ellipse { at: 13 * pu, 13 * pu; radius: 5.5 * pu; color: tint; show: lk_mask == lkm_dots and not s.outline }
                            ellipse { at: 13 * pu, 13 * pu; radius: 5 * pu; stroke: 2 * pu; color: tint; show: lk_mask == lkm_dots and s.outline }
                            group {
                                show: lk_mask == lkm_stars
                                line { from: 5 * pu, 13 * pu; to: 21 * pu, 13 * pu; width: 2.4 * pu; color: tint }
                                line { from: 9 * pu, 6.07 * pu; to: 17 * pu, 19.93 * pu; width: 2.4 * pu; color: tint }
                                line { from: 17 * pu, 6.07 * pu; to: 9 * pu, 19.93 * pu; width: 2.4 * pu; color: tint }
                            }
                            text s.sym { at: 13 * pu, 13 * pu; anchor: center; align: center; size: 27; weight: 700; color: tint; family: "Space Grotesk"; show: lk_mask == lkm_special }
                        }
                    }
                }
            }

            //  Card two: what a typed character becomes.
            box { at: spx + 219 * pu, sby + 141 * pu; size: 438 * pu, 70 * pu; corner: 14 * pu; color: ink; opacity: veil }
