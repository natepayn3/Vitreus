            //  Card seven: the player under the password bar.
            box { at: spx + 219 * pu, sby + 612 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Media player" { at: floor(spx + 14 * pu + 0.5), floor(sby + 602 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "What is playing, under the password bar" { at: floor(spx + 14 * pu + 0.5), floor(sby + 621 * pu + 0.5); anchor: left center; size: 13.5; width: 300 * pu; lines: 1; color: faint; family: "Space Grotesk" }
