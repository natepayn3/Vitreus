language 0.1

import "palette-live.plm"
import "desktopclock/clockface.plm"
import "desktopclock/clockface_styled.plm"

//  Vitreus: a bar of liquid glass. The glass only blurs what is behind it (the
//  compositor does it; `lens: false`, unless the Glass page turns bending on), and the panel is not stuck under the
//  bar: it is the same silhouette, melted, so it hangs from it like a drop.

scene Vitreus {
    //  The palette (palette-live.plm). The logic sets these from the wallpaper (Iris); what is here is the stock look it starts from.
    fact pal_ink_r = 0.9608   // #f5f7f5
    fact pal_ink_g = 0.9686
    fact pal_ink_b = 0.9608
    fact pal_faint_r = 0.7608   // #c2c7cc
    fact pal_faint_g = 0.7804
    fact pal_faint_b = 0.8000
    fact pal_mint_r = 0.6196   // #9ed6bd
    fact pal_mint_g = 0.8392
    fact pal_mint_b = 0.7412
    fact pal_mintlo_r = 0.4235   // #6cbc9c
    fact pal_mintlo_g = 0.7373
    fact pal_mintlo_b = 0.6118
    fact pal_minthi_r = 0.8627   // #dcf8ec
    fact pal_minthi_g = 0.9725
    fact pal_minthi_b = 0.9255
    fact pal_onmint_r = 0.0627   // #10161a
    fact pal_onmint_g = 0.0863
    fact pal_onmint_b = 0.1020
    fact pal_tint_r = 0.1059   // #1b2127
    fact pal_tint_g = 0.1294
    fact pal_tint_b = 0.1529
    fact pal_panel_r = 0.0863   // #161a1f
    fact pal_panel_g = 0.1020
    fact pal_panel_b = 0.1216
    fact pal_deep_r = 0.0431   // #0b0e11
    fact pal_deep_g = 0.0549
    fact pal_deep_b = 0.0667
    fact pal_off_r = 0.2275   // #3a4048
    fact pal_off_g = 0.2510
    fact pal_off_b = 0.2824
    fact pal_alert_r = 0.9373   // #ef4444
    fact pal_alert_g = 0.2667
    fact pal_alert_b = 0.2667
    //  The wallpaper's own colours, whichever theme is chosen: the first card of Settings > Theme shows them (the logic sets them from Iris).
    fact wcol_tint_r = 0.1059
    fact wcol_tint_g = 0.1294
    fact wcol_tint_b = 0.1529
    fact wcol_panel_r = 0.0863
    fact wcol_panel_g = 0.1020
    fact wcol_panel_b = 0.1216
    fact wcol_ink_r = 0.9608
    fact wcol_ink_g = 0.9686
    fact wcol_ink_b = 0.9608
    fact wcol_mint_r = 0.6196
    fact wcol_mint_g = 0.8392
    fact wcol_mint_b = 0.7412
    fact wcol_alert_r = 0.9373
    fact wcol_alert_g = 0.2667
    fact wcol_alert_b = 0.2667
    let wcol.tint = rgb(wcol_tint_r, wcol_tint_g, wcol_tint_b)
    let wcol.panel = rgb(wcol_panel_r, wcol_panel_g, wcol_panel_b)
    let wcol.ink = rgb(wcol_ink_r, wcol_ink_g, wcol_ink_b)
    let wcol.mint = rgb(wcol_mint_r, wcol_mint_g, wcol_mint_b)
    let wcol.alert = rgb(wcol_alert_r, wcol_alert_g, wcol_alert_b)
    //  One copy per monitor always (`screens: each max N`, with N kept at the number of monitors plugged in by logic/bar_monitors.luau): what each
    //  copy holds of its own (the notches, the bar's hovers, the dock's place) is named per
    //  copy (`name.$screen`), which only a copy per monitor has. With the bar on one monitor, the other copies are closed (`open:`, see `sb`), or keep
    //  the frame and its notches (Settings > Bar, "Frame on the other monitors": `bar_others`).
    //  The keyboard is `on_demand`, not `exclusive`: it is asked for every open copy at once (the `while` is not per copy), and Hyprland gave it, and the
    //  pointer with it, to a copy where nothing was open: the cursor seemed stuck until the panel closed. A field that takes the focus (the launcher's
    //  search, the desk's inputs) still has it lent exclusively, to the copy it is on only. A loan ends only when this rule goes false, so the corner dock
    //  asks for the keyboard on an empty workspace while one of its icons is under the pointer or held (`cdk_hot`, `cdk_down`), not all the time:
    //  `cdk_on and ws_empty` held every loan on both copies, and the cursor stuck again.
    surface { size: full, full; anchor: bar_anchor; margin: 0; reserve: 62 while bar_anchor == top and not bar_frame and bar_size > 0.995; screens: each max 1; open: sb > 0.5 or bar_others; keyboard: on_demand while (panel != none and panel != volume and panel != notif) or wp_picker_open or ov_open or pk_open or desk_kb or (desk_open and ws_empty) or (((cdk_hot > 0.5 and cdk_ga > 0.5) or cdk_down > 0.5) and ws_empty) or dash_open or (axf_on and ax_open) }
    permissions { services: "files", "files.write", "auth", "clock", "clock.seconds", "thumbnails", "thumbnails.*", "audio", "audio.*", "window", "media", "media.*", "workspaces", "workspaces.focus", "brightness", "brightness.*", "battery", "network", "network.*", "bluetooth", "bluetooth.*", "apps", "tray", "tray.*", "notifications", "notifications.*"
                  run: "git", "env", "fc-list", "fc-match", "pleamar", "fuser", "ps", "pleamar-update", "cava", "playerctl", "curl", "notify-send", "which", "pgrep", "pkill", "systemctl", "hyprctl", "socat", "printenv", "awww", "iris", "cp", "ls", "xdg-user-dir", "mv", "niri", "magick", "grim", "mkdir", "bluetoothctl", "nmcli", "busctl", "chmod", "wl-copy", "find", "vitreus-term", "vitreus-themes", "claude", "ollama", "codex", "pacman", "paru", "yay", "gemini", "cliphist", "stat", "file", "vitreus-clipimg", "grep", "pactl", "sed", "setsid", "powerprofilesctl", "loginctl", "vitreus-polkit-agent", "vitreus-sysmon", "vitreus-addons", "vitreus-keep", "vitreus-inhibit", "pw-play", "ffmpeg", "tesseract", "cat", "date", "udevadm", "test", "wl-paste", "ffprobe" }

    model wifi_nets max 16 { ssid: text; strength: number; secure: bool; known: bool; active: bool; band: number; bands: text; bandw: number; chan: number; rate: number; sec: text; busy: number }
    model bat_devs max 6 { name: text; level: number }
    model bt_devices max 28 { name: text; address: text; paired: bool; connected: bool; battery: number; busy: number; hd: number; kind: number }

    service clock as now { time: text = "--:--"; date: text; hour: number }
    service clock.seconds as tick { second: number }       // the dashboard clock's ticks: it only runs while the scene reads it
    service audio { volume: number; muted: bool; input: number; input_muted: bool }
    service window as win { title: text; class: text }
    service media { playing: bool; title: text; artist: text; player: text; length: number }
    service brightness { present: bool; level: number }
    service battery as pwr { present: bool; percent: number; charging: bool }     // the bar is its gauge (see `batt_*`)
    fact demo = false               // Demo mode (touch ~/.config/vitreus/demo): a made-up battery at 69 % and the user named "user", for showing the shell off
    let bat_here = pwr.present or demo
    let bat_pct = if(demo, 69, pwr.percent)
    let bat_chg = if(demo, false, pwr.charging)
    service network as net { online: bool; wifi: bool; name: text; strength: number }     // the list itself is built by the logic
    service bluetooth as bt { present: bool; powered: bool }        // the list itself is built by the logic

    text clock12 = "--:--"
    text clock_h = ""              // the bar clock in three parts: the hour (oversized), the minutes (in the accent), am/pm
    text clock_mm = ""
    text clock_mn = ""             // the minutes alone, for the bar down the left
    text bar_ap = ""
    text bar_ap1 = ""              // the first letter of am/pm, for the badge by the hour down the left (the second is always an m)
    text bar_date = ""              // the short day stacked above the am/pm: MON
    text datelong = ""
    //  The clock card's pieces: the numerals, the am/pm tucked beside them, and the date as weekday | month day.
    text dsh_hh = ""                  // the dashboard's clock: the hour, and the minute's tens and ones
    text dsh_m1 = ""
    text dsh_m2 = ""
    text dsh_ap = ""                  // AM / PM beside it, when the system clock is a 12-hour one
    fact dsh_ap_on = false            // that label is showing: the reminders start after it
    measure dsh_hw
    text clock_hm = "--:--"
    text clock_ap = ""
    text date_wd = ""
    text date_md = ""
    measure hmw                    // how wide the big numerals are, to tuck the am/pm against them
    measure mdw                    // and the month and day, the date being right-aligned from them
    text arturl = ""               // the cover: a path to an image file, from the logic
    fact art_on = false            // is there one
    image art = from arturl, 200, 200
    event trackchange              // the logic says the song changed
    //  The calendar: 42 days in the grid (six weeks), what the logic says of each, and the
    //  chosen day's reminders. The logic keeps them in `calendar.json` and paints these.
    event pal_push ->              // the desktop clock opened and wants the palette (see push_pal in vitreus.luau)
    event cal_pick ->              // a day of the grid, by its place
    event cal_prev ->
    event cal_next ->
    event cal_today ->
    event cal_open ->              // the calendar panel just opened: back to today
    event cal_add ->               // the Add button (Enter in the field does the same)
    event cal_check ->             // a reminder of the chosen day, by its row: done / not done
    event cal_delete ->
    fact cal.sel = 0               // which place of the grid is chosen
    text cal.month = ""
    text cal.sel_title = ""
    text cal.sel_sub = ""
    text cal_new = ""              // what is being typed in the field
    model cal_events max 4 { time: text; title: text; done: bool }
    repeat k in 0..42 {
        fact cal.day.$k = 0
        fact cal.in.$k = false
        fact cal.today.$k = false
        fact cal.n.$k = 0
    }
    repeat w in 1..8 { text cal.wd.$w = "" }
    text outname = ""              // where the sound is going: the default output
    measure outw                   // how wide that name really is
    measure clsw                   // how wide the focused app's name really is
    measure lhw0                   // how wide the launcher's five hints are, to centre each in its cell
    measure lhw1
    measure lhw2
    measure lhw3
    measure lhw4
    measure lhw5
    measure lhw6
    measure lhw7
    measure lhw8
    measure lhw9
    measure titw                   // and its window title
    measure vclw                   // the same two, at the size they are drawn down the left bar
    measure vtiw
    measure chw                    // the bar clock's hour, minutes and am/pm: how wide each really is; the bar's
    measure cmw                    // buttons and the calendar's click area are placed from them
    measure caw
    measure cdw
    //  Which panel hangs from the bar: the clock and calendar (click the clock), or the
    //  controls (click the window title).
    fact panel_scr = 0              // which monitor's copy has the open panel (set by the press that opens it): the others draw none of it
    fact panel: none | calendar | controls | player | volume | notif | settings | launch | tray | desk = none
    fact media_on = false          // is there a player at all
    fact bass = 0
    fact fw_on = true      // the bottom frame rises into waves with the music (needs the Frame layout; `pleamar --say vitreus "fact fw_on false"` turns it off)
    //  The 24 bars cava reports, 0..1 each, for the equalizer in the media card. Each one
    //  has its own quick spring, so they rise and fall smoothly instead of stepping.
    spring spike = 520, 26        // the audio bars: a fast attack with a little overshoot, so a bass hit jumps and then settles
    //  (Written out one by one, not in a `repeat`: a `let` cannot read what a `repeat` declares, and the audio visualiser's columns, `fwh_*`, read these.)
    fact spec.0 = 0
    prop spec.s.0 = 0 ~spike
    follow spec.s.0 = spec.0
    fact spec.1 = 0
    prop spec.s.1 = 0 ~spike
    follow spec.s.1 = spec.1
    fact spec.2 = 0
    prop spec.s.2 = 0 ~spike
    follow spec.s.2 = spec.2
    fact spec.3 = 0
    prop spec.s.3 = 0 ~spike
    follow spec.s.3 = spec.3
    fact spec.4 = 0
    prop spec.s.4 = 0 ~spike
    follow spec.s.4 = spec.4
    fact spec.5 = 0
    prop spec.s.5 = 0 ~spike
    follow spec.s.5 = spec.5
    fact spec.6 = 0
    prop spec.s.6 = 0 ~spike
    follow spec.s.6 = spec.6
    fact spec.7 = 0
    prop spec.s.7 = 0 ~spike
    follow spec.s.7 = spec.7
    fact spec.8 = 0
    prop spec.s.8 = 0 ~spike
    follow spec.s.8 = spec.8
    fact spec.9 = 0
    prop spec.s.9 = 0 ~spike
    follow spec.s.9 = spec.9
    fact spec.10 = 0
    prop spec.s.10 = 0 ~spike
    follow spec.s.10 = spec.10
    fact spec.11 = 0
    prop spec.s.11 = 0 ~spike
    follow spec.s.11 = spec.11
    fact spec.12 = 0
    prop spec.s.12 = 0 ~spike
    follow spec.s.12 = spec.12
    fact spec.13 = 0
    prop spec.s.13 = 0 ~spike
    follow spec.s.13 = spec.13
    fact spec.14 = 0
    prop spec.s.14 = 0 ~spike
    follow spec.s.14 = spec.14
    fact spec.15 = 0
    prop spec.s.15 = 0 ~spike
    follow spec.s.15 = spec.15
    fact spec.16 = 0
    prop spec.s.16 = 0 ~spike
    follow spec.s.16 = spec.16
    fact spec.17 = 0
    prop spec.s.17 = 0 ~spike
    follow spec.s.17 = spec.17
    fact spec.18 = 0
    prop spec.s.18 = 0 ~spike
    follow spec.s.18 = spec.18
    fact spec.19 = 0
    prop spec.s.19 = 0 ~spike
    follow spec.s.19 = spec.19
    fact spec.20 = 0
    prop spec.s.20 = 0 ~spike
    follow spec.s.20 = spec.20
    fact spec.21 = 0
    prop spec.s.21 = 0 ~spike
    follow spec.s.21 = spec.21
    fact spec.22 = 0
    prop spec.s.22 = 0 ~spike
    follow spec.s.22 = spec.22
    fact spec.23 = 0
    prop spec.s.23 = 0 ~spike
    follow spec.s.23 = spec.23
                  // 0..1, from cava: how hard the low end is hitting
    model outlist max 6 { name: text; current: bool }   // every place the sound can go
    //  The mixer under the volume slider (right-click it): one row per app that is playing sound.
    model mixer max 6 { name: text; pct: number; muted: bool; corked: bool; icon: image 27, 27 }
    event mix_set ->                // a row's slider: the row times 4, plus 0..1 along its track (one number)
    event mix_mute ->               // a row's speaker
    //  The running windows (asked of Hyprland by the logic: the window service has no list there) and
    //  the apps that live in the tray, for the panel that hangs from the window title. Icons are named
    //  by the logic, which matches each window's class to an app.
    model tasks max 12 { title: text; ws: text; active: bool; icon: image 30, 30 }
    fact tasks_watch = false       // the panel is open: keep the list fresh
    model trays max 16 { title: text; icon: image 30, 30; pinned: bool; menu: bool }
    model bartrays max 8 { icon: image 36, 36 }          // the tray apps that ride the bar
    model cdk_pins max 8 { icon: image 32, 32 }          // the corner dock's pinned apps (logic/dock.luau)
    fact cdk_on = true                                   // the corner dock is shown
    fact cdk_corner = 0                                  // which of the two corners opposite the bar it is in (kept in dock-pins.json)
    fact cdk_down = 0                                    // an icon or the pill is pressed
    fact cdk_hot = 0                                     // the pointer is on an icon (the surface asks for the keyboard on an empty workspace)
    fact cdk_drag = 0                                    // ...and has been pulled far enough to be a drag, not a click
    fact cdk_px = 0                                      // where the pill's middle is being taken to, on the screen
    fact cdk_py = 0
    fact cdk_hx = 0                                      // where in the pill it was taken hold of
    fact cdk_hy = 0
    //  The add-on pill: the corner dock's twin, in the other corner, with an icon for each add-on that gave one (logic/addons.luau). It is pulled like the dock, and the
    //  two swap corners as soon as the one pulled crosses the middle of the screen. Its corner is always the one the dock is not in, so there is no setting of its own.
    model adk_pins max 12 { icon: image 32, 32; name: text }
    fact adk_down = 0
    fact adk_hot = 0
    fact adk_drag = 0
    fact adk_px = 0
    fact adk_py = 0
    fact adk_hx = 0
    fact adk_hy = 0
    event adk_go ->                 // an add-on's icon, by place: a click (let go without having been pulled)
    //  One entry of a tray app's menu, flattened: an open submenu is followed by its own entries, `depth` deeper.
    model tray_menu max 40 { label: text; enabled: bool; sep: bool; checked: bool; kids: bool; open: bool; depth: number }
    //  The tray menu panel (it hangs from the window title, like the player's) is about one app.
    text tm_title = ""
    text tm_sub = ""
    text tm_iconurl = ""
    image tm_icon = from tm_iconurl, 44, 44
    fact tm_pinned = false
    fact tm_has_menu = false
    fact tm_h = 0                       // how tall the menu's rows are, unscaled
    fact tray_only_pinned = false       // the bar shows only the pinned apps
    fact dm_mode: dmm_player | dmm_tray = dmm_player      // what the window-title panel holds
    event tray_pin ->
    event tray_menu_open ->
    event bar_tray_click ->
    event bar_tray_menu ->
    event cdk_go ->                 // a pinned app, by place: a click (let go without having been pulled) starts it,
    event cdk_unpin ->              // and a right click lets it go
    event launch_ctx ->             // a right click on an app's row: pin it to a corner dock, or let it go
    event tray_menu_pick ->
    event tm_pin ->
    event tm_open ->
    event tm_alt ->
    event tray_mode ->
    //  The two transient panels (volume, and a notification arriving) share one drawer. `osd_kind` is
    //  which one it draws; unlike `panel` it stays put while the drawer closes, so it fades out
    //  showing what it was showing.
    fact osd_kind: vol | note | shot = vol
    fact nt_size = 1                 // how big a notification's drawer is (Settings > Notifications, "Size": 0.7, 0.85 or 1; logic/notif_size.luau)
    event nt_size_set ->             // its chips: 0 small, 1 medium, 2 large
    fact osd_on = false                                     // the volume / notification drawer is out: set by the logic; it is not a value of `panel`, so it shows beside Settings, the search, the desk...
    //  The volume drawer holds up to two rows, one above the other: the volume and the brightness, each out for two seconds after it changes (the logic's
    //  timers). With both, the drawer is as tall as both, so neither covers the other.
    fact osd_v = false
    fact osd_b = false
    prop osd_vp = 0 ~calm
    prop osd_bp = 0 ~calm
    fact bright_now = 0                 // the brightness the row shows: from the keys at once (`bright_key`), or from the brightness service
    prop bright_osd = 0 ~quick
    follow bright_osd = bright_now
    event bright_key ->                 // a brightness key: the new level, 0 to 1
    follow osd_vp = if(osd_v, 1, 0)
    follow osd_bp = if(osd_b, 1, 0)
    //  The privacy lights (logic/privacy.luau; the screen's from Hyprland's events in vitreus.luau).
    fact priv_mic = false
    fact priv_cam = false
    fact priv_scr = false
    text priv_mic_who = ""
    text priv_cam_who = ""
    text priv_scr_who = ""
    fact osd_m = false                  // the microphone's row: out for two seconds after it is muted or unmuted, under the other two
    prop osd_mp = 0 ~calm
    follow osd_mp = if(osd_m, 1, 0)
    event mic_toggle ->                 // the microphone button in the controls' volume card
    text nt_app = ""
    text nt_title = ""
    text nt_body = ""
    measure ntt                    // how tall the notification's title really is once wrapped
    measure ntb                    // and its body
    text nt_iconpath = ""          // the app's icon, or the picture it brought: a name or a path
    image nt_img = from nt_iconpath, 59, 59       // drawn at 44 * u = 59: declared at that, or it is made at 44 and stretched (soft, with a jagged edge)
    fact nt_icon_on = false
    fact nt_body_on = false
    fact nt_urgent = false
    model nt_acts max 3 { label: text }
    event ntnew                    // a notification just arrived: ripple the tile
    event nt_close ->              // its cross, or a press on the plate
    //  A screenshot just taken, as a card in the same drawer (logic: `shot_done`): its picture, its name, and what can be done with it. The text buttons
    //  need tesseract (`shot_ocr`).
    text shot_path = ""
    text shot_imgpath = ""
    text shot_name = ""
    image shot_img = from shot_imgpath, 394, 222               // drawn at 292 * u = 394 by 164 * u = 222
    fact shot_ocr = false
    event shot_done ->
    event shot_act ->                // one of its buttons: 0 open, 1 copy the text, 2 ask about the text, 3 delete
    event shot_close ->
    event nt_act ->                // one of its buttons, by position
    //  Settings: a panel of pages, the wallpaper picker first. The logic lists the folder and keeps one
    //  page of sixteen thumbnails at a time (the folder can hold hundreds of full-size images).
    model wps max 16 { thumb: image 260, 146 }
    fact wp_sel = -1                // which thumbnail of this page is the wallpaper in use, or -1
    text wp_curpath = ""            // the wallpaper in use: a path
    image wp_cur = from wp_curpath, 320, 180
    text wp_name = ""
    text wp_dirtext = ""
    fact wpd_open = false           // the folder browser on the wallpaper page (the dashboard picture's, with "Use this folder")
    prop wpd_k = 0 ~calm
    follow wpd_k = if(wpd_open, 1, 0)
    text wp_pager = ""
    event wp_pick ->                // a thumbnail, by position on the page
    event wp_prev ->
    event wp_dir_browse ->          // the folder button: look at the current folder
    event wp_dir_choose ->          // "Use this folder"
    event wp_dir_default ->         // "Default": back to ~/Pictures/Wallpapers
    event wp_next ->
    event wp_random ->
    //  The colour filter (twelve swatches; the lit one is `wp_filter`, -1 for none) and the slideshow.
    fact wp_filter = -1
    //  The glass of the bar and every drawer: how much of the glass effect it has (tint, edge light, and the blur
    //  the compositor puts behind it), and how opaque it is. Set from the Glass page of the settings.
    fact glass_op = 1
    text glass_op_text = "100%"
    //  The rest of the Glass page: the edge light (a multiplier, 0 to 2), and, only while the glass bends what is behind
    //  it (`glass_bend`), how thick it is (0 to 2) and the rainbow at its edge (0 to 2.5). The blur is Hyprland's (`hy_blur`).
    fact glass_rim = 1
    fact glass_refr = 1
    fact glass_disp = 1
    fact glass_dome = 0              // pleamar's `dome:` (magnifies what is behind, towards the middle), 0 to 150 %: a test knob
    fact glass_milk = 0              // pleamar's `milk:` (a milky veil inside the glass), 0 to 100 %: a test knob
    fact glass_bend = false           // the lens is on: X-Bend or Live bend (either one; the switches' own states are `glass_x` and `glass_live`)
    fact glass_x = false              // the Glass page's "X-Bend" switch: the glass bends the wallpaper copy
    fact glass_live = false           // the Glass page's "Live bend": the glass bends the live windows (a capture) instead of the wallpaper copy
    //  Which monitors bend (the Glass page's "Bend on"): `glass_b0` to `glass_b3` by copy number, all true while no monitor is picked (vitreus.luau). `glass_bm.i` lights the page's tile i.
    fact glass_b0 = true
    fact glass_b1 = true
    fact glass_b2 = true
    fact glass_b3 = true
    repeat i in 0..4 {
        fact glass_bm.$i = false
    }
    event glass_bend_mon ->
    fact glass_clear = 1             // pleamar's `frost:` (0.2.35): 0 clear glass, 1 frosted inside the bevel; only the glass that bends has it
    fact glass_auto = false          // `frost: auto`: frosted only where what is behind is busy
    text glass_clear_text = "100%"
    event glass_clear_set ->
    event glass_auto_toggle ->
    //  Glass switched off (`glass_obs`): the same bar and drawers, but a flat, solid obsidian instead of glass. `obs` is 0 glass, 1 obsidian, and travels between them.
    fact glass_obs = false
    prop obs = 0 ~calm
    follow obs = if(glass_obs or cas or uwu or milk, 1, 0)
    //  The Cassette theme (Settings > Theme): the same flat body as obsidian, but in the palette's own plastic (`obsidian` below stops being darkened), with a hard
    //  edge, a lit lip, a seam, a four-colour stripe across each drawer's head and a hard shadow. `cas_k` travels between glass and plastic; the drawers' liquid
    //  (necks, drips, the jelly) is switched off with it and their corners are cut square (`rc`, `bk`).
    fact cas = false
    prop cas_k = 0 ~calm
    follow cas_k = if(cas, 1, 0)
    //  The UwU theme: the same plastic body (an opaque candy-coloured one, with a thick grape outline and a hard pink shadow) but with the liquid left on
    //  (round corners, necks and jelly), and the cute things drawn on every drawer (see bar_glass.plm). `pk` is how much of the body is plastic, of either.
    fact uwu = false
    prop uwu_k = 0 ~calm
    follow uwu_k = if(uwu, 1, 0)
    //  The Milk theme: one soft pale material, no outlines; each drawer is pushed out of the surface by a light shadow on its top left and a dark one on its bottom right
    //  (see bar_glass.plm). The same opaque body as the plastics, with the liquid left on. `milk_k` travels between glass and Milk.
    fact milk = false
    prop milk_k = 0 ~calm
    follow milk_k = if(milk, 1, 0)
    let pk = max(max(cas_k, uwu_k), milk_k)
    //  The Cyber theme: a neon HUD. The glass stays glass (the palette makes it near-black); on top of it each drawer gets a hairline neon outline, corner brackets and
    //  scan ticks (see bar_glass.plm). `cy_k` travels between glass and Cyber. `deep` is its second neon.
    fact cyber_on = false
    let cy_dark = 1.0                  // how far Cyber takes the glass's tint towards black (0 none, 1 black); the glass stays as see-through as it was
    prop cy_k = 0 ~calm
    follow cy_k = if(cyber_on, 1, 0)
    //  How square the corners are: Retro's plastic and Cyber's HUD both take the drawers' rounding down by the same 73 % (`corner: R * (1 - 0.73 * sq)`).
    let sq = max(cas_k, cy_k)
    event glass_obs_toggle ->
    let obsidian = mix(tint, #000000, 0.7 * (1 - pk))      // the theme's own tint, taken most of the way to black (the plastic's own colour on the Cassette): static themes and Iris both change it
    fact hy_blur = 3
    prop glass_bend_k = 0 ~quick
    follow glass_bend_k = if(glass_bend, 1, 0)
    prop glass_live_k = 0 ~quick     // Live bend on: it decides what is bent, so the X-Bend row greys
    follow glass_live_k = if(glass_live, 1, 0)
    text glass_rim_text = "100%"
    text glass_refr_text = "100%"
    text glass_disp_text = "100%"
    text glass_dome_text = "0%"
    text glass_milk_text = "0%"
    text hy_blur_text = "3"
