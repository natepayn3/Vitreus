    //  The music special workspace's mark: a pair of eighth notes joined by a beam, in pencil like PBSpark.
    component PBNote(cx: number, cy: number, k: number, o: number) {
        let fr = floor(time * 5)
        let jt = 0.4 * u
        path { at: cx, cy; stroke: 1.5 * u; color: mint; opacity: o; move -0.4 * k + jt * sin(fr * 67 + 41037), 0.45 * k + jt * sin(fr * 54 + 41074); line -0.4 * k + jt * sin(fr * 73 + 41111), -0.75 * k + jt * sin(fr * 62 + 41148); }
        path { at: cx + 0.5 * u, cy + 0.4 * u; stroke: 0.7 * (1.5 * u); color: mint; opacity: o * 0.34; move -0.4 * k + jt * sin(fr * 52 + 41185), 0.45 * k + jt * sin(fr * 69 + 41222); line -0.4 * k + jt * sin(fr * 59 + 41259), -0.75 * k + jt * sin(fr * 47 + 41296); }
        path { at: cx, cy; stroke: 1.5 * u; color: mint; opacity: o; move 0.6 * k + jt * sin(fr * 67 + 41333), 0.25 * k + jt * sin(fr * 54 + 41370); line 0.6 * k + jt * sin(fr * 73 + 41407), -0.95 * k + jt * sin(fr * 62 + 41444); }
        path { at: cx + 0.5 * u, cy + 0.4 * u; stroke: 0.7 * (1.5 * u); color: mint; opacity: o * 0.34; move 0.6 * k + jt * sin(fr * 52 + 41481), 0.25 * k + jt * sin(fr * 69 + 41518); line 0.6 * k + jt * sin(fr * 59 + 41555), -0.95 * k + jt * sin(fr * 47 + 41592); }
        path { at: cx, cy; stroke: 2.2 * u; color: mint; opacity: o; move -0.4 * k + jt * sin(fr * 67 + 41629), -0.75 * k + jt * sin(fr * 54 + 41666); line 0.6 * k + jt * sin(fr * 73 + 41703), -0.95 * k + jt * sin(fr * 62 + 41740); }
        path { at: cx + 0.5 * u, cy + 0.4 * u; stroke: 0.7 * (2.2 * u); color: mint; opacity: o * 0.34; move -0.4 * k + jt * sin(fr * 52 + 41777), -0.75 * k + jt * sin(fr * 69 + 41814); line 0.6 * k + jt * sin(fr * 59 + 41851), -0.95 * k + jt * sin(fr * 47 + 41888); }
        ellipse { at: cx + -0.65 * k + jt * sin(fr * 67 + 41925), cy + 0.55 * k + jt * sin(fr * 54 + 41962); radius: 0.3 * k; color: mint; opacity: o  }
        ellipse { at: cx + -0.65 * k + jt * sin(fr * 73 + 41999) + 0.5 * u, cy + 0.55 * k + jt * sin(fr * 62 + 42036) + 0.4 * u; radius: 0.3 * k; color: mint; opacity: o * 0.34 }
        ellipse { at: cx + 0.35 * k + jt * sin(fr * 52 + 42073), cy + 0.35 * k + jt * sin(fr * 69 + 42110); radius: 0.3 * k; color: mint; opacity: o  }
        ellipse { at: cx + 0.35 * k + jt * sin(fr * 59 + 42147) + 0.5 * u, cy + 0.35 * k + jt * sin(fr * 47 + 42184) + 0.4 * u; radius: 0.3 * k; color: mint; opacity: o * 0.34 }
    }

    //  The private special workspace's mark: an eye crossed out, in pencil like PBSpark.
    component PBHide(cx: number, cy: number, k: number, o: number) {
        let fr = floor(time * 5)
        let jt = 0.4 * u
        path { at: cx, cy; stroke: 1.5 * u; color: mint; opacity: o; move -1 * k + jt * sin(fr * 67 + 42221), 0 * k + jt * sin(fr * 54 + 42258); curve 1 * k + jt * sin(fr * 73 + 42295), 0 * k + jt * sin(fr * 62 + 42332) via 0 * k + jt * sin(fr * 52 + 42369), -1.15 * k + jt * sin(fr * 69 + 42406); curve -1 * k + jt * sin(fr * 59 + 42443), 0 * k + jt * sin(fr * 47 + 42480) via 0 * k + jt * sin(fr * 67 + 42517), 1.15 * k + jt * sin(fr * 54 + 42554); close }
        path { at: cx + 0.5 * u, cy + 0.4 * u; stroke: 0.7 * (1.5 * u); color: mint; opacity: o * 0.34; move -1 * k + jt * sin(fr * 73 + 42591), 0 * k + jt * sin(fr * 62 + 42628); curve 1 * k + jt * sin(fr * 52 + 42665), 0 * k + jt * sin(fr * 69 + 42702) via 0 * k + jt * sin(fr * 59 + 42739), -1.15 * k + jt * sin(fr * 47 + 42776); curve -1 * k + jt * sin(fr * 67 + 42813), 0 * k + jt * sin(fr * 54 + 42850) via 0 * k + jt * sin(fr * 73 + 42887), 1.15 * k + jt * sin(fr * 62 + 42924); close }
        path { at: cx, cy; stroke: 1.8 * u; color: mint; opacity: o; move -0.75 * k + jt * sin(fr * 52 + 42961), 0.85 * k + jt * sin(fr * 69 + 42998); line 0.75 * k + jt * sin(fr * 59 + 43035), -0.85 * k + jt * sin(fr * 47 + 43072); }
        path { at: cx + 0.5 * u, cy + 0.4 * u; stroke: 0.7 * (1.8 * u); color: mint; opacity: o * 0.34; move -0.75 * k + jt * sin(fr * 67 + 43109), 0.85 * k + jt * sin(fr * 54 + 43146); line 0.75 * k + jt * sin(fr * 73 + 43183), -0.85 * k + jt * sin(fr * 62 + 43220); }
        ellipse { at: cx + 0 * k + jt * sin(fr * 52 + 43257), cy + 0 * k + jt * sin(fr * 69 + 43294); radius: 0.24 * k; color: mint; opacity: o  }
        ellipse { at: cx + 0 * k + jt * sin(fr * 59 + 43331) + 0.5 * u, cy + 0 * k + jt * sin(fr * 47 + 43368) + 0.4 * u; radius: 0.24 * k; color: mint; opacity: o * 0.34 }
    }

    component PBPrev(cx: number, cy: number, hot: number, k: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let jt = (0.1 + 0.3 * a) * k
        path { at: cx, cy; stroke: 1.4 * k; color: ink; opacity: (o); move -2 * k + jt * sin(fr * 64 + 23850), -3.5 * k + jt * sin(fr * 69 + 23910); line -2 * k + jt * sin(fr * 71 + 23947), 3.5 * k + jt * sin(fr * 45 + 24007); }
        path { at: cx + 0.5 * k, cy + 0.4 * k; stroke: 0.98 * k; color: ink; opacity: (o) * 0.34; move -2 * k + jt * sin(fr * 48 + 24221), -3.5 * k + jt * sin(fr * 53 + 24281); line -2 * k + jt * sin(fr * 55 + 24318), 3.5 * k + jt * sin(fr * 60 + 24378); }
        path { at: cx, cy; color: ink; opacity: (0.4 * (o)); move 4.5 * k + jt * sin(fr * 55 + 23956), -3.5 * k + jt * sin(fr * 60 + 24016); line -1 * k + jt * sin(fr * 62 + 24053), 0 * k + jt * sin(fr * 67 + 24113); line 4.5 * k + jt * sin(fr * 69 + 24150), 3.5 * k + jt * sin(fr * 43 + 24210); close }
        path { at: cx, cy; stroke: 1.3 * k; color: ink; opacity: (o); move 4.5 * k + jt * sin(fr * 66 + 24009), -3.5 * k + jt * sin(fr * 71 + 24069); line -1 * k + jt * sin(fr * 73 + 24106), 0 * k + jt * sin(fr * 47 + 24166); line 4.5 * k + jt * sin(fr * 49 + 24203), 3.5 * k + jt * sin(fr * 54 + 24263); close }
        path { at: cx + 0.5 * k, cy + 0.4 * k; stroke: 0.91 * k; color: ink; opacity: (o) * 0.34; move 4.5 * k + jt * sin(fr * 50 + 24380), -3.5 * k + jt * sin(fr * 55 + 24440); line -1 * k + jt * sin(fr * 57 + 24477), 0 * k + jt * sin(fr * 62 + 24537); line 4.5 * k + jt * sin(fr * 64 + 24574), 3.5 * k + jt * sin(fr * 69 + 24634); close }
    }

    component PBNext(cx: number, cy: number, hot: number, k: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let jt = (0.1 + 0.3 * a) * k
        path { at: cx, cy; color: ink; opacity: (0.4 * (o)); move -4.5 * k + jt * sin(fr * 50 + 24380), -3.5 * k + jt * sin(fr * 55 + 24440); line 1 * k + jt * sin(fr * 57 + 24477), 0 * k + jt * sin(fr * 62 + 24537); line -4.5 * k + jt * sin(fr * 64 + 24574), 3.5 * k + jt * sin(fr * 69 + 24634); close }
        path { at: cx, cy; stroke: 1.3 * k; color: ink; opacity: (o); move -4.5 * k + jt * sin(fr * 61 + 24433), -3.5 * k + jt * sin(fr * 66 + 24493); line 1 * k + jt * sin(fr * 68 + 24530), 0 * k + jt * sin(fr * 73 + 24590); line -4.5 * k + jt * sin(fr * 44 + 24627), 3.5 * k + jt * sin(fr * 49 + 24687); close }
        path { at: cx + 0.5 * k, cy + 0.4 * k; stroke: 0.91 * k; color: ink; opacity: (o) * 0.34; move -4.5 * k + jt * sin(fr * 45 + 24804), -3.5 * k + jt * sin(fr * 50 + 24864); line 1 * k + jt * sin(fr * 52 + 24901), 0 * k + jt * sin(fr * 57 + 24961); line -4.5 * k + jt * sin(fr * 59 + 24998), 3.5 * k + jt * sin(fr * 64 + 25058); close }
        path { at: cx, cy; stroke: 1.4 * k; color: ink; opacity: (o); move 2 * k + jt * sin(fr * 72 + 24486), -3.5 * k + jt * sin(fr * 46 + 24546); line 2 * k + jt * sin(fr * 48 + 24583), 3.5 * k + jt * sin(fr * 53 + 24643); }
        path { at: cx + 0.5 * k, cy + 0.4 * k; stroke: 0.98 * k; color: ink; opacity: (o) * 0.34; move 2 * k + jt * sin(fr * 56 + 24857), -3.5 * k + jt * sin(fr * 61 + 24917); line 2 * k + jt * sin(fr * 63 + 24954), 3.5 * k + jt * sin(fr * 68 + 25014); }
    }

    component PBPlay(cx: number, cy: number, hot: number, k: number, o: number, pl: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let jt = (0.1 + 0.3 * a) * k
        path { at: cx, cy; stroke: 2.2 * k; color: ink; opacity: (o) * pl; move -3 * k + jt * sin(fr * 67 + 24910), -4.5 * k + jt * sin(fr * 72 + 24970); line -3 * k + jt * sin(fr * 43 + 25007), 4.5 * k + jt * sin(fr * 48 + 25067); }
        path { at: cx + 0.5 * k, cy + 0.4 * k; stroke: 1.54 * k; color: ink; opacity: (o) * pl * 0.34; move -3 * k + jt * sin(fr * 51 + 25281), -4.5 * k + jt * sin(fr * 56 + 25341); line -3 * k + jt * sin(fr * 58 + 25378), 4.5 * k + jt * sin(fr * 63 + 25438); }
        path { at: cx, cy; stroke: 2.2 * k; color: ink; opacity: (o) * pl; move 3 * k + jt * sin(fr * 47 + 24963), -4.5 * k + jt * sin(fr * 52 + 25023); line 3 * k + jt * sin(fr * 54 + 25060), 4.5 * k + jt * sin(fr * 59 + 25120); }
        path { at: cx + 0.5 * k, cy + 0.4 * k; stroke: 1.54 * k; color: ink; opacity: (o) * pl * 0.34; move 3 * k + jt * sin(fr * 62 + 25334), -4.5 * k + jt * sin(fr * 67 + 25394); line 3 * k + jt * sin(fr * 69 + 25431), 4.5 * k + jt * sin(fr * 43 + 25491); }
        path { at: cx, cy; color: ink; opacity: (1 - pl) * (0.4 * (o)); move -3 * k + jt * sin(fr * 58 + 25016), -4.5 * k + jt * sin(fr * 63 + 25076); line 7 * k + jt * sin(fr * 65 + 25113), 0 * k + jt * sin(fr * 70 + 25173); line -3 * k + jt * sin(fr * 72 + 25210), 4.5 * k + jt * sin(fr * 46 + 25270); close }
        path { at: cx, cy; stroke: 1.3 * k; color: ink; opacity: (1 - pl) * (o); move -3 * k + jt * sin(fr * 69 + 25069), -4.5 * k + jt * sin(fr * 43 + 25129); line 7 * k + jt * sin(fr * 45 + 25166), 0 * k + jt * sin(fr * 50 + 25226); line -3 * k + jt * sin(fr * 52 + 25263), 4.5 * k + jt * sin(fr * 57 + 25323); close }
        path { at: cx + 0.5 * k, cy + 0.4 * k; stroke: 0.91 * k; color: ink; opacity: (1 - pl) * (o) * 0.34; move -3 * k + jt * sin(fr * 53 + 25440), -4.5 * k + jt * sin(fr * 58 + 25500); line 7 * k + jt * sin(fr * 60 + 25537), 0 * k + jt * sin(fr * 65 + 25597); line -3 * k + jt * sin(fr * 67 + 25634), 4.5 * k + jt * sin(fr * 72 + 25694); close }
    }

    //  The controls drawer's icons, drawn in pencil like the gear's, Search's and the notification banner's bell. Each line is drawn twice, the second time fainter, thinner and a hair
    //  off, and every point of it sits a little crooked. `hot` (0 to 1: it is on, or the pointer is over it) makes the icon swell and the lines redraw about five times a second
    //  (`fr`, which stays 0 while it is cold, so a cold icon is still). `cx`, `cy` is the icon's own middle (the slider ones, their origin); the rest is what the icon says.
    //  Signal bars in the bell's manner: each bar twice in pencil with a rounded top, a wash of the accent inside and a shading stroke on its left. `o1` to `o3` are how
    //  much of each bar is lit.
    component PWifi(cx: number, cy: number, hot: number, o1: number, o2: number, o3: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let kw = 0.8 * cu
        group {
            pivot: cx, cy
            scale: 1 + 0.10 * a
            repeat br in 0..3 {
                let bx = (br - 1) * 6.5 * kw
                let bt = (1 - br * 5.5) * kw                      // its top: 1, -4.5, -10
                let bo1 = if(br == 0, o1, if(br == 1, o2, o3))
                repeat bp in 0..2 {
                    let bo = bp * 0.7 * kw
                    let bj = (0.18 + 0.25 * a) * cu * sin(fr * 53 + bp * 137 + br * 29)
                    let bk = (0.18 + 0.25 * a) * cu * sin(fr * 61 + bp * 71 + br * 43 + 40)
                    path { at: cx + bx + bo, cy + 3 * kw + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kw; color: ink; opacity: if(bp == 0, 90%, 34%) * bo1
                           move -2.4 * kw + bj, 6 * kw + bk
                           line -2.4 * kw + bk, bt + 2 * kw + bj
                           curve 2.4 * kw + bj, bt + 2 * kw + bk via 0, bt - 1.6 * kw + bj
                           line 2.4 * kw + bk, 6 * kw + bj
                           close }
                }
                path { at: cx + bx, cy + 3 * kw; color: mint; opacity: 35% * bo1; move -2.4 * kw, 6 * kw; line -2.4 * kw, bt + 2 * kw; curve 2.4 * kw, bt + 2 * kw via 0, bt - 1.6 * kw; line 2.4 * kw, 6 * kw; close }
                line { from: cx + bx - 0.9 * kw, cy + 3 * kw + bt + 3.5 * kw + 0.3 * cu * sin(fr * 47 + br * 60); to: cx + bx - 0.9 * kw, cy + 3 * kw + 4.5 * kw + 0.3 * cu * sin(fr * 53 + br * 70); width: 1.0 * kw; color: mint; opacity: 65% * bo1 }
            }
        }
    }

    //  The Bluetooth rune in the bell's manner: the rune twice in pencil inside a ring with an accent wash, and two shading strokes on the left.
    component PBt(cx: number, cy: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let kt = 0.8 * cu
        group {
            pivot: cx, cy
            scale: 1 + 0.10 * a
            ellipse { at: cx, cy; radius: 11.5 * kt; color: mint; opacity: 22% * o }
            ellipse { at: cx + 0.3 * cu * sin(fr * 49), cy + 0.3 * cu * sin(fr * 57); radius: 11.5 * kt; stroke: 1.6 * kt; color: ink; opacity: 85% * o }
            ellipse { at: cx + 0.7 * kt, cy + 0.5 * kt; radius: 11.5 * kt; stroke: 1.2 * kt; color: ink; opacity: 30% * o }
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kt
                let bj = (0.18 + 0.25 * a) * cu * sin(fr * 53 + bp * 137 + 17)
                let bk = (0.18 + 0.25 * a) * cu * sin(fr * 61 + bp * 71 + 57)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kt; color: ink; opacity: if(bp == 0, 90%, 34%) * o
                       move -4.5 * kt + bj, -4.5 * kt + bk
                       line 4.5 * kt + bk, 4.5 * kt + bj
                       line 0 + bj, 9 * kt + bk
                       line 0 + bk, -9 * kt + bj
                       line 4.5 * kt + bj, -4.5 * kt + bk
                       line -4.5 * kt + bk, 4.5 * kt + bj }
            }
            repeat bc in 0..2 {
                line { from: cx - 9.5 * kt + bc * 1.5 * kt, cy - 3 * kt + bc * 1.5 * kt + 0.3 * cu * sin(fr * 47 + bc * 60); to: cx - 9 * kt + bc * 1.5 * kt, cy + 3 * kt + 0.3 * cu * sin(fr * 53 + bc * 70); width: 1.0 * kt; color: mint; opacity: 65% * o }
            }
        }
    }

    component PBell(cx: number, cy: number, hot: number, o: number, slo: number, wob: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let kbell = 0.8 * cu                                  // the notification banner's bell (osd_drawer.plm), scaled to this tile
        group {
            pivot: cx, cy
            scale: 1 + 0.10 * a
            group {
                pivot: cx, cy - 11 * kbell
                rotate: wob * 14deg
                //  The body, a flared dome: two turns of the pencil, the second fainter and a little off.
                repeat bp in 0..2 {
                    let bo = bp * 0.7 * kbell
                    let bj = (0.18 + 0.25 * a) * cu * sin(fr * 53 + bp * 137)
                    let bk = (0.18 + 0.25 * a) * cu * sin(fr * 61 + bp * 71 + 40)
                    path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kbell; color: ink; opacity: if(bp == 0, 90%, 34%) * o
                           move -10 * kbell + bj, 6 * kbell + bk
                           curve -5.5 * kbell + bk, -6 * kbell + bj via -6.5 * kbell, 2 * kbell
                           curve 5.5 * kbell + bj, -6 * kbell + bk via 0, -15 * kbell + bj
                           curve 10 * kbell + bk, 6 * kbell + bj via 6.5 * kbell, 2 * kbell
                           line -10 * kbell + bj, 6 * kbell + bk }
                }
                //  A wash in the accent inside it.
                path { at: cx, cy; color: mint; opacity: 30% * o; move -10 * kbell, 6 * kbell; curve -5.5 * kbell, -6 * kbell via -6.5 * kbell, 2 * kbell; curve 5.5 * kbell, -6 * kbell via 0, -15 * kbell; curve 10 * kbell, 6 * kbell via 6.5 * kbell, 2 * kbell; close }
                //  The knob on top, and the shading: two short strokes on the left of the dome.
                ellipse { at: cx + 0.3 * cu * sin(fr * 67), cy - 12.3 * kbell; radius: 1.5 * kbell; color: ink; opacity: o }
                repeat bc in 0..2 {
                    line { from: cx - 6 * kbell + bc * 2 * kbell, cy - 3 * kbell + bc * 1.5 * kbell + 0.3 * cu * sin(fr * 47 + bc * 60); to: cx - 5 * kbell + bc * 2 * kbell, cy + 2 * kbell + 0.3 * cu * sin(fr * 53 + bc * 70); width: 1.1 * kbell; color: mint; opacity: 65% * o }
                }
                //  The clapper.
                ellipse { at: cx + 0.3 * cu * sin(fr * 59), cy + 10 * kbell; radius: 2.2 * kbell; color: mint; opacity: o }
            }
            //  Struck through while Do Not Disturb is on.
            path { at: cx, cy; stroke: 1.5 * cu; color: alert; opacity: (slo); move -8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 47 + 1961), -8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 52 + 2021); line 8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 54 + 2058), 8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 59 + 2118); }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: alert; opacity: (slo) * 0.28; move -8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 62 + 2332), -8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 67 + 2392); line 8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 69 + 2429), 8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 74 + 2489); }
        }
    }

    //  The coffee mug, in the bell's manner: the body twice in pencil, the coffee's surface and a wash of the accent, a handle, shading strokes and a saucer.
    component PCup(cx: number, cy: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let kc = 0.8 * cu
        group {
            pivot: cx, cy
            scale: 1 + 0.10 * a
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kc
                let bj = (0.18 + 0.25 * a) * cu * sin(fr * 53 + bp * 137 + 11)
                let bk = (0.18 + 0.25 * a) * cu * sin(fr * 61 + bp * 71 + 51)
                //  The mug.
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kc; color: ink; opacity: if(bp == 0, 90%, 34%) * o
                       move -9 * kc + bj, -6 * kc + bk
                       line -8 * kc + bk, 3 * kc + bj
                       curve -4 * kc + bj, 7 * kc + bk via -7.5 * kc, 6.5 * kc
                       line 3 * kc + bk, 7 * kc + bj
                       curve 7 * kc + bj, 3 * kc + bk via 7.5 * kc, 6.5 * kc
                       line 8 * kc + bk, -6 * kc + bj }
                //  The handle.
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kc; color: ink; opacity: if(bp == 0, 90%, 34%) * o
                       move 8 * kc + bj, -3.5 * kc + bk
                       curve 8 * kc + bk, 2.5 * kc + bj via 14 * kc, -3.5 * kc
                       }
                //  The saucer.
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.5, 1.1) * kc; color: ink; opacity: if(bp == 0, 80%, 30%) * o
                       move -11.5 * kc + bk, 10 * kc + bj
                       line 10.5 * kc + bj, 10 * kc + bk }
            }
            //  The rim: a flat lens, with the coffee's surface in the accent.
            path { at: cx, cy; color: mint; opacity: 55% * o; move -9 * kc, -6 * kc; curve 8 * kc, -6 * kc via -0.5 * kc, -8.5 * kc; curve -9 * kc, -6 * kc via -0.5 * kc, -3.5 * kc; close }
            path { at: cx, cy; stroke: 1.2 * kc; color: ink; opacity: 70% * o; move -9 * kc, -6 * kc; curve 8 * kc, -6 * kc via -0.5 * kc, -8.5 * kc; curve -9 * kc, -6 * kc via -0.5 * kc, -3.5 * kc; close }
            //  A wash in the accent inside the mug, below the coffee.
            path { at: cx, cy; color: mint; opacity: 22% * o; move -9 * kc, -6 * kc; line -8 * kc, 3 * kc; curve -4 * kc, 7 * kc via -7.5 * kc, 6.5 * kc; line 3 * kc, 7 * kc; curve 7 * kc, 3 * kc via 7.5 * kc, 6.5 * kc; line 8 * kc, -6 * kc; close }
            //  The shading: two short strokes on the left of the mug.
            repeat bc in 0..2 {
                line { from: cx - 5.5 * kc + bc * 2 * kc, cy - 1 * kc + bc * 1.5 * kc + 0.3 * cu * sin(fr * 47 + bc * 60); to: cx - 5 * kc + bc * 2 * kc, cy + 4 * kc + 0.3 * cu * sin(fr * 53 + bc * 70); width: 1.1 * kc; color: mint; opacity: 65% * o }
            }
        }
    }

    //  The camera, in the bell's manner: the body twice in pencil with its viewfinder bump, a lens of two rings with the accent at its heart, a flash and a wash.
    component PCam(cx: number, cy: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let kc = 0.8 * cu
        group {
            pivot: cx, cy
            scale: 1 + 0.10 * a
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kc
                let bj = (0.18 + 0.25 * a) * cu * sin(fr * 53 + bp * 137 + 23)
                let bk = (0.18 + 0.25 * a) * cu * sin(fr * 61 + bp * 71 + 67)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kc; color: ink; opacity: if(bp == 0, 90%, 34%) * o
                       move -7 * kc + bj, -5 * kc + bk
                       line -4 * kc + bk, -5 * kc + bj
                       line -2.5 * kc + bj, -8 * kc + bk
                       line 3 * kc + bk, -8 * kc + bj
                       line 4.5 * kc + bj, -5 * kc + bk
                       line 7 * kc + bk, -5 * kc + bj
                       curve 10 * kc + bj, -2 * kc + bk via 10 * kc, -5 * kc
                       line 10 * kc + bk, 5 * kc + bj
                       curve 7 * kc + bj, 8 * kc + bk via 10 * kc, 8 * kc
                       line -7 * kc + bk, 8 * kc + bj
                       curve -10 * kc + bj, 5 * kc + bk via -10 * kc, 8 * kc
                       line -10 * kc + bk, -2 * kc + bj
                       curve -7 * kc + bj, -5 * kc + bk via -10 * kc, -5 * kc }
            }
            //  A wash in the accent inside the body.
            path { at: cx, cy; color: mint; opacity: 22% * o; move -7 * kc, -5 * kc; line -4 * kc, -5 * kc; line -2.5 * kc, -8 * kc; line 3 * kc, -8 * kc; line 4.5 * kc, -5 * kc; line 7 * kc, -5 * kc; curve 10 * kc, -2 * kc via 10 * kc, -5 * kc; line 10 * kc, 5 * kc; curve 7 * kc, 8 * kc via 10 * kc, 8 * kc; line -7 * kc, 8 * kc; curve -10 * kc, 5 * kc via -10 * kc, 8 * kc; line -10 * kc, -2 * kc; curve -7 * kc, -5 * kc via -10 * kc, -5 * kc; close }
            //  The lens: an outer ring twice, an inner ring, the accent at its heart and a glint.
            ellipse { at: cx + 0.3 * cu * sin(fr * 49), cy + 1.5 * kc + 0.3 * cu * sin(fr * 57); radius: 4.8 * kc; stroke: 1.8 * kc; color: ink; opacity: 90% * o }
            ellipse { at: cx + 0.7 * kc, cy + 2.2 * kc; radius: 4.8 * kc; stroke: 1.3 * kc; color: ink; opacity: 34% * o }
            ellipse { at: cx, cy + 1.5 * kc; radius: 2.6 * kc; stroke: 1.1 * kc; color: ink; opacity: 65% * o }
            ellipse { at: cx, cy + 1.5 * kc; radius: 2.2 * kc; color: mint; opacity: 70% * o }
            ellipse { at: cx - 1.0 * kc, cy + 0.5 * kc; radius: 0.7 * kc; color: ink; opacity: o }
            //  The flash, and the shading: two short strokes on the left of the body.
            ellipse { at: cx + 7 * kc, cy - 2.5 * kc; radius: 1.1 * kc; color: ink; opacity: o }
            repeat bc in 0..2 {
                line { from: cx - 8 * kc + bc * 1.5 * kc, cy - 1 * kc + bc * 1.5 * kc + 0.3 * cu * sin(fr * 47 + bc * 60); to: cx - 7.5 * kc + bc * 1.5 * kc, cy + 4 * kc + 0.3 * cu * sin(fr * 53 + bc * 70); width: 1.1 * kc; color: mint; opacity: 65% * o }
            }
        }
    }

    //  Small pencil icons for the Desk's toggle cards (the same drawings as the control center's bell and mug, sized by `k` and drawn in `col`, `o` as strong).
    component PMBell(cx: number, cy: number, k: number, o: number, col: color) {
        let a = 0                                          // still: these small ones do not boil
        let fr = 0
                group {
            group {
                pivot: cx, cy - 11 * k
                //  The body, a flared dome: two turns of the pencil, the second fainter and a little off.
                repeat bp in 0..2 {
                    let bo = bp * 0.7 * k
                    let bj = 0.3 * k * sin(fr * 53 + bp * 137)
                    let bk = 0.3 * k * sin(fr * 61 + bp * 71 + 40)
                    path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * k; color: col; opacity: if(bp == 0, 90%, 34%) * o
                           move -10 * k + bj, 6 * k + bk
                           curve -5.5 * k + bk, -6 * k + bj via -6.5 * k, 2 * k
                           curve 5.5 * k + bj, -6 * k + bk via 0, -15 * k + bj
                           curve 10 * k + bk, 6 * k + bj via 6.5 * k, 2 * k
                           line -10 * k + bj, 6 * k + bk }
                }
                //  A wash in the accent inside it.
                path { at: cx, cy; color: mint; opacity: 30% * o; move -10 * k, 6 * k; curve -5.5 * k, -6 * k via -6.5 * k, 2 * k; curve 5.5 * k, -6 * k via 0, -15 * k; curve 10 * k, 6 * k via 6.5 * k, 2 * k; close }
                //  The knob on top, and the shading: two short strokes on the left of the dome.
                ellipse { at: cx + 0.3 * k * sin(fr * 67), cy - 12.3 * k; radius: 1.5 * k; color: col; opacity: o }
                repeat bc in 0..2 {
                    line { from: cx - 6 * k + bc * 2 * k, cy - 3 * k + bc * 1.5 * k + 0.3 * k * sin(fr * 47 + bc * 60); to: cx - 5 * k + bc * 2 * k, cy + 2 * k + 0.3 * k * sin(fr * 53 + bc * 70); width: 1.1 * k; color: mint; opacity: 65% * o }
                }
                //  The clapper.
                ellipse { at: cx + 0.3 * k * sin(fr * 59), cy + 10 * k; radius: 2.2 * k; color: mint; opacity: o }
            }
        }
    }

    component PMCup(cx: number, cy: number, k: number, o: number, col: color) {
        let a = 0                                          // still: these small ones do not boil
        let fr = 0
                group {
            repeat bp in 0..2 {
                let bo = bp * 0.7 * k
                let bj = 0.3 * k * sin(fr * 53 + bp * 137 + 11)
                let bk = 0.3 * k * sin(fr * 61 + bp * 71 + 51)
                //  The mug.
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * k; color: col; opacity: if(bp == 0, 90%, 34%) * o
                       move -9 * k + bj, -6 * k + bk
                       line -8 * k + bk, 3 * k + bj
                       curve -4 * k + bj, 7 * k + bk via -7.5 * k, 6.5 * k
                       line 3 * k + bk, 7 * k + bj
                       curve 7 * k + bj, 3 * k + bk via 7.5 * k, 6.5 * k
                       line 8 * k + bk, -6 * k + bj }
                //  The handle.
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * k; color: col; opacity: if(bp == 0, 90%, 34%) * o
                       move 8 * k + bj, -3.5 * k + bk
                       curve 8 * k + bk, 2.5 * k + bj via 14 * k, -3.5 * k
                       }
                //  The saucer.
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.5, 1.1) * k; color: col; opacity: if(bp == 0, 80%, 30%) * o
                       move -11.5 * k + bk, 10 * k + bj
                       line 10.5 * k + bj, 10 * k + bk }
            }
            //  The rim: a flat lens, with the coffee's surface in the accent.
            path { at: cx, cy; color: mint; opacity: 55% * o; move -9 * k, -6 * k; curve 8 * k, -6 * k via -0.5 * k, -8.5 * k; curve -9 * k, -6 * k via -0.5 * k, -3.5 * k; close }
            path { at: cx, cy; stroke: 1.2 * k; color: col; opacity: 70% * o; move -9 * k, -6 * k; curve 8 * k, -6 * k via -0.5 * k, -8.5 * k; curve -9 * k, -6 * k via -0.5 * k, -3.5 * k; close }
            //  A wash in the accent inside the mug, below the coffee.
            path { at: cx, cy; color: mint; opacity: 22% * o; move -9 * k, -6 * k; line -8 * k, 3 * k; curve -4 * k, 7 * k via -7.5 * k, 6.5 * k; line 3 * k, 7 * k; curve 7 * k, 3 * k via 7.5 * k, 6.5 * k; line 8 * k, -6 * k; close }
            //  The shading: two short strokes on the left of the mug.
            repeat bc in 0..2 {
                line { from: cx - 5.5 * k + bc * 2 * k, cy - 1 * k + bc * 1.5 * k + 0.3 * k * sin(fr * 47 + bc * 60); to: cx - 5 * k + bc * 2 * k, cy + 4 * k + 0.3 * k * sin(fr * 53 + bc * 70); width: 1.1 * k; color: mint; opacity: 65% * o }
            }
        }
    }

    //  The Capture window's icons in pencil, like the rest: the region's four corner brackets and the screen's monitor, each stroke drawn twice, a hair off, and redrawn about five times a second under the pointer.
    component PRegion(cx: number, cy: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        group {
            pivot: cx, cy
            scale: 1 + 0.10 * a
            path { at: cx, cy; stroke: 1.5 * cu; color: mix(ink, mint, a); opacity: (o); move -7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 54 + 3826), -2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 68 + 3509); line -7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 76 + 3105), -7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 61 + 4202); line -2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 42 + 3825), -7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 75 + 3595) }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: mix(ink, mint, a); opacity: (o) * 0.28; move -7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 58 + 2494), -2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 47 + 4834); line -7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 44 + 3364), -7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 46 + 2005); line -2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 76 + 3385), -7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 58 + 4393) }
            path { at: cx, cy; stroke: 1.5 * cu; color: mix(ink, mint, a); opacity: (o); move -7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 57 + 2438), 2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 53 + 3278); line -7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 72 + 2514), 7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 66 + 4403); line -2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 42 + 3425), 7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 49 + 4361) }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: mix(ink, mint, a); opacity: (o) * 0.28; move -7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 73 + 2312), 2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 74 + 4238); line -7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 57 + 4826), 7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 71 + 2386); line -2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 75 + 3844), 7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 50 + 2044) }
            path { at: cx, cy; stroke: 1.5 * cu; color: mix(ink, mint, a); opacity: (o); move 7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 68 + 3050), -2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 53 + 4703); line 7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 76 + 3569), -7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 45 + 3542); line 2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 51 + 3966), -7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 44 + 4196) }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: mix(ink, mint, a); opacity: (o) * 0.28; move 7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 65 + 4297), -2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 60 + 3255); line 7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 52 + 2387), -7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 51 + 2507); line 2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 75 + 4384), -7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 42 + 2025) }
            path { at: cx, cy; stroke: 1.5 * cu; color: mix(ink, mint, a); opacity: (o); move 7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 70 + 4402), 2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 56 + 4651); line 7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 57 + 2043), 7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 50 + 4861); line 2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 47 + 4630), 7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 71 + 3579) }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: mix(ink, mint, a); opacity: (o) * 0.28; move 7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 47 + 4677), 2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 71 + 3662); line 7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 67 + 3634), 7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 68 + 3405); line 2.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 75 + 3460), 7.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 74 + 4478) }
            ellipse { at: cx + 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 72 + 2215), cy + 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 43 + 3531); radius: 1.7 * cu * (1 + 0.04 * sin(fr * 47 + 1293)); color: mix(ink, mint, a); opacity: (o) }
            ellipse { at: cx + 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 72 + 4855) + 0.35 * cu, cy + 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 67 + 2616) + 0.28 * cu; radius: 1.7 * cu * (1 + 0.04 * sin(fr * 47 + 1694)); stroke: 1.05 * cu; color: mix(ink, mint, a); opacity: (o) * 0.28 }
        }
    }

    component PScreen(cx: number, cy: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        group {
            pivot: cx, cy
            scale: 1 + 0.10 * a
            path { at: cx, cy; stroke: 1.5 * cu; color: mix(ink, mint, a); opacity: (o); move -8.5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 58 + 4882), -6.3 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 71 + 4805); line 8.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 65 + 2052), -6.7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 57 + 4002); line 8.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 62 + 4115), 5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 70 + 2648); line -8.7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 48 + 3329), 4.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 45 + 3160); line -8.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 57 + 3233), -7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 67 + 2641) }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: mix(ink, mint, a); opacity: (o) * 0.28; move -8.5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 75 + 4427), -6.3 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 68 + 4328); line 8.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 50 + 2354), -6.7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 69 + 2293); line 8.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 61 + 2398), 5 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 64 + 4731); line -8.7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 52 + 4513), 4.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 48 + 4632); line -8.4 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 46 + 4468), -7 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 58 + 3895) }
            path { at: cx, cy; stroke: 1.5 * cu; color: mix(ink, mint, a); opacity: (o); move 0.2 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 76 + 3772), 5.2 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 74 + 4785); line -0.1 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 64 + 2169), 8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 40 + 2816) }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: mix(ink, mint, a); opacity: (o) * 0.28; move 0.2 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 62 + 2578), 5.2 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 50 + 3753); line -0.1 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 71 + 3478), 8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 57 + 4770) }
            path { at: cx, cy; stroke: 1.5 * cu; color: mix(ink, mint, a); opacity: (o); move -3.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 43 + 4680), 8.1 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 66 + 3920); line 3.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 56 + 2262), 7.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 61 + 2245) }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: mix(ink, mint, a); opacity: (o) * 0.28; move -3.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 57 + 4805), 8.1 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 73 + 2115); line 3.6 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 48 + 4517), 7.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 44 + 2383) }
        }
    }

    //  The recording dot on the Capture window's video buttons, in pencil like the icons: a bigger dot, drawn twice, with a loose ring round it, redrawn about five times a second under the pointer.
    component PRecDot(cx: number, cy: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        group {
            pivot: cx, cy
            scale: 1 + 0.10 * a
            ellipse { at: cx + (0.18 + 0.25 * a) * cu * sin(fr * 66 + 2539), cy + (0.18 + 0.25 * a) * cu * sin(fr * 41 + 4525); radius: 4.6 * cu * (1 + 0.05 * sin(fr * 47 + 1399)); color: mint; opacity: (o) }
            ellipse { at: cx + (0.18 + 0.25 * a) * cu * sin(fr * 64 + 3314) + 0.4 * cu, cy + (0.18 + 0.25 * a) * cu * sin(fr * 57 + 2757) + 0.3 * cu; radius: 4.2 * cu * (1 + 0.05 * sin(fr * 47 + 1527)); stroke: 1.05 * cu; color: mint; opacity: (o) * 0.4 }
            ellipse { at: cx + (0.18 + 0.25 * a) * cu * sin(fr * 71 + 2098), cy + (0.18 + 0.25 * a) * cu * sin(fr * 70 + 2644); radius: 6.6 * cu * (1 + 0.05 * sin(fr * 47 + 1159)); stroke: 1.2 * cu; color: mint; opacity: (o) * 0.6 }
            ellipse { at: cx + (0.18 + 0.25 * a) * cu * sin(fr * 76 + 4752) + 0.35 * cu, cy + (0.18 + 0.25 * a) * cu * sin(fr * 70 + 2491) + 0.28 * cu; radius: 6.3 * cu * (1 + 0.05 * sin(fr * 47 + 1027)); stroke: 0.9 * cu; color: mint; opacity: (o) * 0.22 }
        }
    }

    component PRing(cx: number, cy: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        group {
            pivot: cx, cy
            scale: 1 + 0.10 * a
            ellipse { at: cx + 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 59 + 3277), cy + 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 71 + 3434); radius: 10 * cu * (1 + 0.04 * sin(fr * 47 + 1860)); stroke: 1.5 * cu; color: mint; opacity: (o) }
            ellipse { at: cx + 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 43 + 3648) + 0.35 * cu, cy + 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 55 + 3805) + 0.28 * cu; radius: 10 * cu * (1 + 0.04 * sin(fr * 47 + 1930)); stroke: 1.05 * cu; color: mint; opacity: (o) * 0.28 }
        }
    }

    //  The power button in the bell's manner: the ring and its bar twice in pencil, an accent wash inside and two shading strokes on the left.
    component PPower(cx: number, cy: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let kp = 0.8 * cu
        group {
            pivot: cx, cy
            scale: 1 + 0.10 * a
            ellipse { at: cx, cy + 0.8 * kp; radius: 8.4 * kp; color: mint; opacity: 22% * o }
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kp
                let bj = (0.18 + 0.25 * a) * cu * sin(fr * 53 + bp * 137 + 31)
                let bk = (0.18 + 0.25 * a) * cu * sin(fr * 61 + bp * 71 + 71)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kp; color: ink; opacity: if(bp == 0, 90%, 34%) * o
                       move 4.818 * kp + bj, -6.081 * kp + bk
                       line 6.720 * kp + bk, -4.241 * kp + bj
                       line 7.954 * kp + bj, -1.900 * kp + bk
                       line 8.400 * kp + bk, 0.708 * kp + bj
                       line 8.011 * kp + bj, 3.326 * kp + bk
                       line 6.828 * kp + bk, 5.693 * kp + bj
                       line 4.967 * kp + bj, 7.574 * kp + bk
                       line 2.613 * kp + bk, 8.783 * kp + bj
                       line 0.000 * kp + bj, 9.200 * kp + bk
                       line -2.613 * kp + bk, 8.783 * kp + bj
                       line -4.967 * kp + bj, 7.574 * kp + bk
                       line -6.828 * kp + bk, 5.693 * kp + bj
                       line -8.011 * kp + bj, 3.326 * kp + bk
                       line -8.400 * kp + bk, 0.708 * kp + bj
                       line -7.954 * kp + bj, -1.900 * kp + bk
                       line -6.720 * kp + bk, -4.241 * kp + bj
                       line -4.818 * kp + bj, -6.081 * kp + bk }
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 2.0, 1.4) * kp; color: ink; opacity: if(bp == 0, 90%, 34%) * o
                       move 0 + bj, -10.5 * kp + bk
                       line 0 + bk, -1.5 * kp + bj }
            }
            repeat bc in 0..2 {
                line { from: cx - 5 * kp + bc * 1.5 * kp, cy + 1 * kp + bc * 1.5 * kp + 0.3 * cu * sin(fr * 47 + bc * 60); to: cx - 4.5 * kp + bc * 1.5 * kp, cy + 5 * kp + 0.3 * cu * sin(fr * 53 + bc * 70); width: 1.0 * kp; color: mint; opacity: 65% * o }
            }
            ellipse { at: cx, cy + 5.5 * kp; radius: 1.1 * kp; color: mint; opacity: o }
        }
    }

    component PSun(cx: number, cy: number, hot: number, lv: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        group {
            pivot: cx, cy
            scale: 1 + 0.10 * a
            ellipse { at: cx + 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 62 + 4337), cy + 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 43 + 4494); radius: 3 * cu * (1 + 0.04 * sin(fr * 47 + 2480)); color: ink; opacity: (o) }
            ellipse { at: cx + 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 46 + 4708) + 0.35 * cu, cy + 0 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 58 + 4865) + 0.28 * cu; radius: 3 * cu * (1 + 0.04 * sin(fr * 47 + 2550)); color: ink; opacity: (o) * 0.28 }
            path { at: cx, cy; stroke: 1.5 * cu; color: ink; opacity: (0.4 + 0.6 * lv); move -3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 66 + 4293), -3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 71 + 4353); line -1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 73 + 4390), -1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 47 + 4450) }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: ink; opacity: (0.4 + 0.6 * lv) * 0.28; move -3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 50 + 4664), -3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 55 + 4724); line -1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 57 + 4761), -1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 62 + 4821) }
            path { at: cx, cy; stroke: 1.5 * cu; color: ink; opacity: (0.4 + 0.6 * lv); move 3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 46 + 4346), -3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 51 + 4406); line 1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 53 + 4443), -1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 58 + 4503) }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: ink; opacity: (0.4 + 0.6 * lv) * 0.28; move 3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 61 + 4717), -3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 66 + 4777); line 1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 68 + 4814), -1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 73 + 4874) }
            path { at: cx, cy; stroke: 1.5 * cu; color: ink; opacity: (0.4 + 0.6 * lv); move -3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 57 + 4399), 3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 62 + 4459); line -1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 64 + 4496), 1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 69 + 4556) }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: ink; opacity: (0.4 + 0.6 * lv) * 0.28; move -3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 72 + 4770), 3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 46 + 4830); line -1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 48 + 4867), 1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 53 + 4927) }
            path { at: cx, cy; stroke: 1.5 * cu; color: ink; opacity: (0.4 + 0.6 * lv); move 3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 68 + 4452), 3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 73 + 4512); line 1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 44 + 4549), 1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 49 + 4609) }
            path { at: cx + 0.35 * cu, cy + 0.28 * cu; stroke: 1.05 * cu; color: ink; opacity: (0.4 + 0.6 * lv) * 0.28; move 3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 52 + 4823), 3.8 * cu + (0.18 + 0.25 * a) * cu * sin(fr * 57 + 4883); line 1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 59 + 4920), 1 * (5.5 + 1.5 * lv) * cu + (0.18 + 0.25 * a) * cu * sin(fr * 64 + 4980) }
        }
    }

    component PSpk(cx: number, cy: number, hot: number, ap: number, w1: number, w2: number, msl: number) {
