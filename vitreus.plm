    //  place when the panel grows to make room for the player.
    let cy = mix(bar.y + bar.h / 2, lp.top, lmk) + (6 + 125 * (1 + (mix(drop, 1, lmk) - 1) * (1 - 2 * bt))) * ku + lp.dy
