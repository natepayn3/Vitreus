    group {
        pivot: screen.width / 2, screen.height / 2
        scale: 1 - 2 * rt, 1 - 2 * bt
        include "pages/bar_glass.plm"
    }
    //  Along the top the volume's and the notification's glass is its own, outside the group above: that group is bent by the bar's wave, which the music drives,
    //  and these panels are not part of the bar. (In the left layout the shape stays in the main glass, where it joins the right frame.)
    group {
        body {
            color: mix(tint, #000000, cy_dark * cy_k)
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend and gbm > 0.5
            frost: glass_clear
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            rim: 10% * glass_rim
            shine: pointer
            shadow: 0, 7, 20, 24%, deep
            show: obs < 0.996 and not glass_auto
            box { at: do.ix + if(fm < 0.5 and do0 > 0.004, 0, 30000), do.ey; size: do.iw * (1 + do.stretch - 0.07 * do.bell + 0.003 * wobble), do.eh * (1 - do.stretch * 0.5 - 0.002 * wobble); corner: mix(min(do.ew, do.eh) / 2, rc, clamp(do0 * 1.6 - 0.1, 0, 1)); show: do0 > 0.004 }
            box { at: dz.six + if(fm < 0.5 and dz0 > 0.004, 0, 30000), dz.siy; size: dz.siw * (1 + dz.stretch - 0.07 * dz.bell), dz.sih * (1 - dz.stretch * 0.5); corner: mix(min(dz.siw, dz.sih) / 2, 26 * u * desk_s * (1 - 0.73 * sq), clamp(dz0 * 1.6 - 0.1, 0, 1)); show: dz0 > 0.004 }
            box { at: mf.cx + if(fm < 0.5 and mfl > 0.01 and mf.mine > 0.5 and media_open > 0.01, 0, 30000), mf.cy; size: max(0.3, 308 * cu * clamp(mfl, 0, 1) * media_open * mf_s), max(0.3, 168 * cu * clamp(mfl, 0, 1) * media_open * mf_s); corner: 26 * cu * (1 - 0.73 * sq); show: mfl > 0.01 and mf.mine > 0.5 and media_open > 0.01 }
        }
        //  The same glass with `frost: auto` (frosted only where what is behind is busy): `frost:` cannot take `auto` from an expression, so it is a body of its own.
        body {
            color: mix(tint, #000000, cy_dark * cy_k)
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend and gbm > 0.5
            frost: auto
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            rim: 10% * glass_rim
            shine: pointer
            shadow: 0, 7, 20, 24%, deep
            show: obs < 0.996 and glass_auto
            box { at: do.ix + if(fm < 0.5 and do0 > 0.004, 0, 30000), do.ey; size: do.iw * (1 + do.stretch - 0.07 * do.bell + 0.003 * wobble), do.eh * (1 - do.stretch * 0.5 - 0.002 * wobble); corner: mix(min(do.ew, do.eh) / 2, rc, clamp(do0 * 1.6 - 0.1, 0, 1)); show: do0 > 0.004 }
            box { at: dz.six + if(fm < 0.5 and dz0 > 0.004, 0, 30000), dz.siy; size: dz.siw * (1 + dz.stretch - 0.07 * dz.bell), dz.sih * (1 - dz.stretch * 0.5); corner: mix(min(dz.siw, dz.sih) / 2, 26 * u * desk_s * (1 - 0.73 * sq), clamp(dz0 * 1.6 - 0.1, 0, 1)); show: dz0 > 0.004 }
            box { at: mf.cx + if(fm < 0.5 and mfl > 0.01 and mf.mine > 0.5 and media_open > 0.01, 0, 30000), mf.cy; size: max(0.3, 308 * cu * clamp(mfl, 0, 1) * media_open * mf_s), max(0.3, 168 * cu * clamp(mfl, 0, 1) * media_open * mf_s); corner: 26 * cu * (1 - 0.73 * sq); show: mfl > 0.01 and mf.mine > 0.5 and media_open > 0.01 }
        }
        //  Blur behind the obsidian: a glass body asks the compositor for it (100 % glass at 34 %: the request needs glass x opacity of 30 % or more, and a more opaque layer would hide the blur), and the obsidian over it (60 % opaque while blur is on, solid when it is off) hides the glass's look.
        body {
            color: obsidian
            glass: 100%
            lens: false
            rim: 0%
            refraction: 0%
            dispersion: 0%
            shine: 9000, 9000
            opacity: obs * 0.34 * (1 - pk)
            show: obs > 0.97
            box { at: do.ix + if(fm < 0.5 and do0 > 0.004, 0, 30000), do.ey; size: do.iw * (1 + do.stretch - 0.07 * do.bell + 0.003 * wobble), do.eh * (1 - do.stretch * 0.5 - 0.002 * wobble); corner: mix(min(do.ew, do.eh) / 2, rc, clamp(do0 * 1.6 - 0.1, 0, 1)); show: do0 > 0.004 }
            box { at: dz.six + if(fm < 0.5 and dz0 > 0.004, 0, 30000), dz.siy; size: dz.siw * (1 + dz.stretch - 0.07 * dz.bell), dz.sih * (1 - dz.stretch * 0.5); corner: mix(min(dz.siw, dz.sih) / 2, 26 * u * desk_s * (1 - 0.73 * sq), clamp(dz0 * 1.6 - 0.1, 0, 1)); show: dz0 > 0.004 }
            box { at: mf.cx + if(fm < 0.5 and mfl > 0.01 and mf.mine > 0.5 and media_open > 0.01, 0, 30000), mf.cy; size: max(0.3, 308 * cu * clamp(mfl, 0, 1) * media_open * mf_s), max(0.3, 168 * cu * clamp(mfl, 0, 1) * media_open * mf_s); corner: 26 * cu * (1 - 0.73 * sq); show: mfl > 0.01 and mf.mine > 0.5 and media_open > 0.01 }
        }
        body {
            color: obsidian
            rim: 0%
            opacity: obs * (1 - 0.4 * clamp(hy_blur, 0, 1))
            shadow: 0, 7, 24, (38%) * (1 - pk), #000000
            show: obs > 0.004
            box { at: do.ix + if(fm < 0.5 and do0 > 0.004, 0, 30000), do.ey; size: do.iw * (1 + do.stretch - 0.07 * do.bell + 0.003 * wobble), do.eh * (1 - do.stretch * 0.5 - 0.002 * wobble); corner: mix(min(do.ew, do.eh) / 2, rc, clamp(do0 * 1.6 - 0.1, 0, 1)); show: do0 > 0.004 }
            box { at: dz.six + if(fm < 0.5 and dz0 > 0.004, 0, 30000), dz.siy; size: dz.siw * (1 + dz.stretch - 0.07 * dz.bell), dz.sih * (1 - dz.stretch * 0.5); corner: mix(min(dz.siw, dz.sih) / 2, 26 * u * desk_s * (1 - 0.73 * sq), clamp(dz0 * 1.6 - 0.1, 0, 1)); show: dz0 > 0.004 }
            box { at: mf.cx + if(fm < 0.5 and mfl > 0.01 and mf.mine > 0.5 and media_open > 0.01, 0, 30000), mf.cy; size: max(0.3, 308 * cu * clamp(mfl, 0, 1) * media_open * mf_s), max(0.3, 168 * cu * clamp(mfl, 0, 1) * media_open * mf_s); corner: 26 * cu * (1 - 0.73 * sq); show: mfl > 0.01 and mf.mine > 0.5 and media_open > 0.01 }
        }
        //  The Cassette's plastic over it (see `cas_k`): a lit lip, a dark outline, a hard shadow.
        body {
            color: obsidian
            rim: 40% * cas_k
            border: 1.7 * u * cas_k, deep
            shadow: 4.5 * u * cas_k, 5.5 * u * cas_k, 0, 55% * cas_k, deep
            opacity: cas_k
            show: cas_k > 0.004
            box { at: do.ix + if(fm < 0.5 and do0 > 0.004, 0, 30000), do.ey; size: do.iw * (1 + do.stretch - 0.07 * do.bell + 0.003 * wobble), do.eh * (1 - do.stretch * 0.5 - 0.002 * wobble); corner: mix(min(do.ew, do.eh) / 2, rc, clamp(do0 * 1.6 - 0.1, 0, 1)); show: do0 > 0.004 }
            box { at: dz.six + if(fm < 0.5 and dz0 > 0.004, 0, 30000), dz.siy; size: dz.siw * (1 + dz.stretch - 0.07 * dz.bell), dz.sih * (1 - dz.stretch * 0.5); corner: mix(min(dz.siw, dz.sih) / 2, 26 * u * desk_s * (1 - 0.73 * sq), clamp(dz0 * 1.6 - 0.1, 0, 1)); show: dz0 > 0.004 }
            box { at: mf.cx + if(fm < 0.5 and mfl > 0.01 and mf.mine > 0.5 and media_open > 0.01, 0, 30000), mf.cy; size: max(0.3, 308 * cu * clamp(mfl, 0, 1) * media_open * mf_s), max(0.3, 168 * cu * clamp(mfl, 0, 1) * media_open * mf_s); corner: 26 * cu * (1 - 0.73 * sq); show: mfl > 0.01 and mf.mine > 0.5 and media_open > 0.01 }
        }
        //  The UwU's candy plastic over it: a pastel gradient across the whole screen (pink, lilac, sky, mint), a thick grape outline, a lit lip and a hard pink shadow.
        body {
            gradient: 0, 0 to screen.width, screen.height, #ffcfe8, #e6d6ff 38%, #cfeaff 68%, #d2fff0
            rim: 55% * uwu_k
            border: 3 * u * uwu_k, deep
            shadow: 4 * u * uwu_k, 5 * u * uwu_k, 0, 90% * uwu_k, mix(deep, #ff6ec7, 0.75)
            opacity: uwu_k
            show: uwu_k > 0.004
            box { at: do.ix + if(fm < 0.5 and do0 > 0.004, 0, 30000), do.ey; size: do.iw * (1 + do.stretch - 0.07 * do.bell + 0.003 * wobble), do.eh * (1 - do.stretch * 0.5 - 0.002 * wobble); corner: mix(min(do.ew, do.eh) / 2, rc, clamp(do0 * 1.6 - 0.1, 0, 1)); show: do0 > 0.004 }
            box { at: dz.six + if(fm < 0.5 and dz0 > 0.004, 0, 30000), dz.siy; size: dz.siw * (1 + dz.stretch - 0.07 * dz.bell), dz.sih * (1 - dz.stretch * 0.5); corner: mix(min(dz.siw, dz.sih) / 2, 26 * u * desk_s * (1 - 0.73 * sq), clamp(dz0 * 1.6 - 0.1, 0, 1)); show: dz0 > 0.004 }
            box { at: mf.cx + if(fm < 0.5 and mfl > 0.01 and mf.mine > 0.5 and media_open > 0.01, 0, 30000), mf.cy; size: max(0.3, 308 * cu * clamp(mfl, 0, 1) * media_open * mf_s), max(0.3, 168 * cu * clamp(mfl, 0, 1) * media_open * mf_s); corner: 26 * cu * (1 - 0.73 * sq); show: mfl > 0.01 and mf.mine > 0.5 and media_open > 0.01 }
        }
    }
    //  The volume / notification drawer's decorations (Retro: tab and grips; UwU: ears, stars, hearts, paws). They are drawn here, after the glass it has of its own along the top
    //  (above), which would cover them in bar_glass.plm.
    group {
        show: cas_k > 0.01 and do0 > 0.9
        opacity: cas_k * clamp(do0 * 3 - 2, 0, 1)
        let gdo.l = do.ix - do.iw / 2
        let gdo.r = do.ix + do.iw / 2
        let gdo.t = do.ey - do.eh / 2
        let gdo.b = min(do.ey + do.eh / 2, vb - lf.t - 1)
        box { at: gdo.l + 58.5 * u + 2, gdo.t + 9 + 3; size: 58 * u, 24; corner: 5; color: deep; opacity: 38% }
        box { at: gdo.l + 58.5 * u, gdo.t + 9; size: 58 * u, 24; corner: 5; color: mintlo }
        box { at: gdo.l + 58.5 * u, gdo.t + 9 - 2.5; size: 58 * u, 24 - 5; corner: 5; color: mint }
        line { from: gdo.l + 58.5 * u - 24 * u, gdo.t + 9 - 2.5 - (24 - 5) / 2 + 4; to: gdo.l + 58.5 * u + 24 * u, gdo.t + 9 - 2.5 - (24 - 5) / 2 + 4; width: 2.2; color: minthi; opacity: 70% }
        box { at: gdo.l + 58.5 * u, gdo.t + 9; size: 58 * u, 24; corner: 5; stroke: 1.4; color: deep }
        repeat k in 0..8 {
            line { from: gdo.r - 20 * u - k * 11 * u, gdo.b + 4; to: gdo.r - 20 * u - k * 11 * u, gdo.b - 18; width: 6; color: mix(deep, #ffffff, 6%) }
            line { from: gdo.r - 20 * u - k * 11 * u + 3.6, gdo.b + 4; to: gdo.r - 20 * u - k * 11 * u + 3.6, gdo.b - 18; width: 1.2; color: #ffffff; opacity: 45% }
        }
        ellipse { at: gdo.l + 12, gdo.b - 12; radius: 3.6; color: mix(deep, #ffffff, 38%) }
        ellipse { at: gdo.l + 12, gdo.b - 12; radius: 3.6; stroke: 1.1; color: deep }
        line { from: gdo.l + 10, gdo.b - 10; to: gdo.l + 14, gdo.b - 14; width: 1.3; color: deep }
    }
    //  The Cyber's HUD marks and digital rain on the volume / notification banner (see bar_glass.plm).
    group {
        show: cy_k > 0.01 and do0 > 0.9
        opacity: cy_k * clamp(do0 * 3 - 2, 0, 1)
        let cydol = do.ix - do.iw / 2
        let cydor = do.ix + do.iw / 2
        let cydot = do.ey - do.eh / 2
        let cydob = min(do.ey + do.eh / 2, vb - lf.t - 1)
        shader matrix { at: cydol, cydot; size: cydor - cydol, cydob - cydot; corner: 24 * u; values: 0.28, 1; colors: mint, minthi }
        repeat cydoc in 0..4 {
            let cydox = if(mod(cydoc, 2) == 0, cydol - 7 * u, cydor + 7 * u)
            let cydoy = if(cydoc < 2, cydot - 7 * u, cydob + 7 * u)
            let cydosx = if(mod(cydoc, 2) == 0, -1, 1)
            let cydosy = if(cydoc < 2, -1, 1)
            path { at: cydox, cydoy; stroke: 5 * u; color: mint; opacity: 16%; move 0, -cydosy * 15 * u; line 0, 0; line -cydosx * 15 * u, 0 }
            path { at: cydox, cydoy; stroke: 1.7; color: minthi; move 0, -cydosy * 15 * u; line 0, 0; line -cydosx * 15 * u, 0 }
        }
        repeat cydok in 0..13 {
            line { from: cydol + 22 * u + cydok * 6 * u, cydob + 7 * u + 1; to: cydol + 22 * u + cydok * 6 * u, cydob + 7 * u + 1 + if(mod(cydok, 4) == 0, 6 * u, 3 * u); width: 1.1; color: mint; opacity: 70% }
        }
    
        text "SYS 2B6D·F418" { at: cydor - 9 * u, cydob + 7 * u + 11 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 1), 3) == 0, 85%, 0) }
        text "SYS E90C·57A3" { at: cydor - 9 * u, cydob + 7 * u + 11 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 1), 3) == 1, 85%, 0) }
        text "SYS 30D8·B166" { at: cydor - 9 * u, cydob + 7 * u + 11 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 1), 3) == 2, 85%, 0) }
        box { at: cydor - 3 * u, cydob + 7 * u + 11 * u; size: 5 * u, 10 * u; color: minthi; opacity: cy_on * if(mod(time * 1.7, 1) < 0.5, 90%, 0) }
    }
    group {
        show: uwu_k > 0.01 and do0 > 0.9
        opacity: uwu_k * clamp(do0 * 3 - 2, 0, 1)
        let wdo.l = do.ix - do.iw / 2
        let wdo.r = do.ix + do.iw / 2
        let wdo.t = do.ey - do.eh / 2
        let wdo.b = min(do.ey + do.eh / 2, vb - lf.t - 1)
        let wdo.m = do.ix
        repeat side in 0..2 {
            let ex = if(side == 0, wdo.l + 50 * u, wdo.r - 50 * u)
            let sg = if(side == 0, -1, 1)
            path { at: ex, wdo.t; color: obsidian; move -23 * u, 8; line sg * 13 * u, -30 * u; line 23 * u, 8; close }
            path { at: ex, wdo.t; stroke: 3 * u; color: deep; move -23 * u, 8; line sg * 13 * u, -30 * u; line 23 * u, 8 }
            path { at: ex, wdo.t; color: #ff8fc8; move -14 * u, 5; line sg * 9 * u, -19 * u; line 14 * u, 5; close }
        }
        //  Whiskers: three on each side of the drawer, fanning out of its edges at the bottom corners.
        repeat wk in 0..6 {
            let wks = if(wk < 3, -1, 1)
            let wkx = if(wk < 3, wdo.l, wdo.r)
            let wky = wdo.b - 20 * u + (mod(wk, 3) - 1) * 7 * u
            line { from: wkx - wks * 6 * u, wky; to: wkx + wks * 26 * u, wky + (mod(wk, 3) - 1) * 6 * u; width: 4; color: deep }
            line { from: wkx - wks * 6 * u, wky; to: wkx + wks * 26 * u, wky + (mod(wk, 3) - 1) * 6 * u; width: 1.8; color: #ffffff }
        }
        repeat s in 0..3 {
            let sx = wdo.m + (s - 1) * 44 * u
            let sr = if(s == 1, 7, 5) * u
            group { scale: 1 + 0.22 * sin(time * 160 + s * 120); pivot: sx, wdo.b - 12
                path { at: sx, wdo.b - 12; stroke: 3; color: deep; move 0, -sr; line 0.3 * sr, -0.3 * sr; line sr, 0; line 0.3 * sr, 0.3 * sr; line 0, sr; line -0.3 * sr, 0.3 * sr; line -sr, 0; line -0.3 * sr, -0.3 * sr; close }
                path { at: sx, wdo.b - 12; color: pick(s, #ffe27a, #ffffff, #7fd3ff); move 0, -sr; line 0.3 * sr, -0.3 * sr; line sr, 0; line 0.3 * sr, 0.3 * sr; line 0, sr; line -0.3 * sr, 0.3 * sr; line -sr, 0; line -0.3 * sr, -0.3 * sr; close }
            }
        }
        repeat hh in 0..2 {
            let hx = wdo.l + (22 + hh * 22) * u
            let hy = wdo.b - 11
            let hr = if(hh == 0, 5.5, 4.5) * u
            group { scale: 1 + 0.13 * sin(time * 200 + hh * 150); pivot: hx, hy
                ellipse { at: hx - 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62 + 1.5; color: deep }
                ellipse { at: hx + 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62 + 1.5; color: deep }
                path { at: hx, hy; stroke: 3; color: deep; move -1.12 * hr, -0.1 * hr; line 0, 1.2 * hr; line 1.12 * hr, -0.1 * hr; close }
                ellipse { at: hx - 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62; color: pick(hh, #ff6eb4, #b69cff) }
                ellipse { at: hx + 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62; color: pick(hh, #ff6eb4, #b69cff) }
                path { at: hx, hy; color: pick(hh, #ff6eb4, #b69cff); move -1.1 * hr, -0.1 * hr; line 0, 1.15 * hr; line 1.1 * hr, -0.1 * hr; close }
                ellipse { at: hx - 0.7 * hr, hy - 0.5 * hr; radius: hr * 0.2; color: #ffffff; opacity: 80% }
            }
        }
        repeat pw in 0..3 {
            let px = wdo.r - (26 + pw * 28) * u
            let py = wdo.b - 12 + if(mod(pw, 2) == 0, 0, -3)
            ellipse { at: px, py + 2.4; radius: 6; color: deep }
            ellipse { at: px - 6.4, py - 3.2; radius: 3.4; color: deep }
            ellipse { at: px - 2.4, py - 7.6; radius: 3.4; color: deep }
            ellipse { at: px + 2.4, py - 7.6; radius: 3.4; color: deep }
            ellipse { at: px + 6.4, py - 3.2; radius: 3.4; color: deep }
            ellipse { at: px, py + 2.4; radius: 4.6; color: #ff8fc8 }
            ellipse { at: px - 6.4, py - 3.2; radius: 2.2; color: #ff8fc8 }
            ellipse { at: px - 2.4, py - 7.6; radius: 2.2; color: #ff8fc8 }
            ellipse { at: px + 2.4, py - 7.6; radius: 2.2; color: #ff8fc8 }
            ellipse { at: px + 6.4, py - 3.2; radius: 2.2; color: #ff8fc8 }
        }
        particles { at: wdo.l + 36 * u, wdo.b - 16; area: 36 * u, 6; count: 16; life: 1.4s .. 2.6s; speed: 18 .. 42; direction: -90deg; spread: 40deg; size: 3.6, 1; colors: #ff6eb4, #b69cff; shape: spark }
    }
    //  The desk's contents (and its tab and opener): drawn after the island's glass above, so the glass is under them and not over them.
        //  The left tab's three dots (with the strip along the top).
        group {
            show: tm > 0.35 and sb > 0.5            // (only where there is a bar: a monitor without one has no tab for them to hint at)
            repeat i in 0..3 {
                ellipse { at: th.l / 2 + (th.l + nt_d) / 2 * nt_vis_l.$screen, mix(vcc, yo + vb - vcc, bt) + (i - 1) * 6.5 * cu; radius: 1.6 * cu; color: ink; opacity: (35% + 55% * ntn_l.hover) * (1 - clamp(dl, 0, 1)) }
            }
        }
        //  The right tab's three dots (stacked, since the tab is on the side).
        group {
            show: fm > 0.35 and sb > 0.5
            repeat i in 0..3 {
                ellipse { at: mix(screen.width - th.r / 2 - (th.r + nt_d) / 2 * nt_vis_r.$screen, th.r / 2 + (th.r + nt_d) / 2 * nt_vis_r.$screen, rt), mix(vcc, yo + vb - vcc, bt) + (i - 1) * 6.5 * cu; radius: 1.6 * cu; color: ink; opacity: (35% + 55% * ntn_r.hover) * (1 - clamp(dz0, 0, 1)) }
            }
        }
        //  The Island layout's way in to the desk: a small side-panel icon in the top right corner, level with the bar. It stays while the desk is open, lit,
        //  and pressing it opens or closes the desk.
        group {
            show: fm < 0.65
            opacity: 1 - clamp(fm * 1.5, 0, 1)
            ellipse { at: screen.width - 41 * cu, os.stop + 20 * u; radius: 14 * cu; color: mix(ink, mint, clamp(dz0, 0, 1)); opacity: 7% + 12% * desk_open_z.hover + 12% * clamp(dz0, 0, 1) }
            //  The glyph: a dashboard, one tall tile beside two small ones (a panel of several things), filled and soft; mint while the desk is open.
            box { at: screen.width - 41 * cu - 5 * cu, os.stop + 20 * u; size: 7 * cu, 14 * cu; corner: 2 * cu; color: mix(ink, mint, clamp(dz0, 0, 1)); opacity: 70% + 30% * desk_open_z.hover }
            box { at: screen.width - 41 * cu + 5 * cu, os.stop + 20 * u - 4.25 * cu; size: 7 * cu, 5.5 * cu; corner: 1.8 * cu; color: mix(ink, mint, clamp(dz0, 0, 1)); opacity: 70% + 30% * desk_open_z.hover }
            box { at: screen.width - 41 * cu + 5 * cu, os.stop + 20 * u + 4.25 * cu; size: 7 * cu, 5.5 * cu; corner: 1.8 * cu; color: mix(ink, mint, clamp(dz0, 0, 1)); opacity: 55% + 45% * desk_open_z.hover }
            zone box desk_open_z { at: screen.width - 41 * cu, os.stop + 20 * u; size: 32 * cu, 32 * cu; corner: 16 * cu; cursor: pointer; active: fm < 0.5 }
            on press desk_open_z { panel_scr = screen.index; desk_open = not desk_open }
        }
    include "pages/desk.plm"

    //  The strip's pieces (icons, clock, title) are laid out down the left; on the right they are slid across to the mirror image of their place, and along the bottom
    //  (the top strip flipped) they are slid down to the mirror image of theirs.
    group {
        show: sb > 0.5                                     // not on a monitor that has only the frame (see `sb`)
        move: rt * (screen.width - 2 * lf.x), bt * (yo + vb - 2 * bar.y)
    include "pages/bar_icons.plm"
    //  The clock runs while something needs it. It is here, after the bar's zones, because it reads their hover: the bar's icons only boil under the pointer.
    let need_clock = (cy_on > 0.01) or bar_hit.hover > 0.01 or wsh.1.$screen > 0.01 or wsh.2.$screen > 0.01 or wsh.3.$screen > 0.01 or wsh.4.$screen > 0.01 or wsh.5.$screen > 0.01 or wsh.6.$screen > 0.01 or wsh.7.$screen > 0.01 or wsh.8.$screen > 0.01 or wsh.9.$screen > 0.01 or wsh.10.$screen > 0.01 or ws.sp > 0.01 or set_hit.hover > 0.01 or sr_hit.hover > 0.01 or ctl_hit.hover > 0.01 or ov_btn.hover > 0.01 or bp.prev.hover > 0.01 or bp.play.hover > 0.01 or bp.next.hover > 0.01 or vm_prev.hover > 0.01 or vm_play.hover > 0.01 or vm_next.hover > 0.01 or ds > 0.01 or dl > 0.01 or dk > 0.01 or ((wifi_scanning or bt_scanning or bt_working or caf_on or pw_d0 or pw_d1 or pw_d2 or pw_d3 or pw_d4) and dk > 0.01) or (do > 0.01 and (osd_kind == vol or osd_kind == note or nt_urgent)) or (set_pgd > 0.01 and disp.h > set.h) or time - pw_b0 < 1.5 or time - pw_b1 < 1.5 or time - pw_b2 < 1.5 or time - pw_b3 < 1.5 or time - pw_b4 < 1.5 or rec_on or dsh_rise > 0.01 or (mf.vis > 0.01 and media.playing)
    spin time by if(need_clock, 1, 0)


    //  The bar's text is drawn on top of the bar, outside its wave-shader group: inside it the letters are
    //  resampled by the shader, which blurs them and smears them whenever the music makes the wave move.
    //  The glass and the icons still bend; the words stay sharp.
    //  The clock in the bar is four texts, right-aligned and set against each other from their measured widths:
    //  the hour, oversized; the minutes with their colon, in the accent, the two digits tucked 3 px over each
    //  other (the colon is left clear: overlapped it disappears); and, at the edge, a small column: the day
    //  stacked tight over a dim am/pm, centred on each other.
    group {
        pivot: at.clock, bar.y
        scale: 1 + 0.08 * bar_hit.hover
        text bar_date { at: floor(clock.r - clock.col / 2 + 0.5), floor(bar.y - 8 * bz + 0.5); anchor: center; size: 11 * bz; weight: 700; measure: cdw; color: faint; opacity: bs.clock * (1 - lm); shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
        text bar_ap { at: floor(clock.r - clock.col / 2 + 0.5), floor(bar.y + 7 * bz + 0.5); anchor: center; size: 14 * bz; weight: 600; measure: caw; color: faint; opacity: bs.clock * (1 - lm); shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
        text clock_mm { at: floor(clock.r - clock.col - 3 * bz + 0.5), floor(bar.y + 3 * bz + 0.5); anchor: right center; size: 26 * bz; weight: 700; measure: cmw; letter_move: 3 * bz * ((letters - 1 - letter) - if(letter == 0, 1, 0)), 0; color: mint; opacity: bs.clock * (1 - lm); shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
        text clock_h { at: floor(clock.r - clock.col - cmw.width + 0.5), floor(bar.y + 0.5); anchor: right center; size: 40 * bz; weight: 700; measure: chw; color: ink; opacity: bs.clock * (1 - lm); shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
        PBLine(clock.left + (chw.width + cmw.width) / 2, bar.y + mix(0.43, 0.286, sg) * bar.h, bar_hit.hover, chw.width + cmw.width, 0.5 * bs.clock * (1 - lm) * (1 - sg))
        //  In the Notches layout the line under the clock is gone, and a smaller one sits between the day and the am/pm instead.
        PBLine(clock.r - clock.col / 2, bar.y - 0.5, bar_hit.hover, clock.col * 0.6, 0.5 * bs.clock * (1 - lm) * sg)
    }
    //  Down the left the clock is stacked in the strip: the hour, the minutes under it in the accent, and the am/pm.
    group {
        pivot: lf.x, lv.clk + 28 * bu
        scale: 1 + 0.08 * bar_hit.hover
        text clock_h { at: floor(lf.x - 5 * bu + 0.5), floor(lv.clk + 0.5); anchor: center; align: center; size: 30 * bz; weight: 700; gradient: 0, lv.clk - 18 * bu to 0, lv.clk + 33 * bu, minthi, mint 55%, mintlo; opacity: bs.clock * lm; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
        text clock_mn { at: floor(lf.x - 5 * bu + 0.5), floor(lv.clk + 28 * bu + 0.5); anchor: center; align: center; size: 17 * bz; weight: 700; gradient: 0, lv.clk - 18 * bu to 0, lv.clk + 33 * bu, minthi, mint 55%, mintlo; opacity: bs.clock * lm; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
        PBLine(lf.x - 5 * bu, lv.clk + 16.5 * bu, bar_hit.hover, 18 * bu, 0.85 * bs.clock * lm)   // the rule under the hour, in pencil
        //  am/pm: two letters one over the other, on the right, level with the rule (the hour and the minutes are moved left to make room).
        text bar_ap1 { at: floor(lf.x + 12.5 * bu + 0.5), floor(lv.clk + 11.9 * bu + 0.5); anchor: center; align: center; size: 11 * bz; weight: 700; color: mint; opacity: bs.clock * lm; family: "Space Grotesk" }
        text "m" { at: floor(lf.x + 12.5 * bu + 0.5), floor(lv.clk + 21.1 * bu + 0.5); anchor: center; align: center; size: 11 * bz; weight: 700; color: mint; opacity: bs.clock * lm; family: "Space Grotesk" }
        //  Under them the day of the week and the date.
        text bar_date { at: floor(lf.x + 5 * bu + 0.5), floor(lv.clk + 41 * bu + 0.5); anchor: center; align: center; size: 11 * bz; weight: 700; color: faint; opacity: bs.clock * lm; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
        text date_md { at: floor(lf.x + 0.5), floor(lv.clk + 55 * bu + 0.5); anchor: center; align: center; size: 14 * bz; weight: 700; color: ink; opacity: bs.clock * lm; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    }
    //  The window title down the left: the app, and under it (to its right once turned) the title, turned a quarter anticlockwise so that it reads
    //  from the foot up, each centred on the strip's middle line and on the stretch `lv.tm` and cut with an ellipsis where that ends.
    group {
        pivot: lf.x - 9 * bcu * (1 - 2 * rt), lv.tm
        rotate: (2 * rt - 1) * 90deg
        opacity: lm * bs.title0
        text win.class { at: floor(lf.x - 9 * bcu * (1 - 2 * rt) + 0.5), floor(lv.tm + 0.5); anchor: center; align: center; size: 15 * bz; weight: 600; width: max(1, lv.span); lines: 1; color: faint; opacity: 70%; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    }
    group {
        opacity: lm * bs.title0 * lv.none
        repeat i in 0..3 {
            ellipse { at: lf.x, lv.tm + (i - 1) * 8 * bcu; radius: 1.9 * bcu; color: faint; opacity: 70% + 30% * pl_btn_z.hover }
        }
    }
    group {
        pivot: lf.x + 9 * bcu * (1 - 2 * rt), lv.tm
        rotate: (2 * rt - 1) * 90deg
        opacity: lm * bs.title0
        text win.title { at: floor(lf.x + 9 * bcu * (1 - 2 * rt) + 0.5), floor(lv.tm + 0.5); anchor: center; align: center; size: 14 * bz; weight: 500; width: max(1, lv.span); lines: 1; color: ink; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    }
    text win.class { at: floor(win.xs + 0.5), floor(bar.y - 6.5 * bu + 0.5); anchor: left center; size: 17 * bz; weight: 600; width: max(0, win.hw - 12 * bu - mctl); lines: 1; color: faint; opacity: 55% * bs.title; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }
    text win.title { at: floor(win.xs + 0.5), floor(bar.y + 8.75 * bu + 0.5); anchor: left center; size: 13.5 * bz; weight: 500; width: max(0, win.hw - 12 * bu); lines: 1; color: ink; opacity: bs.title; shadow: 0, 1, 3, 40%, deep; family: "Space Grotesk" }

    //  Along the top with nothing focused (an empty workspace) and no player: three dots take the title's place, as down the left, so there is something to click.
    group {
        opacity: bs.title * (1 - win.have) * (1 - clamp(mshow * bs.media, 0, 1))
        repeat i in 0..3 {
            ellipse { at: win.zc + (i - 1) * 8 * bu, bar.y; radius: 1.9 * bu; color: faint; opacity: 70% + 30% * win_hit.hover }
        }
    }

    }
    include "pages/corner_dock.plm"
    include "pages/addon_dock.plm"
    include "pages/panel_frame.plm"
    include "pages/controls_drawer.plm"
    include "pages/player.plm"
    include "pages/media_float.plm"
    //  ── the launcher ──
    //  A search field over its results. What is typed picks the kind of search: apps, or after a first
    //  character `#` files, `>` commands, `:` emoji, `^` the clipboard, `~` wallpapers; and a sum is answered. The
    //  logic (see the Launcher section of vitreus.luau) reads the field and fills `lres`. Files, the clipboard and
    //  wallpapers have a preview beside the rows: the picture, or the text, and the file's details.
    group {
        shader: pixelate, px.dl
        clip inset 2 box { at: mix(pcx, dl.gx, fm), mix(bar.y + dl.hh / 2, lp.cy, fm); size: mix(dl.w, dl.gw, fm), mix(dl.hh, dl.gh, fm); corner: 26 * pu * (1 - 0.73 * sq) }
        opacity: fl * pown
        move: rt * (screen.width - 2 * pcx), (1 - fl) * 12 * pu + bt * (yo + vb - 2 * lp.cy)
        let lx = pcx - 215 * pu
        let lhy = ck + 25 * pu                             // the header's middle
        let ly = ck + 50 * pu                              // the field's top
        let lry = ly + 86 * pu                             // the rows start under the two rows of hints
        let lph = max(1, lr * 44 - 4) * pu                 // the rows' height, and the preview's
        let lpx = lx + lw + 8 * pu                         // the preview's left edge
        let lpw = 430 * pu - lw - 8 * pu
        //  Header, like Settings': a badge with an icon, the title, a chip with what kind of search it is (apps, files...), and a cross.
        box { at: lx + 16 * pu, lhy; size: 32 * pu, 32 * pu; corner: 9 * pu; color: mint; opacity: 20% }
        //  The four squares, in pencil like the Settings gear: they turn a quarter as the panel opens (on `dl`), and a quarter more each time the kind of search changes
        //  (`sr_t`, which overshoots).
        group {
            pivot: lx + 16 * pu, lhy
            rotate: -90deg * (1 - dl) + sr_t * 90deg
            let sfr = floor(time * 8)
            repeat i in 0..4 {
                let qx = lx + 16 * pu + (mod(i, 2) - 0.5) * 8.5 * pu
                let qy = lhy + (floor(i / 2) - 0.5) * 8.5 * pu
                let qh = 3.25 * pu
                box { at: qx, qy; size: 6.5 * pu, 6.5 * pu; corner: 2 * pu; color: mint; opacity: 32% }
                repeat p in 0..2 {
                    let qs = i * 97 + p * 131
                    let qj = 0.45 * pu
                    path { at: qx + p * 0.5 * pu, qy + p * 0.4 * pu; stroke: if(p == 0, 1.5, 1) * pu; color: mint; opacity: if(p == 0, 100%, 40%)
                           move -qh + qj * sin(sfr * 53 + qs), -qh + qj * sin(sfr * 59 + qs + 10)
                           line qh + qj * sin(sfr * 61 + qs + 20), -qh + qj * sin(sfr * 67 + qs + 30)
                           line qh + qj * sin(sfr * 71 + qs + 40), qh + qj * sin(sfr * 73 + qs + 50)
                           line -qh + qj * sin(sfr * 79 + qs + 60), qh + qj * sin(sfr * 83 + qs + 70)
                           line -qh + qj * sin(sfr * 53 + qs), -qh + qj * sin(sfr * 59 + qs + 10) }
                }
            }
        }
        group { scale: rs; pivot: floor(lx + 40 * pu + 0.5), floor(lhy + 0.5); text "SEARCH" { at: floor(lx + 40 * pu + 0.5), floor(lhy + 0.5); anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
        path { at: lx + 96 * pu, lhy; stroke: 1.3 * pu; color: faint; move -2 * pu, -3.5 * pu; line 2 * pu, 0; line -2 * pu, 3.5 * pu }
        group { scale: rs; pivot: floor(lx + 106 * pu + 0.5), floor(lhy + 0.5); text lmode { at: floor(lx + 106 * pu + 0.5), floor(lhy + 0.5); anchor: left center; size: 16; weight: 700; width: (150 * pu) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
        ellipse { at: lx + 414 * pu, lhy; radius: 13 * pu; color: ink; opacity: 5% + 10% * launch_x.hover }
        line { from: lx + 409.5 * pu, lhy - 4.5 * pu; to: lx + 418.5 * pu, lhy + 4.5 * pu; width: 1.5 * pu; color: ink; opacity: 60% + 40% * launch_x.hover }
        line { from: lx + 418.5 * pu, lhy - 4.5 * pu; to: lx + 409.5 * pu, lhy + 4.5 * pu; width: 1.5 * pu; color: ink; opacity: 60% + 40% * launch_x.hover }
        zone box launch_x { at: lx + 414 * pu, lhy; size: 28 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
        on press launch_x { panel = none }
        //  Obsidian: the field is a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
        body { color: mix(obsidian, ink, 8% * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { from: lx, ly; size: 430 * pu, 40 * pu; corner: 20 * pu } }
        box { from: lx, ly; size: 430 * pu, 40 * pu; corner: 20 * pu; color: ink; opacity: 8% * (1 - obs) }
        ellipse { at: lx + 24 * pu, ly + 19 * pu; radius: 5.5 * pu; stroke: 1.6 * pu; color: mint }
        line { from: lx + 28 * pu, ly + 23 * pu; to: lx + 32.5 * pu, ly + 27.5 * pu; width: 1.8 * pu; color: mint }
        input lq { at: floor(lx + 46 * pu + 0.5), floor(ly + 12 * pu + 0.5); width: 366 * pu; size: 20; color: ink; family: "Space Grotesk"; placeholder: "Search apps…" }
        text "files" { at: 0, 0; size: 13; lines: 1; measure: lhw0; opacity: 0; family: "Space Grotesk" }
        text "commands" { at: 0, 0; size: 13; lines: 1; measure: lhw1; opacity: 0; family: "Space Grotesk" }
        text "emoji" { at: 0, 0; size: 13; lines: 1; measure: lhw2; opacity: 0; family: "Space Grotesk" }
        text "clipboard" { at: 0, 0; size: 13; lines: 1; measure: lhw3; opacity: 0; family: "Space Grotesk" }
        text "wallpapers" { at: 0, 0; size: 13; lines: 1; measure: lhw4; opacity: 0; family: "Space Grotesk" }
        text "windows" { at: 0, 0; size: 13; lines: 1; measure: lhw5; opacity: 0; family: "Space Grotesk" }
        text "web" { at: 0, 0; size: 13; lines: 1; measure: lhw6; opacity: 0; family: "Space Grotesk" }
        text "snippets" { at: 0, 0; size: 13; lines: 1; measure: lhw7; opacity: 0; family: "Space Grotesk" }
        text "calc" { at: 0, 0; size: 13; lines: 1; measure: lhw8; opacity: 0; family: "Space Grotesk" }
        text "packages" { at: 0, 0; size: 13; lines: 1; measure: lhw9; opacity: 0; family: "Space Grotesk" }
        //  What the first character of the search does, in small type under the field: press one to type it. Five
        //  equal cells across the field, each pair (character, name) centred in its cell, a divider between cells.
        repeat i in 0..5 {
            let hc = lx + (i + 0.5) * 86 * pu                   // the cell's middle
            let hy = ly + 54 * pu
            let hx = floor(hc - (12 * pu + rs * pick(i, lhw0.width, lhw1.width, lhw2.width, lhw3.width, lhw4.width)) / 2 + 0.5)   // where the pair starts
            box { at: hc, hy; size: 82 * pu, 18 * pu; corner: 9 * pu; color: ink; opacity: 8% * lhint_hit.$i.hover }
            group { scale: rs; pivot: hx, floor(hy + 0.5); text pick(i, "#", ">", ":", "^", "~") { at: hx, floor(hy + 0.5); anchor: left center; size: 15; weight: 700; color: mint; family: "Space Grotesk" } }
            group { scale: rs; pivot: hx + floor(12 * pu + 0.5), floor(hy + 0.5); text pick(i, "files", "commands", "emoji", "clipboard", "wallpapers") { at: hx + floor(12 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13; color: faint; family: "Space Grotesk" } }
            line { from: lx + i * 86 * pu, hy - 5 * pu; to: lx + i * 86 * pu, hy + 5 * pu; width: 1 * pu; color: ink; opacity: 18%; show: i > 0 }
            zone box lhint_hit.$i { at: hc, hy; size: 84 * pu, 18 * pu; corner: 9 * pu; cursor: pointer }
            on press lhint_hit.$i { emit launch_hint(i) }
        }
        //  A second row of the same under it: five more (windows, the web, snippets, a sum or a conversion, packages), five cells across the field like the first.
        repeat j in 0..5 {
            let hc2 = lx + (j + 0.5) * 86 * pu
            let hy2 = ly + 72 * pu
            let hx2 = floor(hc2 - (12 * pu + rs * pick(j, lhw5.width, lhw6.width, lhw7.width, lhw8.width, lhw9.width)) / 2 + 0.5)
            box { at: hc2, hy2; size: 82 * pu, 18 * pu; corner: 9 * pu; color: ink; opacity: 8% * lhint2_hit.$j.hover }
            group { scale: rs; pivot: hx2, floor(hy2 + 0.5); text pick(j, "@", "?", "$", "=", "+") { at: hx2, floor(hy2 + 0.5); anchor: left center; size: 15; weight: 700; color: mint; family: "Space Grotesk" } }
            group { scale: rs; pivot: hx2 + floor(12 * pu + 0.5), floor(hy2 + 0.5); text pick(j, "windows", "web", "snippets", "calc", "packages") { at: hx2 + floor(12 * pu + 0.5), floor(hy2 + 0.5); anchor: left center; size: 13; color: ink; opacity: 70%; family: "Space Grotesk" } }
            line { from: lx + j * 86 * pu, hy2 - 5 * pu; to: lx + j * 86 * pu, hy2 + 5 * pu; width: 1 * pu; color: ink; opacity: 18%; show: j > 0 }
            zone box lhint2_hit.$j { at: hc2, hy2; size: 84 * pu, 18 * pu; corner: 9 * pu; cursor: pointer }
            on press lhint2_hit.$j { emit launch_hint(j + 5) }
        }
        //  The wheel over the rows scrolls the list (under the rows, so their presses still win).
        zone box lwheel { from: lx, lry; size: lw, lph }
        on scroll lwheel { emit launch_scroll(-wheel) }
        column lcol {
            at: floor(lx + 0.5), floor(lry + 0.5)     // on whole pixels, as each row's height and the gap are: an icon
            view: lw, lph                             // between two pixels picks up a sliver of its neighbour in the atlas
            gap: floor(4 * pu + 0.5)
            for r in lres { LRow(r, pick: launch_pick, del: launch_del, ctx: launch_ctx) }
        }
        group { scale: rs; pivot: floor(lx + lw / 2 + 0.5), floor(lry + 20 * pu + 0.5); text lmsg { at: floor(lx + lw / 2 + 0.5), floor(lry + 20 * pu + 0.5); anchor: center; align: center; size: 16; color: faint; width: (lw - 16 * pu) / rs; lines: 2; family: "Space Grotesk"; show: lcount < 1 } }

        //  The preview.
        group {
            opacity: lpv
            show: lpv > 0.01
            body { color: mix(obsidian, ink, 5% * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { from: lpx, lry; size: lpw, lph; corner: 14 * pu } }
            box { from: lpx, lry; size: lpw, lph; corner: 14 * pu; color: ink; opacity: 5% * (1 - obs) }
            group { scale: rs; pivot: floor(lpx + 10 * pu + 0.5), floor(lry + 14 * pu + 0.5); text lp_kind { at: floor(lpx + 10 * pu + 0.5), floor(lry + 14 * pu + 0.5); anchor: left center; size: 12; weight: 700; width: (lpw - 20 * pu) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
            group {
                show: lp_img_on
                clip inset 0 box { at: lpx + lpw / 2, lry + 28 * pu + (lpw - 20 * pu) / 3; size: lpw - 20 * pu, (lpw - 20 * pu) * 2 / 3; corner: 8 * pu }
                box { from: lpx + 10 * pu, lry + 28 * pu; size: lpw - 20 * pu, (lpw - 20 * pu) * 2 / 3; corner: 8 * pu; color: ink; opacity: 5% }
                image lp_img { at: lpx + 10 * pu, lry + 28 * pu; size: lpw - 20 * pu, (lpw - 20 * pu) * 2 / 3 }
            }
            let lpy = lry + 28 * pu + if(lp_img_on, (lpw - 20 * pu) * 2 / 3 + 8 * pu, 0)
            group { scale: rs; pivot: floor(lpx + 10 * pu + 0.5), floor(lpy + 8 * pu + 0.5); text lp_title { at: floor(lpx + 10 * pu + 0.5), floor(lpy + 8 * pu + 0.5); anchor: left center; size: 16; weight: 700; width: (lpw - 20 * pu) / rs; lines: 1; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(lpx + 10 * pu + 0.5), floor(lpy + 24 * pu + 0.5); text lp_path { at: floor(lpx + 10 * pu + 0.5), floor(lpy + 24 * pu + 0.5); anchor: left center; size: 13; width: (lpw - 20 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(lpx + 10 * pu + 0.5), floor(lpy + 40 * pu + 0.5); text lp_body { at: floor(lpx + 10 * pu + 0.5), floor(lpy + 40 * pu + 0.5); anchor: left top; size: 15; width: (lpw - 20 * pu) / rs; lines: 9; color: ink; family: "Space Grotesk" } }
            repeat i in 0..4 {
                let ky = lpy + 44 * pu + i * 16 * pu
                group { scale: rs; pivot: floor(lpx + 10 * pu + 0.5), floor(ky + 0.5); text pick(i, lp_k1, lp_k2, lp_k3, lp_k4) { at: floor(lpx + 10 * pu + 0.5), floor(ky + 0.5); anchor: left center; size: 13.5; width: (50 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(lpx + 60 * pu + 0.5), floor(ky + 0.5); text pick(i, lp_v1, lp_v2, lp_v3, lp_v4) { at: floor(lpx + 60 * pu + 0.5), floor(ky + 0.5); anchor: left center; size: 13.5; width: (lpw - 70 * pu) / rs; lines: 1; color: ink; family: "Space Grotesk" } }
            }
        }
        group { scale: rs; pivot: floor(lx + 6 * pu + 0.5), floor(lry + (lr * 44 + 4 + 9) * pu + 0.5); text "↑↓ move   ·   Enter open   ·   Esc close" { at: floor(lx + 6 * pu + 0.5), floor(lry + (lr * 44 + 4 + 9) * pu + 0.5); anchor: left center; size: 13.5; color: faint; opacity: 70%; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(lx + 424 * pu + 0.5), floor(lry + (lr * 44 + 4 + 9) * pu + 0.5); text lfoot { at: floor(lx + 424 * pu + 0.5), floor(lry + (lr * 44 + 4 + 9) * pu + 0.5); anchor: right center; align: right; size: 13.5; width: (120 * pu) / rs; lines: 1; color: faint; opacity: 70%; family: "Space Grotesk" } }
    }

    include "pages/settings_panel.plm"
    prop volume_level = 0 ~140ms
    follow volume_level = if(audio.muted, 0, audio.volume)
    prop bright_level = 0 ~140ms
    follow bright_level = brightness.level
    //  The control center's sliders follow the pointer while they are dragged (`vol_ui`, `bri_ui`: what the pointer says), not the mixer's answer, which comes back a moment later: a
    //  press or a drag sets the lock, and it lets go 0.9 s after the release, by which time the real value has caught up.
    fact vol_ui = 0
    fact bri_ui = 0
    prop vol_lock = 0 ~1ms
    prop bri_lock = 0 ~1ms
    let vol_shown = if(vol_lock > 0.5, vol_ui, volume_level)
    fact mic_ui = 0
    prop mic_lock = 0 ~1ms
    prop mic_level = 0 ~140ms
    follow mic_level = clamp(audio.input, 0, 1)
    let mic_shown = if(mic_lock > 0.5, mic_ui, mic_level)
    let bri_shown = if(bri_lock > 0.5, bri_ui, bright_level)
    // ── dismissing the panel ─────────────────────────────────────
    //  Escape closes it. The scene only asks for the keyboard while the panel is
    //  open (see `surface`), so typing goes to your apps the rest of the time.
    on key Down while panel == launch { emit launch_move(1) }
    on key Up while panel == launch { emit launch_move(-1) }
    on key Tab while panel == launch { emit launch_move(1) }
    on key Ctrl+n while panel == launch { emit launch_move(1) }
    on key Ctrl+p while panel == launch { emit launch_move(-1) }
    on key Shift+Delete while panel == launch { emit launch_delsel }
    on submit lq { emit launch_run }
    on key Escape while dd_open { dd_open = false }
    on key Escape while font_dd_open { font_dd_open = false; blur }
    on key Escape while panel != none and not dd_open and not font_dd_open and not kb_cap { panel = none }
    on key Escape while kb_cap { kb_cap = false }
    //  The font picker on the Theme page, from the keyboard: the arrows, Page Up and Down, Home and End move the chosen typeface whether the dropdown is open or
    //  not; typing a letter opens it and searches (`font_q`); Return closes it.
    on key Down while panel == settings and set_page == pg_theme { emit font_step(1) }
    on key Up while panel == settings and set_page == pg_theme { emit font_step(-1) }
    on key Page_Down while panel == settings and set_page == pg_theme { emit font_step(8) }
    on key Page_Up while panel == settings and set_page == pg_theme { emit font_step(-8) }
    on key Home while panel == settings and set_page == pg_theme { emit font_step(-100000) }
    on key End while panel == settings and set_page == pg_theme { emit font_step(100000) }
    on key Return while font_dd_open { font_dd_open = false; blur }
    on key a while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(97); focus font_q }
    on key b while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(98); focus font_q }
    on key c while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(99); focus font_q }
    on key d while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(100); focus font_q }
    on key e while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(101); focus font_q }
    on key f while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(102); focus font_q }
    on key g while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(103); focus font_q }
    on key h while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(104); focus font_q }
    on key i while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(105); focus font_q }
    on key j while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(106); focus font_q }
    on key k while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(107); focus font_q }
    on key l while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(108); focus font_q }
    on key m while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(109); focus font_q }
    on key n while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(110); focus font_q }
    on key o while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(111); focus font_q }
    on key p while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(112); focus font_q }
    on key q while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(113); focus font_q }
    on key r while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(114); focus font_q }
    on key s while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(115); focus font_q }
    on key t while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(116); focus font_q }
    on key u while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(117); focus font_q }
    on key v while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(118); focus font_q }
    on key w while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(119); focus font_q }
    on key x while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(120); focus font_q }
    on key y while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(121); focus font_q }
    on key z while panel == settings and set_page == pg_theme and not font_dd_open { font_dd_open = true; emit font_char(122); focus font_q }

    include "pages/osd_drawer.plm"
    //  ── the wallpaper picker ─────────────────────────────────────
    //  The tray hangs under the bar. Which layout fits N hexagons best (the biggest ones that still fit the tray) is worked out here,
    //  from a few column counts around the one that N and the tray's shape suggest.
    let g.n = max(1, wp_picker.count)
    let g.aw = min(screen.width - 168, 2400)              // the room for the hexagons
    let g.ah = vh - 260                        // and the height: the bar above, the foot below, some air
    let g.c0 = floor(g.aw / (1.7321 * sqrt(g.aw * g.ah / (2.6 * g.n))))
    let g.c1 = max(1, min(g.n, g.c0 - 2))
    let g.c2 = max(1, min(g.n, g.c0 - 1))
    let g.c3 = max(1, min(g.n, g.c0))
    let g.c4 = max(1, min(g.n, g.c0 + 1))
    let g.c5 = max(1, min(g.n, g.c0 + 2))
    let g.r1 = min(g.aw / (1.7321 * (g.c1 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c1 - 1) / g.c1) - 1) + 2))
    let g.r2 = min(g.aw / (1.7321 * (g.c2 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c2 - 1) / g.c2) - 1) + 2))
    let g.r3 = min(g.aw / (1.7321 * (g.c3 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c3 - 1) / g.c3) - 1) + 2))
    let g.r4 = min(g.aw / (1.7321 * (g.c4 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c4 - 1) / g.c4) - 1) + 2))
    let g.r5 = min(g.aw / (1.7321 * (g.c5 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c5 - 1) / g.c5) - 1) + 2))
    let g.rb = max(max(max(g.r1, g.r2), max(g.r3, g.r4)), g.r5)
    let g.cols = if(g.r1 == g.rb, g.c1, if(g.r2 == g.rb, g.c2, if(g.r3 == g.rb, g.c3, if(g.r4 == g.rb, g.c4, g.c5))))
    let g.R = min(g.rb, 120)                              // a hexagon's radius, corner to middle
    let g.w = 1.7321 * g.R
    let g.rows = floor((g.n + g.cols - 1) / g.cols)
    let g.gw = (g.cols + 0.5) * g.w
    let g.gh = (g.rows - 1) * 1.5 * g.R + 2 * g.R
    let g.pgx = -wp_pgp * screen.width                  // the swipe: the hexagons leave to the left as the cards come in
    let g.x0 = cx - g.gw / 2 + g.pgx
    //  Round the hovered hexagon the others give way: they are pushed outwards (by K, most at about a tile's distance and not at all far
    //  off) and the ring next to it shrinks a little. The hovered one grows on its own spring (`gt`). `sg` is how far this reaches.
    let g.K = 0.55 * clamp(wp_picker_hs, 0, 1.1)
    let g.sg = 1.5 * g.w
    let g.foot = 0.8 * g.R + 80                      // what the foot line takes below the hexagons: the hovered one in the last row swells down over 0.7 of a radius, and the line goes under that
    let g.y0 = yo + (vh - g.gh - g.foot) / 2          // centred on the screen

    group {
        show: wp_picker_show > 0.01
        opacity: wp_picker_show * wp_picker_veil
        //  No sheet over the screen, on either page (the cards change the wallpaper live under them, and it has to be seen): only a soft shade rises from the foot, for the
        //  words, the same on both.
        //  (Each box runs to the foot and lies over the one before, so the dark rises in even steps of 3%; boxes side by side showed a line at each edge.)
        repeat k in 0..24 {
            box { from: 0, yo + vh - 420 + k * 17.5; size: screen.width, 420 - k * 17.5; color: #05070d; opacity: 0.03 / (1 - 0.03 * k) }
        }
        //  Where the pointer is on the hovered tile, for its tilt: a grid of invisible zones laid over it, 7 across and 8 down, each of which
        //  notes the pointer as it comes in. The tile's shader cannot be told (a group's shader is not given the pointer), and reading `cursor`
        //  instead made pleamar poll the mouse all the time. Declared before the tiles, so a press still goes to the tile under it.
        let tl.w = 1.732 * g.R * 0.93 * (1 + 0.8 * wp_picker_hs)
        let tl.h = 2 * g.R * 0.93 * (1 + 0.8 * wp_picker_hs)
        repeat k in 0..56 {
            zone box wp_tilt.$k { at: wp_picker_lx + (mod(k, 7) - 3) * tl.w / 7, wp_picker_ly + (floor(k / 7) - 3.5) * tl.h / 8; size: tl.w / 7 + 1, tl.h / 8 + 1; active: wp_picker_hot >= 0 and wp_picker_open and wp_picker_leaving == 0 and wp_pgp < 0.1 }
            on enter wp_tilt.$k { wp_picker_tx: clamp((pointer.x - wp_picker_lx) / tl.w, -0.6, 0.6); wp_picker_ty: clamp((pointer.y - wp_picker_ly) / tl.h, -0.6, 0.6) }
        }
        repeat i in 0..200 {
            let grow = floor(i / g.cols)
            let bx = g.x0 + g.w * (i - grow * g.cols + 0.5 + 0.5 * mod(grow, 2))
            let by = g.y0 + g.R + grow * 1.5 * g.R
            let hv = wp_picker_z.$i.hover
            let cu = if(wp_picker.$i.cur, 1, 0)
            let ent = clamp(wp_picker_show * 2.4 - i * 0.008, 0, 1)
            let dxh = bx - wp_picker_lx
            let dyh = by - wp_picker_ly
            let xx = length(dxh, dyh) / g.sg
            let ee = exp(-xx * xx)
            let ring = 1 - 0.26 * clamp(wp_picker_hs, 0, 1) * exp(-pow((xx - 1.25) / 0.6, 2))
            let bxl = wp_picker_lx + dxh * (1 + g.K * ee)              // where the others have been pushed to, to make room
            let byl = wp_picker_ly + dyh * (1 + g.K * ee)
            let gi = gt.$i
            let rr = g.R * 0.93 * (0.6 + 0.4 * ent) * ring * (1 + 0.8 * gi)
            group {
                show: i < g.n and i < wp_picker.count and wp_picker_hot != i
                //  The fade goes on each shape, not on the group: a group with an opacity (or a clip) is drawn in a layer of its own, and the renderer gives only
                //  sixty-four of those a frame, so the lower tiles lost their opacity and the hovered one its tilt. The pictures are already cut to the hexagon.
                let to = ent * if(wp_picker.$i.dim, 25%, 1) 
                //  No blurred shadow under the resting tiles: a hundred and forty blur passes a frame were most of what this page cost. The hovered tile has its own.
                // (a plain path, not a `body`: a body is a layer of its own, and its rectangle's edge showed as a faint line across the small tiles)
                path { at: bxl, byl; color: #05070d; opacity: 30% * to; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
                image wp_picker.$i.img { at: floor(bxl - 0.866 * rr * 124 / 120 + 0.5), floor(byl - rr * 143 / 139 + 0.5); size: floor(1.732 * rr * 124 / 120 + 0.5), floor(2 * rr * 143 / 139 + 0.5); opacity: to }
                path { at: bxl, byl; stroke: 2.6 + 1.6 * cu; color: mix(#ffffff, mint, cu); opacity: (55% + 45% * max(hv, cu)) * to; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
            }
            //  The hovered one: the same tile as liquid glass. Its group's shader adds the light (a soft spot under the pointer, and a band
            //  that sweeps across on arrival), and it stands off the grid on a deeper shadow.
            group {
                show: i < g.n and i < wp_picker.count and wp_picker_hot == i
                shader: liquid, clamp(gi, 0, 1), 22, wp_picker_sw, wp_picker_tx, wp_picker_ty, 0, 0, 0
                //  The hovered tile grows to the large hexagon on its own spring (`gi`), which overshoots a little: that is the bounce.
                opacity: 0.75 + 0.25 * clamp(gi * 4, 0, 1)
                //  Room around the hexagon, so the tilt's perspective has somewhere to reach.
                box { at: bxl, byl; size: 2 * rr + 110, 2 * rr + 110; color: #ffffff; opacity: 0.4% }
                body {
                    color: #05070d
                    opacity: 30%
                    rim: 20%
                    shadow: 0, 20, 40, 80%, #000000
                    path { at: bxl, byl; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
                }
                group {
                    clip path { at: bxl, byl; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
                    image wp_picker.$i.img { at: bxl - 0.866 * rr * 124 / 120, byl - rr * 143 / 139; size: 1.732 * rr * 124 / 120, 2 * rr * 143 / 139 }
                }
                path { at: bxl, byl; stroke: 3.4; color: if(cu > 0, mint, #ffffff); opacity: 95%; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
            }
            //  Its zone is the circle inside the hexagon, as big as the hexagon is now.
            zone box wp_picker_z.$i { at: bxl, byl; size: 1.732 * rr, 1.732 * rr; corner: 0.866 * rr; cursor: pointer; active: i < g.n and i < wp_picker.count and wp_picker_show > 0.5 and wp_picker_leaving == 0 and wp_pgp < 0.1 }
            on enter wp_picker_z.$i { wp_picker_hot = i; wp_picker_hx = bx; wp_picker_hy = by }
            on away wp_picker_z.$i for 200ms while wp_picker_hot == i { wp_picker_hot = -1 }
            on press wp_picker_z.$i { wp_picker_px = bxl; wp_picker_py = mh - byl; emit wp_picker_pick(i) }
        }

        //  The foot: the name of the one under the pointer, or a line of help; and Random.
        let fy = g.y0 + g.gh + g.foot - 22
        //  The words are the cards' words: the name in the wallpaper's own accent (24, bold), and under it what it is (14), in the same faces and sizes.
        text wp_picker_hero_name { at: floor(cx + g.pgx + 0.5), floor(fy - 6 + 0.5); anchor: center; align: center; size: 24; weight: 700; width: 900; lines: 1; color: rgb(wp_hr, wp_hg, wp_hb); family: "Space Grotesk"; show: wp_picker_hot >= 0 }
        text wp_hex_info { at: floor(cx + g.pgx + 0.5), floor(fy + 22 + 0.5); anchor: center; align: center; size: 14; weight: 500; width: 900; lines: 1; color: #ffffff; opacity: 80%; family: "Space Grotesk"; show: wp_picker_hot >= 0 }
        text "Pick a wallpaper  ·  Tab for the cards  ·  Esc or a click outside closes" { at: floor(cx + g.pgx + 0.5), floor(fy + 0.5); anchor: center; align: center; size: 13; color: #ffffff; opacity: 45%; family: "Space Grotesk"; show: wp_picker_hot < 0 and wp_picker.count > 0 }
        text wp_picker_status { at: floor(cx + g.pgx + 0.5), floor(yo + vh / 2 + 0.5); anchor: center; align: center; size: 16; weight: 600; width: 600; lines: 1; color: #ffffff; opacity: 70%; family: "Space Grotesk"; show: wp_picker.count < 1 }

        //  ── the cards ────────────────────────────────────────────────
        //  A row of tall slanted slices, the one in focus opened out into a wide card (after Ryoku's carousel). Slot `s` holds the list's number `ix` (the logic
        //  fills them in drawing order: the left side outwards in, then the right side from far to near, so a nearer slice lies over a farther one). A slice's
        //  place comes from its distance `d` to `wp_cpos`, which glides, so a slice keeps moving when the slots are refilled one place along. The focused
        //  picture is `wp_big`, drawn over its slice in the same shape; there are two of them, so the one that has just lost the focus can shrink back.
        let wc.px = (1 - wp_pgp) * screen.width
        let wc.cxm = cx + wc.px
        let wc.W = clamp(screen.width * 0.34, 400, 660)              // the focused card
        let wc.H = wc.W * 9 / 16
        let wc.sw = wc.W * 0.14                                      // a slice
        let wc.sh = wc.H * 0.9
        let wc.gap = -wc.sw * 0.28                                   // they overlap
        let wc.sk = wc.sw * 0.26                                     // how far the top is slanted over
        let wc.step = wc.sw + wc.gap
        let wc.yb = yo + vh - 206                                    // the bottom of the focused card
        let wc.yc = wc.yb - wc.H / 2
        let wc.ext = 0                                               // (the focused card used to have a panel hanging under its picture; its words are now over the picture's foot, and this is 0)
        //  The slices are centred on the focused card as a whole, its panel too: `wc.ext / 2` lower than the picture's middle, which is where they come from (the focus moves up
        //  to its own middle as a card opens out).
        let wc.ar = wp_ar
        let wc.ag = wp_ag
        let wc.ab = wp_ab
        let wc.acc = rgb(wc.ar, wc.ag, wc.ab)
        //  The wobble: a card bows against the way the row is going (the middle of its sides leads, top and foot trail), and as the spring overshoots and the speed turns, it bows back and settles. `wc.bnd` px.
        let wc.bnd = clamp((wp_cpos - wp_clag) * wc.sw * 0.9, -wc.sw * 0.4, wc.sw * 0.4)
        //  The colour filter, under the cards, the same twelve swatches as the Settings' wallpaper page (and the same filter): the cards narrow to the wallpapers of the lit colour; it is
        //  pressed again to clear it.
        repeat i in 0..12 {
            let sw.x = wc.cxm + (i - 5.5) * 28
            let sw.y = wc.yb + wc.ext + 30                          // under the card's panel
            let sw.lit = if(wp_filter == i, 1, 0)
            let sw.a = clamp(wp_ce3 * 1.6, 0, 1)
            box { at: sw.x, sw.y; size: 18 + 4 * sw.lit, 18 + 4 * sw.lit; corner: 5; color: pick(i, #e53935, #fb8c00, #fdd835, #43a047, #00acc1, #1e88e5, #8e24aa, #ec407a, #6d4c41, #f5f5f5, #9e9e9e, #212121); opacity: sw.a }
            box { at: sw.x, sw.y; size: 18 + 4 * sw.lit, 18 + 4 * sw.lit; corner: 5; stroke: 1; color: #000000; opacity: 35% * sw.a }
            box { at: sw.x, sw.y; size: 26, 26; corner: 7; stroke: 2; color: wc.acc; opacity: sw.lit * sw.a }
            zone box wp_cswatch.$i { at: sw.x, sw.y; size: 26, 26; corner: 7; cursor: pointer; active: wp_pg == 1 and wp_pgp > 0.6 and wp_picker_show > 0.5 }
            on press wp_cswatch.$i { emit wp_filter_set(i) }
        }
        repeat s in 0..15 {
            let wc.d = wp_cards.$s.ix - wp_cpos
            let wc.e = 1 - min(1, abs(wc.d))
            //  The cards come in one after another, from the focused one outwards (as the hexagons do in order): each drops into place from well below, growing from half size, on the same spring as the panels: it overshoots as it lands. It follows the picker
            //  opening and the swipe from the hexagons alike (the lesser of the two).
            let wc.rk = min(7, floor(abs(wc.d) + 0.5))
            let wc.ep = pick(wc.rk, wp_ce0, wp_ce1, wp_ce2, wp_ce3, wp_ce4, wp_ce5, wp_ce6, wp_ce7)      // the drop's own spring: it goes past 1 and comes back
            let wc.en = clamp(wc.ep * 1.6, 0, 1)
            //  An accordion: the further from the focus, the smaller the slice (full size beside it, then a step smaller, then a smaller one still), and the row bunches up with it.
            let wc.f = 1 - 0.15 * clamp(abs(wc.d) - 1, 0, 1) - 0.15 * clamp(abs(wc.d) - 2, 0, 1)
            let wc.x1 = clamp(abs(wc.d) - 1, 0, 1)
            let wc.x2 = clamp(abs(wc.d) - 2, 0, 1)
            let wc.fx = wc.x1 * (1 - 0.075 * wc.x1) + wc.x2 * (0.85 - 0.075 * wc.x2) + 0.7 * max(abs(wc.d) - 3, 0)
            let wc.k = wc.sk * wc.f
            let wc.w = mix(wc.sw * wc.f, wc.W, wc.e) * (0.5 + 0.5 * wc.ep)
            let wc.h = mix(wc.sh * wc.f, wc.H, wc.e) * (0.5 + 0.5 * wc.ep)
            let wc.l = if(wc.d < -1, wc.cxm - wc.W / 2 - wc.gap - wc.fx * 0.72 * wc.sw - wc.w, if(wc.d < 0, wc.cxm - wc.W / 2 + wc.d * wc.step, mix(wc.cxm - wc.W / 2, wc.cxm + wc.W / 2 + wc.gap, min(wc.d, 1)) + wc.fx * 0.72 * wc.sw))
            //  Every card has the same rounded corners, focused or not.
            let wc.r = 18
            let wc.ln = length(wc.k, wc.h)
            let wc.nx = -wc.k / wc.ln
            let wc.ny = wc.h / wc.ln
            let wc.brx = wc.w - wc.k
            let wc.m = -wc.bnd
            let wc.t = wc.yc + wc.ext / 2 * (1 - wc.e) - wc.h / 2 + (1 - wc.ep) * 170
            let wc.a = clamp(8 - abs(wc.d), 0, 1) * clamp(wp_pgp * 3, 0, 1) * wc.en
            group {
                show: wp_cards.$s.ok and wc.a > 0.01 and wp_pgp > 0.01
                //  The fade goes on each shape (see the hexagons): a group with an opacity is a layer of its own, and there are only sixty-four a frame.
                group {
                    clip path { at: wc.l, wc.t; move wc.k + wc.r, 0; line wc.w - wc.r, 0; curve wc.w + wc.r * wc.nx, wc.r * wc.ny via wc.w, 0; curve wc.brx - wc.r * wc.nx, wc.h - wc.r * wc.ny via (wc.w + wc.brx) / 2 + 2 * wc.m, wc.h / 2; curve wc.brx - wc.r, wc.h via wc.brx, wc.h; line wc.r, wc.h; curve -wc.r * wc.nx, wc.h - wc.r * wc.ny via 0, wc.h; curve wc.k + wc.r * wc.nx, wc.r * wc.ny via wc.k / 2 + 2 * wc.m, wc.h / 2; curve wc.k + wc.r, 0 via wc.k, 0; close }
                    box { at: wc.l + wc.w / 2, wc.t + wc.h / 2; size: wc.w, wc.h; color: #10131c; opacity: wc.a }
                    image wp_cards.$s.img { at: wc.l + wc.w / 2 - max(wc.w, wc.h * 0.444) / 2, wc.t + wc.h / 2 - max(wc.h, wc.w * 2.25) / 2; size: max(wc.w, wc.h * 0.444), max(wc.h, wc.w * 2.25); opacity: wc.a * (1 - wc.e) }       // gone as it opens out: the big picture takes over, and until it is there a dark card is better than the strip blown up
                    box { at: wc.l + wc.w / 2, wc.t + wc.h / 2; size: wc.w, wc.h; color: #05070d; opacity: 42% * wc.a }
                }
                path { at: wc.l, wc.t; stroke: 1; color: #ffffff; opacity: 22% * wc.a; move wc.k + wc.r, 0; line wc.w - wc.r, 0; curve wc.w + wc.r * wc.nx, wc.r * wc.ny via wc.w, 0; curve wc.brx - wc.r * wc.nx, wc.h - wc.r * wc.ny via (wc.w + wc.brx) / 2 + 2 * wc.m, wc.h / 2; curve wc.brx - wc.r, wc.h via wc.brx, wc.h; line wc.r, wc.h; curve -wc.r * wc.nx, wc.h - wc.r * wc.ny via 0, wc.h; curve wc.k + wc.r * wc.nx, wc.r * wc.ny via wc.k / 2 + 2 * wc.m, wc.h / 2; curve wc.k + wc.r, 0 via wc.k, 0; close }
            }
            zone box wp_card_z.$s { at: wc.l + wc.w / 2, wc.t + wc.h / 2; size: wc.w - wc.k, wc.h; cursor: pointer; active: wp_cards.$s.ok and wp_pg == 1 and wp_pgp > 0.6 and wp_picker_show > 0.5 and abs(wc.d) < 7 }
            on press wp_card_z.$s { emit wp_card_go(wp_cards.$s.ix) }
        }
        repeat b in 0..2 {
            let wb.d = wp_big.$b.ix - wp_cpos
            let wb.e = 1 - min(1, abs(wb.d))
            //  The cards come in one after another, from the focused one outwards (as the hexagons do in order): each drops into place from well below, growing from half size, on the same spring as the panels: it overshoots as it lands. It follows the picker
            //  opening and the swipe from the hexagons alike (the lesser of the two).
            let wb.rk = min(7, floor(abs(wb.d) + 0.5))
            let wb.ep = pick(wb.rk, wp_ce0, wp_ce1, wp_ce2, wp_ce3, wp_ce4, wp_ce5, wp_ce6, wp_ce7)      // the drop's own spring: it goes past 1 and comes back
            let wb.en = clamp(wb.ep * 1.6, 0, 1)
            //  An accordion: the further from the focus, the smaller the slice (full size beside it, then a step smaller, then a smaller one still), and the row bunches up with it.
            let wb.f = 1 - 0.15 * clamp(abs(wb.d) - 1, 0, 1) - 0.15 * clamp(abs(wb.d) - 2, 0, 1)
            let wb.x1 = clamp(abs(wb.d) - 1, 0, 1)
            let wb.x2 = clamp(abs(wb.d) - 2, 0, 1)
            let wb.fx = wb.x1 * (1 - 0.075 * wb.x1) + wb.x2 * (0.85 - 0.075 * wb.x2) + 0.7 * max(abs(wb.d) - 3, 0)
            let wb.k = wc.sk * wb.f
            let wb.w = mix(wc.sw * wb.f, wc.W, wb.e) * (0.5 + 0.5 * wb.ep)
            let wb.h = mix(wc.sh * wb.f, wc.H, wb.e) * (0.5 + 0.5 * wb.ep)
            let wb.l = if(wb.d < -1, wc.cxm - wc.W / 2 - wc.gap - wb.fx * 0.72 * wc.sw - wb.w, if(wb.d < 0, wc.cxm - wc.W / 2 + wb.d * wc.step, mix(wc.cxm - wc.W / 2, wc.cxm + wc.W / 2 + wc.gap, min(wb.d, 1)) + wb.fx * 0.72 * wc.sw))
            let wb.t = wc.yc + wc.ext / 2 * (1 - wb.e) - wb.h / 2 + (1 - wb.ep) * 170
            let wb.a = clamp(8 - abs(wb.d), 0, 1) * clamp(wp_pgp * 3, 0, 1) * wb.en
            //  The focused card has a dark panel hanging under its picture (its name and what it is), and rounded corners. Its sides go on slanting at the same angle.
            let wb.ext = wc.ext * wb.e
            let wb.H = wb.h + wb.ext
            let wb.ske = wb.k * wb.ext / wb.h
            let wb.ln = length(wb.k + wb.ske, wb.H)
            let wb.nx = -(wb.k + wb.ske) / wb.ln
            let wb.ny = wb.H / wb.ln
            let wb.r = 18
            let wb.brx = wb.w - wb.k - wb.ske
            let wb.m = -wc.bnd * (1 - 0.6 * wb.e)
            //  The card's own ripple when it is kept, as the island bar's when a panel closes (`cardrip.wgsl`): two crests run out along its top and foot edges from the middle,
            //  and the picture and panel bulge where they pass. All in pixels from the middle of the group's box (`wb.bx`, `wb.by`); the box is larger than the card, to give the
            //  bulge room.
            let wb.rq = 10 + 0.55 * wb.w * wp_crip
            let wb.rh = 22 * (1 - wp_crip) * clamp(wp_crip * 6, 0, 1) * clamp(wb.e * 2 - 1, 0, 1)
            let wb.bx = wb.l + (wb.w - wb.ske) / 2
            let wb.by = wb.t + wb.H / 2
            group {
                show: wp_big.$b.ok and wb.a > 0.01 and wb.e > 0.02 and wp_pgp > 0.01
                shader: cardrip, wb.rq, wb.rh, wb.l + (wb.k + wb.w) / 2 - wb.bx, wb.l + (wb.brx - wb.ske) / 2 - wb.bx, wb.t - wb.by, wb.t + wb.H - wb.by, 46, 60
                box { at: wb.bx, wb.by; size: wb.w + wb.ske + 240, wb.H + 160; color: #ffffff; opacity: 0.4% }
                group {
                    clip path { at: wb.l, wb.t; move wb.k + wb.r, 0; line wb.w - wb.r, 0; curve wb.w + wb.r * wb.nx, wb.r * wb.ny via wb.w, 0; curve wb.brx - wb.r * wb.nx, wb.H - wb.r * wb.ny via (wb.w + wb.brx) / 2 + 2 * wb.m, wb.H / 2; curve wb.brx - wb.r, wb.H via wb.brx, wb.H; line -wb.ske + wb.r, wb.H; curve -wb.ske - wb.r * wb.nx, wb.H - wb.r * wb.ny via -wb.ske, wb.H; curve wb.k + wb.r * wb.nx, wb.r * wb.ny via (wb.k - wb.ske) / 2 + 2 * wb.m, wb.H / 2; curve wb.k + wb.r, 0 via wb.k, 0; close }
                    image wp_big.$b.img { at: wb.l + wb.w / 2 - max(wb.w, wb.h * 1.7778) / 2, wb.t + wb.h / 2 - max(wb.h, wb.w * 0.5625) / 2; size: max(wb.w, wb.h * 1.7778), max(wb.h, wb.w * 0.5625); opacity: wb.a * clamp(wb.e * 4, 0, 1) }
                    box { at: wb.l + wb.w / 2, wb.t + wb.h / 2; size: wb.w, wb.h; color: #05070d; opacity: 42% * (1 - wb.e) * wb.a }
                    //  The words' ground on the focused card: the foot of the picture, darkened more towards the bottom (the clip gives it the card's shape). Each box runs to the
                    //  bottom and lies over the one before, so the dark builds up smoothly; bands side by side left a hairline between them.
                    repeat k in 0..16 {
                        box { from: wb.l - 30, wb.t + wb.h - 100 + k * 6.25; size: wb.w + 60, 110 - k * 6.25; color: #05070d; opacity: 3.2% * clamp(wb.e * 2 - 1, 0, 1) * wb.a }
                    }
                }
                //  The ring: faint on the slices, the wallpaper's own accent on the one in focus.
                path { at: wb.l, wb.t; stroke: 1; color: #ffffff; opacity: 22% * (1 - wb.e) * wb.a; move wb.k + wb.r, 0; line wb.w - wb.r, 0; curve wb.w + wb.r * wb.nx, wb.r * wb.ny via wb.w, 0; curve wb.brx - wb.r * wb.nx, wb.H - wb.r * wb.ny via (wb.w + wb.brx) / 2 + 2 * wb.m, wb.H / 2; curve wb.brx - wb.r, wb.H via wb.brx, wb.H; line -wb.ske + wb.r, wb.H; curve -wb.ske - wb.r * wb.nx, wb.H - wb.r * wb.ny via -wb.ske, wb.H; curve wb.k + wb.r * wb.nx, wb.r * wb.ny via (wb.k - wb.ske) / 2 + 2 * wb.m, wb.H / 2; curve wb.k + wb.r, 0 via wb.k, 0; close }
                //  A tag on the one in use.
                group {
                    show: wp_big.$b.cur and wb.e > 0.6
                    box { at: wb.l + wb.k + 52, wb.t + 26; size: 84, 24; corner: 12; color: #05070d; opacity: 62% * wb.e * wb.a }
                    box { at: wb.l + wb.k + 52, wb.t + 26; size: 84, 24; corner: 12; stroke: 1.5; color: wc.acc; opacity: 90% * wb.e * wb.a }
                    text "IN USE" { at: floor(wb.l + wb.k + 52 + 0.5), floor(wb.t + 26 + 0.5); anchor: center; align: center; size: 12; weight: 700; color: wc.acc; outline: 1, #0a0a0a; opacity: wb.e * wb.a; family: "Space Grotesk" }
                }
                //  Its name in its own accent, and what it is. (Both are the focus's: while the old one shrinks back they fade out with its panel.)
                group {
                    show: wb.e > 0.5
                    let wb.px = wb.l + (wb.w + wb.k) / 2 - wb.k * (wb.h - 38) / wb.h
                    text wp_card_name { at: floor(wb.px + 0.5), floor(wb.t + wb.h - 50 + 0.5); anchor: center; align: center; size: 24; weight: 700; width: wb.w - 2 * wb.k - 40; lines: 1; color: wc.acc; outline: 1.2, #0a0a0a; opacity: clamp(wb.e * 2 - 1, 0, 1) * wb.a; family: "Space Grotesk" }
                    text wp_card_info { at: floor(wb.px + 0.5), floor(wb.t + wb.h - 22 + 0.5); anchor: center; align: center; size: 14; weight: 500; width: wb.w - 2 * wb.k - 40; lines: 1; color: #ffffff; outline: 1, #0a0a0a; opacity: 90% * clamp(wb.e * 2 - 1, 0, 1) * wb.a; family: "Space Grotesk" }
                }
            }
        }
        //  Under the card: the keys.
        text "Left and Right browse  ·  Enter keeps one  ·  Esc puts the old one back  ·  Tab goes back to the hexagons" { at: floor(wc.cxm + 0.5), floor(wc.yb + wc.ext + 66 + 0.5); anchor: center; align: center; size: 13; color: #ffffff; opacity: 45% * clamp(wp_pgp * 3, 0, 1); family: "Space Grotesk" }
        //  Which page it is on: two dots at the foot.
        ellipse { at: cx - 9, yo + vh - 24; radius: 3.5 + 1.5 * (1 - wp_pgp); color: mint; opacity: 35% + 65% * (1 - wp_pgp) }
        ellipse { at: cx + 9, yo + vh - 24; radius: 3.5 + 1.5 * wp_pgp; color: mint; opacity: 35% + 65% * wp_pgp }
        zone box wp_pg_dot0 { at: cx - 9, yo + vh - 24; size: 18, 18; corner: 9; cursor: pointer; active: wp_picker_show > 0.5 }
        zone box wp_pg_dot1 { at: cx + 9, yo + vh - 24; size: 18, 18; corner: 9; cursor: pointer; active: wp_picker_show > 0.5 }
        on press wp_pg_dot0 { wp_pg = 0 }
        on press wp_pg_dot1 { wp_pg = 1 }
        //  Only here to be focused when the picker opens: it has Hyprland lend the keyboard to this copy of the shell (opened from SUPER+B, the focus stayed on the
        //  window below, and the arrows did nothing until the pointer was over a card). `passive`: it takes no key, so the arrows, Tab, Enter and Esc reach the rules below.
        input wp_kb { at: cx - 2, yo + vh - 24; width: 4; size: 10; color: ink; opacity: 0; passive: true }
    }

    include "pages/overview.plm"
    include "pages/dashboard.plm"

    //  ── the authentication dialog ────────────────────────────────────────────────────────────────────────────────────────────
    //  A card in the bar's glass, in the upper third of the screen, over a dimmed desktop. It is modal: the veil takes every press.
    group {
        show: pk_show > 0.01
        opacity: pk_show
        let pk.cy = yo + vh * 0.34 - 14 * u * (1 - pk_show)
        let pk.x = cx + pk_sk * 14 * u
        let pk.top = pk.cy - 128 * u
        let pk.l = pk.x - 176 * u
        box { at: cx, screen.height / 2; size: screen.width, screen.height; color: #000000; opacity: 34% }
        zone box pk_block { at: cx, screen.height / 2; size: screen.width, screen.height; cursor: pointer }
        body {
            color: mix(tint, #000000, cy_dark * cy_k)
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend and gbm > 0.5
            frost: glass_clear
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            rim: 14% * glass_rim
            shadow: 0, 18 * u, 50 * u, 45%, deep
            show: obs < 0.996 and not glass_auto
            box { at: pk.x, pk.cy; size: 400 * u, 256 * u; corner: rc }
        }
        //  The same glass with `frost: auto` (frosted only where what is behind is busy): `frost:` cannot take `auto` from an expression, so it is a body of its own.
        body {
            color: mix(tint, #000000, cy_dark * cy_k)
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend and gbm > 0.5
            frost: auto
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            rim: 14% * glass_rim
            shadow: 0, 18 * u, 50 * u, 45%, deep
            show: obs < 0.996 and glass_auto
            box { at: pk.x, pk.cy; size: 400 * u, 256 * u; corner: rc }
        }
        //  Blur behind the obsidian: a glass body asks the compositor for it (100 % glass at 34 %: the request needs glass x opacity of 30 % or more, and a more opaque layer would hide the blur), and the obsidian over it (60 % opaque while blur is on, solid when it is off) hides the glass's look.
        body {
            color: obsidian
            glass: 100%
            lens: false
            rim: 0%
            refraction: 0%
            dispersion: 0%
            shine: 9000, 9000
            opacity: obs * 0.34 * (1 - pk)
            show: obs > 0.97
            box { at: pk.x, pk.cy; size: 400 * u, 256 * u; corner: rc }
        }
        body {
            color: obsidian
            rim: 0%
            opacity: obs * (1 - 0.4 * clamp(hy_blur, 0, 1))
            shadow: 0, 18 * u, 60 * u, (55%) * (1 - pk), #000000
            show: obs > 0.004
            box { at: pk.x, pk.cy; size: 400 * u, 256 * u; corner: rc }
        }
        //  The Cassette's plastic over it (see `cas_k`): a lit lip, a dark outline, a hard shadow.
        body {
            color: obsidian
            rim: 40% * cas_k
            border: 1.7 * u * cas_k, deep
            shadow: 4.5 * u * cas_k, 5.5 * u * cas_k, 0, 55% * cas_k, deep
            opacity: cas_k
            show: cas_k > 0.004
            box { at: pk.x, pk.cy; size: 400 * u, 256 * u; corner: rc }
        }
        //  The UwU's candy plastic over it: a pastel gradient across the whole screen (pink, lilac, sky, mint), a thick grape outline, a lit lip and a hard pink shadow.
        body {
            gradient: 0, 0 to screen.width, screen.height, #ffcfe8, #e6d6ff 38%, #cfeaff 68%, #d2fff0
            rim: 55% * uwu_k
            border: 3 * u * uwu_k, deep
            shadow: 4 * u * uwu_k, 5 * u * uwu_k, 0, 90% * uwu_k, mix(deep, #ff6ec7, 0.75)
            opacity: uwu_k
            show: uwu_k > 0.004
            box { at: pk.x, pk.cy; size: 400 * u, 256 * u; corner: rc }
        }
        zone box pk_card { at: pk.x, pk.cy; size: 400 * u, 256 * u; corner: rc }
        //  A padlock, then the title.
        path { at: pk.l + 12 * u, pk.top + 38 * u; stroke: 1.7 * u; color: mint; move -4 * u, -1 * u; line -4 * u, -5 * u; curve 4 * u, -5 * u via 0, -12 * u; line 4 * u, -1 * u }
        box { at: pk.l + 12 * u, pk.top + 41 * u; size: 15 * u, 11 * u; corner: 3 * u; stroke: 1.7 * u; color: mint }
        text "Authentication required" { at: floor(pk.l + 32 * u + 0.5), floor(pk.top + 38 * u + 0.5); anchor: left center; size: 15; weight: 700; color: ink; family: "Space Grotesk" }
        text pk_message { at: floor(pk.l + 0.5), floor(pk.top + 62 * u + 0.5); anchor: left top; size: 11.5; width: 352 * u; lines: 3; color: ink; opacity: 78%; family: "Space Grotesk" }
        //  Whose password it is.
        ellipse { at: pk.l + 10 * u, pk.top + 132 * u; radius: 9 * u; color: mint; opacity: 24% }
        ellipse { at: pk.l + 10 * u, pk.top + 129 * u; radius: 2.6 * u; color: mint }
        path { at: pk.l + 10 * u, pk.top + 138 * u; stroke: 1.5 * u; color: mint; move -4.5 * u, 0; curve 4.5 * u, 0 via 0, -7 * u }
        text pk_user { at: floor(pk.l + 28 * u + 0.5), floor(pk.top + 132 * u + 0.5); anchor: left center; size: 12; weight: 600; color: ink; family: "Space Grotesk" }
        //  The password field.
        box { at: pk.x, pk.top + 166 * u; size: 352 * u, 38 * u; corner: 13 * u; color: ink; opacity: 8% }
        box { at: pk.x, pk.top + 166 * u; size: 352 * u, 38 * u; corner: 13 * u; stroke: 1.4 * u; color: mint; opacity: 40% + 50% * pk_sk * pk_sk }
        input pk_pw { at: floor(pk.l + 14 * u + 0.5), floor(pk.top + 166 * u - 8 * u + 0.5); width: 324 * u; size: 14 * u; color: ink; family: "Space Grotesk"; placeholder: "Password"; secret: true }
        text pk_error { at: floor(pk.l + 2 * u + 0.5), floor(pk.top + 194 * u + 0.5); anchor: left center; size: 10.5; width: 350 * u; lines: 1; color: mint; family: "Space Grotesk"; show: pk_shake and not pk_busy }
        text "Checking…" { at: floor(pk.l + 2 * u + 0.5), floor(pk.top + 194 * u + 0.5); anchor: left center; size: 10.5; color: faint; family: "Space Grotesk"; show: pk_busy }
        //  Cancel and Authenticate.
        box { at: pk.x - 88 * u, pk.top + 226 * u; size: 172 * u, 32 * u; corner: 14 * u; color: ink; opacity: 8% + 9% * pk_cancel_hit.hover }
        text "Cancel" { at: floor(pk.x - 88 * u + 0.5), floor(pk.top + 226 * u + 0.5); anchor: center; align: center; size: 12; weight: 600; color: ink; family: "Space Grotesk" }
        zone box pk_cancel_hit { at: pk.x - 88 * u, pk.top + 226 * u; size: 174 * u, 34 * u; corner: 15 * u; cursor: pointer }
        on press pk_cancel_hit { pk_open = false }
        box { at: pk.x + 88 * u, pk.top + 226 * u; size: 172 * u, 32 * u; corner: 14 * u; color: mint; opacity: if(pk_busy, 28%, 80% + 20% * pk_ok_hit.hover) }
        text "Authenticate" { at: floor(pk.x + 88 * u + 0.5), floor(pk.top + 226 * u + 0.5); anchor: center; align: center; size: 12; weight: 700; color: onmint; family: "Space Grotesk" }
        zone box pk_ok_hit { at: pk.x + 88 * u, pk.top + 226 * u; size: 174 * u, 34 * u; corner: 15 * u; cursor: pointer; active: not pk_busy }
        on press pk_ok_hit { pk_go = true }
    }

}
