            on press lk_md_hit { emit lk_media_toggle }

            //  Card eight: the power buttons. Each is held for a second on the lock screen.
            box { at: spx + 219 * pu, sby + 674 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Power buttons" { at: floor(spx + 14 * pu + 0.5), floor(sby + 664 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Sleep, restart and power off, at the bottom of the screen" { at: floor(spx + 14 * pu + 0.5), floor(sby + 683 * pu + 0.5); anchor: left center; size: 13.5; width: 300 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(lk_pill_pw, 0, 1))
                box { at: spx + 405 * pu, sby + 674 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu }
            }
            box { at: spx + 397 * pu + lk_pill_pw * 16 * pu, sby + 674 * pu; size: (17 + 9 * clamp(4 * lk_pill_pw * (1 - lk_pill_pw), 0, 1)) * pu, (17 - 3 * clamp(4 * lk_pill_pw * (1 - lk_pill_pw), 0, 1)) * pu; corner: (8.5 - 1.5 * clamp(4 * lk_pill_pw * (1 - lk_pill_pw), 0, 1)) * pu; color: ink }
            zone box lk_pw_hit { at: spx + 405 * pu, sby + 674 * pu; size: 46 * pu, 30 * pu; cursor: pointer; active: (sby + 674 * pu) - lk.off > sby and (sby + 674 * pu) - lk.off < sby + 456 * pu }
            on press lk_pw_hit { emit lk_power_toggle }

            text "The lock screen is not running: start it to change these" { at: floor(spx + 14 * pu + 0.5), floor(sby + 714 * pu + 0.5); anchor: left center; size: 13.5; width: 400 * pu; lines: 1; color: #ef4444; family: "Space Grotesk"; show: not lk_ok }
            }

            let lk.thh = 456 * 456 / max(456, lk.h)
            let lk.thy = lk.thh / 2 + lk.sc / max(1, lk.h - 456) * (456 - lk.thh)
            box { at: spx + 442 * pu, sby + 228 * pu; size: 3 * pu, 456 * pu; corner: 1.5 * pu; color: ink; opacity: if(lk.h > 456, 6%, 0%) }
            box { at: spx + 442 * pu, sby + lk.thy * pu; size: 3 * pu, lk.thh * pu; corner: 1.5 * pu; color: mint; opacity: if(lk.h > 456, 55%, 0%) }
            let lk.cue = clamp((lk.h - 456 - lk.sc) / 24, 0, 1)
            let lk.cuey = sby + (456 - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (400 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * lk.cue }
            }
            box { at: spx + 224 * pu, lk.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * lk.cue }
            box { at: spx + 224 * pu, lk.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * lk_cue_hit.hover) * lk.cue }
            path { at: spx + 204 * pu, lk.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: lk.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, lk.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: lk.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            text "More" { at: floor(spx + 232 * pu + 0.5), floor(lk.cuey + 0.5); anchor: center; size: 15; weight: 700; color: ink; opacity: lk.cue; family: "Space Grotesk" }
            zone box lk_cue_hit { at: spx + 224 * pu, sby + (456 - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: lk.cue > 0.5 }
            on press lk_cue_hit { lk_scroll_to = clamp(lk_scroll_to + 342, 0, max(0, lk.h - 456)) }
            zone box lk_bar_hit { at: spx + 442 * pu, sby + 228 * pu; size: 14 * pu, 456 * pu; cursor: pointer; active: lk.h > 456 }
            on press lk_bar_hit { lk_scroll_to = clamp(((pointer.y - sby) / pu - lk.thh / 2) / max(1, 456 - lk.thh) * (lk.h - 456), 0, max(0, lk.h - 456)) }
            on drag lk_bar_hit { lk_scroll_to = clamp(((pointer.y - sby) / pu - lk.thh / 2) / max(1, 456 - lk.thh) * (lk.h - 456), 0, max(0, lk.h - 456)) }
        }

        //  The Night mode page (Visuals): the switch, how warm the tint is, and when it turns itself on and off.
        group {
            show: set_pgn > 0.01
            opacity: set_pgn
            let ntx0 = spx + 14 * pu
            let ntw = 410 * pu

            //  Card one: the switch.
            box { at: spx + 219 * pu, sby + 26 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Night mode" { at: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text night_status { at: floor(spx + 14 * pu + 0.5), floor(sby + 35 * pu + 0.5); anchor: left center; size: 13.5; width: 300 * pu; lines: 1; color: if(night_on, mint, faint); family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(night_pill, 0, 1))
                box { at: spx + 405 * pu, sby + 26 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu }
            }
            box { at: spx + 397 * pu + night_pill * 16 * pu, sby + 26 * pu; size: (17 + 9 * clamp(4 * night_pill * (1 - night_pill), 0, 1)) * pu, (17 - 3 * clamp(4 * night_pill * (1 - night_pill), 0, 1)) * pu; corner: (8.5 - 1.5 * clamp(4 * night_pill * (1 - night_pill), 0, 1)) * pu; color: ink }
            zone box night_sw_hit { at: spx + 405 * pu, sby + 26 * pu; size: 46 * pu, 30 * pu; cursor: pointer }
            on press night_sw_hit { emit night_toggle }

            //  Card two: how warm. The track is the range itself, from neutral to the warmest, so what is being picked
            //  can be seen; the knob sits where the tint is.
            box { at: spx + 219 * pu, sby + 104 * pu; size: 438 * pu, 84 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "COLOR" { at: floor(spx + 14 * pu + 0.5), floor(sby + 73 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text "Warmth" { at: floor(spx + 14 * pu + 0.5), floor(sby + 94 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            text night_temp_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 94 * pu + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
            body {
                gradient: ntx0, 0 to ntx0 + ntw, 0, #f4f7ff, #ffd9ad 45%, #ff9a45
                rim: 12%
                box { at: ntx0 + ntw / 2, sby + 116 * pu; size: ntw, 12 * pu; corner: 6 * pu }
            }
            ellipse { at: ntx0 + ntw * night_t, sby + 116 * pu; radius: 10 * pu; color: ink }
            ellipse { at: ntx0 + ntw * night_t, sby + 116 * pu; radius: 10 * pu; stroke: 1 * pu; color: #000000; opacity: 30% }
            text "6500 K" { at: floor(ntx0 + 0.5), floor(sby + 137 * pu + 0.5); anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
            text "2500 K" { at: floor(ntx0 + ntw + 0.5), floor(sby + 137 * pu + 0.5); anchor: right center; size: 12; color: faint; family: "Space Grotesk" }
            zone box night_t_hit { at: ntx0 + ntw / 2, sby + 116 * pu; size: ntw + 24 * pu, 30 * pu; cursor: pointer }
            on press night_t_hit { emit night_temp_set(clamp((pointer.x - ntx0) / ntw, 0, 1)) }
            on drag night_t_hit { emit night_temp_set(clamp((pointer.x - ntx0) / ntw, 0, 1)) }

            //  Card three: the schedule. Automatic, and the two times, in half hours.
            box { at: spx + 219 * pu, sby + 240 * pu; size: 438 * pu, 136 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "SCHEDULE" { at: floor(spx + 14 * pu + 0.5), floor(sby + 179 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text "Automatic" { at: floor(spx + 14 * pu + 0.5), floor(sby + 197 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Turns itself on and off at these times" { at: floor(spx + 14 * pu + 0.5), floor(sby + 214 * pu + 0.5); anchor: left center; size: 13.5; width: 300 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(night_auto_pill, 0, 1))
                box { at: spx + 405 * pu, sby + 205 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu }
            }
            box { at: spx + 397 * pu + night_auto_pill * 16 * pu, sby + 205 * pu; size: (17 + 9 * clamp(4 * night_auto_pill * (1 - night_auto_pill), 0, 1)) * pu, (17 - 3 * clamp(4 * night_auto_pill * (1 - night_auto_pill), 0, 1)) * pu; corner: (8.5 - 1.5 * clamp(4 * night_auto_pill * (1 - night_auto_pill), 0, 1)) * pu; color: ink }
            zone box night_auto_hit { at: spx + 405 * pu, sby + 205 * pu; size: 46 * pu, 30 * pu; cursor: pointer }
            on press night_auto_hit { emit night_auto_toggle }
            //  From and Until: dimmed while it is not automatic, and still there to be set.
            group {
                opacity: 40% + 60% * night_auto_pill
                text "From" { at: floor(spx + 14 * pu + 0.5), floor(sby + 245 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
                ellipse { at: spx + 292 * pu, sby + 245 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * night_sm_hit.hover }
                box { at: spx + 292 * pu, sby + 245 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 345 * pu, sby + 245 * pu; size: 78 * pu, 24 * pu; corner: 7 * pu; color: ink; opacity: 8% }
                text night_start_text { at: floor(spx + 345 * pu + 0.5), floor(sby + 245 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: 74 * pu; lines: 1; color: mint; family: "Space Grotesk" }
                ellipse { at: spx + 398 * pu, sby + 245 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * night_sp_hit.hover }
                box { at: spx + 398 * pu, sby + 245 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 398 * pu, sby + 245 * pu; size: 1.6 * pu, 9 * pu; corner: 0.8 * pu; color: ink }
                text "Until" { at: floor(spx + 14 * pu + 0.5), floor(sby + 281 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
                ellipse { at: spx + 292 * pu, sby + 281 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * night_em_hit.hover }
                box { at: spx + 292 * pu, sby + 281 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 345 * pu, sby + 281 * pu; size: 78 * pu, 24 * pu; corner: 7 * pu; color: ink; opacity: 8% }
                text night_end_text { at: floor(spx + 345 * pu + 0.5), floor(sby + 281 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: 74 * pu; lines: 1; color: mint; family: "Space Grotesk" }
                ellipse { at: spx + 398 * pu, sby + 281 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * night_ep_hit.hover }
                box { at: spx + 398 * pu, sby + 281 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 398 * pu, sby + 281 * pu; size: 1.6 * pu, 9 * pu; corner: 0.8 * pu; color: ink }
            }
            zone box night_sm_hit { at: spx + 292 * pu, sby + 245 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            zone box night_sp_hit { at: spx + 398 * pu, sby + 245 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            zone box night_em_hit { at: spx + 292 * pu, sby + 281 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            zone box night_ep_hit { at: spx + 398 * pu, sby + 281 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            on press night_sm_hit { emit night_start_step(-1) }
            on press night_sp_hit { emit night_start_step(1) }
            on press night_em_hit { emit night_end_step(-1) }
            on press night_ep_hit { emit night_end_step(1) }
        }

        //  The About page: the build (this shell's commit and pleamar's version) and the way to update it.
        //  Checking is a `git fetch`, updating a `git pull --ff-only`, and after that the shell starts again.
        group {
            show: set_pga > 0.01
            opacity: set_pga

            box { at: spx + 219 * pu, sby + 70 * pu; size: 438 * pu, 140 * pu; corner: 14 * pu; color: ink; opacity: veil }
            box { at: spx + 219 * pu, sby + 201 * pu; size: 438 * pu, 98 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "BUILD" { at: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text "UPDATE" { at: floor(spx + 14 * pu + 0.5), floor(sby + 165 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }

            text "Vitreus" { at: floor(spx + 14 * pu + 0.5), floor(sby + 40 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            text about_commit { at: floor(spx + 424 * pu + 0.5), floor(sby + 40 * pu + 0.5); anchor: right center; size: 16; weight: 600; width: 300 * pu; lines: 1; align: right; color: ink; family: "Space Grotesk" }
            text "Committed" { at: floor(spx + 14 * pu + 0.5), floor(sby + 66 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            text about_date { at: floor(spx + 424 * pu + 0.5), floor(sby + 66 * pu + 0.5); anchor: right center; size: 16; weight: 600; width: 300 * pu; lines: 1; align: right; color: ink; family: "Space Grotesk" }
            text "Last change" { at: floor(spx + 14 * pu + 0.5), floor(sby + 92 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            text about_sub { at: floor(spx + 424 * pu + 0.5), floor(sby + 92 * pu + 0.5); anchor: right center; size: 15; width: 300 * pu; lines: 1; align: right; color: ink; opacity: 85%; family: "Space Grotesk" }
            text "pleamar" { at: floor(spx + 14 * pu + 0.5), floor(sby + 118 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            text about_pl { at: floor(spx + 424 * pu + 0.5), floor(sby + 118 * pu + 0.5); anchor: right center; size: 16; weight: 600; width: 300 * pu; lines: 1; align: right; color: ink; family: "Space Grotesk" }

            text about_msg { at: floor(spx + 14 * pu + 0.5), floor(sby + 190 * pu + 0.5); anchor: left center; size: 15; width: 410 * pu; lines: 1; color: if(about_behind > 0, mint, faint); family: "Space Grotesk" }

            //  Check for updates.
            box { at: spx + 78 * pu, sby + 226 * pu; size: 128 * pu, 24 * pu; corner: 12 * pu; color: ink; opacity: if(about_busy, 5%, 8% + 10% * about_chk_hit.hover) }
            text "Check for updates" { at: floor(spx + 78 * pu + 0.5), floor(sby + 226 * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 124 * pu; lines: 1; color: ink; opacity: if(about_restarting, 40%, 85%); family: "Space Grotesk" }
            zone box about_chk_hit { at: spx + 78 * pu, sby + 226 * pu; size: 130 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: not about_busy }
            on press about_chk_hit { emit about_check }

            //  Update, and start again: only when there is something to pull.
            box { at: spx + 219 * pu, sby + 226 * pu; size: 128 * pu, 24 * pu; corner: 12 * pu; color: mint; opacity: if(about_behind > 0 and not about_busy, 24% + 12% * about_upd_hit.hover, 6%) }
            text "Update & restart" { at: floor(spx + 219 * pu + 0.5), floor(sby + 226 * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 124 * pu; lines: 1; color: mint; opacity: if(about_behind > 0 and not about_busy, 100%, 35%); family: "Space Grotesk" }
            zone box about_upd_hit { at: spx + 219 * pu, sby + 226 * pu; size: 130 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: about_behind > 0 and not about_busy }
            on press about_upd_hit { emit about_update }

            //  Restart.
            box { at: spx + 360 * pu, sby + 226 * pu; size: 128 * pu, 24 * pu; corner: 12 * pu; color: ink; opacity: if(about_restarting, 5%, 8% + 10% * about_rst_hit.hover) }
            text "Restart shell" { at: floor(spx + 360 * pu + 0.5), floor(sby + 226 * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 124 * pu; lines: 1; color: ink; opacity: if(about_restarting, 40%, 85%); family: "Space Grotesk" }
            zone box about_rst_hit { at: spx + 360 * pu, sby + 226 * pu; size: 130 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: not about_restarting }
            on press about_rst_hit { emit about_restart }
        }

        //  The Hyprland page: layout and gaps, border resize and tearing, animations and input.
        //  Every change goes to Hyprland at once and is kept for the next start (see the Hyprland section of
        //  vitreus.luau). It fits the page, so it does not scroll.
        group {
            show: set_pgh > 0.01
            opacity: set_pgh
            let hsl.x0 = spx + 122 * pu
            let hsl.w = 250 * pu
            let hh = 12 * pu

            box { at: spx + 219 * pu, sby + 104 * pu; size: 438 * pu, 208 * pu; corner: 14 * pu; color: ink; opacity: veil }
            box { at: spx + 219 * pu, sby + 249 * pu; size: 438 * pu, 58 * pu; corner: 14 * pu; color: ink; opacity: veil }
            box { at: spx + 219 * pu, sby + 359 * pu; size: 438 * pu, 138 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "GENERAL & LAYOUT" { at: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text "ANIMATIONS" { at: floor(spx + 14 * pu + 0.5), floor(sby + 233 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text "INPUT" { at: floor(spx + 14 * pu + 0.5), floor(sby + 303 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }

            //  Layout.
            text "Layout" { at: floor(spx + 14 * pu + 0.5), floor(sby + 42 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            repeat i in 0..3 {
                let lx = spx + 164 * pu + i * 90 * pu
                box { at: lx, sby + 42 * pu; size: 84 * pu, 24 * pu; corner: 12 * pu; color: if(hy_layout == i + 1, mint, ink); opacity: if(hy_layout == i + 1, 24%, 8% + 10% * hy_lay_hit.$i.hover) }
                text pick(i, "Dwindle", "Master", "Scrolling") { at: floor(lx + 0.5), floor(sby + 42 * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 80 * pu; lines: 1; color: if(hy_layout == i + 1, mint, ink); family: "Space Grotesk" }
                zone box hy_lay_hit.$i { at: lx, sby + 42 * pu; size: 86 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
                on press hy_lay_hit.$i { emit hy_layout_set(i + 1) }
            }

            //  Gaps, 0 to 30 px.
            text "Gaps" { at: floor(spx + 14 * pu + 0.5), floor(sby + 78 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            body { color: deep; rim: 9%; box { at: hsl.x0 + hsl.w / 2, sby + 78 * pu; size: hsl.w, hh; corner: hh / 2 } }
            group {
                glow: 6 * pu, 50%, mint
                body {
                    gradient: hsl.x0, 0 to hsl.x0 + hsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: hsl.x0, sby + 78 * pu - hh / 2; size: max(0.1, hsl.w * hy_gaps / 30), hh; corner: hh / 2 }
                }
            }
            text hy_gaps_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 78 * pu + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
            zone box hy_gaps_hit { at: hsl.x0 + hsl.w / 2, sby + 78 * pu; size: hsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press hy_gaps_hit { emit hy_gaps_set(clamp((pointer.x - hsl.x0) / hsl.w, 0, 1)) }
            on drag hy_gaps_hit { emit hy_gaps_set(clamp((pointer.x - hsl.x0) / hsl.w, 0, 1)) }

            //  Corner rounding, 0 to 30 px.
            text "Corner rounding" { at: floor(spx + 14 * pu + 0.5), floor(sby + 114 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            body { color: deep; rim: 9%; box { at: hsl.x0 + hsl.w / 2, sby + 114 * pu; size: hsl.w, hh; corner: hh / 2 } }
            group {
                glow: 6 * pu, 50%, mint
                body {
                    gradient: hsl.x0, 0 to hsl.x0 + hsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: hsl.x0, sby + 114 * pu - hh / 2; size: max(0.1, hsl.w * hy_round / 30), hh; corner: hh / 2 }
                }
            }
            text hy_round_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 114 * pu + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
            zone box hy_round_hit { at: hsl.x0 + hsl.w / 2, sby + 114 * pu; size: hsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press hy_round_hit { emit hy_round_set(clamp((pointer.x - hsl.x0) / hsl.w, 0, 1)) }
            on drag hy_round_hit { emit hy_round_set(clamp((pointer.x - hsl.x0) / hsl.w, 0, 1)) }

            //  Sensitivity, -1 to 1.
            text "Sensitivity" { at: floor(spx + 14 * pu + 0.5), floor(sby + 332 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            body { color: deep; rim: 9%; box { at: hsl.x0 + hsl.w / 2, sby + 332 * pu; size: hsl.w, hh; corner: hh / 2 } }
            group {
                glow: 6 * pu, 50%, mint
                body {
                    gradient: hsl.x0, 0 to hsl.x0 + hsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: hsl.x0, sby + 332 * pu - hh / 2; size: max(0.1, hsl.w * (hy_sens + 1) / 2), hh; corner: hh / 2 }
                }
            }
            box { at: hsl.x0 + hsl.w / 2, sby + 332 * pu; size: 1.5 * pu, hh + 6 * pu; corner: 0.75 * pu; color: ink; opacity: 40% }
            text hy_sens_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 332 * pu + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
            zone box hy_sens_hit { at: hsl.x0 + hsl.w / 2, sby + 332 * pu; size: hsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press hy_sens_hit { emit hy_sens_set(clamp((pointer.x - hsl.x0) / hsl.w, 0, 1)) }
            on drag hy_sens_hit { emit hy_sens_set(clamp((pointer.x - hsl.x0) / hsl.w, 0, 1)) }

            //  Focus follows the mouse: off, on, loose, full.
            text "Follow mouse" { at: floor(spx + 14 * pu + 0.5), floor(sby + 368 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            repeat i in 0..4 {
                let fx = spx + 152 * pu + i * 66 * pu
                box { at: fx, sby + 368 * pu; size: 60 * pu, 24 * pu; corner: 12 * pu; color: if(hy_follow == i, mint, ink); opacity: if(hy_follow == i, 24%, 8% + 10% * hy_fol_hit.$i.hover) }
                text pick(i, "Off", "On", "Loose", "Full") { at: floor(fx + 0.5), floor(sby + 368 * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 56 * pu; lines: 1; color: if(hy_follow == i, mint, ink); family: "Space Grotesk" }
                zone box hy_fol_hit.$i { at: fx, sby + 368 * pu; size: 62 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
                on press hy_fol_hit.$i { emit hy_follow_set(i) }
            }

            //  The switches: resize from the border, tearing, animations, natural scroll.
            repeat i in 0..4 {
                let ty = sby + pick(i, 150, 184, 258, 404) * pu
                let tk = pick(i, hy_k0, hy_k1, hy_k2, hy_k3)
                text pick(i, "Resize from border", "Allow screen tearing", "Window manager animations", "Natural scroll (touchpad)") { at: floor(spx + 14 * pu + 0.5), floor(ty - 6 * pu + 0.5); anchor: left center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk" }
                text pick(i, "Grab a window's edge anywhere to resize it", "Lets opted-in fullscreen apps skip vsync", "Hyprland's own window and workspace motion", "Reverses the touchpad's scroll direction") { at: floor(spx + 14 * pu + 0.5), floor(ty + 8 * pu + 0.5); anchor: left center; size: 13; color: faint; family: "Space Grotesk" }
                box { at: spx + 404 * pu, ty; size: 40 * pu, 22 * pu; corner: 11 * pu; color: mix(ink, mint, tk); opacity: 14% + 34% * tk + 8% * hy_tg_hit.$i.hover }
                ellipse { at: spx + (404 - 9 + 18 * tk) * pu, ty; radius: 8 * pu; color: mix(ink, mint, tk); opacity: 80% + 20% * tk }
                zone box hy_tg_hit.$i { at: spx + 219 * pu, ty; size: 430 * pu, 32 * pu; corner: 10 * pu; cursor: pointer }
                on press hy_tg_hit.$i { emit hy_toggle(i) }
            }
        }

        //  The Pleamar-WM page: layout, gaps and effects (live, kept in wm.json) and the input lines of session.conf (next login).
        group {
            show: set_pgw > 0.01
            opacity: set_pgw
            let wm.sc = clamp(wm_scroll, 0, max(0, wm.h - 456))
            let wm.off = floor(wm.sc * pu + 0.5)        // whole pixels: text shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pu, sby + 228 * pu; size: 456 * pu, 456 * pu }
            zone box wm_wheel { at: spx + 219 * pu, sby + 228 * pu; size: 446 * pu, 456 * pu }
            on scroll wm_wheel { wm_scroll_to = clamp(wm_scroll_to + wheel * 44, 0, max(0, wm.h - 456)) }
            group {
            move: 0, -wm.off
            let wsl.x0 = spx + 122 * pu
            let wsl.w = 250 * pu
            let wh = 12 * pu

            box { at: spx + 219 * pu, sby + 94 * pu; size: 438 * pu, 188 * pu; corner: 14 * pu; color: ink; opacity: veil }
            box { at: spx + 219 * pu, sby + 247 * pu; size: 438 * pu, 62 * pu; corner: 14 * pu; color: ink; opacity: veil }
            box { at: spx + 219 * pu, sby + 378 * pu; size: 438 * pu, 156 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "LAYOUT & WINDOWS" { at: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text "EFFECTS" { at: floor(spx + 14 * pu + 0.5), floor(sby + 204 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text "INPUT  ·  NEXT LOGIN" { at: floor(spx + 14 * pu + 0.5), floor(sby + 290 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }

            //  Layout: where the windows of a monitor go.
            text "Layout" { at: floor(spx + 14 * pu + 0.5), floor(sby + 42 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            repeat i in 0..5 {
                let lx = spx + 164 * pu + mod(i, 3) * 90 * pu
                let ly = sby + (42 + floor(i / 3) * 28) * pu
                box { at: lx, ly; size: 84 * pu, 24 * pu; corner: 12 * pu; color: if(wm_layout == i, mint, ink); opacity: if(wm_layout == i, 24%, 8% + 10% * wm_lay_hit.$i.hover) }
                text pick(i, "Lead left", "Columns", "Rows", "Grid", "Lead right") { at: floor(lx + 0.5), floor(ly + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 80 * pu; lines: 1; color: if(wm_layout == i, mint, ink); family: "Space Grotesk" }
                zone box wm_lay_hit.$i { at: lx, ly; size: 86 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (ly) - sby - wm.off > 0 and (ly) - sby - wm.off < 456 * pu }
                on press wm_lay_hit.$i { emit wm_layout_set(i) }
            }

            //  The leader's share of the width, 30 to 80 %.
            text "Leader width" { at: floor(spx + 14 * pu + 0.5), floor(sby + 104 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            body { color: deep; rim: 9%; box { at: wsl.x0 + wsl.w / 2, sby + 104 * pu; size: wsl.w, wh; corner: wh / 2 } }
            group {
                glow: 6 * pu, 50%, mint
                body {
                    gradient: wsl.x0, 0 to wsl.x0 + wsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: wsl.x0, sby + 104 * pu - wh / 2; size: max(0.1, wsl.w * (wm_share - 0.3) / 0.5), wh; corner: wh / 2 }
                }
            }
            text wm_share_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 104 * pu + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
            zone box wm_share_hit { at: wsl.x0 + wsl.w / 2, sby + 104 * pu; size: wsl.w + 24 * pu, 30 * pu; cursor: pointer; active: (sby + 104 * pu) - sby - wm.off > 0 and (sby + 104 * pu) - sby - wm.off < 456 * pu }
            on press wm_share_hit { emit wm_share_set(clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }
            on drag wm_share_hit { emit wm_share_set(clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }

            //  Gaps between windows, 0 to 32 px.
            text "Gaps" { at: floor(spx + 14 * pu + 0.5), floor(sby + 136 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            body { color: deep; rim: 9%; box { at: wsl.x0 + wsl.w / 2, sby + 136 * pu; size: wsl.w, wh; corner: wh / 2 } }
            group {
                glow: 6 * pu, 50%, mint
                body {
                    gradient: wsl.x0, 0 to wsl.x0 + wsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: wsl.x0, sby + 136 * pu - wh / 2; size: max(0.1, wsl.w * wm_gap / 32), wh; corner: wh / 2 }
                }
            }
            text wm_gap_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 136 * pu + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
            zone box wm_gap_hit { at: wsl.x0 + wsl.w / 2, sby + 136 * pu; size: wsl.w + 24 * pu, 30 * pu; cursor: pointer; active: (sby + 136 * pu) - sby - wm.off > 0 and (sby + 136 * pu) - sby - wm.off < 456 * pu }
            on press wm_gap_hit { emit wm_gap_set(clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }
            on drag wm_gap_hit { emit wm_gap_set(clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }

            //  Free-floating windows, as on Windows or KDE.
            text "Free-floating windows" { at: floor(spx + 14 * pu + 0.5), floor(sby + 170 * pu + 0.5); anchor: left center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk" }
            box { at: spx + 404 * pu, sby + 170 * pu; size: 40 * pu, 22 * pu; corner: 11 * pu; color: mix(ink, mint, wm_k0); opacity: 14% + 34% * wm_k0 + 8% * wm_tg_hit.0.hover }
            ellipse { at: spx + (404 - 9 + 18 * wm_k0) * pu, sby + 170 * pu; radius: 8 * pu; color: mix(ink, mint, wm_k0); opacity: 80% + 20% * wm_k0 }
            zone box wm_tg_hit.0 { at: spx + 219 * pu, sby + 170 * pu; size: 430 * pu, 28 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 170 * pu) - sby - wm.off > 0 and (sby + 170 * pu) - sby - wm.off < 456 * pu }
            on press wm_tg_hit.0 { emit wm_toggle(0) }

            //  Effects.
            repeat i in 1..3 {
                let ty = sby + (234 + (i - 1) * 30) * pu
                let tk = pick(i - 1, wm_k1, wm_k2)
                text pick(i - 1, "Rain on the glass", "Snow") { at: floor(spx + 14 * pu + 0.5), floor(ty + 0.5); anchor: left center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk" }
                box { at: spx + 404 * pu, ty; size: 40 * pu, 22 * pu; corner: 11 * pu; color: mix(ink, mint, tk); opacity: 14% + 34% * tk + 8% * wm_tg_hit.$i.hover }
                ellipse { at: spx + (404 - 9 + 18 * tk) * pu, ty; radius: 8 * pu; color: mix(ink, mint, tk); opacity: 80% + 20% * tk }
                zone box wm_tg_hit.$i { at: spx + 219 * pu, ty; size: 430 * pu, 28 * pu; corner: 10 * pu; cursor: pointer; active: (ty) - sby - wm.off > 0 and (ty) - sby - wm.off < 456 * pu }
                on press wm_tg_hit.$i { emit wm_toggle(i) }
            }

            //  Pointer speeds, -1 to 1, and the screen's idle time, 1 to 30 minutes.
            repeat i in 0..3 {
                let sy = sby + (320 + i * 30) * pu
                let sv = pick(i, (wm_ms + 1) / 2, (wm_ts + 1) / 2, (wm_idle - 1) / 29)
                text pick(i, "Mouse speed", "Touchpad speed", "Screen off after") { at: floor(spx + 14 * pu + 0.5), floor(sy + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
                body { color: deep; rim: 9%; box { at: wsl.x0 + wsl.w / 2, sy; size: wsl.w, wh; corner: wh / 2 } }
                group {
                    glow: 6 * pu, 50%, mint
                    body {
                        gradient: wsl.x0, 0 to wsl.x0 + wsl.w, 0, mintlo, mint 55%, minthi
                        rim: 22%
                        box { from: wsl.x0, sy - wh / 2; size: max(0.1, wsl.w * sv), wh; corner: wh / 2 }
                    }
                }
                text pick(i, wm_ms_text, wm_ts_text, wm_idle_text) { at: floor(spx + 424 * pu + 0.5), floor(sy + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
                zone box wm_in_hit.$i { at: wsl.x0 + wsl.w / 2, sy; size: wsl.w + 24 * pu, 30 * pu; cursor: pointer; active: (sy) - sby - wm.off > 0 and (sy) - sby - wm.off < 456 * pu }
                on press wm_in_hit.$i { emit wm_input_set(i * 10 + clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }
                on drag wm_in_hit.$i { emit wm_input_set(i * 10 + clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }
            }
            box { at: wsl.x0 + wsl.w / 2, sby + 320 * pu; size: 1.5 * pu, wh + 6 * pu; corner: 0.75 * pu; color: ink; opacity: 40% }
            box { at: wsl.x0 + wsl.w / 2, sby + 350 * pu; size: 1.5 * pu, wh + 6 * pu; corner: 0.75 * pu; color: ink; opacity: 40% }

            //  Natural scroll and tap to click, for the touchpad.
            repeat i in 3..5 {
                let ty = sby + (320 + i * 30) * pu
                let tk = pick(i - 3, wm_k3, wm_k4)
                text pick(i - 3, "Natural scroll (touchpad)", "Tap to click (touchpad)") { at: floor(spx + 14 * pu + 0.5), floor(ty + 0.5); anchor: left center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk" }
                box { at: spx + 404 * pu, ty; size: 40 * pu, 22 * pu; corner: 11 * pu; color: mix(ink, mint, tk); opacity: 14% + 34% * tk + 8% * wm_tg_hit.$i.hover }
                ellipse { at: spx + (404 - 9 + 18 * tk) * pu, ty; radius: 8 * pu; color: mix(ink, mint, tk); opacity: 80% + 20% * tk }
                zone box wm_tg_hit.$i { at: spx + 219 * pu, ty; size: 430 * pu, 28 * pu; corner: 10 * pu; cursor: pointer; active: (ty) - sby - wm.off > 0 and (ty) - sby - wm.off < 456 * pu }
                on press wm_tg_hit.$i { emit wm_toggle(i) }
            }

            //  Window style: the border, the corners, the shadow and the title bar.
            box { at: spx + 219 * pu, sby + 644 * pu; size: 438 * pu, 304 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "WINDOW STYLE" { at: floor(spx + 14 * pu + 0.5), floor(sby + 480 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text "Border from the wallpaper" { at: floor(spx + 14 * pu + 0.5), floor(sby + 512 * pu + 0.5); anchor: left center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk" }
            box { at: spx + 404 * pu, sby + 512 * pu; size: 40 * pu, 22 * pu; corner: 11 * pu; color: mix(ink, mint, wm_k5); opacity: 14% + 34% * wm_k5 + 8% * wm_tg_hit.5.hover }
            ellipse { at: spx + (404 - 9 + 18 * wm_k5) * pu, sby + 512 * pu; radius: 8 * pu; color: mix(ink, mint, wm_k5); opacity: 80% + 20% * wm_k5 }
            zone box wm_tg_hit.5 { at: spx + 219 * pu, sby + 512 * pu; size: 430 * pu, 28 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 512 * pu) - sby - wm.off > 0 and (sby + 512 * pu) - sby - wm.off < 456 * pu }
            on press wm_tg_hit.5 { emit wm_toggle(5) }
            repeat i in 0..9 {
                let sy = sby + (542 + i * 30) * pu
                let sv = pick(i, wm_bw / 6, (wm_ba - 20) / 80, wm_rad / 24, wm_shd / 200, (wm_tb - 16) / 18, (wm_tbo - 40) / 60, (wm_wa - 40) / 60, (wm_wi - 40) / 60, wm_fr / 100)
                text pick(i, "Border width", "Border strength", "Corner radius", "Shadow", "Title bar height", "Title bar glass", "Window opacity", "Unfocused opacity", "Frosted backing") { at: floor(spx + 14 * pu + 0.5), floor(sy + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
                body { color: deep; rim: 9%; box { at: wsl.x0 + wsl.w / 2, sy; size: wsl.w, wh; corner: wh / 2 } }
                group {
                    glow: 6 * pu, 50%, mint
                    body {
                        gradient: wsl.x0, 0 to wsl.x0 + wsl.w, 0, mintlo, mint 55%, minthi
                        rim: 22%
                        box { from: wsl.x0, sy - wh / 2; size: max(0.1, wsl.w * sv), wh; corner: wh / 2 }
                    }
                }
                text pick(i, wm_bw_text, wm_ba_text, wm_rad_text, wm_shd_text, wm_tb_text, wm_tbo_text, wm_wa_text, wm_wi_text, wm_fr_text) { at: floor(spx + 424 * pu + 0.5), floor(sy + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
                zone box wm_st_hit.$i { at: wsl.x0 + wsl.w / 2, sy; size: wsl.w + 24 * pu, 30 * pu; cursor: pointer; active: sy - sby - wm.off > 0 and sy - sby - wm.off < 456 * pu }
                on press wm_st_hit.$i { emit wm_style_set(i * 10 + clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }
                on drag wm_st_hit.$i { emit wm_style_set(i * 10 + clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }
            }
            }

            //  The scrollbar and the "More" cue, as on the Display page: a thumb as tall as the viewport is of the page, and a pill
            //  at the foot of the view while there is more below (pressing it scrolls a screenful down).
            let wm.thh = 456 * 456 / max(456, wm.h)
            let wm.thy = wm.thh / 2 + wm.sc / max(1, wm.h - 456) * (456 - wm.thh)
            box { at: spx + 442 * pu, sby + 228 * pu; size: 3 * pu, 456 * pu; corner: 1.5 * pu; color: ink; opacity: if(wm.h > 456, 6%, 0%) }
            box { at: spx + 442 * pu, sby + wm.thy * pu; size: 3 * pu, wm.thh * pu; corner: 1.5 * pu; color: mint; opacity: if(wm.h > 456, 55%, 0%) }
            let wm.cue = clamp((wm.h - 456 - wm.sc) / 24, 0, 1)
            let wm.cuey = sby + (456 - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (400 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * wm.cue }
            }
            box { at: spx + 224 * pu, wm.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * wm.cue }
            box { at: spx + 224 * pu, wm.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * wm_cue_hit.hover) * wm.cue }
            path { at: spx + 204 * pu, wm.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: wm.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, wm.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: wm.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            text "More" { at: floor(spx + 232 * pu + 0.5), floor(wm.cuey + 0.5); anchor: center; size: 15; weight: 700; color: ink; opacity: wm.cue; family: "Space Grotesk" }
            zone box wm_cue_hit { at: spx + 224 * pu, sby + (456 - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: wm.cue > 0.5 }
            on press wm_cue_hit { wm_scroll_to = clamp(wm_scroll_to + 342, 0, max(0, wm.h - 456)) }
            zone box wm_bar_hit { at: spx + 442 * pu, sby + 228 * pu; size: 14 * pu, 456 * pu; cursor: pointer; active: wm.h > 456 }
            on press wm_bar_hit { wm_scroll_to = clamp(((pointer.y - sby) / pu - wm.thh / 2) / max(1, 456 - wm.thh) * (wm.h - 456), 0, max(0, wm.h - 456)) }
            on drag wm_bar_hit { wm_scroll_to = clamp(((pointer.y - sby) / pu - wm.thh / 2) / max(1, 456 - wm.thh) * (wm.h - 456), 0, max(0, wm.h - 456)) }
        }

        //  ── Notifications page: BEGIN (generated) ──
        //  Scrolls like the System monitor page: a clipped viewport, the content moved by a whole-pixel `nt.off`, the wheel caught under it.
        group {
            show: set_pgt > 0.01
            opacity: set_pgt
            let nt.sc = clamp(nt_scroll, 0, max(0, nt.h - 456))
            let nt.off = floor(nt.sc * pu + 0.5)
            clip box { at: spx + 224 * pu, sby + 228 * pu; size: 456 * pu, 456 * pu }
            zone box nt_wheel { at: spx + 219 * pu, sby + 228 * pu; size: 446 * pu, 456 * pu }
            on scroll nt_wheel { nt_scroll_to = clamp(nt_scroll_to + wheel * 44, 0, max(0, nt.h - 456)) }
            group {
                move: 0, -nt.off
            box { at: spx + 219 * pu, sby + 122 * pu; size: 438 * pu, 232 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "DELIVERY" { at: floor(spx + 14 * pu + 0.5), floor(sby + 22 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text "Play a sound" { at: floor(spx + 14 * pu + 0.5), floor(sby + 43 * pu + 0.5); anchor: left center; size: 16; weight: 600; width: 340 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            text "When a notification is shown" { at: floor(spx + 14 * pu + 0.5), floor(sby + 59 * pu + 0.5); anchor: left center; size: 13; weight: 500; width: 340 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            box { at: spx + 404 * pu, sby + 50 * pu; size: 40 * pu, 22 * pu; corner: 11 * pu; color: mix(ink, mint, ntk0); opacity: 14% + 34% * ntk0 + 8% * ntg_snd_hit.hover }
            ellipse { at: spx + (404 - 9 + 18 * ntk0) * pu, sby + 50 * pu; radius: 8 * pu; color: mix(ink, mint, ntk0); opacity: 80% + 20% * ntk0 }
            zone box ntg_snd_hit { at: spx + 219 * pu, sby + 50 * pu; size: 430 * pu, 32 * pu; corner: 10 * pu; cursor: pointer }
            on press ntg_snd_hit { emit ntg_flag(0) }
            text "Let critical ones through Do Not Disturb" { at: floor(spx + 14 * pu + 0.5), floor(sby + 81 * pu + 0.5); anchor: left center; size: 16; weight: 600; width: 340 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            text "A low battery, a build that broke: the ones you would want" { at: floor(spx + 14 * pu + 0.5), floor(sby + 97 * pu + 0.5); anchor: left center; size: 13; weight: 500; width: 340 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            box { at: spx + 404 * pu, sby + 88 * pu; size: 40 * pu, 22 * pu; corner: 11 * pu; color: mix(ink, mint, ntk1); opacity: 14% + 34% * ntk1 + 8% * ntg_crit_hit.hover }
            ellipse { at: spx + (404 - 9 + 18 * ntk1) * pu, sby + 88 * pu; radius: 8 * pu; color: mix(ink, mint, ntk1); opacity: 80% + 20% * ntk1 }
            zone box ntg_crit_hit { at: spx + 219 * pu, sby + 88 * pu; size: 430 * pu, 32 * pu; corner: 10 * pu; cursor: pointer }
