            text "Accent" { at: floor(spx + 139 * pu + 0.5), floor(sby + 232 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 62 * pu; lines: 1; color: mix(ink, mint, lkc1); family: "Space Grotesk" }
