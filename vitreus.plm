    event settings_toggle ->        // from a key bind (hypr_vitreus.lua): open or close Settings
    //  The pages of the settings panel, and how far the second is in (for the sidebar's highlight and the
    //  panel's height, which follows the page).
    fact set_page: pg_wall | pg_glass | pg_disp | pg_bar | pg_night | pg_hypr | pg_about | pg_sys | pg_nt | pg_lock | pg_wm | pg_vpn | pg_clock | pg_theme | pg_keys | pg_addons = pg_wall
    //  The Bar page: which monitors the bar is on, one or two (logic/bar_monitors.luau). `bar_sel.i` is whether monitor tile i is chosen, and `bar_rest`
    //  whether some plugged-in monitor is not (the ones that can keep the frame alone).
    fact bar_rest = false
    //  The bar's position (Settings > Bar): along the top, or down the left edge with a frame round the screen (see the Bar section of
    //  vitreus.luau). The surface's anchor follows it; `bar_lm` is how far over to the left it has got, and the panels still hang from the top
    //  edge, `lp_w` wide (the one last opened), their left edge by the strip.
    fact bar_anchor: top | left | right | bottom = top
    fact bar_frame = false                   // the frame round the screen is on (the Island is the bar without it)
    fact bar_size = 1                        // Settings > Bar > Size: how big the bar is, 0.7 to 1, on every layout; the logic sets it (logic/bar_size.luau)
    event bar_pick_size ->                   // the slider: 0 to 1 along it, 70 to 100 %
    text bar_size_text = "100%"
    fact bar_seg = false                     // along the top with a frame: a thin frame, and the bar in three pieces of glass (workspaces, clock, controls) out of it
    //  Down the left a panel never turns into another: asking for one while another is open closes the open one first, and the new one
    //  opens when it has gone (see the rule after `lp.top`). `pcur` is the panel as the rule last saw it, `pending` the one that is waiting.
    fact pcur: none | calendar | controls | player | volume | notif | settings | launch | tray = none
    fact pending: none | calendar | controls | player | volume | notif | settings | launch | tray = none
    fact pq_sw = false
    event bar_pick_pos ->
    fact lp_w = 450
