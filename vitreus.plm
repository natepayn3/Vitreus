    event bt_trust_toggle ->
    event bt_rename_go ->
    event bt_disc_toggle ->
    event wifi_join_go ->           // its Join button, or Enter in the field
    event bt_pick ->                // a device row's own button: connect, or leave it
    event bt_forget ->              // a device row's Forget
    event bt_scan ->                // the rescan button
    //  Do Not Disturb is a preference the logic keeps in `dnd.json`; Caffeine is whether hypridle
    //  has been stopped, which the logic asks the system rather than remembering.
    fact dnd_on = false
    fact caf_on = false
    fact caf_avail = true          // hypridle is installed: there is something to hold off
    event togglednd ->
    //  The notifications module: Do Not Disturb with a timer, and the history of what came in.
    model nt_hist max 30 { title: text; sub: text; when: text }
    text nt_tile_sub = ""          // the tile's second line: Silenced · 23:41, 12 in history, All clear
    text dnd_left = ""             // the window's DND row: 23:41 left, On until turned off, Off
    text dnd_big = "Off"            // the window's big words: the time left, On, Quiet or Off
    text dnd_small = ""             // and the small line under them
    fact dnd_frac = 0              // how much of a running timer is left, 1 to 0
    prop dnd_fr = 0 ~1000ms
    follow dnd_fr = dnd_frac
    fact dnd_len = 0               // minutes of the timer that is running (which chip is lit), 0 for none
    event dnd_for ->               // a timer chip: minutes
    event nt_clear ->              // the Clear button
    event nt_hist_del ->           // a history row's cross, by position
    fact caf_len = 0               // minutes of the Caffeine timer that is running (which chip is lit), 0 for none
    text caf_left = ""             // the Caffeine window's row: 23:41 left, On until turned off, Off
    text caf_big = "Off"            // the Caffeine window's big words: the time left, On or Off
    text caf_small = ""             // and the small line under them
    fact caf_frac = 0              // how much of a running timer is left, 1 to 0
    prop caf_fr = 0 ~1000ms
    follow caf_fr = caf_frac
    text caf_tile_sub = ""         // the tile's second line while a timer runs: Awake · 23:41
    event togglecaf ->
    event caf_for ->               // a timer chip: minutes, or 0 for until it is turned off
    //  Capture and Power, the third row of tiles: screenshots and screen recording, the session and the power profile.
    fact rec_on = false            // wf-recorder is running
    text rec_time = ""             // how long, 1:23
    fact rec_mic = false           // a recording takes the microphone too (the default input), set from the Capture window
    event rec_mic_toggle ->
    fact rec_sys = false           // a recording takes the system sound instead (the default output's monitor); one audio source only, so it excludes the mic
    event rec_sys_toggle ->
    fact pow_prof = -1             // 0 power saver, 1 balanced, 2 performance, -1 no power-profiles-daemon
    event shot ->                  // 0 a region, 1 the whole screen
    event rec_start ->             // the same
    event rec_stop ->
    event rec_toggle ->            // the tile's button
    event pow_press ->             // a session button held for one second: 0 lock, 1 sleep, 2 log out, 3 restart, 4 power off
    event pow_prof_set ->          // 0, 1 or 2
    fact ws.active = 1
    fact ws.special = false          // a special workspace (a scratchpad) is shown over them: the marks give way to one of its own
    fact ws.spk = 0                  // which one: 0 magic (or any other), 1 music, 2 private
    repeat i in 1..11 { fact ws.$i.urgent = false }   // a window on that workspace asked for attention while it was out of view
    fact ws.1.busy = false
    fact ws.2.busy = false
    fact ws.3.busy = false
    fact ws.4.busy = false
    fact ws.5.busy = false
    fact ws.6.busy = false
    fact ws.7.busy = false
    fact ws.8.busy = false
    fact ws.9.busy = false
    fact ws.10.busy = false
    //  Whether the workspace in view has no window. Hyprland takes the pointer away from a layer surface that does not hold the keyboard, on the first click, when there
    //  is no window on the screen: it dropped the Desk's grip drag as it began (a slow drag that stayed over the panel was the only one that held). So with an empty
    //  workspace the open Desk holds the keyboard (see the surface's rule), there being no window to take it from.
    fact ws_empty = false
    event go ->
    event ov_go ->                     // a click on a workspace in the overview: it closes, then the switch

    //  The colours live in palette-live.plm (ink, faint, mint, tint…); only the veil is the scene's.
    let veil  = 8%
    let glyph_a = 0.4 * (1 - uwu_k)              // how strong the little marks on the toggle knobs are: kept subtle

    shader wave = file "wave.wgsl"
    shader pixelate = file "pixelate.wgsl"
    shader matrix = file "matrix.wgsl"                  // the Cyber theme's digital rain
    //  The frosting behind the glass, as wide as the Glass page's blur slider says (`hy_blur`, 0 to 20; 0 is off): see blur.wgsl.
    blur = file "blur.wgsl" {
        passes: wide 0.5, tall 1
        values: clamp(hy_blur / 20, 0, 1)
        reach: 40
    }
    //  The glass bends a copy of the wallpaper, not a capture of the screen: `lens_image` in vitreus.luau writes it (half the screen's size is plenty under the frosting).
    lens = image "~/.cache/pleamar/vitreus/lens.png" while not glass_live
    spring dripl = 46, 8          // the drip down the left: slow enough to see the neck stretch, thin and snap, and loose enough to swing past where it lands
    spring drip = 170, 18         // underdamped: it overshoots and settles back, like a real drop landing
    spring pop  = 300, 12         // snappier and much less damped: a toggle knob popping past where it lands
    spring slide = 220, 24        // the Caffeine thumb: quick, with only a hint of overshoot

    prop drop  = 0 ~drip          // the panel, 0 to 1: it hangs from the bar and falls
    //  The settle: the panel hangs a few px lower when it lands and eases back. Critically damped, so it is one slow hump and never a bounce.
    spring hang = 260, 32
    prop sag   = 0 ~hang
    //  The water's own spring, from Marea: a quarter of a second of period and two bounces you can see. A drawer
    //  that lands shakes on it for a moment, as a drop does when it comes to rest.
    spring splash = 420, 13
    prop wobble = 0 ~splash
    //  Where the ripple that crosses the bar is born: 0 at the player controls (the music), 1 in the middle
    //  (a drawer that has just closed, the surface closing over it).
    prop ring_mid = 0 ~30ms
    prop hot   = 0 ~quick         // the bar, when the pointer is on it
    prop f1    = 0 ~200ms        // what is inside, arriving one after another
    prop f2    = 0 ~380ms
    prop f3    = 0 ~520ms
    prop f4    = 0 ~380ms          // the calendar's second stage
    prop f5    = 0 ~620ms          // the controls drawer, third in: brightness
    prop f6    = 0 ~700ms          // fourth: wifi
    prop f7    = 0 ~780ms          // fifth: bluetooth
    prop glass_bend_pill = 0 ~pop    // the Glass page's lens switch, popping past where it lands
    follow glass_bend_pill = if(glass_x, 1, 0)
    prop glass_live_pill = 0 ~pop
    follow glass_live_pill = if(glass_live, 1, 0)
    prop glass_auto_pill = 0 ~pop     // the Glass page's auto-frost switch
    follow glass_auto_pill = if(glass_auto, 1, 0)
    prop glass_on_pill = 1 ~pop       // the Glass switch on the Glass page (on = glass, off = obsidian), likewise
    follow glass_on_pill = if(glass_obs, 0, 1)
    //  The notifications window's envelope: its flap is open while there is history and Do Not Disturb is off, and it hops when the history changes.
    prop env_o = 0 ~pop
    follow env_o = if(nt_hist.count > 0 and not dnd_on, 1, 0)
    prop env_pop = 0 ~pop
    on change nt_hist.count { env_pop: 1 ~0ms; env_pop: 0 ~450ms after 40ms }
    prop wifi_on = 0 ~pop         // the wifi toggle pill, popping past where it lands
    prop wifi_extra = 0 ~calm     // 0..1: whether a Wi-Fi row is open
    //  The Wi-Fi toggle's own motion: finger down, a press held long enough, the tile filling with colour, the ring from the touch.
    prop wf_press = 0 ~pop        // 0..1: the pill is being pressed
    prop wf_hold = 0 ~calm        // 0..1: held long enough, so the pill has grown into a signal meter
    prop wf_fill = 0 ~700ms       // 0..1: the colour that floods the tile from the toggle
    prop wf_rip = 1 ~700ms        // 0..1: the ring that leaves the touch point and fades
    fact wf_held = false          // the press became a hold: letting go then does not flip the radio
    fact wf_rx = 0                // where the ring started (surface coordinates)
    fact wf_ry = 0
    //  The same motion on the other control center toggles (Bluetooth, Notifications, Caffeine).
    prop bt_press = 0 ~pop
    prop bt_rip = 1 ~700ms
    prop bt_fill = 0 ~700ms
    fact bt_rx = 0
    fact bt_ry = 0
    prop dnd_press = 0 ~pop
    prop dnd_rip = 1 ~700ms
    prop dnd_fill = 0 ~700ms
    fact dnd_rx = 0
    fact dnd_ry = 0
    prop caf_press = 0 ~pop
    prop dnd_sel = 0 ~slide         // which Do Not Disturb stop the thumb is on (0 = Off, 1 = 15m .. 4 = 2h, 5 = until turned off)
    let dnd_sel_t = if(not dnd_on, 0, if(dnd_len == 15, 1, if(dnd_len == 30, 2, if(dnd_len == 60, 3, if(dnd_len == 120, 4, 5)))))
    prop nt_rip = 1 ~700ms
    fact nt_rx = 0
    fact nt_ry = 0
    prop caf_sel = 0 ~slide         // which Caffeine stop the thumb is on (0 = Off, 1 = 15m .. 5 = 4h, 6 = until off)
    let caf_sel_t = if(not caf_on, 0, if(caf_len == 15, 1, if(caf_len == 30, 2, if(caf_len == 60, 3, if(caf_len == 120, 4, if(caf_len == 240, 5, 6))))))
    prop cs_rip = 1 ~700ms
    fact cs_rx = 0
    fact cs_ry = 0
    prop caf_rip = 1 ~700ms
    prop caf_fill = 0 ~700ms
    fact caf_rx = 0
    fact caf_ry = 0
    prop wifi_sel = 0 ~calm       // which row, as a position: slides from one row to the next
    prop wifi_pf = 0 ~calm        // the room the connected network's details take, once open
    prop bt_trust_t = 0 ~pop      // the auto-connect switch
    prop bt_disc_t = 0 ~pop       // the discoverable switch
    prop bt_extra = 0 ~calm       // 0..1: whether a Bluetooth row is open
    prop bt_pf = 0 ~calm          // the room its audio profiles take, once open
    prop bt_sel  = 0 ~calm        // which row, as a position: slides from one row to the next
    prop bt_on   = 0 ~pop         // the bluetooth toggle pill, popping past where it lands
    prop media_open = 0 ~drip      // the media card: there while a player exists (nothing at all with none)
    //  The media card can be pulled off its panel and floated about the desktop (pages/media_float.plm): `mf_out` is whether it is, `mf_gx`, `mf_gy` where
    //  its middle is being taken to, `mf_px`, `mf_py` where it is, on a loose spring; `mfl` is 0 in the panel and 1 floating.
    fact mf_out = false
    fact mf_gx = 0
    fact mf_gy = 0
    fact mf_bx = 0                 // where it was when it was grabbed
    fact mf_by = 0
    fact mf_hold = false           // it is held: its grab zone stays where it was pressed
    fact mf_scr = 0                // which monitor's copy it floats on: the one it was grabbed on (the others draw none of it)
    fact mf_hx = 0
    fact mf_hy = 0
    spring mf_sp = 300, 20
    prop mf_px = 0 ~mf_sp
    prop mf_py = 0 ~mf_sp
    //  Floating, it can be made smaller or bigger by a handle in each corner, as the desk's: `mf_gs` is the scale it is going to, `mf_s` where it is (0.5 to 1.6,
    //  about the corner across from the one held, which stays where it is: `mf_fcx`, `mf_fcy`). Put back in the panel it is full size again.
    fact mf_gs = 1
    fact mf_bs = 1                 // the scale when a handle was pressed
    fact mf_rk = -1                // which corner's handle is held (0 top left, 1 top right, 2 bottom left, 3 bottom right)
    fact mf_fcx = 0
    fact mf_fcy = 0
    prop mf_s = 1 ~mf_sp
    follow mf_s = mf_gs
    on change mf_out while not mf_out { mf_gs = 1; mf_rk = -1; mf_hold = false }
    follow mf_px = mf_gx
    follow mf_py = mf_gy
    prop mfl = 0 ~drip
    follow mfl = if(mf_out, 1, 0)
    //  Each panel has its own amount, 0 shut .. 1 open. Each one is a drawer that comes out of the
    //  bar and melts into it; the calendar is as wide as the bar, the others are narrower.
    prop dc    = 0 ~drip
    prop dk    = 0 ~drip
    prop dm    = 0 ~drip          // the player's panel, hanging from the window title
    prop do    = 0 ~drip          // the volume / notification drawer
    prop dz    = 0 ~drip          // the desk's drawer, out of the right frame
    prop ds    = 0 ~drip          // the settings panel
    prop fs    = 0 ~300ms         // what is in it, fading in
    prop dl    = 0 ~drip          // the launcher
    prop dax   = 0 ~drip          // the add-on drawer
    //  The Settings gear and the Search squares (settings_panel.plm, the launcher below): a click round for each page / kind of search. Their pencil lines are redrawn
    //  about eight times a second for as long as the panel is out, which keeps the scene's clock running (`need_clock`).
    fact gr_n = 0
    fact sr_n = 0
    prop gr_t = 0 ~pop
    prop sr_t = 0 ~pop
    follow gr_t = gr_n
    follow sr_t = sr_n
    on change set_page { gr_n = gr_n + 1 }
    //  The Retro's pixelation outlasts the drawer's own movement: each drawer has a slower twin (`pq.*`, 0.6 s) that follows the same target, and the squares are as
    //  big as the two are apart, so they appear as the drawer starts to move and are still there after it has arrived, thinning out as the twin catches up.
    prop pq.dc = 0 ~600ms
    prop pq.dk = 0 ~600ms
    prop pq.dm = 0 ~600ms
    prop pq.dz = 0 ~600ms
    prop pq.ds = 0 ~600ms
    prop pq.dl = 0 ~600ms
    prop pq.do = 0 ~600ms
    //  The UwU's star burst (bar_glass.plm): a clock for each drawer, 0 just born, 1 gone, restarted when the drawer has closed.
    prop sb_dc = 1 ~900ms
    prop sb_dk = 1 ~900ms
    prop sb_dm = 1 ~900ms
    prop sb_dz = 1 ~900ms
    prop sb_ds = 1 ~900ms
    prop sb_dl = 1 ~900ms
    prop sb_do = 1 ~900ms
    on change dc < 0.06 while dc < 0.06 and fm > 0.5 { sb_dc: 0 ~16ms; sb_dc: 1 ~900ms after 30ms }
    on change dk < 0.06 while dk < 0.06 and fm > 0.5 { sb_dk: 0 ~16ms; sb_dk: 1 ~900ms after 30ms }
    on change dm < 0.06 while dm < 0.06 and fm > 0.5 { sb_dm: 0 ~16ms; sb_dm: 1 ~900ms after 30ms }
    on change dz < 0.06 while dz < 0.06 and lm > 0.5 { sb_dz: 0 ~16ms; sb_dz: 1 ~900ms after 30ms }
    on change ds < 0.06 while ds < 0.06 and lm > 0.5 { sb_ds: 0 ~16ms; sb_ds: 1 ~900ms after 30ms }
    on change dl < 0.06 while dl < 0.06 and lm > 0.5 { sb_dl: 0 ~16ms; sb_dl: 1 ~900ms after 30ms }
    on change do < 0.06 while do < 0.06 and lm > 0.5 { sb_do: 0 ~16ms; sb_do: 1 ~900ms after 30ms }
    prop fl    = 0 ~300ms         // what is in it, fading in
    prop lr    = 1 ~calm          // how many rows it has room for
    prop fo    = 0 ~300ms         // what is in it, fading in
    prop okv   = 0 ~calm          // 1 while it is the volume that is drawn
    prop okn   = 0 ~calm          // 1 while it is a notification
    prop oks   = 0 ~calm          // 1 while it is a screenshot
    prop osd_h = 64 ~calm         // the height of its plate: a notification is taller with text and buttons
    prop nt_ring = 1 ~600ms       // a ripple off the notification's tile: 0 born, 1 gone
    prop nt_sw = 1 ~2400ms        // the bell's swing when it arrives: 0 struck, 1 still (much slower than the ripple)
    prop expand = 0 ~drip          // a tile growing into its own window, 0 tile .. 1 full window
    //  The music: fast, and a little loose, so the bar bounces on the beat.
    spring beat = 480, 15
    prop pulse = 0 ~beat
    prop ring  = 1 ~600ms          // a ripple crossing the bar: 0 born, 1 gone
    prop dd    = 0 ~calm           // the output dropdown, 0 shut .. 1 open
    prop vm    = 0 ~calm           // the per-app mixer, 0 shut .. 1 open
    prop mvis  = 0 ~calm           // 1 while there is an app playing sound (or the mixer is open): the dots show
    prop swap  = 1 ~700ms          // the cover popping in on a new song: 0 just changed, 1 settled
    prop playf = 0 ~calm           // 1 while playing: the cover is full and colourful
    prop mshow = 0 ~calm          // the bar's player controls: there while a player exists, paused or not

    follow drop = if(panel != none, 1, 0)
    follow dtrav = if(panel != none, 1, 0)
    follow hot  = if(panel != none, 1, 0)
    follow dc   = if(panel == calendar, 1, 0)
    follow dk   = if(panel == controls, 1, 0)
    follow dm   = if(panel == player or panel == tray, 1, 0)
    follow do   = if(osd_on, 1, 0)
    follow dz   = if(desk_open, 1, 0)
    follow ds   = if(panel == settings, 1, 0)
    follow dl   = if(panel == launch, 1, 0)
    follow dax  = if(ax_open, 1, 0)
    follow pq.dc = if(panel == calendar, 1, 0)
    follow pq.dk = if(panel == controls, 1, 0)
    follow pq.dm = if(panel == player or panel == tray, 1, 0)
    follow pq.dz = if(desk_open, 1, 0)
    follow pq.ds = if(panel == settings, 1, 0)
    follow pq.dl = if(panel == launch, 1, 0)
    follow pq.do = if(osd_on, 1, 0)
    follow lr   = max(1, max(lcount, if(lp_on, 6, 1)))
    follow okv  = if(osd_kind == vol, 1, 0)
    follow okn  = if(osd_kind == note, 1, 0)
    follow oks  = if(osd_kind == shot, 1, 0)
    //  The bell swings once the banner is there: with the drawer already out (another notification replacing the last) it swings at once, and with it still
    //  coming out it waits for it to land, so the swing does not play while the banner is sliding in and the bell is being drawn.
    on ntnew while do >= 0.9 {
        nt_ring: 0 ~16ms
        nt_ring: 1 ~800ms after 30ms
        nt_sw: 0 ~16ms
        nt_sw: 1 ~2400ms after 30ms
    }
    on ntnew while do < 0.9 {
        nt_ring: 0 ~16ms
        nt_ring: 1 ~800ms after 30ms
        nt_sw: 0 ~16ms
        nt_sw: 1 ~2400ms after 450ms
    }
    follow expand = if(panel_sub != none, 1, 0)
    //  Which window to actually draw. It jumps to match `panel_sub` the moment
    //  that becomes something - opening one, or switching straight to the other
    //  - but not back to `none`: closing is `expand` fading the same window out,
    //  so it has to stay named while that happens.
    on change panel_sub while panel_sub != none { showing_sub = panel_sub }
    on change panel_sub { wifi_open_row = -1; bt_open_row = -1 }
    //  Each workspace's indicator has its own amount of «active», 0..1, and morphs by it: the one that
    //  becomes active widens and turns mint in place while the one that stops shrinks back. Nothing
    //  travels. The speed is one with no overshoot: a morph, not a bounce.
    prop ws.act.1 = 0 ~260ms
    prop ws.act.2 = 0 ~260ms
    prop ws.act.3 = 0 ~260ms
    prop ws.act.4 = 0 ~260ms
    prop ws.act.5 = 0 ~260ms
    prop ws.act.6 = 0 ~260ms
    prop ws.act.7 = 0 ~260ms
    prop ws.act.8 = 0 ~260ms
    prop ws.act.9 = 0 ~260ms
    prop ws.act.10 = 0 ~260ms
    follow ws.act.1 = if(ws.active == 1, 1, 0)
    follow ws.act.2 = if(ws.active == 2, 1, 0)
    follow ws.act.3 = if(ws.active == 3, 1, 0)
    follow ws.act.4 = if(ws.active == 4, 1, 0)
    follow ws.act.5 = if(ws.active == 5, 1, 0)
    follow ws.act.6 = if(ws.active == 6, 1, 0)
    follow ws.act.7 = if(ws.active == 7, 1, 0)
    follow ws.act.8 = if(ws.active == 8, 1, 0)
    follow ws.act.9 = if(ws.active == 9, 1, 0)
    follow ws.act.10 = if(ws.active == 10, 1, 0)
    //  Where the active one is, as a number that moves smoothly between slots while two are morphing
    //  (the amounts of the two add up to 1, so this is their weighted middle).
    let pill = ws.act.1 * 1 + ws.act.2 * 2 + ws.act.3 * 3 + ws.act.4 * 4 + ws.act.5 * 5 + ws.act.6 * 6 + ws.act.7 * 7 + ws.act.8 * 8 + ws.act.9 * 9 + ws.act.10 * 10
    //  Occupied but not active: the dot stretches up into a capsule.
    prop ws.tall.1 = 0 ~lively
    prop ws.tall.2 = 0 ~lively
    prop ws.tall.3 = 0 ~lively
    prop ws.tall.4 = 0 ~lively
    prop ws.tall.5 = 0 ~lively
    prop ws.tall.6 = 0 ~lively
    prop ws.tall.7 = 0 ~lively
    prop ws.tall.8 = 0 ~lively
    prop ws.tall.9 = 0 ~lively
    prop ws.tall.10 = 0 ~lively
    follow ws.tall.1 = if(ws.1.busy, 1, 0)
    follow ws.tall.2 = if(ws.2.busy, 1, 0)
    follow ws.tall.3 = if(ws.3.busy, 1, 0)
    follow ws.tall.4 = if(ws.4.busy, 1, 0)
    follow ws.tall.5 = if(ws.5.busy, 1, 0)
    follow ws.tall.6 = if(ws.6.busy, 1, 0)
    follow ws.tall.7 = if(ws.7.busy, 1, 0)
    follow ws.tall.8 = if(ws.8.busy, 1, 0)
    follow ws.tall.9 = if(ws.9.busy, 1, 0)
    follow ws.tall.10 = if(ws.10.busy, 1, 0)
    //  Only the workspaces that matter have a mark: one with a window, or the one in view. The others are shut to nothing (their slot and the gap with it).
    prop ws.vis.1 = 0 ~lively
    prop ws.vis.2 = 0 ~lively
    prop ws.vis.3 = 0 ~lively
    prop ws.vis.4 = 0 ~lively
    prop ws.vis.5 = 0 ~lively
    prop ws.vis.6 = 0 ~lively
    prop ws.vis.7 = 0 ~lively
    prop ws.vis.8 = 0 ~lively
    prop ws.vis.9 = 0 ~lively
    prop ws.vis.10 = 0 ~lively
    follow ws.vis.1 = if((ws.1.busy or ws.active == 1) and not ws.special, 1, 0)
    follow ws.vis.2 = if((ws.2.busy or ws.active == 2) and not ws.special, 1, 0)
    follow ws.vis.3 = if((ws.3.busy or ws.active == 3) and not ws.special, 1, 0)
    follow ws.vis.4 = if((ws.4.busy or ws.active == 4) and not ws.special, 1, 0)
    follow ws.vis.5 = if((ws.5.busy or ws.active == 5) and not ws.special, 1, 0)
    follow ws.vis.6 = if((ws.6.busy or ws.active == 6) and not ws.special, 1, 0)
    follow ws.vis.7 = if((ws.7.busy or ws.active == 7) and not ws.special, 1, 0)
    follow ws.vis.8 = if((ws.8.busy or ws.active == 8) and not ws.special, 1, 0)
    follow ws.vis.9 = if((ws.9.busy or ws.active == 9) and not ws.special, 1, 0)
    follow ws.vis.10 = if((ws.10.busy or ws.active == 10) and not ws.special, 1, 0)
    //  The plus: a workspace to start in, the first one of the five with no window (not the one in view). It is only there when the one in view has a window,
    //  so there is somewhere new to go.
    let ws.new = if(not ws.1.busy and ws.active != 1, 1, if(not ws.2.busy and ws.active != 2, 2, if(not ws.3.busy and ws.active != 3, 3, if(not ws.4.busy and ws.active != 4, 4, if(not ws.5.busy and ws.active != 5, 5, if(not ws.6.busy and ws.active != 6, 6, if(not ws.7.busy and ws.active != 7, 7, if(not ws.8.busy and ws.active != 8, 8, if(not ws.9.busy and ws.active != 9, 9, if(not ws.10.busy and ws.active != 10, 10, 0))))))))))
    prop ws.pv = 0 ~lively
    follow ws.pv = if(ws.new > 0 and not ws_empty and not ws.special, 1, 0)
    prop ws.sp = 0 ~lively                              // how much the special workspace's mark is there
    follow ws.sp = if(ws.special, 1, 0)
    prop ws.spa = 0 ~lively                             // which mark it is: the sparkle (magic, and any other), the music notes, the crossed-out eye (private)
    prop ws.spm = 0 ~lively
    prop ws.spp = 0 ~lively
    follow ws.spa = if(ws.special and ws.spk == 0, 1, 0)
    follow ws.spm = if(ws.special and ws.spk == 1, 1, 0)
    follow ws.spp = if(ws.special and ws.spk == 2, 1, 0)
    prop wspl.0 = 0 ~pop                                  // the plus's hover, on the spring that pops past
    prop wspl.1 = 0 ~pop
    prop wspl.2 = 0 ~pop
    prop wspl.3 = 0 ~pop
    //  The mark of the workspace in view is one piece that travels: its head runs ahead to the new place and its tail follows, so it
    //  stretches across what lies between and gathers again.
    prop pl.head = 1 ~150ms
    prop pl.tail = 1 ~400ms
    follow pl.head = ws.active
    follow pl.tail = ws.active
    //  A workspace that is out of view and has a window asking for attention: its dot warms and breathes until you go there.
    let warm = #ff7a59
    prop ws.urg.1 = 0 ~calm
    prop ws.urg.2 = 0 ~calm
    prop ws.urg.3 = 0 ~calm
    prop ws.urg.4 = 0 ~calm
    prop ws.urg.5 = 0 ~calm
    prop ws.urg.6 = 0 ~calm
    prop ws.urg.7 = 0 ~calm
    prop ws.urg.8 = 0 ~calm
    prop ws.urg.9 = 0 ~calm
    prop ws.urg.10 = 0 ~calm
    follow ws.urg.1 = if(ws.1.urgent, 1, 0)
    follow ws.urg.2 = if(ws.2.urgent, 1, 0)
    follow ws.urg.3 = if(ws.3.urgent, 1, 0)
    follow ws.urg.4 = if(ws.4.urgent, 1, 0)
    follow ws.urg.5 = if(ws.5.urgent, 1, 0)
    follow ws.urg.6 = if(ws.6.urgent, 1, 0)
    follow ws.urg.7 = if(ws.7.urgent, 1, 0)
    follow ws.urg.8 = if(ws.8.urgent, 1, 0)
    follow ws.urg.9 = if(ws.9.urgent, 1, 0)
    follow ws.urg.10 = if(ws.10.urgent, 1, 0)

    on change drop > 0.97 while drop > 0.97 { impulse sag 220; impulse wobble -260 }
    //  The volume's and notifications' drawer lands the same way (it is no longer a value of `panel`, so `drop` does not follow it).
    on change do0 > 0.97 while do0 > 0.97 { impulse sag 220; impulse wobble -260 }
    //  The same moments as in Marea, for the left layout's drop: it lets go (the edge jumps and bounces, two ripples set off, a small drop stays
    //  hanging and is swallowed), it is grabbed on its way back, and the edge closes over it once it has gone in.
    on change dsl > 0.84 while dsl > 0.84 and fm > 0.5 { impulse pbounce -280; impulse wobble -520; prip: 0 ~16ms; prip: 1 ~1100ms after 30ms; pstray: 1 ~16ms; pstray: 0 ~700ms after 60ms }
    on change dsl < 0.84 while dsl < 0.84 and fm > 0.5 { impulse wobble 300; impulse pbounce 80 }
    on change dsl < 0.06 while dsl < 0.06 and fm > 0.5 { impulse pbounce -200; impulse wobble -160; prip: 0 ~16ms; prip: 1 ~600ms after 30ms }
    //  A drawer that has gone back into the bar: the surface closes over it, and a ripple runs out from the
    //  middle of the bar (the same wave the music makes, from another place).
    on change drop < 0.08 while drop < 0.08 and panel == none {
        impulse wobble 90
        ring_mid: 1 ~0ms
        ring: 0 ~16ms
        ring: 1 ~600ms after 30ms
    }
    //  What is inside a panel arrives after the drawer has come down, not with it (it was showing while the
    //  drawer was still a sliver under the bar, over the bar's lower half), and leaves at once when the panel
    //  closes, so nothing is left hanging over the bar as it shuts. Each keeps its own spring, so the
    //  controls' plates still arrive one after another.
    on change panel while panel == calendar   { f1: 1 after 220ms; f4: 1 after 300ms }
    //  Each close says it again just after the open's own delay would have fired: a panel opened and closed inside that delay would else have its
    //  `after` come in late and leave the content drawn over a closed drawer (the calendar's last row stuck in the bar).
    on change panel while panel != calendar   { f1: 0 ~80ms; f4: 0 ~80ms; f1: 0 ~80ms after 225ms; f4: 0 ~80ms after 305ms }
    on change panel while panel == controls   { f2: 1 after 200ms; f5: 1 after 200ms; f6: 1 after 200ms; f7: 1 after 200ms }
    on change panel while panel != controls   { f2: 0 ~80ms; f5: 0 ~80ms; f6: 0 ~80ms; f7: 0 ~80ms; f2: 0 ~80ms after 205ms; f5: 0 ~80ms after 205ms; f6: 0 ~80ms after 205ms; f7: 0 ~80ms after 205ms }
    on change panel while panel == player     { dm_mode = dmm_player }
    on change panel while panel == tray       { dm_mode = dmm_tray }
    on change panel while panel == player or panel == tray { f3: 1 after 200ms }
    on change panel while panel != player and panel != tray { f3: 0 ~80ms; f3: 0 ~80ms after 205ms }
    on change panel while panel == settings   { fs: 1 after 220ms }
    on change panel while panel == launch     { fl: 1 after 200ms; focus lq; emit launch_open }
    on change panel while panel != launch     { fl: 0 ~80ms; fl: 0 ~80ms after 205ms }
    on change panel while panel != settings   { fs: 0 ~80ms; fs: 0 ~80ms after 225ms }
    on change osd_on while osd_on { fo: 1 after 140ms }
    on change osd_on while not osd_on { fo: 0 ~80ms }
    follow wifi_on = if(net.wifi, 1, 0)
    follow wf_fill = if(net.wifi, 1, 0)
    follow bt_fill = if(bt.powered, 1, 0)
    follow dnd_fill = if(dnd_on, 1, 0)
    follow caf_fill = if(caf_on, 1, 0)
    follow dnd_sel = if(not dnd_on, 0, if(dnd_len == 15, 1, if(dnd_len == 30, 2, if(dnd_len == 60, 3, if(dnd_len == 120, 4, 5)))))
    follow caf_sel = if(not caf_on, 0, if(caf_len == 15, 1, if(caf_len == 30, 2, if(caf_len == 60, 3, if(caf_len == 120, 4, if(caf_len == 240, 5, 6))))))
    follow wifi_extra = if(wifi_open_row >= 0, 1, 0)
    on change wifi_open_row while wifi_open_row >= 0 and wifi_extra < 0.05 { wifi_sel: wifi_open_row ~0ms }
    on change wifi_open_row while wifi_open_row >= 0 and wifi_extra >= 0.05 { wifi_sel: wifi_open_row }
    follow bt_extra = if(bt_open_row >= 0, 1, 0)
    follow bt_pf = bt_pf_h + bt_set_h
    follow wifi_pf = wifi_pf_h
    follow bt_trust_t = if(bt_trusted, 1, 0)
    follow bt_disc_t = if(bt_discoverable, 1, 0)
    on change bt_open_row while bt_open_row >= 0 and bt_extra < 0.05 { bt_sel: bt_open_row ~0ms }
    on change bt_open_row while bt_open_row >= 0 and bt_extra >= 0.05 { bt_sel: bt_open_row }
    follow bt_on   = if(bt.powered, 1, 0)
    prop dnd_pill = 0 ~pop
    prop caf_pill = 0 ~pop
    prop rec_pill = 0 ~pop
    fact pw_s0 = 0                   // when the Lock button was pressed (`time`)
    prop pw_hp0 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d0 = false               // it is being held
    follow pw_hp0 = if(pw_d0, clamp((time - pw_s0) / 1, 0, 1), 0)
    fact pw_b0 = -100                // when its hold completed and it shattered (`time`); the tile is gone for 0.8 s and then comes back together
    event pw_shatter0
    fact pw_s1 = 0                   // when the Sleep button was pressed (`time`)
    prop pw_hp1 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d1 = false               // it is being held
    follow pw_hp1 = if(pw_d1, clamp((time - pw_s1) / 1, 0, 1), 0)
    fact pw_b1 = -100                // when its hold completed and it shattered (`time`); the tile is gone for 0.8 s and then comes back together
    event pw_shatter1
    fact pw_s2 = 0                   // when the Log out button was pressed (`time`)
    prop pw_hp2 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d2 = false               // it is being held
    follow pw_hp2 = if(pw_d2, clamp((time - pw_s2) / 1, 0, 1), 0)
    fact pw_b2 = -100                // when its hold completed and it shattered (`time`); the tile is gone for 0.8 s and then comes back together
    event pw_shatter2
    fact pw_s3 = 0                   // when the Restart button was pressed (`time`)
    prop pw_hp3 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d3 = false               // it is being held
    follow pw_hp3 = if(pw_d3, clamp((time - pw_s3) / 1, 0, 1), 0)
    fact pw_b3 = -100                // when its hold completed and it shattered (`time`); the tile is gone for 0.8 s and then comes back together
    event pw_shatter3
    fact pw_s4 = 0                   // when the Power off button was pressed (`time`)
    prop pw_hp4 = 0 ~80ms             // how far its hold has got, 0 to 1 in a steady second (this spring only smooths the ends)
    fact pw_d4 = false               // it is being held
    follow pw_hp4 = if(pw_d4, clamp((time - pw_s4) / 1, 0, 1), 0)
    fact pw_b4 = -100                // when its hold completed and it shattered (`time`); the tile is gone for 0.8 s and then comes back together
    event pw_shatter4
    prop pow_th = 1 ~pop                // where the power-profile thumb is: 0 saver, 1 balanced, 2 performance
    prop wp_show_pill = 0 ~pop
    prop iris_pill = 0 ~pop
    prop bar_lm = 0 ~calm
    prop bar_tm = 0 ~calm
    prop bar_sg = 0 ~calm
    prop pw_x = 450 ~90ms
    prop dtrav = 0 ~dripl             // how far a panel has come out of the strip, 0 to 1 (the left layout's own, slow, drop)
    prop pbounce = 0 ~splash          // the strip's edge bouncing when the thread breaks
    prop prip = 1 ~1100ms              // the ripple that runs along the strip's edge, 0 just born, 1 gone
    prop pstray = 0 ~700ms            // the small drop that is left hanging from the edge
    prop rand_spin = 0 ~pop
    prop set_pg = 0 ~calm
    prop set_pgd = 0 ~calm
    prop set_pgh = 0 ~calm
    prop set_pga = 0 ~calm
    prop set_pgn = 0 ~calm
    prop set_pgs = 0 ~calm
    prop set_pgt = 0 ~calm
    prop set_pgl = 0 ~calm
    prop set_pgw = 0 ~calm
    prop set_pgv = 0 ~calm
    prop set_pgk = 0 ~calm
    prop set_pgp = 0 ~calm
    prop set_pgy = 0 ~calm
    prop set_pgo = 0 ~calm
    prop set_pgb = 0 ~calm
    prop bs.ws = 1 ~calm              // each piece of the bar, 1 shown .. 0 hidden: its room and its opacity
    prop bs.title = 1 ~calm
    prop bs.media0 = 1 ~calm
    prop bs.title0 = 1 ~calm
    prop bs.media = 1 ~calm
    prop bs.sr = 1 ~calm
    prop bs.ctl = 1 ~calm
    prop bs.clock = 1 ~calm
    prop bs.tray = 1 ~calm
    //  The scene's own `time`. If a scene only names `time`, pleamar makes one that never stops, and a scene with a
    //  clock that never stops never rests: it paints every frame for as long as it lives. This one turns only while
    //  something on screen is using it (the scan rings, the pulse of a device being connected, the volume drawer's
    //  face and ripple, the caffeine steam, the urgent dot, the "More" cue), and the scene sleeps the rest of the time.
    prop time = 0
    //  The battery: the bar itself is the gauge. A soft fill grows from its left edge as far as the charge goes, and
    //  goes red below 20 % while it is draining. A machine with no battery (a desktop) draws nothing.
    prop batt_fill = 0 ~calm            // 0..1, the charge, smoothly
    prop batt_on = 0 ~calm              // 1 when there is a battery
    prop batt_low = 0 ~calm             // 1 while below 20 % and not charging
    //  The gauge is not there at rest. It appears (grows a little and fades in) while the pointer is on the bar (any of
    //  its zones: a zone is only hovered while it is the topmost one under the pointer, so it is the most of them all),
    //  and stays while the charge is under 20 %, whatever the pointer does.
    prop batt_open.0 = 0 ~calm
    prop batt_open.1 = 0 ~calm
    prop batt_open.2 = 0 ~calm
    prop batt_open.3 = 0 ~calm
    //  While the charger is filling the battery, a soft glint crosses the bar every 5 seconds (and once as soon as it
    //  is plugged in): `charge_sweep` goes from 0 to 1 over 0.9 s and then rests at 1. It is a timer that wakes the
    //  scene for that second and lets it sleep for the other four. A battery that says "charging" at 98 % or more is
    //  full and only being held there, so it does not glint.
    prop charge_sweep = 1 ~calm
    every 5s while chg_now and bat_pct < 98 { charge_sweep: 0 ~0ms; charge_sweep: 1 ~600ms after 40ms }
    on change chg_now while chg_now and bat_pct < 98 { charge_sweep: 0 ~0ms; charge_sweep: 1 ~600ms after 40ms }
    repeat i in 1..11 { prop wsh.$i.0 = 0 ~quick }         // each workspace dot's hover, brought out of its `repeat`
    repeat i in 1..11 { prop wsh.$i.1 = 0 ~quick }
    repeat i in 1..11 { prop wsh.$i.2 = 0 ~quick }
    repeat i in 1..11 { prop wsh.$i.3 = 0 ~quick }
    prop ovp.0 = 0 ~pop                                   // the overview button's hover, on the same spring: how much it swells
    prop ovp.1 = 0 ~pop
    prop ovp.2 = 0 ~pop
    prop ovp.3 = 0 ~pop
    repeat i in 1..11 { prop wsp.$i.0 = 0 ~pop }           // the same, on a spring that pops a little past: how much a hovered mark swells
    repeat i in 1..11 { prop wsp.$i.1 = 0 ~pop }
    repeat i in 1..11 { prop wsp.$i.2 = 0 ~pop }
    repeat i in 1..11 { prop wsp.$i.3 = 0 ~pop }
    follow batt_fill = clamp(bat_pct / 100, 0, 1)
    follow batt_on = if(bat_here, 1, 0)
    follow batt_low = if(bat_pct < 20 and not chg_now, 1, 0)
    prop rcn = 0 ~calm                // the recording dot's slot on the bar, 1 while a recording runs
    spring cdk_sp = 380, 30
    prop cdk_ga = 0 ~calm             // how far out the corner dock is (0 while it holds nothing)
    prop cdk_cx.0 = 0 ~cdk_sp           // where the middle of its icons is, in the glass's own drawing (see `cdk.*`)
    prop cdk_cx.1 = 0 ~cdk_sp
    prop cdk_cx.2 = 0 ~cdk_sp
    prop cdk_cx.3 = 0 ~cdk_sp
    prop cdk_cy.0 = 0 ~cdk_sp
    prop cdk_cy.1 = 0 ~cdk_sp
    prop cdk_cy.2 = 0 ~cdk_sp
    prop cdk_cy.3 = 0 ~cdk_sp
    prop cdk_ax.0 = 0 ~calm             // which way it reaches into the frame: -1 left, 1 right, 0 free (while it is pulled)
    prop cdk_ax.1 = 0 ~calm
    prop cdk_ax.2 = 0 ~calm
    prop cdk_ax.3 = 0 ~calm
    prop cdk_ay.0 = 0 ~calm
    prop cdk_ay.1 = 0 ~calm
    prop cdk_ay.2 = 0 ~calm
    prop cdk_ay.3 = 0 ~calm
    prop adk_ga = 0 ~calm             // how far out the add-on pill is (0 while it holds nothing)
    prop adk_cx.0 = 0 ~cdk_sp
    prop adk_cx.1 = 0 ~cdk_sp
    prop adk_cx.2 = 0 ~cdk_sp
    prop adk_cx.3 = 0 ~cdk_sp
    prop adk_cy.0 = 0 ~cdk_sp
    prop adk_cy.1 = 0 ~cdk_sp
    prop adk_cy.2 = 0 ~cdk_sp
    prop adk_cy.3 = 0 ~cdk_sp
    prop adk_ax.0 = 0 ~calm
    prop adk_ax.1 = 0 ~calm
    prop adk_ax.2 = 0 ~calm
    prop adk_ax.3 = 0 ~calm
    prop adk_ay.0 = 0 ~calm
    prop adk_ay.1 = 0 ~calm
    prop adk_ay.2 = 0 ~calm
    prop adk_ay.3 = 0 ~calm
    prop trn = 0 ~calm                // how many tray icons the bar holds, smoothly: the bar widens with it
    prop disp_auto_pill = 0 ~pop
    prop snd_pill = 0 ~pop
    prop disp_dd = 0 ~calm            // the resolution dropdown, 0 shut .. 1 open
    prop disp_scroll = 0 ~quick       // the page's scroll, following disp_scroll_to
    prop disp_pn_s = 0 ~calm          // the profiles card's rows, smoothed: it grows and shrinks with them
    prop dnd_wobble = 0 ~pop       // the bell, swung when DND flips
    follow dnd_pill = if(dnd_on, 1, 0)
    follow caf_pill = if(caf_on, 1, 0)
    follow rec_pill = if(rec_on, 1, 0)
    follow pow_th = if(pow_prof < 0, 1, pow_prof)
    follow wp_show_pill = if(wp_show, 1, 0)
    follow iris_pill = if(iris_on, 1, 0)
    prop bar_zs = 1 ~120ms
    follow bar_zs = bar_size
    follow bar_lm = if(bar_frame and (bar_anchor == left or bar_anchor == right), 1, 0)
    follow bar_tm = if(bar_frame and (bar_anchor == top or bar_anchor == bottom), 1, 0)
    follow bar_sg = if(bar_frame and bar_seg and bar_anchor == top, 1, 0)
    follow pw_x = lp_w
    follow rand_spin = rand_turn
    follow set_pg = if(set_page == pg_glass, 1, 0)
    follow set_pgd = if(set_page == pg_disp, 1, 0)
    follow set_pgh = if(set_page == pg_hypr, 1, 0)
    follow set_pgb = if(set_page == pg_bar, 1, 0)
    follow set_pga = if(set_page == pg_about, 1, 0)
    follow set_pgn = if(set_page == pg_night, 1, 0)
    follow set_pgs = if(set_page == pg_sys, 1, 0)
    follow set_pgt = if(set_page == pg_nt, 1, 0)
    follow set_pgl = if(set_page == pg_lock, 1, 0)
    follow set_pgw = if(set_page == pg_wm, 1, 0)
    follow set_pgv = if(set_page == pg_vpn, 1, 0)
    follow set_pgk = if(set_page == pg_clock, 1, 0)
    follow set_pgp = if(set_page == pg_theme, 1, 0)
    follow set_pgy = if(set_page == pg_keys, 1, 0)
    follow set_pgo = if(set_page == pg_addons, 1, 0)
    follow bs.ws = if(bv.ws, 1, 0)
    follow bs.title = if(bv.title and (bar_anchor == top or bar_anchor == bottom), 1, 0)
    follow bs.media = if(bv.media and (bar_anchor == top or bar_anchor == bottom), 1, 0)
    follow bs.media0 = if(bv.media, 1, 0)
    follow bs.title0 = if(bv.title, 1, 0)
    follow bs.sr = if(bv.sr, 1, 0)
    follow bs.ctl = if(bv.ctl, 1, 0)
    follow bs.clock = if(bv.clock, 1, 0)
    follow bs.tray = if(bv.tray, 1, 0)
    follow trn = bartrays.count
    follow cdk_ga = if(cdk_on and cdk_pins.count > 0, 1, 0)
    follow adk_ga = if(adk_pins.count > 0, 1, 0)
    follow rcn = if(rec_on, 1, 0)
    prop pvn = 0 ~calm                // the privacy lights' slots, the same way
    follow pvn = if(priv_mic, 1, 0) + if(priv_cam, 1, 0) + if(priv_scr and not rec_on, 1, 0)
    repeat i in 0..8 {
        prop bcx.$i = 0 ~quick
        prop bcy.$i = 4 ~quick
        prop bcw.$i = 34 ~quick
        follow bcx.$i = bc.$i.x
        follow bcy.$i = bc.$i.y
        follow bcw.$i = bc.$i.w
    }
    //  Settings > Hyprland: what Hyprland has now (see the logic), and the toggles' knobs.
    fact hy_layout = 3
    fact hy_gaps = 5
    fact hy_round = 10
    fact hy_border = 3
    fact hy_sens = 0
    fact hy_follow = 1
    fact hy_resize = false
    fact hy_tear = false
    fact hy_anim = true
    fact hy_nat = false
    fact ni_center = 0                // Settings > niri: when the focused column is centred (0 never, 1 always, 2 when it overflows)
    fact ni_colw = 1                  // the width a new column opens at (0 a third, 1 a half, 2 two thirds, 3 the whole)
    fact ni_single = false            // a lone column sits in the middle
    //  Settings > Pleamar-WM: what the window manager has now (see the logic). The window manager's own facts are set live; the
    //  input lines go to session.conf and apply at the next login.
    fact wm_hypr = false             // the session is Hyprland: the Hyprland page is in the Settings (set by the logic)
    fact wm_pwm = false              // the session is pleamar-wm: the Pleamar-WM page is in the Settings
    fact wm_niri = false             // the session is niri: neither of those pages is, and the Keybinds and Night mode pages work on niri's files (set by the logic)
    fact wm_layout = 0                // the layout of the monitor picked below it
    fact wm_mon_sel = 0               // which monitor's layout the chips set: its slot, 0 and up
    repeat i in 0..4 {
        fact wm_m.$i.on = false
        text wm_m.$i.name = ""
    }
    event wm_mon_pick ->
    fact wm_share = 0.56
    fact wm_gap = 12
    fact wm_free = false
    fact wm_rain = false
    fact wm_snow = false
    fact wm_ms = 0
    fact wm_ts = 0
    fact wm_nat = false
    fact wm_tap = false
    fact wm_idle = 7
    fact wm_bw = 1.5
    fact wm_ba = 70
    fact wm_rad = 12
    fact wm_shd = 100
    fact wm_tb = 22
    fact wm_tbo = 72
    fact wm_wa = 100
    fact wm_wi = 100
    fact wm_fr = 80
    fact wm_wst = 0                  // the window style: 0 Vitreus glass, 1 Water, 2 Borderless, 3 Glow
    fact wm_tbt = true               // title bars on tiled windows
    text wm_fr_text = "80%"
    text wm_wa_text = "100%"
    text wm_wi_text = "100%"
    text wm_bw_text = "1.5 px"
    text wm_ba_text = "70%"
    text wm_rad_text = "12 px"
    text wm_shd_text = "100%"
    text wm_tb_text = "22 px"
    text wm_tbo_text = "72%"
    fact wm_scroll_to = 0
    prop wm_scroll = 0 ~quick
    follow wm_scroll = wm_scroll_to
    text wm_share_text = "56%"
    text wm_gap_text = "12 px"
    text wm_ms_text = "0.00"
    text wm_ts_text = "0.00"
    text wm_idle_text = "7 min"
    prop wm_k0 = 0 ~pop
    prop wm_k1 = 0 ~pop
    prop wm_k2 = 0 ~pop
    prop wm_k3 = 0 ~pop
    follow wm_k0 = if(wm_free, 1, 0)
    follow wm_k1 = if(wm_rain, 1, 0)
    follow wm_k2 = if(wm_snow, 1, 0)
    follow wm_k3 = if(wm_nat, 1, 0)
    prop wm_k4 = 0 ~pop
    follow wm_k4 = if(wm_tap, 1, 0)
    prop wm_k5 = 0 ~pop
    follow wm_k5 = if(wm_tbt, 1, 0)
    //  The About page (Settings > System): what this shell is built from, and how to update it.
    text about_commit = "…"
    text about_date = ""
    text about_sub = ""
    text about_pl = ""
    text about_msg = ""
    fact about_behind = -1              // commits waiting upstream; -1 not known yet
    fact about_busy = false
    fact about_restarting = false   // Restart was pressed: the shell is about to be replaced (the only reason to grey the button out)
    //  Night mode (Settings > Night mode): a warm tint over the whole screen, made by Hyprland's screen shader (see the
    //  logic), by hand or on a schedule.
    fact night_on = false               // the shader is on now
    fact night_auto = false             // it switches itself on and off on the schedule
    fact night_t = 0.65                 // how warm, 0 (6500 K) to 1 (2500 K), along the slider
    text night_temp_text = "3900 K"
    text night_start_text = "9:00 PM"
    text night_end_text = "6:00 AM"
    text night_status = "Off"
    prop night_pill = 0 ~pop
    prop rec_mic_pill = 0 ~pop
    follow rec_mic_pill = if(rec_mic, 1, 0)
    prop rec_sys_pill = 0 ~pop
    follow rec_sys_pill = if(rec_sys, 1, 0)
    prop night_auto_pill = 0 ~pop
    follow night_pill = if(night_on, 1, 0)
    prop bar_oth_pill = 0 ~pop
    follow bar_oth_pill = if(bar_others, 1, 0)
    prop bar_dr_pill = 0 ~pop
    follow bar_dr_pill = if(bar_dockroom, 0, 1)         // the switch says "Corner docks overlap windows": on when there is no room
    follow night_auto_pill = if(night_auto, 1, 0)
    //  Settings > Lock screen: what the lock screen scene holds. The logic asks it when the page opens (`lk_ok` is false if it did not
    //  answer) and tells it what is changed; the lock screen keeps them in its own lockscreen.json.
    fact lk_blur = 36                  // pixels at 1920 wide: 18, 36 or 60 are the chips
    fact lk_12h = true
    fact lk_ampm = true
    fact lk_media = true
    fact lk_date: lkd_long | lkd_std | lkd_day | lkd_iso = lkd_long
    fact lk_ok = true
    //  Settings > Widgets (Clock first): the desktop clock is a scene of its own (desktopclock/), which keeps its settings in its own desktopclock.json. This page asks it
    //  for them when it opens (`ck_ok` is false when it does not answer, which is when it is not running) and tells it each change.
    fact ck_on = false
    fact ck_lay = 0                    // the layout: 0 pipe, 1 rule, 2 tower, 3 digital, 4 slash, 5 hero
    fact ck_px = 220                   // the digits' height: 140, 220, 280 or 340
    fact ck_12h = true
    fact ck_wt = 1                     // the strokes: 0 thin, 1 regular, 2 bold
    fact ck_cl = 1                     // the glass: 0 clear, 1 soft, 2 full
    fact ck_ok = true
    prop ck_pill = 0 ~pop
    follow ck_pill = if(ck_on, 1, 0)
    event ck_toggle ->
    event ck_lay_set ->                // 0 to 5, as above
    event ck_size_set ->               // 0 small, 1 medium, 2 large, 3 extra large
    event ck_12h_set ->                // 1 twelve hours, 0 twenty-four
    //  The clock's hours, minutes and divider, each with a style of its own (Widgets page): the one picked (0 hours, 1 minutes, 2 divider) and its weight, size and tint
    //  as a step (0 to 4) of the lists in the logic.
    fact gl_sel = 0
    //  What the clock scene holds for each part (the logic mirrors it), which the example clock in the Widgets page draws: a weight and a size (multipliers, 1 is the
    //  normal one) and a tint (0 glass, 1 mint, 2 light, 3 rose, 4 grey) for the hours (`gh`), the minutes (`gm`) and the divider (`gs`).
    fact ghw = 1
    fact ghz = 1
    fact ghc = 0
    fact gmw = 1
    fact gmz = 1
    fact gmc = 0
    fact gsw = 1
    fact gsz = 1
    fact gsc = 0
    fact gl_w = 2
    fact gl_z = 2
    fact gl_c = 0
    event gl_pick ->
    event gl_w_set ->
    event gl_z_set ->
    event gl_c_set ->
    event gl_reset ->                  // the picked one back to the normal style
    event gl_reset_all ->
    //  The desktop system monitor, further down the same page (the Widgets page): the same way, with its own scene (desktopsysmon/).
    fact sy_on = false
    fact sy_cl = 1                     // the glass: 0 clear, 1 soft, 2 full
    fact sy_ok = true
    prop sy_pill = 0 ~pop
    follow sy_pill = if(sy_on, 1, 0)
    event sy_toggle ->
    event sy_cl_set ->                 // 0 to 2
    //  The audio visualiser: the bottom edge of the screen rising into the music (pages/bar_shapes.plm), under the system monitor on the same page. Sliders in Settings > Widgets;
    //  their events carry where on the track (0 to 1) and logic/visualizer.luau turns that into these (and keeps them in framewave.json). `fw_on` is the switch (declared with the bass, above).
    fact fw_cols = 24                  // how many columns: 6 to 47
    fact fw_sens = 1                   // how far the music pushes them: 0.3 to 3 (a log scale on the slider)
    fact fw_hgt = 150                  // how tall at most, in px at scale 1: 40 to 300
    fact fw_lay = 0                    // where it stands: 0 along the bottom, 1 in the four corners, 2 along the top, 3 down the left, 4 down the right
    fact fw_bl = 1                     // 0 apart, 1 liquid: how much each column melts into the next
    fact fw_mon = 0                    // which monitor shows it (Settings > Widgets, "Show on"): 0 all of them, k + 1 the chip `cv_m.k`
    fact fw_sw = 0                     // and that monitor's size, which each copy of the scene compares with its own (0: every copy draws it)
    fact fw_sh = 0
    text fw_cols_text = "24"
    text fw_sens_text = "1.0x"
    text fw_hgt_text = "150"
    text fw_bl_text = "100%"
    prop fw_pill = 0 ~pop
    prop fw_lsel = 0 ~calm              // the layout tiles' glow moving from one to the other
    follow fw_lsel = fw_lay
    follow fw_pill = if(fw_on, 1, 0)
    event fw_toggle ->
    event fw_cols_set ->
    event fw_sens_set ->
    event fw_hgt_set ->
    event fw_bl_set ->
    event fw_lay_set ->
    event fw_mon_set ->                // "Show on": 0 all the monitors, k + 1 the chip `cv_m.k` (logic/visualizer.luau)
    //  The monitor chips' names (the clock's and the system monitor's use them too).
    repeat i in 0..4 {
        fact cv_m.$i.on = false
        text cv_m.$i.name = ""
    }
    //  The clock's and the system monitor's: 1 and up is a monitor's slot (the chips' names are `cv_m.N.name`).
    fact ck_mon = 0
    fact sy_mon = 0
    event ck_mon_set ->
    event sy_mon_set ->
    fact ck_scroll_to = 0              // the page scrolls like Lock screen's
    prop ck_scroll = 0 ~quick
    follow ck_scroll = ck_scroll_to
    event ck_wt_set ->
    event ck_cl_set ->
    prop lk_pill_am = 0 ~pop
    prop lk_pill_md = 0 ~pop
    follow lk_pill_am = if(lk_ampm, 1, 0)
    follow lk_pill_md = if(lk_media, 1, 0)
    event lk_blur_set ->               // 0 light, 1 medium, 2 heavy
    event lk_12h_set ->                // 1 twelve hours, 0 twenty-four
    event lk_ampm_toggle ->
    event lk_media_toggle ->
    event lk_date_set ->               // 0 long, 1 standard, 2 day first, 3 ISO
    //  The password bar on that page: what a typed character becomes, in what colours, and the example bar that is typed into (nothing typed
    //  is kept). They are the lock screen's own mask_style and shape_palette.
    fact lk_mask: lkm_shapes | lkm_dots | lkm_stars | lkm_special = lkm_shapes
    fact lk_pal: lkc_vibrant | lkc_accent | lkc_neon | lkc_pastel | lkc_mono = lkc_accent
    event lk_mask_set ->               // 0 shapes, 1 dots, 2 asterisks, 3 special
    event lk_pal_set ->                // 0 vibrant, 1 accent, 2 neon, 3 pastel, 4 monochrome
    text lb_pw = ""
    model lb max 16 { idx: number; rot: number; outline: bool; ci: number; sym: text }
    fact lb_ok = false                 // the example's pretend "unlocked"
    prop lb_okt = 0 ~calm
    follow lb_okt = if(lb_ok, 1, 0)
    event lb_submit ->
    figure lkshp = file "lockscreen/shapes.svg"
    fact lk_px = 200                   // the lock screen's clock size: 100, 150 or 200
    fact lk_secs = false               // seconds on its clock
    fact lk_power = true               // the sleep, restart and power off buttons on it
    prop lk_pill_sec = 0 ~pop
    follow lk_pill_sec = if(lk_secs, 1, 0)
    prop lk_pill_pw = 0 ~pop
    follow lk_pill_pw = if(lk_power, 1, 0)
    event lk_size_set ->               // 0 → 100, 1 → 150, 2 → 200
    event lk_secs_toggle ->
    event lk_power_toggle ->
    //  Where the clock, the password bar and the buttons are: on every monitor, or on one. `lk_mon` is 0 for all, or 1 and up for a monitor's slot.
    fact lk_mon = 0
    repeat i in 0..4 {
        fact lk_m.$i.on = false
        text lk_m.$i.name = ""
    }
    event lk_mon_set ->
    event lk_test ->                   // lock now, as a test: Esc or a minute opens it
    fact gl_scroll_to = 0              // the Glass page scrolls like the Lock screen's
    prop gl_scroll = 0 ~quick
    follow gl_scroll = gl_scroll_to
    fact lk_scroll_to = 0              // the page scrolls like System monitor's
    prop lk_scroll = 0 ~quick
    follow lk_scroll = lk_scroll_to
    event night_toggle ->
    event night_auto_toggle ->
    event night_temp_set ->             // the slider: 0..1
    event night_start_step ->           // -1 or 1, a half hour
    event night_end_step ->
    //  The wallpaper picker (SUPER + B): glass hexagons centred on the screen, drawn at the end of this scene. Every wallpaper is one
    //  hexagon (its picture already cut to the hexagon by the logic); how many there are sets how big they are, so that they always fill
    //  the tray. The logic makes the pictures (`wp_picker`), orders them by colour and does the awww side of a pick.
    model wp_picker max 200 { img: image 104, 120; hue: number; cur: bool; dim: bool; name: text }       // the picture is 124 x 143 (120 x 139 and two transparent pixels all round), and the cell is declared smaller, 104 x 120, in the same shape (the picture is fitted inside it; the resting tiles are drawn at about that size): every image takes its whole cell from the atlas (one 2048 x 2048 texture, shared with the text), and at 186 x 215 only about a hundred of the hundred and thirty-seven tiles fitted, the rest were drawn empty
    fact wp_picker_open = false
    text wp_kb = ""                          // the picker's keyboard catcher (see `wp_kb` in the picker)
    on change wp_picker_open while wp_picker_open { focus wp_kb }
    text wp_picker_status = ""                // "Reading your wallpapers… 42 of 137" while the first analysis runs
    text wp_picker_hero_name = ""             // the name of the hexagon under the pointer
    fact wp_picker_hero_cur = false           // the one under the pointer is the wallpaper in use
    fact wp_picker_hot = -1                   // the hexagon under the pointer, -1 none
    fact wp_picker_px = 0                     // where a pick was, for awww: pixels from the bottom left
    fact wp_picker_py = 0
    event wp_picker_toggle ->
    event wp_picker_pick ->
    event wp_picker_random ->
    fact wp_picker_leaving = false            // a wallpaper was picked: the tray fades so the desktop's own transition shows
    prop wp_picker_veil = 1 ~calm             // 1 normal, 0 while it is leaving
    follow wp_picker_veil = if(wp_picker_leaving, 0, 1)
    prop wp_picker_show = 0 ~calm             // 0 shut, 1 open
    follow wp_picker_show = if(wp_picker_open, 1, 0)
    //  The hexagon under the pointer is drawn again, on top, as a piece of liquid glass (see the end of the scene): it swells
    //  with a spring that overshoots, glides from one hexagon to the next, has a light sweep across it each time the pointer
    //  arrives, and its edge ripples (`liquid.wgsl`).
    shader liquid = file "liquid.wgsl"
    shader cardrip = file "cardrip.wgsl"
    shader dsh_water = file "dashboard/water.wgsl"            // the dashboard's pool (pages/dashboard.plm)
    shader dsh_underwater = file "dashboard/underwater.wgsl"  // the dashboard surfacing: its cards seen through water, then ripples that bulge their rims
    spring wp_picker_pop = 240, 14             // a spring that overshoots (about 17%): the snap out to the large size bounces
    fact wp_picker_hx = 0                     // where the hovered hexagon is
    fact wp_picker_hy = 0
    prop wp_picker_hs = 0 ~wp_picker_pop            // 0 at rest, 1 hovered (it overshoots)
    prop wp_picker_lx = 0 ~quick
    prop wp_picker_ly = 0 ~quick
    prop wp_picker_sw = 0 ~calm               // the light sweep's progress, 0 to 1
    //  Every tile has its own spring for how hovered it is, so each one morphs from small to large (and back) with a bounce.
    repeat i in 0..200 {
        prop gt.$i = 0 ~wp_picker_pop
        follow gt.$i = if(wp_picker_hot == i and wp_picker_open, 1, 0)
    }
    follow wp_picker_hs = if(wp_picker_hot >= 0 and wp_picker_open, 1, 0)
    prop wp_picker_tx = 0 ~quick              // where the pointer is on the hovered tile, about -0.5 to 0.5 across and down: the tilt follows it
    prop wp_picker_ty = 0 ~quick
    follow wp_picker_lx = wp_picker_hx
    follow wp_picker_ly = wp_picker_hy
    on change wp_picker_hot while wp_picker_hot >= 0 { wp_picker_sw: 0 ~40ms }
    on change wp_picker_hot while wp_picker_hot >= 0 { wp_picker_sw: 1 ~700ms after 60ms }
    on change wp_picker_open while not wp_picker_open { wp_picker_hot = -1 }
    on key Escape while wp_picker_open and wp_pg == 0 { wp_picker_open = false }
    //  The picker has a second page, a row of cards along the foot that changes the wallpaper live as they are shifted through. The two sit side by side and
    //  the whole picker swipes between them: Tab goes from one to the other (the arrows belong to the cards; the two dots at the foot can be pressed too). The cards are the logic's `wp_cards`:
    //  fifteen slots around the one in focus (a window onto the list: the atlas could not hold every picture), `wp_card_base` the position of the first slot
    //  in the list and `wp_card_sel` the one in focus. Escape puts the old wallpaper back; Enter, a click on the focused card or a click outside keeps what is showing.
    fact wp_pg = 0                            // the page asked for: 0 hexagons, 1 cards
    prop wp_pgp = 0 ~calm                     // and how far the swipe has got
    follow wp_pgp = wp_pg
    model wp_cards max 15 { img: image 96, 216; ix: number; cur: bool; ok: bool }        // the narrow strip of each wallpaper in the row (a tall crop of its middle)
    model wp_big max 2 { img: image 768, 432; ix: number; cur: bool; ok: bool }           // the picture of the one in focus, and of the one that has just left focus (so it can shrink)
    text wp_hex_info = ""                    // the same, for the hexagon the pointer is on
    fact wp_hex_cr = 0.5
    fact wp_hex_cg = 0.8
    fact wp_hex_cb = 0.7
    prop wp_hr = 0.5 ~calm
    prop wp_hg = 0.8 ~calm
    prop wp_hb = 0.7 ~calm
    follow wp_hr = wp_hex_cr
    follow wp_hg = wp_hex_cg
    follow wp_hb = wp_hex_cb
    text wp_card_info = ""                    // 3840 × 2160  ·  2.4 MB  ·  PNG  ·  41 of 137
    fact wp_card_cr = 0.5                     // the accent of the one in focus, from the wallpaper's own colour (0 to 1)
    fact wp_card_cg = 0.8
    fact wp_card_cb = 0.7
    prop wp_ar = 0.5 ~calm
    prop wp_ag = 0.8 ~calm
    prop wp_ab = 0.7 ~calm
    follow wp_ar = wp_card_cr
    follow wp_ag = wp_card_cg
    follow wp_ab = wp_card_cb
    fact wp_card_sel = 0
    fact wp_card_base = 0
    text wp_card_name = ""
    prop wp_cpos = 0 ~lively                  // where the row has got to, in cards: it glides to the one in focus
    follow wp_cpos = wp_card_sel
    prop wp_clag = 0 ~160ms                   // the same position, a little behind: `wp_cpos - wp_clag` is how fast the row is moving (the cards bend by it)
    follow wp_clag = wp_cpos
    fact wp_card_rip = 0                      // counts the cards kept: each one sets off the ripple
    prop wp_crip = 1 ~600ms                   // the card's ripple, as the island bar's when a panel closes: 0 just born, 1 gone
    on change wp_card_rip while wp_card_rip > 0 { wp_crip: 0 ~16ms; wp_crip: 1 ~600ms after 30ms }
    //  The cards' entrance: the same spring as Search and Settings drop on (`drip`, underdamped, so each card overshoots where it lands and settles back, as a drop does). One for
    //  each step away from the focused card, started a little after the one before it; they run from 0 to 1 when the picker opens on the cards or the swipe from the hexagons arrives.
    prop wp_ce0 = 0 ~drip
    prop wp_ce1 = 0 ~drip
    prop wp_ce2 = 0 ~drip
    prop wp_ce3 = 0 ~drip
    prop wp_ce4 = 0 ~drip
    prop wp_ce5 = 0 ~drip
    prop wp_ce6 = 0 ~drip
    prop wp_ce7 = 0 ~drip
    on change wp_picker_open while wp_picker_open and wp_pg > 0.5 { wp_ce0: 0 ~16ms; wp_ce0: 1 after 40ms }
    on change wp_pg while wp_pg > 0.5 and wp_picker_open { wp_ce0: 0 ~16ms; wp_ce0: 1 after 40ms }
    on change wp_picker_open while not wp_picker_open { wp_ce0: 0 ~200ms }
    on change wp_pg while wp_pg < 0.5 { wp_ce0: 0 ~250ms }
    on change wp_picker_open while wp_picker_open and wp_pg > 0.5 { wp_ce1: 0 ~16ms; wp_ce1: 1 after 85ms }
    on change wp_pg while wp_pg > 0.5 and wp_picker_open { wp_ce1: 0 ~16ms; wp_ce1: 1 after 85ms }
    on change wp_picker_open while not wp_picker_open { wp_ce1: 0 ~200ms }
    on change wp_pg while wp_pg < 0.5 { wp_ce1: 0 ~250ms }
    on change wp_picker_open while wp_picker_open and wp_pg > 0.5 { wp_ce2: 0 ~16ms; wp_ce2: 1 after 130ms }
    on change wp_pg while wp_pg > 0.5 and wp_picker_open { wp_ce2: 0 ~16ms; wp_ce2: 1 after 130ms }
    on change wp_picker_open while not wp_picker_open { wp_ce2: 0 ~200ms }
    on change wp_pg while wp_pg < 0.5 { wp_ce2: 0 ~250ms }
    on change wp_picker_open while wp_picker_open and wp_pg > 0.5 { wp_ce3: 0 ~16ms; wp_ce3: 1 after 175ms }
    on change wp_pg while wp_pg > 0.5 and wp_picker_open { wp_ce3: 0 ~16ms; wp_ce3: 1 after 175ms }
    on change wp_picker_open while not wp_picker_open { wp_ce3: 0 ~200ms }
    on change wp_pg while wp_pg < 0.5 { wp_ce3: 0 ~250ms }
    on change wp_picker_open while wp_picker_open and wp_pg > 0.5 { wp_ce4: 0 ~16ms; wp_ce4: 1 after 220ms }
    on change wp_pg while wp_pg > 0.5 and wp_picker_open { wp_ce4: 0 ~16ms; wp_ce4: 1 after 220ms }
    on change wp_picker_open while not wp_picker_open { wp_ce4: 0 ~200ms }
    on change wp_pg while wp_pg < 0.5 { wp_ce4: 0 ~250ms }
    on change wp_picker_open while wp_picker_open and wp_pg > 0.5 { wp_ce5: 0 ~16ms; wp_ce5: 1 after 265ms }
    on change wp_pg while wp_pg > 0.5 and wp_picker_open { wp_ce5: 0 ~16ms; wp_ce5: 1 after 265ms }
    on change wp_picker_open while not wp_picker_open { wp_ce5: 0 ~200ms }
    on change wp_pg while wp_pg < 0.5 { wp_ce5: 0 ~250ms }
    on change wp_picker_open while wp_picker_open and wp_pg > 0.5 { wp_ce6: 0 ~16ms; wp_ce6: 1 after 310ms }
    on change wp_pg while wp_pg > 0.5 and wp_picker_open { wp_ce6: 0 ~16ms; wp_ce6: 1 after 310ms }
    on change wp_picker_open while not wp_picker_open { wp_ce6: 0 ~200ms }
    on change wp_pg while wp_pg < 0.5 { wp_ce6: 0 ~250ms }
    on change wp_picker_open while wp_picker_open and wp_pg > 0.5 { wp_ce7: 0 ~16ms; wp_ce7: 1 after 355ms }
    on change wp_pg while wp_pg > 0.5 and wp_picker_open { wp_ce7: 0 ~16ms; wp_ce7: 1 after 355ms }
    on change wp_picker_open while not wp_picker_open { wp_ce7: 0 ~200ms }
    on change wp_pg while wp_pg < 0.5 { wp_ce7: 0 ~250ms }
    event wp_card_step ->                     // -1 or 1
    event wp_card_go ->                       // a card pressed, by its place in the list
    event wp_card_pick ->                     // keep this one
    event wp_card_cancel ->                   // put the old one back
    on key Right while wp_picker_open and wp_pg == 1 { emit wp_card_step(1) }
    on key Left while wp_picker_open and wp_pg == 1 and wp_card_sel > 0.5 { emit wp_card_step(-1) }
    on key Tab while wp_picker_open { wp_pg = 1 - wp_pg }
    on key Return while wp_picker_open and wp_pg == 1 { emit wp_card_pick }
    on key Escape while wp_picker_open and wp_pg == 1 { emit wp_card_cancel }
    on change wp_pg while wp_pg > 0.5 { wp_picker_hot = -1 }
    //  The workspace overview (the button before the bar's workspace dots, or the launcher): a card for each of the five workspaces,
    //  listing the windows on it. The logic fills `ovw` a slot at a time (nine to a workspace, in order) from `hyprctl clients`, each with a
    //  picture of the window taken while its workspace was in front.
    model ovw max 45 { ws: number; gx: number; gy: number; gc: number; gr: number; title: text; active: bool; used: bool; snap: bool; icon: image 37, 37 }
    //  The windows' pictures, live, straight from the service (same order as `ovw`: slot n is picture n).
    model wthumbs max 45 { id: text; title: text; app: text; picture: image 456, 257; stale: bool }
    service thumbnails { list: wthumbs }
    fact ov_hotc = 0                          // the workspace of the tile under the pointer
    repeat i in 0..5 { fact ov_cnt.$i = 0 }   // how many windows each workspace has 
    fact ov_else = 0                          // windows that are not on one of the five (special workspaces)
    fact ov_open = false
    event ov_toggle ->
    event ov_move ->                          // a window dropped on another workspace: its slot (and `ov_col`, the column)
    fact ov_drag = -1                         // the tile being held
    fact ov_col = 0                           // the column it was dropped on
    fact ov_dx = 0                            // how far it has been dragged
    fact ov_px = 0                            // where it was pressed: the card carried is there plus the drag
    fact ov_py = 0
    fact ov_dy = 0
    fact ov_hot = -1                          // the tile under the pointer
    event ov_focus ->
    prop ov_show = 0 ~calm
    follow ov_show = if(ov_open, 1, 0)
    on key Escape while ov_open { ov_open = false }
    on change ov_open while not ov_open { ov_drag = -1; ov_dx = 0; ov_dy = 0; ov_hot = -1 }
    //  The dashboard (pages/dashboard.plm): SUPER + SHIFT + D. Opening it puts away whatever else is open.
    fact dash_open = false
    event dash_toggle
    on dash_toggle { toggle dash_open }
    on change dash_open while dash_open { panel = none; ov_open = false; wp_picker_open = false }
    //  And the other way round: opening any panel, the overview, the wallpaper picker or the desk puts the dashboard away.
    on change panel while panel != none { dash_open = false }
    on change ov_open while ov_open { dash_open = false }
    on change wp_picker_open while wp_picker_open { dash_open = false }
    on change desk_open while desk_open { dash_open = false }
    on key Escape while dash_open and not face_open { dash_open = false }
    on key Escape while face_open { face_open = false }
    on change dash_open while not dash_open { face_open = false }
    //  Its movement: slow, and nothing overshoots. The cards are there from the start, just under the water, and come up through it.
    prop dsh_water = 0 ~420ms          // the pool: the screen dimmed and deepened
    prop dsh_rise = 0 ~540ms           // the cards coming up: how much they show, and their size
    prop dsh_under = 1 ~780ms         // how much water is still over the cards: wavering, murky, soft (1 just under, 0 out)
    prop dsh_rq = 0 ~1000ms            // the ripples round the cards' rims, as they break the surface and as they sink: how far they have run…
    prop dsh_rh = 0 ~1ms               // …and how strong they started
    prop dsh_hup = 0 ~lively          // the same cat, the pointer over its head: the head lifts (0 to 1)
    prop dsh_pet = 0 ~lively          // the notification cat being petted: follows the pointer over it (0 to 1)
    prop dsh_poke = 0 ~1700ms          // the sleeping speaker and cat, woken by a press (1), settling back (0)
    prop dsh_c0 = 0 ~420ms             // each tile firming up
    prop dsh_c1 = 0 ~420ms
    prop dsh_c2 = 0 ~420ms
    prop dsh_c3 = 0 ~420ms
    prop dsh_c4 = 0 ~420ms
    prop dsh_c5 = 0 ~420ms
    prop dsh_c6 = 0 ~420ms
    prop dsh_c7 = 0 ~420ms
    measure dsh_nm                     // and the user card's name (the uptime follows it)
    measure dsh_date                   // how wide the clock tile's date is (the battery follows it)
    measure dsh_temp                   // and its temperature (the weather icon sits before it)
    on change dash_open while dash_open {
        dsh_water: 1
        dsh_rise: 1 after 40ms
        dsh_under: 0 after 70ms
        dsh_rq: 0 ~1ms
        dsh_rh: 12
        dsh_rq: 1 after 250ms
        dsh_c0: 1 after 250ms
        dsh_c1: 1 after 290ms
        dsh_c2: 1 after 330ms
        dsh_c3: 1 after 370ms
        dsh_c4: 1 after 410ms
        dsh_c5: 1 after 450ms
        dsh_c6: 1 after 490ms
        dsh_c7: 1 after 530ms
        emit cal_open
    }
    //  Closing runs the opening backwards, a quarter faster: the same order, each step starting where it ended going up (the last tile in is the first
    //  out, the water the last to clear).
    on change dash_open while not dash_open {
        dsh_c7: 0 ~320ms
        dsh_c6: 0 ~320ms after 30ms
        dsh_c5: 0 ~320ms after 60ms
        dsh_c4: 0 ~320ms after 90ms
        dsh_c3: 0 ~320ms after 120ms
        dsh_c2: 0 ~320ms after 150ms
        dsh_c1: 0 ~320ms after 180ms
        dsh_c0: 0 ~320ms after 210ms
        dsh_under: 1 ~585ms after 75ms
        dsh_rq: 0 ~1ms
        dsh_rh: 12
        dsh_rq: 1 ~750ms after 190ms
        dsh_rise: 0 ~405ms after 250ms
        dsh_water: 0 ~315ms after 400ms
    }
    //  The authentication dialog. Vitreus is this session's polkit agent (bin/vitreus-polkit-agent, which the logic starts): when
    //  something asks for admin rights, the agent sets `pk_open` and the texts below; when Authenticate is pressed it reads the
    //  password out of `pk_pw` itself and clears the field.
    fact pk_open = false
    fact pk_busy = false            // polkit's helper is checking the password
    fact pk_shake = false           // the last password was wrong (and, with it, `pk_error` is showing)
    text pk_message = ""            // what polkit says: "Authentication is required to ..."
    text pk_user = ""               // whose password it asks for
    text pk_error = ""
    text pk_pw = ""                 // the password field
    fact pk_go = false              // Enter or Authenticate was pressed: the agent sees it, reads the field, and puts this back
    prop pk_show = 0 ~calm
    prop pk_sk = 0 ~pop             // the card's shake when the password is wrong
    follow pk_show = if(pk_open, 1, 0)
    on change pk_open while pk_open { focus pk_pw }
    on change pk_shake while pk_shake { pk_sk: -1 ~30ms }
    on change pk_shake while pk_shake { pk_sk: 0 ~450ms after 70ms }
    //  Everything here is the scene's own, so the dialog can always be put away: closing it (`pk_open` false) is what cancels the
    //  request, which the agent notices by asking; nothing has to get through the logic.
    on key Escape while pk_open { pk_open = false }
    on submit pk_pw { pk_go = true }
    //  Settings > System monitor. While that page is showing the logic runs bin/vitreus-sysmon, which prints what the machine is doing once a
    //  second; the logic turns it into the facts, texts and models below (nothing runs while the page is shut). The numbers that draw
    //  something are 0 to 1; the `*_p` springs smooth them so a gauge glides between readings.
    fact sm_scroll_to = 0
    prop sm_scroll = 0 ~quick
    follow sm_scroll = sm_scroll_to
    fact sm_cpu = 0                     // total CPU load, 0..1
    fact sm_mem_f = 0                   // memory in use
    fact sm_cache_f = 0                 // and in caches (which can be given back)
    fact sm_swap_f = 0
    fact sm_gpu_on = false              // a GPU that reports itself
    fact sm_gpu_f = 0                   // its load
    fact sm_vram_f = 0                  // its memory
    fact sm_pw_f = 0                    // its power draw against its limit
    prop sm_cpu_p = 0 ~calm
    prop sm_mem_p = 0 ~calm
    prop sm_cache_p = 0 ~calm
    prop sm_swap_p = 0 ~calm
    prop sm_gpu_p = 0 ~calm
    prop sm_vram_p = 0 ~calm
    prop sm_pw_p = 0 ~calm
    follow sm_cpu_p = sm_cpu
    follow sm_mem_p = sm_mem_f
    follow sm_cache_p = sm_cache_f
    follow sm_swap_p = sm_swap_f
    follow sm_gpu_p = sm_gpu_f
    follow sm_vram_p = sm_vram_f
    follow sm_pw_p = sm_pw_f
    text sm_host = ""
    text sm_cpu_name = ""
    text sm_kernel = ""
    text sm_user = ""                   // the account (the dashboard's user card)
    text sm_name = ""                   // its real name, or the account's if it has none
    text sm_distro = ""
    text sm_avatar = ""                 // the picture's path: ~/.face and its like
    fact sm_has_avatar = false
    text sm_face = ""                   // where the picture is kept (~/.face), whether or not there is one yet
    image sm_av = from sm_avatar, 200, 200
    text sm_uptime = ""
    text sm_load = ""
    text sm_cpu_txt = "0%"
    text sm_cpu_meta = ""               // 3.2 GHz · 46°C
    text sm_threads = ""
    text sm_mem_pct = "0%"
    text sm_mem_total = ""
    text sm_mem_used = ""
    text sm_mem_cache = ""
    text sm_mem_free = ""
    text sm_swap_txt = ""
    text sm_gpu_name = ""
    text sm_gpu_txt = "0%"
    text sm_gpu_vram = ""
    text sm_gpu_power = ""
    text sm_gpu_temp = ""
    text sm_gpu_fan = ""
    text sm_gpu_clock = ""
    text sm_iface = ""
    text sm_rx_txt = ""
    text sm_tx_txt = ""
    text sm_rx_total = ""
    text sm_tx_total = ""
    text sm_link = ""
    text sm_bt = ""
    text sm_ip = ""
    text sm_netinfo = ""
    text sm_dr_txt = ""
    text sm_dw_txt = ""
    text sm_fans = ""
    model sm_core max 32 { pct: number }
    model sm_hist max 60 { cpu: number; mem: number; gpu: number; rx: number; tx: number; dr: number; dw: number }
    model sm_mnt max 6 { name: text; info: text; pct: number }
    model sm_tmp max 8 { label: text; txt: text; f: number; heat: number }
    model sm_proc max 8 { name: text; cpu_txt: text; mem_txt: text; cpu: number }
    //  Settings > VPN (see "Settings > VPN" in vitreus.luau): the profiles NetworkManager holds, and a form to add one.
    fact vpn_scroll_to = 0
    prop vpn_scroll = 0 ~quick
    follow vpn_scroll = vpn_scroll_to
    fact vpn_mode: vpm_wg | vpm_ovpn | vpm_imp = vpm_wg
    fact vpn_tcp = false              // the OpenVPN form: TCP instead of UDP
    fact vpn_busy = false             // something is being connected, deleted or added
    fact vpn_on = false               // a profile is connected
    fact vpn_count = 0
    fact vpn_arm = -1                 // the row whose delete button has been pressed once
    text vpn_title = "Not connected"
    text vpn_sub = ""
    text vpn_msg = ""
    text vpn_file = ""
    text vpnw_name = ""
    text vpnw_addr = ""
    text vpnw_key = ""
    text vpnw_peer = ""
    text vpnw_end = ""
    text vpnw_dns = ""
    text vpnw_ips = ""
    text vpnw_psk = ""
    text vpno_name = ""
    text vpno_server = ""
    text vpno_port = ""
    text vpno_user = ""
    text vpno_pw = ""
    text vpno_ca = ""
    event vpn_refresh ->
    event vpn_toggle ->
    event vpn_down ->
    event vpn_arm_ask ->
    event vpn_delete ->
    event vpn_import ->
    event vpn_add_wg ->
    event vpn_add_ovpn ->
    event vpn_fpick ->                // a row of the file browser on the Import tab
    event vpn_fscroll ->
    fact vpn_fmore = false            // the folder has more rows than the browser shows
    text vpn_dir = ""
    repeat i in 0..8 {
        fact vpn_f.$i.on = false
        fact vpn_f.$i.dir = false
        text vpn_f.$i.name = ""
    }
    repeat i in 0..8 {
        fact vpn_r.$i.on = false
        fact vpn_r.$i.active = false
        text vpn_r.$i.name = ""
        text vpn_r.$i.sub = ""
    }
    //  Settings > Notifications (see "Notification rules and sounds" in vitreus.luau): the global switches and default sound, the apps that
    //  have sent something, and the rules of the one that is open.
    fact nt_scroll_to = 0
    prop nt_scroll = 0 ~quick
    follow nt_scroll = nt_scroll_to
    fact ntg_sounds = true             // a sound when one is shown
    fact ntg_crit = true               // critical ones ignore Do Not Disturb
    fact nt_quiet = false              // quiet hours are on (Settings > Notifications)
    fact nt_fs = false                 // hold notifications back while a window is fullscreen
    text nt_qfrom_t = ""
    text nt_qto_t = ""
    event nt_q_toggle ->
    event nt_fs_toggle ->
    event nt_q_step ->                 // 0 start earlier, 1 start later, 2 end earlier, 3 end later
    fact ntg_snd = 0                  // the default sound, 0..7
    fact nta_sel = -1                 // the app whose rules are open (its row), -1 none
    fact nta_count = 0
    fact nta_mute = false
    fact nta_silent = false
    fact nta_bypass = false
    fact nta_hide = false
    fact nta_urg = 0                  // 0 as the app sent it, 1 low, 2 normal, 3 critical
    fact nta_to = 0                   // 0 the usual, 1 4 s, 2 8 s, 3 15 s, 4 until dismissed
    fact nta_snd = 0                  // 0 the default sound, else 1..8
    fact nta_has_rule = false
    text nta_name = ""
    text nta_explain = ""
    model nta_apps max 14 { name: text; info: text; rule: bool }
    event nta_pick ->
    event nta_flag ->
    event nta_urgency ->
    event nta_timeout ->
    event nta_sound ->
    event nta_reset ->
    event ntg_flag ->
    event ntg_sound ->
    event nt_test ->
    prop ntk0 = 0 ~pop
    prop ntq0 = 0 ~pop
    prop ntq1 = 0 ~pop
    prop ntk1 = 0 ~pop
    prop ntk2 = 0 ~pop
    prop ntk3 = 0 ~pop
    prop ntk4 = 0 ~pop
    prop ntk5 = 0 ~pop
    follow ntk0 = if(ntg_sounds, 1, 0)
    follow ntk1 = if(ntg_crit, 1, 0)
    follow ntq0 = if(nt_quiet, 1, 0)
    follow ntq1 = if(nt_fs, 1, 0)
    follow ntk2 = if(nta_mute, 1, 0)
    follow ntk3 = if(nta_silent, 1, 0)
    follow ntk4 = if(nta_bypass, 1, 0)
    follow ntk5 = if(nta_hide, 1, 0)
    event about_check ->
    event about_update ->
    event about_restart ->
    text hy_gaps_text = "5 px"
    text hy_round_text = "10 px"
    text hy_border_text = "3 px"
    text hy_sens_text = "0.00"
    prop hy_k0 = 0 ~pop
    prop hy_k1 = 0 ~pop
    prop hy_k2 = 1 ~pop
    prop hy_k3 = 0 ~pop
    prop ni_k0 = 0 ~pop
    follow hy_k0 = if(hy_resize, 1, 0)
    follow hy_k1 = if(hy_tear, 1, 0)
    follow hy_k2 = if(hy_anim, 1, 0)
    follow hy_k3 = if(hy_nat, 1, 0)
    follow ni_k0 = if(ni_single, 1, 0)
    follow disp_auto_pill = if(disp_auto, 1, 0)
    follow snd_pill = if(snd_on, 1, 0)
    follow disp_dd = if(disp_res_open, 1, 0)
    follow disp_scroll = disp_scroll_to
    follow disp_pn_s = disp_pcount
    on change dnd_on {
        dnd_wobble: -1 ~30ms
        dnd_wobble: 0 ~400ms after 60ms
    }
    follow mshow = if(media_on, 1, 0)
    follow media_open = if(media_on, 1, 0)
    //  Where the song is: the logic reads it once a second while the player is open (MPRIS does not say it as it moves), and the bar follows on a
    //  spring a second long, so it glides from one reading to the next. Dragging along the bar shows where the pointer is, and letting go seeks there.
    fact mp_len = 0                     // seconds; 0 for a stream with no end
    fact mp_pos = 0                     // seconds
    text mp_el = ""                     // 1:42
    text mp_tot = ""                    // 3:58
    prop mp_pf = 0 ~1000ms
    follow mp_pf = if(mp_len > 0, clamp(mp_pos / mp_len, 0, 1), 0)
    fact mp_drag = false
    fact mp_df = 0
    event mp_seek ->                    // where to, 0 to 1
    follow playf = if(media.playing, 1, 0)
    on trackchange {
        swap: 0 ~16ms
        swap: 1 ~700ms after 30ms
    }
    follow dd = if(dd_open and panel == controls, 1, 0)
    follow vm = if(vm_open and panel == controls, 1, 0)
    follow mvis = if(mixer.count > 0 or vm_open, 1, 0)
    //  launch_toggle and settings_toggle are handled by the logic (logic/panel_monitor.luau): it opens them on the focused monitor.
    on change panel { wpd_open = false; font_dd_open = false; dd_open = false; vm_open = false; panel_sub = none; disp_res_open = false; disp_scroll_to = 0; sm_scroll_to = 0; nt_scroll_to = 0; lk_scroll_to = 0; gl_scroll_to = 0; ck_scroll_to = 0; ad_scroll_to = 0; wm_scroll_to = 0; vpn_scroll_to = 0 }
    on change set_page { font_dd_open = false; disp_res_open = false; disp_scroll_to = 0; sm_scroll_to = 0; nt_scroll_to = 0; lk_scroll_to = 0; gl_scroll_to = 0; ck_scroll_to = 0; ad_scroll_to = 0; wm_scroll_to = 0; vpn_scroll_to = 0; vpn_arm = -1 }
    //  The Hyprland and Pleamar-WM pages read their settings from the system when they are shown, and only then: reading them on every page change
    //  (a dozen commands and a couple of hundred fact writes) stalled the scene for half a second on each click anywhere in Settings.
    on change set_page while set_page == pg_hypr { emit hy_refresh }
    on change set_page while set_page == pg_theme { emit themes_refresh }       // a theme file may have been added or edited since
    on change set_page while set_page == pg_addons { emit addons_refresh }       // an add-on folder may have been added since
    on change set_page while set_page == pg_keys { emit kb_refresh }
    on change panel while panel == settings and set_page == pg_keys { emit kb_refresh }
    on change set_page while set_page == pg_wm { emit wm_refresh }
    on change panel while panel == settings and set_page == pg_hypr { emit hy_refresh }
    on change panel while panel == settings and set_page == pg_wm { emit wm_refresh }
    on change panel { tasks_watch = panel == player }
    on pick_out { dd_open = false }
    follow pulse = bass
    //  Every time the bass hits hard, a wave is born at the player controls (the
    //  bar's shader reads `ring` as how far it has travelled). It
    //  has to fall back below the threshold before the next one can be born.
    on change bass > 0.6 while bass > 0.6 {
        ring_mid: 0 ~0ms
        ring: 0 ~16ms
        ring: 1 ~1100ms after 30ms
    }

    //  One number scales the whole shell. The exclusive zone (`reserve` above) is
    //  the bar: 8 + bar.h (62). Below 100 % the Island reserves nothing (a reserve is a plain number): the room is kept by `fr.*` under pleamar-wm, by `gaps_out` on Hyprland (vitreus.luau). Only along the top: down the left, the room is the windows' gaps
    //  (vitreus_colors.lua), and a reserve there as well would leave an empty strip beside the bar.
    let u = 1.35                    // (the icon models are declared at their size times this: 20 → 27, 22 → 30, 26 → 35)
    //  The Settings, the launcher and the Desk follow the monitor's height: they are drawn to fit a 1350 px high screen, and a lower one shrinks them (a 1080 p one to 80 %),
    //  down to 55 %. The geometry follows `pu` and `du`; every text of those three panels is wrapped in a group that scales it by `rs`
    //  about its own anchor point (and its `width:` is divided by `rs` to make up for it). That was written when a text's size had to be a literal
    //  number; since pleamar 0.4.14 `size:` is an expression, and `size: 14 * rs` could take the place of the group.
    let rs = clamp(screen.height / 1350, 0.55, 1)
    let cu = 1.5525                  // u * 1.15: the control center, the calendar and the player and tray are laid out 15% larger than the rest
    let pr = 14 * cu * (1 - 0.5 * sq)        // a plate's corner in the control center, calendar and player: it sharpens with the theme, like the bar's (`bar.rad`)
    let rc = (26 - 19 * sq) * u              // a drawer's corner
    let bk = 1 - 0.85 * sq                   // how much of a melt (a neck) is left
    let du = 1.5525 * rs             // the Desk's own unit: cu (u * 1.15) at the scale of the screen
    let pu = 1.6875 * rs             // u * 1.25: the Settings and the launcher are laid out 25% larger than the rest, at real size (not zoomed)
    //  The bar has its own unit: `bu` and `bcu` are `u` and `cu` at the bar's size (`bz`, 1 to 0.7 with Settings > Bar > Size), used for what the bar itself is made of: its strip, its
    //  pieces, icons, texts and click areas. The panels and the frame keep `u`, so only the bar gets smaller.
    let bz = bar_zs
    let bu = u * bz
    let bcu = cu * bz
    //  One reminder of the chosen day: a circle to tick it off, its time, its words, a cross.
    component CalRow(e: record, tick: event, gone: event) {
        //  30 px tall at least, and as tall as its title needs: a reminder wraps onto more lines rather
        //  than being cut short with an ellipsis. Whole pixels (a row at 22 units, x 1.35, sits on a
        //  fraction of a pixel, and text drawn between pixels comes out soft), and the text and the
        //  ring are put on whole pixels too. The ring, time and cross stay level with the first line.
        size: 154 * cu, max(30, floor(14 + wrap.height + 0.5))
        let rowh = max(30, floor(14 + wrap.height + 0.5))
        zone box touch { from: 0, 0; size: 154 * cu, rowh; corner: 8 * cu }
        //  Obsidian: a solid plate a step lighter than the shell, in place of the veil.
        body { color: mix(obsidian, ink, (6% + 7% * touch.hover) * 1.6); opacity: obs; show: obs > 0.004; box { from: 0, 0; size: 154 * cu, rowh; corner: 8 * cu } }
        box { from: 0, 0; size: 154 * cu, rowh; corner: 8 * cu; color: ink; opacity: (6% + 7% * touch.hover) * (1 - obs) }
        ellipse { at: 15, 15; radius: 5.5 * cu; stroke: 1.3 * cu; color: mint; opacity: if(e.done, 0, 85%) }
        ellipse { at: 15, 15; radius: 5.5 * cu; color: mint; opacity: if(e.done, 100%, 0) }
        path { at: 15, 15; stroke: 1.4 * cu; color: onmint; opacity: if(e.done, 100%, 0); move -2.5 * cu, 0; line -0.5 * cu, 2.2 * cu; line 3 * cu, -2.4 * cu }
        text e.time { at: floor(22 * cu + 0.5), 15; anchor: left center; size: 11.5; weight: 600; width: 34 * cu; lines: 1; color: mint; opacity: if(e.done, 40%, 100%); family: "Space Grotesk" }
        column wrap {
            at: floor(56 * cu + 0.5), 7
            text e.title { size: 13; width: 74 * cu; lines: 5; color: ink; opacity: if(e.done, 40%, 100%); family: "Space Grotesk" }
        }
        line { from: 137 * cu, 15 - 3 * cu; to: 143 * cu, 15 + 3 * cu; width: 1.4 * cu; color: ink; opacity: 22% + 60% * touch.hover }
        line { from: 143 * cu, 15 - 3 * cu; to: 137 * cu, 15 + 3 * cu; width: 1.4 * cu; color: ink; opacity: 22% + 60% * touch.hover }
        zone box check_z { at: 15, 15; size: 22 * cu, 30; corner: 11 * cu; cursor: pointer }
        zone box gone_z { at: 140 * cu, 15; size: 20 * cu, 30; corner: 10 * cu; cursor: pointer }
        on press check_z { emit tick(e.index) }
        on press gone_z { emit gone(e.index) }
    }

    //  One row of the Ask tab's conversation (logic/ask.luau cuts it): a message, or the prose or the code of an answer. The first row of a message has its
    //  name above it (and, on an answer, Copy); a piece of code is in a card of its own with its own Copy. As tall as its text needs.
    component AskRow(m: record, copy: event) {
        size: 300 * du, (if(m.first, 20, 0)) + if(m.kind == 2, 26 * du + floor(cwrap.height + 0.5) + 12 * du, floor(wrap.height + 0.5) + 6)
        let hh   = if(m.first, 20, 0)
        let ph   = floor(if(m.kind == 2, cwrap.height, wrap.height) + 0.5)
        group { scale: rs; pivot: 2, 10; text m.who { at: 2, 10; anchor: left center; size: 11; weight: 700; color: if(m.kind == 0, faint, mint); opacity: 90%; family: "Space Grotesk"; show: m.first } }
        group { scale: rs; pivot: 300 * du - 2, 10; text "Copy" { at: 300 * du - 2, 10; anchor: right center; align: right; size: 11; weight: 600; color: mix(faint, mint, hc.hover); family: "Space Grotesk"; show: m.first and m.kind == 1 } }
        zone box hc { at: 300 * du - 22 * du, 10; size: 44 * du, 20; cursor: pointer; active: m.first and m.kind == 1 }
        on press hc { emit copy(m.index) }
        column wrap {
            at: 2, hh + 2
            text m.body { size: 13; width: 292 * du; lines: 400; line_height: 1.25; color: if(m.kind == 3, faint, ink); family: "Space Grotesk"; show: m.kind != 2 }
        }
        group {
            show: m.kind == 2
            //  Obsidian: a solid plate a step lighter than the shell, in place of the veil.
            body { color: mix(obsidian, ink, (11%) * 1.6); opacity: obs; show: obs > 0.004; box { from: 0, hh + 2; size: 300 * du, 24 * du + ph + 12 * du - 2; corner: 10 * du } }
            box { from: 0, hh + 2; size: 300 * du, 24 * du + ph + 12 * du - 2; corner: 10 * du; color: ink; opacity: (11%) * (1 - obs) }
            group { scale: rs; pivot: 10 * du, hh + 2 + 12 * du; text m.lang { at: 10 * du, hh + 2 + 12 * du; anchor: left center; size: 10; weight: 600; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: 300 * du - 10 * du, hh + 2 + 12 * du; text "Copy" { at: 300 * du - 10 * du, hh + 2 + 12 * du; anchor: right center; align: right; size: 11; weight: 600; color: mix(faint, mint, cc.hover); family: "Space Grotesk" } }
            zone box cc { at: 300 * du - 26 * du, hh + 2 + 12 * du; size: 52 * du, 22 * du; cursor: pointer }
            on press cc { emit copy(m.index) }
        }
        column cwrap {
            at: 10 * du, hh + 2 + 24 * du
            text m.body { size: 11.5; width: 280 * du; lines: 400; line_height: 1.2; color: ink; family: "SpaceMono Nerd Font"; show: m.kind == 2 }
        }
    }

    //  One row of the Desk's Clip tab: a dot (filled when pinned), the text, Ask, and a cross. Pressing the row copies it again.
    component ClipRow(c: record, copy: event, pin: event, ask: event, del: event) {
        //  A picture's row is taller: its thumbnail, then what it is (format and size in pixels) over its weight.
        size: 300 * du, (if(c.image, 52, 34) * du)
        zone box touch { from: 0, 0; size: 300 * du, (if(c.image, 52, 34) * du); corner: 11 * du; cursor: pointer }
        //  Obsidian: a solid plate a step lighter than the shell, in place of the veil.
        body { color: mix(obsidian, ink, (7% + 7% * touch.hover) * 1.6); opacity: obs; show: obs > 0.004; box { from: 0, 0; size: 300 * du, (if(c.image, 52, 34) * du); corner: 11 * du } }
        box { from: 0, 0; size: 300 * du, (if(c.image, 52, 34) * du); corner: 11 * du; color: ink; opacity: (7% + 7% * touch.hover) * (1 - obs) }
        ellipse { at: 15 * du, (if(c.image, 26, 17) * du); radius: 4.5 * du; stroke: 1.4 * du; color: mint; opacity: 70% + 30% * pin_z.hover }
        ellipse { at: 15 * du, (if(c.image, 26, 17) * du); radius: 4.5 * du; color: mint; opacity: if(c.pinned, 100%, 0) }
        box { at: 61 * du, (if(c.image, 26, 17) * du); size: 62 * du, 42 * du; corner: 8 * du; color: deep; opacity: 40%; show: c.image }
        group { clip inset 0 box { at: 61 * du, (if(c.image, 26, 17) * du); size: 62 * du, 42 * du; corner: 8 * du }; image c.thumb { at: 30 * du, (if(c.image, 26, 17) * du) - 21 * du; size: 62 * du, 42 * du; show: c.hasthumb } }
        group { scale: rs; pivot: 61 * du, (if(c.image, 26, 17) * du); text "IMG" { at: 61 * du, (if(c.image, 26, 17) * du); anchor: center; align: center; size: 8.5; weight: 700; color: mint; family: "Space Grotesk"; show: c.image and not c.hasthumb } }
        group { scale: rs; pivot: floor((if(c.image, 100, 30) * du) + 0.5), floor((if(c.image, 26, 17) * du) - if(c.image, 8 * du, 0) + 0.5); text c.label { at: floor((if(c.image, 100, 30) * du) + 0.5), floor((if(c.image, 26, 17) * du) - if(c.image, 8 * du, 0) + 0.5); anchor: left center; size: 12; width: (if(c.image, 168, 190) * du) / rs; lines: 1; color: ink; opacity: 92%; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor((if(c.image, 100, 30) * du) + 0.5), floor((if(c.image, 26, 17) * du) + 9 * du + 0.5); text c.sub { at: floor((if(c.image, 100, 30) * du) + 0.5), floor((if(c.image, 26, 17) * du) + 9 * du + 0.5); anchor: left center; size: 10.5; width: (if(c.image, 168, 190) * du) / rs; lines: 1; color: faint; family: "Space Grotesk"; show: c.image } }
        group { scale: rs; pivot: 238 * du, (if(c.image, 26, 17) * du); text "Ask" { at: 238 * du, (if(c.image, 26, 17) * du); anchor: center; align: center; size: 10.5; weight: 700; color: mix(faint, mint, ask_z.hover); family: "Space Grotesk"; show: not c.image } }
        line { from: 276 * du, (if(c.image, 26, 17) * du) - 3 * du; to: 282 * du, (if(c.image, 26, 17) * du) + 3 * du; width: 1.4 * du; color: ink; opacity: 28% + 62% * del_z.hover }
        line { from: 282 * du, (if(c.image, 26, 17) * du) - 3 * du; to: 276 * du, (if(c.image, 26, 17) * du) + 3 * du; width: 1.4 * du; color: ink; opacity: 28% + 62% * del_z.hover }
        on press touch { emit copy(c.index) }
        zone box pin_z { at: 15 * du, (if(c.image, 26, 17) * du); size: 24 * du, 30 * du; cursor: pointer }
        zone box ask_z { at: 238 * du, (if(c.image, 26, 17) * du); size: 30 * du, 30 * du; cursor: pointer; active: not c.image }
        zone box del_z { at: 279 * du, (if(c.image, 26, 17) * du); size: 24 * du, 30 * du; cursor: pointer }
        on press pin_z { emit pin(c.index) }
        on press ask_z { emit ask(c.index) }
        on press del_z { emit del(c.index) }
    }

    //  One row of the output dropdown: a dot if it is the current one, its name.
    //  A button of the Capture window: a glass plate that lifts and warms to the accent under the pointer and sinks a little when pressed,
    //  an icon in a round badge that lights up, the name and, under it, what happens to the result. `kind` 0 is a region, 1 the whole screen;
    //  `rec` 1 puts the recording dot on the icon. Pressing it says `go(arg)`.
    component CapBtn(label: text, note: text, kind: number, rec: number, go: event, arg: number) {
        size: 134 * cu, floor(52 * cu + 0.5)
        group {
            scale: 1 - 0.035 * touch.pressed
            pivot: 67 * cu, 26 * cu
            body {
                color: mix(ink, mint, touch.hover)
                opacity: 8% + 14% * touch.hover
                rim: 14% + 26% * touch.hover
                shadow: 0, 2 * cu * touch.hover, 9 * cu * touch.hover, 30% * touch.hover, #000000
                box { from: 0, 0; size: 134 * cu, 52 * cu; corner: pr }
            }
            ellipse { at: 28 * cu, 26 * cu; radius: (15 * cu) * 1.3; color: mint; opacity: (40% * touch.hover) * 0.28 }
            ellipse { at: 28 * cu, 26 * cu; radius: (15 * cu) * 0.95; color: mint; opacity: (40% * touch.hover) * 0.34 }
            ellipse { at: 28 * cu, 26 * cu; radius: (15 * cu) * 0.62; color: mint; opacity: (40% * touch.hover) * 0.4 }
            ellipse { at: 28 * cu, 26 * cu; radius: 17 * cu; color: mix(ink, mint, touch.hover); opacity: 10% + 18% * touch.hover }
            ellipse { at: 28 * cu, 26 * cu; radius: 17 * cu; stroke: 1 * cu; color: mint; opacity: 45% * touch.hover }
            group { show: kind == 0; PRegion(28 * cu, 26 * cu, touch.hover, 1) }
            group { show: kind == 1; PScreen(28 * cu, 26 * cu, touch.hover, 1) }
            group { show: rec == 1; PRecDot(40 * cu, 13.5 * cu, touch.hover, 1) }
            text label { at: floor(54 * cu + 0.5), floor(21 * cu + 0.5); anchor: left center; size: 14; weight: 600; width: 76 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            text note { at: floor(54 * cu + 0.5), floor(36 * cu + 0.5); anchor: left center; size: 10.5; width: 76 * cu; lines: 1; color: mix(faint, mint, touch.hover); family: "Space Grotesk" }
        }
        zone box touch { from: 0, 0; size: 134 * cu, 52 * cu; corner: pr; cursor: pointer }
        on press touch { emit go(arg) }
    }

    //  The Power window's icons in pencil, like the rest (see PWifi and the others above): the session tiles', the power profiles' and the battery cell. `hot` (hover, or the
    //  tile being held) makes them swell and redraw; the profile ones colour by `sel` (the chosen one), the cell by `low`.
    //  The Lock icon, in the control center's pencil manner: the body and shackle twice, an accent wash, a keyhole and two shading strokes.
    component PSLock(cx: number, cy: number, hot: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let kk = 1.1 * cu
        let ic = mix(ink, mint, a)
        group {
            pivot: cx, cy
            scale: 1 + 0.18 * a
            path { at: cx, cy; color: mint; opacity: 28%; move -5 * kk, -1 * kk; line 5 * kk, -1 * kk; curve 7 * kk, 1 * kk via 7 * kk, -1 * kk; line 7 * kk, 7 * kk; curve 5 * kk, 9 * kk via 7 * kk, 9 * kk; line -5 * kk, 9 * kk; curve -7 * kk, 7 * kk via -7 * kk, 9 * kk; line -7 * kk, 1 * kk; curve -5 * kk, -1 * kk via -7 * kk, -1 * kk; close }
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kk
                let bj = (0.28 + 0.4 * a) * cu * sin(fr * 53 + bp * 137 + 101)
                let bk = (0.28 + 0.4 * a) * cu * sin(fr * 61 + bp * 71 + 141)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kk; color: ic; opacity: if(bp == 0, 90%, 34%)
                       move -4.2 * kk + bj, -1 * kk + bk
                       line -4.2 * kk + bk, -4.5 * kk + bj
                       curve 4.2 * kk + bj, -4.5 * kk + bk via 0 * kk, -12.5 * kk
                       line 4.2 * kk + bk, -1 * kk + bj }
            }
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kk
                let bj = (0.28 + 0.4 * a) * cu * sin(fr * 53 + bp * 137 + 131)
                let bk = (0.28 + 0.4 * a) * cu * sin(fr * 61 + bp * 71 + 171)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kk; color: ic; opacity: if(bp == 0, 90%, 34%)
                       move -5 * kk + bj, -1 * kk + bk
                       line 5 * kk + bk, -1 * kk + bj
                       curve 7 * kk + bj, 1 * kk + bk via 7 * kk, -1 * kk
                       line 7 * kk + bk, 7 * kk + bj
                       curve 5 * kk + bj, 9 * kk + bk via 7 * kk, 9 * kk
                       line -5 * kk + bk, 9 * kk + bj
                       curve -7 * kk + bj, 7 * kk + bk via -7 * kk, 9 * kk
                       line -7 * kk + bk, 1 * kk + bj
                       curve -5 * kk + bj, -1 * kk + bk via -7 * kk, -1 * kk
                       close }
            }
            ellipse { at: cx + 0 * kk, cy + 3.6 * kk; radius: 1.5 * kk; color: mint; opacity: 100% }
            line { from: cx, cy + 4 * kk; to: cx, cy + 6.5 * kk; width: 1.3 * kk; color: mint; opacity: 100% }
            line { from: cx + -5 * kk, cy + 1.5 * kk + 0.3 * cu * sin(fr * 47 + 60); to: cx + -4.8 * kk, cy + 6.5 * kk + 0.3 * cu * sin(fr * 53 + 70); width: 1.1 * kk; color: mint; opacity: 65% }
            line { from: cx + -3.3 * kk, cy + 2 * kk + 0.3 * cu * sin(fr * 53 + 70); to: cx + -3.1 * kk, cy + 5.5 * kk + 0.3 * cu * sin(fr * 59 + 80); width: 1.1 * kk; color: mint; opacity: 65% }
        }
    }

    //  The Sleep icon, in the control center's pencil manner: a crescent twice, an accent wash, two stars and two shading strokes.
    component PSSleep(cx: number, cy: number, hot: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let kk = 1.1 * cu
        let ic = mix(ink, mint, a)
        group {
            pivot: cx, cy
            scale: 1 + 0.18 * a
            path { at: cx, cy; color: mint; opacity: 28%; move 1 * kk, -9 * kk; curve 9 * kk, 5 * kk via -19 * kk, 2 * kk; curve 1 * kk, -9 * kk via -5 * kk, -1 * kk; close }
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kk
                let bj = (0.28 + 0.4 * a) * cu * sin(fr * 53 + bp * 137 + 171)
                let bk = (0.28 + 0.4 * a) * cu * sin(fr * 61 + bp * 71 + 211)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kk; color: ic; opacity: if(bp == 0, 90%, 34%)
                       move 1 * kk + bj, -9 * kk + bk
                       curve 9 * kk + bk, 5 * kk + bj via -19 * kk, 2 * kk
                       curve 1 * kk + bj, -9 * kk + bk via -5 * kk, -1 * kk
                       close }
            }
            ellipse { at: cx + 4.6 * kk, cy + -4.2 * kk; radius: 1.2 * kk; color: mint; opacity: 100% }
            ellipse { at: cx + 8 * kk, cy + -1.5 * kk; radius: 0.8 * kk; color: mint; opacity: 100% }
            line { from: cx + -4.8 * kk, cy + -3 * kk + 0.3 * cu * sin(fr * 47 + 60); to: cx + -4.5 * kk, cy + 2.2 * kk + 0.3 * cu * sin(fr * 53 + 70); width: 1.1 * kk; color: mint; opacity: 65% }
            line { from: cx + -3 * kk, cy + -3.4 * kk + 0.3 * cu * sin(fr * 53 + 70); to: cx + -2.8 * kk, cy + 0.8 * kk + 0.3 * cu * sin(fr * 59 + 80); width: 1.1 * kk; color: mint; opacity: 65% }
        }
    }

    //  The Log out icon, in the control center's pencil manner: the door and the arrow twice, an accent wash in the doorway, an accent arrowhead and two shading strokes.
    component PSOut(cx: number, cy: number, hot: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let kk = 1.1 * cu
        let ic = mix(ink, mint, a)
        group {
            pivot: cx, cy
            scale: 1 + 0.18 * a
            path { at: cx, cy; color: mint; opacity: 28%; move 1 * kk, -8 * kk; line -4 * kk, -8 * kk; curve -6 * kk, -6 * kk via -6 * kk, -8 * kk; line -6 * kk, 6 * kk; curve -4 * kk, 8 * kk via -6 * kk, 8 * kk; line 1 * kk, 8 * kk; close }
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kk
                let bj = (0.28 + 0.4 * a) * cu * sin(fr * 53 + bp * 137 + 211)
                let bk = (0.28 + 0.4 * a) * cu * sin(fr * 61 + bp * 71 + 251)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kk; color: ic; opacity: if(bp == 0, 90%, 34%)
                       move 1 * kk + bj, -8 * kk + bk
                       line -4 * kk + bk, -8 * kk + bj
                       curve -6 * kk + bj, -6 * kk + bk via -6 * kk, -8 * kk
                       line -6 * kk + bk, 6 * kk + bj
                       curve -4 * kk + bj, 8 * kk + bk via -6 * kk, 8 * kk
                       line 1 * kk + bk, 8 * kk + bj }
            }
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kk
                let bj = (0.28 + 0.4 * a) * cu * sin(fr * 53 + bp * 137 + 241)
                let bk = (0.28 + 0.4 * a) * cu * sin(fr * 61 + bp * 71 + 281)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kk; color: ic; opacity: if(bp == 0, 90%, 34%)
                       move -2 * kk + bj, 0 + bk
                       line 7.5 * kk + bk, 0 + bj }
            }
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kk
                let bj = (0.28 + 0.4 * a) * cu * sin(fr * 53 + bp * 137 + 271)
                let bk = (0.28 + 0.4 * a) * cu * sin(fr * 61 + bp * 71 + 311)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kk; color: ic; opacity: if(bp == 0, 90%, 34%)
                       move 4 * kk + bj, -3.5 * kk + bk
                       line 8 * kk + bk, 0 + bj
                       line 4 * kk + bj, 3.5 * kk + bk }
            }
            path { at: cx, cy; color: mint; opacity: 70%; move 4 * kk, -3.5 * kk; line 8 * kk, 0 * kk; line 4 * kk, 3.5 * kk; close }
            line { from: cx + -4.2 * kk, cy + -4 * kk + 0.3 * cu * sin(fr * 47 + 60); to: cx + -4 * kk, cy + 1 * kk + 0.3 * cu * sin(fr * 53 + 70); width: 1.1 * kk; color: mint; opacity: 65% }
            line { from: cx + -2.6 * kk, cy + -4.4 * kk + 0.3 * cu * sin(fr * 53 + 70); to: cx + -2.4 * kk, cy + -0.4 * kk + 0.3 * cu * sin(fr * 59 + 80); width: 1.1 * kk; color: mint; opacity: 65% }
        }
    }

    //  The Restart icon, in the control center's pencil manner: the ring and its arrowhead twice, an accent wash inside and two shading strokes.
    component PSRestart(cx: number, cy: number, hot: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let kk = 1.1 * cu
        let ic = mix(ink, mint, a)
        group {
            pivot: cx, cy
            scale: 1 + 0.18 * a
            ellipse { at: cx, cy + 0.5 * kk; radius: 7.5 * kk; color: mint; opacity: 22% }
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kk
                let bj = (0.28 + 0.4 * a) * cu * sin(fr * 53 + bp * 137 + 311)
                let bk = (0.28 + 0.4 * a) * cu * sin(fr * 61 + bp * 71 + 351)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kk; color: ic; opacity: if(bp == 0, 90%, 34%)
                       move 5.303 * kk + bj, -4.803 * kk + bk
                       line 6.836 * kk + bk, -2.585 * kk + bj
                       line 7.485 * kk + bj, 0.033 * kk + bk
                       line 7.167 * kk + bk, 2.711 * kk + bj
                       line 5.922 * kk + bj, 5.103 * kk + bk
                       line 3.911 * kk + bk, 6.9 * kk + bj
                       line 1.394 * kk + bj, 7.869 * kk + bk
                       line -1.302 * kk + bk, 7.886 * kk + bj
                       line -3.831 * kk + bj, 6.948 * kk + bk
                       line -5.864 * kk + bk, 5.176 * kk + bj
                       line -7.139 * kk + bj, 2.8 * kk + bk
                       line -7.491 * kk + bk, 0.126 * kk + bj
                       line -6.874 * kk + bj, -2.499 * kk + bk
                       line -5.369 * kk + bk, -4.737 * kk + bj
                       line -3.17 * kk + bj, -6.297 * kk + bk }
            }
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kk
                let bj = (0.28 + 0.4 * a) * cu * sin(fr * 53 + bp * 137 + 341)
                let bk = (0.28 + 0.4 * a) * cu * sin(fr * 61 + bp * 71 + 381)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kk; color: ic; opacity: if(bp == 0, 90%, 34%)
                       move -4.362 * kk + bj, -3.433 * kk + bk
                       line -2.067 * kk + bk, -6.709 * kk + bj
                       line -6.052 * kk + bj, -7.058 * kk + bk }
            }
            ellipse { at: cx + 0 * kk, cy + 0.5 * kk; radius: 1.2 * kk; color: mint; opacity: 100% }
            path { at: cx, cy; color: mint; opacity: 70%; move -4.36159 * kk, -3.43285 * kk; line -2.06728 * kk, -6.70946 * kk; line -6.05206 * kk, -7.05809 * kk; close }
            line { from: cx + -4.6 * kk, cy + -0.5 * kk + 0.3 * cu * sin(fr * 47 + 60); to: cx + -4.4 * kk, cy + 4 * kk + 0.3 * cu * sin(fr * 53 + 70); width: 1.1 * kk; color: mint; opacity: 65% }
            line { from: cx + -3 * kk, cy + -0.9 * kk + 0.3 * cu * sin(fr * 53 + 70); to: cx + -2.8 * kk, cy + 3.1 * kk + 0.3 * cu * sin(fr * 59 + 80); width: 1.1 * kk; color: mint; opacity: 65% }
        }
    }

    //  The Power off icon, in the control center's pencil manner (as the Power tile's): the ring and its bar twice, an accent wash, a dot and two shading strokes.
    component PSOff(cx: number, cy: number, hot: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let kk = 1.1 * cu
        let ic = mix(ink, mint, a)
        group {
            pivot: cx, cy
            scale: 1 + 0.18 * a
            ellipse { at: cx, cy + 0.8 * kk; radius: 8.4 * kk; color: mint; opacity: 22% }
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kk
                let bj = (0.28 + 0.4 * a) * cu * sin(fr * 53 + bp * 137 + 371)
                let bk = (0.28 + 0.4 * a) * cu * sin(fr * 61 + bp * 71 + 411)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.8, 1.3) * kk; color: ic; opacity: if(bp == 0, 90%, 34%)
                       move 4.818 * kk + bj, -6.081 * kk + bk
                       line 6.72 * kk + bk, -4.241 * kk + bj
                       line 7.954 * kk + bj, -1.9 * kk + bk
                       line 8.4 * kk + bk, 0.708 * kk + bj
                       line 8.011 * kk + bj, 3.326 * kk + bk
                       line 6.828 * kk + bk, 5.693 * kk + bj
                       line 4.967 * kk + bj, 7.574 * kk + bk
                       line 2.613 * kk + bk, 8.783 * kk + bj
                       line 0 + bj, 9.2 * kk + bk
                       line -2.613 * kk + bk, 8.783 * kk + bj
                       line -4.967 * kk + bj, 7.574 * kk + bk
                       line -6.828 * kk + bk, 5.693 * kk + bj
                       line -8.011 * kk + bj, 3.326 * kk + bk
                       line -8.4 * kk + bk, 0.708 * kk + bj
                       line -7.954 * kk + bj, -1.9 * kk + bk
                       line -6.72 * kk + bk, -4.241 * kk + bj
                       line -4.818 * kk + bj, -6.081 * kk + bk }
            }
            repeat bp in 0..2 {
                let bo = bp * 0.7 * kk
                let bj = (0.28 + 0.4 * a) * cu * sin(fr * 53 + bp * 137 + 401)
                let bk = (0.28 + 0.4 * a) * cu * sin(fr * 61 + bp * 71 + 441)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 2.0, 1.4) * kk; color: ic; opacity: if(bp == 0, 90%, 34%)
                       move 0 + bj, -10.5 * kk + bk
                       line 0 + bk, -1.5 * kk + bj }
            }
            ellipse { at: cx + 0 * kk, cy + 5.5 * kk; radius: 1.1 * kk; color: mint; opacity: 100% }
            line { from: cx + -5 * kk, cy + 1 * kk + 0.3 * cu * sin(fr * 47 + 60); to: cx + -4.5 * kk, cy + 5 * kk + 0.3 * cu * sin(fr * 53 + 70); width: 1.1 * kk; color: mint; opacity: 65% }
            line { from: cx + -3.5 * kk, cy + 1.5 * kk + 0.3 * cu * sin(fr * 53 + 70); to: cx + -3 * kk, cy + 4.6 * kk + 0.3 * cu * sin(fr * 59 + 80); width: 1.1 * kk; color: mint; opacity: 65% }
        }
    }

    component PPLeaf(cx: number, cy: number, hot: number, sel: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        group {
            pivot: cx, cy
            scale: 1 + 0.18 * a
            path { at: cx, cy; stroke: 1.5 * cu; color: mix(ink, mint, sel); opacity: (o); move -6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 67 + 8480), 6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 72 + 8540); curve 6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 43 + 8577), -6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 48 + 8637) via -8 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 52 + 13427), -6 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 57 + 13487); curve -6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 50 + 8674), 6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 55 + 8734) via 8 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 59 + 13524), 6 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 64 + 13584); }
            path { at: cx + 0.5 * cu, cy + 0.4 * cu; stroke: 1.05 * cu; color: mix(ink, mint, sel); opacity: (o) * 0.34; move -6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 51 + 8851), 6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 56 + 8911); curve 6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 58 + 8948), -6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 63 + 9008) via -8 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 67 + 13798), -6 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 72 + 13858); curve -6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 65 + 9045), 6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 70 + 9105) via 8 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 43 + 13895), 6 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 48 + 13955); }
            path { at: cx, cy; stroke: 1.2 * cu; color: mix(ink, mint, sel); opacity: (o); move -6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 47 + 8533), 6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 52 + 8593); line 1 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 54 + 8630), -1 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 59 + 8690); }
            path { at: cx + 0.5 * cu, cy + 0.4 * cu; stroke: 0.84 * cu; color: mix(ink, mint, sel); opacity: (o) * 0.34; move -6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 62 + 8904), 6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 67 + 8964); line 1 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 69 + 9001), -1 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 43 + 9061); }
        }
    }

    component PPBalance(cx: number, cy: number, hot: number, sel: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        group {
            pivot: cx, cy
            scale: 1 + 0.18 * a
            path { at: cx, cy; stroke: 1.8 * cu; color: mix(ink, mint, sel); opacity: (o); move -6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 53 + 9010), -3 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 58 + 9070); line 6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 60 + 9107), -3 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 65 + 9167); }
            path { at: cx + 0.5 * cu, cy + 0.4 * cu; stroke: 1.26 * cu; color: mix(ink, mint, sel); opacity: (o) * 0.34; move -6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 68 + 9381), -3 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 73 + 9441); line 6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 44 + 9478), -3 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 49 + 9538); }
            path { at: cx, cy; stroke: 1.8 * cu; color: mix(ink, mint, sel); opacity: (o); move -6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 64 + 9063), 3 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 69 + 9123); line 6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 71 + 9160), 3 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 45 + 9220); }
            path { at: cx + 0.5 * cu, cy + 0.4 * cu; stroke: 1.26 * cu; color: mix(ink, mint, sel); opacity: (o) * 0.34; move -6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 48 + 9434), 3 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 53 + 9494); line 6.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 55 + 9531), 3 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 60 + 9591); }
        }
    }

    component PPBolt(cx: number, cy: number, hot: number, sel: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        group {
            pivot: cx, cy
            scale: 1 + 0.18 * a
            path { at: cx, cy; stroke: 1.5 * cu; color: mix(ink, mint, sel); opacity: (o); move 1.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 70 + 9540), -8.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 44 + 9600); line -5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 46 + 9637), 1.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 51 + 9697); line -0.6 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 53 + 9734), 1.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 58 + 9794); line -1.6 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 60 + 9831), 8.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 65 + 9891); line 5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 67 + 9928), -1.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 72 + 9988); line 0.6 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 43 + 10025), -1.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 48 + 10085); line 1.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 50 + 10122), -8.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 55 + 10182); }
            path { at: cx + 0.5 * cu, cy + 0.4 * cu; stroke: 1.05 * cu; color: mix(ink, mint, sel); opacity: (o) * 0.34; move 1.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 54 + 9911), -8.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 59 + 9971); line -5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 61 + 10008), 1.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 66 + 10068); line -0.6 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 68 + 10105), 1.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 73 + 10165); line -1.6 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 44 + 10202), 8.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 49 + 10262); line 5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 51 + 10299), -1.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 56 + 10359); line 0.6 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 58 + 10396), -1.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 63 + 10456); line 1.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 65 + 10493), -8.5 * cu + (0.28 + 0.4 * a) * cu * sin(fr * 70 + 10553); }
        }
    }

    //  The battery, in the control center's pencil manner: the body twice with its rounded corners, a wash and the charge in the battery's colour, hatching on the charge, a terminal and (while charging) the bolt twice.
    component PBatt(cx: number, cy: number, hot: number, lv: number, chg: number, low: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = floor(time * 4)                           // a slow, faint boil; the battery's `hot` is only 'charging', so it cannot wait for the pointer
        let ic = mix(mint, #e0655a, low)
        group {
            pivot: cx, cy
            scale: 1 + 0.18 * a
            path { at: cx, cy; color: ic; opacity: 30%; move -12 * cu, -7.5 * cu; line 12 * cu, -7.5 * cu; curve 15 * cu, -4.5 * cu via 15 * cu, -7.5 * cu; line 15 * cu, 4.5 * cu; curve 12 * cu, 7.5 * cu via 15 * cu, 7.5 * cu; line -12 * cu, 7.5 * cu; curve -15 * cu, 4.5 * cu via -15 * cu, 7.5 * cu; line -15 * cu, -4.5 * cu; curve -12 * cu, -7.5 * cu via -15 * cu, -7.5 * cu; close }
            path { at: cx, cy; color: ic; opacity: (if(chg > 0.5, 0.35, 1)); move -12.5 * cu + 0.25 * cu * sin(fr * 43), -4.8 * cu + 0.25 * cu * sin(fr * 47); line (-12.5 + max(4, lv * 25)) * cu + 0.25 * cu * sin(fr * 53), -4.8 * cu + 0.25 * cu * sin(fr * 59); line (-12.5 + max(4, lv * 25)) * cu + 0.25 * cu * sin(fr * 61), 4.8 * cu + 0.25 * cu * sin(fr * 67); line -12.5 * cu + 0.25 * cu * sin(fr * 71), 4.8 * cu + 0.25 * cu * sin(fr * 73); close }
            line { from: cx + (-11 + 0) * cu, cy + -3 * cu + 0.3 * cu * sin(fr * 47 + 60); to: cx + (-10.5 + 0) * cu, cy + 3 * cu + 0.3 * cu * sin(fr * 53 + 70); width: 0.9 * cu; color: ink; opacity: 28% * clamp((lv * 25 - 0) / 4, 0, 1) }
            line { from: cx + (-11 + 3) * cu, cy + -3 * cu + 0.3 * cu * sin(fr * 53 + 70); to: cx + (-10.5 + 3) * cu, cy + 3 * cu + 0.3 * cu * sin(fr * 59 + 80); width: 0.9 * cu; color: ink; opacity: 28% * clamp((lv * 25 - 3) / 4, 0, 1) }
            line { from: cx + (-11 + 6) * cu, cy + -3 * cu + 0.3 * cu * sin(fr * 59 + 80); to: cx + (-10.5 + 6) * cu, cy + 3 * cu + 0.3 * cu * sin(fr * 65 + 90); width: 0.9 * cu; color: ink; opacity: 28% * clamp((lv * 25 - 6) / 4, 0, 1) }
            repeat bp in 0..3 {
                let bo = bp * 0.5 * cu
                let bj = (0.3 + 0.2 * a) * cu * sin(fr * 53 + bp * 137 + 431)
                let bk = (0.3 + 0.2 * a) * cu * sin(fr * 61 + bp * 71 + 471)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.9, 1.3) * cu; color: ic; opacity: if(bp == 0, 100%, 45%)
                       move -12 * cu + bj, -7.5 * cu + bk
                       line 12 * cu + bk, -7.5 * cu + bj
                       curve 15 * cu + bj, -4.5 * cu + bk via 15 * cu, -7.5 * cu
                       line 15 * cu + bk, 4.5 * cu + bj
                       curve 12 * cu + bj, 7.5 * cu + bk via 15 * cu, 7.5 * cu
                       line -12 * cu + bk, 7.5 * cu + bj
                       curve -15 * cu + bj, 4.5 * cu + bk via -15 * cu, 7.5 * cu
                       line -15 * cu + bk, -4.5 * cu + bj
                       curve -12 * cu + bj, -7.5 * cu + bk via -15 * cu, -7.5 * cu
                       close }
            }
            repeat bp in 0..3 {
                let bo = bp * 0.5 * cu
                let bj = (0.3 + 0.2 * a) * cu * sin(fr * 53 + bp * 137 + 451)
                let bk = (0.3 + 0.2 * a) * cu * sin(fr * 61 + bp * 71 + 491)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 2.6, 1.8) * cu; color: ic; opacity: if(bp == 0, 100%, 45%)
                       move 17.5 * cu + bj, -3 * cu + bk
                       line 17.5 * cu + bk, 3 * cu + bj }
            }
            repeat bp in 0..3 {
                let bo = bp * 0.5 * cu
                let bj = (0.3 + 0.2 * a) * cu * sin(fr * 53 + bp * 137 + 461)
                let bk = (0.3 + 0.2 * a) * cu * sin(fr * 61 + bp * 71 + 501)
                path { at: cx + bo, cy + bo * 0.5; stroke: if(bp == 0, 1.9, 1.3) * cu; color: ic; opacity: if(bp == 0, 100%, 45%) * chg
                       move 2.9 * cu + bj, -8.8 * cu + bk
                       line -4.8 * cu + bk, 1.6 * cu + bj
                       line 0 + bj, 1.6 * cu + bk
                       line -2.9 * cu + bk, 8.8 * cu + bj
                       line 4.8 * cu + bj, -1.6 * cu + bk
                       line 0 + bk, -1.6 * cu + bj
                       close }
            }
            path { at: cx, cy; color: ic; opacity: chg; move 2.9 * cu, -8.8 * cu; line -4.8 * cu, 1.6 * cu; line 0, 1.6 * cu; line -2.9 * cu, 8.8 * cu; line 4.8 * cu, -1.6 * cu; line 0, -1.6 * cu; close }
        }
    }

    //  One battery in the Power window: a glass card that is its own gauge. A wash of colour fills it from the left as far as the
    //  charge goes, with a bright edge where it stops; a cell glyph, the name and its state at the left, and the number big at the right.
    //  Red under 20 % unless it is charging, and a glint crosses it with the charger (the same sweep as the bar's).
    component BatCard(label: text, level: number, state: text, charging: bool) {
        size: 276 * cu, floor(50 * cu + 0.5)
        let lv = clamp(level, 0, 1)
        let low = if(lv < 0.2 and charging == 0, 1, 0)
        let tone = mix(mint, #e0655a, low)
        box { from: 0, 0; size: 276 * cu, 50 * cu; corner: 15 * cu; color: ink; opacity: 8% }
        group {
            clip inset 0 box { from: 0, 0; size: 276 * cu, 50 * cu; corner: 15 * cu }
            box { from: 0, 0; size: 276 * cu * lv, 50 * cu; color: tone; opacity: 22% }
            //  The fill is edged like its divider: the card's own rounded outline, 2 px of it, cut off where the fill stops, so it follows the corners.
            group {
                show: lv > 0.02
                clip inset 0 box { from: 0, 0; size: 276 * cu * lv, 50 * cu }
                box { from: 1 * cu, 1 * cu; size: 274 * cu, 48 * cu; corner: pr; stroke: 2 * cu; color: tone; opacity: 70% }
            }
            box { from: 276 * cu * lv - 2 * cu, 0; size: 2 * cu, 50 * cu; color: tone; opacity: 70%; show: lv > 0.02 and lv < 0.99 }
            box { from: (276 * charge_sweep - 40) * cu, 0; size: 40 * cu, 50 * cu; color: #ffffff; opacity: 10% * sin(clamp(charge_sweep, 0, 1) * 180); show: charging }
        }
        box { from: 0, 0; size: 276 * cu, 50 * cu; corner: 15 * cu; stroke: 1 * cu; color: ink; opacity: 10% }
        PBatt(31 * cu, 25 * cu, if(charging, 1, 0), lv, if(charging, 1, 0), low)
        text label { at: floor(62 * cu + 0.5), floor(19 * cu + 0.5); anchor: left center; size: 13.5; weight: 600; width: 130 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        text state { at: floor(62 * cu + 0.5), floor(35 * cu + 0.5); anchor: left center; size: 11; color: tone; opacity: 85%; family: "Space Grotesk" }
        text number(lv * 100, 0, "%") { at: floor(262 * cu + 0.5), floor(25 * cu + 0.5); anchor: right center; size: 21; weight: 700; color: ink; family: "Space Grotesk" }
    }

    component OutRow(f: record, pick: event) {
        size: 276 * cu, floor(28 * cu + 0.5)
        zone box touch { from: 0, 0; size: 276 * cu, 28 * cu; corner: 10 * cu; cursor: pointer; active: dd > 0.05 }
        box { from: 0, 0; size: 276 * cu, 28 * cu; corner: 10 * cu; color: ink
              opacity: if(f.current, 12%, 0%) + 9% * touch.hover }
        ellipse { at: 14 * cu, 14 * cu; radius: 3 * cu; color: mint; opacity: if(f.current, 100%, 0%) }
        text f.name { at: floor(28 * cu + 0.5), floor(14 * cu + 0.5); anchor: left center; size: 15.5; width: 236 * cu; lines: 1
                      color: ink; family: "Space Grotesk" }
        on press touch { emit pick(f.index) }
    }

    //  The Scan button of the Wi-Fi and Bluetooth windows, one for both. At rest a pill with a glyph (kind 0 the
    //  Wi-Fi arcs, 1 the Bluetooth rune); a tap pops it. While `scanning` it narrows to a round mint button, the glyph
    //  breathes and rings ripple out of it; when the scan ends a tick flashes before the glyph comes back.
    //  It draws where cx, cy say and its zone is declared where the copy is, so the copy goes after the list.
    component ScanButton(cx: number, cy: number, scanning: bool, kind: number, go: event, name: text) {
        prop run = 0 ~calm
        prop grow = 0 ~pop
        prop ok = 0 ~quick
        follow run = if(scanning, 1, 0)
        on change scanning while not scanning { ok: 1 ~80ms; ok: 0 ~700ms after 900ms }
        let w = (44 - 16 * run + 4 * grow) * cu
        let gl = 1 - ok
        //  Rings, three of them a third of a cycle apart: out from the button, fading as they go.
        repeat i in 0..3 {
            let ph = fract(time * 0.8 + i / 3)
            ellipse { at: cx, cy; radius: (10 + 10 * ph) * cu; stroke: 1.3 * cu; color: mint; opacity: 45% * (1 - ph) * run; show: run > 0.02 }
        }
        box { at: cx, cy; size: w, 24 * cu; corner: 12 * cu; color: mix(ink, mint, run); opacity: 8% + 10% * hit.hover + 14% * run + 10% * ok }
        //  Wi-Fi: a dot and three arcs that light one after the other while it searches.
        group {
            show: kind == 0
            opacity: gl
            ellipse { at: cx, cy + 4.5 * cu; radius: 1.1 * cu; color: mix(ink, mint, run); opacity: 85% }
            repeat i in 0..3 {
                arc { at: cx, cy + 4.5 * cu; radius: (3.6 + 2.8 * i) * cu; span: 90deg; width: 1.5 * cu; color: mix(ink, mint, run); opacity: mix(85%, 25% + 75% * clamp(sin(time * 6 - i * 1.1), 0, 1), run) }
            }
        }
        //  Bluetooth: the rune, pulsing while it searches.
        path {
            show: kind == 1
            at: cx, cy; stroke: 1.5 * cu; color: mix(ink, mint, run)
            opacity: gl * mix(85%, 55% + 45% * sin(time * 6), run)
            move -3.2 * cu, -3.2 * cu; line 3.2 * cu, 3.2 * cu; line 0, 6.4 * cu; line 0, -6.4 * cu; line 3.2 * cu, -3.2 * cu; line -3.2 * cu, 3.2 * cu
        }
        path { at: cx, cy; stroke: 1.8 * cu; color: mint; opacity: ok; move -3.6 * cu, 0; line -1 * cu, 2.8 * cu; line 3.8 * cu, -3 * cu }
        zone box hit { at: cx, cy; size: 54 * cu, 26 * cu; corner: 13 * cu; cursor: pointer; label: name }
        on press hit { grow: 1 ~40ms; grow: 0 ~pop after 90ms; emit go }
    }

    //  One row of the Wi-Fi window: a dot if it's the one in use, its name, and
    //  what tapping it means right now. A secured network no password is known
    //  for yet opens the join field instead of trying to connect outright.
    //  Tapping a row never acts by itself - it only opens what's underneath it,
    //  right there: a password field for a secured network not seen before, or
    //  Connect/Disconnect and Forget for anything else. `wifi_open_row` is the
    //  one index that's open at a time, so opening another closes the last one.
    component WifiRow(n: record, pick: event, forget: event, joingo: event) {
        //  Grows on a spring like the Bluetooth rows: wifi_sel slides between rows, wifi_extra is how open, wifi_pf the room the connected network's details take.
        size: 276 * cu, floor((30 + (44 + wifi_pf) * wifi_extra * clamp(1 - abs(n.index - wifi_sel), 0, 1)) * cu + 0.5)
        let isopen = wifi_open_row == n.index
        let open_t = wifi_extra * clamp(1 - abs(n.index - wifi_sel), 0, 1)
        //  What a tap asked for and NetworkManager has not answered yet: 1 joining, 2 leaving.
        let working = n.busy > 0
        let pulse = if(working, 55% + 45% * sin(time * 260), 100%)
        //  One card: the network line on top, and what opens is the same plate carrying on below it.
        box { from: 0, 0; size: 276 * cu, (30 + (44 + wifi_pf) * open_t) * cu; corner: 10 * cu; color: ink; opacity: if(n.active, 12%, 0%) + 5% * open_t + 9% * touch.hover }
        box { from: 0, 0; size: 276 * cu, (30 + (44 + wifi_pf) * open_t) * cu; corner: 10 * cu; color: mint; opacity: if(working, 4% + 6% * pulse, 0%) }
        zone box touch { from: 0, 0; size: 276 * cu, 30 * cu; corner: 10 * cu; cursor: pointer }
        //  Signal: four bars, as many lit as the strength reaches. The one in use is mint.
        repeat i in 0..4 {
            let bh = (4 + 3.6 * i) * cu
            box { from: (10 + 3.9 * i) * cu, 22 * cu - bh; size: 2.6 * cu, bh; corner: 1 * cu; color: if(n.active, mint, ink); opacity: if(n.strength >= pick(i, 0.06, 0.3, 0.55, 0.78), 100%, 24%) }
        }
        text n.ssid { at: floor(34 * cu + 0.5), floor(15 * cu + 0.5); anchor: left center; size: 14.5; width: 100 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        //  The band, in a small pill; and a padlock for a network that wants a password.
        group {
            show: n.band > 0
            box { from: 140 * cu, 8 * cu; size: n.bandw * cu, 14 * cu; corner: 7 * cu; color: ink; opacity: 10% }
            text n.bands { at: floor((140 + n.bandw / 2) * cu + 0.5), floor(15 * cu + 0.5); anchor: center; size: 10; weight: 700; color: ink; opacity: 70%; family: "Space Grotesk" }
        }
        group {
            show: n.secure
            box { at: (140 + n.bandw + 9) * cu, 17 * cu; size: 8 * cu, 6 * cu; corner: 1.2 * cu; color: ink; opacity: 55% }
            arc { at: (140 + n.bandw + 9) * cu, 14 * cu; radius: 2.4 * cu; span: 180deg; width: 1.3 * cu; color: ink; opacity: 55% }
        }
        text "Connected" { at: floor(266 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: mint; family: "Space Grotesk"; show: n.active and n.busy == 0 }
        text "Saved" { at: floor(266 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; family: "Space Grotesk"; show: n.known and not n.active and n.busy == 0 }
        text "Connecting…" { at: floor(266 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: mint; opacity: pulse; family: "Space Grotesk"; show: n.busy == 1 }
        text "Disconnecting…" { at: floor(266 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; opacity: pulse; family: "Space Grotesk"; show: n.busy == 2 }
        on press touch { wifi_open_row = if(isopen, -1, n.index) }

        group {
            show: open_t > 0.01
            opacity: clamp(open_t, 0, 1)
            move: 0, (clamp(open_t, 0, 1) - 1) * 8 * cu
            box { at: 138 * cu, 30 * cu; size: 240 * cu, 1 * cu; color: ink; opacity: 10% }
            //  A secured network never seen before: the password, right here.
            group {
                show: n.secure and not n.known and not n.active
                box { at: 106 * cu, 52 * cu; size: 184 * cu, 26 * cu; corner: 8 * cu; color: ink; opacity: 8% }
                input wifi_pw { at: floor(24 * cu + 0.5), floor(52 * cu - 6.3 * cu + 0.5); width: 164 * cu; size: 13; color: ink; family: "Space Grotesk"; secret: true; placeholder: "Password" }
                box { at: 234 * cu, 52 * cu; size: 56 * cu, 26 * cu; corner: 8 * cu; color: mint; opacity: if(working, 30% + 20% * pulse, 85% + 15% * joinbtn.hover) }
                text "Join" { at: floor(234 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk" }
                zone box joinbtn { at: 234 * cu, 52 * cu; size: 56 * cu, 26 * cu; corner: 8 * cu; cursor: pointer; active: not working }
                on press joinbtn { emit joingo(n.index) }
            }
            //  Open, and never joined: nothing to type, just a way in.
            group {
                show: not n.secure and not n.known and not n.active
                box { at: 138 * cu, 52 * cu; size: 248 * cu, 26 * cu; corner: 8 * cu; color: mint; opacity: if(working, 30% + 20% * pulse, 85% + 15% * connbtn.hover) }
                text "Connect" { at: floor(138 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk"; show: not working }
                text "Connecting…" { at: floor(138 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; family: "Space Grotesk"; show: working }
                zone box connbtn { at: 138 * cu, 52 * cu; size: 248 * cu, 26 * cu; corner: 8 * cu; cursor: pointer; active: not working }
                on press connbtn { emit pick(n.index) }
            }
            //  Known, or the one in use: leave it, join it again, or forget it outright.
            group {
                show: n.known or n.active
                box { at: 76 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; color: if(n.active, ink, mint); opacity: if(working, 12% + 12% * pulse, if(n.active, 12% + 10% * primbtn.hover, 85% + 15% * primbtn.hover)) }
                text "Disconnect" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; family: "Space Grotesk"; show: n.active and not working }
                text "Connect" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk"; show: not n.active and not working }
                text "Connecting…" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; opacity: pulse; family: "Space Grotesk"; show: n.busy == 1 }
                text "Disconnecting…" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; opacity: pulse; family: "Space Grotesk"; show: n.busy == 2 }
                zone box primbtn { at: 76 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; cursor: pointer; active: not working }
                on press primbtn { emit pick(n.index) }
                box { at: 200 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; color: ink; opacity: 6% + 10% * forgetbtn.hover }
                text "Forget" { at: floor(200 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
                zone box forgetbtn { at: 200 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; cursor: pointer }
                on press forgetbtn { emit forget(n.index) }
            }
            //  The connection's details: address, gateway, link speed, channel, security and hardware address.
            group {
                show: n.active and isopen and wifi_pf_h > 0
                box { at: 138 * cu, 74 * cu; size: 240 * cu, 1 * cu; color: ink; opacity: 10% }
                repeat i in 0..6 {
                    let ly = (90 + 16 * i) * cu
                    text pick(i, "ADDRESS", "GATEWAY", "LINK SPEED", "CHANNEL", "SECURITY", "HARDWARE") { at: floor(14 * cu + 0.5), floor(ly + 0.5); anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }
                }
                text wf_ip { at: floor(236 * cu + 0.5), floor(90 * cu + 0.5); anchor: right center; align: right; size: 12; width: 140 * cu; lines: 1; color: ink; family: "Space Grotesk" }
                //  Copy the address: two squares, one over the other.
                box { at: 252 * cu, 90 * cu; size: 20 * cu, 16 * cu; corner: 6 * cu; color: ink; opacity: 8% + 14% * copybtn.hover }
                box { at: 250.5 * cu, 91.5 * cu; size: 6 * cu, 7 * cu; corner: 1.2 * cu; stroke: 1.2 * cu; color: ink; opacity: 70% }
                box { at: 253.5 * cu, 88.5 * cu; size: 6 * cu, 7 * cu; corner: 1.2 * cu; stroke: 1.2 * cu; color: ink; opacity: 70% }
                zone box copybtn { at: 252 * cu, 90 * cu; size: 22 * cu, 18 * cu; corner: 6 * cu; cursor: pointer; label: "Copy address" }
                on press copybtn { emit wifi_copy_ip }
                text wf_gw { at: floor(262 * cu + 0.5), floor(106 * cu + 0.5); anchor: right center; align: right; size: 12; width: 160 * cu; lines: 1; color: ink; family: "Space Grotesk" }
                text number(n.rate, 0, " Mbps") { at: floor(262 * cu + 0.5), floor(122 * cu + 0.5); anchor: right center; size: 12; color: ink; family: "Space Grotesk"; show: n.rate > 0 }
                text number(n.chan, 0) { at: floor(262 * cu + 0.5), floor(138 * cu + 0.5); anchor: right center; size: 12; color: ink; family: "Space Grotesk"; show: n.band == 0 }
                text number(n.chan, 0, " · 2.4 GHz") { at: floor(262 * cu + 0.5), floor(138 * cu + 0.5); anchor: right center; size: 12; color: ink; family: "Space Grotesk"; show: n.band == 2 }
                text number(n.chan, 0, " · 5 GHz") { at: floor(262 * cu + 0.5), floor(138 * cu + 0.5); anchor: right center; size: 12; color: ink; family: "Space Grotesk"; show: n.band == 5 }
                text number(n.chan, 0, " · 6 GHz") { at: floor(262 * cu + 0.5), floor(138 * cu + 0.5); anchor: right center; size: 12; color: ink; family: "Space Grotesk"; show: n.band == 6 }
                text n.sec { at: floor(262 * cu + 0.5), floor(154 * cu + 0.5); anchor: right center; align: right; size: 12; width: 160 * cu; lines: 1; color: ink; family: "Space Grotesk" }
                text wf_mac { at: floor(262 * cu + 0.5), floor(170 * cu + 0.5); anchor: right center; align: right; size: 12; width: 160 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            }
        }
    }

    //  One row of the Bluetooth window: a heading (Connected, Paired, Nearby) or a device, with its kind drawn at the left and its battery,
    //  if it says, at the right. Tapping a device opens its buttons underneath; a paired one also shows its name (to rename) and
    //  whether it may reconnect by itself, and a connected one its audio profile.
    component BtRow(d: record, pick: event, forget: event) {
        //  The row grows and its buttons fade in on a spring, instead of jumping. One spring says which
        //  row is open (bt_sel, sliding between rows) and one how open (bt_extra): a row's share is how
        //  close it is to the selection.
        size: 276 * cu, if(d.hd > 0, 20 * cu, floor((30 + (44 + bt_pf) * bt_extra * clamp(1 - abs(d.index - bt_sel), 0, 1)) * cu + 0.5))
        let isopen = bt_open_row == d.index
        let open_t = bt_extra * clamp(1 - abs(d.index - bt_sel), 0, 1)
        //  What a tap asked for and BlueZ has not answered yet: 1 connecting, 2 disconnecting, 3 it could not.
        let working = d.busy == 1 or d.busy == 2
        let pulse = if(working, 55% + 45% * sin(time * 260), 100%)
        text d.name { at: floor(6 * cu + 0.5), floor(13 * cu + 0.5); anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk"; show: d.hd > 0 }
        group {
            show: d.hd == 0
            //  One card: the device line on top, and what opens is the same plate carrying on below it,
            //  with a hairline between, not a separate strip of buttons.
            box { from: 0, 0; size: 276 * cu, (30 + (44 + bt_pf) * open_t) * cu; corner: 10 * cu; color: ink; opacity: if(d.connected, 12%, 0%) + 5% * open_t + 9% * touch.hover }
            box { from: 0, 0; size: 276 * cu, (30 + (44 + bt_pf) * open_t) * cu; corner: 10 * cu; color: mint; opacity: if(working, 4% + 6% * pulse, 0%) }
            zone box touch { from: 0, 0; size: 276 * cu, 30 * cu; corner: 10 * cu; cursor: pointer }
        group {
            show: d.kind == 0
            opacity: if(working, pulse, 88%)
            path { at: 17 * cu, 15 * cu; stroke: 1.3 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)); move -3 * cu, -3.6 * cu; line 3 * cu, 3.2 * cu; line 0 * cu, 6.4 * cu; line 0 * cu, -6.4 * cu; line 3 * cu, -3.2 * cu; line -3 * cu, 3.6 * cu }
        }
        group {
            show: d.kind == 1
            opacity: if(working, pulse, 88%)
            arc { at: 17 * cu, 15 * cu + 1 * cu; radius: 5.6 * cu; span: 180deg; width: 1.4 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            box { at: 17 * cu + (-5.6) * cu, 15 * cu + (2.2) * cu; size: 3 * cu, 5.5 * cu; corner: 1.2 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            box { at: 17 * cu + (5.6) * cu, 15 * cu + (2.2) * cu; size: 3 * cu, 5.5 * cu; corner: 1.2 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
        }
        group {
            show: d.kind == 2
            opacity: if(working, pulse, 88%)
            box { at: 17 * cu + (0) * cu, 15 * cu + (0) * cu; size: 15 * cu, 9.5 * cu; corner: 2 * cu; stroke: 1.2 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            box { at: 17 * cu + (-4) * cu, 15 * cu + (-1.8) * cu; size: 2 * cu, 1.4 * cu; corner: 0.5 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            box { at: 17 * cu + (0) * cu, 15 * cu + (-1.8) * cu; size: 2 * cu, 1.4 * cu; corner: 0.5 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            box { at: 17 * cu + (4) * cu, 15 * cu + (-1.8) * cu; size: 2 * cu, 1.4 * cu; corner: 0.5 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            box { at: 17 * cu + (0) * cu, 15 * cu + (1.9) * cu; size: 7 * cu, 1.4 * cu; corner: 0.5 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
        }
        group {
            show: d.kind == 3
            opacity: if(working, pulse, 88%)
            box { at: 17 * cu + (0) * cu, 15 * cu + (0) * cu; size: 9.5 * cu, 14 * cu; corner: 4.7 * cu; stroke: 1.2 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            line { from: 17 * cu, 15 * cu - 6.6 * cu; to: 17 * cu, 15 * cu - 1.6 * cu; width: 1.2 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
        }
        group {
            show: d.kind == 4
            opacity: if(working, pulse, 88%)
            box { at: 17 * cu + (0) * cu, 15 * cu + (0) * cu; size: 8.5 * cu, 14 * cu; corner: 2 * cu; stroke: 1.2 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            ellipse { at: 17 * cu + (0) * cu, 15 * cu + (4.8) * cu; radius: 0.8 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
        }
        group {
            show: d.kind == 5
            opacity: if(working, pulse, 88%)
            box { at: 17 * cu + (0) * cu, 15 * cu + (0) * cu; size: 16 * cu, 9.5 * cu; corner: 4.7 * cu; stroke: 1.2 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            box { at: 17 * cu + (-4.2) * cu, 15 * cu + (0) * cu; size: 4 * cu, 1.2 * cu; corner: 0.5 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            box { at: 17 * cu + (-4.2) * cu, 15 * cu + (0) * cu; size: 1.2 * cu, 4 * cu; corner: 0.5 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            ellipse { at: 17 * cu + (3) * cu, 15 * cu + (-1.2) * cu; radius: 0.9 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            ellipse { at: 17 * cu + (5) * cu, 15 * cu + (1.2) * cu; radius: 0.9 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
        }
        group {
            show: d.kind == 6
            opacity: if(working, pulse, 88%)
            box { at: 17 * cu + (0) * cu, 15 * cu + (0) * cu; size: 9.5 * cu, 14 * cu; corner: 2 * cu; stroke: 1.2 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            ellipse { at: 17 * cu + (0) * cu, 15 * cu + (3.4) * cu; radius: 2.5 * cu; stroke: 1.2 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            ellipse { at: 17 * cu + (0) * cu, 15 * cu + (-3.8) * cu; radius: 1 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
        }
        group {
            show: d.kind == 7
            opacity: if(working, pulse, 88%)
            box { at: 17 * cu + (0) * cu, 15 * cu + (-1.2) * cu; size: 13 * cu, 8.5 * cu; corner: 1.5 * cu; stroke: 1.2 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
            line { from: 17 * cu - 8 * cu, 15 * cu + 5.4 * cu; to: 17 * cu + 8 * cu, 15 * cu + 5.4 * cu; width: 1.4 * cu; color: if(d.busy == 3, #e0655a, if(d.connected, mint, ink)) }
        }
            text d.name { at: floor(34 * cu + 0.5), floor(15 * cu + 0.5); anchor: left center; size: 14.5; width: 140 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            text "Connected" { at: floor(266 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: mint; family: "Space Grotesk"; show: d.connected and d.battery < 0 and d.busy == 0 }
            //  The battery, as a little cell filled as far as it is charged, with the number beside it.
            group {
                show: d.connected and d.battery >= 0 and d.busy == 0
                box { at: 222 * cu, 15 * cu; size: 17 * cu, 9 * cu; corner: 2.4 * cu; stroke: 1.1 * cu; color: ink; opacity: 60% }
                box { at: 231.4 * cu, 15 * cu; size: 1.6 * cu, 3.4 * cu; corner: 0.8 * cu; color: ink; opacity: 60% }
                box { from: 215 * cu, 12.2 * cu; size: clamp(d.battery, 0.06, 1) * 14 * cu, 5.6 * cu; corner: 1.2 * cu; color: if(d.battery < 0.2, #e0655a, mint) }
                text number(d.battery * 100, 0, "%") { at: floor(266 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: ink; opacity: 80%; family: "Space Grotesk" }
            }
            text "Paired" { at: floor(266 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; family: "Space Grotesk"; show: d.paired and not d.connected and d.busy == 0 }
            text "Not paired" { at: floor(266 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; family: "Space Grotesk"; show: not d.paired and not d.connected and d.busy == 0 }
            text "Connecting…" { at: floor(266 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: mint; opacity: pulse; family: "Space Grotesk"; show: d.busy == 1 }
            text "Disconnecting…" { at: floor(266 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: faint; opacity: pulse; family: "Space Grotesk"; show: d.busy == 2 }
            text "Couldn't connect" { at: floor(266 * cu + 0.5), floor(15 * cu + 0.5); anchor: right center; size: 11.5; color: #e0655a; family: "Space Grotesk"; show: d.busy == 3 }
            on press touch { bt_open_row = if(isopen, -1, d.index) }

            group {
                show: open_t > 0.01
                opacity: clamp(open_t, 0, 1)
                move: 0, (clamp(open_t, 0, 1) - 1) * 8 * cu
                box { at: 138 * cu, 30 * cu; size: 240 * cu, 1 * cu; color: ink; opacity: 10% }
                group {
                    show: not d.paired and not d.connected
                    box { at: 138 * cu, 52 * cu; size: 248 * cu, 26 * cu; corner: 8 * cu; color: mint; opacity: if(working, 30% + 20% * pulse, 85% + 15% * pairbtn.hover) }
                    text "Pair & Connect" { at: floor(138 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk"; show: not working }
                    text "Pairing…" { at: floor(138 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; family: "Space Grotesk"; show: working }
                    zone box pairbtn { at: 138 * cu, 52 * cu; size: 248 * cu, 26 * cu; corner: 8 * cu; cursor: pointer; active: not working }
                    on press pairbtn { emit pick(d.index) }
                }
                group {
                    show: d.paired or d.connected
                    box { at: 76 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; color: if(d.connected, ink, mint); opacity: if(working, 12% + 12% * pulse, if(d.connected, 12% + 10% * primbtn.hover, 85% + 15% * primbtn.hover)) }
                    text "Disconnect" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; family: "Space Grotesk"; show: d.connected and not working }
                    text "Connect" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: onmint; family: "Space Grotesk"; show: not d.connected and not working }
                    text "Connecting…" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; opacity: pulse; family: "Space Grotesk"; show: d.busy == 1 }
                    text "Disconnecting…" { at: floor(76 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 700; color: ink; opacity: pulse; family: "Space Grotesk"; show: d.busy == 2 }
                    zone box primbtn { at: 76 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; cursor: pointer; active: not working }
                    on press primbtn { emit pick(d.index) }
                    box { at: 200 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; color: ink; opacity: 6% + 10% * forgetbtn.hover }
                    text "Forget" { at: floor(200 * cu + 0.5), floor(52 * cu + 0.5); anchor: center; size: 12.5; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
                    zone box forgetbtn { at: 200 * cu, 52 * cu; size: 120 * cu, 26 * cu; corner: 8 * cu; cursor: pointer }
                    on press forgetbtn { emit forget(d.index) }
                }
                //  What can be changed on a paired device: its name, and whether it may reconnect by itself (BlueZ calls that trusted).
                group {
                    show: (d.paired or d.connected) and isopen and bt_set_h > 0
                    box { at: 138 * cu, 74 * cu; size: 240 * cu, 1 * cu; color: ink; opacity: 10% }
                    box { at: 106 * cu, 92 * cu; size: 184 * cu, 26 * cu; corner: 8 * cu; color: ink; opacity: 8% }
                    input bt_rename { at: floor(24 * cu + 0.5), floor(92 * cu - 6.3 * cu + 0.5); width: 164 * cu; size: 13; color: ink; family: "Space Grotesk"; placeholder: "Name" }
                    box { at: 234 * cu, 92 * cu; size: 56 * cu, 26 * cu; corner: 8 * cu; color: ink; opacity: 10% + 10% * renbtn.hover }
                    text "Rename" { at: floor(234 * cu + 0.5), floor(92 * cu + 0.5); anchor: center; size: 11.5; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
                    zone box renbtn { at: 234 * cu, 92 * cu; size: 56 * cu, 26 * cu; corner: 8 * cu; cursor: pointer }
                    on press renbtn { emit bt_rename_go }
                    text "Reconnect automatically" { at: floor(14 * cu + 0.5), floor(130 * cu + 0.5); anchor: left center; size: 12.5; color: ink; opacity: 90%; family: "Space Grotesk" }
                    box { at: 250 * cu, 130 * cu; size: 34 * cu, 18 * cu; corner: 9 * cu; color: mix(ink, mint, bt_trust_t); opacity: 16% + 64% * bt_trust_t }
                    ellipse { at: (241 + 18 * bt_trust_t) * cu, 130 * cu; radius: 6.5 * cu; color: mix(ink, onmint, bt_trust_t) }
                    zone box trustbtn { at: 138 * cu, 130 * cu; size: 248 * cu, 24 * cu; corner: 8 * cu; cursor: pointer; label: "Reconnect automatically" }
                    on press trustbtn { emit bt_trust_toggle }
                }
                //  What the connected device does with sound: a headset drops to the telephone profile (mono, mic on) on a call and nothing puts it back.
                //  Not more buttons: its own heading under a hairline, and a choice of radio dots, two to a line, so it reads as a setting of the device.
                group {
                    show: d.connected and isopen and bt_pf_h > 0
                    box { at: 138 * cu, (74 + bt_set_h) * cu; size: 240 * cu, 1 * cu; color: ink; opacity: 10% }
                    text "AUDIO PROFILE" { at: floor(14 * cu + 0.5), floor((88 + bt_set_h) * cu + 0.5); anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }
                    repeat i in 0..6 {
                        let px = (14 + mod(i, 2) * 128) * cu
                        let py = (108 + bt_set_h + floor(i / 2) * 26) * cu
                        box { from: px, py - 12 * cu; size: 124 * cu, 24 * cu; corner: 8 * cu; color: ink; opacity: if(bt_po.$i, 7% * bt_pz.$i.hover, 0%) }
                        ellipse { at: px + 11 * cu, py; radius: 5 * cu; stroke: 1.3 * cu; color: if(bt_pa.$i, mint, ink); opacity: if(bt_po.$i, if(bt_pa.$i, 100%, 45%), 0%) }
                        ellipse { at: px + 11 * cu, py; radius: 2.6 * cu; color: mint; opacity: if(bt_pa.$i, 100%, 0%) }
                        text bt_pl.$i { at: floor(px + 23 * cu + 0.5), floor(py + 0.5); anchor: left center; size: 12; weight: 600; width: 98 * cu; lines: 1; color: if(bt_pa.$i, mint, ink); opacity: if(bt_pa.$i, 100%, 80%); family: "Space Grotesk"; show: bt_po.$i }
                        zone box bt_pz.$i { from: px, py - 12 * cu; size: 124 * cu, 24 * cu; corner: 8 * cu; cursor: pointer; active: bt_po.$i }
                        on press bt_pz.$i { emit bt_prof_set(i) }
                    }
                }
            }
        }
    }

    //  One running window: its app icon, its title (mint and
    //  bold if it has the keyboard), and a close button that shows while the row is under the pointer.
    //  A press gives it the keyboard; a middle press closes it.
    component TaskRow(t: record, focus: event, kill: event) {
        size: 288 * cu, floor(36 * cu + 0.5)          // whole pixels (with the list's gap), so the icon is not drawn between two
        zone box touch { from: 0, 0; size: 288 * cu, 36 * cu; corner: 12 * cu; cursor: pointer }
        box { from: 0, 0; size: 288 * cu, 36 * cu; corner: 12 * cu; color: ink; opacity: if(t.active, 11%, 5%) + 8% * touch.hover }
        image t.icon { at: floor(8 * cu + 0.5), floor(7 * cu + 0.5); size: floor(22 * cu + 0.5), floor(22 * cu + 0.5) }
        text t.title { at: floor(38 * cu + 0.5), floor(18 * cu + 0.5); anchor: left center; size: 14.5; width: 186 * cu; lines: 1; color: ink; family: "Space Grotesk"; show: not t.active }
        text t.title { at: floor(38 * cu + 0.5), floor(18 * cu + 0.5); anchor: left center; size: 14.5; weight: 700; width: 186 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: t.active }
        //  Which workspace it is on, in a small pill.
        box { at: 240 * cu, 18 * cu; size: 24 * cu, 18 * cu; corner: 9 * cu; color: ink; opacity: 8% }
        text t.ws { at: floor(240 * cu + 0.5), floor(18 * cu + 0.5); anchor: center; align: center; size: 12; weight: 700; width: 24 * cu; lines: 1; color: ink; opacity: 80%; family: "Space Grotesk" }
        ellipse { at: 268 * cu, 18 * cu; radius: 10 * cu; color: if(close_z.hover, alert, ink); opacity: (if(close_z.hover, 90%, 9%)) * touch.hover }
        line { from: 264.5 * cu, 14.5 * cu; to: 271.5 * cu, 21.5 * cu; width: 1.4 * cu; color: ink; opacity: 70% * touch.hover }
        line { from: 271.5 * cu, 14.5 * cu; to: 264.5 * cu, 21.5 * cu; width: 1.4 * cu; color: ink; opacity: 70% * touch.hover }
        zone box close_z { at: 268 * cu, 18 * cu; size: 22 * cu, 22 * cu; corner: 11 * cu; cursor: pointer }
        on press touch { emit focus(t.index); panel = none }
        on press middle touch { emit kill(t.index) }
        on press close_z { emit kill(t.index) }
    }

    //  One app in the mixer: its icon, its name, a small slider and its percentage, and a speaker that silences it.
    component MixRow(m: record, set: event, mute: event) {
        size: 288 * cu, floor(28 * cu + 0.5)          // whole pixels (with the list's gap), so the icon is not drawn between two
        opacity: if(m.corked, 55%, 100%)
        image m.icon { at: floor(10 * cu + 0.5), floor(5 * cu + 0.5); size: floor(20 * cu + 0.5), floor(20 * cu + 0.5) }
        text m.name { at: floor(38 * cu + 0.5), floor(13 * cu + 0.5); anchor: left center; size: 12.5; width: 78 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        //  The level is the same pencil slider as the volume's (PSlider), smaller: a crooked outline, the level shaded in, a pencil circle at the end; it redraws while the pointer is on it.
        PSlider(116 * cu, 14 * cu, 100 * cu, clamp(m.pct / 100, 0, 1), track.hover, cu, 9 * cu, if(m.muted, 1, 0))
        zone box track { at: 166 * cu, 14 * cu; size: 112 * cu, 24 * cu; cursor: pointer }
        on press track { emit set(m.index * 4 + clamp((local.x - 116 * cu) / (100 * cu), 0, 1)) }
        on drag track { emit set(m.index * 4 + clamp((local.x - 116 * cu) / (100 * cu), 0, 1)) }
        text number(m.pct, 0, "%") { at: floor(252 * cu + 0.5), floor(14 * cu + 0.5); anchor: right center; align: right; size: 12; width: 30 * cu; lines: 1; color: faint; family: "Space Grotesk" }
        //  The speaker that silences it: the pencil one of the volume row (PSpk), smaller, its waves following this app's level and a red slash while it is silenced.
        group {
            pivot: 258 * cu, 14 * cu
            scale: 0.62
            PSpk(258 * cu, 14 * cu, mzone.hover, 0.85, if(m.muted, 0, 25% + 75% * clamp(m.pct / 100 * 12, 0, 1)), if(m.muted, 0, 20% + 80% * clamp((m.pct / 100 - 0.35) * 4, 0, 1)), if(m.muted, 1, 0))
        }
        zone box mzone { at: 263 * cu, 14 * cu; size: 20 * cu, 24 * cu; cursor: pointer }
        on press mzone { emit mute(m.index) }
    }

    //  A result of the launcher: an icon (or a letter where there is none), its name, and a line of detail.
    //  Its width is the rows' width (`lw`): narrower where a preview sits beside the rows, and then it has no detail line.
    let lw = mix(430, 238, lpv) * pu
    //  The UwU's knob: a cat paw (a pad and four toes) in the knob's colour, in place of the rounded one, swelling as it does. Every switch's knob (the Control Center's
    //  tiles, the Settings', the Desk's) calls this, so they are all one: `kx`, `cy` the knob's middle, `kw` its width, `ku` the unit the switch is laid out in.
    component CatPawKnob(kx: number, cy: number, kw: number, ku: number) {
        let ps = kw / (17 * ku)
        body {
            color: ink
            shadow: 0, 2 * ku, 5 * ku, 26%
            opacity: uwu_k
            show: uwu_k > 0.01
            ellipse { at: kx, cy + 3.2 * ku * ps; radius: 5.6 * ku * ps; scale: 1.25, 0.95 }
            ellipse { at: kx - 6.4 * ku * ps, cy - 1.6 * ku * ps; radius: 2.5 * ku * ps }
            ellipse { at: kx - 2.8 * ku * ps, cy - 5.8 * ku * ps; radius: 2.5 * ku * ps }
            ellipse { at: kx + 2.8 * ku * ps, cy - 5.8 * ku * ps; radius: 2.5 * ku * ps }
            ellipse { at: kx + 6.4 * ku * ps, cy - 1.6 * ku * ps; radius: 2.5 * ku * ps }
        }
    }
    //  The switch of the Settings, drawn exactly like the Control Center's (the Notifications tile's, say) without the little icon on the knob: a track that is
    //  a dark hollow off and raised and lit from inside on, a solid knob that swells while it moves and under the finger, and the light that travels with it.
    //  `rx` is the track's right edge, `cy` its middle, `k` how on it is (0 to 1, a spring), `press` how pressed (the row's zone `.pressed`), `hot` its hover (`.hover`), `acc` the colour on.
    component SettingsSwitch(rx: number, cy: number, k: number, press: number, hot: number, acc: color) {
        let sm = clamp(4 * k * (1 - k), 0, 1)             // how much it is moving (0 at rest, 1 half way)
        let sw = (34 + 4 * k) * cu
        let scx = rx - sw / 2
        let sl = scx - sw / 2
        let skx = sl + 11 * cu + k * (sw - 22 * cu)
        let skw = (17 + 9 * sm + 7 * press) * cu
        let skh = (17 - 3 * sm - 2 * press) * cu
        body {
            color: mix(off, acc, clamp(k, 0, 1))
            shadow: 0, 0, 10 * cu * k, 48% * k, acc
            rim: 16% * k
            box { at: scx, cy; size: sw, 22 * cu; corner: (11 - 2 * k) * cu }
        }
        group {
            clip inset 0 box { at: scx, cy; size: sw, 22 * cu; corner: (11 - 2 * k) * cu }
            box { from: sl - 6 * cu, cy - 18 * cu; size: sw + 12 * cu, 9 * cu; color: #000000; opacity: 55% * (1 - k) * 0.5 }
            box { from: sl - 6 * cu, cy - 15 * cu; size: sw + 12 * cu, 5 * cu; color: #000000; opacity: 55% * (1 - k) * 0.45 }
            box { from: sl, cy + 9.5 * cu; size: sw, 1.5 * cu; color: ink; opacity: 12% * (1 - k) }
            ellipse { at: skx, cy; radius: ((6 + 8 * k + 4 * sm) * cu) * 1.3; color: ink; opacity: (22% * k + 28% * sm) * 0.28 }
            ellipse { at: skx, cy; radius: ((6 + 8 * k + 4 * sm) * cu) * 0.95; color: ink; opacity: (22% * k + 28% * sm) * 0.34 }
            ellipse { at: skx, cy; radius: ((6 + 8 * k + 4 * sm) * cu) * 0.62; color: ink; opacity: (22% * k + 28% * sm) * 0.4 }
            repeat i in 0..8 {
                box { at: sl + (4.5 + 5 * i - (k - 0.5) * 9) * cu, cy; size: 1.2 * cu, 9 * cu; corner: 0.6 * cu; color: ink; opacity: 24% * sm }
            }
        }
        PSwitchTrack(scx, cy, sw, skx, hot, k, cu)
        body {
            color: ink
            opacity: 1 - uwu_k
            shadow: 0, 2 * cu, 5 * cu, 26%
            box { at: skx, cy; size: skw, skh; corner: (8.5 - 2 * clamp(k, 0, 1) - 1.5 * sm) * cu }
        }
        CatPawKnob(skx, cy, skw, cu)
    }
    //  An envelope, for the notifications: `o` how open its flap is (0 sealed, 1 open, a spring), `letter` 1 for a letter that comes up out of it, 0 for an
    //  empty one, `op` how much of it shows. `s` is the size (26 * s wide). Flat parts only, so it is the same on glass and obsidian. Back to front: the
    //  flap standing open behind, the back, the letter, the front with its V, and the flap lying shut over the V.
    component Envelope(ex: number, ey: number, s: number, o: number, letter: number, op: number) {
        group {
            opacity: op
            path { at: ex, ey; color: mix(ink, deep, 0.35); opacity: o; move -13 * s, -9 * s; line 0, -22 * s; line 13 * s, -9 * s; close }
            box { at: ex, ey; size: 26 * s, 18 * s; corner: 3 * s; color: mix(ink, deep, 0.2) }
            box { at: ex, ey + (2 - 12 * o) * s; size: 20 * s, 16 * s; corner: 1.8 * s; color: mint; opacity: 100% * letter * (0.25 + 0.75 * o) }
            box { at: ex, ey + (2 - 12 * o) * s - 4 * s; size: 12 * s, 1.5 * s; corner: 0.75 * s; color: deep; opacity: 38% * letter * o }
            box { at: ex, ey + (2 - 12 * o) * s - 0.5 * s; size: 9 * s, 1.5 * s; corner: 0.75 * s; color: deep; opacity: 38% * letter * o }
            path { at: ex, ey; color: ink; move -13 * s, -9 * s; line 0, 3 * s; line 13 * s, -9 * s; line 13 * s, 0; line -13 * s, 0; close }
            box { at: ex, ey + 3 * s; size: 26 * s, 12 * s; corner: 3 * s; color: ink }
            path { at: ex, ey; color: ink; opacity: 1 - o; move -13 * s, -9 * s; line 13 * s, -9 * s; line 0, 3 * s; close }
            path { at: ex, ey; stroke: 1.2 * s; color: deep; opacity: 40%; move -13 * s, -9 * s; line 0, 3 * s; line 13 * s, -9 * s }
        }
    }
    //  The volume's pencil smiley (it was the volume banner's icon; the banner now shows the control center's speaker, PSpk). Kept to reuse: `fvx`, `fvy` is its middle. It reads
    //  the volume and mute state and `fo` (how far the banner has landed, which draws the circle in) itself, and floats a little. Drawn in `u` units (the banners').
    component PSmiley(fvx: number, fvy: number) {
    //  A little face on the slider, a smiley drawn in pencil and seen through a coarse grid of pixels. The pencil: every line is a few short
    //  strokes that are drawn again, a hair off, about eight times a second (the way a hand-drawn film boils), the circle is drawn twice,
    //  a little crooked, and it is drawn in as the banner arrives. The mood is the volume: the mouth grows from a small smile into a laugh
    //  (and the cheeks get hatched) as it goes up, and with the sound off the eyes are dashes and the mouth a flat line. It blinks now and then.
    group {
        move: 0, -1.0 * u * (0.5 + 0.5 * sin(time * 200))
        //  The whole face grows with the volume (small and quiet, a third bigger at full), about its middle; the eyes grow on top of that.
        pivot: fvx, fvy
        scale: 0.8 + 0.35 * if(audio.muted, 0, volume_level)
        let fr = floor(time * 8)                                   // which redrawing of the lines this is
        let lv = if(audio.muted, 0, volume_level)
        let fdraw = clamp(fo * 1.5 - 0.1, 0, 1)                    // how much of the circle is drawn in so far
        let fR = 15 * u
        //  The head: two turns of an uneven circle, 18 strokes the first time round, 12 the second, a little smaller and fainter.
        repeat k in 0..18 {
            let a0 = k * 20 + 6
            let a1 = a0 + 22
            let r0 = fR * (1 + 0.05 * sin(fr * 53 + k * 97))
            let r1 = fR * (1 + 0.05 * sin(fr * 53 + (k + 1) * 97))
            line { from: fvx + r0 * cos(a0), fvy + r0 * sin(a0); to: fvx + r1 * cos(a1), fvy + r1 * sin(a1); width: 1.7 * u; color: if(audio.muted, faint, ink); opacity: if(k < fdraw * 18, 88%, 0%) }
        }
        repeat k in 0..12 {
            let a0 = k * 30 + 112
            let a1 = a0 + 33
            let r0 = fR * 0.93 * (1 + 0.06 * sin(fr * 41 + k * 131 + 40))
            let r1 = fR * 0.93 * (1 + 0.06 * sin(fr * 41 + (k + 1) * 131 + 40))
            line { from: fvx + 1.2 * u + r0 * cos(a0), fvy - 0.8 * u + r0 * sin(a0); to: fvx + 1.2 * u + r1 * cos(a1), fvy - 0.8 * u + r1 * sin(a1); width: 1.3 * u; color: if(audio.muted, faint, ink); opacity: if(k < fdraw * 12, 34%, 0%) }
        }
        //  The eyes: two dots that tremble with the pencil, a little bigger when it is loud; dashes when it is muted; shut for one redrawing in forty.
        let blink = if(mod(fr, 40) == 0, 1, 0)
        let er = (1.4 + 1.8 * lv) * u
        ellipse { at: fvx - 5.5 * u + 0.5 * u * sin(fr * 71), fvy - 4.5 * u + 0.5 * u * sin(fr * 83 + 20); radius: er; scale: 1, 1 - 0.85 * blink; color: if(audio.muted, faint, ink); opacity: fdraw; show: not audio.muted }
        ellipse { at: fvx + 5.5 * u + 0.5 * u * sin(fr * 67 + 50), fvy - 4.5 * u + 0.5 * u * sin(fr * 79 + 90); radius: er; scale: 1, 1 - 0.85 * blink; color: if(audio.muted, faint, ink); opacity: fdraw; show: not audio.muted }
        line { from: fvx - 8 * u, fvy - 4.5 * u + 0.4 * u * sin(fr * 71); to: fvx - 3.5 * u, fvy - 4.5 * u + 0.4 * u * sin(fr * 83); width: 1.6 * u; color: if(audio.muted, faint, ink); opacity: fdraw; show: audio.muted }
        line { from: fvx + 3.5 * u, fvy - 4.5 * u + 0.4 * u * sin(fr * 67); to: fvx + 8 * u, fvy - 4.5 * u + 0.4 * u * sin(fr * 79); width: 1.6 * u; color: if(audio.muted, faint, ink); opacity: fdraw; show: audio.muted }
        //  The mouth, in a coloured pencil: a smile that deepens with the level, and from about half way an open laugh that is filled in.
        let md = (6 + 9 * lv) * u                                  // where the bend of the smile is pulled to
        let mw = (6 + 1.5 * lv) * u
        let mj = 0.5 * u * sin(fr * 59 + 10)
        path { at: fvx, fvy; stroke: 1.8 * u; color: if(audio.muted, faint, mint); opacity: fdraw; show: not audio.muted; move -mw, 3 * u + mj; curve mw, 3 * u - mj via 0, md }
        path { at: fvx, fvy; color: if(audio.muted, faint, mint); opacity: 45% * clamp((lv - 0.5) * 4, 0, 1) * fdraw; show: not audio.muted and lv > 0.5; move -mw, 3 * u + mj; curve mw, 3 * u - mj via 0, md; close }
        line { from: fvx - 5 * u, fvy + 4.5 * u + 0.5 * u * sin(fr * 59); to: fvx + 5 * u, fvy + 4.5 * u + 0.5 * u * sin(fr * 61 + 30); width: 1.8 * u; color: if(audio.muted, faint, ink); opacity: fdraw; show: audio.muted }
        //  Cheeks, shaded with three little strokes each, more of them the louder it is.
        repeat c in 0..3 {
            let ho = clamp(lv * 3.2 - c * 0.7, 0, 1) * fdraw * 65%
            line { from: fvx - 11.5 * u + c * 2 * u, fvy + 0.5 * u + 0.4 * u * sin(fr * 47 + c * 60); to: fvx - 9 * u + c * 2 * u, fvy + 3.5 * u + 0.4 * u * sin(fr * 53 + c * 70); width: 1.1 * u; color: if(audio.muted, faint, mint); opacity: ho }
            line { from: fvx + 9 * u + c * 2 * u, fvy + 0.5 * u + 0.4 * u * sin(fr * 57 + c * 80); to: fvx + 11.5 * u + c * 2 * u, fvy + 3.5 * u + 0.4 * u * sin(fr * 43 + c * 90); width: 1.1 * u; color: if(audio.muted, faint, mint); opacity: ho }
        }
    }
    }

    //  A pencil-drawn slider (the volume and brightness, in the control center and in the banners): the track is a crooked double outline, the level is coloured in with
    //  up-and-down pencil columns (one shape, with a faint second pass), and a pencil circle marks the end. `x0`, `y` the track's left end and middle, `w` its length, `lv` the level
    //  (0 to 1), `k` the unit (`cu` or `u`), `h` the track's thickness, `mute` 1 when silenced (the shading goes grey). `hot` (hover) redraws it about five times a second.
    component PSlider(x0: number, y: number, w: number, lv: number, hot: number, k: number, h: number, mute: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let jt = (0.18 + 0.25 * a) * cu
        let kx = clamp(x0 + w * lv, x0 + h * 0.6, x0 + w - h * 0.6)
        let sp = max(2.5 * k, (w - h) / 86)           // the 88 columns of pencil reach the end of any track: the control center's are as close as they were, a longer one spreads them
        path { at: 0, 0; stroke: 1.5 * k; color: ink; opacity: 0.6; move x0 + h / 2 + jt * sin(fr * 57 + 15900), y - h / 2 + jt * sin(fr * 62 + 15960); line x0 + w - h / 2 + jt * sin(fr * 64 + 15997), y - h / 2 + jt * sin(fr * 69 + 16057); curve x0 + w + jt * sin(fr * 71 + 16094), y + jt * sin(fr * 76 + 16154) via x0 + w + jt * sin(fr * 72 + 19974), y - h / 2 + jt * sin(fr * 77 + 20034); curve x0 + w - h / 2 + jt * sin(fr * 47 + 16191), y + h / 2 + jt * sin(fr * 52 + 16251) via x0 + w + jt * sin(fr * 48 + 20071), y + h / 2 + jt * sin(fr * 53 + 20131); line x0 + h / 2 + jt * sin(fr * 54 + 16288), y + h / 2 + jt * sin(fr * 59 + 16348); curve x0 + jt * sin(fr * 61 + 16385), y + jt * sin(fr * 66 + 16445) via x0 + jt * sin(fr * 62 + 20265), y + h / 2 + jt * sin(fr * 67 + 20325); curve x0 + h / 2 + jt * sin(fr * 68 + 16482), y - h / 2 + jt * sin(fr * 73 + 16542) via x0 + jt * sin(fr * 69 + 20362), y - h / 2 + jt * sin(fr * 74 + 20422); }
        path { at: 0 + 0.35 * cu, 0 + 0.28 * cu; stroke: 1.05 * k; color: ink; opacity: 0.2; move x0 + h / 2 + jt * sin(fr * 72 + 16271), y - h / 2 + jt * sin(fr * 77 + 16331); line x0 + w - h / 2 + jt * sin(fr * 48 + 16368), y - h / 2 + jt * sin(fr * 53 + 16428); curve x0 + w + jt * sin(fr * 55 + 16465), y + jt * sin(fr * 60 + 16525) via x0 + w + jt * sin(fr * 56 + 20345), y - h / 2 + jt * sin(fr * 61 + 20405); curve x0 + w - h / 2 + jt * sin(fr * 62 + 16562), y + h / 2 + jt * sin(fr * 67 + 16622) via x0 + w + jt * sin(fr * 63 + 20442), y + h / 2 + jt * sin(fr * 68 + 20502); line x0 + h / 2 + jt * sin(fr * 69 + 16659), y + h / 2 + jt * sin(fr * 74 + 16719); curve x0 + jt * sin(fr * 45 + 16756), y + jt * sin(fr * 50 + 16816) via x0 + jt * sin(fr * 46 + 20636), y + h / 2 + jt * sin(fr * 51 + 20696); curve x0 + h / 2 + jt * sin(fr * 52 + 16853), y - h / 2 + jt * sin(fr * 57 + 16913) via x0 + jt * sin(fr * 53 + 20733), y - h / 2 + jt * sin(fr * 58 + 20793); }
        //  The shading: the level coloured in with a pencil, in tight columns up and down (one shape, the second pass fainter and a hair off). Each stroke leans, wobbles and overshoots a little;
        //  the columns past the level fold onto its end (they add nothing), and with none of it there is nothing to draw. (A path has at most 191 steps: 88 columns of two.)
        let xs = x0 + h * 0.5
