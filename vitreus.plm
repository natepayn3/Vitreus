    event face_list ->              // the dashboard's picture was pressed: look for pictures to choose from
    event face_set ->               // one of them was chosen (its place in the grid)
    //  The notification rows: a new one slides in; one pressed and dragged to the right (`nt_swx`) is swept away when let go far enough.
    prop nt_in = 1 ~calm
    on change nt_hist.count { nt_in: 0 ~1ms; nt_in: 1 ~450ms after 20ms }
    //  The dashboard's power card: the power button slides the state away and the session options (lock, sleep, log out, restart, shut down)
    //  in; each is held for a second, as in the controls drawer. `dsh_pk` is the one held (-1 none) and `dsh_ps` when it was pressed.
    fact dsh_pw = false
    prop dsh_pwk = 0 ~calm
    follow dsh_pwk = if(dsh_pw, 1, 0)
    fact dsh_pk = -1
    fact dsh_ps = 0
    prop dsh_pp = 0 ~80ms
    follow dsh_pp = if(dsh_pk >= 0, clamp((time - dsh_ps) / 0.9, 0, 1), 0)
    on change dash_open while not dash_open { dsh_pw = false; dsh_pk = -1 }
    //  Settings > Keybinds (logic/keybinds.luau): the shell's binds as the window manager has them, one in edit at a time. Its modifier chips are
    //  `kb_mod` (1 Super, 2 Shift, 4 Ctrl, 8 Alt), its key is recorded by the rules of pages/keybinds_keys.plm while `kb_cap`.
    model kb_rows max 12 { name: text; a: text; b: text; c: text; d: text; wa: number; wb: number; wc: number; wd: number; ra: number; rb: number; rc: number; rd: number; chg: bool }
    fact kb_ok = false                 // the file was read and has binds
    fact kb_sel = -1                   // the row being changed
    fact kb_cap = false                // waiting for a key
    fact kb_mod = 0
    fact kb_has = false                // a key is chosen
    fact kb_dirty = false              // what is chosen differs from what is in the file
    fact kb_arm = false                // Reset to defaults was pressed once: the next press does it
    text kb_name = ""
    text kb_key = ""
    text kb_msg = ""
    text kb_where = ""
