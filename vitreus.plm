    //  A button or pill's outline in pencil, over its fill (the fill and the label stay): the crooked double outline of PSlider's track, drawn as a rounded box with corner `r`, calm
    //  at rest and redrawn about five times a second under the pointer (`hot`). `cx`, `cy` its middle, `w`, `h` its size, `o` how much of it shows, `ku` the unit it is laid out in.
    component PPillOutline(cx: number, cy: number, w: number, h: number, r: number, hot: number, o: number, ku: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let jt = (0.18 + 0.25 * a) * ku
        let x0 = cx - w / 2
        let x1 = cx + w / 2
        let y0 = cy - h / 2
        let y1 = cy + h / 2
        path { at: 0, 0; stroke: 1.3 * ku; color: ink; opacity: 0.6 * o; move x0 + r + jt * sin(fr * 57 + 71000), y0 + jt * sin(fr * 62 + 71060); line x1 - r + jt * sin(fr * 64 + 71100), y0 + jt * sin(fr * 69 + 71160); curve x1 + jt * sin(fr * 71 + 71200), y0 + r + jt * sin(fr * 76 + 71260) via x1 + jt * sin(fr * 72 + 71300), y0 + jt * sin(fr * 77 + 71360); line x1 + jt * sin(fr * 47 + 71400), y1 - r + jt * sin(fr * 52 + 71460); curve x1 - r + jt * sin(fr * 48 + 71500), y1 + jt * sin(fr * 53 + 71560) via x1 + jt * sin(fr * 54 + 71600), y1 + jt * sin(fr * 59 + 71660); line x0 + r + jt * sin(fr * 61 + 71700), y1 + jt * sin(fr * 66 + 71760); curve x0 + jt * sin(fr * 62 + 71800), y1 - r + jt * sin(fr * 67 + 71860) via x0 + jt * sin(fr * 68 + 71900), y1 + jt * sin(fr * 73 + 71960); line x0 + jt * sin(fr * 69 + 72000), y0 + r + jt * sin(fr * 74 + 72060); curve x0 + r + jt * sin(fr * 51 + 72100), y0 + jt * sin(fr * 56 + 72160) via x0 + jt * sin(fr * 58 + 72200), y0 + jt * sin(fr * 63 + 72260); }
        path { at: 0.35 * ku, 0.28 * ku; stroke: 0.9 * ku; color: ink; opacity: 0.2 * o; move x0 + r + jt * sin(fr * 72 + 72300), y0 + jt * sin(fr * 77 + 72360); line x1 - r + jt * sin(fr * 48 + 72400), y0 + jt * sin(fr * 53 + 72460); curve x1 + jt * sin(fr * 55 + 72500), y0 + r + jt * sin(fr * 60 + 72560) via x1 + jt * sin(fr * 56 + 72600), y0 + jt * sin(fr * 61 + 72660); line x1 + jt * sin(fr * 63 + 72700), y1 - r + jt * sin(fr * 68 + 72760); curve x1 - r + jt * sin(fr * 64 + 72800), y1 + jt * sin(fr * 69 + 72860) via x1 + jt * sin(fr * 70 + 72900), y1 + jt * sin(fr * 75 + 72960); line x0 + r + jt * sin(fr * 46 + 73000), y1 + jt * sin(fr * 51 + 73060); curve x0 + jt * sin(fr * 47 + 73100), y1 - r + jt * sin(fr * 52 + 73160) via x0 + jt * sin(fr * 53 + 73200), y1 + jt * sin(fr * 58 + 73260); line x0 + jt * sin(fr * 54 + 73300), y0 + r + jt * sin(fr * 59 + 73360); curve x0 + r + jt * sin(fr * 73 + 73400), y0 + jt * sin(fr * 78 + 73460) via x0 + jt * sin(fr * 49 + 73500), y0 + jt * sin(fr * 54 + 73560); }
    }

    //  A switch's track in pencil, over its fill (the knob stays the solid one): the capsule's crooked double outline and, with the radio on, a few hatched columns up to the knob,
    //  calm at rest and redrawn about five times a second under the pointer (`hot`), like PSlider. `cx`, `cy` the track's middle, `w` its width, `kx` the knob's middle, `on` 0 to 1, `ku` the unit it is laid out in.
    component PSwitchTrack(cx: number, cy: number, w: number, kx: number, hot: number, on: number, ku: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let jt = (0.18 + 0.25 * a) * ku
        let r = 11 * ku
        let x0 = cx - w / 2
        let x1 = cx + w / 2
        path { at: 0, 0; stroke: 1.3 * ku; color: ink; opacity: 0.6; move x0 + r + jt * sin(fr * 57 + 51000), cy - r + jt * sin(fr * 62 + 51060); line x1 - r + jt * sin(fr * 64 + 51100), cy - r + jt * sin(fr * 69 + 51160); curve x1 + jt * sin(fr * 71 + 51200), cy + jt * sin(fr * 76 + 51260) via x1 + jt * sin(fr * 72 + 51300), cy - r + jt * sin(fr * 77 + 51360); curve x1 - r + jt * sin(fr * 47 + 51400), cy + r + jt * sin(fr * 52 + 51460) via x1 + jt * sin(fr * 48 + 51500), cy + r + jt * sin(fr * 53 + 51560); line x0 + r + jt * sin(fr * 54 + 51600), cy + r + jt * sin(fr * 59 + 51660); curve x0 + jt * sin(fr * 61 + 51700), cy + jt * sin(fr * 66 + 51760) via x0 + jt * sin(fr * 62 + 51800), cy + r + jt * sin(fr * 67 + 51860); curve x0 + r + jt * sin(fr * 68 + 51900), cy - r + jt * sin(fr * 73 + 51960) via x0 + jt * sin(fr * 69 + 52000), cy - r + jt * sin(fr * 74 + 52060); }
        path { at: 0.35 * ku, 0.28 * ku; stroke: 0.9 * ku; color: ink; opacity: 0.2; move x0 + r + jt * sin(fr * 72 + 52100), cy - r + jt * sin(fr * 77 + 52160); line x1 - r + jt * sin(fr * 48 + 52200), cy - r + jt * sin(fr * 53 + 52260); curve x1 + jt * sin(fr * 55 + 52300), cy + jt * sin(fr * 60 + 52360) via x1 + jt * sin(fr * 56 + 52400), cy - r + jt * sin(fr * 61 + 52460); curve x1 - r + jt * sin(fr * 63 + 52500), cy + r + jt * sin(fr * 68 + 52560) via x1 + jt * sin(fr * 64 + 52600), cy + r + jt * sin(fr * 69 + 52660); line x0 + r + jt * sin(fr * 70 + 52700), cy + r + jt * sin(fr * 75 + 52760); curve x0 + jt * sin(fr * 46 + 52800), cy + jt * sin(fr * 51 + 52860) via x0 + jt * sin(fr * 47 + 52900), cy + r + jt * sin(fr * 52 + 52960); curve x0 + r + jt * sin(fr * 53 + 53000), cy - r + jt * sin(fr * 58 + 53060) via x0 + jt * sin(fr * 54 + 53100), cy - r + jt * sin(fr * 59 + 53160); }
        repeat i in 0..9 {
            let hx = x0 + r * 0.6 + i * (w - r * 1.2) / 8
            line { from: hx + 0.5 * ku * sin(i * 2.3) + jt * sin(fr * 49 + i * 71), cy - 7 * ku + jt * sin(fr * 61 + i * 53); to: hx - 0.8 * ku + jt * sin(fr * 58 + i * 37), cy + 7 * ku + jt * sin(fr * 67 + i * 43); width: 0.9 * ku; color: ink; opacity: 0.2 * on * clamp((kx - hx) / (4 * ku) + 0.5, 0, 1) }
        }
    }

    //  A workspace mark's outline in pencil (the glass pill is as it is, inside it): a rounded square drawn by hand, with smooth curves for the corners and sides that bow a little, so the wobble
    //  is wavy, not jagged. `o` the mark's own opacity, `wg` how urgent (coral), `act` 1 for the one in view (the accent), `hot` its hover: calm at rest, redrawn about five times a second under the pointer.
    component PWsOutline(cx: number, cy: number, w: number, h: number, o: number, wg: number, act: number, hot: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let c = 0.3 * min(w, h)
        let je = (0.08 + 0.47 * a) * bu       // cleaner at rest, the same wobble under the pointer
        let jm = (0.25 + 1.1 * a) * bu
        path { at: 0, 0; stroke: 1.3 * bu; color: mix(mix(ink, warm, wg), mint, act); opacity: (1) * o; move cx + -w / 2 + c + je * sin(fr * 55 + 37100), cy + -h / 2 + je * sin(fr * 60 + 37160); curve cx + w / 2 - c + je * sin(fr * 62 + 37197), cy + -h / 2 + je * sin(fr * 67 + 37257) via cx + 0 + jm * sin(fr * 55 + 40107), cy + -h / 2 + jm * sin(fr * 60 + 40167); curve cx + w / 2 + je * sin(fr * 69 + 37294), cy + -h / 2 + c + je * sin(fr * 74 + 37354) via cx + w / 2 + jm * sin(fr * 62 + 40204), cy + -h / 2 + jm * sin(fr * 67 + 40264); curve cx + w / 2 + je * sin(fr * 45 + 37391), cy + h / 2 - c + je * sin(fr * 50 + 37451) via cx + w / 2 + jm * sin(fr * 69 + 40301), cy + 0 + jm * sin(fr * 74 + 40361); curve cx + w / 2 - c + je * sin(fr * 52 + 37488), cy + h / 2 + je * sin(fr * 57 + 37548) via cx + w / 2 + jm * sin(fr * 45 + 40398), cy + h / 2 + jm * sin(fr * 50 + 40458); curve cx + -w / 2 + c + je * sin(fr * 59 + 37585), cy + h / 2 + je * sin(fr * 64 + 37645) via cx + 0 + jm * sin(fr * 52 + 40495), cy + h / 2 + jm * sin(fr * 57 + 40555); curve cx + -w / 2 + je * sin(fr * 66 + 37682), cy + h / 2 - c + je * sin(fr * 71 + 37742) via cx + -w / 2 + jm * sin(fr * 59 + 40592), cy + h / 2 + jm * sin(fr * 64 + 40652); curve cx + -w / 2 + je * sin(fr * 73 + 37779), cy + -h / 2 + c + je * sin(fr * 78 + 37839) via cx + -w / 2 + jm * sin(fr * 66 + 40689), cy + 0 + jm * sin(fr * 71 + 40749); curve cx + -w / 2 + c + je * sin(fr * 49 + 37876), cy + -h / 2 + je * sin(fr * 54 + 37936) via cx + -w / 2 + jm * sin(fr * 73 + 40786), cy + -h / 2 + jm * sin(fr * 78 + 40846); close }
        path { at: 0 + 0.35 * bu, 0 + 0.3 * bu; stroke: 0.9 * bu; color: mix(mix(ink, warm, wg), mint, act); opacity: (0.4) * o; move cx + -w / 2 + c + je * sin(fr * 61 + 37577), cy + -h / 2 + je * sin(fr * 66 + 37637); curve cx + w / 2 - c + je * sin(fr * 68 + 37674), cy + -h / 2 + je * sin(fr * 73 + 37734) via cx + 0 + jm * sin(fr * 61 + 40584), cy + -h / 2 + jm * sin(fr * 66 + 40644); curve cx + w / 2 + je * sin(fr * 44 + 37771), cy + -h / 2 + c + je * sin(fr * 49 + 37831) via cx + w / 2 + jm * sin(fr * 68 + 40681), cy + -h / 2 + jm * sin(fr * 73 + 40741); curve cx + w / 2 + je * sin(fr * 51 + 37868), cy + h / 2 - c + je * sin(fr * 56 + 37928) via cx + w / 2 + jm * sin(fr * 44 + 40778), cy + 0 + jm * sin(fr * 49 + 40838); curve cx + w / 2 - c + je * sin(fr * 58 + 37965), cy + h / 2 + je * sin(fr * 63 + 38025) via cx + w / 2 + jm * sin(fr * 51 + 40875), cy + h / 2 + jm * sin(fr * 56 + 40935); curve cx + -w / 2 + c + je * sin(fr * 65 + 38062), cy + h / 2 + je * sin(fr * 70 + 38122) via cx + 0 + jm * sin(fr * 58 + 40972), cy + h / 2 + jm * sin(fr * 63 + 41032); curve cx + -w / 2 + je * sin(fr * 72 + 38159), cy + h / 2 - c + je * sin(fr * 77 + 38219) via cx + -w / 2 + jm * sin(fr * 65 + 41069), cy + h / 2 + jm * sin(fr * 70 + 41129); curve cx + -w / 2 + je * sin(fr * 48 + 38256), cy + -h / 2 + c + je * sin(fr * 53 + 38316) via cx + -w / 2 + jm * sin(fr * 72 + 41166), cy + 0 + jm * sin(fr * 77 + 41226); curve cx + -w / 2 + c + je * sin(fr * 55 + 38353), cy + -h / 2 + je * sin(fr * 60 + 38413) via cx + -w / 2 + jm * sin(fr * 48 + 41263), cy + -h / 2 + jm * sin(fr * 53 + 41323); close }
