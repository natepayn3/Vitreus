            box { at: spx + 219 * pu, sby + (1120 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: if(nta_snd == 2, mint, ink); opacity: if(nta_snd == 2, 24%, 8% + 9% * nta_s2.hover) }
            text "Soft" { at: floor(spx + 219 * pu + 0.5), floor(sby + (1120 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 72 * pu; lines: 1; color: if(nta_snd == 2, mint, ink); opacity: if(nta_snd == 2, 100%, 85%); family: "Space Grotesk" }
            zone box nta_s2 { at: spx + 219 * pu, sby + (1120 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_s2 { emit nta_sound(2) }
            box { at: spx + 302.5 * pu, sby + (1120 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: if(nta_snd == 3, mint, ink); opacity: if(nta_snd == 3, 24%, 8% + 9% * nta_s3.hover) }
            text "Bell" { at: floor(spx + 302.5 * pu + 0.5), floor(sby + (1120 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 72 * pu; lines: 1; color: if(nta_snd == 3, mint, ink); opacity: if(nta_snd == 3, 100%, 85%); family: "Space Grotesk" }
            zone box nta_s3 { at: spx + 302.5 * pu, sby + (1120 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_s3 { emit nta_sound(3) }
            box { at: spx + 386 * pu, sby + (1120 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: if(nta_snd == 4, mint, ink); opacity: if(nta_snd == 4, 24%, 8% + 9% * nta_s4.hover) }
            text "Info" { at: floor(spx + 386 * pu + 0.5), floor(sby + (1120 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 72 * pu; lines: 1; color: if(nta_snd == 4, mint, ink); opacity: if(nta_snd == 4, 100%, 85%); family: "Space Grotesk" }
            zone box nta_s4 { at: spx + 386 * pu, sby + (1120 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_s4 { emit nta_sound(4) }
            box { at: spx + 52 * pu, sby + (1152 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: if(nta_snd == 5, mint, ink); opacity: if(nta_snd == 5, 24%, 8% + 9% * nta_s5.hover) }
            text "Done" { at: floor(spx + 52 * pu + 0.5), floor(sby + (1152 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 72 * pu; lines: 1; color: if(nta_snd == 5, mint, ink); opacity: if(nta_snd == 5, 100%, 85%); family: "Space Grotesk" }
            zone box nta_s5 { at: spx + 52 * pu, sby + (1152 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_s5 { emit nta_sound(5) }
            box { at: spx + 135.5 * pu, sby + (1152 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: if(nta_snd == 6, mint, ink); opacity: if(nta_snd == 6, 24%, 8% + 9% * nta_s6.hover) }
            text "Device" { at: floor(spx + 135.5 * pu + 0.5), floor(sby + (1152 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 72 * pu; lines: 1; color: if(nta_snd == 6, mint, ink); opacity: if(nta_snd == 6, 100%, 85%); family: "Space Grotesk" }
            zone box nta_s6 { at: spx + 135.5 * pu, sby + (1152 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_s6 { emit nta_sound(6) }
            box { at: spx + 219 * pu, sby + (1152 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: if(nta_snd == 7, mint, ink); opacity: if(nta_snd == 7, 24%, 8% + 9% * nta_s7.hover) }
            text "Alarm" { at: floor(spx + 219 * pu + 0.5), floor(sby + (1152 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 72 * pu; lines: 1; color: if(nta_snd == 7, mint, ink); opacity: if(nta_snd == 7, 100%, 85%); family: "Space Grotesk" }
            zone box nta_s7 { at: spx + 219 * pu, sby + (1152 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_s7 { emit nta_sound(7) }
            box { at: spx + 302.5 * pu, sby + (1152 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: if(nta_snd == 8, mint, ink); opacity: if(nta_snd == 8, 24%, 8% + 9% * nta_s8.hover) }
            text "Warning" { at: floor(spx + 302.5 * pu + 0.5), floor(sby + (1152 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 72 * pu; lines: 1; color: if(nta_snd == 8, mint, ink); opacity: if(nta_snd == 8, 100%, 85%); family: "Space Grotesk" }
            zone box nta_s8 { at: spx + 302.5 * pu, sby + (1152 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_s8 { emit nta_sound(8) }
            text nta_explain { at: floor(spx + 14 * pu + 0.5), floor(sby + (1178 - nt.ds) * pu + 0.5); anchor: left top; size: 14; width: 410 * pu; lines: 3; color: faint; family: "Space Grotesk" }
            box { at: spx + 79 * pu, sby + (1238 - nt.ds) * pu; size: 130 * pu, 26 * pu; corner: 13 * pu; color: if(0, mint, ink); opacity: if(0, 24%, 8% + 9% * nta_reset_hit.hover) }
            text "Reset to defaults" { at: floor(spx + 79 * pu + 0.5), floor(sby + (1238 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 124 * pu; lines: 1; color: if(0, mint, ink); opacity: if(0, 100%, 85%); family: "Space Grotesk" }
            zone box nta_reset_hit { at: spx + 79 * pu, sby + (1238 - nt.ds) * pu; size: 132 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: nta_has_rule }
            on press nta_reset_hit { emit nta_reset }
            }
            }
            let nt.thh = 456 * 456 / nt.h
            let nt.thy = nt.thh / 2 + nt.sc / max(1, nt.h - 456) * (456 - nt.thh)
            box { at: spx + 442 * pu, sby + 228 * pu; size: 3 * pu, 456 * pu; corner: 1.5 * pu; color: ink; opacity: 6% }
            box { at: spx + 442 * pu, sby + nt.thy * pu; size: 3 * pu, nt.thh * pu; corner: 1.5 * pu; color: mint; opacity: 55% }
            let nt.cue = clamp((nt.h - 456 - nt.sc) / 24, 0, 1)
            let nt.cuey = sby + (456 - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (400 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * nt.cue }
            }
            box { at: spx + 224 * pu, nt.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * nt.cue }
            box { at: spx + 224 * pu, nt.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * nt_cue_hit.hover) * nt.cue }
            path { at: spx + 204 * pu, nt.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: nt.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, nt.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: nt.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            text "More" { at: floor(spx + 232 * pu + 0.5), floor(nt.cuey + 0.5); anchor: center; size: 15; weight: 700; color: ink; opacity: nt.cue; family: "Space Grotesk" }
            zone box nt_cue_hit { at: spx + 224 * pu, sby + (456 - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: nt.cue > 0.5 }
            on press nt_cue_hit { nt_scroll_to = clamp(nt_scroll_to + 342, 0, max(0, nt.h - 456)) }
            zone box nt_bar_hit { at: spx + 442 * pu, sby + 228 * pu; size: 14 * pu, 456 * pu; cursor: pointer; active: nt.h > 456 }
            on press nt_bar_hit { nt_scroll_to = clamp(((pointer.y - sby) / pu - nt.thh / 2) / max(1, 456 - nt.thh) * (nt.h - 456), 0, max(0, nt.h - 456)) }
            on drag nt_bar_hit { nt_scroll_to = clamp(((pointer.y - sby) / pu - nt.thh / 2) / max(1, 456 - nt.thh) * (nt.h - 456), 0, max(0, nt.h - 456)) }
        }
        //  ── Notifications page: END ──

        //  ── System monitor page: BEGIN (generated; see bin/vitreus-sysmon) ──
        //  The page scrolls like Display's: a clipped viewport as tall as the Wallpaper page, the content moved up by `sm.off`, and the wheel
        //  caught by the zone under it. Nothing on it is pressed, so nothing has to be kept from a click when it is out of sight.
        group {
            show: set_pgs > 0.01
            opacity: set_pgs
            let sm.sc = clamp(sm_scroll, 0, max(0, sm.h - 456))
            let sm.off = floor(sm.sc * pu + 0.5)        // whole pixels: text that is shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pu, sby + 228 * pu; size: 456 * pu, 456 * pu }
            zone box sm_wheel { at: spx + 219 * pu, sby + 228 * pu; size: 446 * pu, 456 * pu }
            on scroll sm_wheel { sm_scroll_to = clamp(sm_scroll_to + wheel * 44, 0, max(0, sm.h - 456)) }
            group {
                move: 0, -sm.off
            box { at: spx + 219 * pu, sby + 40 * pu; size: 438 * pu, 68 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text sm_host { at: floor(spx + 14 * pu + 0.5), floor(sby + 25 * pu + 0.5); anchor: left center; size: 21.5; weight: 700; width: 300 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            text sm_cpu_name { at: floor(spx + 14 * pu + 0.5), floor(sby + 42 * pu + 0.5); anchor: left center; size: 13.5; weight: 500; width: 410 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            text "UPTIME" { at: floor(spx + 14 * pu + 0.5), floor(sby + 61 * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_uptime { at: floor(spx + 62 * pu + 0.5), floor(sby + 61 * pu + 0.5); anchor: left center; size: 15; weight: 600; width: 84 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            text "LOAD" { at: floor(spx + 152 * pu + 0.5), floor(sby + 61 * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_load { at: floor(spx + 200 * pu + 0.5), floor(sby + 61 * pu + 0.5); anchor: left center; size: 15; weight: 600; width: 84 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            text "KERNEL" { at: floor(spx + 292 * pu + 0.5), floor(sby + 61 * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_kernel { at: floor(spx + 346 * pu + 0.5), floor(sby + 61 * pu + 0.5); anchor: left center; size: 15; weight: 600; width: 84 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            box { at: spx + 219 * pu, sby + 176 * pu; size: 438 * pu, 188 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "PROCESSOR" { at: floor(spx + 14 * pu + 0.5), floor(sby + 96 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_cpu_meta { at: floor(spx + 424 * pu + 0.5), floor(sby + 96 * pu + 0.5); anchor: right center; size: 13.5; weight: 500; width: 260 * pu; lines: 1; color: faint; family: "Space Grotesk"; align: right }
            arc { at: spx + 74 * pu, sby + 174 * pu; radius: 44 * pu; span: 270deg; width: 9 * pu; color: ink; opacity: 9%; rotate: 0deg }
            group {
                glow: 7, 26%
                arc { at: spx + 74 * pu, sby + 174 * pu; radius: 44 * pu; span: (270 * clamp(sm_cpu_p, 0.004, 1)) * 1deg; width: 9 * pu; color: mix(mint, alert, clamp((sm_cpu_p - 0.75) / 0.25, 0, 1)); rotate: (-135 + 135 * clamp(sm_cpu_p, 0.004, 1)) * 1deg }
            }
            text sm_cpu_txt { at: floor(spx + 74 * pu + 0.5), floor(sby + 169 * pu + 0.5); anchor: center center; size: 29.5; weight: 700; width: 80 * pu; lines: 1; color: ink; family: "Space Grotesk"; align: center }
            text "CPU" { at: floor(spx + 74 * pu + 0.5), floor(sby + 191 * pu + 0.5); anchor: center center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_threads { at: floor(spx + 74 * pu + 0.5), floor(sby + 250 * pu + 0.5); anchor: center center; size: 13.5; weight: 500; width: 110 * pu; lines: 1; color: faint; family: "Space Grotesk"; align: center }
            box { at: spx + 286 * pu, sby + 146.5 * pu; size: 276 * pu, 0.6 * pu; color: ink; opacity: 7% }
            box { at: spx + 286 * pu, sby + 135 * pu; size: 276 * pu, 0.6 * pu; color: ink; opacity: 7% }
            box { at: spx + 286 * pu, sby + 123.5 * pu; size: 276 * pu, 0.6 * pu; color: ink; opacity: 7% }
            box { at: spx + 286 * pu, sby + 158 * pu; size: 276 * pu, 0.8 * pu; color: ink; opacity: 14% }
            repeat i in 0..60 {
                let k = i + 60 - sm_hist.count
                let hh = max(1.6, clamp(sm_hist.$i.cpu, 0, 1) * 46)
                box { at: spx + 148 * pu + (k + 0.5) * 4.6 * pu, sby + 158 * pu - hh / 2 * pu; size: 3.4 * pu, hh * pu; corner: 1.2 * pu; color: mix(mint, alert, clamp((sm_hist.$i.cpu - 0.75) / 0.25, 0, 1)); opacity: (22% + 70% * k / 60); show: i < sm_hist.count }
            }
            text "CORES" { at: floor(spx + 148 * pu + 0.5), floor(sby + 170 * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            repeat c in 0..16 {
                let cc = mod(c, 8)
                let cr = floor(c / 8)
                let cxx = 148 + cc * 35 + 13
                let cyy = 179 + cr * 42
                let cp = clamp(sm_core.$c.pct, 0, 1)
                box { at: spx + cxx * pu, sby + (cyy + 13) * pu; size: 26 * pu, 26 * pu; corner: 7 * pu; color: ink; opacity: 8%; show: c < sm_core.count }
                box { at: spx + cxx * pu, sby + (cyy + 26 - max(3, 26 * cp) / 2) * pu; size: 26 * pu, max(3, 26 * cp) * pu; corner: 7 * pu; color: mix(mint, alert, clamp((cp - 0.75) / 0.25, 0, 1)); opacity: 60% + 40% * cp; show: c < sm_core.count }
                text number(c, 0, "") { at: floor(spx + cxx * pu + 0.5), floor(sby + (cyy + 34) * pu + 0.5); anchor: center; size: 11; color: faint; family: "Space Grotesk"; show: c < sm_core.count }
            }
            box { at: spx + 219 * pu, sby + 357 * pu; size: 438 * pu, 158 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "MEMORY" { at: floor(spx + 14 * pu + 0.5), floor(sby + 292 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_mem_total { at: floor(spx + 424 * pu + 0.5), floor(sby + 292 * pu + 0.5); anchor: right center; size: 13.5; weight: 500; width: 200 * pu; lines: 1; color: faint; family: "Space Grotesk"; align: right }
            arc { at: spx + 74 * pu, sby + 360 * pu; radius: 40 * pu; span: 359deg; width: 11 * pu; color: ink; opacity: 9%; rotate: 0deg }
            group {
                glow: 7, 24%
            arc { at: spx + 74 * pu, sby + 360 * pu; radius: 40 * pu; span: (360 * clamp(sm_cache_p, 0.004, 1)) * 1deg; width: 11 * pu; color: mint; opacity: 42%; rotate: (360 * clamp(sm_mem_p, 0, 1) + 180 * clamp(sm_cache_p, 0.004, 1)) * 1deg }
            arc { at: spx + 74 * pu, sby + 360 * pu; radius: 40 * pu; span: (360 * clamp(sm_mem_p, 0.004, 1)) * 1deg; width: 11 * pu; color: mix(mint, alert, clamp((sm_mem_p - 0.85) / 0.15000000000000002, 0, 1)); rotate: (180 * clamp(sm_mem_p, 0.004, 1)) * 1deg }
            }
            text sm_mem_pct { at: floor(spx + 74 * pu + 0.5), floor(sby + 356 * pu + 0.5); anchor: center center; size: 27; weight: 700; width: 80 * pu; lines: 1; color: ink; family: "Space Grotesk"; align: center }
            text "IN USE" { at: floor(spx + 74 * pu + 0.5), floor(sby + 375 * pu + 0.5); anchor: center center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            ellipse { at: spx + 148 * pu, sby + 312 * pu; radius: 3.2 * pu; color: mint; opacity: 100% }
            text "Used" { at: floor(spx + 160 * pu + 0.5), floor(sby + 312 * pu + 0.5); anchor: left center; size: 14; weight: 600; color: ink; family: "Space Grotesk"; opacity: 85% }
            text sm_mem_used { at: floor(spx + 424 * pu + 0.5), floor(sby + 312 * pu + 0.5); anchor: right center; size: 15; weight: 600; width: 200 * pu; lines: 1; color: ink; family: "Space Grotesk"; align: right }
            ellipse { at: spx + 148 * pu, sby + 331 * pu; radius: 3.2 * pu; color: mint; opacity: 42% }
            text "Cache" { at: floor(spx + 160 * pu + 0.5), floor(sby + 331 * pu + 0.5); anchor: left center; size: 14; weight: 600; color: ink; family: "Space Grotesk"; opacity: 85% }
            text sm_mem_cache { at: floor(spx + 424 * pu + 0.5), floor(sby + 331 * pu + 0.5); anchor: right center; size: 15; weight: 600; width: 200 * pu; lines: 1; color: ink; family: "Space Grotesk"; align: right }
            ellipse { at: spx + 148 * pu, sby + 350 * pu; radius: 3.2 * pu; color: ink; opacity: 22% }
            text "Free" { at: floor(spx + 160 * pu + 0.5), floor(sby + 350 * pu + 0.5); anchor: left center; size: 14; weight: 600; color: ink; family: "Space Grotesk"; opacity: 85% }
            text sm_mem_free { at: floor(spx + 424 * pu + 0.5), floor(sby + 350 * pu + 0.5); anchor: right center; size: 15; weight: 600; width: 200 * pu; lines: 1; color: ink; family: "Space Grotesk"; align: right }
            text "SWAP" { at: floor(spx + 148 * pu + 0.5), floor(sby + 374 * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_swap_txt { at: floor(spx + 424 * pu + 0.5), floor(sby + 374 * pu + 0.5); anchor: right center; size: 13.5; weight: 500; width: 230 * pu; lines: 1; color: faint; family: "Space Grotesk"; align: right }
            box { at: spx + 286 * pu, sby + 386 * pu; size: 276 * pu, 6 * pu; corner: 3 * pu; color: ink; opacity: 8% }
            box { from: spx + 148 * pu, sby + 383 * pu; size: max(6, 276 * clamp(sm_swap_p, 0, 1)) * pu, 6 * pu; corner: 3 * pu; color: mint }
            box { at: spx + 286 * pu, sby + 428 * pu; size: 276 * pu, 0.8 * pu; color: ink; opacity: 14% }
            repeat i in 0..60 {
                let k = i + 60 - sm_hist.count
                let hh = max(1.6, clamp(sm_hist.$i.mem, 0, 1) * 30)
                box { at: spx + 148 * pu + (k + 0.5) * 4.6 * pu, sby + 428 * pu - hh / 2 * pu; size: 3.4 * pu, hh * pu; corner: 1.2 * pu; color: mint; opacity: (22% + 70% * k / 60); show: i < sm_hist.count }
            }
            box { at: spx + 219 * pu, sby + 526 * pu; size: 438 * pu, 164 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "GRAPHICS" { at: floor(spx + 14 * pu + 0.5), floor(sby + 458 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_gpu_name { at: floor(spx + 424 * pu + 0.5), floor(sby + 458 * pu + 0.5); anchor: right center; size: 13.5; weight: 500; width: 300 * pu; lines: 1; color: faint; family: "Space Grotesk"; align: right; show: sm_gpu_on }
            text "No GPU sensors found" { at: floor(spx + 219 * pu + 0.5), floor(sby + 530 * pu + 0.5); anchor: center center; size: 16; weight: 500; width: 300 * pu; lines: 1; color: faint; family: "Space Grotesk"; align: center; show: not sm_gpu_on }
            group {
                show: sm_gpu_on
            arc { at: spx + 74 * pu, sby + 532 * pu; radius: 44 * pu; span: 270deg; width: 8 * pu; color: ink; opacity: 9%; rotate: 0deg }
            group {
                glow: 7, 26%
                arc { at: spx + 74 * pu, sby + 532 * pu; radius: 44 * pu; span: (270 * clamp(sm_gpu_p, 0.004, 1)) * 1deg; width: 8 * pu; color: mix(mint, alert, clamp((sm_gpu_p - 0.8) / 0.19999999999999996, 0, 1)); rotate: (-135 + 135 * clamp(sm_gpu_p, 0.004, 1)) * 1deg }
            }
            arc { at: spx + 74 * pu, sby + 532 * pu; radius: 30 * pu; span: 270deg; width: 6 * pu; color: ink; opacity: 8%; rotate: 0deg }
            group {
                glow: 7, 26%
                arc { at: spx + 74 * pu, sby + 532 * pu; radius: 30 * pu; span: (270 * clamp(sm_vram_p, 0.004, 1)) * 1deg; width: 6 * pu; color: mix(mint, ink, 0.25); rotate: (-135 + 135 * clamp(sm_vram_p, 0.004, 1)) * 1deg }
            }
            text sm_gpu_txt { at: floor(spx + 74 * pu + 0.5), floor(sby + 529 * pu + 0.5); anchor: center center; size: 23; weight: 700; width: 64 * pu; lines: 1; color: ink; family: "Space Grotesk"; align: center }
            text "GPU" { at: floor(spx + 74 * pu + 0.5), floor(sby + 546 * pu + 0.5); anchor: center center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text "VRAM" { at: floor(spx + 148 * pu + 0.5), floor(sby + 478 * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_gpu_vram { at: floor(spx + 424 * pu + 0.5), floor(sby + 478 * pu + 0.5); anchor: right center; size: 14; weight: 600; width: 240 * pu; lines: 1; color: ink; family: "Space Grotesk"; align: right }
            box { at: spx + 286 * pu, sby + 489 * pu; size: 276 * pu, 6 * pu; corner: 3 * pu; color: ink; opacity: 8% }
            box { from: spx + 148 * pu, sby + 486 * pu; size: max(6, 276 * clamp(sm_vram_p, 0, 1)) * pu, 6 * pu; corner: 3 * pu; color: mix(mint, ink, 0.25) }
            text "POWER" { at: floor(spx + 148 * pu + 0.5), floor(sby + 506 * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_gpu_power { at: floor(spx + 424 * pu + 0.5), floor(sby + 506 * pu + 0.5); anchor: right center; size: 14; weight: 600; width: 240 * pu; lines: 1; color: ink; family: "Space Grotesk"; align: right }
            box { at: spx + 286 * pu, sby + 517 * pu; size: 276 * pu, 6 * pu; corner: 3 * pu; color: ink; opacity: 8% }
            box { from: spx + 148 * pu, sby + 514 * pu; size: max(6, 276 * clamp(sm_pw_p, 0, 1)) * pu, 6 * pu; corner: 3 * pu; color: mix(mint, alert, clamp((sm_pw_p - 0.85) / 0.15000000000000002, 0, 1)) }
            text "TEMP" { at: floor(spx + 148 * pu + 0.5), floor(sby + 536 * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_gpu_temp { at: floor(spx + 148 * pu + 0.5), floor(sby + 550 * pu + 0.5); anchor: left center; size: 15; weight: 700; width: 112 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            text "FAN" { at: floor(spx + 232 * pu + 0.5), floor(sby + 536 * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_gpu_fan { at: floor(spx + 232 * pu + 0.5), floor(sby + 550 * pu + 0.5); anchor: left center; size: 15; weight: 700; width: 112 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            text "CLOCK" { at: floor(spx + 306 * pu + 0.5), floor(sby + 536 * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_gpu_clock { at: floor(spx + 306 * pu + 0.5), floor(sby + 550 * pu + 0.5); anchor: left center; size: 15; weight: 700; width: 112 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            box { at: spx + 286 * pu, sby + 598 * pu; size: 276 * pu, 0.8 * pu; color: ink; opacity: 14% }
            repeat i in 0..60 {
                let k = i + 60 - sm_hist.count
                let hh = max(1.6, clamp(sm_hist.$i.gpu, 0, 1) * 32)
                box { at: spx + 148 * pu + (k + 0.5) * 4.6 * pu, sby + 598 * pu - hh / 2 * pu; size: 3.4 * pu, hh * pu; corner: 1.2 * pu; color: mix(mint, alert, clamp((sm_hist.$i.gpu - 0.8) / 0.2, 0, 1)); opacity: (22% + 70% * k / 60); show: i < sm_hist.count }
            }
            }
            box { at: spx + 219 * pu, sby + 705 * pu; size: 438 * pu, 178 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "NETWORK" { at: floor(spx + 14 * pu + 0.5), floor(sby + 631 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_iface { at: floor(spx + 424 * pu + 0.5), floor(sby + 631 * pu + 0.5); anchor: right center; size: 13.5; weight: 500; width: 200 * pu; lines: 1; color: faint; family: "Space Grotesk"; align: right }
            box { at: spx + 149 * pu, sby + 712 * pu; size: 270 * pu, 0.8 * pu; color: ink; opacity: 16% }
            repeat i in 0..60 {
                let k = i + 60 - sm_hist.count
                let dh = max(1.4, clamp(sm_hist.$i.rx, 0, 1) * 62)
                let uh = max(1.4, clamp(sm_hist.$i.tx, 0, 1) * 62)
                box { at: spx + (14 + (k + 0.5) * 4.5) * pu, sby + (711 - dh / 2) * pu; size: 3.3 * pu, dh * pu; corner: 1.2 * pu; color: mint; opacity: (22% + 70% * k / 60); show: i < sm_hist.count }
                box { at: spx + (14 + (k + 0.5) * 4.5) * pu, sby + (713 + uh / 2) * pu; size: 3.3 * pu, uh * pu; corner: 1.2 * pu; color: mix(mint, ink, 0.4); opacity: (18% + 55% * k / 60); show: i < sm_hist.count }
            }
            text "DOWNLOAD" { at: floor(spx + 304 * pu + 0.5), floor(sby + 656 * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_rx_txt { at: floor(spx + 304 * pu + 0.5), floor(sby + 674 * pu + 0.5); anchor: left center; size: 20; weight: 700; width: 126 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            text sm_rx_total { at: floor(spx + 304 * pu + 0.5), floor(sby + 692 * pu + 0.5); anchor: left center; size: 13; weight: 500; width: 126 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            text "UPLOAD" { at: floor(spx + 304 * pu + 0.5), floor(sby + 720 * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_tx_txt { at: floor(spx + 304 * pu + 0.5), floor(sby + 738 * pu + 0.5); anchor: left center; size: 20; weight: 700; width: 126 * pu; lines: 1; color: mix(mint, ink, 0.4); family: "Space Grotesk" }
            text sm_tx_total { at: floor(spx + 304 * pu + 0.5), floor(sby + 756 * pu + 0.5); anchor: left center; size: 13; weight: 500; width: 126 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            box { at: spx + 219 * pu, sby + (802 + (226 - sm.ds) / 2) * pu; size: 438 * pu, (226 - sm.ds) * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "STORAGE" { at: floor(spx + 14 * pu + 0.5), floor(sby + 817 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            repeat m in 0..4 {
                let my = 844 + m * 38
                text sm_mnt.$m.name { at: floor(spx + 14 * pu + 0.5), floor(sby + my * pu + 0.5); anchor: left center; size: 15.5; weight: 600; width: 200 * pu; lines: 1; color: ink; family: "Space Grotesk"; show: m < sm_mnt.count }
                text sm_mnt.$m.info { at: floor(spx + 424 * pu + 0.5), floor(sby + my * pu + 0.5); anchor: right center; align: right; size: 13.5; width: 220 * pu; lines: 1; color: faint; family: "Space Grotesk"; show: m < sm_mnt.count }
                box { at: spx + 219 * pu, sby + (my + 15) * pu; size: 410 * pu, 8 * pu; corner: 4 * pu; color: ink; opacity: 8%; show: m < sm_mnt.count }
                box { from: spx + 14 * pu, sby + (my + 11) * pu; size: max(8, 410 * clamp(sm_mnt.$m.pct, 0, 1)) * pu, 8 * pu; corner: 4 * pu; color: mix(mint, alert, clamp((sm_mnt.$m.pct - 0.8) / 0.19999999999999996, 0, 1)); show: m < sm_mnt.count }
            }
            box { at: spx + 219 * pu, sby + (968 - sm.ds) * pu; size: 410 * pu, 0.8 * pu; color: ink; opacity: 10% }
            text "READ" { at: floor(spx + 14 * pu + 0.5), floor(sby + (986 - sm.ds) * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_dr_txt { at: floor(spx + 14 * pu + 0.5), floor(sby + (1005 - sm.ds) * pu + 0.5); anchor: left center; size: 17.5; weight: 700; width: 100 * pu; lines: 1; color: ink; family: "Space Grotesk" }
            text "WRITE" { at: floor(spx + 124 * pu + 0.5), floor(sby + (986 - sm.ds) * pu + 0.5); anchor: left center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_dw_txt { at: floor(spx + 124 * pu + 0.5), floor(sby + (1005 - sm.ds) * pu + 0.5); anchor: left center; size: 17.5; weight: 700; width: 100 * pu; lines: 1; color: mix(mint, ink, 0.4); family: "Space Grotesk" }
            repeat i in 0..60 {
                let k = i + 60 - sm_hist.count
                let rh = max(1, clamp(sm_hist.$i.dr, 0, 1) * 22)
                let wh = max(1, clamp(sm_hist.$i.dw, 0, 1) * 22)
                box { at: spx + (240 + (k + 0.5) * 3.05) * pu, sby + (997.5 - sm.ds - rh / 2) * pu; size: 2.2 * pu, rh * pu; corner: 1 * pu; color: mint; opacity: (22% + 70% * k / 60); show: i < sm_hist.count }
                box { at: spx + (240 + (k + 0.5) * 3.05) * pu, sby + (998.5 - sm.ds + wh / 2) * pu; size: 2.2 * pu, wh * pu; corner: 1 * pu; color: mix(mint, ink, 0.4); opacity: (18% + 55% * k / 60); show: i < sm_hist.count }
            }
            box { at: spx + 219 * pu, sby + (1036 - sm.ds + (242 - sm.dt) / 2) * pu; size: 438 * pu, (242 - sm.dt) * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "TEMPERATURES" { at: floor(spx + 14 * pu + 0.5), floor(sby + (1051 - sm.ds) * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            repeat t in 0..8 {
                let ty = 1076 - sm.ds + t * 24
                text sm_tmp.$t.label { at: floor(spx + 14 * pu + 0.5), floor(sby + ty * pu + 0.5); anchor: left center; size: 15; weight: 600; width: 130 * pu; lines: 1; color: ink; family: "Space Grotesk"; show: t < sm_tmp.count }
                box { at: spx + 255 * pu, sby + ty * pu; size: 210 * pu, 7 * pu; corner: 3.5 * pu; color: ink; opacity: 8%; show: t < sm_tmp.count }
                box { from: spx + 150 * pu, sby + (ty - 3.5) * pu; size: max(7, 210 * clamp(sm_tmp.$t.f, 0, 1)) * pu, 7 * pu; corner: 3.5 * pu; color: mix(mint, alert, clamp(sm_tmp.$t.heat, 0, 1)); show: t < sm_tmp.count }
                text sm_tmp.$t.txt { at: floor(spx + 424 * pu + 0.5), floor(sby + ty * pu + 0.5); anchor: right center; align: right; size: 15; weight: 700; width: 56 * pu; lines: 1; color: ink; family: "Space Grotesk"; show: t < sm_tmp.count }
            }
            text sm_fans { at: floor(spx + 14 * pu + 0.5), floor(sby + (1264 - sm.ds - sm.dt) * pu + 0.5); anchor: left center; size: 13.5; width: 410 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            box { at: spx + 219 * pu, sby + (1406 - sm.ds - sm.dt) * pu; size: 438 * pu, 240 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "BUSIEST PROGRAMS" { at: floor(spx + 14 * pu + 0.5), floor(sby + (1301 - sm.ds - sm.dt) * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text "CPU" { at: floor(spx + 372 * pu + 0.5), floor(sby + (1301 - sm.ds - sm.dt) * pu + 0.5); anchor: right center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            text "MEMORY" { at: floor(spx + 424 * pu + 0.5), floor(sby + (1301 - sm.ds - sm.dt) * pu + 0.5); anchor: right center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" }
            repeat r in 0..8 {
                let ry = 1326 - sm.ds - sm.dt + r * 26
                text sm_proc.$r.name { at: floor(spx + 14 * pu + 0.5), floor(sby + ry * pu + 0.5); anchor: left center; size: 15.5; weight: 600; width: 130 * pu; lines: 1; color: ink; family: "Space Grotesk"; show: r < sm_proc.count }
                box { at: spx + 228 * pu, sby + ry * pu; size: 140 * pu, 7 * pu; corner: 3.5 * pu; color: ink; opacity: 8%; show: r < sm_proc.count }
                box { from: spx + 158 * pu, sby + (ry - 3.5) * pu; size: max(7, 140 * clamp(sm_proc.$r.cpu, 0, 1)) * pu, 7 * pu; corner: 3.5 * pu; color: mix(mint, alert, clamp((sm_proc.$r.cpu - 0.75) / 0.25, 0, 1)); show: r < sm_proc.count }
                text sm_proc.$r.cpu_txt { at: floor(spx + 372 * pu + 0.5), floor(sby + ry * pu + 0.5); anchor: right center; align: right; size: 14; weight: 700; width: 56 * pu; lines: 1; color: ink; family: "Space Grotesk"; show: r < sm_proc.count }
                text sm_proc.$r.mem_txt { at: floor(spx + 424 * pu + 0.5), floor(sby + ry * pu + 0.5); anchor: right center; align: right; size: 14; weight: 500; width: 50 * pu; lines: 1; color: faint; family: "Space Grotesk"; show: r < sm_proc.count }
            }
            }
            let sm.thh = 456 * 456 / sm.h
            let sm.thy = sm.thh / 2 + sm.sc / max(1, sm.h - 456) * (456 - sm.thh)
            box { at: spx + 442 * pu, sby + 228 * pu; size: 3 * pu, 456 * pu; corner: 1.5 * pu; color: ink; opacity: 6% }
            box { at: spx + 442 * pu, sby + sm.thy * pu; size: 3 * pu, sm.thh * pu; corner: 1.5 * pu; color: mint; opacity: 55% }
            let sm.cue = clamp((sm.h - 456 - sm.sc) / 24, 0, 1)
            let sm.cuey = sby + (456 - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (400 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * sm.cue }
            }
            box { at: spx + 224 * pu, sm.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * sm.cue }
            box { at: spx + 224 * pu, sm.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * sm_cue_hit.hover) * sm.cue }
            path { at: spx + 204 * pu, sm.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: sm.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, sm.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: sm.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            text "More" { at: floor(spx + 232 * pu + 0.5), floor(sm.cuey + 0.5); anchor: center; size: 15; weight: 700; color: ink; opacity: sm.cue; family: "Space Grotesk" }
            zone box sm_cue_hit { at: spx + 224 * pu, sby + (456 - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: sm.cue > 0.5 }
            on press sm_cue_hit { sm_scroll_to = clamp(sm_scroll_to + 342, 0, max(0, sm.h - 456)) }
            zone box sm_bar_hit { at: spx + 442 * pu, sby + 228 * pu; size: 14 * pu, 456 * pu; cursor: pointer; active: sm.h > 456 }
            on press sm_bar_hit { sm_scroll_to = clamp(((pointer.y - sby) / pu - sm.thh / 2) / max(1, 456 - sm.thh) * (sm.h - 456), 0, max(0, sm.h - 456)) }
            on drag sm_bar_hit { sm_scroll_to = clamp(((pointer.y - sby) / pu - sm.thh / 2) / max(1, 456 - sm.thh) * (sm.h - 456), 0, max(0, sm.h - 456)) }
        }
        //  ── System monitor page: END ──

        //  The Display page: the monitors on a canvas you can drag them on, an inspector for the
        //  one that is selected (mode, refresh rate, scale, rotation, SDR levels), and saved profiles. What it
        //  edits is a draft; Apply sends it to Hyprland and the change is on trial until it is kept (see the Display
        //  section of vitreus.luau).
        group {
            show: set_pgd > 0.01
            opacity: set_pgd
            let disp.sc = clamp(disp_scroll, 0, max(0, disp.h - 456))     // how far the page is scrolled, unscaled
            let disp.off = disp.sc * pu
            let cvx = spx + 19 * pu
            let cvy = sby + 26 * pu
            let dtop = sby + 140 * pu                      // the inspector card's top
            let ptop = sby + 460 * pu                      // the profiles card's top

            //  The page scrolls: everything below moves up by `disp.off` inside a viewport as tall as the Wallpaper page
            //  (456), and only the controls that are in view are live, so one scrolled out of sight catches no click
            //  (a clip does not stop a zone). The wheel is caught by the zone under everything else.
            clip box { at: spx + 224 * pu, sby + 228 * pu; size: 456 * pu, 456 * pu }
            zone box disp_wheel { at: spx + 219 * pu, sby + 228 * pu; size: 446 * pu, 456 * pu }
            on scroll disp_wheel { disp_scroll_to = clamp(disp_scroll_to + wheel * 40, 0, max(0, disp.h - 456)) }
            group {
                move: 0, -disp.off

            //  ── Card one: the monitors ──
            box { at: spx + 219 * pu, sby + 66 * pu; size: 438 * pu, 132 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "MONITORS" { at: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            box { at: spx + 322 * pu, sby + 13 * pu; size: 92 * pu, 20 * pu; corner: 10 * pu; color: ink; opacity: (8% + 10% * disp_arr_hit.hover) * (40% + 60% * clamp(disp_count - 1, 0, 1)) }
            text "Auto-arrange" { at: floor(spx + 322 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 600; width: 88 * pu; lines: 1; color: ink; opacity: 85% * (40% + 60% * clamp(disp_count - 1, 0, 1)); family: "Space Grotesk" }
            zone box disp_arr_hit { at: spx + 322 * pu, sby + 13 * pu; size: 94 * pu, 22 * pu; corner: 11 * pu; cursor: pointer; active: (disp_count > 1) and (sby + 13 * pu) - disp.off > sby and (sby + 13 * pu) - disp.off < sby + 456 * pu }
            on press disp_arr_hit { emit disp_arrange }
            box { at: spx + 394 * pu, sby + 13 * pu; size: 48 * pu, 20 * pu; corner: 10 * pu; color: ink; opacity: (8% + 10% * disp_swap_hit.hover) * (40% + 60% * clamp(disp_count - 1, 0, 1)) }
            text "Swap" { at: floor(spx + 394 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 600; width: 44 * pu; lines: 1; color: ink; opacity: 85% * (40% + 60% * clamp(disp_count - 1, 0, 1)); family: "Space Grotesk" }
            zone box disp_swap_hit { at: spx + 394 * pu, sby + 13 * pu; size: 50 * pu, 22 * pu; corner: 11 * pu; cursor: pointer; active: (disp_count > 1) and (sby + 13 * pu) - disp.off > sby and (sby + 13 * pu) - disp.off < sby + 456 * pu }
            on press disp_swap_hit { emit disp_swap }
            box { at: cvx + 200 * pu, cvy + 48 * pu; size: 400 * pu, 96 * pu; corner: 10 * pu; color: #000000; opacity: 22% }
            repeat i in 0..4 {
                let bx = cvx + disp_b.$i.x * pu
                let by = cvy + disp_b.$i.y * pu
                let bw = disp_b.$i.w * pu
                let bh = disp_b.$i.h * pu
                box { from: bx, by; size: bw, bh; corner: 6 * pu; color: if(disp_b.$i.sel, mint, ink); opacity: if(disp_b.$i.on, if(disp_b.$i.sel, 26%, 12%) + 6% * disp_mz.$i.hover, 0%) }
                box { from: bx, by; size: bw, bh; corner: 6 * pu; stroke: 1.5 * pu; color: mint; opacity: if(disp_b.$i.on and disp_b.$i.sel, 100%, 0%) }
                ellipse { at: bx + bw - 7 * pu, by + 7 * pu; radius: 2.5 * pu; color: mint; opacity: if(disp_b.$i.on and disp_b.$i.dirty, 100%, 0%) }
                text disp_b.$i.name { at: floor(bx + bw / 2 + 0.5), floor(by + bh / 2 - 6 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: max(10 * pu, bw - 8 * pu); lines: 1; color: ink; show: disp_b.$i.on; family: "Space Grotesk" }
                text disp_b.$i.mode { at: floor(bx + bw / 2 + 0.5), floor(by + bh / 2 + 7 * pu + 0.5); anchor: center; align: center; size: 12; width: max(10 * pu, bw - 8 * pu); lines: 1; color: faint; show: disp_b.$i.on and bh > 30 * pu; family: "Space Grotesk" }
                zone box disp_mz.$i { from: bx, by; size: bw, bh; cursor: grab; active: (disp_b.$i.on) and (by + (bh) / 2) - disp.off > sby and (by + (bh) / 2) - disp.off < sby + 456 * pu }
                on press disp_mz.$i { disp_grab_i = i; disp_px = (pointer.x - cvx) / pu; disp_py = (pointer.y - (cvy - disp.off)) / pu; emit disp_grab }
                on drag disp_mz.$i { disp_px = (pointer.x - cvx) / pu; disp_py = (pointer.y - (cvy - disp.off)) / pu; emit disp_drag }
                on release disp_mz.$i { emit disp_drop }
            }

            //  ── Card two: the inspector ──
            box { at: spx + 219 * pu, dtop + 156 * pu; size: 438 * pu, 312 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "INSPECTOR" { at: floor(spx + 14 * pu + 0.5), floor(dtop + 13 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            repeat i in 0..4 {
                let pxx = spx + 424 * pu - 30 * pu - i * 64 * pu
                box { at: pxx, dtop + 13 * pu; size: 58 * pu, 20 * pu; corner: 10 * pu; color: if(disp_sel == 3 - i, mint, ink); opacity: if(disp_pill.$i.on, if(disp_sel == 3 - i, 24%, 8% + 10% * disp_pill_hit.$i.hover), 0%) }
                text disp_pill.$i.text { at: floor(pxx + 0.5), floor(dtop + 13 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 600; width: 54 * pu; lines: 1; color: if(disp_sel == 3 - i, mint, ink); show: disp_pill.$i.on; family: "Space Grotesk" }
                zone box disp_pill_hit.$i { at: pxx, dtop + 13 * pu; size: 60 * pu, 22 * pu; corner: 11 * pu; cursor: pointer; active: (disp_pill.$i.on) and (dtop + 13 * pu) - disp.off > sby and (dtop + 13 * pu) - disp.off < sby + 456 * pu }
                on press disp_pill_hit.$i { emit disp_pick_mon(3 - i) }
            }
            text disp_title { at: floor(spx + 14 * pu + 0.5), floor(dtop + 36 * pu + 0.5); anchor: left center; size: 17.5; weight: 700; color: ink; family: "Space Grotesk" }
            text disp_desc { at: floor(spx + 14 * pu + 0.5), floor(dtop + 52 * pu + 0.5); anchor: left center; size: 13.5; width: 410 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            text disp_cur { at: floor(spx + 14 * pu + 0.5), floor(dtop + 67 * pu + 0.5); anchor: left center; size: 13.5; width: 410 * pu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk" }

            //  Resolution: a dropdown of what the monitor offers, biggest first (the list itself is drawn last, below).
            text "Resolution" { at: floor(spx + 14 * pu + 0.5), floor(dtop + 98 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            let rtw = disp_rw.width + 44 * pu                 // the trigger: its text and room for the chevron
            let rx0 = spx + 122 * pu                          // its left edge: the one every control below starts at, like the sliders
            box { from: rx0, dtop + 85 * pu; size: rtw, 26 * pu; corner: 13 * pu; color: ink; opacity: 8% + 8% * disp_res_hit.hover + 6% * disp_dd }
            box { from: rx0, dtop + 85 * pu; size: rtw, 26 * pu; corner: 13 * pu; stroke: 1.2 * pu; color: mint; opacity: 70% * disp_dd }
            text disp_res_text { at: floor(rx0 + 16 * pu + 0.5), floor(dtop + 98 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: ink; measure: disp_rw; family: "Space Grotesk" }
            path { at: rx0 + rtw - 17 * pu, dtop + 98 * pu; stroke: 1.6 * pu; color: ink; opacity: 60% + 40% * disp_res_hit.hover; move -4 * pu, (-2 + 4 * disp_dd) * pu; line 0, (2 - 4 * disp_dd) * pu; line 4 * pu, (-2 + 4 * disp_dd) * pu }
            zone box disp_res_hit { from: rx0, dtop + 85 * pu; size: rtw, 26 * pu; corner: 13 * pu; cursor: pointer; active: (disp_res_count > 1) and (dtop + 85 * pu + (26 * pu) / 2) - disp.off > sby and (dtop + 85 * pu + (26 * pu) / 2) - disp.off < sby + 456 * pu }
            on press disp_res_hit { toggle disp_res_open }

            //  Refresh rate: the rates this resolution has.
            text "Refresh rate" { at: floor(spx + 14 * pu + 0.5), floor(dtop + 130 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            repeat i in 0..6 {
                let hx = spx + 148 * pu + i * 56 * pu                // 122 + half a chip: the shared left edge
                box { at: hx, dtop + 130 * pu; size: 52 * pu, 24 * pu; corner: 12 * pu; color: if(disp_hz.$i.lit, mint, ink); opacity: if(disp_hz.$i.on, if(disp_hz.$i.lit, 24%, 8% + 10% * disp_hz_hit.$i.hover), 0%) }
                text disp_hz.$i.text { at: floor(hx + 0.5), floor(dtop + 130 * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 50 * pu; lines: 1; color: if(disp_hz.$i.lit, mint, ink); show: disp_hz.$i.on; family: "Space Grotesk" }
                zone box disp_hz_hit.$i { at: hx, dtop + 130 * pu; size: 54 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (disp_hz.$i.on) and (dtop + 130 * pu) - disp.off > sby and (dtop + 130 * pu) - disp.off < sby + 456 * pu }
                on press disp_hz_hit.$i { emit disp_pick_hz(i) }
            }

            //  Scale.
            text "Scale" { at: floor(spx + 14 * pu + 0.5), floor(dtop + 162 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            repeat i in 0..7 {
                let sx = spx + 142 * pu + i * 44 * pu
                box { at: sx, dtop + 162 * pu; size: 40 * pu, 24 * pu; corner: 12 * pu; color: if(disp_scale == i, mint, ink); opacity: if(disp_scale == i, 24%, 8% + 10% * disp_sc_hit.$i.hover) }
                text pick(i, "Auto", "1.0×", "1.25×", "1.33×", "1.5×", "1.75×", "2.0×") { at: floor(sx + 0.5), floor(dtop + 162 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 600; width: 38 * pu; lines: 1; color: if(disp_scale == i, mint, ink); family: "Space Grotesk" }
                zone box disp_sc_hit.$i { at: sx, dtop + 162 * pu; size: 42 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (dtop + 162 * pu) - disp.off > sby and (dtop + 162 * pu) - disp.off < sby + 456 * pu }
                on press disp_sc_hit.$i { emit disp_pick_scale(i) }
            }

            //  Rotation.
            text "Rotation" { at: floor(spx + 14 * pu + 0.5), floor(dtop + 194 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            repeat i in 0..4 {
                let rx = spx + 152 * pu + i * 66 * pu
                box { at: rx, dtop + 194 * pu; size: 60 * pu, 24 * pu; corner: 12 * pu; color: if(disp_rot == i, mint, ink); opacity: if(disp_rot == i, 24%, 8% + 10% * disp_rot_hit.$i.hover) }
                text pick(i, "Normal", "90°", "180°", "270°") { at: floor(rx + 0.5), floor(dtop + 194 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 600; width: 56 * pu; lines: 1; color: if(disp_rot == i, mint, ink); family: "Space Grotesk" }
                zone box disp_rot_hit.$i { at: rx, dtop + 194 * pu; size: 62 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (dtop + 194 * pu) - disp.off > sby and (dtop + 194 * pu) - disp.off < sby + 456 * pu }
                on press disp_rot_hit.$i { emit disp_pick_rot(i) }
            }

            //  SDR brightness (1.00 to 2.00) and saturation (0.90 to 1.10), for HDR modes.
            let dsl.x0 = spx + 122 * pu
            let dsl.w = 250 * pu
            let dh = 12 * pu
            text "SDR brightness" { at: floor(spx + 14 * pu + 0.5), floor(dtop + 226 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            body { color: deep; rim: 9%; box { at: dsl.x0 + dsl.w / 2, dtop + 226 * pu; size: dsl.w, dh; corner: dh / 2 } }
            group {
                glow: 6 * pu, 50%, mint
                body { gradient: dsl.x0, 0 to dsl.x0 + dsl.w, 0, mintlo, mint 55%, minthi; rim: 22%; box { from: dsl.x0, dtop + 226 * pu - dh / 2; size: max(0.1, dsl.w * clamp(disp_sdrb - 1, 0, 1)), dh; corner: dh / 2 } }
            }
            text disp_sdrb_text { at: floor(spx + 424 * pu + 0.5), floor(dtop + 226 * pu + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
            zone box disp_sdrb_hit { at: dsl.x0 + dsl.w / 2, dtop + 226 * pu; size: dsl.w + 24 * pu, 30 * pu; cursor: pointer; active: (dtop + 226 * pu) - disp.off > sby and (dtop + 226 * pu) - disp.off < sby + 456 * pu }
            on press disp_sdrb_hit { emit disp_sdrb_set(clamp((pointer.x - dsl.x0) / dsl.w, 0, 1)) }
            on drag disp_sdrb_hit { emit disp_sdrb_set(clamp((pointer.x - dsl.x0) / dsl.w, 0, 1)) }
            text "SDR saturation" { at: floor(spx + 14 * pu + 0.5), floor(dtop + 256 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            body { color: deep; rim: 9%; box { at: dsl.x0 + dsl.w / 2, dtop + 256 * pu; size: dsl.w, dh; corner: dh / 2 } }
            group {
                glow: 6 * pu, 50%, mint
                body { gradient: dsl.x0, 0 to dsl.x0 + dsl.w, 0, mintlo, mint 55%, minthi; rim: 22%; box { from: dsl.x0, dtop + 256 * pu - dh / 2; size: max(0.1, dsl.w * clamp((disp_sdrs - 0.9) / 0.2, 0, 1)), dh; corner: dh / 2 } }
            }
            text disp_sdrs_text { at: floor(spx + 424 * pu + 0.5), floor(dtop + 256 * pu + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
            zone box disp_sdrs_hit { at: dsl.x0 + dsl.w / 2, dtop + 256 * pu; size: dsl.w + 24 * pu, 30 * pu; cursor: pointer; active: (dtop + 256 * pu) - disp.off > sby and (dtop + 256 * pu) - disp.off < sby + 456 * pu }
            on press disp_sdrs_hit { emit disp_sdrs_set(clamp((pointer.x - dsl.x0) / dsl.w, 0, 1)) }
            on drag disp_sdrs_hit { emit disp_sdrs_set(clamp((pointer.x - dsl.x0) / dsl.w, 0, 1)) }

            //  The bottom row: what it says while nothing is on trial (and Reset, Apply), and while something is
            //  (and Keep, Revert): the question is here, where the eyes are after pressing Apply.
            text disp_msg { at: floor(spx + 14 * pu + 0.5), floor(dtop + 286 * pu + 0.5); anchor: left center; size: 13.5; width: 250 * pu; lines: 1; color: mint; show: disp_trial <= 0; family: "Space Grotesk" }
            text "HDR is experimental in Hyprland: some apps look washed out." { at: floor(spx + 14 * pu + 0.5), floor(dtop + 300 * pu + 0.5); anchor: left center; size: 12; width: 300 * pu; lines: 1; color: faint; opacity: 80%; show: disp_trial <= 0; family: "Space Grotesk" }
            box { at: spx + 314 * pu, dtop + 294 * pu; size: 56 * pu, 24 * pu; corner: 12 * pu; color: ink; opacity: if(disp_trial <= 0, 8% + 10% * disp_reset_hit.hover, 0%) }
            text "Reset" { at: floor(spx + 314 * pu + 0.5), floor(dtop + 294 * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: ink; opacity: 85%; show: disp_trial <= 0; family: "Space Grotesk" }
            zone box disp_reset_hit { at: spx + 314 * pu, dtop + 294 * pu; size: 58 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (disp_trial <= 0) and (dtop + 294 * pu) - disp.off > sby and (dtop + 294 * pu) - disp.off < sby + 456 * pu }
            on press disp_reset_hit { emit disp_reset }
            box { at: spx + 384 * pu, dtop + 294 * pu; size: 64 * pu, 24 * pu; corner: 12 * pu; color: mint; opacity: if(disp_trial <= 0, (35% + 65% * if(disp_dirty, 1, 0)) * (85% + 15% * disp_apply_hit.hover), 0%) }
            text "Apply" { at: floor(spx + 384 * pu + 0.5), floor(dtop + 294 * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; color: onmint; show: disp_trial <= 0; family: "Space Grotesk" }
            zone box disp_apply_hit { at: spx + 384 * pu, dtop + 294 * pu; size: 66 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (disp_trial <= 0 and disp_dirty) and (dtop + 294 * pu) - disp.off > sby and (dtop + 294 * pu) - disp.off < sby + 456 * pu }
            on press disp_apply_hit { emit disp_apply }
            text disp_trial_text { at: floor(spx + 14 * pu + 0.5), floor(dtop + 294 * pu + 0.5); anchor: left center; size: 15; weight: 600; width: 250 * pu; lines: 1; color: mint; show: disp_trial > 0; family: "Space Grotesk" }
            box { at: spx + 314 * pu, dtop + 294 * pu; size: 64 * pu, 24 * pu; corner: 12 * pu; color: ink; opacity: if(disp_trial > 0, 8% + 12% * disp_revert_hit.hover, 0%) }
            text "Revert" { at: floor(spx + 314 * pu + 0.5), floor(dtop + 294 * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: ink; show: disp_trial > 0; family: "Space Grotesk" }
            zone box disp_revert_hit { at: spx + 314 * pu, dtop + 294 * pu; size: 66 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (disp_trial > 0) and (dtop + 294 * pu) - disp.off > sby and (dtop + 294 * pu) - disp.off < sby + 456 * pu }
            on press disp_revert_hit { emit disp_revert }
            box { at: spx + 388 * pu, dtop + 294 * pu; size: 64 * pu, 24 * pu; corner: 12 * pu; color: mint; opacity: if(disp_trial > 0, 85% + 15% * disp_keep_hit.hover, 0%) }
            text "Keep" { at: floor(spx + 388 * pu + 0.5), floor(dtop + 294 * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; color: onmint; show: disp_trial > 0; family: "Space Grotesk" }
            zone box disp_keep_hit { at: spx + 388 * pu, dtop + 294 * pu; size: 66 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (disp_trial > 0) and (dtop + 294 * pu) - disp.off > sby and (dtop + 294 * pu) - disp.off < sby + 456 * pu }
            on press disp_keep_hit { emit disp_keep }

            //  ── Card three: the profiles ──
            box { at: spx + 219 * pu, ptop + (disp.prows + 106) / 2 * pu; size: 438 * pu, (disp.prows + 106) * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "PROFILES" { at: floor(spx + 14 * pu + 0.5), floor(ptop + 13 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text "Reapply when these displays are connected" { at: floor(spx + 350 * pu + 0.5), floor(ptop + 13 * pu + 0.5); anchor: right center; size: 13; color: faint; family: "Space Grotesk" }
            body { color: mix(off, mint, disp_auto_pill); box { at: spx + 405 * pu, ptop + 13 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu } }
            box { at: spx + 397 * pu + disp_auto_pill * 16 * pu, ptop + 13 * pu; size: (17 + 9 * clamp(4 * disp_auto_pill * (1 - disp_auto_pill), 0, 1)) * pu, (17 - 3 * clamp(4 * disp_auto_pill * (1 - disp_auto_pill), 0, 1)) * pu; corner: (8.5 - 1.5 * clamp(4 * disp_auto_pill * (1 - disp_auto_pill), 0, 1)) * pu; color: ink }
            zone box disp_auto_hit { at: spx + 405 * pu, ptop + 13 * pu; size: 46 * pu, 30 * pu; cursor: pointer; active: (ptop + 13 * pu) - disp.off > sby and (ptop + 13 * pu) - disp.off < sby + 456 * pu }
            on press disp_auto_hit { emit disp_auto_toggle }
            text "Connected now: {disp_topo}" { at: floor(spx + 14 * pu + 0.5), floor(ptop + 36 * pu + 0.5); anchor: left center; size: 14; width: 410 * pu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
            text "No saved profiles yet" { at: floor(spx + 219 * pu + 0.5), floor(ptop + 74 * pu + 0.5); anchor: center; size: 15; color: faint; opacity: 1 - clamp(disp_pn_s, 0, 1); show: disp_pcount < 1; family: "Space Grotesk" }
            repeat i in 0..4 {
                let ry = ptop + 62 * pu + i * 30 * pu
                let rowon = clamp(disp_pn_s - i, 0, 1)
                box { at: spx + 219 * pu, ry + 13 * pu; size: 410 * pu, 26 * pu; corner: 10 * pu; color: ink; opacity: if(disp_p.$i.on, 6% + 6% * disp_p.$i.active, 0%) * rowon }
                ellipse { at: spx + 30 * pu, ry + 13 * pu; radius: 3 * pu; color: mint; opacity: if(disp_p.$i.on and disp_p.$i.active, 100%, 0%) }
                text disp_p.$i.name { at: floor(spx + 42 * pu + 0.5), floor(ry + 13 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; width: 130 * pu; lines: 1; color: ink; show: disp_p.$i.on; family: "Space Grotesk" }
                text disp_p.$i.sub { at: floor(spx + 180 * pu + 0.5), floor(ry + 13 * pu + 0.5); anchor: left center; size: 13.5; width: 150 * pu; lines: 1; color: faint; show: disp_p.$i.on; family: "Space Grotesk" }
                box { at: spx + 355 * pu, ry + 13 * pu; size: 52 * pu, 20 * pu; corner: 10 * pu; color: mint; opacity: if(disp_p.$i.on, 16% + 14% * disp_pa_hit.$i.hover, 0%) }
                text "Apply" { at: floor(spx + 355 * pu + 0.5), floor(ry + 13 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 600; color: mint; show: disp_p.$i.on; family: "Space Grotesk" }
                zone box disp_pa_hit.$i { at: spx + 355 * pu, ry + 13 * pu; size: 54 * pu, 22 * pu; corner: 11 * pu; cursor: pointer; active: (disp_p.$i.on and disp_trial <= 0) and (ry + 13 * pu) - disp.off > sby and (ry + 13 * pu) - disp.off < sby + 456 * pu }
                on press disp_pa_hit.$i { emit disp_profile_apply(i) }
                line { from: spx + 400.5 * pu, ry + 9.5 * pu; to: spx + 407.5 * pu, ry + 16.5 * pu; width: 1.4 * pu; color: ink; opacity: if(disp_p.$i.on, 45% + 45% * disp_pd_hit.$i.hover, 0%) }
                line { from: spx + 407.5 * pu, ry + 9.5 * pu; to: spx + 400.5 * pu, ry + 16.5 * pu; width: 1.4 * pu; color: ink; opacity: if(disp_p.$i.on, 45% + 45% * disp_pd_hit.$i.hover, 0%) }
                zone box disp_pd_hit.$i { at: spx + 404 * pu, ry + 13 * pu; size: 22 * pu, 22 * pu; corner: 11 * pu; cursor: pointer; active: (disp_p.$i.on) and (ry + 13 * pu) - disp.off > sby and (ry + 13 * pu) - disp.off < sby + 456 * pu }
                on press disp_pd_hit.$i { emit disp_profile_delete(i) }
            }
            box { at: spx + 130 * pu, ptop + (62 + disp.prows + 21) * pu; size: 232 * pu, 26 * pu; corner: 13 * pu; color: ink; opacity: 8% }
            input disp_profile_name { at: floor(spx + 26 * pu + 0.5), floor(ptop + (62 + disp.prows + 15.5) * pu + 0.5); width: 210 * pu; size: 15; color: ink; family: "Space Grotesk"; placeholder: "Name for the current arrangement" }
            box { at: spx + 350 * pu, ptop + (62 + disp.prows + 21) * pu; size: 106 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: 85% + 15% * disp_save_hit.hover }
            text "Save current" { at: floor(spx + 350 * pu + 0.5), floor(ptop + (62 + disp.prows + 21) * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; color: onmint; family: "Space Grotesk" }
            zone box disp_save_hit { at: spx + 350 * pu, ptop + (62 + disp.prows + 21) * pu; size: 108 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: (ptop + (62 + disp.prows + 21) * pu) - disp.off > sby and (ptop + (62 + disp.prows + 21) * pu) - disp.off < sby + 456 * pu }
            on press disp_save_hit { emit disp_profile_save }

            //  ── The resolution dropdown, drawn last so its rows win the press over everything under it ──
            zone box disp_res_catch { at: spx + 219 * pu, dtop + 156 * pu; size: 438 * pu, 312 * pu; active: (disp_res_open) and (dtop + 156 * pu) - disp.off > sby and (dtop + 156 * pu) - disp.off < sby + 456 * pu }
            on press disp_res_catch { disp_res_open = false }
            group {
                show: disp_dd > 0.02
                opacity: disp_dd
                move: 0, (disp_dd - 1) * 6 * pu
                let rdh = (disp_res_count * 24 + 10) * pu
                let rdw = max(rtw, (disp_res_chars * 7.4 + 34) * pu)   // its longest option, and never narrower than the trigger
                body {
                    color: panel
                    rim: 12%
                    shadow: 0, 6 * pu, 18 * pu, 40%, #000000
                    box { at: rx0 + rdw / 2, dtop + 116 * pu + rdh / 2; size: rdw, rdh; corner: 14 * pu }
                }
                repeat i in 0..14 {
                    let ry = dtop + 116 * pu + 5 * pu + i * 24 * pu + 12 * pu
                    box { at: rx0 + rdw / 2, ry; size: rdw - 10 * pu, 22 * pu; corner: 11 * pu; color: if(disp_r.$i.lit, mint, ink); opacity: if(disp_r.$i.on, if(disp_r.$i.lit, 24%, 0%) + 10% * disp_rr_hit.$i.hover, 0%) }
                    text disp_r.$i.text { at: floor(rx0 + 16 * pu + 0.5), floor(ry + 0.5); anchor: left center; size: 15.5; weight: 600; width: rdw - 24 * pu; lines: 1; color: if(disp_r.$i.lit, mint, ink); show: disp_r.$i.on; family: "Space Grotesk" }
                    zone box disp_rr_hit.$i { at: rx0 + rdw / 2, ry; size: rdw - 8 * pu, 24 * pu; corner: 12 * pu; cursor: pointer; active: (disp_r.$i.on and disp_res_open) and (ry) - disp.off > sby and (ry) - disp.off < sby + 456 * pu }
                    on press disp_rr_hit.$i { emit disp_pick_res(i); disp_res_open = false }
                }
            }
            }

            //  The scrollbar: a thumb as tall as the viewport is of the page, shown when there is something to scroll to.
            let thh = 456 * 456 / max(456, disp.h)
            let thy = thh / 2 + disp.sc / max(1, disp.h - 456) * (456 - thh)
            box { at: spx + 442 * pu, sby + 228 * pu; size: 3 * pu, 456 * pu; corner: 1.5 * pu; color: ink; opacity: if(disp.h > 456, 6%, 0%) }
            box { at: spx + 442 * pu, sby + thy * pu; size: 3 * pu, thh * pu; corner: 1.5 * pu; color: mint; opacity: if(disp.h > 456, 55%, 0%) }
            //  The cue that there is more below: the page fades into the panel and a small "More" pill bobs at the
            //  foot of the view. It goes away at the end of the page, and pressing it scrolls a screenful down.
            let cue = clamp((disp.h - 456 - disp.sc) / 24, 0, 1)
            let cuey = sby + (456 - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (400 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * cue }
            }
            box { at: spx + 224 * pu, cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * cue }
            box { at: spx + 224 * pu, cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * disp_cue_hit.hover) * cue }
            path { at: spx + 204 * pu, cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            text "More" { at: floor(spx + 232 * pu + 0.5), floor(cuey + 0.5); anchor: center; size: 15; weight: 700; color: ink; opacity: cue; family: "Space Grotesk" }
            zone box disp_cue_hit { at: spx + 224 * pu, sby + (456 - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: cue > 0.5 }
            on press disp_cue_hit { disp_scroll_to = clamp(disp_scroll_to + 342, 0, max(0, disp.h - 456)) }
            zone box disp_bar_hit { at: spx + 442 * pu, sby + 228 * pu; size: 14 * pu, 456 * pu; cursor: pointer; active: disp.h > 456 }
            on press disp_bar_hit { disp_scroll_to = clamp(((pointer.y - sby) / pu - thh / 2) / max(1, 456 - thh) * (disp.h - 456), 0, max(0, disp.h - 456)) }
            on drag disp_bar_hit { disp_scroll_to = clamp(((pointer.y - sby) / pu - thh / 2) / max(1, 456 - thh) * (disp.h - 456), 0, max(0, disp.h - 456)) }
        }
    }
    prop volume_level = 0 ~calm
    follow volume_level = if(audio.muted, 0, audio.volume)
    prop bright_level = 0 ~calm
    follow bright_level = brightness.level
    // ── dismissing the panel ─────────────────────────────────────
    //  Escape closes it. The scene only asks for the keyboard while the panel is
    //  open (see `surface`), so typing goes to your apps the rest of the time.
    on key Down while panel == launch { emit launch_move(1) }
    on key Up while panel == launch { emit launch_move(-1) }
    on key Tab while panel == launch { emit launch_move(1) }
    on key Ctrl+n while panel == launch { emit launch_move(1) }
    on key Ctrl+p while panel == launch { emit launch_move(-1) }
    on key Shift+Delete while panel == launch { emit launch_delsel }
    on submit lq { emit launch_run }
    on key Escape while dd_open { dd_open = false }
    on key Escape while panel != none and not dd_open { panel = none }

    //  ── the wallpaper picker ─────────────────────────────────────
    //  The tray hangs under the bar. Which layout fits N hexagons best (the biggest ones that still fit the tray) is worked out here,
    //  from a few column counts around the one that N and the tray's shape suggest.
    let g.n = max(1, wp_picker.count)
    let g.aw = min(screen.width - 168, 2400)              // the room for the hexagons
    let g.ah = vh - 260                        // and the height: the bar above, the foot below, some air
    let g.c0 = floor(g.aw / (1.7321 * sqrt(g.aw * g.ah / (2.6 * g.n))))
    let g.c1 = max(1, min(g.n, g.c0 - 2))
    let g.c2 = max(1, min(g.n, g.c0 - 1))
    let g.c3 = max(1, min(g.n, g.c0))
    let g.c4 = max(1, min(g.n, g.c0 + 1))
    let g.c5 = max(1, min(g.n, g.c0 + 2))
    let g.r1 = min(g.aw / (1.7321 * (g.c1 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c1 - 1) / g.c1) - 1) + 2))
    let g.r2 = min(g.aw / (1.7321 * (g.c2 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c2 - 1) / g.c2) - 1) + 2))
    let g.r3 = min(g.aw / (1.7321 * (g.c3 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c3 - 1) / g.c3) - 1) + 2))
    let g.r4 = min(g.aw / (1.7321 * (g.c4 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c4 - 1) / g.c4) - 1) + 2))
    let g.r5 = min(g.aw / (1.7321 * (g.c5 + 0.5)), g.ah / (1.5 * (floor((g.n + g.c5 - 1) / g.c5) - 1) + 2))
    let g.rb = max(max(max(g.r1, g.r2), max(g.r3, g.r4)), g.r5)
    let g.cols = if(g.r1 == g.rb, g.c1, if(g.r2 == g.rb, g.c2, if(g.r3 == g.rb, g.c3, if(g.r4 == g.rb, g.c4, g.c5))))
    let g.R = min(g.rb, 120)                              // a hexagon's radius, corner to middle
    let g.w = 1.7321 * g.R
    let g.rows = floor((g.n + g.cols - 1) / g.cols)
    let g.gw = (g.cols + 0.5) * g.w
    let g.gh = (g.rows - 1) * 1.5 * g.R + 2 * g.R
    let g.x0 = cx - g.gw / 2
    //  Round the hovered hexagon the others give way: they are pushed outwards (by K, most at about a tile's distance and not at all far
    //  off) and the ring next to it shrinks a little. The hovered one grows on its own spring (`gt`). `sg` is how far this reaches.
    let g.K = 0.55 * clamp(wp_picker_hs, 0, 1.1)
    let g.sg = 1.5 * g.w
    follow wp_picker_tx = clamp((cursor.x - wp_picker_lx) / (1.732 * g.R * 0.93 * (1 + 0.8 * wp_picker_hs)), -0.6, 0.6)
    follow wp_picker_ty = clamp((cursor.y - wp_picker_ly) / (2 * g.R * 0.93 * (1 + 0.8 * wp_picker_hs)), -0.6, 0.6)
    let g.y0 = yo + (vh - g.gh - 60) / 2             // centred on the screen (the foot line takes 60 below the hexagons)

    group {
        show: wp_picker_show > 0.01
        opacity: wp_picker_show * wp_picker_veil
        //  Behind the tiles, a plain dark sheet over the whole surface (a shape, not a glass body: those were what made the picker slow), so that
        //  nothing of what is under shows through.
        box { at: screen.width / 2, screen.height / 2; size: screen.width, screen.height; color: #05070d; opacity: 88% }
        repeat i in 0..200 {
            let grow = floor(i / g.cols)
            let bx = g.x0 + g.w * (i - grow * g.cols + 0.5 + 0.5 * mod(grow, 2))
            let by = g.y0 + g.R + grow * 1.5 * g.R
            let hv = wp_picker_z.$i.hover
            let cu = if(wp_picker.$i.cur, 1, 0)
            let ent = clamp(wp_picker_show * 2.4 - i * 0.008, 0, 1)
            let dxh = bx - wp_picker_lx
            let dyh = by - wp_picker_ly
            let xx = length(dxh, dyh) / g.sg
            let ee = exp(-xx * xx)
            let ring = 1 - 0.26 * clamp(wp_picker_hs, 0, 1) * exp(-pow((xx - 1.25) / 0.6, 2))
            let bxl = wp_picker_lx + dxh * (1 + g.K * ee)              // where the others have been pushed to, to make room
            let byl = wp_picker_ly + dyh * (1 + g.K * ee)
            let gi = gt.$i
            let rr = g.R * 0.93 * (0.6 + 0.4 * ent) * ring * (1 + 0.8 * gi)
            group {
                show: i < g.n and i < wp_picker.count and wp_picker_hot != i
                //  The fade goes on each shape, not on the group: a group with an opacity (or a clip) is drawn in a layer of its own, and the renderer gives only
                //  sixty-four of those a frame, so the lower tiles lost their opacity and the hovered one its tilt. The pictures are already cut to the hexagon.
                let to = ent * if(wp_picker.$i.dim, 25%, 1) 
                //  No blurred shadow under the resting tiles: a hundred and forty blur passes a frame were most of what this page cost. The hovered tile has its own.
                // (a plain path, not a `body`: a body is a layer of its own, and its rectangle's edge showed as a faint line across the small tiles)
                path { at: bxl, byl; color: #05070d; opacity: 30% * to; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
                image wp_picker.$i.img { at: floor(bxl - 0.866 * rr * 124 / 120 + 0.5), floor(byl - rr * 143 / 139 + 0.5); size: floor(1.732 * rr * 124 / 120 + 0.5), floor(2 * rr * 143 / 139 + 0.5); opacity: to }
                path { at: bxl, byl; stroke: 2.6 + 1.6 * cu; color: mix(#ffffff, mint, cu); opacity: (55% + 45% * max(hv, cu)) * to; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
            }
            //  The hovered one: the same tile as liquid glass. Its group's shader adds the light (a soft spot under the pointer, and a band
            //  that sweeps across on arrival), and it stands off the grid on a deeper shadow.
            group {
                show: i < g.n and i < wp_picker.count and wp_picker_hot == i
                shader: liquid, clamp(gi, 0, 1), 22, wp_picker_sw, wp_picker_tx, wp_picker_ty, 0, 0, 0
                //  The hovered tile grows to the large hexagon on its own spring (`gi`), which overshoots a little: that is the bounce.
                opacity: 0.75 + 0.25 * clamp(gi * 4, 0, 1)
                //  Room around the hexagon, so the tilt's perspective has somewhere to reach.
                box { at: bxl, byl; size: 2 * rr + 110, 2 * rr + 110; color: #ffffff; opacity: 0.4% }
                body {
                    color: #05070d
                    opacity: 30%
                    rim: 20%
                    shadow: 0, 20, 40, 80%, #000000
                    path { at: bxl, byl; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
                }
                group {
                    clip path { at: bxl, byl; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
                    image wp_picker.$i.img { at: bxl - 0.866 * rr * 124 / 120, byl - rr * 143 / 139; size: 1.732 * rr * 124 / 120, 2 * rr * 143 / 139 }
                }
                path { at: bxl, byl; stroke: 3.4; color: if(cu > 0, mint, #ffffff); opacity: 95%; move -0.0953 * rr, -0.9450 * rr; curve 0.0953 * rr, -0.9450 * rr via 0, -1 * rr; line 0.7707 * rr, -0.5550 * rr; curve 0.8660 * rr, -0.3900 * rr via 0.866 * rr, -0.5 * rr; line 0.8660 * rr, 0.3900 * rr; curve 0.7707 * rr, 0.5550 * rr via 0.866 * rr, 0.5 * rr; line 0.0953 * rr, 0.9450 * rr; curve -0.0953 * rr, 0.9450 * rr via 0, 1 * rr; line -0.7707 * rr, 0.5550 * rr; curve -0.8660 * rr, 0.3900 * rr via -0.866 * rr, 0.5 * rr; line -0.8660 * rr, -0.3900 * rr; curve -0.7707 * rr, -0.5550 * rr via -0.866 * rr, -0.5 * rr; close }
            }
            //  Its zone is the circle inside the hexagon, as big as the hexagon is now.
            zone box wp_picker_z.$i { at: bxl, byl; size: 1.732 * rr, 1.732 * rr; corner: 0.866 * rr; cursor: pointer; active: i < g.n and i < wp_picker.count and wp_picker_show > 0.5 and wp_picker_leaving == 0 }
            on enter wp_picker_z.$i { wp_picker_hot = i; wp_picker_hx = bx; wp_picker_hy = by }
            on away wp_picker_z.$i for 200ms while wp_picker_hot == i { wp_picker_hot = -1 }
            on press wp_picker_z.$i { wp_picker_px = bxl; wp_picker_py = mh - byl; emit wp_picker_pick(i) }
        }

        //  The foot: the name of the one under the pointer, or a line of help; and Random.
        let fy = g.y0 + g.gh + 36
        text wp_picker_hero_name { at: floor(cx + 0.5), floor(fy + 0.5); anchor: center; align: center; size: 15; weight: 700; width: 640; lines: 1; color: #ffffff; family: "Space Grotesk"; show: wp_picker_hot >= 0 }
        text "Pick a wallpaper  ·  Esc or a click outside closes" { at: floor(cx + 0.5), floor(fy + 0.5); anchor: center; align: center; size: 13; color: #ffffff; opacity: 42%; family: "Space Grotesk"; show: wp_picker_hot < 0 and wp_picker.count > 0 }
        text wp_picker_status { at: floor(cx + 0.5), floor(yo + vh / 2 + 0.5); anchor: center; align: center; size: 16; weight: 600; width: 600; lines: 1; color: #ffffff; opacity: 70%; family: "Space Grotesk"; show: wp_picker.count < 1 }
    }

    //  ── the workspace overview ────────────────────────────────────────────────────────────────────────────────────────────────
    //  Five glass cards in the middle of the screen (in a row, or wrapped on a narrow one), one for each workspace: its number, how many windows it has, and a 16:9
    //  screen on which its windows lie in a grid that grows with their number (one fills it, two sit side by side, up to nine in three by three),
    //  a picture of each. A window
    //  is clicked to go to it, or dragged onto another workspace to move it there; anywhere else on a column goes to the workspace.
    //  The logic fills `ovw`, nine slots a column.
    group {
        show: ov_show > 0.01
        opacity: ov_show
        //  How it fits this screen: five cards in a row if they can be drawn at 85% of their size or more, else three and two,
        //  two by two by one, or one under another (five rows), and whichever it is, scaled (up to a quarter larger than the rest of
        //  the shell) so that it fits with room to spare.
        let ovl.sw = screen.width - 48
        let ovl.sh = vh - 170
        let ovl.k5 = min(1.25, min(ovl.sw / (1506 * u), ovl.sh / (208 * u)))
        let ovl.k3 = min(1.25, min(ovl.sw / (898 * u), ovl.sh / (432 * u)))
        let ovl.k2 = min(1.25, min(ovl.sw / (594 * u), ovl.sh / (656 * u)))
        let ovl.k1 = min(1.25, min(ovl.sw / (290 * u), ovl.sh / (1104 * u)))
        let ovl.nc = if(ovl.k5 >= 0.85, 5, if(ovl.k3 >= 0.85, 3, if(ovl.k2 >= 0.85, 2, 1)))
        let ovl.k = if(ovl.nc == 5, ovl.k5, if(ovl.nc == 3, ovl.k3, if(ovl.nc == 2, ovl.k2, ovl.k1)))
        let ovl.rows = if(ovl.nc == 5, 1, if(ovl.nc == 3, 2, if(ovl.nc == 2, 3, 5)))
        let ovu = u * ovl.k
        let ovl.w = ((ovl.nc - 1) * 304 + 290) * ovu
        let ovl.h = (ovl.rows * 224 - 16) * ovu
        let ovl.cy = floor(yo + vh / 2 + 12 * ovu * (1 - ov_show) + 0.5)
        let ovl.l = floor(cx - ovl.w / 2 + 0.5)
        let ovl.t = floor(ovl.cy - ovl.h / 2 + 0.5)
        let ovl.moving = if(ov_drag >= 0 and length(ov_dx, ov_dy) > 8, 1, 0)
        //  The card under the pointer (-1 when it is off them all), for a drop.
        let ovl.inside = if(cursor.x > ovl.l and cursor.x < ovl.l + ovl.w and cursor.y > ovl.t and cursor.y < ovl.t + ovl.h, 1, 0)
        let ovl.col = if(ovl.inside > 0, clamp(floor((cursor.y - ovl.t) / (224 * ovu)), 0, ovl.rows - 1) * ovl.nc + clamp(floor((cursor.x - ovl.l) / (304 * ovu)), 0, ovl.nc - 1), -1)
        repeat c in 0..5 {
            let ovc.row = floor(c / ovl.nc)
            let ovc.x = floor(ovl.l + (145 + (c - ovc.row * ovl.nc) * 304) * ovu + 0.5)
            let ovc.top = ovl.t + ovc.row * 224 * ovu
            let ovc.act = if(ws.active == c + 1, 1, 0)
            let ovc.drop = if(ovl.moving > 0 and ovl.col == c, 1, 0)
            zone box ov_hz.$c { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu; cursor: pointer; active: ov_show > 0.5 }
            on press ov_hz.$c { ov_open = false; emit ov_go(c + 1) }
            body {
                color: tint
                glass: glass_frost
                opacity: glass_op
                lens: false
                rim: 14%
                shadow: 0, 14 * ovu, 36 * ovu, 45%, deep
                box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu }
            }
            box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu; color: mix(ink, mint, max(ovc.act, ovc.drop)); opacity: 6% + 9% * ovc.act + 14% * ovc.drop + 4% * ov_hz.$c.hover }
            box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu; stroke: 1.4 * ovu; color: mint; opacity: max(50% * ovc.act, 90% * ovc.drop) }
            //  The 16:9 screen the windows lie on.
            box { at: ovc.x, ovc.top + 120 * ovu; size: 270 * ovu, 152 * ovu; corner: 10 * ovu; color: #05070d; opacity: 38% }
            text number(c + 1, 0, "") { at: floor(ovc.x - 128 * ovu + 0.5), floor(ovc.top + 22 * ovu + 0.5); anchor: left center; size: 22 * ovu; weight: 700; color: mix(ink, mint, ovc.act); family: "Space Grotesk" }
            text number(ov_cnt.$c, 0, " windows") { at: floor(ovc.x + 130 * ovu + 0.5), floor(ovc.top + 22 * ovu + 0.5); anchor: right center; align: right; size: 10.5 * ovu; width: 110 * ovu; lines: 1; color: faint; family: "Space Grotesk"; show: ov_cnt.$c != 1 }
            text "1 window" { at: floor(ovc.x + 130 * ovu + 0.5), floor(ovc.top + 22 * ovu + 0.5); anchor: right center; align: right; size: 10.5 * ovu; width: 110 * ovu; lines: 1; color: faint; family: "Space Grotesk"; show: ov_cnt.$c == 1 }
            text "Nothing here" { at: floor(ovc.x + 0.5), floor(ovc.top + 120 * ovu + 0.5); anchor: center; align: center; size: 11.5 * ovu; color: faint; opacity: 70%; family: "Space Grotesk"; show: ov_cnt.$c < 1 }
        }
        repeat n in 0..45 {
            let ovr.c = floor(n / 9)
            let ovr.row = floor(ovr.c / ovl.nc)
            let ovr.col = ovr.c - ovr.row * ovl.nc
            //  The cell this window has in its workspace's grid (the logic says how big the grid is, and which cell), and the
            //  16:9 picture that fits it, in the middle of the cell.
            let ovr.pad = if(ovw.$n.gc == 1, 0, 5 * ovu)
            let ovr.cw = (270 * ovu - 2 * ovr.pad - (ovw.$n.gc - 1) * 5 * ovu) / ovw.$n.gc
            let ovr.ch = (152 * ovu - 2 * ovr.pad - (ovw.$n.gr - 1) * 5 * ovu) / ovw.$n.gr
            let ovr.tw = floor(min(ovr.cw, ovr.ch * 16 / 9) + 0.5)
            let ovr.th = floor(ovr.tw * 9 / 16 + 0.5)
            let ovr.x = floor(ovl.l + (10 + ovr.col * 304) * ovu + ovr.pad + ovw.$n.gx * (ovr.cw + 5 * ovu) + ovr.cw / 2 + 0.5)
            let ovr.y = floor(ovl.t + (44 + ovr.row * 224) * ovu + ovr.pad + ovw.$n.gy * (ovr.ch + 5 * ovu) + ovr.ch / 2 + 0.5)
            let ovr.on = n < ovw.count and ovw.$n.used
            let ovr.lift = if(ov_drag == n and ovl.moving > 0, 0.35, 1)
            group {
                show: ovr.on
                opacity: ovr.lift
                body {
                    color: #05070d
                    opacity: 40%
                    shadow: 0, 2 * ovu, 8 * ovu, 50%, #000000
                    box { at: ovr.x, ovr.y; size: ovr.tw, ovr.th; corner: 6 * ovu }
                }
                group {
                    clip box { at: ovr.x, ovr.y; size: ovr.tw, ovr.th; corner: 6 * ovu }
                    image ovw.$n.thumb { at: ovr.x - ovr.tw / 2, ovr.y - ovr.th / 2; size: ovr.tw, ovr.th; show: ovw.$n.snap }
                    //  No picture taken yet: the app's icon.
                    image ovw.$n.icon { at: floor(ovr.x - 11 * ovu + 0.5), floor(ovr.y - 11 * ovu + 0.5); size: floor(22 * ovu + 0.5), floor(22 * ovu + 0.5); show: not ovw.$n.snap and ovr.tw > 100 * ovu }
                    box { at: ovr.x, ovr.y; size: ovr.tw, ovr.th; color: #ffffff; opacity: 10% * ov_rz.$n.hover }
                }
                box { at: ovr.x, ovr.y; size: ovr.tw, ovr.th; corner: 6 * ovu; stroke: if(ovw.$n.active, 2 * ovu, 1.2 * ovu); color: if(ovw.$n.active, mint, #ffffff); opacity: if(ovw.$n.active, 100%, 16% + 34% * ov_rz.$n.hover) }
            }
            zone box ov_rz.$n { at: ovr.x, ovr.y; size: ovr.tw, ovr.th; corner: 6 * ovu; cursor: pointer; active: ovr.on and ov_show > 0.5 }
            on enter ov_rz.$n { ov_hot = n }
            on away ov_rz.$n for 80ms while ov_hot == n { ov_hot = -1 }
            on press ov_rz.$n { ov_drag = n; ov_dx = 0; ov_dy = 0 }
            on drag ov_rz.$n { ov_dx = drag.dx; ov_dy = drag.dy }
            //  Let go hardly moved: it was a click. Let go far away: it was dropped, on the column under the pointer.
            on release ov_rz.$n while length(ov_dx, ov_dy) < 8 { emit ov_focus(n); ov_open = false }
            on release ov_rz.$n while length(ov_dx, ov_dy) >= 8 { ov_col = ovl.col; emit ov_move(n) }
            on release ov_rz.$n { ov_drag = -1; ov_dx = 0; ov_dy = 0 }
        }
        //  The name of the window under the pointer, or of the one in use, in the header between the number and the count (cut
        //  with an ellipsis where it is too long).
        repeat n in 0..45 {
            let ovt.c = floor(n / 9)
            let ovt.row = floor(ovt.c / ovl.nc)
            let ovt.x = floor(ovl.l + (145 + (ovt.c - ovt.row * ovl.nc) * 304 - 96) * ovu + 0.5)
            let ovt.y = floor(ovl.t + (22 + ovt.row * 224) * ovu + 0.5)
            let ovt.on = n < ovw.count and ovw.$n.used and ovl.moving < 1
            text ovw.$n.title { at: ovt.x, ovt.y; anchor: left center; size: 11.5 * ovu; width: 156 * ovu; lines: 1; color: ink; family: "Space Grotesk"; show: ovt.on and (ov_hot == n or (floor(ov_hot / 9) != ovt.c and ovw.$n.active)) }
        }
        //  The window being carried: a card following the pointer, over everything.
        repeat n in 0..45 {
            let ovg.tw = floor(180 * ovu + 0.5)
            let ovg.th = floor(101 * ovu + 0.5)
            group {
                show: ov_drag == n and ovl.moving > 0
                opacity: 94%
                body {
                    color: #05070d
                    opacity: 40%
                    shadow: 0, 12 * ovu, 26 * ovu, 70%, #000000
                    box { at: cursor.x, cursor.y; size: ovg.tw, ovg.th; corner: 9 * ovu }
                }
                group {
                    clip box { at: cursor.x, cursor.y; size: ovg.tw, ovg.th; corner: 9 * ovu }
                    image ovw.$n.thumb { at: cursor.x - ovg.tw / 2, cursor.y - ovg.th / 2; size: ovg.tw, ovg.th; show: ovw.$n.snap }
                    image ovw.$n.icon { at: floor(cursor.x - 11 * ovu + 0.5), floor(cursor.y - 11 * ovu + 0.5); size: floor(22 * ovu + 0.5), floor(22 * ovu + 0.5); show: not ovw.$n.snap }
                    box { at: cursor.x, cursor.y + ovg.th / 2 - 12 * ovu; size: ovg.tw, 24 * ovu; color: #05070d; opacity: 70% }
                    text ovw.$n.title { at: floor(cursor.x - ovg.tw / 2 + 10 * ovu + 0.5), floor(cursor.y + ovg.th / 2 - 12 * ovu + 0.5); anchor: left center; size: 10.5 * ovu; width: ovg.tw - 20 * ovu; lines: 1; color: #f2f4f2; family: "Space Grotesk" }
                }
                box { at: cursor.x, cursor.y; size: ovg.tw, ovg.th; corner: 9 * ovu; stroke: 2 * ovu; color: mint }
            }
        }
    }

    //  ── the authentication dialog ────────────────────────────────────────────────────────────────────────────────────────────
    //  A card in the bar's glass, in the upper third of the screen, over a dimmed desktop. It is modal: the veil takes every press.
    group {
        show: pk_show > 0.01
        opacity: pk_show
        let pk.cy = yo + vh * 0.34 - 14 * u * (1 - pk_show)
        let pk.x = cx + pk_sk * 14 * u
        let pk.top = pk.cy - 128 * u
        let pk.l = pk.x - 176 * u
        box { at: cx, screen.height / 2; size: screen.width, screen.height; color: #000000; opacity: 34% }
        zone box pk_block { at: cx, screen.height / 2; size: screen.width, screen.height; cursor: pointer }
        body {
            color: tint
            glass: glass_frost
            opacity: glass_op
            lens: false
            rim: 14%
            shadow: 0, 18 * u, 50 * u, 45%, deep
            box { at: pk.x, pk.cy; size: 400 * u, 256 * u; corner: 26 * u }
        }
        zone box pk_card { at: pk.x, pk.cy; size: 400 * u, 256 * u; corner: 26 * u }
        //  A padlock, then the title.
        path { at: pk.l + 12 * u, pk.top + 38 * u; stroke: 1.7 * u; color: mint; move -4 * u, -1 * u; line -4 * u, -5 * u; curve 4 * u, -5 * u via 0, -12 * u; line 4 * u, -1 * u }
        box { at: pk.l + 12 * u, pk.top + 41 * u; size: 15 * u, 11 * u; corner: 3 * u; stroke: 1.7 * u; color: mint }
        text "Authentication required" { at: floor(pk.l + 32 * u + 0.5), floor(pk.top + 38 * u + 0.5); anchor: left center; size: 15 * u; weight: 700; color: ink; family: "Space Grotesk" }
        text pk_message { at: floor(pk.l + 0.5), floor(pk.top + 62 * u + 0.5); anchor: left top; size: 11.5 * u; width: 352 * u; lines: 3; color: ink; opacity: 78%; family: "Space Grotesk" }
        //  Whose password it is.
        ellipse { at: pk.l + 10 * u, pk.top + 132 * u; radius: 9 * u; color: mint; opacity: 24% }
        ellipse { at: pk.l + 10 * u, pk.top + 129 * u; radius: 2.6 * u; color: mint }
        path { at: pk.l + 10 * u, pk.top + 138 * u; stroke: 1.5 * u; color: mint; move -4.5 * u, 0; curve 4.5 * u, 0 via 0, -7 * u }
        text pk_user { at: floor(pk.l + 28 * u + 0.5), floor(pk.top + 132 * u + 0.5); anchor: left center; size: 12 * u; weight: 600; color: ink; family: "Space Grotesk" }
        //  The password field.
        box { at: pk.x, pk.top + 166 * u; size: 352 * u, 38 * u; corner: 13 * u; color: ink; opacity: 8% }
        box { at: pk.x, pk.top + 166 * u; size: 352 * u, 38 * u; corner: 13 * u; stroke: 1.4 * u; color: mint; opacity: 40% + 50% * pk_sk * pk_sk }
        input pk_pw { at: floor(pk.l + 14 * u + 0.5), floor(pk.top + 166 * u - 8 * u + 0.5); width: 324 * u; size: 14 * u; color: ink; family: "Space Grotesk"; placeholder: "Password"; secret: true }
        text pk_error { at: floor(pk.l + 2 * u + 0.5), floor(pk.top + 194 * u + 0.5); anchor: left center; size: 10.5 * u; width: 350 * u; lines: 1; color: mint; family: "Space Grotesk"; show: pk_shake and not pk_busy }
        text "Checking…" { at: floor(pk.l + 2 * u + 0.5), floor(pk.top + 194 * u + 0.5); anchor: left center; size: 10.5 * u; color: faint; family: "Space Grotesk"; show: pk_busy }
        //  Cancel and Authenticate.
        box { at: pk.x - 88 * u, pk.top + 226 * u; size: 172 * u, 32 * u; corner: 14 * u; color: ink; opacity: 8% + 9% * pk_cancel_hit.hover }
        text "Cancel" { at: floor(pk.x - 88 * u + 0.5), floor(pk.top + 226 * u + 0.5); anchor: center; align: center; size: 12 * u; weight: 600; color: ink; family: "Space Grotesk" }
        zone box pk_cancel_hit { at: pk.x - 88 * u, pk.top + 226 * u; size: 174 * u, 34 * u; corner: 15 * u; cursor: pointer }
        on press pk_cancel_hit { pk_open = false }
        box { at: pk.x + 88 * u, pk.top + 226 * u; size: 172 * u, 32 * u; corner: 14 * u; color: mint; opacity: if(pk_busy, 28%, 80% + 20% * pk_ok_hit.hover) }
        text "Authenticate" { at: floor(pk.x + 88 * u + 0.5), floor(pk.top + 226 * u + 0.5); anchor: center; align: center; size: 12 * u; weight: 700; color: onmint; family: "Space Grotesk" }
        zone box pk_ok_hit { at: pk.x + 88 * u, pk.top + 226 * u; size: 174 * u, 34 * u; corner: 15 * u; cursor: pointer; active: not pk_busy }
        on press pk_ok_hit { pk_go = true }
    }

}
