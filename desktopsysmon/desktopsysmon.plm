language 0.1
import "../palette.plm"

//  The desktop system monitor: a small glass card on the bottom layer (above the wallpaper, under every window) with the processor, the memory, the
//  graphics card and the network, a smaller cousin of Settings > System monitor. Its numbers come from `vitreus-sysmon`, which runs only while the
//  card is shown. Its tint is the shell's (`tint` of palette.plm, which Iris keeps), the same as the clock's and the bar's glass.
//
//  Turn it on or off with   pleamar --say desktopsysmon "fact shown true"   (or false).
//  Its settings are kept in desktopsysmon.json, in ~/.local/share/pleamar/desktopsysmon (see desktopsysmon.luau).

scene DesktopSysmon {
    surface { size: 400, 250; anchor: where; margin: 40; level: bottom; screens: all; reserve: -1 }

    permissions {
        services: "files", "files.write"
        run: "vitreus-sysmon"
    }

    fact where: top_left | top | top_right | left | center | right | bottom_left | bottom | bottom_right = bottom_right
    fact shown = false     // the logic sets it from desktopsysmon.json (so that `sh` follows it from nothing)
    fact cli = 1           // the glass: 0 clear, 1 soft, 2 full

    fact cpu_f = 0         // the processor's load, 0..1
    fact mem_f = 0
    fact gpu_on = false    // a graphics card that reports itself
    fact gpu_f = 0
    text host = ""
    text up = ""
    text cpu_txt = "0%"
    text cpu_meta = ""     // 3.2 GHz · 46°C
    text mem_txt = "0%"
    text mem_meta = ""     // 2.5 of 31 GB
    text gpu_txt = "0%"
    text gpu_meta = ""
    text rx_txt = ""
    text tx_txt = ""

    prop sh = 0 ~calm
    follow sh = if(shown, 1, 0)
    prop cpu_p = 0 ~calm
    prop mem_p = 0 ~calm
    prop gpu_p = 0 ~calm
    follow cpu_p = cpu_f
    follow mem_p = mem_f
    follow gpu_p = gpu_f

    let clr = if(cli == 0, 55%, if(cli == 1, 80%, 100%))

    group {
        show: sh > 0.01
        body {
            color: tint
            glass: 1
            lens: false
            rim: 40%
            shine: 0, 0
            shadow: 0, 8, 24, 28%
            opacity: sh * clr
            box { at: 200, 125; size: 360, 210; corner: 22 }
        }
        group {
            opacity: sh
            text host { at: 38, 38; anchor: left center; size: 15; weight: 700; width: 170; lines: 1; color: ink; family: "Space Grotesk" }
            text up { at: 362, 38; anchor: right center; size: 12.5; weight: 500; width: 120; lines: 1; color: faint; family: "Space Grotesk"; align: right }

            arc { at: 100, 128; radius: 42; span: 270deg; width: 9; color: ink; opacity: 9%; rotate: 0deg }
            group {
                glow: 7, 26%
                arc { at: 100, 128; radius: 42; span: (270 * clamp(cpu_p, 0.004, 1)) * 1deg; width: 9; color: mix(mint, alert, clamp((cpu_p - 0.75) / 0.25, 0, 1)); rotate: (-135 + 135 * clamp(cpu_p, 0.004, 1)) * 1deg }
            }
            text cpu_txt { at: 100, 123; anchor: center center; size: 25; weight: 700; width: 70; lines: 1; color: ink; family: "Space Grotesk"; align: center }
            text "CPU" { at: 100, 144; anchor: center center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
            text cpu_meta { at: 100, 186; anchor: center center; size: 12; weight: 500; width: 120; lines: 1; color: faint; family: "Space Grotesk"; align: center }

            text "MEMORY" { at: 176, 74; anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
            text mem_txt { at: 362, 74; anchor: right center; size: 13.5; weight: 600; width: 90; lines: 1; color: ink; family: "Space Grotesk"; align: right }
            box { at: 269, 90; size: 186, 6; corner: 3; color: ink; opacity: 9% }
            box { at: 176 + 93 * clamp(mem_p, 0.02, 1), 90; size: 186 * clamp(mem_p, 0.02, 1), 6; corner: 3; color: mix(mint, alert, clamp((mem_p - 0.85) / 0.15, 0, 1)) }
            text mem_meta { at: 176, 104; anchor: left center; size: 11.5; weight: 500; width: 186; lines: 1; color: faint; family: "Space Grotesk" }

            text "GRAPHICS" { at: 176, 130; anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk"; show: gpu_on }
            text gpu_txt { at: 362, 130; anchor: right center; size: 13.5; weight: 600; width: 90; lines: 1; color: ink; family: "Space Grotesk"; align: right; show: gpu_on }
            box { at: 269, 146; size: 186, 6; corner: 3; color: ink; opacity: 9%; show: gpu_on }
            box { at: 176 + 93 * clamp(gpu_p, 0.02, 1), 146; size: 186 * clamp(gpu_p, 0.02, 1), 6; corner: 3; color: mix(mint, alert, clamp((gpu_p - 0.85) / 0.15, 0, 1)); show: gpu_on }
            text gpu_meta { at: 176, 160; anchor: left center; size: 11.5; weight: 500; width: 186; lines: 1; color: faint; family: "Space Grotesk"; show: gpu_on }

            text "NETWORK" { at: 176, 188; anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
            text rx_txt { at: 268, 188; anchor: left center; size: 12.5; weight: 600; width: 95; lines: 1; color: ink; family: "Space Grotesk" }
            text tx_txt { at: 362, 188; anchor: right center; size: 12.5; weight: 600; width: 95; lines: 1; color: ink; family: "Space Grotesk"; align: right }
        }
    }
}
