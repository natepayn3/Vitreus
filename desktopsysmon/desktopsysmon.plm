language 0.1
import "../palette.plm"

//  The desktop system monitor: glass channels and writing on the bottom layer (above the wallpaper, under every window) with the processor, the memory, the
//  graphics card and the network, a smaller cousin of Settings > System monitor. Its numbers come from `vitreus-sysmon`, which runs only while the
//  card is shown. Its tint is the shell's (`tint` of palette.plm, which Iris keeps), the same as the clock's and the bar's glass.
//
//  Turn it on or off with   pleamar --say desktopsysmon "fact shown true"   (or false).
//  Its settings are kept in desktopsysmon.json, in ~/.local/share/pleamar/desktopsysmon (see desktopsysmon.luau).

scene DesktopSysmon {
    surface { size: 400, 280; anchor: where; margin: 40; level: bottom; screens: all; reserve: -1; rate: 10 }

    permissions {
        services: "files", "files.write"
        run: "vitreus-sysmon", "sh", "pleamar"
    }

    fact where: top_left | top | top_right | left | center | right | bottom_left | bottom | bottom_right = bottom_right
    fact shown = false     // the logic sets it from desktopsysmon.json (so that `sh` follows it from nothing)
    fact cli = 1           // the glass: 0 clear, 1 soft, 2 full

    fact cpu_f = 0         // the processor's load, 0..1
    fact mem_f = 0
    fact gpu_on = false    // a graphics card that reports itself
    fact gpu_f = 0
    text host = ""
    text up = ""
    text cpu_txt = "0%"
    text cpu_meta = ""     // 3.2 GHz · 46°C
    text mem_txt = "0%"
    text mem_meta = ""     // 2.5 of 31 GB
    text gpu_txt = "0%"
    text gpu_meta = ""
    text rx_txt = ""
    text tx_txt = ""
    fact aur_on = false    // the AUR has been asked (once an hour, see the logic) and answered
    text aur_txt = ""      // "3 AUR updates", or "AUR up to date"
    model net_h max 120 { rx: number; tx: number }    // the last minute of the network, smoothed to two columns a second, each against the biggest in view
    fact net_step = 0                                  // one more with every sample: the graph slides by one sample
    fact net_t0 = 0                                    // when the last one arrived (the scene's seconds)
    prop time = 0                                      // our own seconds, which run only while the card is shown (a scene that names `time` otherwise never rests)
    spin time by if(shown, 1, 0)
    on change net_step { net_t0 = time }

    prop sh = 0 ~calm
    follow sh = if(shown, 1, 0)
    fact obs = false        // Vitreus has its glass off: the card is flat obsidian (Vitreus says so with `fact obs true`)
    prop ob = 0 ~calm
    follow ob = if(obs, 1, 0)
    prop cpu_p = 0 ~calm
    prop mem_p = 0 ~calm
    prop gpu_p = 0 ~calm
    follow cpu_p = cpu_f
    follow mem_p = mem_f
    follow gpu_p = gpu_f

    let clr = if(cli == 0, 55%, if(cli == 1, 80%, 100%))

    //  Three rings (the processor, the memory, the graphics card: two when there is no card that reports itself) and the last minute of the network under
    //  them. The rings' tracks and the graph's line are channels of one body of glass (like the clock's digits); what fills them and the writing float over the
    //  wallpaper, with a little shadow to read by.
    let g0 = if(gpu_on, 85, 135)
    let g1 = if(gpu_on, 200, 265)
    let g2 = 315
    let ry = 92
    group {
        show: sh > 0.01
        body {
            color: tint
            glass: 1
            lens: false
            rim: 70%
            shine: 0, 0
            shadow: 0, 6, 18, 30%
            opacity: sh * clr * (1 - ob)
            show: ob < 0.996
            arc { at: g0, ry; radius: 36; span: 270deg; width: 8; rotate: 0deg }
            arc { at: g1, ry; radius: 36; span: 270deg; width: 8; rotate: 0deg }
            arc { at: g2, ry; radius: 36; span: 270deg; width: 8; rotate: 0deg; show: gpu_on }
            box { at: 200, 206; size: 340, 2.4; corner: 1.2 }
        }
        //  Obsidian (Vitreus has its glass off): the same shapes as a flat, dark piece.
        body {
            color: mix(mix(tint, #000000, 0.7), ink, 0.3)
            rim: 0%
            opacity: sh * ob
            shadow: 0, 6, 18, 45%, #000000
            show: ob > 0.004
            arc { at: g0, ry; radius: 36; span: 270deg; width: 8; rotate: 0deg }
            arc { at: g1, ry; radius: 36; span: 270deg; width: 8; rotate: 0deg }
            arc { at: g2, ry; radius: 36; span: 270deg; width: 8; rotate: 0deg; show: gpu_on }
            box { at: 200, 206; size: 340, 2.4; corner: 1.2 }
        }
        group {
            opacity: sh
            text host { at: 30, 30; anchor: left center; size: 17; weight: 700; width: 190; lines: 1; color: ink; family: "Space Grotesk"; shadow: 0, 1, 5, 70% }
            text up { at: 370, 30; anchor: right center; size: 13; weight: 600; width: 120; lines: 1; color: ink; family: "Space Grotesk"; align: right; opacity: 80%; shadow: 0, 1, 5, 70% }
            text aur_txt { at: 212, 30; anchor: center center; size: 12; weight: 600; width: 150; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; align: center; show: aur_on; shadow: 0, 1, 5, 70% }

            group {
                glow: 7, 26%
                arc { at: g0, ry; radius: 36; span: (270 * clamp(cpu_p, 0.004, 1)) * 1deg; width: 8; color: mix(mint, alert, clamp((cpu_p - 0.75) / 0.25, 0, 1)); rotate: (-135 + 135 * clamp(cpu_p, 0.004, 1)) * 1deg }
                arc { at: g1, ry; radius: 36; span: (270 * clamp(mem_p, 0.004, 1)) * 1deg; width: 8; color: mix(mint, alert, clamp((mem_p - 0.85) / 0.15, 0, 1)); rotate: (-135 + 135 * clamp(mem_p, 0.004, 1)) * 1deg }
                arc { at: g2, ry; radius: 36; span: (270 * clamp(gpu_p, 0.004, 1)) * 1deg; width: 8; color: mix(mint, alert, clamp((gpu_p - 0.85) / 0.15, 0, 1)); rotate: (-135 + 135 * clamp(gpu_p, 0.004, 1)) * 1deg; show: gpu_on }
            }
            text cpu_txt { at: g0, ry - 4; anchor: center center; size: 20; weight: 700; width: 60; lines: 1; color: ink; family: "Space Grotesk"; align: center; shadow: 0, 1, 6, 70% }
            text "CPU" { at: g0, ry + 13; anchor: center center; size: 10; weight: 700; color: ink; opacity: 75%; family: "Space Grotesk"; shadow: 0, 1, 5, 70% }
            text cpu_meta { at: g0, 146; anchor: center center; size: 11.5; weight: 600; width: 112; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk"; align: center; shadow: 0, 1, 5, 70% }
            text mem_txt { at: g1, ry - 4; anchor: center center; size: 20; weight: 700; width: 60; lines: 1; color: ink; family: "Space Grotesk"; align: center; shadow: 0, 1, 6, 70% }
            text "MEMORY" { at: g1, ry + 13; anchor: center center; size: 10; weight: 700; color: ink; opacity: 75%; family: "Space Grotesk"; shadow: 0, 1, 5, 70% }
            text mem_meta { at: g1, 146; anchor: center center; size: 11.5; weight: 600; width: 112; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk"; align: center; shadow: 0, 1, 5, 70% }
            text gpu_txt { at: g2, ry - 4; anchor: center center; size: 20; weight: 700; width: 60; lines: 1; color: ink; family: "Space Grotesk"; align: center; show: gpu_on; shadow: 0, 1, 6, 70% }
            text "GRAPHICS" { at: g2, ry + 13; anchor: center center; size: 10; weight: 700; color: ink; opacity: 75%; family: "Space Grotesk"; show: gpu_on; shadow: 0, 1, 5, 70% }
            text gpu_meta { at: g2, 146; anchor: center center; size: 11.5; weight: 600; width: 112; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk"; align: center; show: gpu_on; shadow: 0, 1, 5, 70% }

            text "NETWORK" { at: 30, 172; anchor: left center; size: 11; weight: 700; color: ink; opacity: 75%; family: "Space Grotesk"; shadow: 0, 1, 5, 70% }
            text rx_txt { at: 140, 172; anchor: left center; size: 12.5; weight: 700; width: 112; lines: 1; color: ink; family: "Space Grotesk"; shadow: 0, 1, 5, 70% }
            text tx_txt { at: 370, 172; anchor: right center; size: 12.5; weight: 700; width: 112; lines: 1; color: mix(mint, ink, 0.4); family: "Space Grotesk"; align: right; shadow: 0, 1, 5, 70% }
            //  The columns are close enough (and smoothed in the logic) to read as one curve; the whole graph slides left as each sample arrives.
            //  The slide is linear, a sample's width in a second, and the newest sample comes in from beyond the edge (clipped), so it never pops in.
            group {
                clip box { at: 200, 206; size: 344, 80 }
                group {
                    move: (1 - clamp(time - net_t0, 0, 1)) * 5.67, 0
                    repeat i in 0..120 {
                        let k = i + 120 - net_h.count
                        let dh = max(1.2, clamp(net_h.$i.rx, 0, 1) * 26)
                        let uh = max(1.2, clamp(net_h.$i.tx, 0, 1) * 22)
                        box { at: 31.4 + (k + 0.5) * 2.835, 205 - dh / 2; size: 2.6, dh; corner: 1.2; color: mint; opacity: (25% + 70% * k / 120); show: i < net_h.count }
                        box { at: 31.4 + (k + 0.5) * 2.835, 208 + uh / 2; size: 2.6, uh; corner: 1.2; color: mix(mint, ink, 0.4); opacity: (20% + 55% * k / 120); show: i < net_h.count }
                    }
                }
            }
        }
    }
}
