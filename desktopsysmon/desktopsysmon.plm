            text "System" { at: lx + ox + 14, ly + oy + 16; anchor: left center; size: 12; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 5, 70% * (1 - pl) }
            //  (its monitor is not plugged in: shown here only in Edit mode, to be placed)
            text orph { at: lx + ox + ow - 14, ly + oy + 16; anchor: right center; size: 12; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 5, 70% * (1 - pl); show: orphan }
        }
        SysCard(lx, ly, on)
    }

