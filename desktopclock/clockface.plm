8, if(d0 == 7, 88, if(d0 == 8, 2, if(d0 == 9, 50, 0))))))))))) * kk0; curve (if(d0 == 0, 23, if(d0 == 1, 30, if(d0 == 2, 46, if(d0 == 3, 2, if(d0 == 4, 46, if(d0 == 5, 4, if(d0 == 6, 2, if(d0 == 7, 14, if(d0 == 8, 23, if(d0 == 9, 44, 30000))))))))))) * kk0, (if(d0 == 0, 0, if(d0 == 1, 88, if(d0 == 2, 88, if(d0 == 3, 78, if(d0 == 4, 62, if(d0 == 5, 74, if(d0 == 6, 52, if(d0 == 7, 88, if(d0 == 8, 2, if(d0 == 9, 36, 0))))))))))) * kk0 via (if(d0 == 0, 0, if(d0 == 1, 30, if(d0 == 2, 46, if(d0 == 3, 8, if(d0 == 4, 46, if(d0 == 5, 12, if(d0 == 6, 2, if(d0 == 7, 14, if(d0 == 8, 23, if(d0 == 9, 44, 30000))))))))))) * kk0, (if(d0 == 0, 0, if(d0 == 1, 88, if(d0 == 2, 88, if(d0 == 3, 88, if(d0 == 4, 62, if(d0 == 5, 88, if(d0 == 6, 40, if(d0 == 7, 88, if(d0 == 8, 2, if(d0 == 9, 48, 0))))))))))) * kk0 }
            path { at: x0, y0; stroke: sw0; move (if(d0 == 8, 23, 30000)) * kk0, (if(d0 == 8, 42, 0)) * kk0; curve (if(d0 == 8, 45, 30000)) * kk0, (if(d0 == 8, 65, 0)) * kk0 via (if(d0 == 8, 45, 30000)) * kk0, (if(d0 == 8, 42, 0)) * kk0; curve (if(d0 == 8, 23, 30000)) * kk0, (if(d0 == 8, 88, 0)) * kk0 via (if(d0 == 8, 45, 30000)) * kk0, (if(d0 == 8, 88, 0)) * kk0; curve (if(d0 == 8, 1, 30000)) * kk0, (if(d0 == 8, 65, 0)) * kk0 via (if(d0 == 8, 1, 30000)) * kk0, (if(d0 == 8, 88, 0)) * kk0; curve (if(d0 == 8, 23, 30000)) * kk0, (if(d0 == 8, 42, 0)) * kk0 via (if(d0 == 8, 1, 30000)) * kk0, (if(d0 == 8, 42, 0)) * kk0 }
            path { at: x1, y1; stroke: sw1; move (if(d1 == 0, 23, if(d1 == 1, 10, if(d1 == 2, 2, if(d1 == 3, 3, if(d1 == 4, 34, if(d1 == 5, 42, if(d1 == 6, 40, if(d1 == 7, 2, if(d1 == 8, 23, if(d1 == 9, 6, 30000))))))))))) * kk1, (if(d1 == 0, 0, if(d1 == 1, 18, if(d1 == 2, 24, if(d1 == 3, 10, if(d1 == 4, 88, if(d1 == 5, 2, if(d1 == 6, 8, if(d1 == 7, 2, if(d1 == 8, 2, if(d1 == 9, 80, 0))))))))))) * kk1; curve (if(d1 == 0, 46, if(d1 == 1, 30, if(d1 == 2, 23, if(d1 == 3, 23, if(d1 == 4, 34, if(d1 == 5, 8, if(d1 == 6, 22, if(d1 == 7, 44, if(d1 == 8, 41, if(d1 == 9, 24, 30000))))))))))) * kk1, (if(d1 == 0, 23, if(d1 == 1, 0, if(d1 == 2, 0, if(d1 == 3, 0, if(d1 == 4, 0, if(d1 == 5, 2, if(d1 == 6, 0, if(d1 == 7, 2, if(d1 == 8, 22, if(d1 == 9, 88, 0))))))))))) * kk1 via (if(d1 == 0, 46, if(d1 == 1, 20, if(d1 == 2, 2, if(d1 == 3, 8, if(d1 == 4, 34, if(d1 == 5, 25, if(d1 == 6, 34, if(d1 == 7, 23, if(d1 == 8, 41, if(d1 == 9, 12, 30000))))))))))) * kk1, (if(d1 == 0, 0, if(d1 == 1, 9, if(d1 == 2, 0, if(d1 == 3, 0, if(d1 == 4, 44, if(d1 == 5, 2, if(d1 == 6, 0, if(d1 == 7, 2, if(d1 == 8, 2, if(d1 == 9, 88, 0))))))))))) * kk1; curve (if(d1 == 0, 46, if(d1 == 1, 30, if(d1 == 2, 44, if(d1 == 3, 42, if(d1 == 4, 0, if(d1 == 5, 6, if(d1 == 6, 2, if(d1 == 7, 14, if(d1 == 8, 23, if(d1 == 9, 44, 30000))))))))))) * kk1, (if(d1 == 0, 65, if(d1 == 1, 88, if(d1 == 2, 24, if(d1 == 3, 22, if(d1 == 4, 62, if(d1 == 5, 42, if(d1 == 6, 52, if(d1 == 7, 88, if(d1 == 8, 42, if(d1 == 9, 36, 0))))))))))) * kk1 via (if(d1 == 0, 46, if(d1 == 1, 30, if(d1 == 2, 44, if(d1 == 3, 42, if(d1 == 4, 17, if(d1 == 5, 7, if(d1 == 6, 2, if(d1 == 7, 29, if(d1 == 8, 41, if(d1 == 9, 44, 30000))))))))))) * kk1, (if(d1 == 0, 44, if(d1 == 1, 44, if(d1 == 2, 0, if(d1 == 3, 0, if(d1 == 4, 31, if(d1 == 5, 22, if(d1 == 6, 0, if(d1 == 7, 45, if(d1 == 8, 42, if(d1 == 9, 88, 0))))))))))) * kk1; curve (if(d1 == 0, 23, if(d1 == 1, 30, if(d1 == 2, 29, if(d1 == 3, 22, if(d1 == 4, 46, if(d1 == 5, 26, if(d1 == 6, 23, if(d1 == 7, 14, if(