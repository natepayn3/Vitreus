language 0.1

//  The clock face of the desktop clock, and of the layout badges in Vitreus Settings: the time as glass digits. Each digit is a single stroke (a
//  centre-line, `sw` thick) with one path per digit place whose points are worked out from the digit, so that there are few shapes in the glass: its
//  cost when it changes (fading in, say) grows with them. The dividers (a bar, an outline, a slash) are a shape each, moved far away when the layout has
//  none.
//
//  ClockFace(k, lay, d0, d1, d2, d3, cx, cy, tint, gl, rimv, op, wt): `k` is the scale (a digit is 88 * k tall), `lay` the layout:
//    0 pipe      12 | 34      a tall bar between the hour and the minutes
//    1 rule      12 over 34   with a line between
//    2 tower     1 2 3 4      the four digits in a narrow column, with a line in the middle
//    3 digital   12:34        with a colon
//    4 slash     12 at the top left, 34 at the bottom right, and a slash between them
//    5 hero      a big hour, a line, and small minutes under it
//  `d0`..`d3` are the digits (`d0` is -1 when the hour has no tens), `cx`, `cy` the middle of the whole face, `tint` its colour, `gl` how much glass it
//  is (0 to 1; 0 is a flat piece with an edge light, for the small badges), `rimv` the edge light, `op` its opacity and `wt` how thick the strokes are
//  (1 is the normal one). It draws its own body, and the glass never bends what is behind it: the compositor blurs it, which costs almost nothing.

library ClockFace {
    component ClockFace(k: number, lay: number, d0: number, d1: number, d2: number, d3: number, cx: number, cy: number, tint: color, gl: number, rimv: number, op: number, wt: number) {
        let m01 = if(lay == 2, 0.6, 1)            // the tower is smaller, to fit
        let m23 = if(lay == 2, 0.6, if(lay == 5, 0.5, 1))   // and the hero's minutes are half the size
        let kk0 = k * m01
        let kk1 = k * m01
        let kk2 = k * m23
        let kk3 = k * m23
        let sw0 = 13 * wt * kk0
        let sw1 = 13 * wt * kk1
        let sw2 = 13 * wt * kk2
        let sw3 = 13 * wt * kk3
        let hi = if(d0 < 0, 0 - 38 * k, 0)        // no tens in the hour: what is left is still centred (in the layouts where that is the thing to centre)
        let x0 = if(lay == 0, cx - 149 * k, if(lay == 1, cx - 61 * k + hi, if(lay == 2, cx - 13.8 * k, if(lay == 3, cx - 152 * k + hi, if(lay == 4, cx - 130 * k, cx - 61 * k + hi)))))
        let x1 = if(lay == 0, x0 + 76 * k, if(lay == 1, x0 + 76 * k, if(lay == 2, x0, if(lay == 3, x0 + 76 * k, if(lay == 4, x0 + 76 * k, x0 + 76 * k)))))
        let x2 = if(lay == 0, cx + 27 * k, if(lay == 1, cx - 61 * k, if(lay == 2, cx - 13.8 * k, if(lay == 3, x1 + 106 * k, if(lay == 4, cx + 8 * k, cx)))))
        let x3 = if(lay == 0, x2 + 76 * k, if(lay == 1, x2 + 76 * k, if(lay == 2, x2, if(lay == 3, x2 + 76 * k, if(lay == 4, x2 + 76 * k, x2 + 38 * k)))))
        let y0 = if(lay == 0, cy - 44 * k, if(lay == 1, cy - 111 * k, if(lay == 2, cy - 130.6 * k, if(lay == 3, cy - 44 * k, if(lay == 4, cy - 112 * k, cy - 84 * k)))))
        let y1 = if(lay == 0, y0, if(lay == 1, y0, if(lay == 2, y0 + 64.8 * k, if(lay == 3, y0, if(lay == 4, y0, y0)))))
        let y2 = if(lay == 0, y0, if(lay == 1, cy + 23 * k, if(lay == 2, y1 + 78.8 * k, if(lay == 3, y0, if(lay == 4, cy + 24 * k, cy + 40 * k)))))
        let y3 = if(lay == 0, y2, if(lay == 1, y2, if(lay == 2, y2 + 64.8 * k, if(lay == 3, y2, if(lay == 4, y2, y2)))))
        let ccx = (x1 + 46 * k + x2) / 2
        let cd = if(lay == 3, 0, 30000)            // the colon: only in the digital layout
        //  The bar (pipe, rules): its middle, and its size.
        let bt = 6 * wt * k
        let bw = if(lay == 0, bt, if(lay == 1, 122 * k, if(lay == 2, 62 * k, if(lay == 3, bt, if(lay == 4, bt, 122 * k)))))
        let bh = if(lay == 0, 118 * k, if(lay == 1, bt, if(lay == 2, bt, if(lay == 3, bt, if(lay == 4, bt, bt)))))
        let bpy = if(lay == 5, cy + 22 * k, cy)
        let bd = if(lay == 3 or lay == 4, 30000, 0)
        body {
            color: tint
            glass: gl
            lens: false
            rim: 100% * rimv
            shine: 0, 0
            shadow: 0, 8 * k * gl, 24 * k * gl, 28% * gl
            opacity: op
            path { at: x0, y0; stroke: sw0; move (if(d0 == 0, 23, if(d0 == 1, 10, if(d0 == 2, 2, if(d0 == 3, 3, if(d0 == 4, 34, if(d0 == 5, 42, if(d0 == 6, 40, if(d0 == 7, 2, if(d0 == 8, 23, if(d0 == 9, 6, 30000))))))))))) * kk0, (if(d0 == 0, 0, if(d0 == 1, 18, if(d0 == 2, 24, if(d0 == 3, 10, if(d0 == 4, 88, if(d0 == 5, 2, if(d0 == 6, 8, if(d0 == 7, 2, if(d0 == 8, 2, if(d0 == 9, 80, 0))))))))))) * kk0; curve (if(d0 == 0, 46, if(d0 == 1, 30, if(d0 == 2, 23, if(d0 == 3, 23, if(d0 == 4, 34, if(d0 == 5, 8, if(d0 == 6, 22, if(d0 == 7, 44, if(d0 == 8, 41, if(d0 == 9, 24, 30000))))))))))) * kk0, (if(d0 == 0, 23, if(d0 == 1, 0, if(d0 == 2, 0, if(d0 == 3, 0, if(d0 == 4, 0, if(d0 == 5, 2, if(d0 == 6, 0, if(d0 == 7, 2, if(d0 == 8, 22, if(d0 == 9, 88, 0))))))))))) * kk0 via (if(d0 == 0, 46, if(d0 == 1, 20, if(d0 == 2, 2, if(d0 == 3, 8, if(d0 == 4, 34, if(d0 == 5, 25, if(d0 == 6, 34, if(d0 == 7, 23, if(d0 == 8, 41, if(d0 == 9, 12, 30000))))))))))) * kk0, (if(d0 == 0, 0, if(d0 == 1, 9, if(d0 == 2, 0, if(d0 == 3, 0, if(d0 == 4, 44, if(d0 == 5, 2, if(d0 == 6, 0, if(d0 == 7, 2, if(d0 == 8, 2, if(d0 == 9, 88, 0))))))))))) * kk0; curve (if(d0 == 0, 46, if(d0 == 1, 30, if(d0 == 2, 44, if(d0 == 3, 42, if(d0 == 4, 0, if(d0 == 5, 6, if(d0 == 6, 2, if(d0 == 7, 14, if(d0 == 8, 23, if(d0 == 9, 44, 30000))))))))))) * kk0, (if(d0 == 0, 65, if(d0 == 1, 88, if(d0 == 2, 24, if(d0 == 3, 22, if(d0 == 4, 62, if(d0 == 5, 42, if(d0 == 6, 52, if(d0 == 7, 88, if(d0 == 8, 42, if(d0 == 9, 36, 0))))))))))) * kk0 via (if(d0 == 0, 46, if(d0 == 1, 30, if(d0 == 2, 44, if(d0 == 3, 42, if(d0 == 4, 17, if(d0 == 5, 7, if(d0 == 6, 2, if(d0 == 7, 29, if(d0 == 8, 41, if(d0 == 9, 44, 30000))))))))))) * kk0, (if(d0 == 0, 44, if(d0 == 1, 44, if(d0 == 2, 0, if(d0 == 3, 0, if(d0 == 4, 31, if(d0 == 5, 22, if(d0 == 6, 0, if(d0 == 7, 45, if(d0 == 8, 42, if(d0 == 9, 88, 0))))))))))) * kk0; curve (if(d0 == 0, 23, if(d0 == 1, 30, if(d0 == 2, 29, if(d0 == 3, 22, if(d0 == 4, 46, if(d0 == 5, 26, if(d0 == 6, 23, if(d0 == 7, 14, if(