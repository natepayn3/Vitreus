language 0.1

//  The clock face with a style for each set: the hours (`ghw`, `ghz`, `ghc`) and the minutes (`gmw`, `gmz`, `gmc`) each have a weight (a multiplier), a size (a multiplier) and a tint
//  (0 the shell's glass, 1 mint, 2 light, 3 rose, 4 grey), and the divider (the colon, the bar, the outline or the slash, whichever the layout
//  has) has its own too (`gsw`, `gsz`, `gsc`). The scene that imports it declares those facts. It is clockface.plm with each place its own body of glass
//  (a tint is one for a body), and it is given the four colours it can tint with (a library cannot see the scene's own): `p_mint`, `p_ink` (light), `p_alert` (rose),
//  `p_faint` (grey). The small badges in Settings, which need no styles, use the plain one instead.

library ClockFaceStyled {
    component ClockFaceStyled(k: number, lay: number, d0: number, d1: number, d2: number, d3: number, cx: number, cy: number, tint: color, gl: number, rimv: number, op: number, wt: number, p_mint: color, p_ink: color, p_alert: color, p_faint: color, obsv: number) {
        let m01 = if(lay == 2, 0.6, 1)            // the tower is smaller, to fit
        let m23 = if(lay == 2, 0.6, if(lay == 5, 0.5, 1))   // and the hero's minutes are half the size
        let w0 = ghw
        let z0 = ghz
        let ci0 = ghc
        let w1 = ghw
        let z1 = ghz
        let ci1 = ghc
        let w2 = gmw
        let z2 = gmz
        let ci2 = gmc
        let w3 = gmw
        let z3 = gmz
        let ci3 = gmc
        let kk0 = k * m01 * z0
        let kk1 = k * m01 * z1
        let kk2 = k * m23 * z2
        let kk3 = k * m23 * z3
        let sw0 = 13 * wt * kk0 * w0
        let sw1 = 13 * wt * kk1 * w1
        let sw2 = 13 * wt * kk2 * w2
        let sw3 = 13 * wt * kk3 * w3
        let ox0 = (1 - z0) * 23 * k * m01
        let oy0 = (1 - z0) * 44 * k * m01
        let ox1 = (1 - z1) * 23 * k * m01
        let oy1 = (1 - z1) * 44 * k * m01
        let ox2 = (1 - z2) * 23 * k * m23
        let oy2 = (1 - z2) * 44 * k * m23
        let ox3 = (1 - z3) * 23 * k * m23
        let oy3 = (1 - z3) * 44 * k * m23
        let hi = if(d0 < 0, 0 - 38 * k, 0)        // no tens in the hour: what is left is still centred (in the layouts where that is the thing to centre)
        let bx0 = if(lay == 0, cx - 149 * k, if(lay == 1, cx - 61 * k + hi, if(lay == 2, cx - 13.8 * k, if(lay == 3, cx - 152 * k + hi, if(lay == 4, cx - 130 * k, cx - 61 * k + hi)))))
        let bx1 = if(lay == 0, bx0 + 76 * k, if(lay == 1, bx0 + 76 * k, if(lay == 2, bx0, if(lay == 3, bx0 + 76 * k, if(lay == 4, bx0 + 76 * k, bx0 + 76 * k)))))
        let bx2 = if(lay == 0, cx + 27 * k, if(lay == 1, cx - 61 * k, if(lay == 2, cx - 13.8 * k, if(lay == 3, bx1 + 106 * k, if(lay == 4, cx + 8 * k, cx)))))
        let bx3 = if(lay == 0, bx2 + 76 * k, if(lay == 1, bx2 + 76 * k, if(lay == 2, bx2, if(lay == 3, bx2 + 76 * k, if(lay == 4, bx2 + 76 * k, bx2 + 38 * k)))))
        let by0 = if(lay == 0, cy - 44 * k, if(lay == 1, cy - 111 * k, if(lay == 2, cy - 130.6 * k, if(lay == 3, cy - 44 * k, if(lay == 4, cy - 112 * k, cy - 84 * k)))))
        let by1 = if(lay == 0, by0, if(lay == 1, by0, if(lay == 2, by0 + 64.8 * k, if(lay == 3, by0, if(lay == 4, by0, by0)))))
        let by2 = if(lay == 0, by0, if(lay == 1, cy + 23 * k, if(lay == 2, by1 + 78.8 * k, if(lay == 3, by0, if(lay == 4, cy + 24 * k, cy + 40 * k)))))
        let by3 = if(lay == 0, by2, if(lay == 1, by2, if(lay == 2, by2 + 64.8 * k, if(lay == 3, by2, if(lay == 4, by2, by2)))))
        let ccx = (bx1 + 46 * k + bx2) / 2
        let wts = wt * gsw
        let ks = k * gsz
        let cd = if(lay == 3, 0, 30000)            // the colon: only in the digital layout
        //  The bar (pipe, rules): its middle, and its size.
        let bt = 6 * wts * ks
        let bw = if(lay == 0, bt, if(lay == 1, 122 * ks, if(lay == 2, 62 * ks, if(lay == 3, bt, if(lay == 4, bt, 122 * ks)))))
        let bh = if(lay == 0, 118 * ks, if(lay == 1, bt, if(lay == 2, bt, if(lay == 3, bt, if(lay == 4, bt, bt)))))
        let bpy = if(lay == 5, cy + 22 * k, cy)       // (the hero's line stays where it is when it grows: it grows in place, not towards the minutes)
        let bd = if(lay == 3 or lay == 4, 30000, 0)

        //  Room for what grows. A bigger or bolder part grows round its own middle, so it needs more room than the layout gave it: how much each part grows
        //  towards its neighbours (`ge_*` the hours', `me_*` the minutes', `dv` the divider's line, `dc` the colon's dots), and the parts are moved apart by that,
        //  so that no part ever touches another. `_h` is sideways, `_v` up and down. Two digits of one part also keep apart (`sh*`, `sv*`).
        let ge_h = max(0, 1.4 * k * m01 * (ghz * (23 + 6.5 * wt * ghw) - (23 + 6.5 * wt)))
        let ge_v = max(0, 1.4 * k * m01 * (ghz * (44 + 6.5 * wt * ghw) - (44 + 6.5 * wt)))
        let me_h = max(0, 1.4 * k * m23 * (gmz * (23 + 6.5 * wt * gmw) - (23 + 6.5 * wt)))
        let me_v = max(0, 1.4 * k * m23 * (gmz * (44 + 6.5 * wt * gmw) - (44 + 6.5 * wt)))
        let dv = max(0, 4.2 * wt * k * (gsw * gsz - 1))
        let dc = max(0, 9.8 * wt * k * (gsw * gsz - 1))
        let gap_h = if(lay == 2, 12, 30) * k
        let gap_m = if(lay == 2, 12, if(lay == 5, 15, 30)) * k
        let sh = if(lay == 2, 0, max(0, 2 * ge_h - 0.5 * gap_h))
        let sm = if(lay == 2, 0, max(0, 2 * me_h - 0.5 * gap_m))
        let svh = if(lay == 2, max(0, 2 * ge_v - 0.5 * gap_h), 0)
        let svm = if(lay == 2, max(0, 2 * me_v - 0.5 * gap_m), 0)
        let ghx = if(lay == 0 or lay == 4, 0 - (ge_h + dv + sh / 2), if(lay == 3, 0 - (ge_h + dc + sh / 2), 0))
        let gmx = if(lay == 0 or lay == 4, me_h + dv + sm / 2, if(lay == 3, me_h + dc + sm / 2, 0))
        let ghy = if(lay == 1 or lay == 4 or lay == 5 or lay == 2, 0 - (ge_v + dv), 0)
        let gmy = if(lay == 1 or lay == 4 or lay == 5 or lay == 2, me_v + dv, 0)
        let x0 = bx0 + ghx - sh / 2
        let x1 = bx1 + ghx + sh / 2
        let x2 = bx2 + gmx - sm / 2
        let x3 = bx3 + gmx + sm / 2
        let y1 = by1 + ghy
        let y0 = by0 + ghy - svh
        let y2 = by2 + gmy
        let y3 = by3 + gmy + svm
        body {
            color: if(ci0 == 1, p_mint, if(ci0 == 2, p_ink, if(ci0 == 3, p_alert, if(ci0 == 4, p_faint, tint))))
            glass: gl
            lens: false
            rim: 100% * rimv
            shine: 0, 0
            shadow: 0, 8 * k * gl, 24 * k * gl, 28% * gl
            opacity: op * (1 - obsv)
            show: obsv < 0.996
            path { at: x0 + ox0, y0 + oy0; stroke: sw0; move (if(d0 == 0, 23, if(d0 == 1, 10, if(d0 == 2, 2, if(d0 == 3, 3, if(d0 == 4, 34, if(d0 == 5, 42, if(d0 == 6, 40, if(d0 == 7, 2, if(d0 == 8, 23, if(d0 == 9, 6, 30000))))))))))) * kk0, (if(d0 == 0, 0, if(d0 == 1, 18, if(d0 == 2, 24, if(d0 == 3, 10, if(d0 == 4, 88, if(d0 == 5, 2, if(d0 == 6, 8, if(d0 == 7, 2, if(d0 == 8, 2, if(d0 == 9, 80, 0))))))))))) * kk0; curve (if(d0 == 0, 46, if(d0 == 1, 30, if(d0 == 2, 23, if(d0 == 3, 23, if(d0 == 4, 34, if(d0 == 5, 8, if(d0 == 6, 22, if(d0 == 7, 44, if(d0 == 8, 41, if(d0 == 9, 24, 30000))))))))))) * kk0, (if(d0 == 0, 23, if(d0 == 1, 0, if(d0 == 2, 0, if(d0 == 3, 0, if(d0 == 4, 0, if(d0 == 5, 2, if(d0 == 6, 0, if(d0 == 7, 2, if(d0 == 8, 22, if(d0 == 9, 88, 0))))))))))) * kk0 via (if(d0 == 0, 46, if(d0 == 1, 20, if(d0 == 2, 2, if(d0 == 3, 8, if(d0 == 4, 34, if(d0 == 5, 25, if(d0 == 6, 34, if(d0 == 7, 23, if(d0 == 8, 41, if(d0 == 9, 12, 30000))))))))))) * kk0, (if(d0 == 0, 0, if(d0 == 1, 9, if(d0 == 2, 0, if(d0 == 3, 0, if(d0 == 4, 44, if(d0 == 5, 2, if(d0 == 6, 0, if(d0 == 7, 2, if(d0 == 8, 2, if(d0 == 9, 88, 0))))))))))) * kk0; curve (if(d0 == 0, 46, if(d0 == 1, 30, if(d0 == 2, 44, if(d0 == 3, 42, if(d0 == 4, 0, if(d0 == 5, 6, if(d0 == 6, 2, if(d0 == 7, 14, if(d0 == 8, 23, if(d0 == 9, 44, 30000))))))))))) * kk0, (if(d0 == 0, 65, if(d0 == 1, 88, if(d0 == 2, 24, if(d0 == 3, 22, if(d0 == 4, 62, if(d0 == 5, 42, if(d0 == 6, 52, if(d0 == 7, 88, if(d0 == 8, 42, if(d0 == 9, 36, 0))))))))))) * kk0 via (if(d0 == 0, 46, if(d0 == 1, 30, if(d0 == 2, 44, if(d0 == 3, 42, if(d0 == 4, 17, if(d0 == 5, 7, if(d0 == 6, 2, if(d0 == 7, 29, if(d0 == 8, 41, if(d0 == 9, 44, 30000))))))))))) * kk0, (if(d0 == 0, 44, if(d0 == 1, 44, if(d0 == 2, 0, if(d0 == 3, 0, if(d0 == 4, 31, if(d0 == 5, 22, if(d0 == 6, 0, if(d0 == 7, 45, if(d0 == 8, 42, if(d0 == 9, 88, 0))))))))))) * kk0; curve (if(d0 == 0, 23, if(d0 == 1, 30, if(d0 == 2, 29, if(d0 == 3, 22, if(d0 == 4, 46, if(d0 == 5, 26, if(d0 == 6, 23, if(d0 == 7, 14, if(d0 == 8, 5, if(d0 == 9, 23, 30000))))))))))) * kk0, (if(d0 == 0, 88, if(d0 == 1, 88, if(d0 == 2, 55, if(d0 == 3, 42, if(d0 == 4, 62, if(d0 == 5, 34, if(d0 == 6, 88, if(d0 == 7, 88, if(d0 == 8, 22, if(d0 == 9, 0, 0))))))))))) * kk0 via (if(d0 == 0, 46, if(d0 == 1, 30, if(d0 == 2, 44, if(d0 == 3, 42, if(d0 == 4, 23, if(d0 == 5, 14, if(d0 == 6, 2, if(d0 == 7, 14, if(d0 == 8, 5, if(d0 == 9, 44, 30000))))))))))) * kk0, (if(d0 == 0, 88, if(d0 == 1, 88, if(d0 == 2, 35, if(d0 == 3, 42, if(d0 == 4, 62, if(d0 == 5, 34, if(d0 == 6, 88, if(d0 == 7, 88, if(d0 == 8, 42, if(d0 == 9, 0, 0))))))))))) * kk0; curve (if(d0 == 0, 0, if(d0 == 1, 30, if(d0 == 2, 4, if(d0 == 3, 44, if(d0 == 4, 46, if(d0 == 5, 44, if(d0 == 6, 44, if(d0 == 7, 14, if(d0 == 8, 23, if(d0 == 9, 2, 30000))))))))))) * kk0, (if(d0 == 0, 65, if(d0 == 1, 88, if(d0 == 2, 88, if(d0 == 3, 66, if(d0 == 4, 62, if(d0 == 5, 60, if(d0 == 6, 62, if(d0 == 7, 88, if(d0 == 8, 2, if(d0 == 9, 26, 0))))))))))) * kk0 via (if(d0 == 0, 0, if(d0 == 1, 30, if(d0 == 2, 16.5, if(d0 == 3, 46, if(d0 == 4, 46, if(d0 == 5, 44, if(d0 == 6, 44, if(d0 == 7, 14, if(d0 == 8, 5, if(d0 == 9, 2, 30000))))))))))) * kk0, (if(d0 == 0, 88, if(d0 == 1, 88, if(d0 == 2, 71.5, if(d0 == 3, 44, if(d0 == 4, 62, if(d0 == 5, 34, if(d0 == 6, 88, if(d0 == 7, 88, if(d0 == 8, 2, if(d0 == 9, 0, 0))))))))))) * kk0; curve (if(d0 == 0, 0, if(d0 == 1, 30, if(d0 == 2, 46, if(d0 == 3, 22, if(d0 == 4, 46, if(d0 == 5, 24, if(d0 == 6, 22, if(d0 == 7, 14, if(d0 == 8, 23, if(d0 == 9, 24, 30000))))))))))) * kk0, (if(d0 == 0, 23, if(d0 == 1, 88, if(d0 == 2, 88, if(d0 == 3, 88, if(d0 == 4, 62, if(d0 == 5, 88, if(d0 == 6, 38, if(d0 == 7, 88, if(d0 == 8, 2, if(d0 == 9, 50, 0))))))))))) * kk0 via (if(d0 == 0, 0, if(d0 == 1, 30, if(d0 == 2, 25, if(d0 == 3, 44, if(d0 == 4, 46, if(d0 == 5, 44, if(d0 == 6, 44, if(d0 == 7, 14, if(d0 == 8, 23, if(d0 == 9, 2, 30000))))))))))) * kk0, (if(d0 == 0, 44, if(d0 == 1, 88, if(d0 == 2, 88, if(d0 == 3, 88, if(d0 == 4, 62, if(d0 == 5, 88, if(d0 == 6, 38, if(d0 == 7, 88, if(d0 == 8, 2, if(d0 == 9, 50, 0))))))))))) * kk0; curve (if(d0 == 0, 23, if(d0 == 1, 30, if(d0 == 2, 46, if(d0 == 3, 2, if(d0 == 4, 46, if(d0 == 5, 4, if(d0 == 6, 2, if(d0 == 7, 14, if(d0 == 8, 23, if(d0 == 9, 44, 30000))))))))))) * kk0, (if(d0 == 0, 0, if(d0 == 1, 88, if(d0 == 2, 88, if(d0 == 3, 78, if(d0 == 4, 62, if(d0 == 5, 74, if(d0 == 6, 52, if(d0 == 7, 88, if(d0 == 8, 2, if(d0 == 9, 36, 0))))))))))) * kk0 via (if(d0 == 0, 0, if(d0 == 1, 30, if(d0 == 2, 46, if(d0 == 3, 8, if(d0 == 4, 46, if(d0 == 5, 12, if(d0 == 6, 2, if(d0 == 7, 14, if(d0 == 8, 23, if(d0 == 9, 44, 30000))))))))))) * kk0, (if(d0 == 0, 0, if(d0 == 1, 88, if(d0 == 2, 88, if(d0 == 3, 88, if(d0 == 4, 62, if(d0 == 5, 88, if(d0 == 6, 40, if(d0 == 7, 88, if(d0 == 8, 2, if(d0 == 9, 48, 0))))))))))) * kk0 }
            path { at: x0 + ox0, y0 + oy0; stroke: sw0; move (if(d0 == 8, 23, 30000)) * kk0, (if(d0 == 8, 42, 0)) * kk0; curve (if(d0 == 8, 45, 30000)) * kk0, (if(d0 == 8, 65, 0)) * kk0 via (if(d0 == 8, 45, 30000)) * kk0, (if(d0 == 8, 42, 0)) * kk0; curve (if(d0 == 8, 23, 30000)) * kk0, (if(d0 == 8, 88, 0)) * kk0 via (if(d0 == 8, 45, 30000)) * kk0, (if(d0 == 8, 88, 0)) * kk0; curve (if(d0 == 8, 1, 30000)) * kk0, (if(d0 == 8, 65, 0)) * kk0 via (if(d0 == 8, 1, 30000)) * kk0, (if(d0 == 8, 88, 0)) * kk0; curve (if(d0 == 8, 23, 30000)) * kk0, (if(d0 == 8, 42, 0)) * kk0 via (if(d0 == 8, 1, 30000)) * kk0, (if(d0 == 8, 42, 0)) * kk0 }
        }
        //  Obsidian: the same strokes as a flat, dark piece (a `rim` that is an expression keeps a hairline of light even at zero, hence a body of its own).
        body {
            color: mix(if(ci0 == 1, p_mint, if(ci0 == 2, p_ink, if(ci0 == 3, p_alert, if(ci0 == 4, p_faint, tint)))), #000000, 0.7)
            rim: 0%
            opacity: op * obsv
            shadow: 0, 8 * k, 24 * k, 45%, #000000
            show: obsv > 0.004
