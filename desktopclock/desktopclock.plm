        on press ez3 { pk = 3; pgx = sx3 + pointer.x; pgy = sy3 + pointer.y; pnx = sx3 + pointer.x; pny = sy3 + pointer.y; kx = cgx - (sx3 + pointer.x); ky = cgy - (sy3 + pointer.y); dfx = fx - (gl + (ex0 + fw / 2) * gw); dfy = fy - (gt + (ey0 + fh / 2) * gh); dragging = true }
