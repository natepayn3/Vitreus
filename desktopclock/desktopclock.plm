language 0.1
// vitreus-fonts: lean   (it draws only in "Space Grotesk": bin/vitreus-keep starts it without the system's other fonts, see bin/vitreus-fonts)
import "../palette-live.plm"
import "clockface.plm"
import "clockface_styled.plm"

//  The desktop clock: the time in digits drawn as glass, on the bottom layer (above the wallpaper, under every window).
//  Each digit is a single stroke (clockface.plm), and all of them are one body of glass: the light runs round their edges and the compositor
//  blurs what is behind them. Its tint is the shell's (`tint` of palette.plm, which Iris keeps), the same as the bar's glass.
//
//  Turn it on or off with   pleamar --say desktopclock "fact shown true"   (or false); Settings > Clock has the switch and the rest.
//  Its settings are kept in desktopclock.json, in ~/.local/share/pleamar/desktopclock (see desktopclock.luau).

scene DesktopClock {
    //  Motion: pleamar's house springs, made about 18% quicker (stiffness x1.38, damping x1.18: the same overshoot, sooner).
    spring calm = 208, 27
    spring quick = 581, 47
    spring gentle = 263, 28
    //  1 x 1 and empty, one on each monitor: its copies report the monitors' names (`screen.K.name`) for where `hyprctl` does not answer, and keep the
    //  scene's rules running. The clock itself is drawn by the surfaces `sl0` to `sl3` below: out of Edit mode only its own monitor's is there, not a
    //  full-screen copy on every monitor (~27 MB on the card each, drawing nothing but on one of them). See widget_place.luau.
    surface { size: 1, 1; anchor: top_left; margin: 0; level: background; screens: each max 4; reserve: -1; keyboard: none }

    permissions { services: "clock", "files", "files.write"; run: "pleamar", "hyprctl", "socat", "printenv", "vitreus-btnwait" }

    //  The shell's colours as facts (palette-live.plm reads them): Vitreus sets them when the palette changes (`push_pal` in vitreus.luau), so the theme
    //  changes the colour at once, not after a reload of this scene as the imported palette.plm did.
    fact pal_ink_r = 0.9608   // #f5f7f5
    fact pal_ink_g = 0.9686
    fact pal_ink_b = 0.9608
    fact pal_faint_r = 0.7608   // #c2c7cc
    fact pal_faint_g = 0.7804
    fact pal_faint_b = 0.8000
    fact pal_mint_r = 0.6196   // #9ed6bd
    fact pal_mint_g = 0.8392
    fact pal_mint_b = 0.7412
    fact pal_mintlo_r = 0.4235   // #6cbc9c
    fact pal_mintlo_g = 0.7373
    fact pal_mintlo_b = 0.6118
    fact pal_minthi_r = 0.8627   // #dcf8ec
    fact pal_minthi_g = 0.9725
    fact pal_minthi_b = 0.9255
    fact pal_onmint_r = 0.0627   // #10161a
    fact pal_onmint_g = 0.0863
    fact pal_onmint_b = 0.1020
    fact pal_tint_r = 0.1059   // #1b2127
    fact pal_tint_g = 0.1294
    fact pal_tint_b = 0.1529
    fact pal_panel_r = 0.0863   // #161a1f
    fact pal_panel_g = 0.1020
    fact pal_panel_b = 0.1216
    fact pal_deep_r = 0.0431   // #0b0e11
    fact pal_deep_g = 0.0549
    fact pal_deep_b = 0.0667
    fact pal_off_r = 0.2275   // #3a4048
    fact pal_off_g = 0.2510
    fact pal_off_b = 0.2824
    fact pal_alert_r = 0.9373   // #ef4444
    fact pal_alert_g = 0.2667
    fact pal_alert_b = 0.2667

    service clock as now { hour: number }

    fact where: top_left | top | top_right | left | center | right | bottom_left | bottom | bottom_right = center
    fact gx = -1           // the cell of its top left corner, 0 to 15 (-1: not chosen yet, `where` says)
    fact gy = -1           // and the row, 0 to 8
    fact edit = false      // Edit, from the desktop editor (desktopedit/): the widget shows the cells it takes and can be dragged to others
    fact g0x = 0           // while it is dragged: the cell it was at when it was pressed
    fact g0y = 0
    fact dragging = false
    text mon_name = ""     // the name of the monitor that shows the card (Settings > Widgets sets it; the logic keeps it)
    //  One surface a monitor (`sl0` to `sl3`, on the monitors `s0` to `s3` name): in Edit mode on every monitor there is, put there as the editor opens and
    //  taken off as it shuts, so that none is made, moved or taken off while the widget goes from one to another (a layer fades in and out as it comes and
    //  goes: that was the flicker, and moving one under a drag ended the drag); out of it, only on the widget's own (`hk`). `sx*`, `sy*`: where each
    //  monitor is in the desktop; `sm*`: there is one. The logic keeps them (widget_place.luau).
    text s0 = ""
    text s1 = ""
    text s2 = ""
    text s3 = ""
    fact sx0 = 0
    fact sy0 = 0
    fact sx1 = 0
    fact sy1 = 0
    fact sx2 = 0
    fact sy2 = 0
    fact sx3 = 0
    fact sy3 = 0
    fact sm0 = false
    fact sm1 = false
    fact sm2 = false
    fact sm3 = false
    fact hk = 0            // which of them is the widget's own monitor
    //  Carried: the compositor lets go of a drag as the pointer goes on to another monitor. When it ends by an edge (`edge`) with the button still down
    //  (bin/vitreus-btnwait says so to the logic), the widget goes on following the pointer (`carry`: the logic gives where it is, `pnx`, `pny`, from
    //  Hyprland), and when the button comes up the logic says `drop`: it stays in the cell it is in, on that monitor.
    fact carry = false
    fact drop = false
    fact edge = false
    fact pk = 0            // and, while it is dragged, the one it was pressed on: only that one hears the pointer meanwhile (a surface of this scene that
                           // hears it on another monitor takes the pointer over as it gets there, and the drag ends)
    //  While it is dragged: the pointer in the desktop's coordinates where it was pressed (`pgx`, `pgy`) and now (`pnx`, `pny`), and from it to the middle of
    //  the face (`kx`, `ky`).
    fact pgx = 0
    fact pgy = 0
    fact pnx = 0
    fact pny = 0
    fact kx = 0
    fact ky = 0
    fact dfx = 0           // from the middle of its cells to the middle of the face, when it was pressed
    fact dfy = 0
    fact dfx = 0           // while it is dragged: from the middle of its cells to the middle of the face (the face follows the pointer, the cells come after)
    fact dfy = 0
    fact jump = false      // just gone over to another monitor: drawn at its new cell at once, not slid there by the cells' spring (the logic, a moment)
    prop jp = 0 ~0ms
    follow jp = if(jump, 1, 0)
    fact orphan = false    // its monitor is not plugged in: it is shown only in Edit mode, on the first monitor, marked (the logic)
    text orph = ""         // and that monitor's name
    fact shown = false     // the logic sets it from desktopclock.json (so that `sh` follows it from nothing)
    fact lay = 0           // 0 pipe, 1 rule, 2 tower, 3 digital, 4 slash, 5 hero (see clockface.plm)
    fact h12 = true        // a 12 hour clock (the logic turns it into the digits); the Settings page reads it
    fact d0 = -1           // the digits shown: -1 for none (the hour's tens, with a 12 hour clock, when the hour is below 10)
    fact d1 = 0
    fact d2 = 0
    fact d3 = 0
    fact px = 220          // the digits' height in pixels
    fact wti = 1           // the strokes: 0 thin, 1 regular, 2 bold
    fact cli = 1           // the glass: 0 clear, 1 soft, 2 full

    //  The style of the hours, the minutes and the divider (see clockface_styled.plm): a weight and a size (multipliers; 1 is the normal) and a tint (0 the glass, 1 mint, 2 light, 3 rose, 4 grey)
    fact ghw = 1
    fact ghz = 1
    fact ghc = 0
    fact gmw = 1
    fact gmz = 1
    fact gmc = 0
    fact gsw = 1
    fact gsz = 1
    fact gsc = 0
    fact greset = 0          // set to 1 by Settings: every glyph back to the normal style (the logic puts it back to 0)
    text gpack = ""          // all of them in one line, for the Settings page to read at once: "w,z,c;" for the hours, the minutes and the divider

    prop sh = 0 ~calm
    follow sh = if(shown, 1, 0)
    fact obs = false        // Vitreus has its glass off: the digits are flat obsidian (Vitreus says so with `fact obs true`)
    prop ob = 0 ~calm
    follow ob = if(obs or look == 1 or look == 2 or look == 4 or look == 5 or look == 6 or look == 7, 1, 0)
    fact look = 0           // the shell's theme (Vitreus says so): 0 Glass, 1 Retro, 2 UwU, 3 Cyber; the last three draw the digits as plastic, like the bar (outline, hard shadow)
    prop pl = 0 ~calm
    follow pl = if(look == 1 or look == 2 or look == 4 or look == 5 or look == 6 or look == 7, 1, 0)
    prop dd = 0 ~calm
    follow dd = if(look == 7, 1, 0)         // Doodle: pastel digits, a thick black outline, no hard shadow
    prop mk = 0 ~calm
    follow mk = if(look == 4, 1, 0)
    prop pxk = 0 ~calm
    follow pxk = if(look == 5, 1, 0)
    prop cy = 0 ~calm
    follow cy = if(look == 3, 1, 0)         // Cyber: the digits are filled with the neon (the glass's own tint is near-black there)
    prop uk = 0 ~calm
    follow uk = if(look == 2, 1, 0)

    let k = px / 88
    let wt = if(wti == 0, 0.62, if(wti == 2, 1.4, 1))
    let clr = if(cli == 0, 55%, if(cli == 1, 80%, 100%))
    //  Where the middle of the face is, in the surface: the middle of it, or against the edge or corner it sits in (half the face, and its stroke).
    //  What the style of the parts adds to the face (the same sums as in clockface_styled.plm and in the Settings page): how far each part grows past its normal size, so that
    //  the cells the clock takes (and the outline of them in Edit mode) hold all of it and not only the normal face.
    let pm1 = if(lay == 2, 0.6, 1)
    let pm2 = if(lay == 2, 0.6, if(lay == 5, 0.5, 1))
    let ugeh = max(0, 1.4 * pm1 * (ghz * (23 + 6.5 * wt * ghw) - (23 + 6.5 * wt)))
    let ugev = max(0, 1.4 * pm1 * (ghz * (44 + 6.5 * wt * ghw) - (44 + 6.5 * wt)))
    let umeh = max(0, 1.4 * pm2 * (gmz * (23 + 6.5 * wt * gmw) - (23 + 6.5 * wt)))
    let umev = max(0, 1.4 * pm2 * (gmz * (44 + 6.5 * wt * gmw) - (44 + 6.5 * wt)))
    let udv = max(0, 4.2 * wt * (gsw * gsz - 1))
    let udc = max(0, 9.8 * wt * (gsw * gsz - 1))
    let hw = (if(lay == 0, 149, if(lay == 1 or lay == 5, 61, if(lay == 2, 31, if(lay == 3, 152, 130)))) + 6.5 * wt + 2 * max(ugeh, umeh) + 1.5 * max(udv, udc)) * k
    let hh = (if(lay == 0, 59, if(lay == 1, 111, if(lay == 2, 131, if(lay == 3, 44, if(lay == 4, 112, 84))))) + 6.5 * wt + 2.2 * max(ugev, umev) + 1.5 * udv) * k
    let isl = if(where == top_left or where == left or where == bottom_left, 1, 0)
    let isr = if(where == top_right or where == right or where == bottom_right, 1, 0)
    let ist = if(where == top_left or where == top or where == top_right, 1, 0)
    let isb = if(where == bottom_left or where == bottom or where == bottom_right, 1, 0)
    //  The desktop is a grid of 16 columns and 9 rows, inside a 40 px margin; the settings put a widget on it by the cell of its top left corner (`gx`, `gy`) and it
    //  takes as many cells as it needs (`cfw`, `cfh`, which Settings > Widgets asks for). Against an edge of the grid it sits against that edge, between them it is centred in its cells.
    //  `gx` and `gy` below 0 are an older settings file: it is put where `where` says (one of the nine places, which is what the cells are made of).
    //  The room the bar's frame takes round the screen (Vitreus tells it: `room_*`, in pixels, 0 when the bar is not a frame), which the grid stays out of, so a widget cannot be put under the bar.
    fact room_t = 0
    fact room_r = 0
    fact room_b = 0
    fact room_l = 0
    let gnx = 28           // the grid: 28 columns and 16 rows (it used to be 16 x 9), from the bar's frame (the `room_*`) plus a 16 px margin
    let gny = 16
    let gm = 16
    let gl = gm + room_l
    let gt = gm + room_t
    let gr = gm + room_r
    let gb = gm + room_b
    let scw = max(pick(hk, sl0.width, sl1.width, sl2.width, sl3.width), 1)       // what its own monitor measures (its surface is the whole of it)
    let sch = max(pick(hk, sl0.height, sl1.height, sl2.height, sl3.height), 1)
    let hox = pick(hk, sx0, sx1, sx2, sx3)          // and where it is in the desktop
    let hoy = pick(hk, sy0, sy1, sy2, sy3)
    let gw = (scw - gl - gr) / gnx
    let gh = (sch - gt - gb) / gny
    let fw = clamp(ceil(2 * hw / gw), 1, gnx)
    let fh = clamp(ceil(2 * hh / gh), 1, gny)
    let ex0 = clamp(if(gx < 0, if(isl > 0.5, 0, if(isr > 0.5, gnx - fw, (gnx - fw) / 2)), gx), 0, gnx - fw)
    let ey0 = clamp(if(gy < 0, if(ist > 0.5, 0, if(isb > 0.5, gny - fh, (gny - fh) / 2)), gy), 0, gny - fh)
    //  In Edit mode what is drawn follows the cell with a spring (`erx`, `ery`); otherwise it is the cell.
    prop erx = 0 ~quick
    prop ery = 0 ~quick
    follow erx = if(gx < 0, ex0, gx)      // (`ex` clamps it to what fits)
    //  Settings > Theme > Pin widgets: while a theme puts the widgets back (`glide`, said by Vitreus), what is drawn slides to its new cell on a slower
    //  spring instead of jumping to it.
    fact glide = false
    prop glp = 0 ~0ms                    // (at once: the slower spring is already where the widget is, so taking it over shows nothing)
    follow glp = if(glide, 1, 0)
    prop gsx = 0 ~gentle
    prop gsy = 0 ~gentle
    follow gsx = if(gx < 0, ex0, gx)
    follow gsy = if(gy < 0, ey0, gy)
    follow ery = if(gy < 0, ey0, gy)
    let ex = clamp(mix(mix(mix(ex0, erx, edp), gsx, glp), if(gx < 0, ex0, gx), jp), 0, gnx - fw)
    let ey = clamp(mix(mix(mix(ey0, ery, edp), gsy, glp), if(gy < 0, ey0, gy), jp), 0, gny - fh)
    //  Against the grid's edge the face is against the edge, between them it is in the middle of its cells, and in between it moves from one to the other (so that it never jumps).
    let cxm = gl + (ex + fw / 2) * gw
    let cym = gt + (ey + fh / 2) * gh
    let fx = cxm + (gl + hw + 13 - cxm) * clamp(1 - ex, 0, 1) + (scw - gr - hw - 13 - cxm) * clamp(ex + fw - (gnx - 1), 0, 1)
    let fy = cym + (gt + hh + 13 - cym) * clamp(1 - ey, 0, 1) + (sch - gb - hh - 13 - cym) * clamp(ey + fh - (gny - 1), 0, 1)
    //  Edit mode: the cells it takes are outlined, and a press on them takes the widget; it moves a whole cell at a time under the pointer, and keeps its place (the settings
    //  file is written for each cell it lands on). The zone stays where the press was while it is dragged, as a zone that moves itself would lose the drag.
    prop edp = 0 ~calm
    follow edp = if(edit, 1, 0)
    prop dgp = 0 ~quick
    follow dgp = if(dragging, 1, 0)
    //  The outline hugs the face (a little margin round it) instead of the cells it takes, and the face is in the middle of it.
    let pad = 10
    //  Where the face is on its monitor, for the window manager's scene (it keeps a hole in its desktop-click zone there; see logic/desk_holes.luau in the shell).
    fact hl_x = 0
    fact hl_y = 0
    fact hl_w = 0
    fact hl_h = 0
    on change fx { hl_x = fx - hw - pad }
    on change fy { hl_y = fy - hh - pad }
    on change hw { hl_w = 2 * (hw + pad); hl_x = fx - hw - pad }
    on change hh { hl_h = 2 * (hh + pad); hl_y = fy - hh - pad }
    //  Dragged, it goes from cell to cell on a quick spring, as the desktop's other widgets do, and where it is seen is where it stays: the cell under it on the
    //  monitor the pointer is over (`dk`), whichever that is. Its place is kept in the desktop's coordinates (`cgx`, `cgy`) and each monitor's surface
    //  draws what falls on it, so it goes across an edge as it goes from cell to cell.
    let in0 = if(sm0 and pnx >= sx0 and pnx < sx0 + sl0.width and pny >= sy0 and pny < sy0 + sl0.height, 1, 0)
    let in1 = if(sm1 and pnx >= sx1 and pnx < sx1 + sl1.width and pny >= sy1 and pny < sy1 + sl1.height, 1, 0)
    let in2 = if(sm2 and pnx >= sx2 and pnx < sx2 + sl2.width and pny >= sy2 and pny < sy2 + sl2.height, 1, 0)
    let in3 = if(sm3 and pnx >= sx3 and pnx < sx3 + sl3.width and pny >= sy3 and pny < sy3 + sl3.height, 1, 0)
    let dk = if(in0 > 0.5, 0, if(in1 > 0.5, 1, if(in2 > 0.5, 2, if(in3 > 0.5, 3, hk))))
    let tox = pick(dk, sx0, sx1, sx2, sx3)
    let toy = pick(dk, sy0, sy1, sy2, sy3)
    let tw = max(pick(dk, sl0.width, sl1.width, sl2.width, sl3.width), 1)
    let th = max(pick(dk, sl0.height, sl1.height, sl2.height, sl3.height), 1)
    let ngw = (tw - gl - gr) / gnx
    let ngh = (th - gt - gb) / gny
    let nfw = clamp(ceil(2 * hw / ngw), 1, gnx)
    let nfh = clamp(ceil(2 * hh / ngh), 1, gny)
    let ccx = pnx + kx - dfx - tox          // (the middle of the cells under it, freely, on that monitor)
    let ccy = pny + ky - dfy - toy
    let dgx = clamp(floor((ccx - gl) / ngw - nfw / 2 + 0.5), 0, gnx - nfw)
    let dgy = clamp(floor((ccy - gt) / ngh - nfh / 2 + 0.5), 0, gny - nfh)
    //  The face's place for that cell (as `fx`, `fy` put it: in the middle of its cells, against the grid's edge at the first or the last one).
    let dex = gl + (dgx + nfw / 2) * ngw
    let dey = gt + (dgy + nfh / 2) * ngh
    //  The pointer by an edge of the monitor it is over (48 px) when the drag ends: maybe the compositor let go of it there.
    let lpx = pnx - tox
    let lpy = pny - toy
    let nearedge = if(lpx <= 48 or lpx >= tw - 48 or lpy <= 48 or lpy >= th - 48, 1, 0)
    on change drop while drop { gx = dgx; gy = dgy; hk = dk; jump = true; carry = false; drop = false }
    let tcx = tox + dex + (gl + hw + 13 - dex) * clamp(1 - dgx, 0, 1) + (tw - gr - hw - 13 - dex) * clamp(dgx + nfw - (gnx - 1), 0, 1)
    let tcy = toy + dey + (gt + hh + 13 - dey) * clamp(1 - dgy, 0, 1) + (th - gb - hh - 13 - dey) * clamp(dgy + nfh - (gny - 1), 0, 1)
    //  (At rest the spring stays on the face, so that a drag starts from where it is.)
    prop dxs = 0 ~quick
    prop dys = 0 ~quick
    follow dxs = if(dragging or carry, tcx, hox + fx)
    follow dys = if(dragging or carry, tcy, hoy + fy)
    let cgx = if(dragging or carry, dxs, hox + fx)
    let cgy = if(dragging or carry, dys, hoy + fy)

    surface sl0 {
        size: full, full; anchor: top_left; margin: 0; level: bottom, top while edit; screens: s0; reserve: -1; keyboard: none
        //  The face as it falls on this monitor.
        let lx = cgx - sx0
        let ly = cgy - sy0
        let on = sm0 and lx + hw + pad > 0 and lx - hw - pad < sl0.width and ly + hh + pad > 0 and ly - hh - pad < sl0.height
        //  Pressed on it here (the zone is the face; while it is dragged, the whole surface: pleamar keeps the drag going past its edge).
        zone box ez0 { from: if(dragging and pk == 0, 0, lx - hw - pad), if(dragging and pk == 0, 0, ly - hh - pad); size: if(dragging and pk == 0, sl0.width, 2 * (hw + pad)), if(dragging and pk == 0, sl0.height, 2 * (hh + pad)); corner: 16; cursor: pointer; active: edit and shown and ((on and not dragging and not carry) or (dragging and pk == 0)); label: "Move clock" }
        on press ez0 { pk = 0; pgx = sx0 + pointer.x; pgy = sy0 + pointer.y; pnx = sx0 + pointer.x; pny = sy0 + pointer.y; kx = cgx - (sx0 + pointer.x); ky = cgy - (sy0 + pointer.y); dfx = fx - (gl + (ex0 + fw / 2) * gw); dfy = fy - (gt + (ey0 + fh / 2) * gh); dragging = true }
        on drag ez0 { pnx = if(dragging, pgx + drag.dx, pnx); pny = if(dragging, pgy + drag.dy, pny) }
        //  A right click does nothing here, on purpose: a scene that never names the right button is closed by one (pleamar's way out of a prototype with no
        //  keyboard), and the keeper starts it again a moment later, out of Edit mode: the widget went away and came back stuck.
        on press right ez0 { }
        //  Let go: it stays in the cell it was in, on that monitor (`jump`: drawn there at once, not slid there by the cells' spring from where it was).
        on release ez0 { edge = if(dragging, nearedge > 0.5, edge); jump = if(dragging, true, jump); gx = if(dragging, dgx, gx); gy = if(dragging, dgy, gy); hk = if(dragging, dk, hk); dragging = false }
        group {
            show: on
            group {
                show: edp > 0.01 and shown
                opacity: edp
                box { from: lx - hw - pad, ly - hh - pad; size: 2 * (hw + pad), 2 * (hh + pad); corner: 16; color: mint; opacity: 7% + 9% * dgp }
                box { from: lx - hw - pad, ly - hh - pad; size: 2 * (hw + pad), 2 * (hh + pad); corner: 16; stroke: 1.6; color: mint; opacity: 55% + 45% * dgp }
                text "Clock" { at: lx - hw - pad + 14, ly - hh - pad + 16; anchor: left center; size: 12; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 5, 70% }
                //  (its monitor is not plugged in: shown here only in Edit mode, to be placed)
                text orph { at: lx + hw + pad - 14, ly - hh - pad + 16; anchor: right center; size: 12; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 5, 70%; show: orphan }
            }
            group {
                ClockFaceStyled(k, lay, d0, d1, d2, d3, lx, ly, mix(tint, mint, cy), 1, 0.4, sh * clr, wt, mint, ink, alert, faint, ob, pl, uk, deep, mk, pxk, dd)
            }
        }
    }

    surface sl1 {
        size: full, full; anchor: top_left; margin: 0; level: bottom, top while edit; screens: s1; reserve: -1; keyboard: none
        //  The face as it falls on this monitor.
        let lx = cgx - sx1
        let ly = cgy - sy1
        let on = sm1 and lx + hw + pad > 0 and lx - hw - pad < sl1.width and ly + hh + pad > 0 and ly - hh - pad < sl1.height
        //  Pressed on it here (the zone is the face; while it is dragged, the whole surface: pleamar keeps the drag going past its edge).
        zone box ez1 { from: if(dragging and pk == 1, 0, lx - hw - pad), if(dragging and pk == 1, 0, ly - hh - pad); size: if(dragging and pk == 1, sl1.width, 2 * (hw + pad)), if(dragging and pk == 1, sl1.height, 2 * (hh + pad)); corner: 16; cursor: pointer; active: edit and shown and ((on and not dragging and not carry) or (dragging and pk == 1)); label: "Move clock" }
        on press ez1 { pk = 1; pgx = sx1 + pointer.x; pgy = sy1 + pointer.y; pnx = sx1 + pointer.x; pny = sy1 + pointer.y; kx = cgx - (sx1 + pointer.x); ky = cgy - (sy1 + pointer.y); dfx = fx - (gl + (ex0 + fw / 2) * gw); dfy = fy - (gt + (ey0 + fh / 2) * gh); dragging = true }
        on drag ez1 { pnx = if(dragging, pgx + drag.dx, pnx); pny = if(dragging, pgy + drag.dy, pny) }
        //  A right click does nothing here, on purpose: a scene that never names the right button is closed by one (pleamar's way out of a prototype with no
        //  keyboard), and the keeper starts it again a moment later, out of Edit mode: the widget went away and came back stuck.
        on press right ez1 { }
        //  Let go: it stays in the cell it was in, on that monitor (`jump`: drawn there at once, not slid there by the cells' spring from where it was).
        on release ez1 { edge = if(dragging, nearedge > 0.5, edge); jump = if(dragging, true, jump); gx = if(dragging, dgx, gx); gy = if(dragging, dgy, gy); hk = if(dragging, dk, hk); dragging = false }
        group {
            show: on
            group {
                show: edp > 0.01 and shown
                opacity: edp
                box { from: lx - hw - pad, ly - hh - pad; size: 2 * (hw + pad), 2 * (hh + pad); corner: 16; color: mint; opacity: 7% + 9% * dgp }
                box { from: lx - hw - pad, ly - hh - pad; size: 2 * (hw + pad), 2 * (hh + pad); corner: 16; stroke: 1.6; color: mint; opacity: 55% + 45% * dgp }
                text "Clock" { at: lx - hw - pad + 14, ly - hh - pad + 16; anchor: left center; size: 12; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 5, 70% }
                //  (its monitor is not plugged in: shown here only in Edit mode, to be placed)
                text orph { at: lx + hw + pad - 14, ly - hh - pad + 16; anchor: right center; size: 12; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 5, 70%; show: orphan }
            }
            group {
                ClockFaceStyled(k, lay, d0, d1, d2, d3, lx, ly, mix(tint, mint, cy), 1, 0.4, sh * clr, wt, mint, ink, alert, faint, ob, pl, uk, deep, mk, pxk, dd)
            }
        }
    }

    surface sl2 {
        size: full, full; anchor: top_left; margin: 0; level: bottom, top while edit; screens: s2; reserve: -1; keyboard: none
        //  The face as it falls on this monitor.
        let lx = cgx - sx2
        let ly = cgy - sy2
        let on = sm2 and lx + hw + pad > 0 and lx - hw - pad < sl2.width and ly + hh + pad > 0 and ly - hh - pad < sl2.height
        //  Pressed on it here (the zone is the face; while it is dragged, the whole surface: pleamar keeps the drag going past its edge).
        zone box ez2 { from: if(dragging and pk == 2, 0, lx - hw - pad), if(dragging and pk == 2, 0, ly - hh - pad); size: if(dragging and pk == 2, sl2.width, 2 * (hw + pad)), if(dragging and pk == 2, sl2.height, 2 * (hh + pad)); corner: 16; cursor: pointer; active: edit and shown and ((on and not dragging and not carry) or (dragging and pk == 2)); label: "Move clock" }
        on press ez2 { pk = 2; pgx = sx2 + pointer.x; pgy = sy2 + pointer.y; pnx = sx2 + pointer.x; pny = sy2 + pointer.y; kx = cgx - (sx2 + pointer.x); ky = cgy - (sy2 + pointer.y); dfx = fx - (gl + (ex0 + fw / 2) * gw); dfy = fy - (gt + (ey0 + fh / 2) * gh); dragging = true }
