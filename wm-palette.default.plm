//  pleamar-wm's stock colours. This is the tracked copy: the live one is `wm-palette.plm`, which Vitreus's own logic
//  rewrites from the wallpaper (through Iris) or the theme, and which git ignores. On a fresh checkout, copy this to
//  `wm-palette.plm` (`cp wm-palette.default.plm wm-palette.plm`): pleamar-wm's scene imports it.
//  What pleamar-wm's scene takes from it: the colour of the focused window's border, and the palette its own drawing wears
//  (title bars, menus, the dock, the overview's cards, the window buttons).

library WmPalette {
    let wm_border = #e4cdad
    let wm_ink    = #f5f7f5
    let wm_faint  = #c2c7cc
    let wm_mint   = #9ed6bd
    let wm_mintlo = #6cbc9c
    let wm_minthi = #dcf8ec
    let wm_onmint = #10161a
    let wm_tint   = #1b2127
    let wm_panel  = #161a1f
    let wm_deep   = #0b0e11
    let wm_off    = #3a4048
    let wm_alert  = #ef4444
}
