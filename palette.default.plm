//  Vitreus's stock colours. This is the tracked copy: the live one is `palette.plm`, which Vitreus's own logic
//  rewrites from the wallpaper (through Iris) and which git ignores. On a fresh checkout, copy this to
//  `palette.plm` (`cp palette.default.plm palette.plm`) before the first run, since the scene imports it.
//
//  Vitreus's colours, in one place. Vitreus's own logic rewrites this file from the wallpaper (through
//  Iris) and the scene reloads in the new colours; what is here to begin with is its stock look.
//  `let`s only: a library can declare nothing else, and the scene uses these names everywhere.

library Palette {
    let ink    = #f5f7f5   // text, icons and light overlays (Iris: fg)
    let faint  = #c2c7cc   // secondary text (Iris: dim)
    let mint   = #9ed6bd   // the accent (Iris: accent)
    let mintlo = #6cbc9c   // the accent, deeper: the start of a slider's fill
    let minthi = #dcf8ec   // the accent, lighter: the end of it
    let onmint = #10161a   // text and marks that sit on the accent
    let tint   = #1b2127   // the glass (Iris: bg)
    let panel  = #161a1f   // a solid card: the output dropdown (Iris: surface)
    let deep   = #0b0e11   // sunken tracks, and shadows
    let off    = #3a4048   // a toggle that is off, a muted fill
    let alert  = #ef4444   // urgent, close, muted (Iris: red)
}
