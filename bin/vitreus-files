#!/bin/sh
# Opens the file manager (SUPER + E, and "Files" in the launcher): Vitreus's own window, files/files.plm, a pleamar window in the shell's glass. `vitreus-files [FOLDER...]` starts it in FOLDER (else the home
# folder). Each call opens a window of its own (the second one to start answers to `files-<number>` when talked to with `pleamar --say`); files are dragged between them.
#
# It is also the program the system runs when Files is the default file manager (vitreus-files.desktop, for inode/directory, which passes `%U`: file:// links, as many as were chosen), and the one
# that org.freedesktop.FileManager1's «Show in folder» ends in (bin/vitreus-filemanager). So an argument may be a path or a file:// link, and one that is a file opens the folder it is in with the file chosen; one window for each.
#
# Without pleamar or without the scene, another file manager (the D-Bus one first, which Nautilus, Dolphin, Thunar and others answer; then the programs themselves), and xdg-open last: it follows the
# inode/directory handler, which on some systems is a terminal, and which is this very program once Files is the default. So the fallbacks are tried once (VITREUS_FILES_FALLBACK marks that we are in one), and
# xdg-open is left out when it would come back here.
here=$(dirname "$(readlink -f "$0")")
scene="$here/../files/files.plm"
export PATH="$HOME/.local/bin:$PATH"
# `vitreus-files --close`, run by a Files window: closes that window and no other. The first window to start is the scene `files`, a second one `files-<its pid>`, and the program that
# runs this is the window itself ($PPID), so the name that answers with that pid is the window's.
if [ "${1:-}" = --close ]; then
    for n in files "files-$PPID"; do
        pleamar --say "$n" hello 2> /dev/null | grep -q "pid $PPID " && exec pleamar --say "$n" quit
    done
    echo "vitreus-files --close: no Files scene answers with pid $PPID" >&2
    exit 1
fi

# What was passed, as `folder` and `pick`: a file:// link is decoded (%20 and the rest), `~` is the home folder; a file is its folder, with the file's name to have chosen there
# (and so is a folder, when it was asked to be shown in its own: `--reveal`, which «Show in folder» in another program means).
reveal=false
resolve() {
    p=$1
    case $p in
        file://*)
            p=${p#file://}
            p=${p#localhost}
            if command -v python3 > /dev/null 2>&1; then
                p=$(python3 -I -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]), end="")' "$p")
            else
                p=$(printf '%s' "$p" | sed 's/%20/ /g; s/%23/#/g; s/%25/%/g')
            fi ;;
        "~") p=$HOME ;;
        "~/"*) p=$HOME/${p#"~/"} ;;
    esac
    folder=$p pick=""
    if [ -d "$p" ] && ! $reveal; then
        return
    elif [ -e "$p" ]; then
        folder=$(dirname "$p") pick=$(basename "$p")
    fi
}

# The folder, in another file manager: the one the person has through D-Bus, then the well-known ones.
fallback() {
    [ -n "${VITREUS_FILES_FALLBACK:-}" ] && return 1        # we came here from a fallback: going round again is how this loops
    export VITREUS_FILES_FALLBACK=1
    f=$1
    dbus-send --session --type=method_call --dest=org.freedesktop.FileManager1 /org/freedesktop/FileManager1 \
        org.freedesktop.FileManager1.ShowFolders array:string:"file://$f" string:"" 2> /dev/null && return 0
    for fm in nautilus dolphin thunar nemo pcmanfm pcmanfm-qt caja; do
        command -v "$fm" > /dev/null 2>&1 && { "$fm" "$f" > /dev/null 2>&1 & return 0; }
    done
    # xdg-open follows inode/directory: not when that is us
    case $(xdg-mime query default inode/directory 2> /dev/null) in
        vitreus-files.desktop) return 1 ;;
    esac
    exec xdg-open "$f"
}

[ "${1:-}" = --reveal ] && { reveal=true; shift; }
[ "$#" -gt 0 ] || set -- "$HOME"
status=0
for arg in "$@"; do
    resolve "$arg"
    [ -n "$folder" ] || folder=$HOME
    if [ -f "$scene" ] && command -v pleamar > /dev/null 2>&1; then
        FILES_START="$folder" FILES_PICK="$pick" setsid pleamar --scene "$scene" --no-hud > /dev/null 2>&1 &
    else
        fallback "$folder" || status=1
    fi
done
exit $status
