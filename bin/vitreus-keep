#!/bin/sh
# vitreus-keep SCENE.plm [LOG]: runs a pleamar scene and starts it again when it stops, for as long as the
# session lasts. The autostart lines go through it, so a shell that a monitor's sleep or a protocol error
# brought down comes back by itself instead of staying gone until the next login.
#
#   - One keeper per scene: a second one (the shell's own restart, a second autostart) sees the first and
#     leaves, and the first starts the scene again once it has stopped.
#   - A scene that is already running, started by hand, is left alone: the keeper ends.
#   - When the compositor has gone (the session ended), it ends too.
#   - Five quick failures in a row (each within 30 s of starting) and it gives up: a scene that cannot start
#     is not started forever. A quick stop that ended well (exit 0: the shell stopping a widget to start it again
#     with a new theme or typeface) is not a failure: twenty of those in a row are needed, so going through the
#     themes one after another no longer leaves a widget gone until the next login.
#   - A scene that is still running but no longer answers (its render stuck: a frozen bar that never exits) is stopped, and so
#     started again: every 30 s it is asked something only its render can answer, and three times in a row without an answer
#     in 20 s (after a minute's grace at each start) is taken as hung. `VITREUS_KEEP_WATCH=0` turns this off
#     (`VITREUS_KEEP_GRACE`, `_EVERY`, `_PATIENCE`: those seconds, for testing it).
#   - An update that replaces this script (git reset) does not reach a keeper already running: it reads the old file it opened. So
#     before each start it looks whether its file is still the one it began with, and if not runs the new one in its place (issue #67:
#     the old keeper went on starting the bar without `--screen`, and the bar was gone).
#   - To stop a scene for good, stop its keeper first (pkill -f "vitreus-keep SCENE"), then the scene.
set -u
P="${1:?usage: vitreus-keep SCENE.plm [LOG]}"
# Without LOG, the scene's own file in the shell's logs folder: the widgets went to /dev/null, so a widget that stopped or kept stopping
# left nothing to read. `/dev/null` given as LOG still means no log.
L="${2:-${XDG_DATA_HOME:-$HOME/.local/share}/pleamar/vitreus/logs/$(basename "$P" .plm).log}"
# A fresh install has no log folder yet: without it the redirects below fail and the scene never starts, silently.
mkdir -p "$(dirname "$L")" 2> /dev/null
export PATH="$HOME/.local/bin:$PATH"
name=$(basename "$P" .plm)
run="${XDG_RUNTIME_DIR:-/tmp}"
say() { printf 'vitreus-keep · %s · %s\n' "$name" "$*" >> "$L"; }
running() { pgrep -f "^([^ ]*/)?pleamar --scene $P( |\$)" > /dev/null; }
# The display is there only if something answers on its socket: a compositor that has gone (pleamar-wm logged out of)
# can leave the socket file behind, and then every start panics with NoCompositor.
alive() {
    [ -n "${WAYLAND_DISPLAY:-}" ] || return 1
    case "$WAYLAND_DISPLAY" in /*) s="$WAYLAND_DISPLAY" ;; *) s="$run/$WAYLAND_DISPLAY" ;; esac
    [ -S "$s" ] || return 1
    command -v socat > /dev/null 2>&1 || return 0
    socat -u OPEN:/dev/null "UNIX-CONNECT:$s" > /dev/null 2>&1
}

data="${XDG_DATA_HOME:-$HOME/.local/share}/pleamar/vitreus"
# With the bar down the left (the Frame), the room round the windows is Hyprland's own gaps, not the layer's reserved zone, so it stays
# after the shell has gone. When the keeper stops for good, it gives the gaps back (gaps-undo.lua, written by the shell) and takes them
# out of vitreus_colors.lua, so a `hyprctl reload` does not bring them back either. Not between starts: the shell sets them again itself.
undo_gaps() {
    [ "$name" = vitreus ] || return 0
    [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || return 0
    [ -s "$data/gaps-undo.lua" ] || return 0
    hyprctl eval "$(cat "$data/gaps-undo.lua")" > /dev/null 2>&1 && say "gave Hyprland's gaps back"
    sed -i '/gaps_out/d' "$data/vitreus_colors.lua" "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/vitreus_colors.lua" 2> /dev/null
}

# The hang watch, run beside the scene (pid $1). `--say` reaches a scene by its file's name; `wait` is answered by the scene's render,
# which is what freezes, while `hello` would be answered by a thread that keeps going. A healthy shell answers in well under a second
# (even painting once a second for a surface the compositor does not show); one that misses three in a row is killed, and the loop
# below starts it again as after any other stop.
watch_hang() {
    [ "${VITREUS_KEEP_WATCH:-1}" = 0 ] && return 0
    # A first start whose logic load was cut off (pleamar ends any handler over 2 s, and a cold login can take that long) runs with no
    # logic at all: default colours, full size, dead buttons, yet it answers `--say`, so the check below calls it healthy (issue #68).
    # The log says so: no "running in" line, but "the previous one stays as it was". Looked for in what this start wrote ($2 = the
    # log's size at the start), for the first minute; the scene is then stopped and started again, when the logic loads in ~70 ms.
    if [ "$L" != /dev/null ] && [ "$name" = vitreus ]; then
        i=0
        while [ "$i" -lt "${VITREUS_KEEP_GRACE:-60}" ] && kill -0 "$1" 2> /dev/null; do
            new=$(tail -c +"$(( ${2:-0} + 1 ))" "$L" 2> /dev/null)
            case "$new" in
                *"vitreus.luau running in"*) break ;;
                *"the previous one stays as it was"*)
                    say "its logic did not load (cut off): stopping it, to start it again"
                    kill -9 "$1" 2> /dev/null
                    return 0 ;;
            esac
            sleep 2; i=$((i + 2))
        done
        [ "$i" -lt "${VITREUS_KEEP_GRACE:-60}" ] && sleep $(( ${VITREUS_KEEP_GRACE:-60} - i ))
    else
        sleep "${VITREUS_KEEP_GRACE:-60}"
    fi
    misses=0
    while kill -0 "$1" 2> /dev/null; do
        a=$(timeout "${VITREUS_KEEP_PATIENCE:-20}" pleamar --say "$name" "wait screen.width > 0 5s" 2> /dev/null)
        case "$a" in
            yes*) misses=0 ;;
            *) misses=$((misses + 1)) ;;
        esac
        if [ "$misses" -ge 3 ]; then
            say "not answering for over a minute (hung): stopping it, to start it again"
            kill -9 "$1" 2> /dev/null
            return 0
        fi
        sleep "${VITREUS_KEEP_EVERY:-30}"
    done
}

exec 9> "$run/vitreus-keep-$name.lock"
flock -n 9 || exit 0
spid=""; wpid=""
self=$(readlink -f "$0")
stamp() { stat -L -c '%i %Y %s' "$self" 2> /dev/null; }
began=$(stamp)
# Stopped by hand (pkill -f "vitreus-keep SCENE", then the scene): it gets here once the scene it is waiting on has ended.
trap '[ -n "$wpid" ] && kill "$wpid" 2> /dev/null; [ -n "$spid" ] && wait "$spid" 2> /dev/null; undo_gaps; exit 0' TERM INT HUP

quick=0
while :; do
    # Its own file changed (an update): the new one takes over, with the lock let go so it can take it. Not a half-written file (`sh -n`).
    now=$(stamp)
    if [ -n "$now" ] && [ "$now" != "$began" ] && sh -n "$self" 2> /dev/null; then
        say "its script was updated: running the new one"
        exec 9>&-
        exec "$self" "$P" "$L"
    fi
    if running; then
        say "already running: left to whoever started it"
        exit 0
    fi
    alive || exit 0
    # The log is appended to for as long as the session lasts (a long one wrote tens of MB of "slow frame" lines): past 8 MB it is kept
    # as LOG.1 (one generation, replacing the one before) and started again, at a start of the scene, never while it is writing.
    if [ "$L" != /dev/null ] && [ -f "$L" ] && [ "$(stat -c %s "$L" 2> /dev/null || echo 0)" -gt 8000000 ]; then
        mv -f "$L" "$L.1" 2> /dev/null
    fi
    started=$(date +%s)
    logsize=$(stat -c %s "$L" 2> /dev/null || echo 0)
    # The shell's typeface (Settings > Theme): Glass is Space Grotesk and Retro a VCR face, unless the Theme page's font picker chose another. pleamar's
    # font names are fixed in the scenes, so another typeface is shown by starting it with a font setup where "Space Grotesk" is that one (bin/vitreus-fonts
    # makes it). Any trouble there and the shell keeps its own font.
    # The themes (themes/*.toml and the person's own folder) first: the font setup and the shell both read the list it leaves in the data folder.
    "$(dirname "$(readlink -f "$0")")/vitreus-themes" "$data" 2>/dev/null || true
    # A scene that draws only in "Space Grotesk" says so with a line `// vitreus-fonts: lean`, and is started with a font setup of the person's own
    # fonts and two fallbacks instead of every font on the system: pleamar reads every font fontconfig names at each start (no cache), which took
    # several seconds per scene at login, with all of them starting at once (bin/vitreus-fonts).
    lean=""
    grep -qE '^//[[:space:]]*vitreus-fonts:[[:space:]]*lean' "$P" 2> /dev/null && lean="--lean"
    # shellcheck disable=SC2086
    fonts=$("$(dirname "$(readlink -f "$0")")/vitreus-fonts" "$data" $lean 2>/dev/null) || fonts=""
    # Settings > Display > Graphics card keeps its choice in gpu.json, for the shell itself: on, it is drawn on the discrete card (PLEAMAR_GPU=high),
    # off, on the integrated one. Without the file the shell is drawn where it was started, as the autostart line says.
    gpu_set=""; gpu_unset=""
    if [ "$name" = vitreus ] && [ -f "$data/gpu.json" ]; then
        if grep -q '"discrete"[[:space:]]*:[[:space:]]*true' "$data/gpu.json" 2> /dev/null; then gpu_set="PLEAMAR_GPU=high"; else gpu_unset="-u PLEAMAR_GPU"; fi
    fi
    # The bar's copies go to its monitors by name (`--screen`, copy K to the K-th): the list the shell leaves in bar-screens (logic/bar_monitors.luau).
    # Without it pleamar hands them out in the order the compositor announced the monitors, and one switched off and on again is announced last:
    # the bar's copy landed on another monitor, where it was closed, and the bar was gone until the next login (issue #67).
    set --
    if [ "$name" = vitreus ] && [ -s "$data/bar-screens" ]; then
        scr=$(head -n 1 "$data/bar-screens" | tr -d ' \t')
        [ -n "$scr" ] && set -- --screen "$scr"
    fi
    # env takes its options (-u) before its NAME=value words: after the first of those, the next word is the command.
    # In the background, so the hang watch can run beside it; `wait` gives its exit code as running it in the foreground did.
    if [ -n "$fonts" ]; then
        # shellcheck disable=SC2086
        env $gpu_unset $gpu_set FONTCONFIG_FILE="$fonts" pleamar --scene "$P" --no-hud "$@" >> "$L" 2>&1 9>&- &
    else
        # Not the font setup this keeper itself was started under (a theme change since): that one is no longer the shell's typeface.
        # shellcheck disable=SC2086
        env $gpu_unset -u FONTCONFIG_FILE $gpu_set pleamar --scene "$P" --no-hud "$@" >> "$L" 2>&1 9>&- &
    fi
    spid=$!
    watch_hang "$spid" "$logsize" 9>&- < /dev/null &
    wpid=$!
    wait "$spid"
    code=$?
    kill "$wpid" 2> /dev/null
    wpid=""
    alive || exit 0
    # (a failure weighs four, a stop that ended well one, and twenty is the end: five failures, or twenty clean stops)
    if [ $(( $(date +%s) - started )) -lt 30 ]; then
        if [ "$code" -eq 0 ]; then quick=$((quick + 1)); else quick=$((quick + 4)); fi
    else quick=0; fi
    if [ "$quick" -ge 20 ]; then
        say "kept stopping within 30 s of starting (last exit $code): giving up"
        undo_gaps
        exit 1
    fi
    # A bar of more copies than fit in one scene (`screens: each max N`: every copy is the whole scene again) does not load at all, so
    # its logic never gets to shrink it (issue #60: three monitors, no bar). It is put back to one copy, and the logic grows it again
    # to what fits.
    if [ "$name" = vitreus ] && [ "$L" != /dev/null ] && tail -n 40 "$L" 2> /dev/null | grep -q "properties, and no more than" \
        && grep -qE "^    surface \{.*screens: each max [2-9];" "$P"; then
        sed -i --follow-symlinks -E '/^    surface \{/s/screens: each max [0-9]+;/screens: each max 1;/' "$P" && say "too many copies to load: back to each max 1"
    fi
    say "stopped (exit $code): starting it again"
    sleep 2
done
