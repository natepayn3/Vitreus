#!/usr/bin/env python3
"""vitreus-sysmon: what the machine is doing, one line of JSON a second, for Settings > System monitor.

It is started by the shell when that page opens and stopped when it closes, so nothing runs while nobody looks. It reads
/proc and /sys directly (no other program, no root); the GPU comes from `nvidia-smi` (NVIDIA) or sysfs (AMD) when there is
one. Standard library only.

    vitreus-sysmon            print a line every second until stopped
    vitreus-sysmon --once     print one line and exit (for looking at what it reports)

Each line is a JSON object: cpu (total, per core, frequency, load), mem, net, disk (io, mounts), gpu (or null), temps, fans,
procs (the busiest), up (uptime, seconds) and, on the first line only, info (the CPU's name, the host, the kernel).
"""
import glob
import json
import os
import platform
import re
import signal
import socket
import subprocess
import sys
import time

TICKS = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")
NCPU = os.cpu_count() or 1


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return default


def cpu_times():
    """{'cpu': (busy, total), 'cpu0': ...} from /proc/stat."""
    out = {}
    for line in read("/proc/stat").splitlines():
        if not line.startswith("cpu"):
            continue
        parts = line.split()
        vals = [int(x) for x in parts[1:9]]
        idle = vals[3] + vals[4]
        total = sum(vals)
        out[parts[0]] = (total - idle, total)
    return out


def meminfo():
    m = {}
    for line in read("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        try:
            m[k] = int(v.split()[0])
        except (ValueError, IndexError):
            pass
    total = m.get("MemTotal", 0)
    avail = m.get("MemAvailable", m.get("MemFree", 0))
    cache = m.get("Buffers", 0) + m.get("Cached", 0) + m.get("SReclaimable", 0) - m.get("Shmem", 0)
    return {
        "total": total, "used": max(0, total - avail), "cache": max(0, cache), "free": m.get("MemFree", 0),
        "swap_total": m.get("SwapTotal", 0), "swap_used": max(0, m.get("SwapTotal", 0) - m.get("SwapFree", 0)),
    }


def default_iface():
    best = None
    for line in read("/proc/net/route").splitlines()[1:]:
        f = line.split()
        if len(f) > 7 and f[1] == "00000000":
            if best is None or int(f[6]) < best[0]:
                best = (int(f[6]), f[0])
    return best[1] if best else None


def net_counters(iface):
    for line in read("/proc/net/dev").splitlines()[2:]:
        name, _, rest = line.partition(":")
        if name.strip() == iface:
            f = rest.split()
            return int(f[0]), int(f[8])
    return None


DISK_RE = re.compile(r"^(nvme\d+n\d+|sd[a-z]+|vd[a-z]+|xvd[a-z]+|mmcblk\d+)$")


def disk_counters():
    rd = wr = 0
    for line in read("/proc/diskstats").splitlines():
        f = line.split()
        if len(f) > 9 and DISK_RE.match(f[2]):
            rd += int(f[5]) * 512
            wr += int(f[9]) * 512
    return rd, wr


REAL_FS = {"ext4", "ext3", "ext2", "btrfs", "xfs", "f2fs", "vfat", "exfat", "ntfs", "ntfs3", "zfs", "jfs", "reiserfs"}


def mounts():
    seen = {}
    for line in read("/proc/mounts").splitlines():
        f = line.split()
        if len(f) < 3 or f[2] not in REAL_FS or not f[0].startswith("/dev/"):
            continue
        dev, mnt = f[0], f[1].replace("\\040", " ")
        if dev not in seen or len(mnt) < len(seen[dev]):
            seen[dev] = mnt
    out = []
    for dev, mnt in seen.items():
        try:
            st = os.statvfs(mnt)
        except OSError:
            continue
        total = st.f_blocks * st.f_frsize
        free = st.f_bavail * st.f_frsize
        if total <= 0:
            continue
        out.append({"m": mnt, "dev": dev.replace("/dev/", ""), "total": total, "used": total - free})
    out.sort(key=lambda d: (d["m"] != "/", d["m"]))
    return out[:6]


def gpu():
    try:
        r = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw,power.limit,fan.speed,clocks.sm,clocks.mem",
             "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=3)
        if r.returncode == 0 and r.stdout.strip():
            f = [x.strip() for x in r.stdout.strip().splitlines()[0].split(",")]

            def num(s):
                try:
                    return float(s)
                except ValueError:
                    return None
            return {"name": f[0], "util": num(f[1]), "mem_used": num(f[2]), "mem_total": num(f[3]), "temp": num(f[4]),
                    "power": num(f[5]), "power_max": num(f[6]), "fan": num(f[7]), "clock": num(f[8]), "mem_clock": num(f[9])}
    except (OSError, subprocess.TimeoutExpired):
        pass
    for card in sorted(glob.glob("/sys/class/drm/card[0-9]/device")):
        busy = read(card + "/gpu_busy_percent").strip()
        if busy:
            used = read(card + "/mem_info_vram_used").strip()
            total = read(card + "/mem_info_vram_total").strip()
            return {"name": "AMD GPU", "util": float(busy), "mem_used": int(used) / 1048576 if used else None,
                    "mem_total": int(total) / 1048576 if total else None, "temp": None, "power": None, "power_max": None,
                    "fan": None, "clock": None, "mem_clock": None}
    return None


def temps_and_fans():
    temps, fans = [], []
    for h in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        name = read(h + "/name").strip()
        for t in sorted(glob.glob(h + "/temp*_input")):
            try:
                c = int(read(t).strip()) / 1000.0
            except ValueError:
                continue
            label = read(t.replace("_input", "_label")).strip() or name
            temps.append({"chip": name, "l": label, "c": round(c, 1)})
        for fan in sorted(glob.glob(h + "/fan*_input")):
            try:
                rpm = int(read(fan).strip())
            except ValueError:
                continue
            label = read(fan.replace("_input", "_label")).strip() or name
            fans.append({"l": label, "rpm": rpm})
    return temps, fans


def nice_temps(temps):
    """A short list of the ones worth showing: the CPU package, its hottest core, the drives, and what else a chip reports."""
    out = []
    core = [t for t in temps if t["chip"] == "coretemp" and t["l"].startswith("Core")]
    pkg = [t for t in temps if t["chip"] == "coretemp" and t["l"].startswith("Package")]
    if pkg:
        out.append({"l": "CPU package", "c": pkg[0]["c"]})
    if core:
        out.append({"l": "Hottest core", "c": max(t["c"] for t in core)})
    for t in temps:
        if t["chip"] == "nvme" and t["l"] in ("Composite", "nvme"):
            out.append({"l": "NVMe drive", "c": t["c"]})
    n = 0
    for t in temps:
        if t["chip"] in ("coretemp", "nvme") or t["c"] <= 0:
            continue
        if t["chip"] in ("acpitz", "k10temp", "zenpower") or t["chip"].startswith("dell") or t["chip"].startswith("thinkpad"):
            n += 1
            label = t["l"] if t["l"] != t["chip"] else "Board sensor %d" % n
            out.append({"l": label, "c": t["c"]})
    return out[:8]


def procs(prev, now, elapsed, mem_total_kb):
    """The busiest processes: CPU from the change in their ticks, memory from their resident pages."""
    cur = {}
    rows = []
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open("/proc/%s/stat" % d) as f:
                raw = f.read()
            rp = raw.rindex(")")
            comm = raw[raw.index("(") + 1:rp]
            fields = raw[rp + 2:].split()
            ticks = int(fields[11]) + int(fields[12])
            rss = int(fields[21]) * PAGE
        except (OSError, ValueError, IndexError):
            continue
        cur[d] = ticks
        if d in prev and elapsed > 0:
            cpu = (ticks - prev[d]) / TICKS / elapsed * 100.0
            rows.append((cpu, comm, rss))
    # One line for each program, not each process: a browser is dozens of them.
    by = {}
    for cpu, comm, rss in rows:
        a = by.setdefault(comm, [0.0, 0])
        a[0] += cpu
        a[1] += rss
    ranked = sorted(((v[0], k, v[1]) for k, v in by.items()), reverse=True)
    top = [{"n": c[:22], "cpu": round(p, 1), "mem": round(r / 1024 / mem_total_kb * 100, 1) if mem_total_kb else 0} for p, c, r in ranked[:8]]
    return cur, top


def info():
    model = ""
    for line in read("/proc/cpuinfo").splitlines():
        if line.startswith("model name"):
            model = line.partition(":")[2].strip()
            break
    return {"cpu": model, "threads": NCPU, "host": socket.gethostname(), "kernel": platform.release()}


def main():
    once = "--once" in sys.argv
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGPIPE, lambda *_: sys.exit(0))
    iface = default_iface()
    t0 = time.time()
    c0 = cpu_times()
    net0 = net_counters(iface) if iface else None
    dk0 = disk_counters()
    p0, _ = procs({}, None, 0, 1)
    tp = t0
    last_proc, last_gpu, last_temps, last_mounts = None, None, None, None
    top, g, temps, fans, mnts = [], None, [], [], []
    first = True
    tick = 0
    time.sleep(0.25 if once else 1.0)
    while True:
        now = time.time()
        dt = max(now - t0, 0.001)
        c1 = cpu_times()

        def pct(key):
            a, b = c0.get(key), c1.get(key)
            if not a or not b or b[1] == a[1]:
                return 0.0
            return max(0.0, min(100.0, (b[0] - a[0]) * 100.0 / (b[1] - a[1])))
        cores = [round(pct("cpu%d" % i), 1) for i in range(NCPU)]
        mhz = []
        for i in range(NCPU):
            v = read("/sys/devices/system/cpu/cpu%d/cpufreq/scaling_cur_freq" % i).strip()
            mhz.append(int(v) // 1000 if v.isdigit() else 0)
        rx = tx = 0
        net1 = net_counters(iface) if iface else None
        if net0 and net1:
            rx, tx = (net1[0] - net0[0]) / dt, (net1[1] - net0[1]) / dt
        dk1 = disk_counters()
        dread, dwrite = (dk1[0] - dk0[0]) / dt, (dk1[1] - dk0[1]) / dt
        mem = meminfo()
        if tick % 2 == 0:
            p1, top = procs(p0, now, now - tp, mem["total"])
            p0, tp = p1, now
            g = gpu()
        if tick % 3 == 0:
            temps, fans = temps_and_fans()
            temps = nice_temps(temps)
        if tick % 10 == 0:
            mnts = mounts()
        line = {
            "cpu": {"total": round(pct("cpu"), 1), "cores": cores, "mhz": mhz, "load": [float(x) for x in read("/proc/loadavg").split()[:3]]},
            "mem": mem,
            "net": {"iface": iface or "", "rx": round(rx), "tx": round(tx), "rx_total": net1[0] if net1 else 0, "tx_total": net1[1] if net1 else 0},
            "disk": {"read": round(dread), "write": round(dwrite), "mounts": mnts},
            "gpu": g, "temps": temps, "fans": fans, "procs": top,
            "up": int(float(read("/proc/uptime", "0").split()[0])),
        }
        if first:
            line["info"] = info()
            first = False
        sys.stdout.write(json.dumps(line, separators=(",", ":")) + "\n")
        sys.stdout.flush()
        if once:
            return 0
        c0, net0, dk0, t0 = c1, net1, dk1, now
        tick += 1
        time.sleep(max(0.05, 1.0 - (time.time() - now)))


if __name__ == "__main__":
    sys.exit(main())
