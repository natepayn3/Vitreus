#!/bin/sh
# Opens a picture in View, Vitreus's picture viewer (view/view.plm): `vitreus-view FILE` (or a folder: its first picture), or a video, or a web link to one
# (`vitreus-view https://...`: played in View's player). Each call opens a window of its own.
#
# It is the program the system runs for pictures once View is the default (view/integrate.sh --set writes vitreus-view.desktop, which passes `%U`: file:// links,
# as many as were chosen), so an argument may be a path or a file:// link. Only the first one is opened: the others of its folder are a key away.
#
# Started from outside the shell (a browser, Files, a terminal), it sets up what the shell's own scenes are started with: the shell's typeface (below)
# and ~/.local/bin on the PATH. The look and the glass are asked of Vitreus by the scene itself.
# Without pleamar or without the scene, the picture goes to whatever else opens pictures (xdg-open, unless that would come back here).
here=$(dirname "$(readlink -f "$0")")
shell=$(cd "$here/.." && pwd)
scene="$shell/view/view.plm"
export PATH="$HOME/.local/bin:$PATH"

# The player's look: the theme's colours (../palette.plm) and the look Vitreus has (as View asks it: 1 Retro, 2 UwU, 3 Cyber and Proxy, 7 Doodle; the rest
# Glass), as the --script-opts of View's player (mpv, with view/player as its config folder: its keys, and the controls drawn as View's).
player_opts() {
    pal="$shell/palette.plm"
    o=",vitreus-player-palette=$pal,vitreus-player-shell=$shell"           # (watched by the player: a new theme reaches it while it plays)
    for k in ink faint mint minthi onmint tint panel deep alert; do
        c=$(sed -n "s/^ *let $k *= *#\([0-9a-fA-F]\{6\}\).*/\1/p" "$pal" 2> /dev/null | head -n 1)
        [ -n "$c" ] && o="$o,vitreus-player-$k=$c"
    done
    lv=$(pleamar --say vitreus "get look_v" 2> /dev/null | grep -o -- '-\?[0-9]\+' | head -n 1)
    case $lv in 1) look=1 ;; 2) look=2 ;; 3) look=3 ;; 7) look=4 ;; *) look=0 ;; esac
    [ -n "${VIEW_LOOK:-}" ] && look=$VIEW_LOOK                               # (to try a look without changing the theme)
    printf 'vitreus-player-look=%s%s' "$look" "$o"
}

# Handed over by View itself (its Play, on a video or a link): the player takes View's place, and View comes back when the player closes.
# $VIEW_AT is where View's window was ("floating x y w h", from Hyprland), $VIEW_BACK what View showed (it is opened on that again). Neither is kept
# for the View that comes back, which hands over its own when it plays something.
at=${VIEW_AT:-}
back=${VIEW_BACK:-}
stay=${VIEW_STAY:-}                  # View coming back after the player: View itself, even on a video (not the player again)
from=${VIEW_FROM:-}                  # the View window handing over (its name for `pleamar --say`): it closes once the player's window is up
unset VIEW_AT VIEW_BACK VIEW_STAY VIEW_FROM

# place PID: waits for the window of that process (30 seconds at most: a link's player opens once yt-dlp has found the video, and not at all if that
# process ends first), floats it where View was (Hyprland, and only when View floated: a tiled View leaves its tile to the player by itself), and
# says so to the View handing over (`bye`), which closes then. Without Hyprland there is nothing to wait on: View is told at once.
place() {
    if ! command -v hyprctl > /dev/null 2>&1 || ! command -v jq > /dev/null 2>&1; then
        [ -n "$from" ] && pleamar --say "$from" "emit bye" > /dev/null 2>&1
        return 0
    fi
    i=0; a=""
    while [ $i -lt 300 ] && [ -d "/proc/$1" ]; do
        a=$(hyprctl -j clients 2> /dev/null | jq -r --argjson p "$1" '.[] | select(.pid == $p) | .address' 2> /dev/null | head -n 1)
        [ -n "$a" ] && break
        sleep 0.1; i=$((i + 1))
    done
    [ -n "$a" ] || return 0
    if [ -n "$at" ]; then
        set -- $at
        [ "$1" = 1 ] && hyprctl --batch "dispatch setfloating address:$a; dispatch resizewindowpixel exact $4 $5,address:$a; dispatch movewindowpixel exact $2 $3,address:$a" > /dev/null 2>&1
    fi
    [ -n "$from" ] && pleamar --say "$from" "emit bye" > /dev/null 2>&1
    return 0
}

# player ARGS...: View's player (mpv, view/player as its config folder) with these, put where View was; when it closes, View again on what it showed.
player() {
    so=$(player_opts)
    (
        mpv --config-dir="$shell/view/player" --script-opts="$so" "$@" > /dev/null 2>&1 < /dev/null &
        mp=$!
        place "$mp" &
        pl=$!
        wait "$mp"
        kill "$pl" 2> /dev/null
        [ -n "$back" ] && VIEW_AT="$at" VIEW_STAY=1 exec "$here/vitreus-view" "$back"
    ) > /dev/null 2>&1 &
}

p=${1:-.}

# A web link (a video's page, or the video itself) goes to View's player too: mpv streams it, finding the video on the page with yt-dlp.
# There is nothing of it to show in View itself, so without mpv it goes to the browser.
case $p in
    http://*|https://*)
        if [ -n "$stay" ]; then
            p=.                          # (never: View comes back on a file or a folder; but not on the link again)
        elif command -v mpv > /dev/null 2>&1; then
            player -- "$p"
            exit 0
        else
            exec xdg-open "$p"
        fi ;;
esac

case $p in
    file://*)
        p=${p#file://}
        p=${p#localhost}
        if command -v python3 > /dev/null 2>&1; then
            p=$(python3 -I -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]), end="")' "$p")
        else
            p=$(printf '%s' "$p" | sed 's/%20/ /g; s/%23/#/g; s/%25/%/g')
        fi ;;
    "~") p=$HOME ;;
    "~/"*) p=$HOME/${p#"~/"} ;;
esac
case $p in /*) ;; *) p="$(pwd)/$p" ;; esac

# An empty View that sent the person to Files to find a picture (its button under the cat) waits for it: the picture chosen there goes to that window,
# not to a new one, and so does a video (that View hands it to the player in its own place, as its Play does). It leaves its name in the runtime folder (`waiting`); it is asked whether it is still empty, and then told which picture to open.
w="${XDG_RUNTIME_DIR:-/tmp}/vitreus-view/waiting"
if [ -z "$stay" ] && [ -f "$p" ] && [ -r "$w" ] && command -v pleamar > /dev/null 2>&1; then
    n=$(head -n 1 "$w")
    rm -f "$w"
    if [ -n "$n" ] && [ "$(pleamar --say "$n" "get ready" 2> /dev/null)" = false ]; then
        pleamar --say "$n" "text open_req $p" > /dev/null 2>&1 && exit 0
    fi
fi

# A video goes to View's player (player_opts, above). The other videos of its folder come after it in its list, in the order Files gives names, so the one before and after are a key away.
VIDEOS="mp4 m4v mkv webm mov avi wmv flv mpg mpeg m2ts mts ts ogv 3gp 3g2 vob divx f4v"
is_video() {
    e=$(printf '%s' "${1##*.}" | tr '[:upper:]' '[:lower:]')
    for v in $VIDEOS; do [ "$e" = "$v" ] && return 0; done
    return 1
}
if [ -z "$stay" ] && [ -f "$p" ] && is_video "$p" && command -v mpv > /dev/null 2>&1; then
    dir=$(dirname "$p")
    list=$(cd "$dir" 2> /dev/null && for f in *; do [ -f "$f" ] && is_video "$f" && printf '%s\n' "$f"; done | LC_ALL=C sort -f -V)
    start=$(printf '%s\n' "$list" | grep -n -x -F -- "$(basename "$p")" | head -n 1 | cut -d: -f1)
    if [ -n "$start" ]; then
        pl=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/vitreus-view-list.XXXXXX")
        printf '%s\n' "$list" | while IFS= read -r f; do printf '%s/%s\n' "$dir" "$f"; done > "$pl"       # (not sed: an & or | in the folder's name would be read as sed's own)
        ( sleep 30; rm -f "$pl" ) > /dev/null 2>&1 &
        player --playlist="$pl" --playlist-start=$((start - 1))
    else
        player -- "$p"
    fi
    exit 0
fi

if [ ! -f "$scene" ] || ! command -v pleamar > /dev/null 2>&1; then
    [ -n "${VITREUS_VIEW_FALLBACK:-}" ] && exit 1
    export VITREUS_VIEW_FALLBACK=1
    for v in loupe eog gwenview ristretto imv feh; do command -v "$v" > /dev/null 2>&1 && exec "$v" "$p"; done
    case $(xdg-mime query default image/png 2> /dev/null) in vitreus-view.desktop) exit 1 ;; esac
    exec xdg-open "$p"
fi

# The typeface: the one the shell is drawn in now. The shell takes a new one only when it starts again (Settings > Theme > Apply), so the font setup it was
# started with is read from it (its FONTCONFIG_FILE, or none: Space Grotesk itself); without the shell running, what bin/vitreus-fonts makes of the settings.
# Whatever the program that started View had (Files started under another theme, say) is not kept.
unset FONTCONFIG_FILE
sp=$(pgrep -f "pleamar --scene $shell/vitreus.plm" | head -n 1)
if [ -n "$sp" ] && [ -r "/proc/$sp/environ" ]; then
    fc=$(tr '\0' '\n' < "/proc/$sp/environ" | sed -n 's/^FONTCONFIG_FILE=//p' | head -n 1)
    [ -n "$fc" ] && [ -f "$fc" ] && export FONTCONFIG_FILE="$fc"
else
    fc=$("$shell/bin/vitreus-fonts" "${XDG_DATA_HOME:-$HOME/.local/share}/pleamar/vitreus" 2> /dev/null) && [ -n "$fc" ] && export FONTCONFIG_FILE="$fc"
fi
# Each window answers to a name of its own (for the hand-over above).
VIEW_START="$p" VIEW_SHELL="$shell" VIEW_NAME="view-$$" setsid pleamar --scene "$scene" --no-hud --answer-as "view-$$" > /dev/null 2>&1 &
[ -n "$at" ] && from="" place $!
