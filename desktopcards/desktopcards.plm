language 0.1
import "../palette-live.plm"

//  The desktop's calendar and reminders: two cards of glass on the bottom layer (above the wallpaper, under every window), in one scene since they place and drag the same way.
//  Each takes a block of the 28 x 16 grid of the desktop (inside the bar's frame and a 16 px margin) and sits at the cell its settings say; in Edit mode (`edit`, which the desktop editor sets) it is framed
//  and dragged in place, a cell at a time, even to another monitor. The editor's tiles switch them on and off (`cal_shown`, `rem_shown`).
//  Calendar: the month, with today lit; the arrows turn the month and the title brings it back. Reminders: a list to tick off, with a field to add to it.
//  Their facts and the lists are kept in ~/.local/share/pleamar/desktopcards (see desktopcards.luau).
//  THIS FILE IS WRITTEN BY gen.py: edit that and run it.

scene DesktopCards {
    surface { size: full, full; anchor: top_left; margin: 0; level: bottom, top while edit; screens: each max 4; reserve: -1; keyboard: on_demand }

    permissions { services: "clock", "files", "files.write"; run: "pleamar", "hyprctl", "socat", "printenv" }

    fact pal_ink_r = 0.9608   // #f5f7f5
    fact pal_ink_g = 0.9686
    fact pal_ink_b = 0.9608
    fact pal_faint_r = 0.7608   // #c2c7cc
    fact pal_faint_g = 0.7804
    fact pal_faint_b = 0.8000
    fact pal_mint_r = 0.6196   // #9ed6bd
    fact pal_mint_g = 0.8392
    fact pal_mint_b = 0.7412
    fact pal_mintlo_r = 0.4235   // #6cbc9c
    fact pal_mintlo_g = 0.7373
    fact pal_mintlo_b = 0.6118
    fact pal_minthi_r = 0.8627   // #dcf8ec
    fact pal_minthi_g = 0.9725
    fact pal_minthi_b = 0.9255
    fact pal_onmint_r = 0.0627   // #10161a
    fact pal_onmint_g = 0.0863
    fact pal_onmint_b = 0.1020
    fact pal_tint_r = 0.1059   // #1b2127
    fact pal_tint_g = 0.1294
    fact pal_tint_b = 0.1529
    fact pal_panel_r = 0.0863   // #161a1f
    fact pal_panel_g = 0.1020
    fact pal_panel_b = 0.1216
    fact pal_deep_r = 0.0431   // #0b0e11
    fact pal_deep_g = 0.0549
    fact pal_deep_b = 0.0667
    fact pal_off_r = 0.2275   // #3a4048
    fact pal_off_g = 0.2510
    fact pal_off_b = 0.2824
    fact pal_alert_r = 0.9373   // #ef4444
    fact pal_alert_g = 0.2667
    fact pal_alert_b = 0.2667

    fact edit = false          // the desktop editor is open: the cards are framed and can be dragged
    fact room_t = 0            // the room the bar's frame takes round the screen (Vitreus tells it, in pixels): the grid stays out of it
    fact room_r = 0
    fact room_b = 0
    fact room_l = 0
    shader paper = file "../paper.wgsl"
    fact obs = false           // Vitreus has its glass off: flat obsidian
    fact look = 0              // the shell's theme (Vitreus says so): 0 Glass, 1 Retro, 2 UwU, 3 Cyber; Retro and UwU are not glass, so the cards are plastic plates there, like the bar; Cyber is glass
    prop ob = 0 ~calm
    follow ob = if(obs or look == 1 or look == 2 or look == 4 or look == 5 or look == 6 or look == 7, 1, 0)
    prop pl = 0 ~calm
    follow pl = if(look == 1 or look == 2 or look == 4 or look == 5 or look == 6 or look == 7, 1, 0)
    prop mk = 0 ~calm
    follow mk = if(look == 4, 1, 0)         // Milkbox: one pale raised material, no outline, a white light up and left and a soft shade down and right
    prop pxk = 0 ~calm
    follow pxk = if(look == 5, 1, 0)        // Proxy: a flat dark plate with a thin pale outline and a hard offset edge
    prop ppk = 0 ~calm
    prop dd = 0 ~calm
    follow dd = if(look == 7, 1, 0)         // Doodle: a cream plate with a thick black outline
    follow ppk = if(look == 6, 1, 0)       // Paper: a worn sheet of cream paper, taped down (paper.wgsl)
    prop uk = 0 ~calm
    follow uk = if(look == 2, 1, 0)
    prop cyk = 0 ~calm
    follow cyk = if(look == 3, 1, 0)       // Cyber is glass, with its HUD marks on top (corner brackets, a hairline, a ruler of ticks) and squarer corners, as on the bar's drawers
    prop edp = 0 ~calm
    follow edp = if(edit, 1, 0)
    //  Where the monitors lie in the desktop (logical pixels) and how big they are, up to four, by the scene's copies (the logic asks `hyprctl`; one that is not there is 0 x 0).
    fact m0x = 0
    fact m0y = 0
    fact m0w = 0
    fact m0h = 0
    fact m1x = 0
    fact m1y = 0
    fact m1w = 0
    fact m1h = 0
    fact m2x = 0
    fact m2y = 0
    fact m2w = 0
    fact m2h = 0
    fact m3x = 0
    fact m3y = 0
    fact m3w = 0
    fact m3h = 0

    let gnx = 28           // the grid: 28 columns and 16 rows, from the bar's frame (`room_*`) plus a 16 px margin
    let gny = 16
    let gm = 16
    let gl = gm + room_l
    let gt = gm + room_t
    let gr = gm + room_r
    let gb = gm + room_b
    let mi = clamp(screen.index, 0, 3)
    let scw = pick(mi, m0w, m1w, m2w, m3w)
    let sch = pick(mi, m0h, m1h, m2h, m3h)
    let gw = (max(scw, 800) - gl - gr) / gnx
    let gh = (max(sch, 600) - gt - gb) / gny

    //  Calendar: the month the logic worked out (`cal_title`, and 42 days from the Monday before the 1st).
    text cal_title = ""
    text cal_week = ""
    model cal_days max 42 { d: number; k: number }       // k: 0 another month, 1 a day, 2 today, 3 a weekend day
    event cal_nav ->                                    // -1 the month before, 1 the month after, 0 this month

    //  Reminders: the list (`todos`, what the logic keeps), the line being written, and what to do with them.
    model todos max 12 { t: text; done: number }
    text rem_sub = ""
    text rem_new = ""
    event rem_toggle ->        // a row, by position
    event rem_add ->
    event rem_clear ->

    //  ---- Calendar: 6 x 6 cells, by default at 0, 0 ----
    fact cal_shown = false
    fact cal_gx = -1           // the cell of its top left corner (-1: the default one)
    fact cal_gy = -1
    fact cal_mon = -1          // which copy of the scene draws it (the logic keeps it)
    text cal_mon_name = ""     // that monitor's name: set from outside (Settings > Theme > Pin widgets), a name it has not got is ignored
    fact cal_dragging = false
    prop cal_dg = 0 ~quick
    follow cal_dg = if(cal_dragging, 1, 0)
    fact cal_pcx = 0           // while it is dragged: where its centre was when it was pressed, and where it is now (the desktop's own coordinates)
    fact cal_pcy = 0
    fact cal_dcx = 0
    fact cal_dcy = 0
    fact cal_zpx = 0           // and where its zone stays (a zone that moves itself would lose the drag)
    fact cal_zpy = 0
    prop cal_sh = 0 ~calm
    follow cal_sh = if(cal_shown, 1, 0)
    let cal_fw = 6
    let cal_fh = 6
    let cal_here = if(mi == cal_mon, 1, 0)
    let cal_mox = pick(cal_mon, m0x, m1x, m2x, m3x)
    let cal_moy = pick(cal_mon, m0y, m1y, m2y, m3y)
    let cal_gx0 = clamp(if(cal_gx < 0, 0, cal_gx), 0, gnx - cal_fw)
    let cal_gy0 = clamp(if(cal_gy < 0, 0, cal_gy), 0, gny - cal_fh)
    prop cal_erx = 0 ~quick
    prop cal_ery = 0 ~quick
    follow cal_erx = if(cal_gx < 0, 0, cal_gx)
    //  Settings > Theme > Pin widgets: while a theme puts the widgets back (`glide`, said by Vitreus), what is drawn slides to its new cell on a slower
    //  spring instead of jumping to it.
    fact glide = false
    prop glp = 0 ~0ms                    // (at once: the slower spring is already where the widget is, so taking it over shows nothing)
    follow glp = if(glide, 1, 0)
    prop cal_gsx = 0 ~gentle
    prop cal_gsy = 0 ~gentle
    follow cal_gsx = if(cal_gx < 0, 0, cal_gx)
    follow cal_gsy = if(cal_gy < 0, 0, cal_gy)
    follow cal_ery = if(cal_gy < 0, 0, cal_gy)
    let cal_ex = clamp(mix(mix(cal_gx0, cal_erx, edp), cal_gsx, glp), 0, gnx - cal_fw)
    let cal_ey = clamp(mix(mix(cal_gy0, cal_ery, edp), cal_gsy, glp), 0, gny - cal_fh)
    let cal_x = gl + cal_ex * gw + 3          // the card, a little inside its cells
    let cal_y = gt + cal_ey * gh + 3
    let cal_w = cal_fw * gw - 6
    let cal_h = cal_fh * gh - 6
    //  Dragged over to another monitor it lands there: the monitor under the card's centre shows it, and the cell is worked out against that one's grid.
    let cal_in0 = if(cal_dcx >= m0x and cal_dcx < m0x + m0w and cal_dcy >= m0y and cal_dcy < m0y + m0h, 1, 0)
    let cal_in1 = if(cal_dcx >= m1x and cal_dcx < m1x + m1w and cal_dcy >= m1y and cal_dcy < m1y + m1h, 1, 0)
    let cal_in2 = if(cal_dcx >= m2x and cal_dcx < m2x + m2w and cal_dcy >= m2y and cal_dcy < m2y + m2h, 1, 0)
    let cal_in3 = if(cal_dcx >= m3x and cal_dcx < m3x + m3w and cal_dcy >= m3y and cal_dcy < m3y + m3h, 1, 0)
    let cal_tmon = if(cal_in0 > 0.5, 0, if(cal_in1 > 0.5, 1, if(cal_in2 > 0.5, 2, if(cal_in3 > 0.5, 3, cal_mon))))
    let cal_tox = pick(cal_tmon, m0x, m1x, m2x, m3x)
    let cal_toy = pick(cal_tmon, m0y, m1y, m2y, m3y)
    let cal_tgw = (max(pick(cal_tmon, m0w, m1w, m2w, m3w), 800) - gl - gr) / gnx
    let cal_tgh = (max(pick(cal_tmon, m0h, m1h, m2h, m3h), 600) - gt - gb) / gny
    zone box cal_edz { from: if(cal_dragging, 0, cal_x), if(cal_dragging, 0, cal_y); size: if(cal_dragging, scw, cal_w), if(cal_dragging, sch, cal_h); corner: 20; cursor: pointer; active: edit and cal_shown and (cal_here > 0.5 or cal_dragging); label: "Move Calendar" }
    on press cal_edz { cal_pcx = cal_mox + gl + (cal_gx0 + cal_fw / 2) * gw; cal_pcy = cal_moy + gt + (cal_gy0 + cal_fh / 2) * gh; cal_dcx = cal_pcx; cal_dcy = cal_pcy; cal_zpx = cal_x; cal_zpy = cal_y; cal_dragging = true }
    on drag cal_edz { cal_dcx = cal_pcx + drag.dx; cal_dcy = cal_pcy + drag.dy }
    //  A right click does nothing here, on purpose: a scene that never names the right button is closed by one (pleamar's way out of a prototype with no
    //  keyboard), and the keeper starts it again a moment later, out of Edit mode: the widget went away and came back stuck.
    on press right cal_edz { }
    on change cal_dcx { cal_mon = cal_tmon; cal_gx = clamp(floor((cal_dcx - cal_tox - gl) / cal_tgw - cal_fw / 2 + 0.5), 0, gnx - cal_fw); cal_gy = clamp(floor((cal_dcy - cal_toy - gt) / cal_tgh - cal_fh / 2 + 0.5), 0, gny - cal_fh) }
    on change cal_dcy { cal_mon = cal_tmon; cal_gx = clamp(floor((cal_dcx - cal_tox - gl) / cal_tgw - cal_fw / 2 + 0.5), 0, gnx - cal_fw); cal_gy = clamp(floor((cal_dcy - cal_toy - gt) / cal_tgh - cal_fh / 2 + 0.5), 0, gny - cal_fh) }
    on release cal_edz { cal_dragging = false; cal_mon = cal_tmon; cal_gx = clamp(floor((cal_dcx - cal_tox - gl) / cal_tgw - cal_fw / 2 + 0.5), 0, gnx - cal_fw); cal_gy = clamp(floor((cal_dcy - cal_toy - gt) / cal_tgh - cal_fh / 2 + 0.5), 0, gny - cal_fh) }

    //  ---- Reminders: 6 x 8 cells, by default at 22, 0 ----
    fact rem_shown = false
    fact rem_gx = -1           // the cell of its top left corner (-1: the default one)
    fact rem_gy = -1
    fact rem_mon = -1          // which copy of the scene draws it (the logic keeps it)
    text rem_mon_name = ""     // (as the calendar's)
    fact rem_dragging = false
    prop rem_dg = 0 ~quick
    follow rem_dg = if(rem_dragging, 1, 0)
    fact rem_pcx = 0           // while it is dragged: where its centre was when it was pressed, and where it is now (the desktop's own coordinates)
    fact rem_pcy = 0
    fact rem_dcx = 0
    fact rem_dcy = 0
    fact rem_zpx = 0           // and where its zone stays (a zone that moves itself would lose the drag)
    fact rem_zpy = 0
    prop rem_sh = 0 ~calm
    follow rem_sh = if(rem_shown, 1, 0)
    let rem_fw = 6
    let rem_fh = 8
    let rem_here = if(mi == rem_mon, 1, 0)
    let rem_mox = pick(rem_mon, m0x, m1x, m2x, m3x)
    let rem_moy = pick(rem_mon, m0y, m1y, m2y, m3y)
    let rem_gx0 = clamp(if(rem_gx < 0, 22, rem_gx), 0, gnx - rem_fw)
    let rem_gy0 = clamp(if(rem_gy < 0, 0, rem_gy), 0, gny - rem_fh)
    prop rem_erx = 0 ~quick
    prop rem_ery = 0 ~quick
    follow rem_erx = if(rem_gx < 0, 22, rem_gx)
    prop rem_gsx = 0 ~gentle              // (the Pin widgets slide, as the calendar's)
    prop rem_gsy = 0 ~gentle
    follow rem_gsx = if(rem_gx < 0, 22, rem_gx)
    follow rem_gsy = if(rem_gy < 0, 0, rem_gy)
    follow rem_ery = if(rem_gy < 0, 0, rem_gy)
    let rem_ex = clamp(mix(mix(rem_gx0, rem_erx, edp), rem_gsx, glp), 0, gnx - rem_fw)
    let rem_ey = clamp(mix(mix(rem_gy0, rem_ery, edp), rem_gsy, glp), 0, gny - rem_fh)
    let rem_x = gl + rem_ex * gw + 3          // the card, a little inside its cells
    let rem_y = gt + rem_ey * gh + 3
    let rem_w = rem_fw * gw - 6
    let rem_h = rem_fh * gh - 6
    //  Where the cal card is on its monitor, for the window manager's scene: it keeps a hole in its desktop-click zone there (see pleamar-wm/build-session.py), so a press on this card reaches it.
    fact cal_hx = 0
    fact cal_hy = 0
    fact cal_hw = 0
    fact cal_hh = 0
    on change cal_x while cal_here > 0.5 { cal_hx = cal_x }
    on change cal_y while cal_here > 0.5 { cal_hy = cal_y }
    on change cal_w while cal_here > 0.5 { cal_hw = cal_w }
    on change cal_h while cal_here > 0.5 { cal_hh = cal_h }
    on change cal_here { cal_hx = cal_x; cal_hy = cal_y; cal_hw = cal_w; cal_hh = cal_h }
    //  Where the rem card is on its monitor, for the window manager's scene: it keeps a hole in its desktop-click zone there (see pleamar-wm/build-session.py), so a press on this card reaches it.
    fact rem_hx = 0
    fact rem_hy = 0
    fact rem_hw = 0
    fact rem_hh = 0
    on change rem_x while rem_here > 0.5 { rem_hx = rem_x }
    on change rem_y while rem_here > 0.5 { rem_hy = rem_y }
    on change rem_w while rem_here > 0.5 { rem_hw = rem_w }
    on change rem_h while rem_here > 0.5 { rem_hh = rem_h }
    on change rem_here { rem_hx = rem_x; rem_hy = rem_y; rem_hw = rem_w; rem_hh = rem_h }
    //  Dragged over to another monitor it lands there: the monitor under the card's centre shows it, and the cell is worked out against that one's grid.
    let rem_in0 = if(rem_dcx >= m0x and rem_dcx < m0x + m0w and rem_dcy >= m0y and rem_dcy < m0y + m0h, 1, 0)
    let rem_in1 = if(rem_dcx >= m1x and rem_dcx < m1x + m1w and rem_dcy >= m1y and rem_dcy < m1y + m1h, 1, 0)
    let rem_in2 = if(rem_dcx >= m2x and rem_dcx < m2x + m2w and rem_dcy >= m2y and rem_dcy < m2y + m2h, 1, 0)
    let rem_in3 = if(rem_dcx >= m3x and rem_dcx < m3x + m3w and rem_dcy >= m3y and rem_dcy < m3y + m3h, 1, 0)
    let rem_tmon = if(rem_in0 > 0.5, 0, if(rem_in1 > 0.5, 1, if(rem_in2 > 0.5, 2, if(rem_in3 > 0.5, 3, rem_mon))))
    let rem_tox = pick(rem_tmon, m0x, m1x, m2x, m3x)
    let rem_toy = pick(rem_tmon, m0y, m1y, m2y, m3y)
    let rem_tgw = (max(pick(rem_tmon, m0w, m1w, m2w, m3w), 800) - gl - gr) / gnx
    let rem_tgh = (max(pick(rem_tmon, m0h, m1h, m2h, m3h), 600) - gt - gb) / gny
    zone box rem_edz { from: if(rem_dragging, 0, rem_x), if(rem_dragging, 0, rem_y); size: if(rem_dragging, scw, rem_w), if(rem_dragging, sch, rem_h); corner: 20; cursor: pointer; active: edit and rem_shown and (rem_here > 0.5 or rem_dragging); label: "Move Reminders" }
    on press rem_edz { rem_pcx = rem_mox + gl + (rem_gx0 + rem_fw / 2) * gw; rem_pcy = rem_moy + gt + (rem_gy0 + rem_fh / 2) * gh; rem_dcx = rem_pcx; rem_dcy = rem_pcy; rem_zpx = rem_x; rem_zpy = rem_y; rem_dragging = true }
    on drag rem_edz { rem_dcx = rem_pcx + drag.dx; rem_dcy = rem_pcy + drag.dy }
    //  A right click does nothing here, on purpose: a scene that never names the right button is closed by one (pleamar's way out of a prototype with no
    //  keyboard), and the keeper starts it again a moment later, out of Edit mode: the widget went away and came back stuck.
    on press right rem_edz { }
    on change rem_dcx { rem_mon = rem_tmon; rem_gx = clamp(floor((rem_dcx - rem_tox - gl) / rem_tgw - rem_fw / 2 + 0.5), 0, gnx - rem_fw); rem_gy = clamp(floor((rem_dcy - rem_toy - gt) / rem_tgh - rem_fh / 2 + 0.5), 0, gny - rem_fh) }
    on change rem_dcy { rem_mon = rem_tmon; rem_gx = clamp(floor((rem_dcx - rem_tox - gl) / rem_tgw - rem_fw / 2 + 0.5), 0, gnx - rem_fw); rem_gy = clamp(floor((rem_dcy - rem_toy - gt) / rem_tgh - rem_fh / 2 + 0.5), 0, gny - rem_fh) }
    on release rem_edz { rem_dragging = false; rem_mon = rem_tmon; rem_gx = clamp(floor((rem_dcx - rem_tox - gl) / rem_tgw - rem_fw / 2 + 0.5), 0, gnx - rem_fw); rem_gy = clamp(floor((rem_dcy - rem_toy - gt) / rem_tgh - rem_fh / 2 + 0.5), 0, gny - rem_fh) }

    let cal_cw = (cal_w - 28) / 7
    let cal_top = cal_y + 96
    let cal_rh = (cal_h - 96 - 18) / 6
    zone box cal_prev { at: cal_x + cal_w - 76, cal_y + 32; size: 34, 34; corner: 17; cursor: pointer; active: cal_shown and edit == false and cal_here > 0.5; label: "Previous month" }
    zone box cal_next { at: cal_x + cal_w - 34, cal_y + 32; size: 34, 34; corner: 17; cursor: pointer; active: cal_shown and edit == false and cal_here > 0.5; label: "Next month" }
    zone box cal_ttl { at: cal_x + 110, cal_y + 32; size: 190, 34; corner: 12; cursor: pointer; active: cal_shown and edit == false and cal_here > 0.5; label: "This month" }
    on press cal_prev { emit cal_nav(-1) }
    on press cal_next { emit cal_nav(1) }
    on press cal_ttl { emit cal_nav(0) }
    group {
        show: cal_sh > 0.01 and cal_here > 0.5
        opacity: cal_sh
        scale: 0.96 + 0.04 * cal_sh
        pivot: cal_x + cal_w / 2, cal_y + cal_h / 2

        body {
            color: tint
            glass: 1
            lens: false
            rim: 70%
            shine: 0, 0
            shadow: 0, 8, 22, 34%
            opacity: 85% * (1 - ob)
            show: ob < 0.996
            box { from: cal_x, cal_y; size: cal_w, cal_h; corner: 22 * (1 - 0.73 * cyk) }
        }
        body {
            color: tint
            rim: 0%
            border: (2 + 1.2 * uk - 0.8 * ppk - 0.6 * pxk + 2.2 * dd) * (1 - mk) * pl, mix(mix(mix(deep, tint, 0.55 * ppk), mix(#e8f1f5, tint, 0.4), pxk), ink, dd)
            shadow: (4 - 2.5 * ppk - mk - 1.5 * pxk) * pl, (5 - 1.5 * ppk - mk - 2 * pxk) * pl, 9 * ppk + 10 * mk, (55% - 13% * ppk - 27% * mk + 30% * pxk + 35% * uk) * (1 - dd), mix(deep, #ff6ec7, 0.75 * uk)
            opacity: pl
            show: pl > 0.004
            box { from: cal_x, cal_y; size: cal_w, cal_h; corner: 22 * (1 - 0.73 * cyk) }
        }
        //  Milkbox: the white light of the raised plate (the dark shade is the plate's own shadow, above).
        body {
            color: tint
            rim: 0%
            shadow: -3 * mk, -3 * mk, 8 * mk, 38% * mk, #ffffff
            opacity: mk
            show: mk > 0.004
            box { from: cal_x, cal_y; size: cal_w, cal_h; corner: 22 * (1 - 0.73 * cyk) }
        }
        //  Paper: the worn, torn edge and two strips of tape.
        group {
            show: ppk > 0.01
            opacity: 1 * ppk
            shader paper { at: cal_x - 8, cal_y - 8; size: cal_w + 16, cal_h + 16; values: 1, 3.7, 8, 22; colors: tint, deep }
            box { at: cal_x + 30, cal_y + -2; size: 60, 19; rotate: -11deg; color: #e9dba8; opacity: 86% }
            box { at: cal_x + 30, cal_y + -2; size: 60, 19; rotate: -11deg; stroke: 1; color: deep; opacity: 22% }
            box { at: cal_x + cal_w - 58, cal_y + 4; size: 70, 19; rotate: 3deg; color: #c9d8ec; opacity: 86% }
            box { at: cal_x + cal_w - 58, cal_y + 4; size: 70, 19; rotate: 3deg; stroke: 1; color: deep; opacity: 22% }
        }
        body {
            color: mix(mix(tint, #000000, 0.7), ink, 0.3)
            rim: 0%
            opacity: 100% * ob * (1 - pl)
            shadow: 0, 8, 22, 45%, #000000
            show: ob * (1 - pl) > 0.004
            box { from: cal_x, cal_y; size: cal_w, cal_h; corner: 22 * (1 - 0.73 * cyk) }
        }
        //  The Cyber's HUD marks (the same as on its drawers, bar_glass.plm): bright corner brackets with a soft glow, 6 px outside the card, a neon hairline round it, and a little ruler of ticks under it.
        group {
            show: cyk > 0.01
            opacity: cyk
            box { from: cal_x, cal_y; size: cal_w, cal_h; corner: 22 * (1 - 0.73 * cyk); stroke: 1.1; color: mint; opacity: 38% }
            repeat cal_c in 0..4 {
                let cal_bx = if(mod(cal_c, 2) == 0, cal_x - 6, cal_x + cal_w + 6)
                let cal_by = if(cal_c < 2, cal_y - 6, cal_y + cal_h + 6)
                let cal_sx = if(mod(cal_c, 2) == 0, -1, 1)
                let cal_sy = if(cal_c < 2, -1, 1)
                path { at: cal_bx, cal_by; stroke: 5; color: mint; opacity: 16%; move 0, -cal_sy * 14; line 0, 0; line -cal_sx * 14, 0 }
                path { at: cal_bx, cal_by; stroke: 1.7; color: minthi; move 0, -cal_sy * 14; line 0, 0; line -cal_sx * 14, 0 }
            }
            repeat cal_k in 0..13 {
                line { from: cal_x + 22 + cal_k * 6, cal_y + cal_h + 7; to: cal_x + 22 + cal_k * 6, cal_y + cal_h + 7 + if(mod(cal_k, 4) == 0, 6, 3); width: 1.1; color: mint; opacity: 70% }
            }
        }
        text cal_title { at: cal_x + 22, cal_y + 32; anchor: left center; size: 21; weight: 700; color: ink; family: "Space Grotesk" }
        text cal_week { at: cal_x + 22, cal_y + 58; anchor: left center; size: 11; weight: 600; color: faint; family: "Space Grotesk" }
        ellipse { at: cal_x + cal_w - 76, cal_y + 32; radius: 15; color: ink; opacity: 8% + 10% * cal_prev.hover }
        ellipse { at: cal_x + cal_w - 34, cal_y + 32; radius: 15; color: ink; opacity: 8% + 10% * cal_next.hover }
        text "‹" { at: cal_x + cal_w - 76, cal_y + 31; anchor: center center; size: 20; weight: 700; color: ink; family: "Space Grotesk" }
        text "›" { at: cal_x + cal_w - 34, cal_y + 31; anchor: center center; size: 20; weight: 700; color: ink; family: "Space Grotesk" }
        repeat q in 0..7 {
            text pick(q, "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN") { at: cal_x + 14 + q * cal_cw + cal_cw / 2, cal_y + 84; anchor: center center; size: 10; weight: 700; color: mix(faint, mint, if(q > 4, 0.6, 0)); family: "Space Grotesk" }
        }
        for r in cal_days {
            let cx = cal_x + 14 + mod(r.index, 7) * cal_cw + cal_cw / 2
            let cy = cal_top + floor(r.index / 7) * cal_rh + cal_rh / 2
            ellipse { at: cx, cy; radius: min(cal_cw, cal_rh) / 2 - 3; color: mint; opacity: if(r.k == 2, 1, 0) }
            text "{r.d}" { at: cx, cy; anchor: center center; size: 15; weight: if(r.k == 2, 700, 600); color: if(r.k == 2, onmint, if(r.k == 3, mix(ink, mint, 0.55), ink)); opacity: if(r.k == 0, 30%, 100%); family: "Space Grotesk" }
        }
    }

    let rem_rows = clamp(floor((rem_h - 150) / 34), 1, 12)
    let rem_top = rem_y + 96
    repeat i in 0..12 {
        zone box rem_tz.$i { at: rem_x + 36, rem_top + i * 34 + 14; size: 30, 30; corner: 8; cursor: pointer; active: rem_shown and edit == false and rem_here > 0.5 and i < rem_rows; label: "Tick reminder" }
        on press rem_tz.$i { emit rem_toggle(i) }
    }
    zone box rem_clr { at: rem_x + rem_w - 62, rem_y + 32; size: 92, 28; corner: 14; cursor: pointer; active: rem_shown and edit == false and rem_here > 0.5; label: "Clear done" }
    on press rem_clr { emit rem_clear }
    zone box rem_fz { at: rem_x + rem_w / 2 - 20, rem_y + rem_h - 36; size: rem_w - 90, 34; corner: 17; cursor: text; active: rem_shown and edit == false and rem_here > 0.5; label: "Write a reminder" }
    on press rem_fz { focus rem_new }
    zone box rem_add_z { at: rem_x + rem_w - 36, rem_y + rem_h - 36; size: 34, 34; corner: 17; cursor: pointer; active: rem_shown and edit == false and rem_here > 0.5; label: "Add reminder" }
    on press rem_add_z { emit rem_add }
    on submit rem_new { emit rem_add }
    group {
        show: rem_sh > 0.01 and rem_here > 0.5
        opacity: rem_sh
        scale: 0.96 + 0.04 * rem_sh
        pivot: rem_x + rem_w / 2, rem_y + rem_h / 2

        body {
            color: tint
            glass: 1
            lens: false
            rim: 70%
            shine: 0, 0
            shadow: 0, 8, 22, 34%
            opacity: 85% * (1 - ob)
            show: ob < 0.996
            box { from: rem_x, rem_y; size: rem_w, rem_h; corner: 22 * (1 - 0.73 * cyk) }
        }
        body {
            color: tint
            rim: 0%
            border: (2 + 1.2 * uk - 0.8 * ppk - 0.6 * pxk + 2.2 * dd) * (1 - mk) * pl, mix(mix(mix(deep, tint, 0.55 * ppk), mix(#e8f1f5, tint, 0.4), pxk), ink, dd)
            shadow: (4 - 2.5 * ppk - mk - 1.5 * pxk) * pl, (5 - 1.5 * ppk - mk - 2 * pxk) * pl, 9 * ppk + 10 * mk, (55% - 13% * ppk - 27% * mk + 30% * pxk + 35% * uk) * (1 - dd), mix(deep, #ff6ec7, 0.75 * uk)
            opacity: pl
            show: pl > 0.004
            box { from: rem_x, rem_y; size: rem_w, rem_h; corner: 22 * (1 - 0.73 * cyk) }
        }
        //  Paper: the worn, torn edge and two strips of tape.
        group {
            show: ppk > 0.01
            opacity: 1 * ppk
            shader paper { at: rem_x - 8, rem_y - 8; size: rem_w + 16, rem_h + 16; values: 1, 9.0, 8, 22; colors: tint, deep }
            box { at: rem_x + 64, rem_y + 5; size: 58, 19; rotate: -3deg; color: #e8b9b4; opacity: 86% }
            box { at: rem_x + 64, rem_y + 5; size: 58, 19; rotate: -3deg; stroke: 1; color: deep; opacity: 22% }
            box { at: rem_x + rem_w - 24, rem_y + -3; size: 64, 19; rotate: 8deg; color: #cfe0bf; opacity: 86% }
            box { at: rem_x + rem_w - 24, rem_y + -3; size: 64, 19; rotate: 8deg; stroke: 1; color: deep; opacity: 22% }
        }
        body {
            color: mix(mix(tint, #000000, 0.7), ink, 0.3)
            rim: 0%
            opacity: 100% * ob * (1 - pl)
            shadow: 0, 8, 22, 45%, #000000
            show: ob * (1 - pl) > 0.004
            box { from: rem_x, rem_y; size: rem_w, rem_h; corner: 22 * (1 - 0.73 * cyk) }
        }
        //  The Cyber's HUD marks (the same as on its drawers, bar_glass.plm): bright corner brackets with a soft glow, 6 px outside the card, a neon hairline round it, and a little ruler of ticks under it.
        group {
            show: cyk > 0.01
            opacity: cyk
            box { from: rem_x, rem_y; size: rem_w, rem_h; corner: 22 * (1 - 0.73 * cyk); stroke: 1.1; color: mint; opacity: 38% }
            repeat rem_c in 0..4 {
                let rem_bx = if(mod(rem_c, 2) == 0, rem_x - 6, rem_x + rem_w + 6)
                let rem_by = if(rem_c < 2, rem_y - 6, rem_y + rem_h + 6)
                let rem_sx = if(mod(rem_c, 2) == 0, -1, 1)
                let rem_sy = if(rem_c < 2, -1, 1)
                path { at: rem_bx, rem_by; stroke: 5; color: mint; opacity: 16%; move 0, -rem_sy * 14; line 0, 0; line -rem_sx * 14, 0 }
                path { at: rem_bx, rem_by; stroke: 1.7; color: minthi; move 0, -rem_sy * 14; line 0, 0; line -rem_sx * 14, 0 }
            }
            repeat rem_k in 0..13 {
                line { from: rem_x + 22 + rem_k * 6, rem_y + rem_h + 7; to: rem_x + 22 + rem_k * 6, rem_y + rem_h + 7 + if(mod(rem_k, 4) == 0, 6, 3); width: 1.1; color: mint; opacity: 70% }
            }
        }
        text "Reminders" { at: rem_x + 22, rem_y + 32; anchor: left center; size: 21; weight: 700; color: ink; family: "Space Grotesk" }
        text rem_sub { at: rem_x + 22, rem_y + 58; anchor: left center; size: 11; weight: 600; color: faint; family: "Space Grotesk" }
        box { at: rem_x + rem_w - 62, rem_y + 32; size: 92, 28; corner: 14; color: ink; opacity: 8% + 10% * rem_clr.hover }
        text "clear done" { at: rem_x + rem_w - 62, rem_y + 32; anchor: center center; size: 11; weight: 700; color: ink; family: "Space Grotesk" }
        box { at: rem_x + rem_w / 2, rem_y + 76; size: rem_w - 40, 1.5; color: ink; opacity: 12% }
        for r in todos {
            let ry = rem_top + r.index * 34 + 14
            box { at: rem_x + 36, ry; size: 20, 20; corner: 6; color: mint; opacity: if(r.done > 0.5, 1, 0) }
            box { at: rem_x + 36, ry; size: 20, 20; corner: 6; stroke: 1.8; color: mint; opacity: if(r.done > 0.5, 1, 60%) }
            text "✓" { at: rem_x + 36, ry; anchor: center center; size: 14; weight: 800; color: onmint; opacity: if(r.done > 0.5, 1, 0); family: "Space Grotesk" }
            text r.t { at: rem_x + 54, ry; anchor: left center; size: 15; weight: 600; width: rem_w - 80; lines: 1; color: if(r.done > 0.5, faint, ink); opacity: if(r.done > 0.5, 50%, 100%); family: "Space Grotesk"; show: r.index < rem_rows }
        }
        box { at: rem_x + rem_w / 2 - 20, rem_y + rem_h - 36; size: rem_w - 90, 34; corner: 17; color: ink; opacity: 9% }
        input rem_new { at: rem_x + 34, rem_y + rem_h - 46; width: rem_w - 120; size: 14; weight: 500; color: ink; family: "Space Grotesk"; placeholder: "add a reminder…"; show: rem_sh > 0.5 }
        ellipse { at: rem_x + rem_w - 36, rem_y + rem_h - 36; radius: 16; color: mint; opacity: 80% + 20% * rem_add_z.hover }
        //  The plus is drawn, not typed: a font's "+" sits off the middle of the circle in the handwriting fonts.
        line { from: rem_x + rem_w - 36 - 6.5, rem_y + rem_h - 36; to: rem_x + rem_w - 36 + 6.5, rem_y + rem_h - 36; width: 2.8; color: onmint }
        line { from: rem_x + rem_w - 36, rem_y + rem_h - 36 - 6.5; to: rem_x + rem_w - 36, rem_y + rem_h - 36 + 6.5; width: 2.8; color: onmint }
    }

    group {
        show: edp > 0.01 and cal_here > 0.5 and cal_sh > 0.01
        opacity: edp
        box { from: cal_x, cal_y; size: cal_w, cal_h; corner: 22; color: mint; opacity: 7% + 9% * cal_dg }
        box { from: cal_x, cal_y; size: cal_w, cal_h; corner: 22; stroke: 1.6; color: mint; opacity: 55% + 45% * cal_dg }
        text "Calendar" { at: cal_x + 16, cal_y + 14; anchor: left center; size: 12; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 5, 70% }
    }
    group {
        show: edp > 0.01 and rem_here > 0.5 and rem_sh > 0.01
        opacity: edp
        box { from: rem_x, rem_y; size: rem_w, rem_h; corner: 22; color: mint; opacity: 7% + 9% * rem_dg }
        box { from: rem_x, rem_y; size: rem_w, rem_h; corner: 22; stroke: 1.6; color: mint; opacity: 55% + 45% * rem_dg }

    }}
