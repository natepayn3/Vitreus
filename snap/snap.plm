language 0.1
import "../palette.plm"

//  Snap: the screenshot tool. The logic takes the picture of the screen before anything is drawn (snap.luau); the scene freezes it, dims it, and lets you drag out the part to keep,
//  then move it and pull its edges. Two pills of glass come up under it: the tools (not working yet) and what to do with the picture (Copy, Save).
//
//  Start it with   pleamar --scene ~/.config/pleamar/shells/vitreus/snap/snap.plm --no-hud   (Esc closes it).

scene Snap {
    surface { size: full, full; anchor: top_left; margin: 0; level: overlay; keyboard: exclusive while phase > 0 }

    permissions { run: "sh", "pleamar", "notify-send", "magick" }

    fact phase = 0         // 0 taking the picture (nothing is drawn), 1 picking, 2 a part is picked
    //  Vitreus's look (Settings > Theme), which the logic reads: 0 Glass, 1 Retro (moulded plastic: square corners, a dark outline, a hard shadow),
    //  2 UwU (candy plastic: a pastel gradient, a thick grape outline, a hard pink shadow, cat ears), 3 Cyber (near-black glass, a neon hairline,
    //  magenta corner brackets). The colours are Vitreus's own already (../palette.plm), whichever the look.
    fact look = 0
    //  1 for the whole screen (Controls > Screen, Shift+Print): the picture is taken as it is, shown smaller with the bar underneath, and `vs`, `vx`, `vy` are its scale and
    //  where its corner is (1, 0, 0 when it fills the screen). The logic sets `full`; the scene lays the picture out.
    fact full = 0
    //  Where the picture sits on its canvas, as fractions of it (left, top, width, height): 0, 0, 1, 1 for the screen, less for an old screenshot opened again, which the logic
    //  puts on a canvas of the screen's shape. The whole-screen layout selects just that part.
    fact fo_x = 0
    fact fo_y = 0
    fact fo_w = 1
    fact fo_h = 1
    fact vs = 1
    fact vx = 0
    fact vy = 0
    let pink_shadow = mix(deep, #ff6ec7, 0.75)
    text shot_path = ""    // the picture: its file, `?` and a number
    image shot = from shot_path, 1920, 1080
    image shotv = from shot_path, 1080, 1920      // the same picture for a monitor standing on its side: the cell has the shape it is drawn in, or it is squashed
    //  and for an ultrawide one (21:9, wider than 2:1): in the 16:9 cell it was fitted with a band above and below, and the cell stretched to the
    //  screen showed it smaller in the middle, with the real screen above and below it. At 3440 x 1440 it is also the monitor's own resolution.
    image shotw = from shot_path, 3440, 1440
    event do_copy ->
    event do_save ->
    event do_quit ->

    fact tool = 1          // 0 select, 1 move the area, 2 pen, 3 arrow, 4 rectangle, 5 ellipse, 6 text, 7 marker, 8 redact, 9 highlighter, 10 eraser
    fact col = 0           // which of the nine colours (red, orange, yellow, green, blue, indigo, violet, white, black)
    fact sz = 1            // the stroke size: 0 thin, 1 medium, 2 thick (each tool turns it into its own width, see snap.luau)

    //  What is drawn on the picture. The logic keeps the marks (and their history, for undo); the scene draws them. Coordinates are the scene's.
    //  `k` is the tool that made it (2 pen, 3 arrow, 4 rectangle, 5 ellipse, 6 text, 7 marker, 8 redact, 9 highlighter), `w` its width (a text's size, a
    //  marker's radius), `n` a marker's number, `s` a text's words, `bx0`..`by1` its bounds, for the Select tool's outline.
    model marks max 128 { k: number; x0: number; y0: number; x1: number; y1: number; c: number; w: number; n: number; s: text; bx0: number; by0: number; bx1: number; by1: number }
    //  The pen's and the highlighter's strokes, as segments: `m` the mark each belongs to (so a mark being moved takes them along), `hl` 1 for the highlighter.
    model segs max 1024 { x0: number; y0: number; x1: number; y1: number; c: number; w: number; hl: number; m: number }
    fact dragging = 0      // a shape is being dragged out, from `ax`, `ay` to `qx`, `qy`; the logic sets it back to 0 once the shape is in the list
    fact ax = 0
    fact ay = 0
    fact qx = 0
    fact qy = 0
    fact px = 0            // the pointer, for the pen and for a click of the marker, the text and Select
    fact py = 0
    fact typing = 0        // a text is being written, at `tx`, `ty`
    fact tx = 0
    fact ty_ = 0
    text tq = ""
    fact selm = -1         // the mark Select picked (-1 none), and how far it is being dragged
    fact mvx = 0
    fact mvy = 0
    fact erasing = 0       // the eraser is held down, at `px`, `py`
    fact can_undo = false
    fact can_redo = false
    event pen_down ->
    event pen_pt ->
    event pen_up ->
    event shape_add ->
    event marker_add ->
    event txt_at ->
    event txt_commit ->
    event sel_at ->
    event sel_move ->
    event mk_del ->
    event erase_down ->
    event erase_pt ->
    event erase_up ->
    event do_undo ->
    //  The windows on the monitor taken, as the logic gets them from Hyprland (bottom first, the one on top last), in the scene's plane: hovered, one
    //  shows undimmed with an outline, and a click (not a drag) picks it.
    model wins max 32 { x: number; y: number; w: number; h: number }
    //  Dragging the picture out: the logic keeps a finished copy (marks and all) in the runtime folder, made again a moment after each change;
    //  `drag_ready` while the one there is up to date. Once it is dragged out, Snap hides (see do_dropped in snap.luau) and quits a while later.
    text drag_path = ""
    fact drag_ready = false
    event do_dropped ->
    //  The text in the picture (tesseract): copied, or the private bits of it (addresses, links, long numbers) covered with black bars. `busy` while it reads.
    fact busy = 0
    //  The button whose tooltip shows: 0 none, else its number in the bar (left to right, from 1), after 400 ms over it.
    fact tip = 0
    //  A word from Snap itself, over the bar: a notification would open under Snap, which covers the screen, and never be seen while it is open.
    text toast = ""
    fact toast_on = false
    event do_ocr_copy ->
    event do_hide ->
    event do_redo ->

    spring pop = 230, 17
    prop toast_k = 0 ~pop
    follow toast_k = if(toast_on, 1, 0)
    prop ti = 0 ~pop       // which tool and which colour the beads are at: sprung as a number, so moving the bar moves them with it (no lag)
    prop ci = 0 ~pop
    prop pv = 0 ~pop

    let W = screen.width
    let H = screen.height
    let u = min(W / 1920, H / 1080)

    //  The selection
    fact sx = 0
    fact sy = 0
    fact sw = 0
    fact sh = 0
    fact x0 = 0            // where the press that began a new selection was
    fact y0 = 0
    fact picking = 0       // a new selection is being dragged out
    fact scrw = 0          // the scene's width, for the logic to find the picture's scale
    fact bx = 0            // where the selection was when a drag began
    fact by = 0
    fact bw = 0
    fact bh = 0

    //  The bar: under the selection if it fits there with its hint (and, on UwU, room for the cat ears above it); else above the selection, clear
    //  of the size chip; else, the selection filling the screen, inside it at the bottom. Pushed against the bottom edge, the hint was cut off.
    //  One grid for the whole bar: the icon buttons 40 apart (the tools, undo and redo, drag, text, private), the colours 26 apart, each hairline
    //  24 from what is either side of it, and the same 7 px round the ends (a bead's edge to the bar's). `tl` is the first tool's middle, `abx`
    //  the hairline before undo; everything after it is measured from there.
    let bw_ = 1178
    let tbx = clamp(sx + sw / 2 - bw_ / 2, 16, max(16, W - bw_ - 16))
    let ears_ = if(look == 2, 16, 0)
    let below_ = sy + sh + 22 + ears_
    let above_ = sy - 34 - 30 - 52
    let tby = if(below_ + 52 + 34 <= H, below_, if(above_ >= 8 + ears_ * 2, above_, H - 52 - 50))
    let tl = tbx + 26
    let ty = tby + 26
    let abx = tbx + 754

    let cyc = if(sy > 40, sy - 34, sy + 8)
    follow pv = if(phase == 2, 1, 0)
    follow ti = tool
    follow ci = col
    let hx = tl + ti * 40
    let cx_ = tbx + 474 + ci * 26

    //  A tooltip over a button of the bar: its words in a small chip, in the look's material. `w` is worked out from the words' length (and the
    //  look's typeface, some of which run wide); `x` is the button's middle.
    component Tip(n: number, x: number, y: number, w: number, words: text) {
        group {
            show: tip == n and pv > 0.9
            body {
                color: if(look == 3, mix(tint, #000000, 0.8), tint)
                rim: 10% + 30% * (look == 1) + 45% * (look == 2)
                border: pick(look, 0, 1.5, 2.5, 1.2), if(look == 3, mint, deep)
                shadow: pick(look, 0, 2.5, 2.5, 0), pick(look, 4, 3, 3, 4), pick(look, 12, 0, 0, 12), pick(look, 30%, 55%, 90%, 30%), if(look == 2, pink_shadow, deep)
                box { at: x, y; size: w * pick(look, 1, 1.12, 1.1, 1.16), 28; corner: pick(look, 14, 4, 14, 3) }
            }
            text words { at: x, y; anchor: center; size: 13; weight: 700; color: ink; family: "Space Grotesk" }
        }
    }

    //  An arrow, a rectangle or an ellipse from (x0, y0) to (x1, y1): a mark in the list, or the one being dragged out. The ellipse is eight quadratic curves
    //  (a path has no ellipse of two radii), each control point at 1 / cos 22.5° of the radius, which is within a third of a percent of the real one.
    component Shape(k: number, x0: number, y0: number, x1: number, y1: number, tone: color, w: number) {
        let aa = atan2(y1 - y0, x1 - x0)
        let al = 8 + 3.2 * w
        line { from: x0, y0; to: x1 - cos(aa) * al * 0.7, y1 - sin(aa) * al * 0.7; width: w; color: tone; show: k == 3 }
        //  the head's corners worked out here, not turned with `rotate:` (which turns a path about its own middle, not about `at`, and left the head off the line)
        path { at: x1, y1; color: tone; show: k == 3; move 0, 0; line -cos(aa) * al + sin(aa) * al * 0.55, -sin(aa) * al - cos(aa) * al * 0.55; line -cos(aa) * al - sin(aa) * al * 0.55, -sin(aa) * al + cos(aa) * al * 0.55; close }
        box { from: min(x0, x1), min(y0, y1); size: max(1, abs(x1 - x0)), max(1, abs(y1 - y0)); corner: 3; stroke: w; color: tone; show: k == 4 }
        let erx = max(1, abs(x1 - x0) / 2)
        let ery = max(1, abs(y1 - y0) / 2)
        path {
            at: (x0 + x1) / 2, (y0 + y1) / 2; stroke: w; color: tone; show: k == 5
            move erx, 0
            curve 0.70711 * erx, 0.70711 * ery via erx, 0.41421 * ery
            curve 0, ery via 0.41421 * erx, ery
            curve -0.70711 * erx, 0.70711 * ery via -0.41421 * erx, ery
            curve -erx, 0 via -erx, 0.41421 * ery
            curve -0.70711 * erx, -0.70711 * ery via -erx, -0.41421 * ery
            curve 0, -ery via -0.41421 * erx, -ery
            curve 0.70711 * erx, -0.70711 * ery via 0.41421 * erx, -ery
            curve erx, 0 via erx, -0.41421 * ery
        }
    }

    //  ── The frozen screen ───────────────────────────────────────────────────────────────────────────────────────
    image shot { at: 0, 0; size: W, H; show: phase > 0 and full == 0 and W >= H and W <= 2 * H }
    image shotw { at: 0, 0; size: W, H; show: phase > 0 and full == 0 and W > 2 * H }
    image shotv { at: 0, 0; size: W, H; show: phase > 0 and full == 0 and H > W }
    //  the whole-screen picture: the screen behind it, blurred and dimmed, and the picture smaller in front, with the bar under it
    group { show: phase > 0 and full == 1; blur: 14; image shot { at: 0, 0; size: W, H; show: W >= H and W <= 2 * H }; image shotw { at: 0, 0; size: W, H; show: W > 2 * H }; image shotv { at: 0, 0; size: W, H; show: H > W } }
    image shot { at: vx, vy; size: W * vs, H * vs; show: phase > 0 and full == 1 and W >= H and W <= 2 * H }
    image shotw { at: vx, vy; size: W * vs, H * vs; show: phase > 0 and full == 1 and W > 2 * H }
    image shotv { at: vx, vy; size: W * vs, H * vs; show: phase > 0 and full == 1 and H > W }

    //  ── The marks, inside the selection only (what is outside it is not in the picture) ─────────────────────────────────
    //  In the order the picture gets them (snap.luau, `export`): redactions, highlighter, shapes, pen, markers, text. A mark that Select is dragging is drawn moved
    //  by `mvx`, `mvy` until it is let go.
    group {
        show: phase > 0 and sw > 1
        clip inset 0 box { from: sx, sy; size: max(1, sw), max(1, sh) }
        for r in marks {
            group {
                show: r.k == 8
                clip inset 0 box { from: r.x0 + if(r.index == selm, mvx, 0), r.y0 + if(r.index == selm, mvy, 0); size: max(1, r.x1 - r.x0), max(1, r.y1 - r.y0) }
                //  a redaction: a solid black bar, as it is saved
                box { from: r.x0 + if(r.index == selm, mvx, 0), r.y0 + if(r.index == selm, mvy, 0); size: max(1, r.x1 - r.x0), max(1, r.y1 - r.y0); color: #000000 }
            }
        }
        group {
            opacity: 42%
            for sg in segs {
                line { from: sg.x0 + if(sg.m == selm, mvx, 0), sg.y0 + if(sg.m == selm, mvy, 0); to: sg.x1 + if(sg.m == selm, mvx, 0), sg.y1 + if(sg.m == selm, mvy, 0); width: sg.w; color: pick(sg.c, #ff5c5c, #ff9f45, #ffd93d, #5fd068, #3fa9ff, #5b5bf0, #b66cff, #ffffff, #000000); show: sg.hl == 1 }
            }
        }
        for r in marks {
            Shape(r.k, r.x0 + if(r.index == selm, mvx, 0), r.y0 + if(r.index == selm, mvy, 0), r.x1 + if(r.index == selm, mvx, 0), r.y1 + if(r.index == selm, mvy, 0), pick(r.c, #ff5c5c, #ff9f45, #ffd93d, #5fd068, #3fa9ff, #5b5bf0, #b66cff, #ffffff, #000000), r.w)
        }
        for sg in segs {
            line { from: sg.x0 + if(sg.m == selm, mvx, 0), sg.y0 + if(sg.m == selm, mvy, 0); to: sg.x1 + if(sg.m == selm, mvx, 0), sg.y1 + if(sg.m == selm, mvy, 0); width: sg.w; color: pick(sg.c, #ff5c5c, #ff9f45, #ffd93d, #5fd068, #3fa9ff, #5b5bf0, #b66cff, #ffffff, #000000); show: sg.hl == 0 }
        }
        for r in marks {
            ellipse { at: r.x0 + if(r.index == selm, mvx, 0), r.y0 + if(r.index == selm, mvy, 0); radius: r.w; color: pick(r.c, #ff5c5c, #ff9f45, #ffd93d, #5fd068, #3fa9ff, #5b5bf0, #b66cff, #ffffff, #000000); show: r.k == 7 }
            //  a text's size is a fixed number, so the words are drawn at one size and scaled to the mark's
            group {
                show: r.k == 7
                pivot: r.x0 + if(r.index == selm, mvx, 0), r.y0 + if(r.index == selm, mvy, 0)
                scale: r.w / 16
                text number(r.n, 0) { at: r.x0 + if(r.index == selm, mvx, 0), r.y0 + if(r.index == selm, mvy, 0); anchor: center; size: 18; weight: 800; color: if(r.c == 8, #ffffff, #10161a); family: "Space Grotesk" }
            }
            group {
                show: r.k == 6
                pivot: r.x0 + if(r.index == selm, mvx, 0), r.y0 + if(r.index == selm, mvy, 0)
                scale: r.w / 26
                text r.s { at: r.x0 + if(r.index == selm, mvx, 0), r.y0 + if(r.index == selm, mvy, 0); anchor: left center; size: 26; weight: 700; color: pick(r.c, #ff5c5c, #ff9f45, #ffd93d, #5fd068, #3fa9ff, #5b5bf0, #b66cff, #ffffff, #000000); family: "Space Grotesk" }
            }
            //  the one Select picked: a hairline round it
            box { from: r.bx0 - 6 + if(r.index == selm, mvx, 0), r.by0 - 6 + if(r.index == selm, mvy, 0); size: r.bx1 - r.bx0 + 12, r.by1 - r.by0 + 12; corner: 6; stroke: 1.4; color: ink; opacity: 85%; show: r.index == selm and tool == 0 }
        }
        //  the shape being dragged out
        group {
            show: dragging == 1 and tool >= 3 and tool <= 5
            Shape(tool, ax, ay, qx, qy, pick(col, #ff5c5c, #ff9f45, #ffd93d, #5fd068, #3fa9ff, #5b5bf0, #b66cff, #ffffff, #000000), pick(sz, 3, 5, 9))
        }
        box { from: min(ax, qx), min(ay, qy); size: max(1, abs(qx - ax)), max(1, abs(qy - ay)); corner: 0; color: #000000; opacity: 85%; show: dragging == 1 and tool == 8 }
        box { from: min(ax, qx), min(ay, qy); size: max(1, abs(qx - ax)), max(1, abs(qy - ay)); corner: 3; stroke: 1.5; color: ink; opacity: 80%; show: dragging == 1 and tool == 8 }
    }
    //  where the eraser is, while it is held
    ellipse { at: px, py; radius: 10; stroke: 1.5; color: ink; opacity: 85%; show: erasing == 1 }
    //  the text being written: Enter keeps it, Esc drops it, a click elsewhere keeps it and starts another
    group {
        show: typing == 1
        pivot: tx, ty_
        scale: pick(sz, 18, 26, 38) / 26
        input tq { at: tx, ty_; width: 640; size: 26; weight: 700; color: pick(col, #ff5c5c, #ff9f45, #ffd93d, #5fd068, #3fa9ff, #5b5bf0, #b66cff, #ffffff, #000000); family: "Space Grotesk"; placeholder: "Type, then Enter"; label: "Text on the picture" }
    }

    //  Everything outside the selection is dimmed
    box { from: 0, 0; size: W, sy; color: #000000; opacity: 58%; show: phase > 0 }
    box { from: 0, sy + sh; size: W, H - sy - sh; color: #000000; opacity: 58%; show: phase > 0 }
    box { from: 0, sy; size: sx, sh; color: #000000; opacity: 58%; show: phase > 0 }
    box { from: sx + sw, sy; size: W - sx - sw, sh; color: #000000; opacity: 58%; show: phase > 0 }

    //  ── The selection's edge and its handles ──────────────────────────────────────────────────────────────────
    //  Glass: a hairline and round handles. Retro: a heavier putty line and square handles with the accent in them. UwU: a thick pink line and
    //  candy handles. Cyber: a neon hairline, small square handles, and magenta brackets just outside the corners. (Over the dimmed screen: the
    //  plastic looks' dark ink would not show there.)
    box { from: sx, sy; size: sw, sh; corner: pick(look, 2, 0, 6, 0); stroke: pick(look, 1.5, 2.2, 3, 1.2); color: pick(look, ink, tint, mint, mint); show: phase > 0 and sw > 1 }
    repeat k in 0..8 {
        let hdx = sx + pick(k, 0, 0.5, 1, 1, 1, 0.5, 0, 0) * sw
        let hdy = sy + pick(k, 0, 0, 0, 0.5, 1, 1, 1, 0.5) * sh
        ellipse { at: hdx, hdy; radius: 6; color: #101417; opacity: 70%; show: phase == 2 and look == 0 }
        ellipse { at: hdx, hdy; radius: 4; color: ink; show: phase == 2 and look == 0 }
        box { at: hdx, hdy; size: 13, 13; corner: 2; color: tint; show: phase == 2 and look == 1 }
        box { at: hdx, hdy; size: 6, 6; corner: 1; color: mint; show: phase == 2 and look == 1 }
        ellipse { at: hdx, hdy; radius: 8; color: deep; show: phase == 2 and look == 2 }
        ellipse { at: hdx, hdy; radius: 6; color: tint; show: phase == 2 and look == 2 }
        ellipse { at: hdx, hdy; radius: 3.5; color: mint; show: phase == 2 and look == 2 }
        box { at: hdx, hdy; size: 7, 7; color: mint; show: phase == 2 and look == 3 }
    }
    repeat k in 0..4 {
        let bkx = if(mod(k, 2) == 0, sx - 6, sx + sw + 6)
        let bky = if(k < 2, sy - 6, sy + sh + 6)
        let bsx = if(mod(k, 2) == 0, 1, -1)
        let bsy = if(k < 2, 1, -1)
        path { at: bkx, bky; stroke: 2; color: deep; show: phase > 0 and sw > 1 and look == 3; move 0, bsy * 18; line 0, 0; line bsx * 18, 0 }
    }

    //  What to do, while nothing is picked yet.
    group {
        show: phase == 1 and sw <= 8
        text "Click a window, or drag an area" { at: W / 2, 46; anchor: center; size: 17; weight: 700; color: if(look == 1 or look == 2, tint, ink); family: "Space Grotesk" }
        text "Esc  close" { at: W / 2, 70; anchor: center; size: 12; color: if(look == 1 or look == 2, tint, ink); opacity: 62%; family: "Space Grotesk" }
    }


    //  ── Dragging out a selection ───────────────────────────────────────────────────────────────────────────────────
    //  Under everything else, so a press on the selection or its handles is theirs; a press anywhere else begins a new selection. A drag belongs to every zone that was under the press,
    //  so this one only follows it if the press itself was on the bare screen (`picking`): a click on a button that moves a pixel is not a new selection.
    zone box zpick { from: 0, 0; size: W, H; cursor: crosshair; active: phase > 0 and full == 0 }
    on press zpick { picking = 1; x0 = pointer.x; y0 = pointer.y; phase = 1; sw = 0; sh = 0 }
    on drag zpick while picking == 1 {
        sx = min(x0, clamp(x0 + drag.dx, 0, W))
        sy = min(y0, clamp(y0 + drag.dy, 0, H))
        sw = abs(clamp(x0 + drag.dx, 0, W) - x0)
        sh = abs(clamp(y0 + drag.dy, 0, H) - y0)
    }
    on release zpick { picking = 0; phase = if(sw > 8 and sh > 8, 2, 1) }
    on change phase { scrw = W }
    //  The picture's own edges, which the selection stays inside: the whole picture for the screen, only the screenshot (`fo_*`) when one is opened again on its canvas.
    let ix0 = vx + fo_x * W * vs
    let iy0 = vy + fo_y * H * vs
    let ix1 = ix0 + fo_w * W * vs
    let iy1 = iy0 + fo_h * H * vs
    //  The whole screen: the picture shrinks to leave room under it for the bar (the margin above, and 130 below its edge), centred, and is the selection
    //  already. Only the picture itself can be cropped then: the drag and the handles stay inside it (vx, vy, vs).
    on change full while full == 1 { vs = (H - 166) / H; vx = (W - W * (H - 166) / H) / 2; vy = 36; sx = vx + fo_x * W * vs; sy = 36 + fo_y * H * vs; sw = fo_w * W * vs; sh = fo_h * H * vs; scrw = W; phase = 2 }

    //  ── Windows ─────────────────────────────────────────────────────────────────────────────────────────────────
    //  Over the bare screen, under the selection and its handles: a press here begins a selection as on the bare screen (the drag then goes to
    //  `zpick` too, which was under the press), and a press that does not drag picks the window, cut to the screen.
    repeat i in 0..32 {
        let wa = clamp(wins.$i.x, 0, W)
        let wb = clamp(wins.$i.y, 0, H)
        let wc = clamp(wins.$i.x + wins.$i.w, 0, W)
        let wd = clamp(wins.$i.y + wins.$i.h, 0, H)
        //  the window under the pointer, while nothing is picked yet: undimmed, outlined
        group {
            show: phase == 1 and sw <= 8 and wz.$i.hover > 0.5
            clip inset 0 box { from: wa, wb; size: max(1, wc - wa), max(1, wd - wb) }
            image shot { at: 0, 0; size: W, H; show: W >= H and W <= 2 * H }
            image shotw { at: 0, 0; size: W, H; show: W > 2 * H }
            image shotv { at: 0, 0; size: W, H; show: H > W }
        }
        box { from: wa, wb; size: max(1, wc - wa), max(1, wd - wb); corner: pick(look, 6, 0, 8, 0); stroke: pick(look, 2, 2.2, 3, 1.5); color: mint; show: phase == 1 and sw <= 8 and wz.$i.hover > 0.5 }
        zone box wz.$i { from: wa, wb; size: max(1, wc - wa), max(1, wd - wb); cursor: crosshair; active: phase > 0 and full == 0 and wc - wa > 4 and wd - wb > 4; label: "Window" }
        on press wz.$i { picking = 1; x0 = pointer.x; y0 = pointer.y; phase = 1; sw = 0; sh = 0 }
        on release wz.$i while sw > 8 and sh > 8 { picking = 0; phase = 2 }
        on release wz.$i while not (sw > 8 and sh > 8) { picking = 0; sx = wa; sy = wb; sw = wc - wa; sh = wd - wb; phase = 2 }
    }

    //  ── Moving and resizing the selection ──────────────────────────────────────────────────────────────────────
    //  The body carries it. The handles come after, so they win where they overlap it. A handle pulls its own side or corner; the rest stays where it was when the press began.
    //  Only with Move: with the other tools a press inside the selection draws (below).
    zone box zsel { from: sx + 6, sy + 6; size: max(1, sw - 12), max(1, sh - 12); cursor: if(zsel.pressed > 0.5, grabbing, grab); active: phase == 2 and tool == 1 }
    on press zsel { bx = sx; by = sy }
    on drag zsel { sx = clamp(bx + drag.dx, ix0, ix1 - sw); sy = clamp(by + drag.dy, iy0, iy1 - sh) }

    //  ── Drawing ─────────────────────────────────────────────────────────────────────────────────────────────────
    //  Select: a press picks the mark under it (the logic looks), a drag moves it.
    zone box zmove { from: sx + 6, sy + 6; size: max(1, sw - 12), max(1, sh - 12); cursor: if(zmove.pressed > 0.5, grabbing, grab); active: phase == 2 and tool == 0; label: "Pick a mark" }
    on press zmove { px = pointer.x; py = pointer.y; mvx = 0; mvy = 0; emit sel_at }
    on drag zmove while selm >= 0 { mvx = drag.dx; mvy = drag.dy }
    on release zmove while selm >= 0 { emit sel_move }
    //  The other tools. The pen and the highlighter send each point to the logic; a shape is dragged out here and only sent when it is let go.
    zone box zdraw { from: sx + 6, sy + 6; size: max(1, sw - 12), max(1, sh - 12); cursor: crosshair; active: phase == 2 and tool >= 2; label: "Draw" }
    on press zdraw while tool == 2 or tool == 9 { px = pointer.x; py = pointer.y; emit pen_down }
    on drag zdraw while tool == 2 or tool == 9 { px = pointer.x; py = pointer.y; emit pen_pt }
    on release zdraw while tool == 2 or tool == 9 { emit pen_up }
    on press zdraw while (tool >= 3 and tool <= 5) or tool == 8 { ax = pointer.x; ay = pointer.y; qx = pointer.x; qy = pointer.y; dragging = 1 }
    on drag zdraw while dragging == 1 { qx = clamp(pointer.x, sx, sx + sw); qy = clamp(pointer.y, sy, sy + sh) }
    on release zdraw while dragging == 1 { emit shape_add }
    //  The eraser takes out every mark it passes over; one drag is one step of undo.
    on press zdraw while tool == 10 { px = pointer.x; py = pointer.y; erasing = 1; emit erase_down }
    on drag zdraw while tool == 10 { px = pointer.x; py = pointer.y; emit erase_pt }
    on release zdraw while tool == 10 { erasing = 0; emit erase_up }
    on press zdraw while tool == 7 { px = pointer.x; py = pointer.y; emit marker_add }
    on press zdraw while tool == 6 { px = pointer.x; py = pointer.y; emit txt_at; focus tq }
    on submit tq { emit txt_commit }
    zone box zh0 { at: sx + 0 * sw, sy + 0 * sh; size: 26, 26; corner: 13; cursor: nwse_resize; active: phase == 2 }
    on press zh0 { bx = sx; by = sy; bw = sw; bh = sh }
    on drag zh0 {
        sx = clamp(bx + drag.dx, ix0, bx + bw - 24)
        sw = bw + bx - clamp(bx + drag.dx, ix0, bx + bw - 24)
        sy = clamp(by + drag.dy, iy0, by + bh - 24)
        sh = bh + by - clamp(by + drag.dy, iy0, by + bh - 24)
    }
    zone box zh1 { at: sx + 0.5 * sw, sy + 0 * sh; size: 26, 26; corner: 13; cursor: ns_resize; active: phase == 2 }
    on press zh1 { bx = sx; by = sy; bw = sw; bh = sh }
    on drag zh1 {
        sx = bx
        sw = bw
        sy = clamp(by + drag.dy, iy0, by + bh - 24)
        sh = bh + by - clamp(by + drag.dy, iy0, by + bh - 24)
    }
    zone box zh2 { at: sx + 1 * sw, sy + 0 * sh; size: 26, 26; corner: 13; cursor: nesw_resize; active: phase == 2 }
    on press zh2 { bx = sx; by = sy; bw = sw; bh = sh }
    on drag zh2 {
        sx = bx
        sw = clamp(bw + drag.dx, 24, ix1 - bx)
        sy = clamp(by + drag.dy, iy0, by + bh - 24)
        sh = bh + by - clamp(by + drag.dy, iy0, by + bh - 24)
    }
    zone box zh3 { at: sx + 1 * sw, sy + 0.5 * sh; size: 26, 26; corner: 13; cursor: ew_resize; active: phase == 2 }
    on press zh3 { bx = sx; by = sy; bw = sw; bh = sh }
    on drag zh3 {
        sx = bx
        sw = clamp(bw + drag.dx, 24, ix1 - bx)
        sy = by
        sh = bh
    }
    zone box zh4 { at: sx + 1 * sw, sy + 1 * sh; size: 26, 26; corner: 13; cursor: nwse_resize; active: phase == 2 }
    on press zh4 { bx = sx; by = sy; bw = sw; bh = sh }
    on drag zh4 {
        sx = bx
        sw = clamp(bw + drag.dx, 24, ix1 - bx)
        sy = by
        sh = clamp(bh + drag.dy, 24, iy1 - by)
    }
    zone box zh5 { at: sx + 0.5 * sw, sy + 1 * sh; size: 26, 26; corner: 13; cursor: ns_resize; active: phase == 2 }
    on press zh5 { bx = sx; by = sy; bw = sw; bh = sh }
    on drag zh5 {
        sx = bx
        sw = bw
        sy = by
        sh = clamp(bh + drag.dy, 24, iy1 - by)
    }
    zone box zh6 { at: sx + 0 * sw, sy + 1 * sh; size: 26, 26; corner: 13; cursor: nesw_resize; active: phase == 2 }
    on press zh6 { bx = sx; by = sy; bw = sw; bh = sh }
    on drag zh6 {
        sx = clamp(bx + drag.dx, ix0, bx + bw - 24)
        sw = bw + bx - clamp(bx + drag.dx, ix0, bx + bw - 24)
        sy = by
        sh = clamp(bh + drag.dy, 24, iy1 - by)
    }
    zone box zh7 { at: sx + 0 * sw, sy + 0.5 * sh; size: 26, 26; corner: 13; cursor: ew_resize; active: phase == 2 }
    on press zh7 { bx = sx; by = sy; bw = sw; bh = sh }
    on drag zh7 {
        sx = clamp(bx + drag.dx, ix0, bx + bw - 24)
        sw = bw + bx - clamp(bx + drag.dx, ix0, bx + bw - 24)
        sy = by
        sh = bh
    }

    //  The size, in a small chip over the top left corner
    body {
        color: if(look == 3, mix(tint, #000000, 0.8), tint)
        glass: 100%
        opacity: 100%
        frost: 70%
        rim: 10%
        border: if(look == 3, 1.2, 0), mint
        shadow: 0, 4, 12, 22%, deep
        show: phase > 0 and sw > 2 and (look == 0 or look == 3)
        box { from: sx, cyc; size: 108, 26; corner: if(look == 3, 3, 13) }
    }
    body {
        color: tint
        rim: 40%
        border: 1.7, deep
        shadow: 2.5, 3, 0, 55%, deep
        show: phase > 0 and sw > 2 and look == 1
        box { from: sx, cyc; size: 108, 26; corner: 4 }
    }
    body {
        gradient: sx, cyc to sx + 108, cyc + 26, #ffcfe8, #e6d6ff 38%, #cfeaff 68%, #d2fff0
        rim: 55%
        border: 2.5, deep
        shadow: 2.5, 3, 0, 90%, pink_shadow
        show: phase > 0 and sw > 2 and look == 2
        box { from: sx, cyc; size: 108, 26; corner: 13 }
    }
    text number(sw, 0) { at: sx + 46, cyc + 13; anchor: right center; size: 13; weight: 700; color: ink; family: "Space Grotesk" ; show: phase > 0 and sw > 2 }
    text "×" { at: sx + 54, cyc + 13; anchor: center; size: 13; color: ink; opacity: 60%; family: "Space Grotesk" ; show: phase > 0 and sw > 2 }
    text number(sh, 0) { at: sx + 62, cyc + 13; anchor: left center; size: 13; weight: 700; color: ink; family: "Space Grotesk" ; show: phase > 0 and sw > 2 }

    //  ── The tools pill ───────────────────────────────────────────────────────────────────────────────────────────
    //  One bar: the tools, then (after a hairline) undo, redo, Save and Copy.
    //  Glass and Cyber: glass that bends (Cyber's near-black, with a neon hairline and magenta brackets). Retro and UwU: plastic, as Vitreus's drawers are.
    let pty = tby + 14 * (1 - pv)
    body {
        color: if(look == 3, mix(tint, #000000, 0.8), tint)
        glass: 100%
        opacity: pv
        show: pv > 0.01 and (look == 0 or look == 3)
        lens: true
        frost: 70%
        refraction: 100%
        rim: 10%
        shine: pointer
        border: if(look == 3, 1.2, 0), mint
        shadow: 0, 7, 20, 24%, deep
        box { from: tbx, pty; size: bw_, 52; corner: if(look == 3, 5, 26) }
    }
    repeat k in 0..4 {
        let pbl = tbx
        let pbr = tbx + bw_
        let pbx = if(mod(k, 2) == 0, pbl - 5, pbr + 5)
        let pby = if(mod(k, 4) < 2, pty - 5, pty + 57)
        let pbsx = if(mod(k, 2) == 0, 1, -1)
        let pbsy = if(mod(k, 4) < 2, 1, -1)
        path { at: pbx, pby; stroke: 2; color: deep; opacity: pv; show: pv > 0.01 and look == 3; move 0, pbsy * 14; line 0, 0; line pbsx * 14, 0 }
    }
    //  Retro: moulded putty, a lit lip, a dark outline and a hard shadow, square corners; and the accent-coloured tab of Vitreus's drawers, at the top left.
    body {
        color: tint
        rim: 40%
        border: 1.7, deep
        shadow: 4.5, 5.5, 0, 55%, deep
        opacity: pv
        show: pv > 0.01 and look == 1
        box { from: tbx, pty; size: bw_, 52; corner: 7 }
    }
    box { from: tbx + 22, pty - 4; size: 30, 6; corner: 2; color: mint; opacity: pv; show: pv > 0.01 and look == 1 }
    box { from: tbx + 22, pty - 4; size: 30, 6; corner: 2; stroke: 1.5; color: deep; opacity: pv; show: pv > 0.01 and look == 1 }
    //  UwU: candy plastic, pastel across both pills, a thick grape outline, a hard pink shadow; and cat ears at the two ends of the bar.
    body {
        gradient: tbx, pty to tbx + bw_, pty + 52, #ffcfe8, #e6d6ff 38%, #cfeaff 68%, #d2fff0
        rim: 55%
        border: 3, deep
        shadow: 4, 5, 0, 90%, pink_shadow
        opacity: pv
        show: pv > 0.01 and look == 2
        box { from: tbx, pty; size: bw_, 52; corner: 26 }
    }
    //  The ears, as Vitreus's drawers wear them (bar_glass.plm): one over each end of the bar —the tools pill's left, the actions pill's right—,
    //  leaning outwards, in the pastel of that end, with the grape outline and a pink inside.
    repeat side in 0..2 {
        let ex = if(side == 0, tbx + 50, tbx + bw_ - 50)
        let sg = if(side == 0, -1, 1)
        path { at: ex, pty; color: if(side == 0, #ffcfe8, #d2fff0); opacity: pv; show: pv > 0.01 and look == 2; move -23, 8; line sg * 13, -30; line 23, 8; close }
        path { at: ex, pty; stroke: 3; color: deep; opacity: pv; show: pv > 0.01 and look == 2; move -23, 8; line sg * 13, -30; line 23, 8 }
        path { at: ex, pty; color: #ff8fc8; opacity: pv; show: pv > 0.01 and look == 2; move -14, 5; line sg * 9, -19; line 14, 5; close }
    }

    //  the tool that is picked, as a bead of mint that slides to it
    body {
        color: mint
        opacity: pv
        rim: 22%
        border: pick(look, 0, 1.5, 2.5, 0), deep
        shadow: pick(look, 0, 2.5, 2.5, 0), pick(look, 0, 3, 3, 0), pick(look, 8, 0, 0, 14), pick(look, 40%, 55%, 90%, 75%), pick(look, mint, deep, pink_shadow, mint)
        show: pv > 0.01
        box { at: hx, ty + 14 * (1 - pv); size: 38, 38; corner: pick(look, 13, 4, 13, 3) }
    }

    group {
        opacity: pv
        move: 0, 14 * (1 - pv)
        //  0 select
        path { at: tl + 0 * 40, ty; color: mix(ink, onmint, tool == 0); move -5, -8; line -5, 8; line -1, 4; line 3, 10; line 5, 9; line 1, 3; line 6, 3; close }
        //  1 move the area: a cross with an arrowhead at each end
        path { at: tl + 1 * 40, ty; stroke: 2.2; color: mix(ink, onmint, tool == 1); move -9, 0; line 9, 0 }
        path { at: tl + 1 * 40, ty; stroke: 2.2; color: mix(ink, onmint, tool == 1); move 0, -9; line 0, 9 }
        path { at: tl + 1 * 40, ty; stroke: 2.2; color: mix(ink, onmint, tool == 1); move -6, -3; line -9, 0; line -6, 3 }
        path { at: tl + 1 * 40, ty; stroke: 2.2; color: mix(ink, onmint, tool == 1); move 6, -3; line 9, 0; line 6, 3 }
        path { at: tl + 1 * 40, ty; stroke: 2.2; color: mix(ink, onmint, tool == 1); move -3, -6; line 0, -9; line 3, -6 }
        path { at: tl + 1 * 40, ty; stroke: 2.2; color: mix(ink, onmint, tool == 1); move -3, 6; line 0, 9; line 3, 6 }
        //  2 pen
        path { at: tl + 2 * 40, ty; stroke: 2.4; color: mix(ink, onmint, tool == 2); move -9, 5; curve -2, -3 via -6, -9; curve 4, 3 via 2, 6; curve 9, -5 via 8, 0 }
        //  3 arrow
        path { at: tl + 3 * 40, ty; stroke: 2.4; color: mix(ink, onmint, tool == 3); move -8, 8; line 7, -7 }
        path { at: tl + 3 * 40, ty; stroke: 2.4; color: mix(ink, onmint, tool == 3); move -1, -8; line 8, -8; line 8, 1 }
        //  4 rectangle
        box { at: tl + 4 * 40, ty; size: 18, 13; corner: 3; stroke: 2.2; color: mix(ink, onmint, tool == 4) }
        //  5 ellipse
        ellipse { at: tl + 5 * 40, ty; radius: 8; stroke: 2.2; color: mix(ink, onmint, tool == 5) }
        //  6 text
        text "T" { at: tl + 6 * 40, ty; anchor: center; size: 20; weight: 700; color: mix(ink, onmint, tool == 6); family: "Space Grotesk" }
        //  7 marker
        ellipse { at: tl + 7 * 40, ty; radius: 9; stroke: 2.2; color: mix(ink, onmint, tool == 7) }
        text "1" { at: tl + 7 * 40, ty; anchor: center; size: 12; weight: 700; color: mix(ink, onmint, tool == 7); family: "Space Grotesk" }
        //  8 redact
        repeat j in 0..9 {
            box { at: tl + 8 * 40 - 6 + mod(j, 3) * 6, ty - 6 + floor(j / 3) * 6; size: 5, 5; corner: 1; color: mix(ink, onmint, tool == 8); opacity: pick(mod(j * 4, 5), 100%, 55%, 80%, 35%, 65%) }
        }
        //  9 highlighter: a chisel-tipped pen over the broad stripe it leaves
        box { at: tl + 9 * 40, ty + 6; size: 22, 7; corner: 2; color: mix(ink, onmint, tool == 9); opacity: 45% }
        path { at: tl + 9 * 40 + 1, ty - 3; color: mix(ink, onmint, tool == 9); move -7, 6; line 3, -6; line 8, -2; line -2, 10; close }
        //  10 eraser
        box { at: tl + 10 * 40, ty; size: 9, 20; corner: 3; rotate: 40deg; color: mix(ink, onmint, tool == 10) }
        box { at: tl + 10 * 40 + 5, ty + 8; size: 14, 3; corner: 1; color: mix(ink, onmint, tool == 10); opacity: 70% }

        zone box tz0 { at: tl + 0 * 40, ty; size: 38, 38; corner: 13; cursor: pointer; label: "Select" }
        zone box tz1 { at: tl + 1 * 40, ty; size: 38, 38; corner: 13; cursor: pointer; label: "Move the area" }
        zone box tz2 { at: tl + 2 * 40, ty; size: 38, 38; corner: 13; cursor: pointer; label: "Pen" }
        zone box tz3 { at: tl + 3 * 40, ty; size: 38, 38; corner: 13; cursor: pointer; label: "Arrow" }
        zone box tz4 { at: tl + 4 * 40, ty; size: 38, 38; corner: 13; cursor: pointer; label: "Rectangle" }
        zone box tz5 { at: tl + 5 * 40, ty; size: 38, 38; corner: 13; cursor: pointer; label: "Ellipse" }
        zone box tz6 { at: tl + 6 * 40, ty; size: 38, 38; corner: 13; cursor: pointer; label: "Text" }
        zone box tz7 { at: tl + 7 * 40, ty; size: 38, 38; corner: 13; cursor: pointer; label: "Marker" }
        zone box tz8 { at: tl + 8 * 40, ty; size: 38, 38; corner: 13; cursor: pointer; label: "Redact" }
        zone box tz9 { at: tl + 9 * 40, ty; size: 38, 38; corner: 13; cursor: pointer; label: "Highlighter" }
        zone box tz10 { at: tl + 10 * 40, ty; size: 38, 38; corner: 13; cursor: pointer; label: "Eraser" }
        on press tz0 { tool = 0 }
        on press tz1 { tool = 1 }
        on press tz2 { tool = 2 }
        on press tz3 { tool = 3 }
        on press tz4 { tool = 4 }
        on press tz5 { tool = 5 }
        on press tz6 { tool = 6 }
        on press tz7 { tool = 7 }
        on press tz8 { tool = 8 }
        on press tz9 { tool = 9 }
        on press tz10 { tool = 10 }

        //  a hairline between the tools and the colours
        box { at: tbx + 450, ty; size: 1, 24; color: ink; opacity: 22% }

        //  the nine colours (the rainbow from red to violet, then white and black), with a ring that slides to the one picked
        ellipse { at: cx_, ty; radius: 12; stroke: 2; color: ink }
        ellipse { at: tbx + 474 + 0 * 26, ty; radius: 8; color: #ff5c5c }
        ellipse { at: tbx + 474 + 1 * 26, ty; radius: 8; color: #ff9f45 }
        ellipse { at: tbx + 474 + 2 * 26, ty; radius: 8; color: #ffd93d }
        ellipse { at: tbx + 474 + 3 * 26, ty; radius: 8; color: #5fd068 }
        ellipse { at: tbx + 474 + 4 * 26, ty; radius: 8; color: #3fa9ff }
        ellipse { at: tbx + 474 + 5 * 26, ty; radius: 8; color: #5b5bf0 }
        ellipse { at: tbx + 474 + 6 * 26, ty; radius: 8; color: #b66cff }
        ellipse { at: tbx + 474 + 7 * 26, ty; radius: 8; color: #ffffff }
        ellipse { at: tbx + 474 + 8 * 26, ty; radius: 8; color: #000000 }
        ellipse { at: tbx + 474 + 8 * 26, ty; radius: 8; stroke: 1; color: #ffffff; opacity: 35% }
        zone box cz0 { at: tbx + 474 + 0 * 26, ty; size: 24, 24; corner: 12; cursor: pointer; label: "Red" }
        zone box cz1 { at: tbx + 474 + 1 * 26, ty; size: 24, 24; corner: 12; cursor: pointer; label: "Orange" }
        zone box cz2 { at: tbx + 474 + 2 * 26, ty; size: 24, 24; corner: 12; cursor: pointer; label: "Yellow" }
        zone box cz3 { at: tbx + 474 + 3 * 26, ty; size: 24, 24; corner: 12; cursor: pointer; label: "Green" }
        zone box cz4 { at: tbx + 474 + 4 * 26, ty; size: 24, 24; corner: 12; cursor: pointer; label: "Blue" }
        zone box cz5 { at: tbx + 474 + 5 * 26, ty; size: 24, 24; corner: 12; cursor: pointer; label: "Indigo" }
        zone box cz6 { at: tbx + 474 + 6 * 26, ty; size: 24, 24; corner: 12; cursor: pointer; label: "Violet" }
        zone box cz7 { at: tbx + 474 + 7 * 26, ty; size: 24, 24; corner: 12; cursor: pointer; label: "White" }
        zone box cz8 { at: tbx + 474 + 8 * 26, ty; size: 24, 24; corner: 12; cursor: pointer; label: "Black" }
        on press cz0 { col = 0 }
        on press cz1 { col = 1 }
        on press cz2 { col = 2 }
        on press cz3 { col = 3 }
        on press cz4 { col = 4 }
        on press cz5 { col = 5 }
        on press cz6 { col = 6 }
        on press cz7 { col = 7 }
        on press cz8 { col = 8 }

        box { at: tbx + 706, ty; size: 1, 24; color: ink; opacity: 22% }

        //  the stroke size: a dot as thick as the line will be
        ellipse { at: tbx + 730, ty; radius: pick(sz, 2.5, 4, 6); color: ink }
        ellipse { at: tbx + 730, ty; radius: 11; stroke: 1.2; color: ink; opacity: 35% }
        zone box zsz { at: tbx + 730, ty; size: 30, 30; corner: 15; cursor: pointer; label: "Stroke size" }
        on press zsz { sz = mod(sz + 1, 3) }

        //  ── The actions pill ─────────────────────────────────────────────────────────────────────────────────────────
        //  undo, redo
        //  where the tools end and the actions begin (the bar was two pills once)
        box { at: abx, ty; size: 1, 24; color: ink; opacity: 22% }
        path { at: abx + 24, ty; stroke: 2.4; color: ink; opacity: if(can_undo, 100%, 38%); move 6, 6; curve -4, -2 via 5, -6; line -2, -6 }
        path { at: abx + 24, ty; stroke: 2.4; color: ink; opacity: if(can_undo, 100%, 38%); move 1, -10; line -5, -5; line 1, 0 }
        path { at: abx + 64, ty; stroke: 2.4; color: ink; opacity: if(can_redo, 100%, 38%); move -6, 6; curve 4, -2 via -5, -6; line 2, -6 }
        path { at: abx + 64, ty; stroke: 2.4; color: ink; opacity: if(can_redo, 100%, 38%); move -1, -10; line 5, -5; line -1, 0 }
        zone box zundo { at: abx + 24, ty; size: 34, 34; corner: 13; cursor: pointer; label: "Undo"; active: can_undo }
        zone box zredo { at: abx + 64, ty; size: 34, 34; corner: 13; cursor: pointer; label: "Redo"; active: can_redo }
        on press zundo { emit do_undo }
        on press zredo { emit do_redo }
        box { at: abx + 88, ty; size: 1, 24; color: ink; opacity: 22% }

        //  Drag out: six grip dots and a small picture. Pressed and moved, the finished picture goes with the pointer to whatever it is let go on.
        repeat j in 0..6 {
            ellipse { at: abx + 101 + mod(j, 2) * 5, ty - 6 + floor(j / 2) * 6; radius: 1.6; color: ink; opacity: if(drag_ready, 100%, 38%) }
        }
        box { at: abx + 118, ty; size: 14, 12; corner: 2; stroke: 1.8; color: ink; opacity: if(drag_ready, 100%, 38%) }
        path { at: abx + 118, ty; color: ink; opacity: if(drag_ready, 100%, 38%); move -5, 4; line -1, -1; line 2, 2; line 5, -1; line 5, 4; close }
        zone box zdrag { at: abx + 112, ty; size: 36, 36; corner: 13; cursor: if(zdrag.pressed > 0.5, grabbing, grab); carries: "{drag_path}"; active: drag_ready; label: "Drag the picture out" }
        on carry zdrag { emit do_dropped }
        //  Copy the text: lines of text in a page.
        box { at: abx + 152, ty; size: 18, 22; corner: 3; stroke: 1.8; color: ink; opacity: if(busy == 1, 38%, 100%) }
        repeat j in 0..3 {
            box { at: abx + 152 - if(j == 2, 2, 0), ty - 5 + j * 5; size: if(j == 2, 6, 10), 1.8; corner: 0.9; color: ink; opacity: if(busy == 1, 38%, 100%) }
        }
        zone box zocr { at: abx + 152, ty; size: 36, 36; corner: 13; cursor: pointer; active: busy == 0; label: "Copy the text" }
        on press zocr { scrw = W; busy = 1; emit do_ocr_copy }
        //  Hide what is private: an eye, struck through.
        path { at: abx + 192, ty; stroke: 1.8; color: ink; opacity: if(busy == 1, 38%, 100%); move -10, 0; curve 10, 0 via 0, -9; curve -10, 0 via 0, 9 }
        ellipse { at: abx + 192, ty; radius: 3; color: ink; opacity: if(busy == 1, 38%, 100%) }
        path { at: abx + 192, ty; stroke: 1.8; color: ink; opacity: if(busy == 1, 38%, 100%); move -8, 8; line 8, -8 }
        zone box zhide { at: abx + 192, ty; size: 36, 36; corner: 13; cursor: pointer; active: busy == 0; label: "Redact what is private" }
        on press zhide { scrw = W; busy = 1; emit do_hide }
        box { at: abx + 216, ty; size: 1, 24; color: ink; opacity: 22% }

        //  save, a clear pill, and copy, the one that is filled
        box { at: abx + 272, ty; size: 80, 36; corner: pick(look, 18, 5, 18, 3); stroke: pick(look, 1.4, 1.7, 2.5, 1.2); color: pick(look, ink, deep, deep, mint); opacity: pick(look, 55%, 100%, 100%, 90%) }
        text "Save" { at: abx + 272, ty; anchor: center; size: 15; weight: 700; color: ink; family: "Space Grotesk" }
        body {
            color: mint
            opacity: 100%
            rim: 22%
            border: pick(look, 0, 1.5, 2.5, 0), deep
            shadow: pick(look, 0, 2.5, 2.5, 0), pick(look, 0, 3, 3, 0), pick(look, 10, 0, 0, 14), pick(look, 38%, 55%, 90%, 75%), pick(look, mint, deep, pink_shadow, mint)
            box { at: abx + 368, ty; size: 96, 36; corner: pick(look, 18, 5, 18, 3) }
        }
        text "Copy" { at: abx + 368, ty; anchor: center; size: 15; weight: 800; color: onmint; family: "Space Grotesk" }

        zone box zsave { at: abx + 272, ty; size: 80, 36; corner: 18; cursor: pointer; label: "Save" }
        zone box zcopy { at: abx + 368, ty; size: 96, 36; corner: 18; cursor: pointer; label: "Copy" }
        on press zsave { scrw = W; emit do_save }
        on press zcopy { scrw = W; emit do_copy }

        //  The tooltips: above the bar, or under its hint when the bar is at the top of the screen.
        let tipy = if(tby > 60, ty - 46, ty + 74)
        on hover tz0 for 400ms { tip = 1 }
        on leave tz0 { tip = 0 }
        on press tz0 { tip = 0 }
        on hover tz1 for 400ms { tip = 2 }
        on leave tz1 { tip = 0 }
        on press tz1 { tip = 0 }
        on hover tz2 for 400ms { tip = 3 }
        on leave tz2 { tip = 0 }
        on press tz2 { tip = 0 }
        on hover tz3 for 400ms { tip = 4 }
        on leave tz3 { tip = 0 }
        on press tz3 { tip = 0 }
        on hover tz4 for 400ms { tip = 5 }
        on leave tz4 { tip = 0 }
        on press tz4 { tip = 0 }
        on hover tz5 for 400ms { tip = 6 }
        on leave tz5 { tip = 0 }
        on press tz5 { tip = 0 }
        on hover tz6 for 400ms { tip = 7 }
        on leave tz6 { tip = 0 }
        on press tz6 { tip = 0 }
        on hover tz7 for 400ms { tip = 8 }
        on leave tz7 { tip = 0 }
        on press tz7 { tip = 0 }
        on hover tz8 for 400ms { tip = 9 }
        on leave tz8 { tip = 0 }
        on press tz8 { tip = 0 }
        on hover tz9 for 400ms { tip = 10 }
        on leave tz9 { tip = 0 }
        on press tz9 { tip = 0 }
        on hover tz10 for 400ms { tip = 11 }
        on leave tz10 { tip = 0 }
        on press tz10 { tip = 0 }
        on hover cz0 for 400ms { tip = 12 }
        on leave cz0 { tip = 0 }
        on press cz0 { tip = 0 }
        on hover cz1 for 400ms { tip = 13 }
        on leave cz1 { tip = 0 }
        on press cz1 { tip = 0 }
        on hover cz2 for 400ms { tip = 14 }
        on leave cz2 { tip = 0 }
        on press cz2 { tip = 0 }
        on hover cz3 for 400ms { tip = 15 }
        on leave cz3 { tip = 0 }
        on press cz3 { tip = 0 }
        on hover cz4 for 400ms { tip = 16 }
        on leave cz4 { tip = 0 }
        on press cz4 { tip = 0 }
        on hover cz5 for 400ms { tip = 17 }
        on leave cz5 { tip = 0 }
        on press cz5 { tip = 0 }
        on hover cz6 for 400ms { tip = 18 }
        on leave cz6 { tip = 0 }
        on press cz6 { tip = 0 }
        on hover cz7 for 400ms { tip = 19 }
        on leave cz7 { tip = 0 }
        on press cz7 { tip = 0 }
        on hover cz8 for 400ms { tip = 20 }
        on leave cz8 { tip = 0 }
        on press cz8 { tip = 0 }
        on hover zsz for 400ms { tip = 21 }
        on leave zsz { tip = 0 }
        on press zsz { tip = 0 }
        on hover zundo for 400ms { tip = 22 }
        on leave zundo { tip = 0 }
        on press zundo { tip = 0 }
        on hover zredo for 400ms { tip = 23 }
        on leave zredo { tip = 0 }
        on press zredo { tip = 0 }
        on hover zdrag for 400ms { tip = 24 }
        on leave zdrag { tip = 0 }
        on press zdrag { tip = 0 }
        on hover zocr for 400ms { tip = 25 }
        on leave zocr { tip = 0 }
        on press zocr { tip = 0 }
        on hover zhide for 400ms { tip = 26 }
        on leave zhide { tip = 0 }
        on press zhide { tip = 0 }
        on hover zsave for 400ms { tip = 27 }
        on leave zsave { tip = 0 }
        on press zsave { tip = 0 }
        on hover zcopy for 400ms { tip = 28 }
        on leave zcopy { tip = 0 }
        on press zcopy { tip = 0 }
        Tip(1, tl + 0 * 40, tipy, 183, "Select and move marks")
        Tip(2, tl + 1 * 40, tipy, 124, "Move the area")
        Tip(3, tl + 2 * 40, tipy, 50, "Pen")
        Tip(4, tl + 3 * 40, tipy, 65, "Arrow")
        Tip(5, tl + 4 * 40, tipy, 95, "Rectangle")
        Tip(6, tl + 5 * 40, tipy, 80, "Ellipse")
        Tip(7, tl + 6 * 40, tipy, 58, "Text")
        Tip(8, tl + 7 * 40, tipy, 139, "Numbered marker")
        Tip(9, tl + 8 * 40, tipy, 124, "Redact an area")
        Tip(10, tl + 9 * 40, tipy, 109, "Highlighter")
        Tip(11, tl + 10 * 40, tipy, 72, "Eraser")
        Tip(12, tbx + 474 + 0 * 26, tipy, 50, "Red")
        Tip(13, tbx + 474 + 1 * 26, tipy, 80, "Orange")
        Tip(14, tbx + 474 + 2 * 26, tipy, 80, "Yellow")
        Tip(15, tbx + 474 + 3 * 26, tipy, 80, "Green")
        Tip(16, tbx + 474 + 4 * 26, tipy, 65, "Blue")
        Tip(17, tbx + 474 + 5 * 26, tipy, 80, "Indigo")
        Tip(18, tbx + 474 + 6 * 26, tipy, 80, "Violet")
        Tip(19, tbx + 474 + 7 * 26, tipy, 65, "White")
        Tip(20, tbx + 474 + 8 * 26, tipy, 65, "Black")
        Tip(21, tbx + 730, tipy, 109, "Stroke size")
        Tip(22, abx + 24, tipy, 117, "Undo  Ctrl+Z")
        Tip(23, abx + 64, tipy, 161, "Redo  Ctrl+Shift+Z")
        Tip(24, abx + 112, tipy, 154, "Drag into any app")
        Tip(25, abx + 152, tipy, 124, "Copy the text")
        Tip(26, abx + 192, tipy, 168, "Redact private info")
        Tip(27, abx + 272, tipy, 117, "Save  Ctrl+S")
        Tip(28, abx + 368, tipy, 109, "Copy  Enter")

        //  Snap's own word (`toast`): where the tooltips go, over them, a little bigger, in the look's material.
        group {
            show: toast_k > 0.01 and pv > 0.9
            opacity: clamp(toast_k, 0, 1)
            scale: 0.9 + 0.1 * toast_k
            pivot: tbx + bw_ / 2, tipy
            measure toast_m
            body {
                color: if(look == 3, mix(tint, #000000, 0.8), tint)
                rim: 10% + 30% * (look == 1) + 45% * (look == 2)
                border: pick(look, 0, 1.5, 2.5, 1.2), if(look == 3, mint, deep)
                shadow: pick(look, 0, 2.5, 2.5, 0), pick(look, 4, 3, 3, 4), pick(look, 14, 0, 0, 14), pick(look, 34%, 55%, 90%, 34%), if(look == 2, pink_shadow, deep)
                box { at: tbx + bw_ / 2, tipy; size: toast_m.width + 36, 34; corner: pick(look, 17, 5, 17, 3) }
            }
            text toast { at: tbx + bw_ / 2, tipy; anchor: center; size: 14; weight: 700; color: ink; family: "Space Grotesk"; measure: toast_m }
        }

        //  a small hint of the keys, under the pills
        text "Enter  copy      Ctrl+S  save      Ctrl+Z  undo      Esc  close" { at: tbx + bw_ / 2, tby + 52 + 14 + if(look == 1 or look == 2, 6, 0); anchor: center; size: 12; color: if(look == 1 or look == 2, tint, ink); opacity: if(look == 1 or look == 2, 85%, 62%); family: "Space Grotesk" }
    }

    //  While a text is being written the keys are its own: Esc drops the text instead of closing, Enter keeps it (`submit tq`) instead of copying.
    on key Escape while typing == 1 { typing = 0; blur }
    on key Escape while typing == 0 { emit do_quit }
    on key Return while phase == 2 and typing == 0 { scrw = W; emit do_copy }
    on key Ctrl+s while phase == 2 { scrw = W; emit do_save }
    on key Ctrl+z while typing == 0 { emit do_undo }
    on key Ctrl+Shift+z while typing == 0 { emit do_redo }
    on key Ctrl+y while typing == 0 { emit do_redo }
    on key Delete while typing == 0 and tool == 0 and selm >= 0 { emit mk_del }
    on key BackSpace while typing == 0 and tool == 0 and selm >= 0 { emit mk_del }
}
