language 0.1
import "../palette.plm"

//  Files: a file manager in the shell's own glass. Places down the left (the ones you know, the drives, the folders you pinned), where you are across the top (back, forward, up, a path you can click or
//  type, tabs under it), the folder as tiles or lines in the middle and a bar under it. Everything is drawn from the palette (so any theme is its own) and the file and folder pictures are pencil
//  drawings, like the shell's icons. The logic (files.luau) does the work with `find`, `cp`, `mv`, `gio` and the like, and says what is chosen, what is going on and what can be undone.
//
//  Keys (when the window has the keyboard): Enter opens, F2 renames, Delete trashes, Ctrl+C / X / V, Ctrl+A, Ctrl+I, Ctrl+Z undoes, Ctrl+Shift+N a new folder, Ctrl+H hidden files, F5 refreshes, Space looks
//  at a file, Ctrl+L types a path, Ctrl+T / Ctrl+W / Ctrl+Tab are the tabs, Ctrl+D pins this folder, Ctrl++ and Ctrl+- zoom, typing a name searches. Backspace or Alt+Up goes up, Alt+Left and Alt+Right back
//  and forward, Alt+Home goes home, the arrows move the choice (with Shift they extend it, with Ctrl they only move), Escape lets go of it. See `files.luau` for the whole list.
//
//  Open it with SUPER + E, or "Files" in the launcher (bin/vitreus-files).

scene Files {
    //  Motion: pleamar's house springs, made about 18% quicker (stiffness x1.38, damping x1.18: the same overshoot, sooner).
    spring calm = 208, 27
    spring quick = 581, 47
    surface { size: 1000, 650; kind: window; title: "Files"; app_id: "vitreus.files"; keyboard: on_demand }
    //  The glass bends a copy of the wallpaper (as the shell does) unless the Glass page's Live bend is on (`glive`): then it bends the windows behind it,
    //  a capture at the page's refresh pace (`gcap`). The copy is the default because a capture needs a moment to start and the window is only blurred until it does.
    lens = image "~/.cache/pleamar/vitreus/lens.png" while not glive
    lens every max(gcap, 16) * 1ms

    permissions {
        services: "files", "files.write"
        run: "find", "magick", "vitreus-thumb", "ffmpeg", "ffprobe", "identify", "pdftoppm", "stat", "du", "file", "rm", "rmdir", "hyprctl", "xdg-open", "gio", "cp", "mv", "mkdir", "df", "xdg-user-dir", "printenv", "pleamar", "wl-copy", "wl-paste", "fc-match", "vitreus-files", "cat", "head", "chmod", "ln", "touch", "bsdtar", "grep", "sha256sum", "lsblk", "findmnt", "udisksctl", "awww", "which", "readlink", "kitty", "alacritty", "foot", "wezterm", "konsole", "gnome-terminal", "xterm", "date", "sync", "sh"
    }

    // ── what the logic says ──
    text dragicon = ""               // the picture that goes under the pointer while a file is dragged out (the logic makes it when a tile is pressed)
    fact view: grid | lines = grid
    fact hidden = false              // hidden files shown
    fact sort: name | size | type | date = name
    fact sortrev = false             // the order turned round
    fact dirfirst = true             // folders before files
    fact zoom = 3                    // how big the tiles are, 1 to 5
    fact tilebase = 128              // the tile's width that goes with it (the logic knows the steps)
    fact tilew = 128                 // the tile's width as drawn (the scene says: a wide window stretches them so that a row never has more than twelve)
    fact total = 0                   // rows of tiles in the folder (or blocks of lines)
    fact itemsn = 0                  // how many things are in it
    fact first = 0                   // the first row of the window the logic is showing
    fact cols = 6                    // tiles across, as the middle is wide
    fact gen = 0                     // goes up with each folder you go into: the list starts at its top
    fact sct = 0                     // where the list is scrolled to (pixels): the wheel, the bar and the logic all say it
    fact can.back = false
    fact can.fwd = false
    fact ready = false
    fact roomw = 700                 // how wide the folder's part is, for the tabs
    fact vh = 400                    // how tall the folder's window is, for scrolling a chosen tile into view
    fact clip.on = false             // something is waiting to be pasted
    fact ask.on = false              // the name dialog (new folder, rename)
    fact ask.gen = 0
    fact ask.input = true            // the dialog asks for a name (else it is a question with Cancel and a button)
    fact ask.danger = false          // and the button is the alert colour
    fact in.trash = false            // the folder shown is the trash
    fact in.list = false             // what is shown is a list made of places (a search, recent files, starred ones), not a folder
    fact menu.on = false             // the right-click menu
    fact menu.x = 0
    fact menu.y = 0
    fact menu.h = 100                // how tall the menu is (the logic adds up its rows and the lines between groups)
    fact menu.cur = -1               // the line the keyboard is on (Up and Down walk them, Enter presses it); -1 when the mouse is choosing
    fact prop.on = false             // the properties card
    fact prop.h = 320
    fact pm.on = false               // the card shows the permissions' switches (a single thing that is yours)
    fact pm.bits = 0                 // rwxrwxrwx as a number of nine bits
    fact crumbw = 300                // how much room the path has: the logic keeps the last folders that fit
    fact pen = 0                     // the pointer is on something that boils: the pencil's clock runs only then
    //  Every zone that boils says `leave` before `enter`, and `hover` again a moment after: when the pointer goes straight from one to the next, both fire in one frame and the one declared last stays (so `enter` has to be),
    //  and when it is another zone's `leave` that stays, the `hover` sets it right again in 80 ms. Without them the clock stopped under the pointer and the pencil froze.
    fact obs = false                 // Vitreus has its glass off: flat obsidian (Vitreus says so with `fact obs true`)
    fact gop = 1                     // the shell's glass settings (Vitreus says so, as with obs): opacity, X-Bend on, edge thickness, rainbow fringe, frost, dome, milk, rim
    fact gbend = false
    fact gflat = true                // on trial: Files does not bend what is behind it at all, the compositor blurs it (always in its place, also while the window is dragged)
    let gb = gbend and not gflat     // whether its glass bends
    fact glive = false               // Live bend: the glass bends the windows behind it, not the wallpaper copy
    fact gcap = 300                  // the least time between two captures of Live bend, in ms
    fact grefr = 1
    fact gdisp = 1
    fact gclear = 1
    fact gdome = 0
    fact gmilk = 0
    fact gsmoke = 0
    fact grim = 1
    fact look = 0                    // the shell's theme (Vitreus says so): 0 Glass, 1 Retro, 2 UwU, 3 Cyber; the plastic ones get an outline and a hard shadow
    text status = ""
    text empty = "This folder is empty"
    text free = ""
    text sortname = "Name"
    text ask.title = ""
    text ask.ok = "OK"
    text ask.msg = ""
    text askin = ""
    text sq = ""                      // what is typed in the search field
    fact searching = false           // the search field is open (it takes the place of the path)
    fact so.where = 0                // the search: 0 this folder, 1 the whole home folder
    fact so.what = 0                 // 0 names, 1 what is written in the files
    fact so.kind = 0                 // 0 anything, 1 folders, 2 pictures, 3 documents, 4 sounds, 5 videos
    text locin = ""                  // what is typed where the path is
    fact loc.edit = false            // the path is being typed
    fact rb.on = false               // a box is being dragged over the folder to choose what is in it
    fact rb.down = false             // the press that may start it was on the folder itself (a press that closed the menu was not: the zone under the menu's catch-all still sees the pointer move)
    fact rb.ax = 0                   // where it began and where it is, in the folder's own measures (the list's width, and down from its top)
    fact rb.ay = 0
    fact rb.bx = 0
    fact rb.by = 0
    fact job.on = false              // something is being copied, moved or put away
    fact job.p = 0                   // how far it has got, 0 to 1 (-1 when it cannot say)
    text job.text = ""
    text job.detail = ""             // how much of how much, how fast and how long is left (a copy or a move)
    fact undo.on = false             // the last thing done can be taken back
    text undo.text = ""
    fact cf.on = false               // the question about a name that is taken
    fact cf.all = false              // and the answer is for all the others
    text cf.name = ""
    text cf.msg = ""
    fact pick.on = false             // a list to choose from (open with, a template, what to make an archive of)
    text pick.title = ""
    fact pv.on = false               // the look at a file
    fact pv.kind = 0                 // 0 only what it is, 1 a picture, 2 its words
    text pv.name = ""
    text pv.sub = ""
    text pv.text = ""
    text pv.path = ""
    fact pv.n = 0                    // which of how many (so that the arrows say there is more)
    fact pv.of = 0
    //  Choosing for another program: a browser's «Open» or «Save as» (bin/vitreus-portal starts Files so, with $FILES_CHOOSE). A strip at the bottom says what is asked, and holds the name to save as,
    //  the kinds of file shown, Cancel and the button that answers.
    fact ch.on = false               // this window was opened to choose
    fact ch.save = false             // ... a place to save to: there is a name to give
    fact ch.filt = false             // there are kinds of file to choose between (the pill cycles them)
    fact ch.typing = false           // the name field has the writing cursor (the logic then leaves the keys to it)
    fact ch.done = false             // answered, or cancelled: the window goes
    text ch.ok = "Open"
    text ch.hint = ""
    text ch.filter = ""
    text chname = ""
    event search_go ->               // Enter in it: look in the folders under this one too
    event loc_go ->                  // Enter in the path being typed

    model crumbs max 8 { at: number; name: text; path: text; x: number; w: number; last: bool }
    fact hr.y = 18                   // the place we are in: the middle of its row in the places' column, its height, and whether there is one (the logic says so)
    fact hr.h = 36
    fact hr.on = false
    model places max 40 { at: number; name: text; path: text; pk: number; here: bool; pinned: bool; kind: number; eject: bool; use: number }
    model tabs max 10 { at: number; name: text; x: number; w: number; active: bool }
    model pinfo max 1 { name: text; sub: text; ik: number; thumb: image 192, 144; has.thumb: bool }
    model prows max 18 { label: text; value: text; tog: bool; on: bool; btn: text; hb: bool; k: number }
    model menuitems max 28 { label: text; k: number; on: bool; ic: number; key: text; danger: bool; sep: bool; chk: bool; cy: number }       // (`cy`: the middle of its line in the menu's column, for the thumb)
    fact menu.ky = 16                // the middle of the line the keyboard is on (the logic says so, before `menu.cur`)
    fact menu.kd = false             // …and whether that one puts something away
    fact menu.hov = false            // the pointer is on a line of the menu
    fact menu.td = 0                 // the line the thumb is on puts something away (the alert colour)
    model picks max 14 { at: number; label: text; sub: text; hs: bool; ic: number }
    model rows max 12 {
        list cells max 10 {
            at: number
            name: text
            ik: number
            carry: text
            thumb: image 192, 144
            has.thumb: bool
            picked: bool
            cur: bool
            hidden: bool
            cut: bool
            link: bool
            broken: bool
            star: bool
            size: text
            date: text
            kind: text
        }
    }

    event slid ->
    event set_cols ->
    event tile ->
    event tile_up ->
    event tile_menu ->
    event tile_mid ->
    event bg_menu ->
    event place ->
    event place_eject ->
    event crumb ->
    event act ->
    event ask_ok ->
    event menu_close ->
    event dropped ->
    event spring ->
    event place_menu ->
    event focused ->
    event band ->
    event band_end ->
    event sort_by ->
    event sopt ->
    event tab_go ->
    event tab_close ->
    event pick_ok ->
    event cf_pick ->
    event job_cancel ->
    event prop_act ->
    event perm ->

    // ── the pencil's clock, and the theme ──
    prop time = 0
    spin time by if(pen > 0.5, 1, 0)
    prop ob = 0 ~calm
    follow ob = if(obs or look == 1 or look == 2, 1, 0)
    prop pl = 0 ~calm
    follow pl = if(look == 1 or look == 2, 1, 0)
    prop uk = 0 ~calm
    follow uk = if(look == 2, 1, 0)
    prop sq = 0 ~calm
    follow sq = if(look == 1 or look == 3 or look == 7, 1, 0)       // Retro, Cyber and Doodle cut their corners squarer, as the bar's drawers do (`rc` in vitreus.plm)
    prop ddk = 0 ~calm
    follow ddk = if(look == 7, 1, 0)                   // Doodle: no hatching, and all but sharp corners, as in the Settings
    shader pencilhatch = file "../pencilhatch.wgsl"    // the pencil shading inside the places' thumb (the Settings' own)
    shader fillstyle = file "../fillstyle.wgsl"        // ... and the other fills, when Settings > Style > Fill is not Pencil
    //  Settings > Style, as Vitreus has it (it says so itself when it changes; asked when this starts): the fill (0 Pencil, 1 Marker, 2 Gradient, 3 Plain, 4 Dots)
    //  and how strong it is (Shade: 0 Off, 1 Light, 2 Normal, 3 Heavy).
    fact pn_fill_i = 0
    fact pn_shade_i = 2
    prop pn_hatch = 1 ~calm
    follow pn_hatch = pick(pn_shade_i, 0, 0.5, 1, 1.5)
    let rr = 1 - 0.73 * sq                             // what every corner is multiplied by
    //  The window's own corners: the compositor's (Hyprland's `decoration:rounding`, which Vitreus sets from the theme), so the glass fills the rounded window
    //  to its edge and meets its border; -1 (no Hyprland to ask) keeps the theme's own.
    fact wr = -1
    let wcr = if(wr >= 0, wr, 22 * rr)

    // >>> icons (written by gen_icons.py: edit that, not this)
    //  A file's or a folder's picture in pencil: a folder, a picture, a PDF, a sound, a video, code, an archive or any other file (`ik`, which the logic sets). `s` is its size (1 is 64 px); `hot` (hover) swells it and redraws it about five times a second. The folder takes the accent and the files the ink, so any palette is theirs.
    component PFile(cx: number, cy: number, s: number, ik: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let jb = 0.7 * a * (0.5 + s)
        let w1 = 1.3 + 1.1 * s
        let w2 = 0.9 + 0.6 * s
        let off = 0.35 * (0.5 + s)
        group {
            pivot: cx, cy
            scale: 1 + 0.08 * a
            group {
                show: ik >= 1
                path { at: cx + jb * sin(fr * 73 + 457), cy + jb * sin(fr * 52 + 3424); color: ink; opacity: (o) * 0.06; move 6.70 * s + -0.15, -25.82 * s + 0.09; line -14.29 * s + -0.14, -25.73 * s + 0.13; curve -16.84 * s + 0.08, -22.89 * s + 0.06 via -16.79 * s + 0.10, -26.14 * s + -0.07; line -17.30 * s + -0.15, 23.14 * s + 0.07; curve -14.24 * s + -0.12, 26.28 * s + 0.14 via -16.79 * s + 0.11, 25.70 * s + -0.15; line 13.89 * s + -0.06, 26.21 * s + 0.11; curve 16.70 * s + -0.15, 23.07 * s + 0.03 via 16.90 * s + -0.05, 25.73 * s + -0.13; line 17.00 * s + -0.00, -16.27 * s + -0.13; line 7.30 * s + 0.15, -26.29 * s + -0.14; close }
                path { at: cx + jb * sin(fr * 46 + 4153), cy + jb * sin(fr * 71 + 4816); color: ink; opacity: (o) * 0.16; move 7.06 * s + 0.03, -26.25 * s + -0.12; line 6.80 * s + -0.10, -15.82 * s + 0.09; line 16.71 * s + -0.15, -16.07 * s + -0.03; close }
                path { at: cx + jb * sin(fr * 51 + 1079), cy + jb * sin(fr * 50 + 3026); stroke: w1; color: ink; opacity: (o); move 6.83 * s + -0.09, -26.29 * s + -0.14; line -14.23 * s + -0.12, -25.82 * s + 0.09; curve -17.29 * s + -0.15, -23.08 * s + -0.04 via -16.73 * s + 0.13, -25.74 * s + 0.13; line -17.23 * s + -0.11, 23.27 * s + 0.14; curve -14.10 * s + -0.05, 26.01 * s + 0.00 via -17.30 * s + -0.15, 25.70 * s + -0.15; line 13.94 * s + -0.03, 25.70 * s + -0.15; curve 16.71 * s + -0.15, 22.94 * s + -0.03 via 16.92 * s + -0.04, 25.70 * s + -0.15; line 17.23 * s + 0.11, -16.28 * s + -0.14; line 7.00 * s + 0.00, -26.30 * s + -0.15; line 3.92 * s + -0.04, -26.30 * s + -0.15 }
                path { at: cx + off + jb * sin(fr * 53 + 4575), cy + off + jb * sin(fr * 61 + 267); stroke: w2; color: ink; opacity: (o) * 0.28; move 7.22 * s + 0.11, -25.70 * s + 0.15; line -13.98 * s + 0.01, -25.87 * s + 0.06; curve -16.70 * s + 0.15, -22.70 * s + 0.15 via -16.96 * s + 0.02, -25.93 * s + 0.03; line -17.05 * s + -0.02, 22.78 * s + -0.11; curve -13.87 * s + 0.06, 26.29 * s + 0.14 via -17.21 * s + -0.10, 25.91 * s + -0.04; line 13.84 * s + -0.08, 25.71 * s + -0.15; curve 16.87 * s + -0.06, 22.70 * s + -0.15 via 17.18 * s + 0.09, 26.17 * s + 0.08; line 16.74 * s + -0.13, -15.80 * s + 0.10; line 7.23 * s + 0.11, -26.17 * s + -0.08; line 3.72 * s + -0.14, -25.78 * s + 0.11 }
                path { at: cx + jb * sin(fr * 58 + 1389), cy + jb * sin(fr * 74 + 4072); stroke: w1; color: ink; opacity: (o); move 7.26 * s + 0.13, -26.15 * s + -0.08; line 6.94 * s + -0.03, -18.64 * s + -0.07; curve 9.67 * s + 0.09, -15.71 * s + 0.14 via 7.24 * s + 0.12, -16.10 * s + -0.05; line 16.80 * s + -0.10, -15.74 * s + 0.13 }
                path { at: cx + off + jb * sin(fr * 60 + 1072), cy + off + jb * sin(fr * 47 + 3809); stroke: w2; color: ink; opacity: (o) * 0.28; move 7.28 * s + 0.14, -25.87 * s + 0.06; line 6.90 * s + -0.05, -18.21 * s + 0.15; curve 9.73 * s + 0.12, -15.98 * s + 0.01 via 7.18 * s + 0.09, -15.97 * s + 0.01; line 17.30 * s + 0.15, -15.83 * s + 0.08 }
            }
            group {
                show: ik == 0
                path { at: cx + jb * sin(fr * 76 + 1963), cy + jb * sin(fr * 73 + 2520); stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -26.30 * s + -0.15, -2.70 * s + 0.15; line -26.27 * s + -0.13, -18.38 * s + 0.06; curve -22.36 * s + 0.07, -22.09 * s + -0.05 via -26.21 * s + -0.11, -22.28 * s + -0.14; line -12.55 * s + -0.03, -21.85 * s + 0.08; curve -6.93 * s + -0.09, -19.28 * s + 0.02 via -8.78 * s + 0.11, -22.15 * s + -0.08; line -6.41 * s + -0.08, -18.44 * s + 0.13; curve -0.21 * s + 0.14, -16.25 * s + -0.13 via -3.84 * s + 0.08, -15.72 * s + 0.14; line 22.70 * s + 0.10, -15.91 * s + 0.05; curve 26.29 * s + 0.15, -12.78 * s + -0.14 via 25.93 * s + -0.04, -16.15 * s + -0.07; line 25.91 * s + -0.05, -2.85 * s + 0.08 }
                path { at: cx + off + jb * sin(fr * 56 + 1200), cy + off + jb * sin(fr * 49 + 3622); stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.28; move -26.30 * s + -0.15, -2.83 * s + 0.08; line -26.30 * s + -0.15, -18.39 * s + 0.05; curve -22.75 * s + -0.13, -21.93 * s + 0.04 via -25.99 * s + 0.01, -21.85 * s + 0.07; line -12.59 * s + -0.05, -21.89 * s + 0.05; curve -6.46 * s + 0.15, -19.59 * s + -0.14 via -9.30 * s + -0.15, -22.15 * s + -0.07; line -6.50 * s + -0.13, -18.85 * s + -0.08; curve -0.67 * s + -0.08, -15.98 * s + 0.01 via -3.94 * s + 0.03, -15.71 * s + 0.14; line 22.45 * s + -0.03, -16.19 * s + -0.09; curve 25.70 * s + -0.15, -12.80 * s + -0.15 via 25.71 * s + -0.14, -15.83 * s + 0.08; line 26.12 * s + 0.06, -3.20 * s + -0.10 }
                path { at: cx + jb * sin(fr * 46 + 3631), cy + jb * sin(fr * 71 + 2003); stroke: w2; color: ink; opacity: (o) * 0.85; move -19.91 * s + 0.04, -7.28 * s + -0.14; line -19.77 * s + 0.11, -10.30 * s + 0.10; curve -18.79 * s + -0.14, -11.84 * s + 0.08 via -20.16 * s + -0.08, -11.70 * s + 0.15; line 18.78 * s + 0.14, -12.23 * s + -0.11; curve 20.23 * s + 0.12, -10.54 * s + -0.02 via 19.79 * s + -0.11, -11.80 * s + 0.10; line 19.75 * s + -0.13, -6.92 * s + 0.04 }
                path { at: cx + jb * sin(fr * 41 + 206), cy + jb * sin(fr * 45 + 2149); stroke: w2; color: ink; opacity: (o) * 0.24; show: pn_fill_i == 0; move -16.98 * s + 0.01, -9.18 * s + -0.09; line 17.19 * s + 0.09, -9.03 * s + -0.02 }
