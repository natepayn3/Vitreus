language 0.1
import "../palette.plm"

//  Files: a file manager in the shell's own glass. Places down the left (the ones you know, the drives, the folders you pinned), where you are across the top (back, forward, up, a path you can click or
//  type, tabs under it), the folder as tiles or lines in the middle and a bar under it. Everything is drawn from the palette (so any theme is its own) and the file and folder pictures are pencil
//  drawings, like the shell's icons. The logic (files.luau) does the work with `find`, `cp`, `mv`, `gio` and the like, and says what is chosen, what is going on and what can be undone.
//
//  Keys (when the window has the keyboard): Enter opens, F2 renames, Delete trashes, Ctrl+C / X / V, Ctrl+A, Ctrl+I, Ctrl+Z undoes, Ctrl+Shift+N a new folder, Ctrl+H hidden files, F5 refreshes, Space looks
//  at a file, Ctrl+L types a path, Ctrl+T / Ctrl+W / Ctrl+Tab are the tabs, Ctrl+D pins this folder, Ctrl++ and Ctrl+- zoom, typing a name searches. Backspace or Alt+Up goes up, Alt+Left and Alt+Right back
//  and forward, Alt+Home goes home, the arrows move the choice (with Shift they extend it, with Ctrl they only move), Escape lets go of it. See `files.luau` for the whole list.
//
//  Open it with SUPER + E, or "Files" in the launcher (bin/vitreus-files).

scene Files {
    surface { size: 1100, 720; kind: window; title: "Files"; app_id: "vitreus.files"; keyboard: on_demand }
    //  The glass bends a copy of the wallpaper (as the shell does), not a capture of the screen: a capture needs a moment to start and the window is clear until it does.
    lens = image "~/.cache/pleamar/vitreus/lens.png"

    permissions {
        services: "files", "files.write"
        run: "find", "magick", "ffmpeg", "ffprobe", "identify", "pdftoppm", "stat", "du", "file", "rm", "rmdir", "hyprctl", "xdg-open", "gio", "cp", "mv", "mkdir", "df", "xdg-user-dir", "printenv", "pleamar", "wl-copy", "wl-paste", "fc-match", "vitreus-files", "cat", "head", "chmod", "ln", "touch", "bsdtar", "grep", "sha256sum", "lsblk", "findmnt", "udisksctl", "awww", "which", "readlink", "kitty", "alacritty", "foot", "wezterm", "konsole", "gnome-terminal", "xterm", "date", "sh"
    }

    // ── what the logic says ──
    text dragicon = ""               // the picture that goes under the pointer while a file is dragged out (the logic makes it when a tile is pressed)
    fact view: grid | lines = grid
    fact hidden = false              // hidden files shown
    fact sort: name | size | type | date = name
    fact sortrev = false             // the order turned round
    fact dirfirst = true             // folders before files
    fact zoom = 3                    // how big the tiles are, 1 to 5
    fact tilebase = 128              // the tile's width that goes with it (the logic knows the steps)
    fact tilew = 128                 // the tile's width as drawn (the scene says: a wide window stretches them so that a row never has more than twelve)
    fact total = 0                   // rows of tiles in the folder (or blocks of lines)
    fact itemsn = 0                  // how many things are in it
    fact first = 0                   // the first row of the window the logic is showing
    fact cols = 6                    // tiles across, as the middle is wide
    fact gen = 0                     // goes up with each folder you go into: the list starts at its top
    fact sct = 0                     // where the list is scrolled to (pixels): the wheel, the bar and the logic all say it
    fact can.back = false
    fact can.fwd = false
    fact ready = false
    fact roomw = 700                 // how wide the folder's part is, for the tabs
    fact vh = 400                    // how tall the folder's window is, for scrolling a chosen tile into view
    fact clip.on = false             // something is waiting to be pasted
    fact ask.on = false              // the name dialog (new folder, rename)
    fact ask.gen = 0
    fact ask.input = true            // the dialog asks for a name (else it is a question with Cancel and a button)
    fact ask.danger = false          // and the button is the alert colour
    fact in.trash = false            // the folder shown is the trash
    fact in.list = false             // what is shown is a list made of places (a search, recent files, starred ones), not a folder
    fact menu.on = false             // the right-click menu
    fact menu.x = 0
    fact menu.y = 0
    fact menu.h = 100                // how tall the menu is (the logic adds up its rows and the lines between groups)
    fact prop.on = false             // the properties card
    fact prop.h = 320
    fact pm.on = false               // the card shows the permissions' switches (a single thing that is yours)
    fact pm.bits = 0                 // rwxrwxrwx as a number of nine bits
    fact crumbw = 300                // how much room the path has: the logic keeps the last folders that fit
    fact pen = 0                     // the pointer is on something that boils: the pencil's clock runs only then
    //  Every zone that boils says `leave` before `enter`, and `hover` again a moment after: when the pointer goes straight from one to the next, both fire in one frame and the one declared last stays (so `enter` has to be),
    //  and when it is another zone's `leave` that stays, the `hover` sets it right again in 80 ms. Without them the clock stopped under the pointer and the pencil froze.
    fact obs = false                 // Vitreus has its glass off: flat obsidian (Vitreus says so with `fact obs true`)
    fact gop = 1                     // the shell's glass settings (Vitreus says so, as with obs): opacity, X-Bend on, edge thickness, rainbow fringe, frost, dome, milk, rim
    fact gbend = false
    fact grefr = 1
    fact gdisp = 1
    fact gclear = 1
    fact gdome = 0
    fact gmilk = 0
    fact grim = 1
    fact look = 0                    // the shell's theme (Vitreus says so): 0 Glass, 1 Retro, 2 UwU, 3 Cyber; the plastic ones get an outline and a hard shadow
    text status = ""
    text empty = "This folder is empty"
    text free = ""
    text sortname = "Name"
    text ask.title = ""
    text ask.ok = "OK"
    text ask.msg = ""
    text askin = ""
    text sq = ""                      // what is typed in the search field
    fact searching = false           // the search field is open (it takes the place of the path)
    fact so.where = 0                // the search: 0 this folder, 1 the whole home folder
    fact so.what = 0                 // 0 names, 1 what is written in the files
    fact so.kind = 0                 // 0 anything, 1 folders, 2 pictures, 3 documents, 4 sounds, 5 videos
    text locin = ""                  // what is typed where the path is
    fact loc.edit = false            // the path is being typed
    fact rb.on = false               // a box is being dragged over the folder to choose what is in it
    fact rb.down = false             // the press that may start it was on the folder itself (a press that closed the menu was not: the zone under the menu's catch-all still sees the pointer move)
    fact rb.ax = 0                   // where it began and where it is, in the folder's own measures (the list's width, and down from its top)
    fact rb.ay = 0
    fact rb.bx = 0
    fact rb.by = 0
    fact job.on = false              // something is being copied, moved or put away
    fact job.p = 0                   // how far it has got, 0 to 1 (-1 when it cannot say)
    text job.text = ""
    fact undo.on = false             // the last thing done can be taken back
    text undo.text = ""
    fact cf.on = false               // the question about a name that is taken
    fact cf.all = false              // and the answer is for all the others
    text cf.name = ""
    text cf.msg = ""
    fact pick.on = false             // a list to choose from (open with, a template, what to make an archive of)
    text pick.title = ""
    fact pv.on = false               // the look at a file
    fact pv.kind = 0                 // 0 only what it is, 1 a picture, 2 its words
    text pv.name = ""
    text pv.sub = ""
    text pv.text = ""
    text pv.path = ""
    fact pv.n = 0                    // which of how many (so that the arrows say there is more)
    fact pv.of = 0
    event search_go ->               // Enter in it: look in the folders under this one too
    event loc_go ->                  // Enter in the path being typed

    model crumbs max 8 { at: number; name: text; path: text; x: number; w: number; last: bool }
    model places max 40 { at: number; name: text; path: text; pk: number; here: bool; pinned: bool; kind: number; eject: bool; use: number }
    model tabs max 10 { at: number; name: text; x: number; w: number; active: bool }
    model pinfo max 1 { name: text; sub: text; ik: number; thumb: image 192, 144; has.thumb: bool }
    model prows max 18 { label: text; value: text; tog: bool; on: bool; btn: text; hb: bool; k: number }
    model menuitems max 28 { label: text; k: number; on: bool; ic: number; key: text; danger: bool; sep: bool; chk: bool }
    model picks max 14 { at: number; label: text; sub: text; hs: bool; ic: number }
    model rows max 12 {
        list cells max 10 {
            at: number
            name: text
            ik: number
            carry: text
            thumb: image 192, 144
            has.thumb: bool
            picked: bool
            cur: bool
            hidden: bool
            cut: bool
            link: bool
            broken: bool
            star: bool
            size: text
            date: text
            kind: text
        }
    }

    event slid ->
    event set_cols ->
    event tile ->
    event tile_up ->
    event tile_menu ->
    event tile_mid ->
    event bg_menu ->
    event place ->
    event place_eject ->
    event crumb ->
    event act ->
    event ask_ok ->
    event menu_close ->
    event dropped ->
    event spring ->
    event place_menu ->
    event focused ->
    event band ->
    event band_end ->
    event sort_by ->
    event sopt ->
    event tab_go ->
    event tab_close ->
    event pick_ok ->
    event cf_pick ->
    event job_cancel ->
    event prop_act ->
    event perm ->

    // ── the pencil's clock, and the theme ──
    prop time = 0
    spin time by if(pen > 0.5, 1, 0)
    prop ob = 0 ~calm
    follow ob = if(obs or look == 1 or look == 2, 1, 0)
    prop pl = 0 ~calm
    follow pl = if(look == 1 or look == 2, 1, 0)
    prop uk = 0 ~calm
    follow uk = if(look == 2, 1, 0)
    prop sq = 0 ~calm
    follow sq = if(look == 1 or look == 3, 1, 0)       // Retro and Cyber cut their corners squarer, as the bar's drawers do (`rc` in vitreus.plm)
    let rr = 1 - 0.73 * sq                             // what every corner is multiplied by

    // >>> icons (written by gen_icons.py: edit that, not this)
    //  A file's or a folder's picture in pencil: a folder, a picture, a PDF, a sound, a video, code, an archive or any other file (`ik`, which the logic sets). `s` is its size (1 is 64 px); `hot` (hover) swells it and redraws it about five times a second. The folder takes the accent and the files the ink, so any palette is theirs.
    component PFile(cx: number, cy: number, s: number, ik: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let jb = 0.7 * a * (0.5 + s)
        let w1 = 1.3 + 1.1 * s
        let w2 = 0.9 + 0.6 * s
        let off = 0.35 * (0.5 + s)
        group {
            pivot: cx, cy
            scale: 1 + 0.08 * a
            group {
                show: ik >= 1
                path { at: cx + jb * sin(fr * 53 + 3069), cy + jb * sin(fr * 74 + 762); stroke: w1; color: ink; opacity: (o); move -16.86 * s + 0.07, -26.24 * s + -0.12; line 7.23 * s + 0.12, -26.00 * s + 0.00; line 17.01 * s + 0.01, -16.18 * s + -0.09; line 16.88 * s + -0.06, 26.06 * s + 0.03; line -16.72 * s + 0.14, 26.01 * s + 0.00; line -16.97 * s + 0.02, -27.20 * s + -0.10; line -17.23 * s + -0.11, -20.08 * s + -0.04 }
                path { at: cx + off + jb * sin(fr * 69 + 4348), cy + off + jb * sin(fr * 52 + 3890); stroke: w2; color: ink; opacity: (o) * 0.28; move -16.70 * s + 0.15, -26.25 * s + -0.13; line 6.81 * s + -0.09, -26.15 * s + -0.08; line 17.20 * s + 0.10, -15.70 * s + 0.15; line 16.88 * s + -0.06, 26.30 * s + 0.15; line -16.99 * s + 0.00, 26.25 * s + 0.13; line -16.70 * s + 0.15, -27.29 * s + -0.15; line -16.80 * s + 0.10, -19.71 * s + 0.14 }
                path { at: cx + jb * sin(fr * 43 + 3028), cy + jb * sin(fr * 48 + 1868); stroke: w1; color: ink; opacity: (o); move 7.15 * s + 0.08, -26.29 * s + -0.14; line 6.73 * s + -0.14, -15.80 * s + 0.10; line 16.70 * s + -0.15, -15.95 * s + 0.02 }
                path { at: cx + off + jb * sin(fr * 50 + 3718), cy + off + jb * sin(fr * 51 + 4222); stroke: w2; color: ink; opacity: (o) * 0.28; move 7.28 * s + 0.14, -26.30 * s + -0.15; line 6.72 * s + -0.14, -16.21 * s + -0.10; line 16.76 * s + -0.12, -15.99 * s + 0.01 }
            }
            group {
                show: ik == 0
                path { at: cx + jb * sin(fr * 65 + 3219), cy + jb * sin(fr * 52 + 1564); stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -25.86 * s + 0.07, -11.83 * s + 0.08; line -25.98 * s + 0.01, -21.71 * s + 0.14; line -9.92 * s + 0.04, -21.99 * s + 0.00; line -4.25 * s + -0.12, -14.80 * s + 0.10; line 26.17 * s + 0.08, -14.85 * s + 0.07; line 26.15 * s + 0.07, 21.96 * s + -0.02; line -26.30 * s + -0.15, 21.72 * s + -0.14; line -25.96 * s + 0.02, -13.23 * s + -0.12; line -26.20 * s + -0.10, -8.30 * s + -0.15 }
                path { at: cx + off + jb * sin(fr * 54 + 2135), cy + off + jb * sin(fr * 48 + 809); stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.28; move -25.70 * s + 0.15, -12.29 * s + -0.15; line -25.88 * s + 0.06, -22.21 * s + -0.10; line -9.70 * s + 0.15, -22.29 * s + -0.15; line -4.30 * s + -0.15, -15.13 * s + -0.06; line 26.07 * s + 0.03, -15.28 * s + -0.14; line 26.16 * s + 0.08, 21.83 * s + -0.09; line -25.71 * s + 0.15, 22.26 * s + 0.13; line -26.03 * s + -0.02, -12.90 * s + 0.05; line -26.26 * s + -0.13, -7.98 * s + 0.01 }
                path { at: cx + jb * sin(fr * 56 + 3238), cy + jb * sin(fr * 73 + 4512); stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -25.74 * s + 0.13, -4.95 * s + 0.03; line 26.27 * s + 0.14, -5.23 * s + -0.12 }
                path { at: cx + off + jb * sin(fr * 45 + 4108), cy + off + jb * sin(fr * 52 + 3554); stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.28; move -26.03 * s + -0.01, -4.71 * s + 0.14; line 25.76 * s + -0.12, -5.09 * s + -0.04 }
                path { at: cx + jb * sin(fr * 53 + 3163), cy + jb * sin(fr * 64 + 1841); stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; move -17.06 * s + -0.03, 18.09 * s + 0.04; line -9.00 * s + -0.00, 5.86 * s + -0.07 }
                path { at: cx + jb * sin(fr * 49 + 3880), cy + jb * sin(fr * 51 + 4744); stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; move -7.82 * s + 0.09, 17.85 * s + -0.08; line 0.29 * s + 0.14, 5.99 * s + -0.01 }
                path { at: cx + jb * sin(fr * 61 + 779), cy + jb * sin(fr * 73 + 819); stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; move 1.17 * s + 0.08, 18.12 * s + 0.06; line 8.84 * s + -0.08, 6.11 * s + 0.05 }
                path { at: cx + jb * sin(fr * 70 + 2691), cy + jb * sin(fr * 65 + 449); stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; move 10.27 * s + 0.13, 18.02 * s + 0.01; line 17.83 * s + -0.09, 6.28 * s + 0.14 }
                path { at: cx + jb * sin(fr * 57 + 4670), cy + jb * sin(fr * 40 + 3583); stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; move 19.05 * s + 0.03, 17.81 * s + -0.09; line 26.85 * s + -0.07, 6.11 * s + 0.05 }
            }
            group {
                show: ik == 1
                path { at: cx + jb * sin(fr * 51 + 403), cy + jb * sin(fr * 47 + 290); stroke: w1; color: mint; opacity: (o); move -11.28 * s + -0.14, 16.70 * s + -0.15; line -4.20 * s + -0.10, 4.30 * s + 0.15; line 2.16 * s + 0.08, 10.70 * s + -0.15; line 6.99 * s + -0.00, 4.82 * s + -0.09; line 11.74 * s + -0.13, 16.71 * s + -0.14 }
                path { at: cx + off + jb * sin(fr * 50 + 3980), cy + off + jb * sin(fr * 66 + 764); stroke: w2; color: mint; opacity: (o) * 0.28; move -11.26 * s + -0.13, 16.77 * s + -0.11; line -4.08 * s + -0.04, 4.30 * s + 0.15; line 2.23 * s + 0.11, 10.93 * s + -0.03; line 7.18 * s + 0.09, 4.97 * s + -0.01; line 12.28 * s + 0.14, 16.84 * s + -0.08 }
                ellipse { at: cx + 5.92 * s + -0.04 + jb * sin(fr * 67 + 804), cy + -7.70 * s + 0.15 + jb * sin(fr * 49 + 2637); radius: 3.25 * s; stroke: w1; color: mint; opacity: (o) }
                ellipse { at: cx + 6.11 * s + 0.05 + off + jb * sin(fr * 40 + 3221), cy + -7.94 * s + 0.03 + off + jb * sin(fr * 61 + 1212); radius: 3.2 * s; stroke: w2; color: mint; opacity: (o) * 0.28 }
            }
            group {
                show: ik == 2
                path { at: cx + jb * sin(fr * 47 + 890), cy + jb * sin(fr * 47 + 1276); stroke: w1; color: ink; opacity: (o); move -8.70 * s + 0.15, -9.04 * s + -0.02; line 8.72 * s + -0.14, -8.93 * s + 0.03 }
                path { at: cx + off + jb * sin(fr * 58 + 1526), cy + off + jb * sin(fr * 51 + 3457); stroke: w2; color: ink; opacity: (o) * 0.28; move -8.73 * s + 0.14, -9.27 * s + -0.13; line 9.02 * s + 0.01, -9.20 * s + -0.10 }
                path { at: cx + jb * sin(fr * 49 + 1800), cy + jb * sin(fr * 75 + 2714); stroke: w1; color: ink; opacity: (o); move -9.23 * s + -0.12, -1.86 * s + 0.07; line 8.94 * s + -0.03, -2.25 * s + -0.13 }
                path { at: cx + off + jb * sin(fr * 71 + 2016), cy + off + jb * sin(fr * 56 + 1060); stroke: w2; color: ink; opacity: (o) * 0.28; move -8.70 * s + 0.15, -1.70 * s + 0.15; line 9.21 * s + 0.11, -1.83 * s + 0.09 }
                path { at: cx + jb * sin(fr * 63 + 1623), cy + jb * sin(fr * 44 + 4206); stroke: w1; color: alert; opacity: (o); move -10.91 * s + 0.05, 8.71 * s + -0.14; line 11.29 * s + 0.15, 8.80 * s + -0.10; line 10.90 * s + -0.05, 19.16 * s + 0.08; line -11.18 * s + -0.09, 19.19 * s + 0.09; line -10.79 * s + 0.11, 9.05 * s + 0.02 }
                path { at: cx + off + jb * sin(fr * 58 + 191), cy + off + jb * sin(fr * 43 + 2864); stroke: w2; color: alert; opacity: (o) * 0.28; move -11.26 * s + -0.13, 8.92 * s + -0.04; line 11.28 * s + 0.14, 8.90 * s + -0.05; line 11.10 * s + 0.05, 18.80 * s + -0.10; line -11.02 * s + -0.01, 19.13 * s + 0.07; line -11.15 * s + -0.08, 8.76 * s + -0.12 }
            }
            group {
                show: ik == 3
                path { at: cx + jb * sin(fr * 59 + 1951), cy + jb * sin(fr * 59 + 966); stroke: w1; color: mint; opacity: (o); move 3.78 * s + -0.11, -11.76 * s + 0.12; line 4.12 * s + 0.06, 10.30 * s + 0.15 }
                path { at: cx + off + jb * sin(fr * 60 + 1890), cy + off + jb * sin(fr * 55 + 3242); stroke: w2; color: mint; opacity: (o) * 0.28; move 3.80 * s + -0.10, -11.77 * s + 0.12; line 3.99 * s + -0.00, 10.25 * s + 0.12 }
                path { at: cx + jb * sin(fr * 58 + 3689), cy + jb * sin(fr * 45 + 3686); stroke: w1; color: mint; opacity: (o); move 3.71 * s + -0.15, -12.02 * s + -0.01; line 10.85 * s + -0.08, -8.13 * s + -0.06; line 11.25 * s + 0.13, -4.17 * s + -0.09 }
                path { at: cx + off + jb * sin(fr * 66 + 2198), cy + off + jb * sin(fr * 44 + 4221); stroke: w2; color: mint; opacity: (o) * 0.28; move 3.71 * s + -0.15, -12.01 * s + -0.00; line 10.78 * s + -0.11, -7.78 * s + 0.11; line 10.91 * s + -0.04, -3.73 * s + 0.13 }
                ellipse { at: cx + -1.30 * s + -0.15 + jb * sin(fr * 58 + 2726), cy + 12.30 * s + 0.15 + jb * sin(fr * 70 + 4468); radius: 4.38 * s; stroke: w1; color: mint; opacity: (o) }
                ellipse { at: cx + -1.27 * s + -0.14 + off + jb * sin(fr * 48 + 2203), cy + 12.11 * s + 0.06 + off + jb * sin(fr * 67 + 2482); radius: 4.2 * s; stroke: w2; color: mint; opacity: (o) * 0.28 }
            }
            group {
                show: ik == 4
                path { at: cx + jb * sin(fr * 66 + 1994), cy + jb * sin(fr * 66 + 2930); stroke: w1; color: mint; opacity: (o); move -5.76 * s + 0.12, -7.74 * s + 0.13; line 8.80 * s + -0.10, 1.70 * s + -0.15; line -5.72 * s + 0.14, 11.71 * s + -0.14; line -5.71 * s + 0.14, -8.26 * s + -0.13 }
                path { at: cx + off + jb * sin(fr * 65 + 129), cy + off + jb * sin(fr * 47 + 4209); stroke: w2; color: mint; opacity: (o) * 0.28; move -6.10 * s + -0.05, -8.02 * s + -0.01; line 8.71 * s + -0.14, 2.04 * s + 0.02; line -6.15 * s + -0.07, 12.28 * s + 0.14; line -5.97 * s + 0.01, -7.95 * s + 0.03 }
            }
            group {
                show: ik == 5
                path { at: cx + jb * sin(fr * 41 + 961), cy + jb * sin(fr * 59 + 719); stroke: w1; color: mint; opacity: (o); move -3.70 * s + 0.15, -8.21 * s + -0.11; line -10.70 * s + 0.15, 0.77 * s + -0.12; line -4.04 * s + -0.02, 10.25 * s + 0.13 }
                path { at: cx + off + jb * sin(fr * 42 + 577), cy + off + jb * sin(fr * 66 + 2555); stroke: w2; color: mint; opacity: (o) * 0.28; move -3.72 * s + 0.14, -7.87 * s + 0.06; line -11.27 * s + -0.14, 1.30 * s + 0.15; line -4.25 * s + -0.12, 10.26 * s + 0.13 }
                path { at: cx + jb * sin(fr * 63 + 4664), cy + jb * sin(fr * 76 + 2518); stroke: w1; color: mint; opacity: (o); move 4.10 * s + 0.05, -8.09 * s + -0.04; line 11.17 * s + 0.09, 1.30 * s + 0.15; line 3.72 * s + -0.14, 10.11 * s + 0.05 }
