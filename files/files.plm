                path { at: cx, cy; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; move 0.71 * s + -0.15, 17.87 * s + -0.07; line 8.84 * s + -0.08, 6.05 * s + 0.02 }
