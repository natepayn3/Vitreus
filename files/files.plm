                path { at: cx, cy; stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -15.30 * s + -0.15, -3.79 * s + 0.10; line -14.97 * s + 0.02, 20.72 * s + -0.14; line 14.80 * s + -0.10, 21.20 * s + 0.10; line 14.79 * s + -0.10, -4.30 * s + -0.15 }
