                path { at: cx + off, cy + off; stroke: w2; color: mint; opacity: (o) * 0.28; move -0.24 * s + -0.12, -21.23 * s + -0.12; line 9.86 * s + -0.07, -7.83 * s + 0.09; line 9.83 * s + -0.08, 7.70 * s + -0.15; line 0.23 * s + 0.12, 20.79 * s + -0.10 }
            }
            group {
                show: pk == 14
                path { at: cx, cy; stroke: w1; color: ink; opacity: (o); move -22.13 * s + -0.07, -6.21 * s + -0.10; line 21.71 * s + -0.15, -6.18 * s + -0.09; line 22.28 * s + 0.14, 12.17 * s + 0.08; line -22.11 * s + -0.06, 12.30 * s + 0.15; line -21.72 * s + 0.14, -7.30 * s + -0.15 }
                path { at: cx + off, cy + off; stroke: w2; color: ink; opacity: (o) * 0.28; move -21.77 * s + 0.12, -5.82 * s + 0.09; line 21.74 * s + -0.13, -6.11 * s + -0.06; line 21.70 * s + -0.15, 12.26 * s + 0.13; line -21.70 * s + 0.15, 12.30 * s + 0.15; line -21.79 * s + 0.10, -6.72 * s + 0.14 }
                path { at: cx, cy; stroke: w1; color: mint; opacity: (o); move -13.75 * s + 0.13, 0.05 * s + 0.03; line -6.01 * s + -0.00, -0.27 * s + -0.14 }
                path { at: cx + off, cy + off; stroke: w2; color: mint; opacity: (o) * 0.28; move -13.94 * s + 0.03, -0.13 * s + -0.06; line -6.00 * s + -0.00, -0.20 * s + -0.10 }
                ellipse { at: cx + 14.20 * s + 0.10, cy + 3.25 * s + 0.13; radius: 2.22 * s; stroke: w1; color: mint; opacity: (o) }
                ellipse { at: cx + 14.21 * s + 0.11 + off, cy + 2.71 * s + -0.15 + off; radius: 2.2 * s; stroke: w2; color: mint; opacity: (o) * 0.28 }
                path { at: cx, cy; stroke: w1; color: ink; opacity: (o); move -21.97 * s + 0.01, -6.21 * s + -0.11; line -14.00 * s + -0.00, -18.27 * s + -0.14; line 13.74 * s + -0.13, -17.71 * s + 0.14; line 22.27 * s + 0.13, -6.09 * s + -0.04 }
                path { at: cx + off, cy + off; stroke: w2; color: ink; opacity: (o) * 0.28; move -21.72 * s + 0.14, -5.84 * s + 0.08; line -14.28 * s + -0.14, -17.90 * s + 0.05; line 13.71 * s + -0.15, -17.75 * s + 0.13; line 22.01 * s + 0.01, -5.96 * s + 0.02 }
            }
            group {
                show: pk == 15
                ellipse { at: cx + 0.30 * s + 0.15, cy + -0.27 * s + -0.13; radius: 20.03 * s; stroke: w1; color: ink; opacity: (o) }
                ellipse { at: cx + -0.27 * s + -0.14 + off, cy + 0.20 * s + 0.10 + off; radius: 21 * s; stroke: w2; color: ink; opacity: (o) * 0.28 }
                path { at: cx, cy; stroke: w1; color: mint; opacity: (o); move -9.27 * s + -0.13, -0.14 * s + -0.07; line 9.11 * s + 0.06, -0.26 * s + -0.13 }
                path { at: cx + off, cy + off; stroke: w2; color: mint; opacity: (o) * 0.28; move -9.06 * s + -0.03, 0.29 * s + 0.14; line 9.11 * s + 0.05, 0.02 * s + 0.01 }
                path { at: cx, cy; stroke: w1; color: mint; opacity: (o); move 0.28 * s + 0.14, -9.02 * s + -0.01; line -0.22 * s + -0.11, 8.96 * s + -0.02 }
                path { at: cx + off, cy + off; stroke: w2; color: mint; opacity: (o) * 0.28; move 0.30 * s + 0.15, -9.30 * s + -0.15; line 0.29 * s + 0.15, 8.80 * s + -0.10 }
            }
            group {
                show: pk == 16
                ellipse { at: cx + -0.26 * s + -0.13, cy + -0.13 * s + -0.06; radius: 19.95 * s; stroke: w1; color: ink; opacity: (o) }
                ellipse { at: cx + 0.30 * s + 0.15 + off, cy + 0.30 * s + 0.15 + off; radius: 21 * s; stroke: w2; color: ink; opacity: (o) * 0.28 }
