    //  `PGlyphS` for a pick list's picture (apps, archive types): only the kinds those lists use.
    component PGlyphSP(cx: number, cy: number, s: number, g: number, o: number) {
        let a = 0
        let w1 = 1.3 + 1.1 * s
        let w2 = 0.9 + 0.6 * s
        let off = 0.35 * (0.5 + s)
        group {
            pivot: cx, cy
            group {
                show: g == 8
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -3.83 * s + 0.08, -8.70 * s + 0.15; line -9.24 * s + -0.12, -9.02 * s + -0.01; line -9.05 * s + -0.03, 9.30 * s + 0.15; line 8.90 * s + -0.05, 8.88 * s + -0.06; line 8.70 * s + -0.15, 4.30 * s + 0.15 }
