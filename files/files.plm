    //  `PGlyphS` for a menu line's picture, which is chosen while it runs: only the kinds the menus use.
    component PGlyphSM(cx: number, cy: number, s: number, g: number, o: number) {
        let a = 0
        let w1 = 1.3 + 1.1 * s
        let w2 = 0.9 + 0.6 * s
        let off = 0.35 * (0.5 + s)
        group {
            pivot: cx, cy
