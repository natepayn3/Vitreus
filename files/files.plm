            }
        }
    }

    //  A toolbar or menu picture (`g`): back, forward, up, tiles, lines, hidden files, new folder, close, then the menu's own. `hot` swells it, turns it to the accent and redraws it, like the shell's own.
    component PGlyph(cx: number, cy: number, s: number, g: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let jb = 0.7 * a * (0.5 + s)
        let w1 = 1.3 + 1.1 * s
        let w2 = 0.9 + 0.6 * s
        let off = 0.35 * (0.5 + s)
        group {
            pivot: cx, cy
            scale: 1 + 0.08 * a
            group {
                show: g == 0
                path { at: cx + jb * sin(fr * 51 + 2201), cy + jb * sin(fr * 50 + 4325); stroke: w1; color: mix(ink, mint, a); opacity: (o); move 5.70 * s + -0.15, -9.16 * s + -0.08; line -4.79 * s + 0.11, -0.22 * s + -0.11; line 5.77 * s + -0.11, 8.85 * s + -0.07 }
                path { at: cx + off + jb * sin(fr * 72 + 4550), cy + off + jb * sin(fr * 44 + 2022); stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move 6.02 * s + 0.01, -9.03 * s + -0.02; line -4.95 * s + 0.03, -0.03 * s + -0.02; line 5.73 * s + -0.14, 9.30 * s + 0.15 }
            }
            group {
                show: g == 1
                path { at: cx + jb * sin(fr * 55 + 4396), cy + jb * sin(fr * 54 + 3548); stroke: w1; color: mix(ink, mint, a); opacity: (o); move -5.79 * s + 0.11, -9.29 * s + -0.15; line 5.10 * s + 0.05, 0.03 * s + 0.01; line -5.76 * s + 0.12, 8.74 * s + -0.13 }
                path { at: cx + off + jb * sin(fr * 65 + 4395), cy + off + jb * sin(fr * 75 + 693); stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -5.79 * s + 0.10, -9.04 * s + -0.02; line 4.72 * s + -0.14, 0.27 * s + 0.13; line -6.04 * s + -0.02, 9.24 * s + 0.12 }
            }
            group {
                show: g == 2
                path { at: cx + jb * sin(fr * 55 + 2152), cy + jb * sin(fr * 60 + 4725); stroke: w1; color: mix(ink, mint, a); opacity: (o); move -8.70 * s + 0.15, 5.11 * s + 0.06; line 0.20 * s + 0.10, -5.77 * s + 0.11; line 8.79 * s + -0.11, 5.26 * s + 0.13 }
