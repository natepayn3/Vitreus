    //  A place's picture in pencil for the sidebar (`pk`): a folder, home, the trash, this computer, downloads, documents, pictures, music, videos, a drive. Still, and a little crooked.
    component PPlace(cx: number, cy: number, s: number, pk: number, o: number) {
        let a = 0
        let w1 = 1.3 + 1.1 * s
        let w2 = 0.9 + 0.6 * s
        let off = 0.35 * (0.5 + s)
        group {
            pivot: cx, cy
            group {
                show: pk == 0
                path { at: cx, cy; stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -26.07 * s + -0.03, -12.29 * s + -0.15; line -25.81 * s + 0.09, -22.13 * s + -0.06; line -9.90 * s + 0.05, -22.25 * s + -0.12; line -4.30 * s + -0.15, -14.75 * s + 0.13; line 25.70 * s + -0.15, -14.78 * s + 0.11; line 25.89 * s + -0.06, 22.06 * s + 0.03; line -26.25 * s + -0.12, 22.00 * s + 0.00; line -25.79 * s + 0.11, -12.71 * s + 0.14; line -26.02 * s + -0.01, -7.75 * s + 0.13 }
                path { at: cx + off, cy + off; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.28; move -25.71 * s + 0.15, -12.09 * s + -0.04; line -26.11 * s + -0.05, -22.28 * s + -0.14; line -9.92 * s + 0.04, -21.76 * s + 0.12; line -3.80 * s + 0.10, -15.17 * s + -0.08; line 25.75 * s + -0.12, -15.20 * s + -0.10; line 25.76 * s + -0.12, 21.76 * s + -0.12; line -25.85 * s + 0.08, 22.30 * s + 0.15; line -25.85 * s + 0.08, -12.70 * s + 0.15; line -26.19 * s + -0.09, -7.76 * s + 0.12 }
                path { at: cx, cy; stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -26.05 * s + -0.03, -4.84 * s + 0.08; line 26.27 * s + 0.13, -5.29 * s + -0.15 }
                path { at: cx + off, cy + off; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.28; move -26.30 * s + -0.15, -5.24 * s + -0.12; line 26.27 * s + 0.13, -5.22 * s + -0.11 }
                path { at: cx, cy; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; show: pn_fill_i == 0; move -17.21 * s + -0.11, 17.78 * s + -0.11; line -9.30 * s + -0.15, 5.92 * s + -0.04 }
                path { at: cx, cy; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; show: pn_fill_i == 0; move -8.21 * s + -0.11, 17.76 * s + -0.12; line 0.28 * s + 0.14, 6.27 * s + 0.14 }
                path { at: cx, cy; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; show: pn_fill_i == 0; move 0.71 * s + -0.15, 17.87 * s + -0.07; line 8.84 * s + -0.08, 6.05 * s + 0.02 }
                path { at: cx, cy; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; show: pn_fill_i == 0; move 9.80 * s + -0.10, 17.76 * s + -0.12; line 17.81 * s + -0.09, 5.78 * s + -0.11 }
                path { at: cx, cy; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; show: pn_fill_i == 0; move 19.29 * s + 0.15, 17.89 * s + -0.05; line 27.12 * s + 0.06, 5.71 * s + -0.15 }
                shader fillstyle { at: cx + -17.21 * s, cy + -0.38 * s; size: 44.33 * s, 24.36 * s; values: 0, 44.33 * s, 12.18 * s, 3.04 * s, pn_fill_i, 0, 0, 1; colors: mix(mint, ink, 0.25); opacity: (o) * 0.45 * pn_hatch; show: pn_fill_i > 0 }      // (Settings > Style > Fill that is not Pencil: the fill in place of the hatching)
            }
            group {
                show: pk == 1
                path { at: cx, cy; stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -21.70 * s + 0.15, 0.09 * s + 0.04; line 0.17 * s + 0.09, -21.21 * s + -0.11; line 21.85 * s + -0.07, -0.19 * s + -0.09 }
                path { at: cx + off, cy + off; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.28; move -21.71 * s + 0.15, 0.11 * s + 0.05; line -0.18 * s + -0.09, -20.87 * s + 0.06; line 22.30 * s + 0.15, 0.23 * s + 0.11 }
                path { at: cx, cy; stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -15.30 * s + -0.15, -3.79 * s + 0.10; line -14.97 * s + 0.02, 20.72 * s + -0.14; line 14.80 * s + -0.10, 21.20 * s + 0.10; line 14.79 * s + -0.10, -4.30 * s + -0.15 }
                path { at: cx + off, cy + off; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.28; move -14.86 * s + 0.07, -4.30 * s + -0.15; line -15.30 * s + -0.15, 20.71 * s + -0.15; line 14.81 * s + -0.09, 21.30 * s + 0.15; line 14.90 * s + -0.05, -3.71 * s + 0.15 }
                path { at: cx, cy; stroke: w1; color: mint; opacity: (o); move -4.29 * s + -0.15, 20.79 * s + -0.11; line -3.82 * s + 0.09, 8.71 * s + -0.15; line 4.19 * s + 0.09, 9.29 * s + 0.15; line 3.70 * s + -0.15, 20.72 * s + -0.14 }
                path { at: cx + off, cy + off; stroke: w2; color: mint; opacity: (o) * 0.28; move -3.71 * s + 0.15, 20.70 * s + -0.15; line -3.84 * s + 0.08, 9.29 * s + 0.15; line 4.04 * s + 0.02, 9.30 * s + 0.15; line 4.21 * s + 0.10, 20.81 * s + -0.10 }
            }
            group {
                show: pk == 2
                path { at: cx, cy; stroke: w1; color: ink; opacity: (o); move -15.30 * s + -0.15, -13.95 * s + 0.02; line 14.82 * s + -0.09, -13.78 * s + 0.11 }
                path { at: cx + off, cy + off; stroke: w2; color: ink; opacity: (o) * 0.28; move -15.28 * s + -0.14, -13.92 * s + 0.04; line 14.96 * s + -0.02, -13.71 * s + 0.15 }
                path { at: cx, cy; stroke: w1; color: ink; opacity: (o); move -5.15 * s + -0.08, -14.12 * s + -0.06; line -4.89 * s + 0.05, -21.25 * s + -0.13; line 4.88 * s + -0.06, -21.05 * s + -0.03; line 4.93 * s + -0.04, -14.13 * s + -0.06 }
