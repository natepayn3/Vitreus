                path { at: cx, cy; stroke: w1; color: ink; opacity: (o); move -25.25 * s + -0.13, -18.86 * s + 0.07; line 25.11 * s + 0.06, -18.70 * s + 0.15; line 25.08 * s + 0.04, 10.30 * s + 0.15; line -24.73 * s + 0.13, 9.74 * s + -0.13; line -24.84 * s + 0.08, -19.84 * s + 0.08 }
                path { at: cx + off, cy + off; stroke: w2; color: ink; opacity: (o) * 0.28; move -24.71 * s + 0.15, -19.09 * s + -0.04; line 25.02 * s + 0.01, -19.29 * s + -0.14; line 25.22 * s + 0.11, 10.21 * s + 0.10; line -24.92 * s + 0.04, 10.17 * s + 0.08; line -24.70 * s + 0.15, -19.71 * s + 0.14 }
