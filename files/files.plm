                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -6.20 * s + -0.10, -5.81 * s + 0.09; line 5.75 * s + -0.13, 5.83 * s + -0.08 }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -6.19 * s + -0.09, -6.01 * s + -0.01; line 5.75 * s + -0.13, 5.73 * s + -0.14 }
