    //  A place's picture in pencil for the sidebar (`pk`): a folder, home, the trash, this computer, downloads, documents, pictures, music, videos, a drive. Still, and a little crooked.
    component PPlace(cx: number, cy: number, s: number, pk: number, o: number) {
        let a = 0
        let w1 = 1.3 + 1.1 * s
        let w2 = 0.9 + 0.6 * s
        let off = 0.35 * (0.5 + s)
        group {
            pivot: cx, cy
            group {
                show: pk == 0
                path { at: cx, cy; stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -26.07 * s + -0.03, -12.29 * s + -0.15; line -25.81 * s + 0.09, -22.13 * s + -0.06; line -9.90 * s + 0.05, -22.25 * s + -0.12; line -4.30 * s + -0.15, -14.75 * s + 0.13; line 25.70 * s + -0.15, -14.78 * s + 0.11; line 25.89 * s + -0.06, 22.06 * s + 0.03; line -26.25 * s + -0.12, 22.00 * s + 0.00; line -25.79 * s + 0.11, -12.71 * s + 0.14; line -26.02 * s + -0.01, -7.75 * s + 0.13 }
                path { at: cx + off, cy + off; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.28; move -25.71 * s + 0.15, -12.09 * s + -0.04; line -26.11 * s + -0.05, -22.28 * s + -0.14; line -9.92 * s + 0.04, -21.76 * s + 0.12; line -3.80 * s + 0.10, -15.17 * s + -0.08; line 25.75 * s + -0.12, -15.20 * s + -0.10; line 25.76 * s + -0.12, 21.76 * s + -0.12; line -25.85 * s + 0.08, 22.30 * s + 0.15; line -25.85 * s + 0.08, -12.70 * s + 0.15; line -26.19 * s + -0.09, -7.76 * s + 0.12 }
                path { at: cx, cy; stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -26.05 * s + -0.03, -4.84 * s + 0.08; line 26.27 * s + 0.13, -5.29 * s + -0.15 }
                path { at: cx + off, cy + off; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.28; move -26.30 * s + -0.15, -5.24 * s + -0.12; line 26.27 * s + 0.13, -5.22 * s + -0.11 }
                path { at: cx, cy; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; move -17.21 * s + -0.11, 17.78 * s + -0.11; line -9.30 * s + -0.15, 5.92 * s + -0.04 }
