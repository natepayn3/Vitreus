            }
            group {
                show: g == 3
                path { at: cx + jb * sin(fr * 41 + 413), cy + jb * sin(fr * 67 + 609); stroke: w1; color: mix(ink, mint, a); opacity: (o); move -10.29 * s + -0.14, -9.70 * s + 0.15; line -2.02 * s + -0.01, -10.30 * s + -0.15; line -2.12 * s + -0.06, -1.91 * s + 0.05; line -10.29 * s + -0.14, -1.70 * s + 0.15; line -9.73 * s + 0.14, -10.80 * s + 0.10 }
                path { at: cx + off + jb * sin(fr * 60 + 1653), cy + off + jb * sin(fr * 43 + 2499); stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -10.21 * s + -0.10, -10.30 * s + -0.15; line -1.81 * s + 0.09, -9.70 * s + 0.15; line -2.13 * s + -0.07, -1.70 * s + 0.15; line -9.82 * s + 0.09, -1.72 * s + 0.14; line -10.23 * s + -0.11, -11.26 * s + -0.13 }
                path { at: cx + jb * sin(fr * 51 + 2297), cy + jb * sin(fr * 56 + 183); stroke: w1; color: mix(ink, mint, a); opacity: (o); move 2.30 * s + 0.15, -9.94 * s + 0.03; line 10.26 * s + 0.13, -10.30 * s + -0.15; line 10.26 * s + 0.13, -2.25 * s + -0.12; line 1.70 * s + -0.15, -2.12 * s + -0.06; line 1.90 * s + -0.05, -10.78 * s + 0.11 }
                path { at: cx + off + jb * sin(fr * 76 + 4444), cy + off + jb * sin(fr * 58 + 1707); stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move 2.28 * s + 0.14, -10.26 * s + -0.13; line 10.25 * s + 0.12, -9.93 * s + 0.03; line 10.26 * s + 0.13, -1.71 * s + 0.15; line 2.29 * s + 0.14, -2.09 * s + -0.05; line 1.85 * s + -0.08, -11.14 * s + -0.07 }
