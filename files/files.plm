                path { at: cx + off + jb * sin(fr * 41 + 3007), cy + off + jb * sin(fr * 54 + 1256); stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move 1.96 * s + -0.02, 2.15 * s + 0.07; line 10.13 * s + 0.06, 2.20 * s + 0.10; line 10.09 * s + 0.05, 10.29 * s + 0.15; line 1.76 * s + -0.12, 9.78 * s + -0.11; line 1.84 * s + -0.08, 0.83 * s + -0.08 }
