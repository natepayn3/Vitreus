                path { at: cx + jb * sin(fr * 44 + 2154), cy + jb * sin(fr * 70 + 3304); stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -25.91 * s + 0.05, -5.18 * s + -0.09; line 25.71 * s + -0.15, -5.30 * s + -0.15 }
