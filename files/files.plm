                path { at: cx + off + jb * sin(fr * 51 + 1835), cy + off + jb * sin(fr * 54 + 2914); stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -3.00 * s + 0.00, 0.27 * s + 0.14; line 10.08 * s + 0.04, -0.00 * s + -0.00 }
                path { at: cx + jb * sin(fr * 56 + 677), cy + jb * sin(fr * 40 + 3655); stroke: w1; color: mix(ink, mint, a); opacity: (o); move -3.26 * s + -0.13, 6.75 * s + -0.13; line 10.03 * s + 0.02, 6.73 * s + -0.14 }
                path { at: cx + off + jb * sin(fr * 47 + 3670), cy + off + jb * sin(fr * 45 + 3129); stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -2.81 * s + 0.09, 6.76 * s + -0.12; line 10.29 * s + 0.15, 7.29 * s + 0.15 }
                ellipse { at: cx + -8.70 * s + 0.15 + jb * sin(fr * 71 + 3571), cy + -7.10 * s + -0.05 + jb * sin(fr * 75 + 3178); radius: 1.32 * s; stroke: w1; color: mix(ink, mint, a); opacity: (o) }
                ellipse { at: cx + -9.19 * s + -0.09 + off + jb * sin(fr * 75 + 2253), cy + -6.74 * s + 0.13 + off + jb * sin(fr * 60 + 2925); radius: 1.3 * s; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28 }
