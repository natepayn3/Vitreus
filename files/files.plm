    //  `PFile` for a folder alone (the sidebar's pinned-folder marker).
    component PFile0(cx: number, cy: number, s: number, ik: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let jb = 0.7 * a * (0.5 + s)
        let w1 = 1.3 + 1.1 * s
        let w2 = 0.9 + 0.6 * s
        let off = 0.35 * (0.5 + s)
        group {
            pivot: cx, cy
            scale: 1 + 0.08 * a
            group {
                show: ik == 0
                path { at: cx + jb * sin(fr * 57 + 4412), cy + jb * sin(fr * 59 + 2149); stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -25.87 * s + 0.06, -11.88 * s + 0.06; line -26.14 * s + -0.07, -22.30 * s + -0.15; line -10.15 * s + -0.08, -22.14 * s + -0.07; line -4.28 * s + -0.14, -14.75 * s + 0.13; line 25.76 * s + -0.12, -14.86 * s + 0.07; line 25.71 * s + -0.14, 21.96 * s + -0.02; line -26.30 * s + -0.15, 21.82 * s + -0.09; line -26.21 * s + -0.11, -13.10 * s + -0.05; line -25.71 * s + 0.14, -7.91 * s + 0.04 }
