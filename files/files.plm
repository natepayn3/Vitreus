                path { at: cx + off + jb * sin(fr * 57 + 3817), cy + off + jb * sin(fr * 71 + 2872); stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -10.76 * s + 0.12, -4.80 * s + 0.10; line -10.95 * s + 0.02, -9.00 * s + -0.00; line -3.77 * s + 0.12, -9.30 * s + -0.15; line -0.83 * s + 0.09, -6.30 * s + -0.15; line 10.83 * s + -0.08, -6.23 * s + -0.11; line 11.24 * s + 0.12, 8.28 * s + 0.14; line -11.07 * s + -0.03, 7.86 * s + -0.07; line -11.08 * s + -0.04, -4.03 * s + -0.01 }
