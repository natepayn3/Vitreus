            let wn9.nd = (-(ws.st.1 * (5 + 8 * (max(1, ws.cnt.9) - 1)) + ws.st.2 * (16 * max(1, ws.ico.9) - 3) + ws.nl) * wk / 2 + 5.5 * wk) * (ws.st.1 + ws.st.2)      // the number and the pips or icons after it, centred as one
            let wn9.o1 = ws.vis.9 * wso * ws.st.3 * min(100%, mix(45% + 40% * ws.tall.9 + 30% * wsh.9.$screen, 100%, wn9.act))
            let wn9.o2 = ws.vis.9 * wso * ws.nums * min(100%, mix(55% + 30% * ws.tall.9 + 25% * wsh.9.$screen, 100%, wn9.act))
            text "9" { at: 0, 0; anchor: left center; size: 11.5; weight: 700; lines: 1; measure: wsnw.9.0; opacity: 0; family: "Space Grotesk" }
            text "IX" { at: 0, 0; anchor: left center; size: 11.5; weight: 700; lines: 1; measure: wsnw.9.1; opacity: 0; family: "Space Grotesk" }
            text "九" { at: 0, 0; anchor: left center; size: 14; lines: 1; measure: wsnw.9.2; opacity: 0; family: "Zen Kurenaido" }
            group {
                scale: wk * (1 + 0.22 * wsp.9.$screen * (1 - 0.75 * wn9.act))
                pivot: wn9.cx, wn9.cy
                text "9" { at: wn9.cx, wn9.cy - 0.5 * ws.st.3; anchor: center; align: center; size: 11.5; weight: 700; color: mix(mix(ink, warm, wn9.wg), wsacc, wn9.act); opacity: wn9.o1 * (1 - ws.nr1 - ws.nr2); family: "Space Grotesk" }
                text "IX" { at: wn9.cx, wn9.cy - 0.5 * ws.st.3; anchor: center; align: center; size: 11.5; weight: 700; color: mix(mix(ink, warm, wn9.wg), wsacc, wn9.act); opacity: wn9.o1 * ws.nr1; family: "Space Grotesk" }
                text "九" { at: wn9.cx, wn9.cy - 0.5 * ws.st.3; anchor: center; align: center; size: 14; color: mix(mix(ink, warm, wn9.wg), wsacc, wn9.act); opacity: wn9.o1 * ws.nr2; family: "Zen Kurenaido" }
            }
            group {
                scale: wk * (1 + 0.22 * wsp.9.$screen * (1 - 0.75 * wn9.act))
                pivot: mix(wn9.a + wn9.nd, lf.x, lm), mix(bar.y, wn9.a + wn9.nd, lm)
                text "9" { at: mix(wn9.a + wn9.nd, lf.x, lm), mix(bar.y, wn9.a + wn9.nd, lm); anchor: center; align: center; size: 9; weight: 700; color: mix(mix(ink, warm, wn9.wg), mix(wsacc.on, ink, ws.st.2), wn9.act); opacity: wn9.o2 * (1 - ws.nr1 - ws.nr2); family: "Space Grotesk" }
                text "IX" { at: mix(wn9.a + wn9.nd, lf.x, lm), mix(bar.y, wn9.a + wn9.nd, lm); anchor: center; align: center; size: 9; weight: 700; color: mix(mix(ink, warm, wn9.wg), mix(wsacc.on, ink, ws.st.2), wn9.act); opacity: wn9.o2 * ws.nr1; family: "Space Grotesk" }
                text "九" { at: mix(wn9.a + wn9.nd, lf.x, lm), mix(bar.y, wn9.a + wn9.nd, lm); anchor: center; align: center; size: 11; color: mix(mix(ink, warm, wn9.wg), mix(wsacc.on, ink, ws.st.2), wn9.act); opacity: wn9.o2 * ws.nr2; family: "Zen Kurenaido" }
            }
        }
        group {
            let wn10.a = ws.a.10
            let wn10.act = ws.act.10
            let wn10.wg = ws.urg.10 * (1 - wn10.act) * (1 - 0.6 * ws.br)
            let wn10.cx = mix(wn10.a, lf.x, lm)
            let wn10.cy = mix(bar.y, wn10.a, lm)
            let wn10.nd = (-(ws.st.1 * (5 + 8 * (max(1, ws.cnt.10) - 1)) + ws.st.2 * (16 * max(1, ws.ico.10) - 3) + ws.nl) * wk / 2 + 5.5 * wk) * (ws.st.1 + ws.st.2)      // the number and the pips or icons after it, centred as one
            let wn10.o1 = ws.vis.10 * wso * ws.st.3 * min(100%, mix(45% + 40% * ws.tall.10 + 30% * wsh.10.$screen, 100%, wn10.act))
            let wn10.o2 = ws.vis.10 * wso * ws.nums * min(100%, mix(55% + 30% * ws.tall.10 + 25% * wsh.10.$screen, 100%, wn10.act))
            text "十" { at: 0, 0; anchor: left center; size: 14; lines: 1; measure: wsnw.10.0; opacity: 0; family: "Zen Kurenaido" }
            text "X" { at: 0, 0; anchor: left center; size: 11.5; weight: 700; lines: 1; measure: wsnw.10.1; opacity: 0; family: "Space Grotesk" }
            text "十" { at: 0, 0; anchor: left center; size: 14; lines: 1; measure: wsnw.10.2; opacity: 0; family: "Zen Kurenaido" }
            group {
                scale: wk * (1 + 0.22 * wsp.10.$screen * (1 - 0.75 * wn10.act))
                pivot: wn10.cx, wn10.cy
                text "十" { at: wn10.cx, wn10.cy - 0.5 * ws.st.3; anchor: center; align: center; size: 14; color: mix(mix(ink, warm, wn10.wg), wsacc, wn10.act); opacity: wn10.o1 * (1 - ws.nr1 - ws.nr2); family: "Zen Kurenaido" }
                text "X" { at: wn10.cx, wn10.cy - 0.5 * ws.st.3; anchor: center; align: center; size: 11.5; weight: 700; color: mix(mix(ink, warm, wn10.wg), wsacc, wn10.act); opacity: wn10.o1 * ws.nr1; family: "Space Grotesk" }
                text "十" { at: wn10.cx, wn10.cy - 0.5 * ws.st.3; anchor: center; align: center; size: 14; color: mix(mix(ink, warm, wn10.wg), wsacc, wn10.act); opacity: wn10.o1 * ws.nr2; family: "Zen Kurenaido" }
            }
            group {
                scale: wk * (1 + 0.22 * wsp.10.$screen * (1 - 0.75 * wn10.act))
                pivot: mix(wn10.a + wn10.nd, lf.x, lm), mix(bar.y, wn10.a + wn10.nd, lm)
                text "十" { at: mix(wn10.a + wn10.nd, lf.x, lm), mix(bar.y, wn10.a + wn10.nd, lm); anchor: center; align: center; size: 11; color: mix(mix(ink, warm, wn10.wg), mix(wsacc.on, ink, ws.st.2), wn10.act); opacity: wn10.o2 * (1 - ws.nr1 - ws.nr2); family: "Zen Kurenaido" }
                text "X" { at: mix(wn10.a + wn10.nd, lf.x, lm), mix(bar.y, wn10.a + wn10.nd, lm); anchor: center; align: center; size: 9; weight: 700; color: mix(mix(ink, warm, wn10.wg), mix(wsacc.on, ink, ws.st.2), wn10.act); opacity: wn10.o2 * ws.nr1; family: "Space Grotesk" }
                text "十" { at: mix(wn10.a + wn10.nd, lf.x, lm), mix(bar.y, wn10.a + wn10.nd, lm); anchor: center; align: center; size: 11; color: mix(mix(ink, warm, wn10.wg), mix(wsacc.on, ink, ws.st.2), wn10.act); opacity: wn10.o2 * ws.nr2; family: "Zen Kurenaido" }
            }
        }
    }
}
