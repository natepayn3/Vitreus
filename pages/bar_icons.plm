part BarIcons {
    //  The bar's icons are drawn here, on top of the bar and outside its wave-shader group, with a soft dark
    //  halo (a group `glow` in the palette's dark colour) so they hold up on a light wallpaper, as the text
    //  does. An effect cannot sit inside another effect's group, hence outside. The click areas and rules
    //  stay in the bar group above.
    group {
        glow: 2.4 * bu, 110%, deep
        row tray_bar_row {
            at: floor(tr.x - ((if(bs.tray > 0.02, bartrays.count, 0) + if(rec_on, 1, 0) + if(priv_mic, 1, 0) + if(priv_cam, 1, 0) + if(priv_scr and not rec_on, 1, 0) + if(kb_multi, 1, 0)) * 24 - 6) * bu / 2 + 0.5), floor(bar.y - 9 * bu + 0.5)
            gap: floor(6 * bu + 0.5)
            show: lm < 0.5
            BarKbd() { show: kb_multi }
            BarPriv(0) { show: priv_mic }
            BarPriv(1) { show: priv_cam }
            BarPriv(2) { show: priv_scr and not rec_on }
            BarRec(rec_stop) { show: rec_on }
            for t in bartrays { BarTray(t, click: bar_tray_click, menu: bar_tray_menu) { show: bs.tray > 0.02 } }
        }
        column tray_bar_col {
            at: floor(lf.x - 9 * bu + 0.5), floor(lv.tray + 0.5)
            gap: floor(6 * bu + 0.5)
            show: lm >= 0.5
            BarKbd() { show: kb_multi }
            BarPriv(0) { show: priv_mic }
            BarPriv(1) { show: priv_cam }
            BarPriv(2) { show: priv_scr and not rec_on }
            BarRec(rec_stop) { show: rec_on }
            for t in bartrays { BarTray(t, click: bar_tray_click, menu: bar_tray_menu) { show: bs.tray > 0.02 } }
        }
        //  The add-ons piece (only on the Island): the add-on pill's icons.
        row ax_bar_row {
            at: floor(ax.x - fw.ax / 2 + 0.5), floor(bar.y - 9 * bu + 0.5)
            gap: floor(6 * bu + 0.5)
            show: fm < 0.5 and bs.ax > 0.02
            for t in adk_pins { BarAddon(t) }
        }
        //  Every workspace is a soft square. The one in view stretches into a rectangle (along the bar; down the strip, down) and turns
        //  to the accent, one square becoming the other with nothing travelling; one with a window in it is a little more solid; one calling for
        //  attention is coral, still, until you go there. Under the pointer a mark swells by a third, popping a little past, and brightens.
        let cx1 = mix(ws.a1, lf.x, lm)
        let cy1 = mix(bar.y, ws.a1, lm)
        let wg1 = ws.urg.1 * (1 - ws.act.1)
        let al1 = (ws.ma + ws.mt * ws.tall.1) * ws.U * (1 + 0.35 * wsp.1.$screen) * ws.vis.1
        let ac1 = mix(al1, ws.lt * (1 + 0.35 * wsp.1.$screen) * ws.vis.1, ws.st3)
        let bw1 = mix(al1, ac1, lm)
        let bh1 = mix(ac1, al1, lm)
        let cx2 = mix(ws.a2, lf.x, lm)
        let cy2 = mix(bar.y, ws.a2, lm)
        let wg2 = ws.urg.2 * (1 - ws.act.2)
        let al2 = (ws.ma + ws.mt * ws.tall.2) * ws.U * (1 + 0.35 * wsp.2.$screen) * ws.vis.2
        let ac2 = mix(al2, ws.lt * (1 + 0.35 * wsp.2.$screen) * ws.vis.2, ws.st3)
        let bw2 = mix(al2, ac2, lm)
        let bh2 = mix(ac2, al2, lm)
        let cx3 = mix(ws.a3, lf.x, lm)
        let cy3 = mix(bar.y, ws.a3, lm)
        let wg3 = ws.urg.3 * (1 - ws.act.3)
        let al3 = (ws.ma + ws.mt * ws.tall.3) * ws.U * (1 + 0.35 * wsp.3.$screen) * ws.vis.3
        let ac3 = mix(al3, ws.lt * (1 + 0.35 * wsp.3.$screen) * ws.vis.3, ws.st3)
        let bw3 = mix(al3, ac3, lm)
        let bh3 = mix(ac3, al3, lm)
        let cx4 = mix(ws.a4, lf.x, lm)
        let cy4 = mix(bar.y, ws.a4, lm)
        let wg4 = ws.urg.4 * (1 - ws.act.4)
        let al4 = (ws.ma + ws.mt * ws.tall.4) * ws.U * (1 + 0.35 * wsp.4.$screen) * ws.vis.4
        let ac4 = mix(al4, ws.lt * (1 + 0.35 * wsp.4.$screen) * ws.vis.4, ws.st3)
        let bw4 = mix(al4, ac4, lm)
        let bh4 = mix(ac4, al4, lm)
        let cx5 = mix(ws.a5, lf.x, lm)
        let cy5 = mix(bar.y, ws.a5, lm)
        let wg5 = ws.urg.5 * (1 - ws.act.5)
        let al5 = (ws.ma + ws.mt * ws.tall.5) * ws.U * (1 + 0.35 * wsp.5.$screen) * ws.vis.5
        let ac5 = mix(al5, ws.lt * (1 + 0.35 * wsp.5.$screen) * ws.vis.5, ws.st3)
        let bw5 = mix(al5, ac5, lm)
        let bh5 = mix(ac5, al5, lm)
        let cx6 = mix(ws.a6, lf.x, lm)
        let cy6 = mix(bar.y, ws.a6, lm)
        let wg6 = ws.urg.6 * (1 - ws.act.6)
        let al6 = (ws.ma + ws.mt * ws.tall.6) * ws.U * (1 + 0.35 * wsp.6.$screen) * ws.vis.6
        let ac6 = mix(al6, ws.lt * (1 + 0.35 * wsp.6.$screen) * ws.vis.6, ws.st3)
        let bw6 = mix(al6, ac6, lm)
        let bh6 = mix(ac6, al6, lm)
        let cx7 = mix(ws.a7, lf.x, lm)
        let cy7 = mix(bar.y, ws.a7, lm)
        let wg7 = ws.urg.7 * (1 - ws.act.7)
        let al7 = (ws.ma + ws.mt * ws.tall.7) * ws.U * (1 + 0.35 * wsp.7.$screen) * ws.vis.7
        let ac7 = mix(al7, ws.lt * (1 + 0.35 * wsp.7.$screen) * ws.vis.7, ws.st3)
        let bw7 = mix(al7, ac7, lm)
        let bh7 = mix(ac7, al7, lm)
        let cx8 = mix(ws.a8, lf.x, lm)
        let cy8 = mix(bar.y, ws.a8, lm)
        let wg8 = ws.urg.8 * (1 - ws.act.8)
        let al8 = (ws.ma + ws.mt * ws.tall.8) * ws.U * (1 + 0.35 * wsp.8.$screen) * ws.vis.8
        let ac8 = mix(al8, ws.lt * (1 + 0.35 * wsp.8.$screen) * ws.vis.8, ws.st3)
        let bw8 = mix(al8, ac8, lm)
        let bh8 = mix(ac8, al8, lm)
        let cx9 = mix(ws.a9, lf.x, lm)
        let cy9 = mix(bar.y, ws.a9, lm)
        let wg9 = ws.urg.9 * (1 - ws.act.9)
        let al9 = (ws.ma + ws.mt * ws.tall.9) * ws.U * (1 + 0.35 * wsp.9.$screen) * ws.vis.9
        let ac9 = mix(al9, ws.lt * (1 + 0.35 * wsp.9.$screen) * ws.vis.9, ws.st3)
        let bw9 = mix(al9, ac9, lm)
        let bh9 = mix(ac9, al9, lm)
        let cx10 = mix(ws.a10, lf.x, lm)
        let cy10 = mix(bar.y, ws.a10, lm)
        let wg10 = ws.urg.10 * (1 - ws.act.10)
        let al10 = (ws.ma + ws.mt * ws.tall.10) * ws.U * (1 + 0.35 * wsp.10.$screen) * ws.vis.10
        let ac10 = mix(al10, ws.lt * (1 + 0.35 * wsp.10.$screen) * ws.vis.10, ws.st3)
        let bw10 = mix(al10, ac10, lm)
        let bh10 = mix(ac10, al10, lm)
        body ws.sq1 {
            color: mix(ink, warm, wg1)
            opacity: 0.55 * (min(100%, mix(30% + 55% * ws.tall.1, 100%, wg1) + 35% * wsh.1.$screen) * (1 - ws.act.1) * ws.vis.1 * bs.ws * (1 - ws.st2))
            rim: 40%
            box { at: cx1, cy1; size: bw1, bh1; corner: ws.cr * min(bw1, bh1) }
        }
        PWsOutline(cx1, cy1, bw1, bh1, min(100%, mix(30% + 55% * ws.tall.1, 100%, wg1) + 35% * wsh.1.$screen) * (1 - ws.act.1) * ws.vis.1 * bs.ws * (1 - ws.st2), wg1, 0, wsh.1.$screen)
        body ws.sq2 {
            color: mix(ink, warm, wg2)
            opacity: 0.55 * (min(100%, mix(30% + 55% * ws.tall.2, 100%, wg2) + 35% * wsh.2.$screen) * (1 - ws.act.2) * ws.vis.2 * bs.ws * (1 - ws.st2))
            rim: 40%
            box { at: cx2, cy2; size: bw2, bh2; corner: ws.cr * min(bw2, bh2) }
        }
        PWsOutline(cx2, cy2, bw2, bh2, min(100%, mix(30% + 55% * ws.tall.2, 100%, wg2) + 35% * wsh.2.$screen) * (1 - ws.act.2) * ws.vis.2 * bs.ws * (1 - ws.st2), wg2, 0, wsh.2.$screen)
        body ws.sq3 {
            color: mix(ink, warm, wg3)
            opacity: 0.55 * (min(100%, mix(30% + 55% * ws.tall.3, 100%, wg3) + 35% * wsh.3.$screen) * (1 - ws.act.3) * ws.vis.3 * bs.ws * (1 - ws.st2))
            rim: 40%
            box { at: cx3, cy3; size: bw3, bh3; corner: ws.cr * min(bw3, bh3) }
        }
        PWsOutline(cx3, cy3, bw3, bh3, min(100%, mix(30% + 55% * ws.tall.3, 100%, wg3) + 35% * wsh.3.$screen) * (1 - ws.act.3) * ws.vis.3 * bs.ws * (1 - ws.st2), wg3, 0, wsh.3.$screen)
        body ws.sq4 {
            color: mix(ink, warm, wg4)
            opacity: 0.55 * (min(100%, mix(30% + 55% * ws.tall.4, 100%, wg4) + 35% * wsh.4.$screen) * (1 - ws.act.4) * ws.vis.4 * bs.ws * (1 - ws.st2))
            rim: 40%
            box { at: cx4, cy4; size: bw4, bh4; corner: ws.cr * min(bw4, bh4) }
        }
        PWsOutline(cx4, cy4, bw4, bh4, min(100%, mix(30% + 55% * ws.tall.4, 100%, wg4) + 35% * wsh.4.$screen) * (1 - ws.act.4) * ws.vis.4 * bs.ws * (1 - ws.st2), wg4, 0, wsh.4.$screen)
        body ws.sq5 {
            color: mix(ink, warm, wg5)
            opacity: 0.55 * (min(100%, mix(30% + 55% * ws.tall.5, 100%, wg5) + 35% * wsh.5.$screen) * (1 - ws.act.5) * ws.vis.5 * bs.ws * (1 - ws.st2))
            rim: 40%
            box { at: cx5, cy5; size: bw5, bh5; corner: ws.cr * min(bw5, bh5) }
        }
        PWsOutline(cx5, cy5, bw5, bh5, min(100%, mix(30% + 55% * ws.tall.5, 100%, wg5) + 35% * wsh.5.$screen) * (1 - ws.act.5) * ws.vis.5 * bs.ws * (1 - ws.st2), wg5, 0, wsh.5.$screen)
        body ws.sq6 {
            color: mix(ink, warm, wg6)
            opacity: 0.55 * (min(100%, mix(30% + 55% * ws.tall.6, 100%, wg6) + 35% * wsh.6.$screen) * (1 - ws.act.6) * ws.vis.6 * bs.ws * (1 - ws.st2))
            rim: 40%
            box { at: cx6, cy6; size: bw6, bh6; corner: ws.cr * min(bw6, bh6) }
        }
        PWsOutline(cx6, cy6, bw6, bh6, min(100%, mix(30% + 55% * ws.tall.6, 100%, wg6) + 35% * wsh.6.$screen) * (1 - ws.act.6) * ws.vis.6 * bs.ws * (1 - ws.st2), wg6, 0, wsh.6.$screen)
        body ws.sq7 {
            color: mix(ink, warm, wg7)
            opacity: 0.55 * (min(100%, mix(30% + 55% * ws.tall.7, 100%, wg7) + 35% * wsh.7.$screen) * (1 - ws.act.7) * ws.vis.7 * bs.ws * (1 - ws.st2))
            rim: 40%
            box { at: cx7, cy7; size: bw7, bh7; corner: ws.cr * min(bw7, bh7) }
        }
        PWsOutline(cx7, cy7, bw7, bh7, min(100%, mix(30% + 55% * ws.tall.7, 100%, wg7) + 35% * wsh.7.$screen) * (1 - ws.act.7) * ws.vis.7 * bs.ws * (1 - ws.st2), wg7, 0, wsh.7.$screen)
        body ws.sq8 {
            color: mix(ink, warm, wg8)
            opacity: 0.55 * (min(100%, mix(30% + 55% * ws.tall.8, 100%, wg8) + 35% * wsh.8.$screen) * (1 - ws.act.8) * ws.vis.8 * bs.ws * (1 - ws.st2))
            rim: 40%
            box { at: cx8, cy8; size: bw8, bh8; corner: ws.cr * min(bw8, bh8) }
        }
        PWsOutline(cx8, cy8, bw8, bh8, min(100%, mix(30% + 55% * ws.tall.8, 100%, wg8) + 35% * wsh.8.$screen) * (1 - ws.act.8) * ws.vis.8 * bs.ws * (1 - ws.st2), wg8, 0, wsh.8.$screen)
        body ws.sq9 {
            color: mix(ink, warm, wg9)
            opacity: 0.55 * (min(100%, mix(30% + 55% * ws.tall.9, 100%, wg9) + 35% * wsh.9.$screen) * (1 - ws.act.9) * ws.vis.9 * bs.ws * (1 - ws.st2))
            rim: 40%
            box { at: cx9, cy9; size: bw9, bh9; corner: ws.cr * min(bw9, bh9) }
        }
        PWsOutline(cx9, cy9, bw9, bh9, min(100%, mix(30% + 55% * ws.tall.9, 100%, wg9) + 35% * wsh.9.$screen) * (1 - ws.act.9) * ws.vis.9 * bs.ws * (1 - ws.st2), wg9, 0, wsh.9.$screen)
        body ws.sq10 {
            color: mix(ink, warm, wg10)
            opacity: 0.55 * (min(100%, mix(30% + 55% * ws.tall.10, 100%, wg10) + 35% * wsh.10.$screen) * (1 - ws.act.10) * ws.vis.10 * bs.ws * (1 - ws.st2))
            rim: 40%
            box { at: cx10, cy10; size: bw10, bh10; corner: ws.cr * min(bw10, bh10) }
        }
        PWsOutline(cx10, cy10, bw10, bh10, min(100%, mix(30% + 55% * ws.tall.10, 100%, wg10) + 35% * wsh.10.$screen) * (1 - ws.act.10) * ws.vis.10 * bs.ws * (1 - ws.st2), wg10, 0, wsh.10.$screen)
        let pl.h1 = ws.c1 + clamp(pl.head - 1, 0, 1) * (ws.c2 - ws.c1) + clamp(pl.head - 2, 0, 1) * (ws.c3 - ws.c2) + clamp(pl.head - 3, 0, 1) * (ws.c4 - ws.c3) + clamp(pl.head - 4, 0, 1) * (ws.c5 - ws.c4) + clamp(pl.head - 5, 0, 1) * (ws.c6 - ws.c5) + clamp(pl.head - 6, 0, 1) * (ws.c7 - ws.c6) + clamp(pl.head - 7, 0, 1) * (ws.c8 - ws.c7) + clamp(pl.head - 8, 0, 1) * (ws.c9 - ws.c8) + clamp(pl.head - 9, 0, 1) * (ws.c10 - ws.c9)
        let pl.h2 = ws.c1 + clamp(pl.tail - 1, 0, 1) * (ws.c2 - ws.c1) + clamp(pl.tail - 2, 0, 1) * (ws.c3 - ws.c2) + clamp(pl.tail - 3, 0, 1) * (ws.c4 - ws.c3) + clamp(pl.tail - 4, 0, 1) * (ws.c5 - ws.c4) + clamp(pl.tail - 5, 0, 1) * (ws.c6 - ws.c5) + clamp(pl.tail - 6, 0, 1) * (ws.c7 - ws.c6) + clamp(pl.tail - 7, 0, 1) * (ws.c8 - ws.c7) + clamp(pl.tail - 8, 0, 1) * (ws.c9 - ws.c8) + clamp(pl.tail - 9, 0, 1) * (ws.c10 - ws.c9)
        let pl.s = min(1, abs(pl.head - pl.tail))
        let pl.t = ws.pb * (1 - 0.18 * pl.s)
        let pl.len = abs(pl.h1 - pl.h2) + ws.pl
        let pl.m = ws.o + (pl.h1 + pl.h2) / 2
        let pl.w = mix(pl.len, pl.t, lm)
        let pl.h = mix(pl.t, pl.len, lm)
        group {
            body ws.pill {
                gradient: 0, mix(bar.y, pl.m, lm) - pl.h / 2 to 0, mix(bar.y, pl.m, lm) + pl.h / 2, minthi, mintlo
                rim: 55%
                shadow: 0, 0, 7 * bu, 30%, mint
                opacity: 0.55 * bs.ws * (1 - ws.sp)
                box { at: mix(pl.m, lf.x, lm), mix(bar.y, pl.m, lm); size: pl.w, pl.h; corner: ws.cr * min(pl.w, pl.h) }
            }
            PWsOutline(mix(pl.m, lf.x, lm), mix(bar.y, pl.m, lm), pl.w, pl.h, bs.ws * (1 - ws.sp), 0, 1, max(max(max(wsh.1.$screen, wsh.2.$screen), max(wsh.3.$screen, wsh.4.$screen)), max(max(max(wsh.5.$screen, wsh.6.$screen), max(wsh.7.$screen, wsh.8.$screen)), max(wsh.9.$screen, wsh.10.$screen))))
        }
        //  Numbers (Settings > Bar > Workspaces): each mark is its workspace's number, the one in view on the pill, one with a window a little more solid.
        group { scale: ws.U; pivot: cx1, cy1; text "1" { at: cx1, cy1; anchor: center; align: center; size: 11; weight: 700; color: mix(ink, warm, wg1); opacity: min(100%, mix(mix(45% + 40% * ws.tall.1, 100%, wg1) + 30% * wsh.1.$screen, 100%, ws.act.1)) * ws.vis.1 * ws.st2 * bs.ws * (1 - ws.sp); family: "Space Grotesk" } }
        group { scale: ws.U; pivot: cx2, cy2; text "2" { at: cx2, cy2; anchor: center; align: center; size: 11; weight: 700; color: mix(ink, warm, wg2); opacity: min(100%, mix(mix(45% + 40% * ws.tall.2, 100%, wg2) + 30% * wsh.2.$screen, 100%, ws.act.2)) * ws.vis.2 * ws.st2 * bs.ws * (1 - ws.sp); family: "Space Grotesk" } }
        group { scale: ws.U; pivot: cx3, cy3; text "3" { at: cx3, cy3; anchor: center; align: center; size: 11; weight: 700; color: mix(ink, warm, wg3); opacity: min(100%, mix(mix(45% + 40% * ws.tall.3, 100%, wg3) + 30% * wsh.3.$screen, 100%, ws.act.3)) * ws.vis.3 * ws.st2 * bs.ws * (1 - ws.sp); family: "Space Grotesk" } }
        group { scale: ws.U; pivot: cx4, cy4; text "4" { at: cx4, cy4; anchor: center; align: center; size: 11; weight: 700; color: mix(ink, warm, wg4); opacity: min(100%, mix(mix(45% + 40% * ws.tall.4, 100%, wg4) + 30% * wsh.4.$screen, 100%, ws.act.4)) * ws.vis.4 * ws.st2 * bs.ws * (1 - ws.sp); family: "Space Grotesk" } }
        group { scale: ws.U; pivot: cx5, cy5; text "5" { at: cx5, cy5; anchor: center; align: center; size: 11; weight: 700; color: mix(ink, warm, wg5); opacity: min(100%, mix(mix(45% + 40% * ws.tall.5, 100%, wg5) + 30% * wsh.5.$screen, 100%, ws.act.5)) * ws.vis.5 * ws.st2 * bs.ws * (1 - ws.sp); family: "Space Grotesk" } }
        group { scale: ws.U; pivot: cx6, cy6; text "6" { at: cx6, cy6; anchor: center; align: center; size: 11; weight: 700; color: mix(ink, warm, wg6); opacity: min(100%, mix(mix(45% + 40% * ws.tall.6, 100%, wg6) + 30% * wsh.6.$screen, 100%, ws.act.6)) * ws.vis.6 * ws.st2 * bs.ws * (1 - ws.sp); family: "Space Grotesk" } }
        group { scale: ws.U; pivot: cx7, cy7; text "7" { at: cx7, cy7; anchor: center; align: center; size: 11; weight: 700; color: mix(ink, warm, wg7); opacity: min(100%, mix(mix(45% + 40% * ws.tall.7, 100%, wg7) + 30% * wsh.7.$screen, 100%, ws.act.7)) * ws.vis.7 * ws.st2 * bs.ws * (1 - ws.sp); family: "Space Grotesk" } }
        group { scale: ws.U; pivot: cx8, cy8; text "8" { at: cx8, cy8; anchor: center; align: center; size: 11; weight: 700; color: mix(ink, warm, wg8); opacity: min(100%, mix(mix(45% + 40% * ws.tall.8, 100%, wg8) + 30% * wsh.8.$screen, 100%, ws.act.8)) * ws.vis.8 * ws.st2 * bs.ws * (1 - ws.sp); family: "Space Grotesk" } }
        group { scale: ws.U; pivot: cx9, cy9; text "9" { at: cx9, cy9; anchor: center; align: center; size: 11; weight: 700; color: mix(ink, warm, wg9); opacity: min(100%, mix(mix(45% + 40% * ws.tall.9, 100%, wg9) + 30% * wsh.9.$screen, 100%, ws.act.9)) * ws.vis.9 * ws.st2 * bs.ws * (1 - ws.sp); family: "Space Grotesk" } }
        group { scale: ws.U; pivot: cx10, cy10; text "10" { at: cx10, cy10; anchor: center; align: center; size: 11; weight: 700; color: mix(ink, warm, wg10); opacity: min(100%, mix(mix(45% + 40% * ws.tall.10, 100%, wg10) + 30% * wsh.10.$screen, 100%, ws.act.10)) * ws.vis.10 * ws.st2 * bs.ws * (1 - ws.sp); family: "Space Grotesk" } }
        //  A special workspace in view: a pencil mark where the marks were, coming up from nothing: the sparkle (magic, and any other), a pair of notes (music) or an eye
        //  crossed out (private). Their lines are redrawn about five times a second the whole time they are there, the way a workspace mark's are under the pointer.
        let sk.x = mix(ws.o + 9 * ws.U, lf.x, lm)
        let sk.y = mix(bar.y, ws.o + 9 * ws.U, lm)
        PBSpark(sk.x, sk.y, 9 * ws.U * max(ws.spa, 0.01), ws.spa * bs.ws)
        PBNote(sk.x, sk.y, 9 * ws.U * max(ws.spm, 0.01), ws.spm * bs.ws)
        PBHide(sk.x, sk.y, 9 * ws.U * max(ws.spp, 0.01), ws.spp * bs.ws)
        //  The plus: two strokes, there while the workspace in view has a window.
        let wpl.x = mix(ws.a11, lf.x, lm)
        let wpl.y = mix(bar.y, ws.a11, lm)
        let wpl.d = ws.ps * 0.62 * (1 + 0.3 * wspl.$screen)
        body ws_plus_icon {
            color: ink
            opacity: (55% + 40% * wspl.$screen) * ws.pv * bs.ws
            rim: 30%
            box { at: wpl.x, wpl.y; size: max(0.3, wpl.d * ws.pv), 1.6 * ws.U; corner: 0.8 * ws.U }
            box { at: wpl.x, wpl.y; size: 1.6 * ws.U, max(0.3, wpl.d * ws.pv); corner: 0.8 * ws.U }
        }
        //  The overview button: two windows drawn as outlines (the marks are all solid), wide with small corners, one behind the other; the front one has
        //  its title bar. Brightening under the pointer.
        let ovi.w = 1.3 * ws.U
        PBOver(ob.x, ob.y, ov_btn.hover, ob.d, ovi.w, (45% + 35% * ov_btn.hover) * bs.ws, (70% + 30% * ov_btn.hover) * bs.ws, (70% + 30% * ov_btn.hover) * bs.ws)
        //  The player's buttons.
        group {
            opacity: mshow * bs.media * bs.title
            group {
                pivot: mcx - 18.5 * bu, mcy
                scale: 1 + 0.14 * bp.prev.hover
                PBPrev(mcx - 18.5 * bu, mcy, bp.prev.hover, bu, 65% + 35% * bp.prev.hover)
            }
            //  Pause while it plays, play while it is paused.
            group {
                pivot: mcx, mcy
                scale: 1 + 0.14 * bp.play.hover
                PBPlay(mcx, mcy, bp.play.hover, bu, 85% + 15% * bp.play.hover, if(media.playing, 1, 0))
            }
            group {
                pivot: mcx + 18.5 * bu, mcy
                scale: 1 + 0.14 * bp.next.hover
                PBNext(mcx + 18.5 * bu, mcy, bp.next.hover, bu, 65% + 35% * bp.next.hover)
            }
        }
        //  Down the left the player's buttons are the top bar's own, turned with the title (a quarter anticlockwise, so they read from the foot up:
        //  previous nearest the text, next at the far end), at the top end of it.
        group {
            opacity: mshow * bs.media0 * lm
            pivot: lf.x, lv.mid
            rotate: -90deg
            group {
                pivot: lf.x - 18.5 * bcu, lv.mid
                scale: 1 + 0.14 * vm_prev.hover
                PBPrev(lf.x - 18.5 * bcu, lv.mid, vm_prev.hover, bcu, 65% + 35% * vm_prev.hover)
            }
            group {
                pivot: lf.x, lv.mid
                scale: 1 + 0.14 * vm_play.hover
                PBPlay(lf.x, lv.mid, vm_play.hover, bcu, 85% + 15% * vm_play.hover, if(media.playing, 1, 0))
            }
            group {
                pivot: lf.x + 18.5 * bcu, lv.mid
                scale: 1 + 0.14 * vm_next.hover
                PBNext(lf.x + 18.5 * bcu, lv.mid, vm_next.hover, bcu, 65% + 35% * vm_next.hover)
            }
        }
        //  The settings button: a gear, between the player's buttons and the controls button.
        group {
            opacity: 65% + 35% * max(set_hit.hover, clamp(ds, 0, 1))
            move: (lf.x - set.x) * lm, (lv.set - bar.y) * lm
            group {
                pivot: set.x, bar.y
                scale: 1 + 0.14 * set_hit.hover
                PBGear(set.x, bar.y, set_hit.hover, bu, clamp(ds, 0, 1))
            }
        }
        //  The launcher's button, between the settings button and the controls button: a magnifying glass.
        group {
            opacity: (65% + 35% * max(sr_hit.hover, clamp(dl, 0, 1))) * bs.sr
            move: (lf.x - sr.x) * lm, (lv.sr - bar.y) * lm
            group {
                pivot: sr.x + 2 * bu, bar.y + 2 * bu
                scale: 1 + 0.14 * sr_hit.hover
                PBSearch(sr.x, bar.y, sr_hit.hover, bu, clamp(dl, 0, 1))
            }
        }
        //  The controls button, between the settings button and the clock: two sliders.
        group {
            opacity: (65% + 35% * max(ctl_hit.hover, clamp(dk, 0, 1))) * bs.ctl
            move: (lf.x - ctl.x) * lm, (lv.ctl - bar.y) * lm
            group {
                pivot: ctl.x, bar.y
                scale: 1 + 0.14 * ctl_hit.hover
                PBCtl(ctl.x, bar.y, ctl_hit.hover, bu, clamp(dk, 0, 1))
            }
        }
    }
}
