part BarIcons {
    //  The bar's icons are drawn here, on top of the bar and outside its wave-shader group, with a soft dark
    //  halo (a group `glow` in the palette's dark colour) so they hold up on a light wallpaper, as the text
    //  does. An effect cannot sit inside another effect's group, hence outside. The click areas and rules
    //  stay in the bar group above.
    group {
        glow: 2.4 * bu, 110%, deep
        row tray_bar_row {
            at: floor(tr.x - ((if(bs.tray > 0.02, bartrays.count, 0) + if(rec_on, 1, 0) + if(priv_mic, 1, 0) + if(priv_cam, 1, 0) + if(priv_scr and not rec_on, 1, 0) + if(kb_multi, 1, 0)) * 24 - 6) * bu / 2 + 0.5), floor(bar.y - 9 * bu + 0.5)
            gap: floor(6 * bu + 0.5)
            show: lm < 0.5
            BarKbd() { show: kb_multi }
            BarPriv(0) { show: priv_mic }
            BarPriv(1) { show: priv_cam }
            BarPriv(2) { show: priv_scr and not rec_on }
            BarRec(rec_stop) { show: rec_on }
            for t in bartrays { BarTray(t, click: bar_tray_click, menu: bar_tray_menu) { show: bs.tray > 0.02 } }
        }
        column tray_bar_col {
            at: floor(lf.x - 9 * bu + 0.5), floor(lv.tray + 0.5)
            gap: floor(6 * bu + 0.5)
            show: lm >= 0.5
            BarKbd() { show: kb_multi }
            BarPriv(0) { show: priv_mic }
            BarPriv(1) { show: priv_cam }
            BarPriv(2) { show: priv_scr and not rec_on }
            BarRec(rec_stop) { show: rec_on }
            for t in bartrays { BarTray(t, click: bar_tray_click, menu: bar_tray_menu) { show: bs.tray > 0.02 } }
        }
        //  The add-ons piece (only on the Island): the add-on pill's icons.
        row ax_bar_row {
            at: floor(ax.x - fw.ax / 2 + 0.5), floor(bar.y - 9 * bu + 0.5)
            gap: floor(6 * bu + 0.5)
            show: fm < 0.5 and bs.ax > 0.02
            for t in adk_pins { BarAddon(t) }
        }
        //  The workspace marks (Settings > Bar > Workspaces): five looks, each morphing into the next (`ws.st.k`; their lengths are `ws.s` in vitreus.plm).
        //  What they share: a busy workspace is more solid than an empty one, one asking for attention is coral (breathing, if chosen), and under the pointer
        //  a mark swells a little, popping past, and brightens. The one in view takes the accent (`wsacc`): one piece that travels (`pl.*`), or that fades in place.
        let wk = ws.K
        let wso = bs.ws * (1 - ws.sp)
        let ws.pop = 0.8 * ws.st.0 + 0.92 * ws.st.1 + 0.3 * ws.st.2 + ws.st.3 + 0.92 * ws.st.4      // how solid the accent is: a glass tint round the app icons, solid elsewhere
        //  The capsule's track: one piece of glass under all the segments, from the first to the last.
        let tk.l = ws.o - 2.5 * wk
        let tk.r = ws.o + ws.end + 2.5 * wk
        let tk.m = (tk.l + tk.r) / 2
        let tk.len = max(0, tk.r - tk.l)
        let tk.t = 17 * wk
        body ws.track {
            color: ink
            opacity: 7% * ws.st.0 * wso
            rim: 35%
            box { at: mix(tk.m, lf.x, lm), mix(bar.y, tk.m, lm); size: mix(tk.len, tk.t, lm), mix(tk.t, tk.len, lm); corner: tk.t / 2 }
        }
        //  The mark in view, travelling (Stretch: its head runs ahead and its tail follows; Slide: as one piece), the same shape whatever the look: a capsule's
        //  filled segment, the pips' pill, the lit tile, the numerals' underline (under the line: `ws.po`), the rings' disc. Under the marks, so what
        //  the one in view holds (its pips, icons, number, the ring's arc) is drawn on it.
        let pl.w = mix(pl.len, pl.t, lm)
        let pl.h = mix(pl.t, pl.len, lm)
        let plx = mix(pl.m, lf.x + ws.po, lm)
        let ply = mix(bar.y + ws.po, pl.m, lm)
        group {
            body ws.pill {
                gradient: 0, ply - pl.h / 2 to 0, ply + pl.h / 2, wsacc.hi, wsacc.lo
                rim: 55%
                shadow: 0, 0, 7 * bu, 30% * (1 - ws.st.3), wsacc
                opacity: ws.pop * wso * (1 - ws.mo2)
                box { at: plx, ply; size: pl.w, pl.h; corner: ws.cr * min(pl.w, pl.h) }
            }
            PWsOutline(plx, ply, pl.w, pl.h, wso * (1 - ws.mo2) * (1 - ws.st.3), 0, 1, max(max(max(wsh.1.$screen, wsh.2.$screen), max(wsh.3.$screen, wsh.4.$screen)), max(max(max(wsh.5.$screen, wsh.6.$screen), max(wsh.7.$screen, wsh.8.$screen)), max(wsh.9.$screen, wsh.10.$screen))))
        }
        repeat i in 1..11 {
            let a = ws.a.$i
            let L = ws.s.$i
            let act = ws.act.$i
            let busy = ws.tall.$i
            let n = ws.cnt.$i
            let ni = ws.ico.$i
            let hot = wsh.$i.$screen
            let wg = ws.urg.$i * (1 - act) * (1 - 0.6 * ws.br)
            let tone = mix(ink, warm, wg)
            let cx = mix(a, lf.x, lm)
            let cy = mix(bar.y, a, lm)
            let lead = ws.nl * wk / 2                    // the pips and the icons move along by half the room the number before them takes
            group {
                opacity: ws.vis.$i * wso
                pivot: cx, cy
                scale: 1 + 0.22 * wsp.$i.$screen * (1 - 0.75 * act)        // (the one in view swells less: its pill does not swell with it)
                //  Fade: the accent is each mark's own, coming and going in place, in the travelling one's shape.
                body {
                    color: wsacc
                    rim: 55%
                    opacity: act * ws.mo2 * ws.pop
                    box { at: mix(a, lf.x + ws.po, lm), mix(bar.y + ws.po, a, lm); size: mix(L, ws.pb, lm), mix(ws.pb, L, lm); corner: ws.cr * min(L, ws.pb) }
                }
                //  Capsule: a segment of the track.
                box { at: cx, cy; size: mix(L - 3 * wk, 11 * wk, lm), mix(11 * wk, L - 3 * wk, lm); corner: 3.5 * wk; color: tone; opacity: ws.st.0 * (1 - act) * (9% + 15% * busy + 14% * hot + 45% * wg) }
                //  Pips: a dot for each window, up to three, or a hollow one for none.
                repeat k in 0..3 {
                    let d = (k - (max(1, n) - 1) / 2) * 8 * wk + lead
                    let on = if(k == 0, clamp(n, 0, 1), clamp(n - k, 0, 1))
                    ellipse { at: mix(a + d, lf.x, lm), mix(bar.y, a + d, lm); radius: 2.5 * wk * (0.3 + 0.7 * on); color: mix(tone, wsacc.on, act); opacity: ws.st.1 * on * mix(55% + 25% * busy + 20% * hot, 100%, act) }
                }
                ellipse { at: mix(a + lead, lf.x, lm), mix(bar.y, a + lead, lm); radius: 2.3 * wk; stroke: 1.2 * wk; color: mix(tone, wsacc.on, act); opacity: ws.st.1 * (1 - clamp(n, 0, 1)) * mix(45% + 30% * hot, 100%, act) }
                //  Apps: a glass tile round its app icons, or a dot for none.
                box { at: cx, cy; size: mix(L, 24 * wk, lm), mix(24 * wk, L, lm); corner: 7 * wk; color: tone; opacity: ws.st.2 * (1 - act) * (6% + 7% * hot + 30% * wg) }
                box { at: cx, cy; size: mix(L, 24 * wk, lm), mix(24 * wk, L, lm); corner: 7 * wk; stroke: 1 * wk; color: tone; opacity: ws.st.2 * (1 - act) * (10% + 8% * busy + 12% * hot + 40% * wg) }
                repeat k in 0..3 {
                    let d = (k - (max(1, ni) - 1) / 2) * 16 * wk + lead
                    let on = clamp(ni - k, 0, 1)
                    let isz = 13 * wk * (0.5 + 0.5 * on)
                    image wsim.$i.$k { at: mix(a + d, lf.x, lm) - isz / 2, mix(bar.y, a + d, lm) - isz / 2; size: isz, isz; opacity: ws.st.2 * on * mix(70% + 30% * hot, 100%, act) }
                }
                ellipse { at: mix(a + lead, lf.x, lm), mix(bar.y, a + lead, lm); radius: 2.2 * wk; color: tone; opacity: ws.st.2 * (1 - clamp(ni, 0, 1)) * mix(45% + 30% * hot, 90%, act) }
                //  Rings: a ring with a third of it drawn for each window; the one in view's on the accent's disc.
                let rr = (5.5 + 2 * ws.nums) * wk
                ellipse { at: cx, cy; radius: rr; stroke: 1.4 * wk; color: tone; opacity: ws.st.4 * (1 - act) * (26% + 16% * hot + 40% * wg) }
                arc { at: cx, cy; radius: rr; span: n / 3 * 360deg; rotate: n / 3 * 180deg; width: 1.8 * wk; color: mix(tone, wsacc.on, act); opacity: ws.st.4 * clamp(n, 0, 1) * mix(85% + 15% * hot, 100%, act) }
            }
        }
        //  A special workspace in view: a pencil mark where the marks were, coming up from nothing: the sparkle (magic, and any other), a pair of notes (music) or an eye
        //  crossed out (private). Their lines are redrawn about five times a second the whole time they are there, the way a workspace mark's are under the pointer.
        let sk.x = mix(ws.o + 9 * ws.U, lf.x, lm)
        let sk.y = mix(bar.y, ws.o + 9 * ws.U, lm)
        PBSpark(sk.x, sk.y, 9 * ws.U * max(ws.spa, 0.01), ws.spa * bs.ws)
        PBNote(sk.x, sk.y, 9 * ws.U * max(ws.spm, 0.01), ws.spm * bs.ws)
        PBHide(sk.x, sk.y, 9 * ws.U * max(ws.spp, 0.01), ws.spp * bs.ws)
        //  The plus: two strokes, there while the workspace in view has a window.
        let wpl.x = mix(ws.pa, lf.x, lm)
        let wpl.y = mix(bar.y, ws.pa, lm)
        let wpl.d = ws.ps * 0.62 * (1 + 0.3 * wspl.$screen)
        body ws_plus_icon {
            color: ink
            opacity: (55% + 40% * wspl.$screen) * ws.pv * bs.ws
            rim: 30%
            box { at: wpl.x, wpl.y; size: max(0.3, wpl.d * ws.pv), 1.6 * ws.U; corner: 0.8 * ws.U }
            box { at: wpl.x, wpl.y; size: 1.6 * ws.U, max(0.3, wpl.d * ws.pv); corner: 0.8 * ws.U }
        }
        //  The overview button: two windows drawn as outlines (the marks are all solid), wide with small corners, one behind the other; the front one has
        //  its title bar. Brightening under the pointer.
        let ovi.w = 1.3 * ws.U
        PBOver(ob.x, ob.y, ov_btn.hover, ob.d, ovi.w, (45% + 35% * ov_btn.hover) * bs.ws, (70% + 30% * ov_btn.hover) * bs.ws, (70% + 30% * ov_btn.hover) * bs.ws)
        //  The player's buttons.
        group {
            opacity: mshow * bs.media * bs.title
            group {
                pivot: mcx - 18.5 * bu, mcy
                scale: 1 + 0.14 * bp.prev.hover
                PBPrev(mcx - 18.5 * bu, mcy, bp.prev.hover, bu, 65% + 35% * bp.prev.hover)
            }
            //  Pause while it plays, play while it is paused.
            group {
                pivot: mcx, mcy
                scale: 1 + 0.14 * bp.play.hover
                PBPlay(mcx, mcy, bp.play.hover, bu, 85% + 15% * bp.play.hover, if(media.playing, 1, 0))
            }
            group {
                pivot: mcx + 18.5 * bu, mcy
                scale: 1 + 0.14 * bp.next.hover
                PBNext(mcx + 18.5 * bu, mcy, bp.next.hover, bu, 65% + 35% * bp.next.hover)
            }
        }
        //  Down the left the player's buttons are the top bar's own, turned with the title (a quarter anticlockwise, so they read from the foot up:
        //  previous nearest the text, next at the far end), at the top end of it.
        group {
            opacity: mshow * bs.media0 * lm
            pivot: lf.x, lv.mid
            rotate: -90deg
            group {
                pivot: lf.x - 18.5 * bcu, lv.mid
                scale: 1 + 0.14 * vm_prev.hover
                PBPrev(lf.x - 18.5 * bcu, lv.mid, vm_prev.hover, bcu, 65% + 35% * vm_prev.hover)
            }
            group {
                pivot: lf.x, lv.mid
                scale: 1 + 0.14 * vm_play.hover
                PBPlay(lf.x, lv.mid, vm_play.hover, bcu, 85% + 15% * vm_play.hover, if(media.playing, 1, 0))
            }
            group {
                pivot: lf.x + 18.5 * bcu, lv.mid
                scale: 1 + 0.14 * vm_next.hover
                PBNext(lf.x + 18.5 * bcu, lv.mid, vm_next.hover, bcu, 65% + 35% * vm_next.hover)
            }
        }
        //  The settings button: a gear, between the player's buttons and the controls button.
        group {
            opacity: (65% + 35% * max(set_hit.hover, clamp(ds, 0, 1))) * bs.set
            move: (lf.x - set.x) * lm, (lv.set - bar.y) * lm
            group {
                pivot: set.x, bar.y
                scale: 1 + 0.14 * set_hit.hover
                PBGear(set.x, bar.y, set_hit.hover, bu, clamp(ds, 0, 1))
            }
        }
        //  The launcher's button, between the settings button and the controls button: a magnifying glass.
        group {
            opacity: (65% + 35% * max(sr_hit.hover, clamp(dl, 0, 1))) * bs.sr
            move: (lf.x - sr.x) * lm, (lv.sr - bar.y) * lm
            group {
                pivot: sr.x + 2 * bu, bar.y + 2 * bu
                scale: 1 + 0.14 * sr_hit.hover
                PBSearch(sr.x, bar.y, sr_hit.hover, bu, clamp(dl, 0, 1))
            }
        }
        //  The controls button, between the settings button and the clock: two sliders.
        group {
            opacity: (65% + 35% * max(ctl_hit.hover, clamp(dk, 0, 1))) * bs.ctl
            move: (lf.x - ctl.x) * lm, (lv.ctl - bar.y) * lm
            group {
                pivot: ctl.x, bar.y
                scale: 1 + 0.14 * ctl_hit.hover
                PBCtl(ctl.x, bar.y, ctl_hit.hover, bu, clamp(dk, 0, 1))
            }
        }
        //  The workspace numbers (Numerals, and the number on every mark), written out one by one: in the bar's icons a text that is not written out in the file
        //  (a live text, a `pick`) comes out without its colour. Each in the three numerals (1 2 3, I II III, 一 二 三: these in Zen Kurenaido, the one font here that has them, a size up for its thinner stroke), the chosen one shown: they cross-fade.
        //  The unseen copies measure each one, for the numerals' slots (`wsnw.i.k`).
        let wk = ws.K
        let wso = bs.ws * (1 - ws.sp)
        group {
            let wn1.a = ws.a.1
            let wn1.act = ws.act.1
            let wn1.wg = ws.urg.1 * (1 - wn1.act) * (1 - 0.6 * ws.br)
            let wn1.cx = mix(wn1.a, lf.x, lm)
            let wn1.cy = mix(bar.y, wn1.a, lm)
            let wn1.nd = (-(ws.st.1 * (5 + 8 * (max(1, ws.cnt.1) - 1)) + ws.st.2 * (16 * max(1, ws.ico.1) - 3) + ws.nl) * wk / 2 + 5.5 * wk) * (ws.st.1 + ws.st.2)      // the number and the pips or icons after it, centred as one
            let wn1.o1 = ws.vis.1 * wso * ws.st.3 * min(100%, mix(45% + 40% * ws.tall.1 + 30% * wsh.1.$screen, 100%, wn1.act))
            let wn1.o2 = ws.vis.1 * wso * ws.nums * min(100%, mix(55% + 30% * ws.tall.1 + 25% * wsh.1.$screen, 100%, wn1.act))
            text "1" { at: 0, 0; anchor: left center; size: 11.5; weight: 700; lines: 1; measure: wsnw.1.0; opacity: 0; family: "Space Grotesk" }
            text "I" { at: 0, 0; anchor: left center; size: 11.5; weight: 700; lines: 1; measure: wsnw.1.1; opacity: 0; family: "Space Grotesk" }
            text "一" { at: 0, 0; anchor: left center; size: 14; lines: 1; measure: wsnw.1.2; opacity: 0; family: "Zen Kurenaido" }
            group {
                scale: wk * (1 + 0.22 * wsp.1.$screen * (1 - 0.75 * wn1.act))
                pivot: wn1.cx, wn1.cy
                text "1" { at: wn1.cx, wn1.cy - 0.5 * ws.st.3; anchor: center; align: center; size: 11.5; weight: 700; color: mix(mix(ink, warm, wn1.wg), wsacc, wn1.act); opacity: wn1.o1 * (1 - ws.nr1 - ws.nr2); family: "Space Grotesk" }
                text "I" { at: wn1.cx, wn1.cy - 0.5 * ws.st.3; anchor: center; align: center; size: 11.5; weight: 700; color: mix(mix(ink, warm, wn1.wg), wsacc, wn1.act); opacity: wn1.o1 * ws.nr1; family: "Space Grotesk" }
                text "一" { at: wn1.cx, wn1.cy - 0.5 * ws.st.3; anchor: center; align: center; size: 14; color: mix(mix(ink, warm, wn1.wg), wsacc, wn1.act); opacity: wn1.o1 * ws.nr2; family: "Zen Kurenaido" }
            }
            group {
                scale: wk * (1 + 0.22 * wsp.1.$screen * (1 - 0.75 * wn1.act))
                pivot: mix(wn1.a + wn1.nd, lf.x, lm), mix(bar.y, wn1.a + wn1.nd, lm)
                text "1" { at: mix(wn1.a + wn1.nd, lf.x, lm), mix(bar.y, wn1.a + wn1.nd, lm); anchor: center; align: center; size: 9; weight: 700; color: mix(mix(ink, warm, wn1.wg), mix(wsacc.on, ink, ws.st.2), wn1.act); opacity: wn1.o2 * (1 - ws.nr1 - ws.nr2); family: "Space Grotesk" }
                text "I" { at: mix(wn1.a + wn1.nd, lf.x, lm), mix(bar.y, wn1.a + wn1.nd, lm); anchor: center; align: center; size: 9; weight: 700; color: mix(mix(ink, warm, wn1.wg), mix(wsacc.on, ink, ws.st.2), wn1.act); opacity: wn1.o2 * ws.nr1; family: "Space Grotesk" }
                text "一" { at: mix(wn1.a + wn1.nd, lf.x, lm), mix(bar.y, wn1.a + wn1.nd, lm); anchor: center; align: center; size: 11; color: mix(mix(ink, warm, wn1.wg), mix(wsacc.on, ink, ws.st.2), wn1.act); opacity: wn1.o2 * ws.nr2; family: "Zen Kurenaido" }
            }
        }
        group {
            let wn2.a = ws.a.2
            let wn2.act = ws.act.2
            let wn2.wg = ws.urg.2 * (1 - wn2.act) * (1 - 0.6 * ws.br)
            let wn2.cx = mix(wn2.a, lf.x, lm)
            let wn2.cy = mix(bar.y, wn2.a, lm)
            let wn2.nd = (-(ws.st.1 * (5 + 8 * (max(1, ws.cnt.2) - 1)) + ws.st.2 * (16 * max(1, ws.ico.2) - 3) + ws.nl) * wk / 2 + 5.5 * wk) * (ws.st.1 + ws.st.2)      // the number and the pips or icons after it, centred as one
            let wn2.o1 = ws.vis.2 * wso * ws.st.3 * min(100%, mix(45% + 40% * ws.tall.2 + 30% * wsh.2.$screen, 100%, wn2.act))
            let wn2.o2 = ws.vis.2 * wso * ws.nums * min(100%, mix(55% + 30% * ws.tall.2 + 25% * wsh.2.$screen, 100%, wn2.act))
            text "2" { at: 0, 0; anchor: left center; size: 11.5; weight: 700; lines: 1; measure: wsnw.2.0; opacity: 0; family: "Space Grotesk" }
            text "II" { at: 0, 0; anchor: left center; size: 11.5; weight: 700; lines: 1; measure: wsnw.2.1; opacity: 0; family: "Space Grotesk" }
            text "二" { at: 0, 0; anchor: left center; size: 14; lines: 1; measure: wsnw.2.2; opacity: 0; family: "Zen Kurenaido" }
            group {
                scale: wk * (1 + 0.22 * wsp.2.$screen * (1 - 0.75 * wn2.act))
                pivot: wn2.cx, wn2.cy
                text "2" { at: wn2.cx, wn2.cy - 0.5 * ws.st.3; anchor: center; align: center; size: 11.5; weight: 700; color: mix(mix(ink, warm, wn2.wg), wsacc, wn2.act); opacity: wn2.o1 * (1 - ws.nr1 - ws.nr2); family: "Space Grotesk" }
                text "II" { at: wn2.cx, wn2.cy - 0.5 * ws.st.3; anchor: center; align: center; size: 11.5; weight: 700; color: mix(mix(ink, warm, wn2.wg), wsacc, wn2.act); opacity: wn2.o1 * ws.nr1; family: "Space Grotesk" }
                text "二" { at: wn2.cx, wn2.cy - 0.5 * ws.st.3; anchor: center; align: center; size: 14; color: mix(mix(ink, warm, wn2.wg), wsacc, wn2.act); opacity: wn2.o1 * ws.nr2; family: "Zen Kurenaido" }
            }
            group {
                scale: wk * (1 + 0.22 * wsp.2.$screen * (1 - 0.75 * wn2.act))
                pivot: mix(wn2.a + wn2.nd, lf.x, lm), mix(bar.y, wn2.a + wn2.nd, lm)
                text "2" { at: mix(wn2.a + wn2.nd, lf.x, lm), mix(bar.y, wn2.a + wn2.nd, lm); anchor: center; align: center; size: 9; weight: 700; color: mix(mix(ink, warm, wn2.wg), mix(wsacc.on, ink, ws.st.2), wn2.act); opacity: wn2.o2 * (1 - ws.nr1 - ws.nr2); family: "Space Grotesk" }
                text "II" { at: mix(wn2.a + wn2.nd, lf.x, lm), mix(bar.y, wn2.a + wn2.nd, lm); anchor: center; align: center; size: 9; weight: 700; color: mix(mix(ink, warm, wn2.wg), mix(wsacc.on, ink, ws.st.2), wn2.act); opacity: wn2.o2 * ws.nr1; family: "Space Grotesk" }
                text "二" { at: mix(wn2.a + wn2.nd, lf.x, lm), mix(bar.y, wn2.a + wn2.nd, lm); anchor: center; align: center; size: 11; color: mix(mix(ink, warm, wn2.wg), mix(wsacc.on, ink, ws.st.2), wn2.act); opacity: wn2.o2 * ws.nr2; family: "Zen Kurenaido" }
            }
        }
        group {
            let wn3.a = ws.a.3
            let wn3.act = ws.act.3
            let wn3.wg = ws.urg.3 * (1 - wn3.act) * (1 - 0.6 * ws.br)
            let wn3.cx = mix(wn3.a, lf.x, lm)
            let wn3.cy = mix(bar.y, wn3.a, lm)
            let wn3.nd = (-(ws.st.1 * (5 + 8 * (max(1, ws.cnt.3) - 1)) + ws.st.2 * (16 * max(1, ws.ico.3) - 3) + ws.nl) * wk / 2 + 5.5 * wk) * (ws.st.1 + ws.st.2)      // the number and the pips or icons after it, centred as one
            let wn3.o1 = ws.vis.3 * wso * ws.st.3 * min(100%, mix(45% + 40% * ws.tall.3 + 30% * wsh.3.$screen, 100%, wn3.act))
