part ControlsDrawer {
    //  The controls' content is clipped to the drawer's shape.
    group {
        shader: pixelate, px.dk
        opacity: pown
        move: rt * (screen.width - 2 * pcx), bt * (yo + vb - 2 * (th.t + lp.hd / 2))
        clip inset 2 box { at: mix(mix(mix(pcx, dk.gx, lm), 2 * pcx - mix(pcx, dk.gx, lm), rt), dk.tex, tu), mix(mix(bar.y + dk.hh / 2, lp.cy, lm), dk.tey, tu) + bt * (2 * (th.t + lp.hd / 2) - 2 * mix(mix(bar.y + dk.hh / 2, lp.cy, lm), dk.tey, tu)); size: mix(mix(dk.w, dk.gw, lm), dk.tew, tu), mix(mix(dk.hh, dk.gh, lm), dk.teh, tu); corner: 26 * cu * (1 - 0.73 * sq) }
        //  Down the left it comes out of the strip: what is inside grows with the drawer's shape (`dk.lf`), from the strip's edge at the panel's middle, instead of waiting still under the clip.
        group {
            pivot: mix(mix(lp.xl, 2 * pcx - lp.xl, rt), pcx, tu), mix(lp.cy, bar.y + bar.h / 2 + bt * lp.hd, tu)
            scale: mix(1, max(dk.lf, 0.05), att)
        //  The three sliders, rows of one card, with no title: an icon, the slider, and how far it is. Brightness, then the microphone, then the volume (which also holds the mixer
        //  of every app that plays sound, under it, and the output list, from the chevron at its end). Every row has the same geometry: the icon at `pcx - 118`, the track from
        //  `pcx - 96` for 170, the number right-aligned at `pcx + 120`.

        //  ONE card for the three sliders: a veil under all of them (the rows below draw only their own things). It grows at its foot for the mixer.
        group {
            opacity: f6 * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f6) * 12 * cu
            let card_cy = ck + (bright_top + vp.h / 2) * cu
            //  Obsidian: the plate is a solid step lighter than the shell, with a small tight shadow under it, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: pcx, card_cy; size: 288 * cu, vp.h * cu; corner: pr } }
            box { at: pcx, card_cy; size: 288 * cu, vp.h * cu; corner: pr; color: ink; opacity: (veil) * (1 - obs) }
        }

        //  Brightness: a sun that opens its rays as the backlight climbs. Dimmed with no brightnessctl to move it; with no backlight at all the row is not there (`bri_cut`).
        group {
            opacity: f6 * brightness.present * mix(0.45, 1, bright_avail) * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f6) * 12 * cu
            let bcy = ck + (vol_top - 56 + 8 * dd_k) * cu
            //  Obsidian: the plate is a solid step lighter than the shell, with a small tight shadow under it, in place of the veil.
            let bsl.x0 = pcx - 96 * cu
            let bsl.w = 170 * cu
            let bsy = bcy
            let bth = (16 + 3 * bright_hit.hover) * cu
            PSun(pcx - 118 * cu, bsy, bright_hit.hover, bright_level, 0.7 + 0.3 * bright_hit.hover)
            PSlider(bsl.x0, bsy, bsl.w, bri_shown, bright_hit.hover, cu, bth, 0)
            zone box bright_hit { at: bsl.x0 + bsl.w / 2, bsy; size: bsl.w + 28 * cu, 34 * cu; cursor: pointer; active: brightness.present and bright_avail }
            on press bright_hit { bri_ui = clamp(((pointer.x - tx.pnl) - bsl.x0) / bsl.w, 0, 1); bri_lock: 1 ~1ms; emit setbright(clamp(((pointer.x - tx.pnl) - bsl.x0) / bsl.w, 0, 1)) }
            on drag bright_hit { bri_ui = clamp(((pointer.x - tx.pnl) - bsl.x0) / bsl.w, 0, 1); bri_lock: 1 ~1ms; emit setbright(clamp(((pointer.x - tx.pnl) - bsl.x0) / bsl.w, 0, 1)) }
            on release bright_hit { bri_lock: 0 ~1ms after 900ms }
            text number(bri_shown * 100, 0, "%") { at: floor(pcx + 120 * cu + 0.5), floor(bcy + 0.5); anchor: right center; size: 18.5; weight: 600; color: ink; family: "Space Grotesk"; show: brightness.present and bright_avail }
            text "No backlight" { at: floor(pcx + 128 * cu + 0.5), floor(bcy + 0.5); anchor: right center; size: 14; color: faint; family: "Space Grotesk"; show: not brightness.present }
            text "brightnessctl missing" { at: floor(pcx + 128 * cu + 0.5), floor(bcy + 0.5); anchor: right center; size: 12.5; color: faint; family: "Space Grotesk"; show: brightness.present and not bright_avail }
        }

        //  The microphone: the button that mutes it (red, with a slash, while it is muted) and a slider for how loud it listens.
        group {
            opacity: f6 * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f6) * 12 * cu
            let micy = ck + (vol_top - 16 + 4 * dd_k) * cu
            let msl.x0 = pcx - 96 * cu
            let msl.w = 170 * cu
            let mth = (16 + 3 * mic_sl.hover) * cu
            PSlider(msl.x0, micy, msl.w, mic_shown, mic_sl.hover, cu, mth, if(audio.input_muted, 1, 0))
            zone box mic_sl { at: msl.x0 + msl.w / 2, micy; size: msl.w + 28 * cu, 34 * cu; cursor: pointer }
            on press mic_sl { mic_ui = clamp(((pointer.x - tx.pnl) - msl.x0) / msl.w, 0, 1); mic_lock: 1 ~1ms; emit setmic(clamp(((pointer.x - tx.pnl) - msl.x0) / msl.w, 0, 1)) }
            on drag mic_sl { mic_ui = clamp(((pointer.x - tx.pnl) - msl.x0) / msl.w, 0, 1); mic_lock: 1 ~1ms; emit setmic(clamp(((pointer.x - tx.pnl) - msl.x0) / msl.w, 0, 1)) }
            on release mic_sl { mic_lock: 0 ~1ms after 900ms }
            //  The icon is the mute button, declared after the track's zone so it wins where they meet.
            PMic(pcx - 118 * cu, micy, mic_hit.hover, if(audio.input_muted, 1, 0), mic_hit.hover)
            zone box mic_hit { at: pcx - 118 * cu, micy; size: 28 * cu, 32 * cu; corner: 13 * cu; cursor: pointer }
            on press mic_hit { emit mic_toggle }
            text number(mic_shown * 100, 0, "%") { at: floor(pcx + 120 * cu + 0.5), floor(micy + 0.5); anchor: right center; size: 18.5; weight: 600; color: ink; family: "Space Grotesk"; show: not audio.input_muted }
            text "Muted" { at: floor(pcx + 120 * cu + 0.5), floor(micy + 0.5); anchor: right center; size: 18.5; weight: 600; color: faint; family: "Space Grotesk"; show: audio.input_muted }
        }

        //  The volume: the speaker (the mute button), the slider, how loud; a chevron at the end opens the list of outputs, and the dots under it the mixer.
        group {
            opacity: f5 * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f5) * 12 * cu
            let vol_cy = ck + (vol_top + 24) * cu
            //  The track runs from `sl.x0` for `sl.w`; the pointer is turned into a volume against those two numbers, so they are written once.
            let sl.x0 = pcx - 96 * cu
            let sl.w = 170 * cu
            let sy = vol_cy
            let th = (16 + 3 * vol_hit.hover) * cu          // the track thickens under the pointer
            PSlider(sl.x0, sy, sl.w, vol_shown, vol_hit.hover, cu, th, if(audio.muted, 1, 0))
            //  The zone that takes the click: the whole track and a little more each side, so it is easy to hit; on the press and all through a drag it turns where the pointer is into a volume.
            zone box vol_plate { at: pcx, ck + (vol_top + (vp.h + bri_cut - 82 + 8 * dd_k) / 2) * cu; size: 288 * cu, (vp.h + bri_cut - 82 + 8 * dd_k) * cu; corner: pr }
            on press right vol_plate { vm_open = not vm_open; dd_open = false }
            zone box vol_hit { at: sl.x0 + sl.w / 2, sy; size: sl.w + 16 * cu, 24 * cu; cursor: pointer }
            on press vol_hit { vol_ui = clamp(((pointer.x - tx.pnl) - sl.x0) / sl.w, 0, 1); vol_lock: 1 ~1ms; emit setvol(clamp(((pointer.x - tx.pnl) - sl.x0) / sl.w, 0, 1)) }
            on press right vol_hit { vm_open = not vm_open; dd_open = false }
            on drag vol_hit { vol_ui = clamp(((pointer.x - tx.pnl) - sl.x0) / sl.w, 0, 1); vol_lock: 1 ~1ms; emit setvol(clamp(((pointer.x - tx.pnl) - sl.x0) / sl.w, 0, 1)) }
            on release vol_hit { vol_lock: 0 ~1ms after 900ms }
            //  Three small dots at the foot of the plate say there is more under it: the mixer. They are a button too (right-clicking the plate does the same).
            repeat i in 0..3 {
                ellipse { at: pcx + (i - 1) * 6.5 * cu, vol_cy + (vp.h + bri_cut - 110.5 + 8 * dd_k) * cu; radius: 1.6 * cu; color: ink; opacity: (35% + 55% * mix_hit.hover) * (1 - clamp(vm * 1.6, 0, 1)) * clamp(mvis, 0, 1) }
            }
            //  While it is open the dots give way to an arrow pointing up: press it to fold the mixer away.
            path { at: pcx, vol_cy + (vp.h + bri_cut - 110.5 + 8 * dd_k) * cu; stroke: 1.6 * cu; color: mint; opacity: (55% + 40% * mix_hit.hover) * clamp(vm * 1.6 - 0.6, 0, 1) * clamp(mvis, 0, 1); move -4.5 * cu, 1.8 * cu; line 0, -1.8 * cu; line 4.5 * cu, 1.8 * cu }
            zone box mix_hit { at: pcx, vol_cy + (vp.h + bri_cut - 110.5 + 8 * dd_k) * cu; size: 40 * cu, 9 * cu; corner: 4.5 * cu; cursor: pointer; active: mixer.count > 0 or vm_open }
            on press mix_hit { vm_open = not vm_open; dd_open = false }
            on press right mix_hit { vm_open = not vm_open; dd_open = false }
            //  The speaker is a mute button. Declared after the track's zone, which reaches a little way under it, so the icon wins there.
            PSpk(pcx - 128 * cu, sy, max(vol_hit.hover, mute_hit.hover), 0.7 + 0.3 * mute_hit.hover, if(audio.muted, 0, 25% + 75% * clamp(volume_level * 12, 0, 1)), if(audio.muted, 0, 20% + 80% * clamp((volume_level - 0.35) * 4, 0, 1)), if(audio.muted, 1, 0))
            zone box mute_hit { at: pcx - 118 * cu, sy; size: 28 * cu, 32 * cu; cursor: pointer }
            on press mute_hit { emit mute }
            on press right mute_hit { vm_open = not vm_open; dd_open = false }
            text number(if(vol_lock > 0.5, vol_ui, audio.volume) * 100, 0, "%") { at: floor(pcx + 120 * cu + 0.5), floor(vol_cy + 0.5); anchor: right center; size: 18.5; weight: 600; color: ink; family: "Space Grotesk"; show: not audio.muted }
            text "Muted" { at: floor(pcx + 120 * cu + 0.5), floor(vol_cy + 0.5); anchor: right center; size: 18.5; weight: 600; color: faint; family: "Space Grotesk"; show: audio.muted }
            //  The chevron at the end of the row opens the list of outputs (which one is in use is marked there).
            path { at: pcx + 133 * cu, vol_cy; stroke: 1.5 * cu; color: ink; opacity: 55% + 40% * out_hit.hover; move -3.5 * cu, -2 * cu; line 0, 2 * cu; line 3.5 * cu, -2 * cu }
            zone box out_hit { at: pcx + 133 * cu, vol_cy; size: 20 * cu, 30 * cu; cursor: pointer }
            on press out_hit { toggle dd_open; vm_open = false }
            on press right out_hit { vm_open = not vm_open; dd_open = false }
        }

        //  The mixer: every app that is playing, each with a slider of its own, inside the volume card (which grows to hold
        //  them). Right-click the card, or press its dots, to open it.
        group {
            show: vm > 0.01
            opacity: f5 * clamp(1 - expand0, 0, 1) * clamp(vm, 0, 1) * (1 - clamp(dd * 2, 0, 1))
            let mix_top = ck + (vol_top + 42) * cu                   // under the slider, inside the card
            clip inset 0 box { at: pcx, mix_top + (mix.m - 12) * cu * clamp(vm, 0, 1) / 2; size: 288 * cu, (mix.m - 12) * cu * clamp(vm, 0, 1) }
            text "No app is playing sound" { at: floor(pcx + 0.5), floor(mix_top + 12 * cu + 0.5); anchor: center; align: center; size: 12.5; color: faint; family: "Space Grotesk"; show: mixer.count < 1 }
            column mixcol {
                at: floor(pcx - 144 * cu + 0.5), floor(mix_top + 0.5)
                view: 288 * cu, max(1, mixer.count * 32 - 4) * cu
                gap: floor(4 * cu + 0.5)
                for m in mixer { MixRow(m, set: mix_set, mute: mix_mute) }
            }
        }

        //  Wi-Fi and Bluetooth: two narrow tiles side by side, each just its
        //  name, a signal, and the toggle for its radio. Tapping the rest of
        //  the tile - the toggle has its own small zone, declared after so it
        //  wins there - grows it into its own window, below.
        group {
            opacity: f2 * clamp(1 - expand0, 0, 1)
            move: 0, (1 - f2) * 12 * cu
            let tile_cy = ck + (tiles_top + tiles_h / 2) * cu
            let tile2_cy = ck + (tiles2_top + tiles_h / 2) * cu
            let s1_cy = ck + (tiles_top + st_h / 2) * cu                 // the small tiles of the two right-hand columns: three to a column
            let s2_cy = ck + (tiles_top + st_h * 1.5 + st_gap) * cu
            let s3_cy = ck + (tiles_top + st_h * 2.5 + st_gap * 2) * cu
            //  Six tiles, three across and two down. Each one hangs its content from a `base` 21 right of its middle: tile 1's middle
            //  is 97 left of the drawer's, tile 3's 97 right of it.
            let tb1 = pcx - 76 * cu
            let tb2 = pcx + 21 * cu
            let tb3 = pcx + 118 * cu

            //  Obsidian: the plate is a solid step lighter than the shell, with a small tight shadow under it, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_p2, dd_k); opacity: obs; border: 3.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: tb1 - 21 * cu, tile_cy; size: 94 * cu, tiles_h * cu; corner: pr } }
            box { at: tb1 - 21 * cu, tile_cy; size: 94 * cu, tiles_h * cu; corner: pr; color: ink; opacity: (veil) * (1 - obs) }
            group { pivot: tb1 - 44 * cu, tile_cy - 17 * cu; scale: 1.2; PWifi(tb1 - 44 * cu, tile_cy - 17 * cu, max(if(on_wifi, 1, 0), wifi_tile_hit.hover), if(on_wifi, 45% + 55% * clamp(net.strength / 0.3, 0, 1), 30%) * (1 - wf_hold), if(on_wifi, 45% + 55% * clamp(net.strength / 0.65, 0, 1), 30%) * (1 - wf_hold), if(on_wifi, 45% + 55% * clamp(net.strength / 1.0, 0, 1), 30%) * (1 - wf_hold)) }
            text "Wi-Fi" { at: floor(tb1 - 58 * cu + 0.5), floor(tile_cy + 8 * cu + 0.5); anchor: left center; size: 15; color: ink; family: "Space Grotesk" }
            text "{net.name} · {round(net.strength * 100)}%" { at: floor(tb1 - 58 * cu + 0.5), floor(tile_cy + 26 * cu + 0.5); anchor: left center; size: 13; width: 80 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: on_wifi }
            text "Disconnected" { at: floor(tb1 - 58 * cu + 0.5), floor(tile_cy + 26 * cu + 0.5); anchor: left center; size: 13; color: faint; family: "Space Grotesk"; show: net.wifi and not (on_wifi) }
            text "Off" { at: floor(tb1 - 58 * cu + 0.5), floor(tile_cy + 26 * cu + 0.5); anchor: left center; size: 13; color: faint; family: "Space Grotesk"; show: not net.wifi }
            //  The Wi-Fi pill. Where things are: the track keeps its right edge and, held, grows to the left into a signal meter;
            //  `wf_m` is how much it is moving (0 at rest, 1 half way), which the ridges, the light and the squish ride on.
            let wf_m    = clamp(4 * wifi_on * (1 - wifi_on), 0, 1)
            let wf_w    = (34 + 4 * wifi_on + 26 * wf_hold) * cu
            let wf_cx   = tb1 + 18 * cu - wf_w / 2
            let wf_cy   = tile_cy - 17 * cu
            let wf_l    = wf_cx - wf_w / 2
            let wf_sg   = clamp(net.strength, 0.08, 1)
            let wf_t    = wifi_on * (1 - wf_hold + wf_hold * wf_sg)
            let wf_kx   = wf_l + 11 * cu + wf_t * (wf_w - 22 * cu)
            let wf_kw   = (17 + 9 * wf_m + 7 * wf_press) * cu
            let wf_kh   = (17 - 3 * wf_m - 2 * wf_press) * cu
            let wf_dk   = off

            //  Tile fills up: colour floods from the toggle, and drains back to it.
            group {
                clip inset 0 box { at: tb1 - 21 * cu, tile_cy; size: 94 * cu, tiles_h * cu; corner: pr }
                ellipse { at: tb1 + 5 * cu, wf_cy; radius: clamp(wf_fill, 0, 1.2) * 96 * cu; color: mint; opacity: 15% }
                //  Ripple from the touch: a thin ring that leaves the finger and fades.
                ellipse { at: wf_rx, wf_ry; radius: wf_rip * 70 * cu; stroke: 1.4 * cu; color: mint; opacity: (1 - wf_rip) * 55% }
            }

            //  The track. Off it is a dark hollow; on it is raised and lit from inside.
            body {
                color: mix(off, mint, clamp(wifi_on * (1 - wf_hold), 0, 1))
                shadow: 0, 0, 10 * cu * wifi_on, 48% * wifi_on, mint
                rim: 16% * wifi_on
                box { at: wf_cx, wf_cy; size: wf_w, 22 * cu; corner: (11 - 2 * wifi_on) * cu }
            }
            group {
                clip inset 0 box { at: wf_cx, wf_cy; size: wf_w, 22 * cu; corner: (11 - 2 * wifi_on) * cu }
                //  Held: the track shows the signal as a mint bar up to the knob.
                box { from: wf_l, wf_cy - 11 * cu; size: wf_kx - wf_l + 8 * cu, 22 * cu; color: mint; opacity: wf_hold * wifi_on }
                //  Off: the hollow's inner shadow (dark above, a faint lip below).
                box { from: wf_l - 6 * cu, wf_cy - 18 * cu; size: wf_w + 12 * cu, 9 * cu; color: #000000; opacity: (55% * (1 - wifi_on)) * 0.5 }
                box { from: wf_l - 6 * cu, (wf_cy - 18 * cu) + 3 * cu; size: wf_w + 12 * cu, 5 * cu; color: #000000; opacity: (55% * (1 - wifi_on)) * 0.45 }
                box { from: wf_l, wf_cy + 9.5 * cu; size: wf_w, 1.5 * cu; color: ink; opacity: 12% * (1 - wifi_on) }
                //  A light that travels with the knob and drains back into it.
                ellipse { at: wf_kx, wf_cy; radius: ((6 + 8 * wifi_on + 4 * wf_m) * cu) * 1.15; color: ink; opacity: (22% * wifi_on + 28% * wf_m) * 0.3 }
                ellipse { at: wf_kx, wf_cy; radius: ((6 + 8 * wifi_on + 4 * wf_m) * cu) * 0.85; color: ink; opacity: (22% * wifi_on + 28% * wf_m) * 0.35 }
                ellipse { at: wf_kx, wf_cy; radius: ((6 + 8 * wifi_on + 4 * wf_m) * cu) * 0.55; color: ink; opacity: (22% * wifi_on + 28% * wf_m) * 0.4 }
                //  Ridges that slide past as it moves, like a real switch.
                repeat i in 0..8 {
                    box { at: wf_l + (4.5 + 5 * i - (wifi_on - 0.5) * 9) * cu, wf_cy; size: 1.2 * cu, 9 * cu; corner: 0.6 * cu; color: ink; opacity: 24% * wf_m }
                }
            }

            //  The track in pencil, over the fill (hybrid: the knob stays the solid one).
            PSwitchTrack(wf_cx, wf_cy, wf_w, wf_kx, wifi_toggle_hit.hover, wifi_on, cu)

            //  The knob: a plain solid one, swelling under the finger, with a Wi-Fi mark on it that is solid with the radio on
            //  and an outline, crossed out, with it off.
            body {
                color: ink
                opacity: 1 - uwu_k
                shadow: 0, 2 * cu, 5 * cu, 26%
                box { at: wf_kx, wf_cy; size: wf_kw, wf_kh; corner: (8.5 - 2 * clamp(wifi_on, 0, 1) - 1.5 * wf_m) * cu }
            }
            CatPawKnob(wf_kx, wf_cy, wf_kw, cu)
            let wf_gy = wf_cy + 3.4 * cu
            PKnobBars(wf_kx, wf_cy, wifi_on, glyph_a, 1, clamp(net.strength / 0.5 + 0.35, 0, 1))
            line { from: wf_kx - 5 * cu, wf_cy - 5 * cu; to: wf_kx + 5 * cu, wf_cy + 5 * cu; width: 1.4 * cu; color: wf_dk; opacity: glyph_a * (0.8 * (1 - wifi_on)) }

            //  No Wi-Fi adapter (a desktop with only a cable): the tile is greyed out, says so, and does nothing.
            box { at: tb1 - 21 * cu, tile_cy; size: 94 * cu, tiles_h * cu; corner: pr; color: deep; opacity: 60% * (1 - wifi_hw_k) }
            text "No adapter" { at: floor(tb1 - 58 * cu + 0.5), floor(tile_cy + 26 * cu + 0.5); anchor: left center; size: 13; color: faint; opacity: 1 - wifi_hw_k; family: "Space Grotesk" }
            zone box wifi_tile_hit { at: tb1 - 21 * cu, tile_cy; size: 94 * cu, tiles_h * cu; cursor: pointer; active: wifi_hw }
            on press wifi_tile_hit { panel_sub = if(panel_sub == netview, none, netview) }
            zone box wifi_toggle_hit { at: wf_cx, wf_cy; size: wf_w + 8 * cu, 30 * cu; cursor: pointer; active: wifi_hw }
            //  Press: squish, ring from the finger. Hold: the pill becomes a signal meter. Release flips the radio unless it was a hold.
            on press wifi_toggle_hit { wf_press: 1; wf_rx = (pointer.x - tx.pnl); wf_ry = (pointer.y - ty.att); wf_rip: 0 ~0ms; wf_rip: 1 ~700ms after 40ms }
            on hold wifi_toggle_hit for 450ms { wf_held = true; wf_hold: 1 }
            on release wifi_toggle_hit while not wf_held { emit togglewifi(not net.wifi) }
            on release wifi_toggle_hit { wf_press: 0; wf_hold: 0; wf_held = false }

            //  Obsidian: the plate is a solid step lighter than the shell, with a small tight shadow under it, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_p3, dd_k); opacity: obs; border: 3.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: tb1 - 21 * cu, tile2_cy; size: 94 * cu, tiles_h * cu; corner: pr } }
            box { at: tb1 - 21 * cu, tile2_cy; size: 94 * cu, tiles_h * cu; corner: pr; color: ink; opacity: (veil) * (1 - obs) }
            group { pivot: tb1 - 44 * cu, tile2_cy - 17 * cu; scale: 1.2; PBt(tb1 - 44 * cu, tile2_cy - 17 * cu, max(bt_on, bt_tile_hit.hover), 0.45 + 0.55 * bt_on) }
            text "Bluetooth" { at: floor(tb1 - 58 * cu + 0.5), floor(tile2_cy + 8 * cu + 0.5); anchor: left center; size: 15; color: ink; family: "Space Grotesk" }
            text bt_name { at: floor(tb1 - 58 * cu + 0.5), floor(tile2_cy + 26 * cu + 0.5); anchor: left center; size: 13; width: 80 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: bt_connected }
            text "No device" { at: floor(tb1 - 58 * cu + 0.5), floor(tile2_cy + 26 * cu + 0.5); anchor: left center; size: 13; color: faint; family: "Space Grotesk"; show: bt.powered and not bt_connected }
            text "Off" { at: floor(tb1 - 58 * cu + 0.5), floor(tile2_cy + 26 * cu + 0.5); anchor: left center; size: 13; color: faint; family: "Space Grotesk"; show: not bt.powered }
            //  gbt: the pill, like the Wi-Fi one. `gbt_m` is how much it is moving (0 at rest, 1 half way).
            let gbt_m  = clamp(4 * bt_on * (1 - bt_on), 0, 1)
            let gbt_w  = (34 + 4 * bt_on) * cu
            let gbt_cx = tb1 + 18 * cu - gbt_w / 2
            let gbt_cy = tile2_cy - 17 * cu
            let gbt_l  = gbt_cx - gbt_w / 2
            let gbt_kx = gbt_l + 11 * cu + bt_on * (gbt_w - 22 * cu)
            let gbt_kw = (17 + 9 * gbt_m + 7 * bt_press) * cu
            let gbt_kh = (17 - 3 * gbt_m - 2 * bt_press) * cu
            let gbt_dk = off

            //  Tile fills up from the toggle, and a thin ring leaves the touch.
            group {
                clip inset 0 box { at: tb1 - 21 * cu, tile2_cy; size: 94 * cu, tiles_h * cu; corner: pr }
                ellipse { at: tb1 + 5 * cu, gbt_cy; radius: clamp(bt_fill, 0, 1.2) * 96 * cu; color: mint; opacity: 15% }
                ellipse { at: bt_rx, bt_ry; radius: bt_rip * 70 * cu; stroke: 1.4 * cu; color: mint; opacity: (1 - bt_rip) * 55% }
            }

            //  The track: a dark hollow off, raised and lit from inside on.
            body {
                color: mix(off, mint, clamp(bt_on, 0, 1))
                shadow: 0, 0, 10 * cu * bt_on, 48% * bt_on, mint
                rim: 16% * bt_on
                box { at: gbt_cx, gbt_cy; size: gbt_w, 22 * cu; corner: (11 - 2 * bt_on) * cu }
            }
            group {
                clip inset 0 box { at: gbt_cx, gbt_cy; size: gbt_w, 22 * cu; corner: (11 - 2 * bt_on) * cu }
                box { from: gbt_l - 6 * cu, gbt_cy - 18 * cu; size: gbt_w + 12 * cu, 9 * cu; color: #000000; opacity: (55% * (1 - bt_on)) * 0.5 }
                box { from: gbt_l - 6 * cu, (gbt_cy - 18 * cu) + 3 * cu; size: gbt_w + 12 * cu, 5 * cu; color: #000000; opacity: (55% * (1 - bt_on)) * 0.45 }
                box { from: gbt_l, gbt_cy + 9.5 * cu; size: gbt_w, 1.5 * cu; color: ink; opacity: 12% * (1 - bt_on) }
                ellipse { at: gbt_kx, gbt_cy; radius: ((6 + 8 * bt_on + 4 * gbt_m) * cu) * 1.15; color: ink; opacity: (22% * bt_on + 28% * gbt_m) * 0.3 }
                ellipse { at: gbt_kx, gbt_cy; radius: ((6 + 8 * bt_on + 4 * gbt_m) * cu) * 0.85; color: ink; opacity: (22% * bt_on + 28% * gbt_m) * 0.35 }
                ellipse { at: gbt_kx, gbt_cy; radius: ((6 + 8 * bt_on + 4 * gbt_m) * cu) * 0.55; color: ink; opacity: (22% * bt_on + 28% * gbt_m) * 0.4 }
                repeat i in 0..8 {
                    box { at: gbt_l + (4.5 + 5 * i - (bt_on - 0.5) * 9) * cu, gbt_cy; size: 1.2 * cu, 9 * cu; corner: 0.6 * cu; color: ink; opacity: 24% * gbt_m }
                }
            }

            PSwitchTrack(gbt_cx, gbt_cy, gbt_w, gbt_kx, bt_toggle_hit.hover, bt_on, cu)

            //  The knob: plain, solid, squared a little when on, swelling under the finger, with a mark on it.
            body {
                color: ink
                opacity: 1 - uwu_k
                shadow: 0, 2 * cu, 5 * cu, 26%
                box { at: gbt_kx, gbt_cy; size: gbt_kw, gbt_kh; corner: (8.5 - 2 * clamp(bt_on, 0, 1) - 1.5 * gbt_m) * cu }
            }
            CatPawKnob(gbt_kx, gbt_cy, gbt_kw, cu)
            path { at: gbt_kx, gbt_cy; stroke: 1.3 * cu; color: gbt_dk; opacity: glyph_a * (bt_on); move -3.5 * cu, -3 * cu; line 3.5 * cu, 3 * cu; line 0, 5.5 * cu; line 0, -5.5 * cu; line 3.5 * cu, -3 * cu; line -3.5 * cu, 3 * cu }
            path { at: gbt_kx, gbt_cy; stroke: 1.1 * cu; color: gbt_dk; opacity: glyph_a * (0.7 * (1 - bt_on)); move -3.5 * cu, -3 * cu; line 3.5 * cu, 3 * cu; line 0, 5.5 * cu; line 0, -5.5 * cu; line 3.5 * cu, -3 * cu; line -3.5 * cu, 3 * cu }
            line { from: gbt_kx - 5 * cu, gbt_cy - 5 * cu; to: gbt_kx + 5 * cu, gbt_cy + 5 * cu; width: 1.4 * cu; color: gbt_dk; opacity: glyph_a * (0.8 * (1 - bt_on)) }
            zone box bt_tile_hit { at: tb1 - 21 * cu, tile2_cy; size: 94 * cu, tiles_h * cu; cursor: pointer }
            on press bt_tile_hit { panel_sub = if(panel_sub == btview, none, btview) }
            zone box bt_toggle_hit { at: tb1 - 1 * cu, tile2_cy - 17 * cu; size: 46 * cu, 30 * cu; cursor: pointer }
            on press bt_toggle_hit { emit togglebt(not bt.powered) }
            on press bt_toggle_hit { bt_press: 1; bt_rx = (pointer.x - tx.pnl); bt_ry = (pointer.y - ty.att); bt_rip: 0 ~0ms; bt_rip: 1 ~700ms after 40ms }
            on release bt_toggle_hit { bt_press: 0 }

            //  Notifications (Do Not Disturb, with its own window) and Caffeine (the whole tile is its toggle), underneath.

            //  Obsidian: the plate is a solid step lighter than the shell, with a small tight shadow under it, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil + 6% * dnd_hit.hover) * 1.6), dd_p4, dd_k); opacity: obs; border: 3.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: tb2 - 21 * cu, s2_cy; size: 94 * cu, st_h * cu; corner: pr } }
            box { at: tb2 - 21 * cu, s2_cy; size: 94 * cu, st_h * cu; corner: pr; color: ink; opacity: (veil + 6% * dnd_hit.hover) * (1 - obs) }
            //  A bell: dome, rim and clapper, struck through while it is on.
            PBell(tb2 - 48 * cu, s2_cy - 15 * cu, max(dnd_pill, dnd_hit.hover), 0.45 + 0.55 * dnd_pill, dnd_pill, dnd_wobble)
            text "Notifications" { at: floor(tb2 - 58 * cu + 0.5), floor(s2_cy + 7 * cu + 0.5); anchor: left center; size: 13; width: 74 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            text nt_tile_sub { at: floor(tb2 - 58 * cu + 0.5), floor(s2_cy + 20 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: if(dnd_on, mint, faint); family: "Space Grotesk" }
            //  gdn: the pill, like the Wi-Fi one. `gdn_m` is how much it is moving (0 at rest, 1 half way).
            let gdn_m  = clamp(4 * dnd_pill * (1 - dnd_pill), 0, 1)
            let gdn_w  = (34 + 4 * dnd_pill) * cu
            let gdn_cx = tb2 + 18 * cu - gdn_w / 2
            let gdn_cy = s2_cy - 15 * cu
            let gdn_l  = gdn_cx - gdn_w / 2
            let gdn_kx = gdn_l + 11 * cu + dnd_pill * (gdn_w - 22 * cu)
            let gdn_kw = (17 + 9 * gdn_m + 7 * dnd_press) * cu
            let gdn_kh = (17 - 3 * gdn_m - 2 * dnd_press) * cu
            let gdn_dk = off

            //  Tile fills up from the toggle, and a thin ring leaves the touch.
            group {
                clip inset 0 box { at: tb2 - 21 * cu, s2_cy; size: 94 * cu, st_h * cu; corner: pr }
                ellipse { at: tb2 + 5 * cu, gdn_cy; radius: clamp(dnd_fill, 0, 1.2) * 96 * cu; color: mint; opacity: 15% }
                ellipse { at: dnd_rx, dnd_ry; radius: dnd_rip * 70 * cu; stroke: 1.4 * cu; color: mint; opacity: (1 - dnd_rip) * 55% }
            }

            //  The track: a dark hollow off, raised and lit from inside on.
            body {
                color: mix(off, mint, clamp(dnd_pill, 0, 1))
                shadow: 0, 0, 10 * cu * dnd_pill, 48% * dnd_pill, mint
                rim: 16% * dnd_pill
                box { at: gdn_cx, gdn_cy; size: gdn_w, 22 * cu; corner: (11 - 2 * dnd_pill) * cu }
            }
            group {
                clip inset 0 box { at: gdn_cx, gdn_cy; size: gdn_w, 22 * cu; corner: (11 - 2 * dnd_pill) * cu }
                box { from: gdn_l - 6 * cu, gdn_cy - 18 * cu; size: gdn_w + 12 * cu, 9 * cu; color: #000000; opacity: (55% * (1 - dnd_pill)) * 0.5 }
                box { from: gdn_l - 6 * cu, (gdn_cy - 18 * cu) + 3 * cu; size: gdn_w + 12 * cu, 5 * cu; color: #000000; opacity: (55% * (1 - dnd_pill)) * 0.45 }
                box { from: gdn_l, gdn_cy + 9.5 * cu; size: gdn_w, 1.5 * cu; color: ink; opacity: 12% * (1 - dnd_pill) }
                ellipse { at: gdn_kx, gdn_cy; radius: ((6 + 8 * dnd_pill + 4 * gdn_m) * cu) * 1.15; color: ink; opacity: (22% * dnd_pill + 28% * gdn_m) * 0.3 }
                ellipse { at: gdn_kx, gdn_cy; radius: ((6 + 8 * dnd_pill + 4 * gdn_m) * cu) * 0.85; color: ink; opacity: (22% * dnd_pill + 28% * gdn_m) * 0.35 }
                ellipse { at: gdn_kx, gdn_cy; radius: ((6 + 8 * dnd_pill + 4 * gdn_m) * cu) * 0.55; color: ink; opacity: (22% * dnd_pill + 28% * gdn_m) * 0.4 }
                repeat i in 0..8 {
                    box { at: gdn_l + (4.5 + 5 * i - (dnd_pill - 0.5) * 9) * cu, gdn_cy; size: 1.2 * cu, 9 * cu; corner: 0.6 * cu; color: ink; opacity: 24% * gdn_m }
                }
            }

            PSwitchTrack(gdn_cx, gdn_cy, gdn_w, gdn_kx, dnd_toggle_hit.hover, dnd_pill, cu)

            //  The knob: plain, solid, squared a little when on, swelling under the finger, with a mark on it.
            body {
                color: ink
                opacity: 1 - uwu_k
                shadow: 0, 2 * cu, 5 * cu, 26%
                box { at: gdn_kx, gdn_cy; size: gdn_kw, gdn_kh; corner: (8.5 - 2 * clamp(dnd_pill, 0, 1) - 1.5 * gdn_m) * cu }
            }
            CatPawKnob(gdn_kx, gdn_cy, gdn_kw, cu)
            PKnobBell(gdn_kx, gdn_cy, dnd_pill, glyph_a)
            line { from: gdn_kx - 5.5 * cu, gdn_cy - 5.5 * cu; to: gdn_kx + 5.5 * cu, gdn_cy + 5.5 * cu; width: 1.5 * cu; color: gdn_dk; opacity: glyph_a * dnd_pill }
            zone box dnd_hit { at: tb2 - 21 * cu, s2_cy; size: 94 * cu, st_h * cu; cursor: pointer }
            on press dnd_hit { panel_sub = if(panel_sub == notifview, none, notifview) }
            zone box dnd_toggle_hit { at: tb2 - 1 * cu, s2_cy - 15 * cu; size: 46 * cu, 30 * cu; cursor: pointer }
            on press dnd_toggle_hit { emit togglednd }
            on press dnd_toggle_hit { dnd_press: 1; dnd_rx = (pointer.x - tx.pnl); dnd_ry = (pointer.y - ty.att); dnd_rip: 0 ~0ms; dnd_rip: 1 ~700ms after 40ms }
            on release dnd_toggle_hit { dnd_press: 0 }

            //  Caffeine: a cup that steams while the machine is being kept awake. Dimmed on a
            //  machine with no hypridle, which is what the card would be stopping.
            group {
                opacity: mix(0.45, 1, caf_avail)
                //  Obsidian: the plate is a solid step lighter than the shell, with a small tight shadow under it, in place of the veil.
                body { color: mix(mix(obsidian, ink, (veil + 6% * caf_hit.hover * caf_avail) * 1.6), dd_p0, dd_k); opacity: obs; border: 3.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: tb2 - 21 * cu, s1_cy; size: 94 * cu, st_h * cu; corner: pr } }
                box { at: tb2 - 21 * cu, s1_cy; size: 94 * cu, st_h * cu; corner: pr; color: ink; opacity: (veil + 6% * caf_hit.hover * caf_avail) * (1 - obs) }
                PCup(tb2 - 46 * cu, s1_cy - 14 * cu, max(caf_pill, caf_hit.hover), 0.45 + 0.55 * caf_pill)
                repeat i in 0..3 {
                    let sp = fract(time * 0.7 + i * 0.33)
                    box { at: tb2 - 52 * cu + i * 3.5 * cu, s1_cy - 21 * cu - sp * 6 * cu; size: 1.4 * cu, 5 * cu; corner: 0.7 * cu; color: ink; opacity: caf_pill * 55% * sin(sp * 180) }
                }
                text "Caffeine" { at: floor(tb2 - 58 * cu + 0.5), floor(s1_cy + 7 * cu + 0.5); anchor: left center; size: 13; color: ink; family: "Space Grotesk" }
                text "Awake" { at: floor(tb2 - 58 * cu + 0.5), floor(s1_cy + 20 * cu + 0.5); anchor: left center; size: 11.5; color: mint; opacity: 90%; family: "Space Grotesk"; show: caf_on and caf_len == 0 }
                text caf_tile_sub { at: floor(tb2 - 58 * cu + 0.5), floor(s1_cy + 20 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: caf_on and caf_len > 0 }
                text "Off" { at: floor(tb2 - 58 * cu + 0.5), floor(s1_cy + 20 * cu + 0.5); anchor: left center; size: 11.5; color: faint; family: "Space Grotesk"; show: not caf_on and caf_avail }
                text "No hypridle" { at: floor(tb2 - 58 * cu + 0.5), floor(s1_cy + 20 * cu + 0.5); anchor: left center; size: 11.5; color: faint; family: "Space Grotesk"; show: not caf_avail }
                //  gcf: the pill, like the Wi-Fi one. `gcf_m` is how much it is moving (0 at rest, 1 half way).
                let gcf_m  = clamp(4 * caf_pill * (1 - caf_pill), 0, 1)
                let gcf_w  = (34 + 4 * caf_pill) * cu
                let gcf_cx = tb2 + 18 * cu - gcf_w / 2
                let gcf_cy = s1_cy - 15 * cu
                let gcf_l  = gcf_cx - gcf_w / 2
                let gcf_kx = gcf_l + 11 * cu + caf_pill * (gcf_w - 22 * cu)
                let gcf_kw = (17 + 9 * gcf_m + 7 * caf_press) * cu
                let gcf_kh = (17 - 3 * gcf_m - 2 * caf_press) * cu
                let gcf_dk = off

                //  Tile fills up from the toggle, and a thin ring leaves the touch.
                group {
                    clip inset 0 box { at: tb2 - 21 * cu, s1_cy; size: 94 * cu, st_h * cu; corner: pr }
                    ellipse { at: tb2 + 5 * cu, gcf_cy; radius: clamp(caf_fill, 0, 1.2) * 96 * cu; color: mint; opacity: 15% }
                    ellipse { at: caf_rx, caf_ry; radius: caf_rip * 70 * cu; stroke: 1.4 * cu; color: mint; opacity: (1 - caf_rip) * 55% }
                }

                //  The track: a dark hollow off, raised and lit from inside on.
                body {
                    color: mix(off, mint, clamp(caf_pill, 0, 1))
                    shadow: 0, 0, 10 * cu * caf_pill, 48% * caf_pill, mint
                    rim: 16% * caf_pill
                    box { at: gcf_cx, gcf_cy; size: gcf_w, 22 * cu; corner: (11 - 2 * caf_pill) * cu }
                }
                group {
                    clip inset 0 box { at: gcf_cx, gcf_cy; size: gcf_w, 22 * cu; corner: (11 - 2 * caf_pill) * cu }
                    box { from: gcf_l - 6 * cu, gcf_cy - 18 * cu; size: gcf_w + 12 * cu, 9 * cu; color: #000000; opacity: (55% * (1 - caf_pill)) * 0.5 }
                    box { from: gcf_l - 6 * cu, (gcf_cy - 18 * cu) + 3 * cu; size: gcf_w + 12 * cu, 5 * cu; color: #000000; opacity: (55% * (1 - caf_pill)) * 0.45 }
                    box { from: gcf_l, gcf_cy + 9.5 * cu; size: gcf_w, 1.5 * cu; color: ink; opacity: 12% * (1 - caf_pill) }
                    ellipse { at: gcf_kx, gcf_cy; radius: ((6 + 8 * caf_pill + 4 * gcf_m) * cu) * 1.15; color: ink; opacity: (22% * caf_pill + 28% * gcf_m) * 0.3 }
                    ellipse { at: gcf_kx, gcf_cy; radius: ((6 + 8 * caf_pill + 4 * gcf_m) * cu) * 0.85; color: ink; opacity: (22% * caf_pill + 28% * gcf_m) * 0.35 }
                    ellipse { at: gcf_kx, gcf_cy; radius: ((6 + 8 * caf_pill + 4 * gcf_m) * cu) * 0.55; color: ink; opacity: (22% * caf_pill + 28% * gcf_m) * 0.4 }
                    repeat i in 0..8 {
                        box { at: gcf_l + (4.5 + 5 * i - (caf_pill - 0.5) * 9) * cu, gcf_cy; size: 1.2 * cu, 9 * cu; corner: 0.6 * cu; color: ink; opacity: 24% * gcf_m }
                    }
                }

                PSwitchTrack(gcf_cx, gcf_cy, gcf_w, gcf_kx, caf_toggle_hit.hover, caf_pill, cu)

                //  The knob: plain, solid, squared a little when on, swelling under the finger, with a mark on it.
                body {
                    color: ink
                    opacity: 1 - uwu_k
                    shadow: 0, 2 * cu, 5 * cu, 26%
                    box { at: gcf_kx, gcf_cy; size: gcf_kw, gcf_kh; corner: (8.5 - 2 * clamp(caf_pill, 0, 1) - 1.5 * gcf_m) * cu }
                }
                CatPawKnob(gcf_kx, gcf_cy, gcf_kw, cu)
                PKnobCup(gcf_kx, gcf_cy, caf_pill, glyph_a)
                zone box caf_hit { at: tb2 - 21 * cu, s1_cy; size: 94 * cu, st_h * cu; cursor: pointer; active: caf_avail }
                on press caf_hit { panel_sub = if(panel_sub == cafview, none, cafview) }
                zone box caf_toggle_hit { at: tb2 - 1 * cu, s1_cy - 15 * cu; size: 46 * cu, 30 * cu; cursor: pointer; active: caf_avail }
                on press caf_toggle_hit { emit togglecaf }
                on press caf_toggle_hit { caf_press: 1; caf_rx = (pointer.x - tx.pnl); caf_ry = (pointer.y - ty.att); caf_rip: 0 ~0ms; caf_rip: 1 ~700ms after 40ms }
                on release caf_toggle_hit { caf_press: 0 }
            }

            //  Capture and Power: a third row. Capture's button starts and stops a recording; the rest of the tile opens its window
            //  (screenshots, and a recording of the whole screen). Power has no switch: the whole tile opens its window.

            //  Obsidian: the plate is a solid step lighter than the shell, with a small tight shadow under it, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil + 6% * cap_hit.hover) * 1.6), dd_p1, dd_k); opacity: obs; border: 3.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: tb2 - 21 * cu, s3_cy; size: 94 * cu, st_h * cu; corner: pr } }
            box { at: tb2 - 21 * cu, s3_cy; size: 94 * cu, st_h * cu; corner: pr; color: ink; opacity: (veil + 6% * cap_hit.hover) * (1 - obs) }
            PCam(tb2 - 48 * cu, s3_cy - 14 * cu, max(rec_pill, cap_hit.hover), 0.45 + 0.55 * rec_pill)
            text "Capture" { at: floor(tb2 - 58 * cu + 0.5), floor(s3_cy + 7 * cu + 0.5); anchor: left center; size: 13; color: ink; family: "Space Grotesk" }
            text rec_time { at: floor(tb2 - 58 * cu + 0.5), floor(s3_cy + 20 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: rec_on }
            text "Shot · Record" { at: floor(tb2 - 58 * cu + 0.5), floor(s3_cy + 20 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: faint; family: "Space Grotesk"; show: not rec_on }
            //  The record button: a ring with a dot in it, which becomes a square (and beats) while it records.
            PRing(tb2 + 8 * cu, s3_cy - 15 * cu, max(rec_pill, cap_rec_hit.hover), 0.55 + 0.45 * rec_pill)
            box { at: tb2 + 8 * cu, s3_cy - 15 * cu; size: (10 - 2 * rec_pill) * cu, (10 - 2 * rec_pill) * cu; corner: (5 - 3 * rec_pill) * cu; color: mint; opacity: 65% + 35% * rec_pill - rec_pill * 0.25 * (0.5 + 0.5 * sin(time * 300)) }
            zone box cap_hit { at: tb2 - 21 * cu, s3_cy; size: 94 * cu, st_h * cu; cursor: pointer }
            on press cap_hit { panel_sub = if(panel_sub == capview, none, capview) }
            zone box cap_rec_hit { at: tb2 + 8 * cu, s3_cy - 15 * cu; size: 34 * cu, 30 * cu; corner: 15 * cu; cursor: pointer }
            on press cap_rec_hit { emit rec_toggle }

            //  Obsidian: the plate is a solid step lighter than the shell, with a small tight shadow under it, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil + 6% * pow_hit.hover) * 1.6), dd_p2, dd_k); opacity: obs; border: 3.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: tb3 - 21 * cu, s3_cy; size: 94 * cu, st_h * cu; corner: pr } }
            box { at: tb3 - 21 * cu, s3_cy; size: 94 * cu, st_h * cu; corner: pr; color: ink; opacity: (veil + 6% * pow_hit.hover) * (1 - obs) }
            //  A power symbol: a ring open at the top, and the bar through the gap.
            PPower(tb3 - 48 * cu, s3_cy - 14 * cu, pow_hit.hover, 0.75)
            text "Power" { at: floor(tb3 - 58 * cu + 0.5), floor(s3_cy + 7 * cu + 0.5); anchor: left center; size: 13; color: ink; family: "Space Grotesk" }
            text "Power saver" { at: floor(tb3 - 58 * cu + 0.5), floor(s3_cy + 20 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: pow_prof == 0 }
            text "Balanced" { at: floor(tb3 - 58 * cu + 0.5), floor(s3_cy + 20 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: pow_prof == 1 }
            text "Performance" { at: floor(tb3 - 58 * cu + 0.5), floor(s3_cy + 20 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; show: pow_prof == 2 }
            text "Lock · Sleep · Off" { at: floor(tb3 - 58 * cu + 0.5), floor(s3_cy + 20 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: faint; family: "Space Grotesk"; show: pow_prof < 0 }
            zone box pow_hit { at: tb3 - 21 * cu, s3_cy; size: 94 * cu, st_h * cu; cursor: pointer }
            on press pow_hit { panel_sub = if(panel_sub == powview, none, powview) }

            //  Night mode: the whole tile is its switch (there is no window of its own), the pill shows it.
            group {
                opacity: 1
                body { color: mix(mix(obsidian, ink, (veil + 6% * nm_hit.hover * 1) * 1.6), dd_p3, dd_k); opacity: obs; border: 3.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: tb3 - 21 * cu, s1_cy; size: 94 * cu, st_h * cu; corner: pr } }
                box { at: tb3 - 21 * cu, s1_cy; size: 94 * cu, st_h * cu; corner: pr; color: ink; opacity: (veil + 6% * nm_hit.hover * 1) * (1 - obs) }
                PMoon(tb3 - 46 * cu, s1_cy - 14 * cu, max(nm_pill, nm_hit.hover), 0.45 + 0.55 * nm_pill)
                text "Night mode" { at: floor(tb3 - 58 * cu + 0.5), floor(s1_cy + 7 * cu + 0.5); anchor: left center; size: 13; color: ink; family: "Space Grotesk" }
                text night_status { at: floor(tb3 - 58 * cu + 0.5), floor(s1_cy + 20 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: if(night_on, mint, faint); family: "Space Grotesk" }
                let gnm_m  = clamp(4 * nm_pill * (1 - nm_pill), 0, 1)
                let gnm_w  = (34 + 4 * nm_pill) * cu
                let gnm_cx = tb3 + 18 * cu - gnm_w / 2
                let gnm_cy = s1_cy - 15 * cu
                let gnm_l  = gnm_cx - gnm_w / 2
                let gnm_kx = gnm_l + 11 * cu + nm_pill * (gnm_w - 22 * cu)
                let gnm_kw = (17 + 9 * gnm_m + 7 * nm_press) * cu
                let gnm_kh = (17 - 3 * gnm_m - 2 * nm_press) * cu

                group {
                    clip inset 0 box { at: tb3 - 21 * cu, s1_cy; size: 94 * cu, st_h * cu; corner: pr }
                    ellipse { at: tb3 + 5 * cu, gnm_cy; radius: clamp(nm_fill, 0, 1.2) * 96 * cu; color: mint; opacity: 15% }
                    ellipse { at: nm_rx, nm_ry; radius: nm_rip * 70 * cu; stroke: 1.4 * cu; color: mint; opacity: (1 - nm_rip) * 55% }
                }
                body {
                    color: mix(off, mint, clamp(nm_pill, 0, 1))
                    shadow: 0, 0, 10 * cu * nm_pill, 48% * nm_pill, mint
                    rim: 16% * nm_pill
                    box { at: gnm_cx, gnm_cy; size: gnm_w, 22 * cu; corner: (11 - 2 * nm_pill) * cu }
                }
                group {
                    clip inset 0 box { at: gnm_cx, gnm_cy; size: gnm_w, 22 * cu; corner: (11 - 2 * nm_pill) * cu }
                    box { from: gnm_l - 6 * cu, gnm_cy - 18 * cu; size: gnm_w + 12 * cu, 9 * cu; color: #000000; opacity: (55% * (1 - nm_pill)) * 0.5 }
                    box { from: gnm_l - 6 * cu, (gnm_cy - 18 * cu) + 3 * cu; size: gnm_w + 12 * cu, 5 * cu; color: #000000; opacity: (55% * (1 - nm_pill)) * 0.45 }
                    box { from: gnm_l, gnm_cy + 9.5 * cu; size: gnm_w, 1.5 * cu; color: ink; opacity: 12% * (1 - nm_pill) }
                    ellipse { at: gnm_kx, gnm_cy; radius: ((6 + 8 * nm_pill + 4 * gnm_m) * cu) * 1.15; color: ink; opacity: (22% * nm_pill + 28% * gnm_m) * 0.3 }
                    ellipse { at: gnm_kx, gnm_cy; radius: ((6 + 8 * nm_pill + 4 * gnm_m) * cu) * 0.85; color: ink; opacity: (22% * nm_pill + 28% * gnm_m) * 0.35 }
                    ellipse { at: gnm_kx, gnm_cy; radius: ((6 + 8 * nm_pill + 4 * gnm_m) * cu) * 0.55; color: ink; opacity: (22% * nm_pill + 28% * gnm_m) * 0.4 }
                    repeat i in 0..8 {
                        box { at: gnm_l + (4.5 + 5 * i - (nm_pill - 0.5) * 9) * cu, gnm_cy; size: 1.2 * cu, 9 * cu; corner: 0.6 * cu; color: ink; opacity: 24% * gnm_m }
                    }
                }
                PSwitchTrack(gnm_cx, gnm_cy, gnm_w, gnm_kx, nm_toggle_hit.hover, nm_pill, cu)
                body {
                    color: ink
                    opacity: 1 - uwu_k
                    shadow: 0, 2 * cu, 5 * cu, 26%
                    box { at: gnm_kx, gnm_cy; size: gnm_kw, gnm_kh; corner: (8.5 - 2 * clamp(nm_pill, 0, 1) - 1.5 * gnm_m) * cu }
                }
                CatPawKnob(gnm_kx, gnm_cy, gnm_kw, cu)
                PKnobMoon(gnm_kx, gnm_cy, nm_pill, glyph_a)
                zone box nm_hit { at: tb3 - 21 * cu, s1_cy; size: 94 * cu, st_h * cu; cursor: pointer; active: 1 > 0.5 }
                on press nm_hit { emit night_toggle }
                zone box nm_toggle_hit { at: tb3 - 1 * cu, s1_cy - 15 * cu; size: 46 * cu, 30 * cu; cursor: pointer; active: 1 > 0.5 }
                on press nm_toggle_hit { emit night_toggle }
                on press nm_hit { nm_press: 1; nm_rx = (pointer.x - tx.pnl); nm_ry = (pointer.y - ty.att); nm_rip: 0 ~0ms; nm_rip: 1 ~700ms after 40ms }
                on release nm_hit { nm_press: 0 }
            }

            //  Game mode: the whole tile is its switch (there is no window of its own), the pill shows it.
            group {
                opacity: game_k
                body { color: mix(mix(obsidian, ink, (veil + 6% * gm_hit.hover * game_k) * 1.6), dd_p4, dd_k); opacity: obs; border: 3.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: tb3 - 21 * cu, s2_cy; size: 94 * cu, st_h * cu; corner: pr } }
                box { at: tb3 - 21 * cu, s2_cy; size: 94 * cu, st_h * cu; corner: pr; color: ink; opacity: (veil + 6% * gm_hit.hover * game_k) * (1 - obs) }
                PPad(tb3 - 46 * cu, s2_cy - 14 * cu, max(gm_pill, gm_hit.hover), 0.45 + 0.55 * gm_pill)
                text "Game mode" { at: floor(tb3 - 58 * cu + 0.5), floor(s2_cy + 7 * cu + 0.5); anchor: left center; size: 13; color: ink; family: "Space Grotesk" }
                text game_status { at: floor(tb3 - 58 * cu + 0.5), floor(s2_cy + 20 * cu + 0.5); anchor: left center; size: 11.5; width: 74 * cu; lines: 1; color: if(game_on, mint, faint); family: "Space Grotesk" }
                let ggm_m  = clamp(4 * gm_pill * (1 - gm_pill), 0, 1)
                let ggm_w  = (34 + 4 * gm_pill) * cu
                let ggm_cx = tb3 + 18 * cu - ggm_w / 2
                let ggm_cy = s2_cy - 15 * cu
                let ggm_l  = ggm_cx - ggm_w / 2
                let ggm_kx = ggm_l + 11 * cu + gm_pill * (ggm_w - 22 * cu)
                let ggm_kw = (17 + 9 * ggm_m + 7 * gm_press) * cu
                let ggm_kh = (17 - 3 * ggm_m - 2 * gm_press) * cu

                group {
                    clip inset 0 box { at: tb3 - 21 * cu, s2_cy; size: 94 * cu, st_h * cu; corner: pr }
                    ellipse { at: tb3 + 5 * cu, ggm_cy; radius: clamp(gm_fill, 0, 1.2) * 96 * cu; color: mint; opacity: 15% }
                    ellipse { at: gm_rx, gm_ry; radius: gm_rip * 70 * cu; stroke: 1.4 * cu; color: mint; opacity: (1 - gm_rip) * 55% }
                }
                body {
                    color: mix(off, mint, clamp(gm_pill, 0, 1))
                    shadow: 0, 0, 10 * cu * gm_pill, 48% * gm_pill, mint
                    rim: 16% * gm_pill
                    box { at: ggm_cx, ggm_cy; size: ggm_w, 22 * cu; corner: (11 - 2 * gm_pill) * cu }
                }
                group {
                    clip inset 0 box { at: ggm_cx, ggm_cy; size: ggm_w, 22 * cu; corner: (11 - 2 * gm_pill) * cu }
                    box { from: ggm_l - 6 * cu, ggm_cy - 18 * cu; size: ggm_w + 12 * cu, 9 * cu; color: #000000; opacity: (55% * (1 - gm_pill)) * 0.5 }
                    box { from: ggm_l - 6 * cu, (ggm_cy - 18 * cu) + 3 * cu; size: ggm_w + 12 * cu, 5 * cu; color: #000000; opacity: (55% * (1 - gm_pill)) * 0.45 }
                    box { from: ggm_l, ggm_cy + 9.5 * cu; size: ggm_w, 1.5 * cu; color: ink; opacity: 12% * (1 - gm_pill) }
                    ellipse { at: ggm_kx, ggm_cy; radius: ((6 + 8 * gm_pill + 4 * ggm_m) * cu) * 1.15; color: ink; opacity: (22% * gm_pill + 28% * ggm_m) * 0.3 }
                    ellipse { at: ggm_kx, ggm_cy; radius: ((6 + 8 * gm_pill + 4 * ggm_m) * cu) * 0.85; color: ink; opacity: (22% * gm_pill + 28% * ggm_m) * 0.35 }
                    ellipse { at: ggm_kx, ggm_cy; radius: ((6 + 8 * gm_pill + 4 * ggm_m) * cu) * 0.55; color: ink; opacity: (22% * gm_pill + 28% * ggm_m) * 0.4 }
                    repeat i in 0..8 {
                        box { at: ggm_l + (4.5 + 5 * i - (gm_pill - 0.5) * 9) * cu, ggm_cy; size: 1.2 * cu, 9 * cu; corner: 0.6 * cu; color: ink; opacity: 24% * ggm_m }
                    }
                }
                PSwitchTrack(ggm_cx, ggm_cy, ggm_w, ggm_kx, gm_toggle_hit.hover, gm_pill, cu)
                body {
                    color: ink
                    opacity: 1 - uwu_k
                    shadow: 0, 2 * cu, 5 * cu, 26%
                    box { at: ggm_kx, ggm_cy; size: ggm_kw, ggm_kh; corner: (8.5 - 2 * clamp(gm_pill, 0, 1) - 1.5 * ggm_m) * cu }
                }
                CatPawKnob(ggm_kx, ggm_cy, ggm_kw, cu)
                PKnobPad(ggm_kx, ggm_cy, gm_pill, glyph_a)
                zone box gm_hit { at: tb3 - 21 * cu, s2_cy; size: 94 * cu, st_h * cu; cursor: pointer; active: game_k > 0.5 }
                on press gm_hit { emit game_toggle }
                zone box gm_toggle_hit { at: tb3 - 1 * cu, s2_cy - 15 * cu; size: 46 * cu, 30 * cu; cursor: pointer; active: game_k > 0.5 }
                on press gm_toggle_hit { emit game_toggle }
                on press gm_hit { gm_press: 1; gm_rx = (pointer.x - tx.pnl); gm_ry = (pointer.y - ty.att); gm_rip: 0 ~0ms; gm_rip: 1 ~700ms after 40ms }
                on release gm_hit { gm_press: 0 }
            }
        }

        //  The Wi-Fi tile's own window: the networks in range, strongest first.
        //  A known or open one connects on a tap; a secured one not seen before
        //  asks for its password first.
        group {
            show: showing_sub == netview
            opacity: expand0
            let ex_top = ck + tiles_top * cu
            let ex_cy = ex_top + 22 * cu
            path { at: pcx - 124 * cu, ex_cy; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * wifi_back.hover; move 4 * cu, -6 * cu; line -4 * cu, 0; line 4 * cu, 6 * cu }
            on press wifi_back { panel_sub = none }
            text "WI-FI" { at: floor(pcx - 102 * cu + 0.5), floor(ex_cy + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            //  Enter in the password field of the open row joins like its button does.
            on submit wifi_pw while wifi_open_row >= 0 { emit wifi_join_go(wifi_open_row) }
            box { at: pcx, ex_top + 44 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }
            column wifi_list_col ~quick {
                at: floor(pcx - 138 * cu + 0.5), floor(ex_top + 54 * cu + 0.5)
                view: 276 * cu, list_view_h * cu
                gap: 5
                for n in wifi_nets { WifiRow(n, pick: wifi_pick, forget: wifi_forget, joingo: wifi_join_go) }
            }
            //  After the list, so they win where its rows have scrolled up under the header (a row's zone still takes the click there).
            zone box wifi_back { at: pcx - 124 * cu, ex_cy; size: 30 * cu, 30 * cu; cursor: pointer }
            ScanButton(pcx + 112 * cu, ex_cy, wifi_scanning, 0, wifi_scan, "Scan Wi-Fi")
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: pcx + 141 * cu, ex_top + 54 * cu + wifi_list_col.scroll / max(wifi_list_col.content, 1) * (list_view_h * cu); size: 3 * cu, (list_view_h * cu) * (list_view_h * cu) / max(wifi_list_col.content, list_view_h * cu); corner: 1.5 * cu; color: ink; opacity: if(wifi_list_col.content > (list_view_h * cu) + 1, 35%, 0%) }
            text "No networks in range" { at: floor(pcx + 0.5), floor(ex_top + 54 * cu + 15 * cu + 0.5); anchor: center; size: 14; color: faint; family: "Space Grotesk"; show: wifi_nets.count < 1 and not wifi_scanning }
            text "Scanning…" { at: floor(pcx + 0.5), floor(ex_top + 54 * cu + 15 * cu + 0.5); anchor: center; size: 14; color: mint; family: "Space Grotesk"; show: wifi_nets.count < 1 and wifi_scanning }
        }

        //  The Bluetooth tile's own window: paired and nearby devices, connected first.
        group {
            show: showing_sub == btview
            opacity: expand0
            let ex2_top = ck + tiles_top * cu
            let ex2_cy = ex2_top + 22 * cu
            path { at: pcx - 124 * cu, ex2_cy; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * bt_back.hover; move 4 * cu, -6 * cu; line -4 * cu, 0; line 4 * cu, 6 * cu }
            on press bt_back { panel_sub = none }
            text "BLUETOOTH" { at: floor(pcx - 102 * cu + 0.5), floor(ex2_cy + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            //  Enter in the name field of the open device renames it like its button does.
            on submit bt_rename while bt_open_row >= 0 { emit bt_rename_go }
            box { at: pcx, ex2_top + 44 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }
            //  This computer, as other devices see it, and the switch that lets them find it.
            text bt_adapter { at: floor(pcx - 134 * cu + 0.5), floor(ex2_top + 56 * cu + 0.5); anchor: left center; size: 13; weight: 600; width: 120 * cu; lines: 1; color: ink; family: "Space Grotesk"; show: bt.powered }
            text bt_adapter_addr { at: floor(pcx - 134 * cu + 0.5), floor(ex2_top + 71 * cu + 0.5); anchor: left center; size: 10.5; color: faint; family: "Space Grotesk"; show: bt.powered }
            text "Discoverable" { at: floor(pcx + 96 * cu + 0.5), floor(ex2_top + 63 * cu + 0.5); anchor: right center; align: right; size: 12; color: if(bt_discoverable, mint, faint); family: "Space Grotesk"; show: bt.powered }
            group {
                show: bt.powered
                SettingsSwitch(pcx + 134 * cu, ex2_top + 63 * cu, bt_disc_t, bt_disc_hit.pressed, bt_disc_hit.hover, mint)
            }
            box { at: pcx, ex2_top + 86 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }
            column bt_list_col ~quick {
                at: floor(pcx - 138 * cu + 0.5), floor(ex2_top + 94 * cu + 0.5)
                view: 276 * cu, list_view_h * cu
                gap: 5
                for d in bt_devices { BtRow(d, pick: bt_pick, forget: bt_forget) }
            }
            //  After the list, so they win where its rows have scrolled up under the header (a row's zone still takes the click there).
            zone box bt_back { at: pcx - 124 * cu, ex2_cy; size: 30 * cu, 30 * cu; cursor: pointer }
            ScanButton(pcx + 112 * cu, ex2_cy, bt_scanning, 1, bt_scan, "Scan Bluetooth")
            zone box bt_disc_hit { at: pcx + 70 * cu, ex2_top + 63 * cu; size: 130 * cu, 26 * cu; corner: 8 * cu; cursor: pointer; active: bt.powered; label: "Discoverable" }
            on press bt_disc_hit { emit bt_disc_toggle }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: pcx + 141 * cu, ex2_top + 94 * cu + bt_list_col.scroll / max(bt_list_col.content, 1) * (list_view_h * cu); size: 3 * cu, (list_view_h * cu) * (list_view_h * cu) / max(bt_list_col.content, list_view_h * cu); corner: 1.5 * cu; color: ink; opacity: if(bt_list_col.content > (list_view_h * cu) + 1, 35%, 0%) }
            text "No devices found" { at: floor(pcx + 0.5), floor(ex2_top + 94 * cu + 15 * cu + 0.5); anchor: center; size: 14; color: faint; family: "Space Grotesk"; show: bt_devices.count < 1 and not bt_scanning and bt.powered }
            text "Bluetooth is off" { at: floor(pcx + 0.5), floor(ex2_top + 94 * cu + 15 * cu + 0.5); anchor: center; size: 14; color: faint; family: "Space Grotesk"; show: not bt.powered }
            text "Scanning…" { at: floor(pcx + 0.5), floor(ex2_top + 94 * cu + 15 * cu + 0.5); anchor: center; size: 14; color: mint; family: "Space Grotesk"; show: bt_devices.count < 1 and bt_scanning }
        }

        //  The notifications window: Do Not Disturb (a toggle, and timer chips that count down), and under them
        //  the history of what came in, newest first. Clear empties it; a row's cross removes that one.
        group {
            show: showing_sub == notifview
            opacity: expand0
            let nx_top = ck + tiles_top * cu
            let nx_cy = nx_top + 22 * cu
            path { at: pcx - 124 * cu, nx_cy; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * nt_back.hover; move 4 * cu, -6 * cu; line -4 * cu, 0; line 4 * cu, 6 * cu }
            zone box nt_back { at: pcx - 124 * cu, nx_cy; size: 30 * cu, 30 * cu; cursor: pointer }
            on press nt_back { panel_sub = none }
            text "NOTIFICATIONS" { at: floor(pcx - 102 * cu + 0.5), floor(nx_cy + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            //  An envelope beside the title: sealed when there is nothing (or while Do Not Disturb is on), open with a letter coming up out of it
            //  and the count when there is history, and it hops when something comes in.
            PEnvelope(pcx + 0 * cu, nx_cy + 5.5 * cu * env_o - 3 * cu * env_pop, (0.8 + 0.12 * env_pop) * cu, env_o, 1, 55% + 45% * clamp(env_o + env_pop, 0, 1))
            ellipse { at: pcx + 13.5 * cu, nx_cy - 4 * cu; radius: 6.5 * cu; color: mint; opacity: if(nt_hist.count > 0 and not dnd_on, 100%, 0%) }
            text number(min(99, nt_hist.count), 0, "") { at: floor(pcx + 13.5 * cu + 0.5), floor(nx_cy - 4 * cu + 0.5); anchor: center; align: center; size: 9.5; weight: 700; width: 14 * cu; lines: 1; color: onmint; family: "Space Grotesk"; show: nt_hist.count > 0 and not dnd_on }
            //  Where it stands, beside the title: how long is left, or that it is on until turned off.
            text dnd_left { at: floor(pcx + 78 * cu + 0.5), floor(nx_cy + 0.5); anchor: right center; align: right; size: 11.5; width: 62 * cu; lines: 1; color: if(dnd_on, mint, faint); family: "Space Grotesk" }
            box { at: pcx + 112 * cu, nx_cy; size: 52 * cu, 24 * cu; corner: 12 * cu; color: ink; opacity: 8% + 10% * nt_clear_hit.hover }
            PPillOutline(pcx + 112 * cu, nx_cy, 52 * cu, 24 * cu, 12 * cu, nt_clear_hit.hover, clamp(3 * (8% + 10% * nt_clear_hit.hover), 0, 1), cu)
            text "Clear" { at: floor(pcx + 112 * cu + 0.5), floor(nx_cy + 0.5); anchor: center; size: 14; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box nt_clear_hit { at: pcx + 112 * cu, nx_cy; size: 54 * cu, 26 * cu; corner: 13 * cu; cursor: pointer }
            on press nt_clear_hit { emit nt_clear }
            box { at: pcx, nx_top + 44 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }

            //  Do Not Disturb, in one control: six stops, Off, then how long, then until turned off. The thumb sits on the one in use
            //  and glows when it is on (grey on Off), sliding and stretching like liquid to a new stop. Pressing the lit stop again,
            //  or Off, turns it off; a ring leaves the touch.
            let ns_y   = nx_top + 68 * cu
            let ns_str = clamp(abs(dnd_sel_t - dnd_sel), 0, 3)
            let ns_tx  = pcx + (dnd_sel - 2.5) * 44 * cu
            let ns_tw  = (38 + 11 * ns_str) * cu
            let ns_th  = (26 - 3 * clamp(ns_str, 0, 1) - 2 * dnd_press) * cu
            let ns_on  = clamp(dnd_pill, 0, 1)
            //  Obsidian: the plate is a solid step lighter than the shell, with a small tight shadow under it, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: pcx, ns_y; size: 264 * cu, 36 * cu; corner: 18 * cu } }
            box { at: pcx, ns_y; size: 264 * cu, 36 * cu; corner: 18 * cu; color: ink; opacity: (veil) * (1 - obs) }
            group {
                clip inset 0 box { at: pcx, ns_y; size: 264 * cu, 36 * cu; corner: 18 * cu }
                repeat i in 0..5 {
                    box { at: pcx + (i - 2) * 44 * cu, ns_y; size: 1 * cu, 10 * cu; corner: 0.5 * cu; color: ink; opacity: 12% }
                }
                ellipse { at: nt_rx, nt_ry; radius: nt_rip * 50 * cu; stroke: 1.4 * cu; color: mint; opacity: (1 - nt_rip) * 55% }
            }
            body {
                color: mix(ink, mint, ns_on)
                opacity: (16% + 84% * ns_on) * (1 - px_k)
                shadow: 0, 0, 10 * cu * ns_on, 48% * ns_on, mint
                rim: 16% * ns_on
                box { at: ns_tx, ns_y; size: ns_tw, ns_th; corner: 10 * cu }
            }
            //  The Proxy's thumb: a slanted slab a little taller than its track, as in the Desk.
            group {
                show: px_k > 0.01
                opacity: px_k * (16% + 84% * ns_on)
                let nsq.w = ns_tw + 10 * cu
                let nsq.h = 40 * cu
                let nsq.x = ns_tx - nsq.w / 2
                let nsq.y = ns_y - nsq.h / 2
                let nsq.sk = 9 * cu
                path { at: nsq.x + 2 * cu, nsq.y + 2 * cu; color: mix(ink, mint, ns_on); move nsq.sk, 0; line nsq.w - 4 * cu, 0; line nsq.w - 4 * cu - nsq.sk, nsq.h - 4 * cu; line 0, nsq.h - 4 * cu; close }
                path { at: nsq.x + 2 * cu, nsq.y + 2 * cu; stroke: 4 * cu; color: mix(ink, mint, ns_on); move nsq.sk, 0; line nsq.w - 4 * cu, 0; line nsq.w - 4 * cu - nsq.sk, nsq.h - 4 * cu; line 0, nsq.h - 4 * cu; line nsq.sk, 0 }
            }
            repeat i in 0..6 {
                let lx  = pcx + (i - 2.5) * 44 * cu
                let sel = clamp(1 - abs(dnd_sel - i), 0, 1) * ns_on
                text pick(i, "Off", "15m", "30m", "1h", "2h", "") { at: floor(lx + 0.5), floor(ns_y + 0.5); anchor: center; align: center; size: 12; weight: 600; color: mix(ink, off, sel); opacity: 62% + 38% * sel + 30% * dnd_chip.$i.hover; family: "Space Grotesk"; show: i < 5 }
                //  "Until turned off": an infinity mark.
                ellipse { at: lx - 3.4 * cu, ns_y; radius: 3.4 * cu; stroke: 1.5 * cu; color: mix(ink, off, sel); opacity: 62% + 38% * sel + 30% * dnd_chip.$i.hover; show: i == 5 }
                ellipse { at: lx + 3.4 * cu, ns_y; radius: 3.4 * cu; stroke: 1.5 * cu; color: mix(ink, off, sel); opacity: 62% + 38% * sel + 30% * dnd_chip.$i.hover; show: i == 5 }
                zone box dnd_chip.$i { at: lx, ns_y; size: 44 * cu, 36 * cu; cursor: pointer }
                on press dnd_chip.$i while i > 0 and i < 5 { emit dnd_for(pick(i, 0, 15, 30, 60, 120, 0)) }
                on press dnd_chip.$i while i == 0 and dnd_on { emit togglednd }
                on press dnd_chip.$i while i == 5 and not dnd_on { emit togglednd }
                on press dnd_chip.$i while i == 5 and dnd_on and dnd_len == 0 { emit togglednd }
                on press dnd_chip.$i while i == 5 and dnd_on and dnd_len > 0 { emit togglednd; emit togglednd }
                on press dnd_chip.$i { dnd_press: 1; nt_rx = (pointer.x - tx.pnl); nt_ry = (pointer.y - ty.att); nt_rip: 0 ~0ms; nt_rip: 1 ~700ms after 40ms }
                on release dnd_chip.$i { dnd_press: 0 }
            }

            //  The history.
            text "HISTORY" { at: floor(pcx - 134 * cu + 0.5), floor(nx_top + 102 * cu + 0.5); anchor: left center; size: 10.5; weight: 700; color: faint; opacity: 80%; family: "Space Grotesk" }
            column nt_hist_col {
                at: floor(pcx - 138 * cu + 0.5), floor(nx_top + 114 * cu + 0.5)
                view: 276 * cu, list_view_h * cu
                gap: 6
                for h in nt_hist { NtHistRow(h, del: nt_hist_del) }
            }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: pcx + 141 * cu, nx_top + 114 * cu + nt_hist_col.scroll / max(nt_hist_col.content, 1) * (list_view_h * cu); size: 3 * cu, (list_view_h * cu) * (list_view_h * cu) / max(nt_hist_col.content, list_view_h * cu); corner: 1.5 * cu; color: ink; opacity: if(nt_hist_col.content > (list_view_h * cu) + 1, 35%, 0%) }
            //  The main envelope, while there is nothing in the history: open and empty, bobbing over a soft glow ("All clear"), and while Do Not Disturb is on
            //  sealed, with three sleepers drifting up, and the glow turned mint ("Silenced"). It moves between the two the way the switch does.
            group {
                show: nt_hist.count < 1
                let en_y = nx_top + 196 * cu + 1.5 * cu * sin(time * 100)
                let en_on = clamp(dnd_pill, 0, 1)   // Do Not Disturb, as a spring
                ellipse { at: pcx, en_y; radius: (34 * cu) * 1.3; color: mint; opacity: (10% + 5% * (0.5 + 0.5 * sin(time * 100)) + en_on * 14%) * 0.28 }
                ellipse { at: pcx, en_y; radius: (34 * cu) * 0.95; color: mint; opacity: (10% + 5% * (0.5 + 0.5 * sin(time * 100)) + en_on * 14%) * 0.34 }
                ellipse { at: pcx, en_y; radius: (34 * cu) * 0.62; color: mint; opacity: (10% + 5% * (0.5 + 0.5 * sin(time * 100)) + en_on * 14%) * 0.4 }
                PEnvelope(pcx, en_y, 2.4 * cu, 1 - en_on, 0, 100%)
                let ne0 = fract(time * 0.38)
                let ne1 = fract(time * 0.38 + 0.33)
                let ne2 = fract(time * 0.38 + 0.66)
                text "z" { at: pcx + (30 + ne0 * 10) * cu, en_y - (14 + ne0 * 34) * cu; anchor: center; size: 11; weight: 700; color: mint; opacity: en_on * 85% * sin(ne0 * 180) }
                text "z" { at: pcx + (30 + ne1 * 10) * cu, en_y - (14 + ne1 * 34) * cu; anchor: center; size: 14; weight: 700; color: mint; opacity: en_on * 85% * sin(ne1 * 180) }
                text "z" { at: pcx + (30 + ne2 * 10) * cu, en_y - (14 + ne2 * 34) * cu; anchor: center; size: 17; weight: 700; color: mint; opacity: en_on * 85% * sin(ne2 * 180) }
                text "All clear" { at: floor(pcx + 0.5), floor(nx_top + 240 * cu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: faint; opacity: 1 - en_on; family: "Space Grotesk" }
                text "Silenced" { at: floor(pcx + 0.5), floor(nx_top + 240 * cu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: mint; opacity: en_on; family: "Space Grotesk" }
            }
        }

        //  The Caffeine window: the keep-awake switch and what state it is in, and timer chips. A chip keeps the
        //  machine awake for that long and then lets it sleep again; the lit one, pressed again, turns it off.
        group {
            show: showing_sub == cafview
            opacity: expand0
            let kx_top = ck + tiles_top * cu
            let kx_cy = kx_top + 22 * cu
            path { at: pcx - 124 * cu, kx_cy; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * caf_back.hover; move 4 * cu, -6 * cu; line -4 * cu, 0; line 4 * cu, 6 * cu }
            zone box caf_back { at: pcx - 124 * cu, kx_cy; size: 30 * cu, 30 * cu; cursor: pointer }
            on press caf_back { panel_sub = none }
            text "CAFFEINE" { at: floor(pcx - 102 * cu + 0.5), floor(kx_cy + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: pcx, kx_top + 44 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }

            //  The hero: a cup that steams inside a ring. The ring is the timer: what is left of it, with a bright head, or a full one that
            //  breathes when Caffeine is on until turned off. The time left (or On, or Off) is beside it in big words.
            let cf_x = pcx - 66 * cu
            let cf_y = kx_top + 128 * cu
            let cf_r = 44 * cu
            let cf_p = 0.5 + 0.5 * sin(time * 130)                // a slow breath
            group {
                opacity: mix(0.45, 1, caf_avail)
                ellipse { at: cf_x, cf_y; radius: ((36 + 6 * cf_p) * cu) * 1.3; color: mint; opacity: (caf_pill * (22% + 12% * cf_p)) * 0.28 }
                ellipse { at: cf_x, cf_y; radius: ((36 + 6 * cf_p) * cu) * 0.95; color: mint; opacity: (caf_pill * (22% + 12% * cf_p)) * 0.34 }
                ellipse { at: cf_x, cf_y; radius: ((36 + 6 * cf_p) * cu) * 0.62; color: mint; opacity: (caf_pill * (22% + 12% * cf_p)) * 0.4 }
                ellipse { at: cf_x, cf_y; radius: cf_r; stroke: 5 * cu; color: ink; opacity: 10% }
                let cf_s = if(caf_len > 0, max(0.004, caf_fr), 1)
                arc { at: cf_x, cf_y; radius: cf_r; span: cf_s * 360deg; width: 11 * cu; rotate: cf_s * 180deg; color: mint; opacity: 0.22 * caf_pill * if(caf_len > 0, 100%, 55% + 35% * cf_p) }
                arc { at: cf_x, cf_y; radius: cf_r; span: cf_s * 360deg; width: 5 * cu; rotate: cf_s * 180deg; color: mint; opacity: caf_pill * if(caf_len > 0, 100%, 55% + 35% * cf_p) }
                //  The cup, in pencil: the tile's mug (PCup) drawn bigger, and always boiling (the page is open, so the clock runs).
                group {
                    opacity: 55% + 45% * caf_pill
                    PCupK(cf_x - 1.2 * cu, cf_y - 5 * cu, 1, 1, 2.1 * cu, 0.95 * cu)
                }
                group {
                    particles steam {
                        at: cf_x - 1.5 * cu, cf_y - 25 * cu; count: 24
                        life: 1.8s .. 3.2s; speed: 9 .. 20
                        direction: -90deg; spread: 16deg; gravity: 0, -4
                        size: 5, 15; colors: ink; opacity: 70%, 0%
                        shape: dot; emit: caf_on
                    }
                }
                text caf_big { at: floor(pcx + 58 * cu + 0.5), floor(cf_y - 10 * cu + 0.5); anchor: center; align: center; size: 36; weight: 700; width: 130 * cu; lines: 1; color: mix(faint, mint, caf_pill); family: "Space Grotesk" }
                text caf_small { at: floor(pcx + 58 * cu + 0.5), floor(cf_y + 20 * cu + 0.5); anchor: center; align: center; size: 12.5; width: 112 * cu; lines: 2; color: faint; family: "Space Grotesk" }
            }


            group {
                opacity: mix(0.45, 1, caf_avail)
                //  One control for all of it: seven stops, Off and then how long. The thumb sits on the one in use and glows when
                //  Caffeine is on (grey on Off); it slides to a new stop, stretching like liquid on the way. The label under it turns
                //  dark. Pressing the lit stop again, or Off, turns it off; a ring leaves the touch.
                let cs_y   = kx_top + 226 * cu
                let cs_str = clamp(abs(caf_sel_t - caf_sel), 0, 3)
                let cs_tx  = pcx + (caf_sel - 3) * 38 * cu
                let cs_tw  = (34 + 11 * cs_str) * cu
                let cs_th  = (26 - 3 * clamp(cs_str, 0, 1) - 2 * caf_press) * cu
                let cs_on  = clamp(caf_pill, 0, 1)
                //  Obsidian: the plate is a solid step lighter than the shell, with a small tight shadow under it, in place of the veil.
                body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: pcx, cs_y; size: 266 * cu, 36 * cu; corner: 18 * cu } }
                box { at: pcx, cs_y; size: 266 * cu, 36 * cu; corner: 18 * cu; color: ink; opacity: (veil) * (1 - obs) }
                group {
                    clip inset 0 box { at: pcx, cs_y; size: 266 * cu, 36 * cu; corner: 18 * cu }
                    repeat i in 0..6 {
                        box { at: pcx + (i - 2.5) * 38 * cu, cs_y; size: 1 * cu, 10 * cu; corner: 0.5 * cu; color: ink; opacity: 12% }
                    }
                    ellipse { at: cs_rx, cs_ry; radius: cs_rip * 50 * cu; stroke: 1.4 * cu; color: mint; opacity: (1 - cs_rip) * 55% }
                }
                body {
                    color: mix(ink, mint, cs_on)
                    opacity: (16% + 84% * cs_on) * (1 - px_k)
                    shadow: 0, 0, 10 * cu * cs_on, 48% * cs_on, mint
                    rim: 16% * cs_on
                    box { at: cs_tx, cs_y; size: cs_tw, cs_th; corner: 10 * cu }
                }
                //  The Proxy's thumb: a slanted slab a little taller than its track, as in the Desk.
                group {
                    show: px_k > 0.01
                    opacity: px_k * (16% + 84% * cs_on)
                    let csq.w = cs_tw + 10 * cu
                    let csq.h = 40 * cu
                    let csq.x = cs_tx - csq.w / 2
                    let csq.y = cs_y - csq.h / 2
                    let csq.sk = 9 * cu
                    path { at: csq.x + 2 * cu, csq.y + 2 * cu; color: mix(ink, mint, cs_on); move csq.sk, 0; line csq.w - 4 * cu, 0; line csq.w - 4 * cu - csq.sk, csq.h - 4 * cu; line 0, csq.h - 4 * cu; close }
                    path { at: csq.x + 2 * cu, csq.y + 2 * cu; stroke: 4 * cu; color: mix(ink, mint, cs_on); move csq.sk, 0; line csq.w - 4 * cu, 0; line csq.w - 4 * cu - csq.sk, csq.h - 4 * cu; line 0, csq.h - 4 * cu; line csq.sk, 0 }
                }
                repeat i in 0..7 {
                    let lx  = pcx + (i - 3) * 38 * cu
                    let sel = clamp(1 - abs(caf_sel - i), 0, 1) * cs_on
                    text pick(i, "Off", "15m", "30m", "1h", "2h", "4h", "") { at: floor(lx + 0.5), floor(cs_y + 0.5); anchor: center; align: center; size: 12; weight: 600; color: mix(ink, off, sel); opacity: 62% + 38% * sel + 30% * caf_chip.$i.hover; family: "Space Grotesk"; show: i < 6 }
                    //  "Until off": an infinity mark.
                    ellipse { at: lx - 3.4 * cu, cs_y; radius: 3.4 * cu; stroke: 1.5 * cu; color: mix(ink, off, sel); opacity: 62% + 38% * sel + 30% * caf_chip.$i.hover; show: i == 6 }
                    ellipse { at: lx + 3.4 * cu, cs_y; radius: 3.4 * cu; stroke: 1.5 * cu; color: mix(ink, off, sel); opacity: 62% + 38% * sel + 30% * caf_chip.$i.hover; show: i == 6 }
                    zone box caf_chip.$i { at: lx, cs_y; size: 38 * cu, 36 * cu; cursor: pointer; active: caf_avail }
                    on press caf_chip.$i while i > 0 { emit caf_for(pick(i, 0, 15, 30, 60, 120, 240, 0)) }
                    on press caf_chip.$i while i == 0 and caf_on { emit togglecaf }
                    on press caf_chip.$i { caf_press: 1; cs_rx = (pointer.x - tx.pnl); cs_ry = (pointer.y - ty.att); cs_rip: 0 ~0ms; cs_rip: 1 ~700ms after 40ms }
                    on release caf_chip.$i { caf_press: 0 }
                }
            }
        }

        //  The Capture window: a screenshot of a region or of the whole screen (kept in ~/Pictures/Screenshots and copied), and
        //  a screen recording (kept in ~/Videos), with a Stop while one is running. Big tiles with an icon each.
        group {
            show: showing_sub == capview
            opacity: expand0
            let qx_top = ck + tiles_top * cu
            let qx_cy = qx_top + 22 * cu
            path { at: pcx - 124 * cu, qx_cy; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * qx_back.hover; move 4 * cu, -6 * cu; line -4 * cu, 0; line 4 * cu, 6 * cu }
            zone box qx_back { at: pcx - 124 * cu, qx_cy; size: 30 * cu, 30 * cu; cursor: pointer }
            on press qx_back { panel_sub = none }
            text "CAPTURE" { at: floor(pcx - 102 * cu + 0.5), floor(qx_cy + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: pcx, qx_top + 44 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }
            //  the hairline between the picture options and the video ones
            box { at: pcx, qx_top + 126 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }
            text "SCREENSHOT" { at: floor(pcx - 138 * cu + 0.5), floor(qx_top + 62 * cu + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
            row cap_shots {
                at: floor(pcx - 138 * cu + 0.5), floor(qx_top + 66 * cu + 0.5)
                gap: 8 * cu
                CapBtn("Region", "Draw, then save", 0, 0, shot, 0)
                CapBtn("Full screen", "Saved and copied", 1, 0, shot, 1)
            }
            text "SCREEN RECORDING" { at: floor(pcx - 138 * cu + 0.5), floor(qx_top + 134 * cu + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
            text rec_time { at: floor(pcx + 138 * cu + 0.5), floor(qx_top + 134 * cu + 0.5); anchor: right center; size: 12; weight: 600; color: mint; family: "Space Grotesk"; show: rec_on }
            group {
                show: not rec_on
                row cap_recs {
                    at: floor(pcx - 138 * cu + 0.5), floor(qx_top + 138 * cu + 0.5)
                    gap: 8 * cu
                    CapBtn("Region", "Saved to Videos", 0, 1, rec_start, 0)
                    CapBtn("Full screen", "Saved to Videos", 1, 1, rec_start, 1)
                }
            }
            group {
                show: rec_on
                box { at: pcx, qx_top + 164 * cu; size: 276 * cu, 52 * cu; corner: pr; color: mint; opacity: 14% + 8% * cap_stop.hover }
                ellipse { at: pcx - 104 * cu, qx_top + 164 * cu; radius: (9 + 2 * sin(time * 300)) * cu; color: mint; opacity: 30% }
                box { at: pcx - 104 * cu, qx_top + 164 * cu; size: 11 * cu, 11 * cu; corner: 2.5 * cu; color: mint }
                text "Stop recording" { at: floor(pcx - 80 * cu + 0.5), floor(qx_top + 164 * cu + 0.5); anchor: left center; size: 14.5; weight: 700; width: 150 * cu; lines: 1; color: mint; family: "Space Grotesk" }
                text rec_time { at: floor(pcx + 128 * cu + 0.5), floor(qx_top + 164 * cu + 0.5); anchor: right center; size: 14; weight: 600; color: mint; family: "Space Grotesk" }
                zone box cap_stop { at: pcx, qx_top + 164 * cu; size: 278 * cu, 54 * cu; corner: 15 * cu; cursor: pointer }
                on press cap_stop { emit rec_stop }
            }
            //  The newest screenshots, four small pictures: a press opens one, and one can be dragged out onto another program.
            group {
                show: capr_n > 0
                let rb = qx_top + if(rec_on, 200, 244) * cu
                box { at: pcx, rb; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }
                text "RECENT" { at: floor(pcx - 138 * cu + 0.5), floor(rb + 14 * cu + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
                repeat k in 0..4 {
                    let tcx = pcx - 106.5 * cu + 71 * k * cu
                    let tcy = rb + 40 * cu
                    group {
                        show: capr.$k.has
                        box { at: tcx, tcy; size: 63 * cu, 40 * cu; corner: 8 * cu; color: ink; opacity: 8% + 8% * capr_z.$k.hover }
                        group { show: capr.$k.thumbed; clip inset 0 box { at: tcx, tcy; size: 63 * cu, 40 * cu; corner: 8 * cu }; image capr.$k.im { at: tcx - 31.5 * cu, tcy - 20 * cu; size: 63 * cu, 40 * cu } }
                        box { at: tcx, tcy; size: 63 * cu, 40 * cu; corner: 8 * cu; stroke: 1 * cu; color: mint; opacity: 55% * capr_z.$k.hover }
                        zone box capr_z.$k { at: tcx, tcy; size: 63 * cu, 40 * cu; corner: 8 * cu; cursor: pointer; carries: "{capr.$k.path}"; label: "Open screenshot" }
                        on press capr_z.$k { emit capr_open(k) }
                    }
                }
            }
            let qx_ay = qx_top + 220 * cu
            //  Whether a recording takes the microphone or the system sound (one of the two), under the two recordings, which are what they act on: the Settings' switch, with its word beside it. Out while one runs.
            group {
                show: not rec_on
                text "RECORD WITH" { at: floor(pcx - 138 * cu + 0.5), floor(qx_ay + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
                PStageMic(pcx + 87 * cu, qx_ay, rec_mic_hit.hover, 0.6 + 0.4 * max(rec_mic_hit.hover, if(rec_mic, 1, 0)), if(rec_mic, 1, 0))
                SettingsSwitch(pcx + 138 * cu, qx_ay, rec_mic_pill, rec_mic_hit.pressed, rec_mic_hit.hover, mint)
                zone box rec_mic_hit { at: pcx + 106 * cu, qx_ay; size: 80 * cu, 30 * cu; corner: 10 * cu; cursor: pointer; label: "Record microphone" }
                on press rec_mic_hit { emit rec_mic_toggle }
                PShelfSpk(pcx - 17 * cu, qx_ay, rec_sys_hit.hover, 0.6 + 0.4 * max(rec_sys_hit.hover, if(rec_sys, 1, 0)), 0.9 * if(rec_sys, 1, 0))
                SettingsSwitch(pcx + 44 * cu, qx_ay, rec_sys_pill, rec_sys_hit.pressed, rec_sys_hit.hover, mint)
                zone box rec_sys_hit { at: pcx + 4 * cu, qx_ay; size: 100 * cu, 30 * cu; corner: 10 * cu; cursor: pointer; label: "Record system sound" }
                on press rec_sys_hit { emit rec_sys_toggle }
            }
        }

        //  The Power window: the session as five icon tiles, each of which has to be held for one second (it fills from the bottom and
        //  counts down while it is held, and lets go if you do), and the power profile as a track with a glass thumb that slides, on a
        //  spring that overshoots, to the one in use.
        group {
            show: showing_sub == powview
            opacity: expand0
            let px_top = ck + tiles_top * cu
            let px_cy = px_top + 22 * cu
            path { at: pcx - 124 * cu, px_cy; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * px_back.hover; move 4 * cu, -6 * cu; line -4 * cu, 0; line 4 * cu, 6 * cu }
            zone box px_back { at: pcx - 124 * cu, px_cy; size: 30 * cu, 30 * cu; cursor: pointer }
            on press px_back { panel_sub = none }
            text "POWER" { at: floor(pcx - 102 * cu + 0.5), floor(px_cy + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: pcx, px_top + 44 * cu; size: 276 * cu, 1 * cu; color: ink; opacity: 8% }
            text "SESSION" { at: floor(pcx - 138 * cu + 0.5), floor(px_top + 62 * cu + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
            let pwj0 = pw_hp0
            let pwx0 = sin(time * 5400 + 0.0) * 3 * cu * pwj0
            let pwy0 = sin(time * 6300 + 0.9) * 3 * cu * pwj0
            let pwv0 = clamp((time - pw_b0 - 0.8) / 0.5, 0, 1)
            group {
                move: pwx0, pwy0
                opacity: pwv0
                box { at: pcx + -113.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr; color: ink; opacity: 8% + 9% * pw_t0.hover }
                box { at: pcx + -113.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr; color: mint; opacity: 12% * pw_t0.hover }
                group {
                    clip inset 0 box { at: pcx + -113.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr }
                    box { at: pcx + -113.0 * cu, px_top + 96 * cu + 29 * cu - 29 * cu * clamp(pw_hp0, 0, 1); size: 52 * cu, 58 * cu * clamp(pw_hp0, 0, 1); color: mint; opacity: 34% }
                    box { at: pcx + -113.0 * cu, px_top + 96 * cu + 29 * cu - 58 * cu * clamp(pw_hp0, 0, 1); size: 52 * cu, 2 * cu; color: mint; opacity: 70% * clamp(pw_hp0 * 8, 0, 1) }
                }
                PSLock(pcx + -113.0 * cu, px_top + 96 * cu - 8 * cu, max(pw_t0.hover, clamp(pw_hp0 * 3, 0, 1)))
                text "Lock" { at: floor(pcx + -113.0 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 600; width: 50 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk"; show: pw_hp0 < 0.03 }
                text number(1 - clamp(pw_hp0, 0, 1), 1, "s") { at: floor(pcx + -113.0 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 700; width: 50 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: pw_hp0 >= 0.03 }
            }
            particles { at: pcx + -113.0 * cu, px_top + 96 * cu; area: 44, 52; count: 30; life: 0.5s .. 0.95s; speed: 70 .. 230; spread: 360deg
                gravity: 0, 420; drag: 1.3; size: 6, 2; colors: mint, minthi; opacity: 100%, 0%; shape: square; burst: pw_shatter0 }
            zone box pw_t0 { at: pcx + -113.0 * cu, px_top + 96 * cu; size: 54 * cu, 60 * cu; corner: 15 * cu; cursor: pointer; active: pwv0 > 0.9 }
            on press pw_t0 { pw_s0 = time; pw_d0 = true }
            on release pw_t0 { pw_d0 = false }
            on hold pw_t0 for 1000ms { pw_d0 = false; pw_b0 = time; emit pow_press(0); emit pw_shatter0 }
            let pwj1 = pw_hp1
            let pwx1 = sin(time * 5400 + 1.7) * 3 * cu * pwj1
            let pwy1 = sin(time * 6300 + 3.2) * 3 * cu * pwj1
            let pwv1 = clamp((time - pw_b1 - 0.8) / 0.5, 0, 1)
            group {
                move: pwx1, pwy1
                opacity: pwv1
                box { at: pcx + -56.5 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr; color: ink; opacity: 8% + 9% * pw_t1.hover }
                box { at: pcx + -56.5 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr; color: mint; opacity: 12% * pw_t1.hover }
                group {
                    clip inset 0 box { at: pcx + -56.5 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr }
                    box { at: pcx + -56.5 * cu, px_top + 96 * cu + 29 * cu - 29 * cu * clamp(pw_hp1, 0, 1); size: 52 * cu, 58 * cu * clamp(pw_hp1, 0, 1); color: mint; opacity: 34% }
                    box { at: pcx + -56.5 * cu, px_top + 96 * cu + 29 * cu - 58 * cu * clamp(pw_hp1, 0, 1); size: 52 * cu, 2 * cu; color: mint; opacity: 70% * clamp(pw_hp1 * 8, 0, 1) }
                }
                PSSleep(pcx + -56.5 * cu, px_top + 96 * cu - 8 * cu, max(pw_t1.hover, clamp(pw_hp1 * 3, 0, 1)))
                text "Sleep" { at: floor(pcx + -56.5 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 600; width: 50 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk"; show: pw_hp1 < 0.03 }
                text number(1 - clamp(pw_hp1, 0, 1), 1, "s") { at: floor(pcx + -56.5 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 700; width: 50 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: pw_hp1 >= 0.03 }
            }
            particles { at: pcx + -56.5 * cu, px_top + 96 * cu; area: 44, 52; count: 30; life: 0.5s .. 0.95s; speed: 70 .. 230; spread: 360deg
                gravity: 0, 420; drag: 1.3; size: 6, 2; colors: mint, minthi; opacity: 100%, 0%; shape: square; burst: pw_shatter1 }
            zone box pw_t1 { at: pcx + -56.5 * cu, px_top + 96 * cu; size: 54 * cu, 60 * cu; corner: 15 * cu; cursor: pointer; active: pwv1 > 0.9 }
            on press pw_t1 { pw_s1 = time; pw_d1 = true }
            on release pw_t1 { pw_d1 = false }
            on hold pw_t1 for 1000ms { pw_d1 = false; pw_b1 = time; emit pow_press(1); emit pw_shatter1 }
            let pwj2 = pw_hp2
            let pwx2 = sin(time * 5400 + 3.4) * 3 * cu * pwj2
            let pwy2 = sin(time * 6300 + 5.5) * 3 * cu * pwj2
            let pwv2 = clamp((time - pw_b2 - 0.8) / 0.5, 0, 1)
            group {
                move: pwx2, pwy2
                opacity: pwv2
                box { at: pcx + 0.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr; color: ink; opacity: 8% + 9% * pw_t2.hover }
                box { at: pcx + 0.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr; color: mint; opacity: 12% * pw_t2.hover }
                group {
                    clip inset 0 box { at: pcx + 0.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr }
                    box { at: pcx + 0.0 * cu, px_top + 96 * cu + 29 * cu - 29 * cu * clamp(pw_hp2, 0, 1); size: 52 * cu, 58 * cu * clamp(pw_hp2, 0, 1); color: mint; opacity: 34% }
                    box { at: pcx + 0.0 * cu, px_top + 96 * cu + 29 * cu - 58 * cu * clamp(pw_hp2, 0, 1); size: 52 * cu, 2 * cu; color: mint; opacity: 70% * clamp(pw_hp2 * 8, 0, 1) }
                }
                PSOut(pcx + 0.0 * cu, px_top + 96 * cu - 8 * cu, max(pw_t2.hover, clamp(pw_hp2 * 3, 0, 1)))
                text "Log out" { at: floor(pcx + 0.0 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 600; width: 50 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk"; show: pw_hp2 < 0.03 }
                text number(1 - clamp(pw_hp2, 0, 1), 1, "s") { at: floor(pcx + 0.0 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 700; width: 50 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: pw_hp2 >= 0.03 }
            }
            particles { at: pcx + 0.0 * cu, px_top + 96 * cu; area: 44, 52; count: 30; life: 0.5s .. 0.95s; speed: 70 .. 230; spread: 360deg
                gravity: 0, 420; drag: 1.3; size: 6, 2; colors: mint, minthi; opacity: 100%, 0%; shape: square; burst: pw_shatter2 }
            zone box pw_t2 { at: pcx + 0.0 * cu, px_top + 96 * cu; size: 54 * cu, 60 * cu; corner: 15 * cu; cursor: pointer; active: pwv2 > 0.9 }
            on press pw_t2 { pw_s2 = time; pw_d2 = true }
            on release pw_t2 { pw_d2 = false }
            on hold pw_t2 for 1000ms { pw_d2 = false; pw_b2 = time; emit pow_press(2); emit pw_shatter2 }
            let pwj3 = pw_hp3
            let pwx3 = sin(time * 5400 + 5.1) * 3 * cu * pwj3
            let pwy3 = sin(time * 6300 + 7.8) * 3 * cu * pwj3
            let pwv3 = clamp((time - pw_b3 - 0.8) / 0.5, 0, 1)
            group {
                move: pwx3, pwy3
                opacity: pwv3
                box { at: pcx + 56.5 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr; color: ink; opacity: 8% + 9% * pw_t3.hover }
                box { at: pcx + 56.5 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr; color: mint; opacity: 12% * pw_t3.hover }
                group {
                    clip inset 0 box { at: pcx + 56.5 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr }
                    box { at: pcx + 56.5 * cu, px_top + 96 * cu + 29 * cu - 29 * cu * clamp(pw_hp3, 0, 1); size: 52 * cu, 58 * cu * clamp(pw_hp3, 0, 1); color: mint; opacity: 34% }
                    box { at: pcx + 56.5 * cu, px_top + 96 * cu + 29 * cu - 58 * cu * clamp(pw_hp3, 0, 1); size: 52 * cu, 2 * cu; color: mint; opacity: 70% * clamp(pw_hp3 * 8, 0, 1) }
                }
                PSRestart(pcx + 56.5 * cu, px_top + 96 * cu - 8 * cu, max(pw_t3.hover, clamp(pw_hp3 * 3, 0, 1)))
                text "Restart" { at: floor(pcx + 56.5 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 600; width: 50 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk"; show: pw_hp3 < 0.03 }
                text number(1 - clamp(pw_hp3, 0, 1), 1, "s") { at: floor(pcx + 56.5 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 700; width: 50 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: pw_hp3 >= 0.03 }
            }
            particles { at: pcx + 56.5 * cu, px_top + 96 * cu; area: 44, 52; count: 30; life: 0.5s .. 0.95s; speed: 70 .. 230; spread: 360deg
                gravity: 0, 420; drag: 1.3; size: 6, 2; colors: mint, minthi; opacity: 100%, 0%; shape: square; burst: pw_shatter3 }
            zone box pw_t3 { at: pcx + 56.5 * cu, px_top + 96 * cu; size: 54 * cu, 60 * cu; corner: 15 * cu; cursor: pointer; active: pwv3 > 0.9 }
            on press pw_t3 { pw_s3 = time; pw_d3 = true }
            on release pw_t3 { pw_d3 = false }
            on hold pw_t3 for 1000ms { pw_d3 = false; pw_b3 = time; emit pow_press(3); emit pw_shatter3 }
            let pwj4 = pw_hp4
            let pwx4 = sin(time * 5400 + 6.8) * 3 * cu * pwj4
            let pwy4 = sin(time * 6300 + 10.1) * 3 * cu * pwj4
            let pwv4 = clamp((time - pw_b4 - 0.8) / 0.5, 0, 1)
            group {
                move: pwx4, pwy4
                opacity: pwv4
                box { at: pcx + 113.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr; color: ink; opacity: 8% + 9% * pw_t4.hover }
                box { at: pcx + 113.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr; color: mint; opacity: 12% * pw_t4.hover }
                group {
                    clip inset 0 box { at: pcx + 113.0 * cu, px_top + 96 * cu; size: 52 * cu, 58 * cu; corner: pr }
                    box { at: pcx + 113.0 * cu, px_top + 96 * cu + 29 * cu - 29 * cu * clamp(pw_hp4, 0, 1); size: 52 * cu, 58 * cu * clamp(pw_hp4, 0, 1); color: mint; opacity: 34% }
                    box { at: pcx + 113.0 * cu, px_top + 96 * cu + 29 * cu - 58 * cu * clamp(pw_hp4, 0, 1); size: 52 * cu, 2 * cu; color: mint; opacity: 70% * clamp(pw_hp4 * 8, 0, 1) }
                }
                PSOff(pcx + 113.0 * cu, px_top + 96 * cu - 8 * cu, max(pw_t4.hover, clamp(pw_hp4 * 3, 0, 1)))
                text "Power off" { at: floor(pcx + 113.0 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 600; width: 50 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk"; show: pw_hp4 < 0.03 }
                text number(1 - clamp(pw_hp4, 0, 1), 1, "s") { at: floor(pcx + 113.0 * cu + 0.5), floor(px_top + 96 * cu + 19 * cu + 0.5); anchor: center; align: center; size: 11; weight: 700; width: 50 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: pw_hp4 >= 0.03 }
            }
            particles { at: pcx + 113.0 * cu, px_top + 96 * cu; area: 44, 52; count: 30; life: 0.5s .. 0.95s; speed: 70 .. 230; spread: 360deg
                gravity: 0, 420; drag: 1.3; size: 6, 2; colors: mint, minthi; opacity: 100%, 0%; shape: square; burst: pw_shatter4 }
            zone box pw_t4 { at: pcx + 113.0 * cu, px_top + 96 * cu; size: 54 * cu, 60 * cu; corner: 15 * cu; cursor: pointer; active: pwv4 > 0.9 }
            on press pw_t4 { pw_s4 = time; pw_d4 = true }
            on release pw_t4 { pw_d4 = false }
            on hold pw_t4 for 1000ms { pw_d4 = false; pw_b4 = time; emit pow_press(4); emit pw_shatter4 }
            //  The battery levels: this computer, then each connected device that reports a charge. Nothing at all with none.
            text "BATTERY" { at: floor(pcx - 138 * cu + 0.5), floor(px_top + 142 * cu + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk"; show: bat_rows > 0 }
            column bat_list {
                at: floor(pcx - 138 * cu + 0.5), floor(px_top + 154 * cu + 0.5)
                gap: 6 * cu
                BatCard("This computer", bat_pct / 100, bat_state, chg_now) { show: bat_here }
                for d in bat_devs { BatCard(d.name, d.level, "Connected", false) }
            }
            text "POWER PROFILE" { at: floor(pcx - 138 * cu + 0.5), floor(px_top + (142 + bat_h) * cu + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
            group { opacity: mix(0.45, 1, clamp(pow_prof + 1, 0, 1))
                box { at: pcx, px_top + (176 + bat_h) * cu; size: 276 * cu, 46 * cu; corner: 16 * cu; color: ink; opacity: 8% }
                body {
                    color: mint
                    opacity: 24%
                    rim: 40%
                    shadow: 0, 2 * cu, 8 * cu, 25%, #000000
                    box { at: pcx + (pow_th - 1) * 92 * cu, px_top + (176 + bat_h) * cu; size: (90 + 8 * abs(pow_th - if(pow_prof < 0, 1, pow_prof))) * cu, 40 * cu; corner: pr }
                }
                PPLeaf(pcx + -92 * cu, px_top + (176 + bat_h) * cu - 8 * cu, max(clamp(1 - abs(pow_th - 0), 0, 1), pw_p0.hover), clamp(1 - abs(pow_th - 0), 0, 1), 0.55 + 0.45 * max(clamp(1 - abs(pow_th - 0), 0, 1), pw_p0.hover))
                text "Saver" { at: floor(pcx + -92 * cu + 0.5), floor(px_top + (176 + bat_h) * cu + 12 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 88 * cu; lines: 1; color: mix(ink, mint, clamp(1 - abs(pow_th - 0), 0, 1)); opacity: 60% + 40% * max(clamp(1 - abs(pow_th - 0), 0, 1), pw_p0.hover); family: "Space Grotesk" }
                zone box pw_p0 { at: pcx + -92 * cu, px_top + (176 + bat_h) * cu; size: 90 * cu, 44 * cu; corner: 15 * cu; cursor: pointer; active: pow_prof >= 0 }
                on press pw_p0 { emit pow_prof_set(0) }
                PPBalance(pcx + 0 * cu, px_top + (176 + bat_h) * cu - 8 * cu, max(clamp(1 - abs(pow_th - 1), 0, 1), pw_p1.hover), clamp(1 - abs(pow_th - 1), 0, 1), 0.55 + 0.45 * max(clamp(1 - abs(pow_th - 1), 0, 1), pw_p1.hover))
                text "Balanced" { at: floor(pcx + 0 * cu + 0.5), floor(px_top + (176 + bat_h) * cu + 12 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 88 * cu; lines: 1; color: mix(ink, mint, clamp(1 - abs(pow_th - 1), 0, 1)); opacity: 60% + 40% * max(clamp(1 - abs(pow_th - 1), 0, 1), pw_p1.hover); family: "Space Grotesk" }
                zone box pw_p1 { at: pcx + 0 * cu, px_top + (176 + bat_h) * cu; size: 90 * cu, 44 * cu; corner: 15 * cu; cursor: pointer; active: pow_prof >= 0 }
                on press pw_p1 { emit pow_prof_set(1) }
                PPBolt(pcx + 92 * cu, px_top + (176 + bat_h) * cu - 8 * cu, max(clamp(1 - abs(pow_th - 2), 0, 1), pw_p2.hover), clamp(1 - abs(pow_th - 2), 0, 1), 0.55 + 0.45 * max(clamp(1 - abs(pow_th - 2), 0, 1), pw_p2.hover))
                text "Performance" { at: floor(pcx + 92 * cu + 0.5), floor(px_top + (176 + bat_h) * cu + 12 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 88 * cu; lines: 1; color: mix(ink, mint, clamp(1 - abs(pow_th - 2), 0, 1)); opacity: 60% + 40% * max(clamp(1 - abs(pow_th - 2), 0, 1), pw_p2.hover); family: "Space Grotesk" }
                zone box pw_p2 { at: pcx + 92 * cu, px_top + (176 + bat_h) * cu; size: 90 * cu, 44 * cu; corner: 15 * cu; cursor: pointer; active: pow_prof >= 0 }
                on press pw_p2 { emit pow_prof_set(2) }
            }
        }

        //  The dropdown: a solid card that drops from the volume row over what is
        //  below it. Declared last so its rows win the press over the slider.
        group {
            opacity: dd
            move: 0, (1 - dd) * -8 * cu
            let ddn = clamp(outlist.count, 1, 6)
            let ddh = ddn * 30 * cu + 12 * cu
            box { at: pcx, ck + (vol_top + 24) * cu + ddh / 2; size: 288 * cu, ddh; corner: pr; color: card }
            zone box dd_block { at: pcx, ck + (vol_top + 24) * cu + ddh / 2; size: 288 * cu, ddh; active: dd > 0.05 }
            column dd_list {
                at: floor(pcx - 138 * cu + 0.5), floor(ck + (vol_top + 24) * cu + 6 * cu + 0.5)
                gap: 3
                for o in outlist { OutRow(o, pick: pick_out) }
            }
            text "No outputs" { at: floor(pcx + 0.5), floor(ck + (vol_top + 24) * cu + ddh / 2 + 0.5); anchor: center; size: 14; color: faint; family: "Space Grotesk"; show: outlist.count < 1 }
        }
        }
    }
}
