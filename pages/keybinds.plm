part Keybinds {
        //  The Keybinds page (System): the shell's keybinds as the window manager has them, one row each with its keys drawn as caps. A row pressed opens its
        //  editor under the list: the four modifiers as chips, and a box that records the next key pressed; Save writes it into the window manager's own
        //  file, Reset puts the key this shell ships with. (logic/keybinds.luau reads and writes the file; pages/keybinds_keys.plm are the rules that hear a key.)
        group {
            show: set_pgy > 0.01
            opacity: set_pgy
            let kb.n = max(1, kb_rows.count)
            let kb.rh = 26 * pu                                         // a row
            let kb.h1 = 14 * pu + kb.n * kb.rh                          // the list's card
            let kb.t1 = sby + 24 * pu                                   // its top
            let kb.t2 = kb.t1 + kb.h1 + 12 * pu                         // the editor's top
            let kb.h2 = if(kb_sel >= 0, 118, 44) * pu
            let kb.xr = spx + 424 * pu                                  // the right end of a row

            //  Card one: the list.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, (kb.t1 + kb.h1 / 2) * 1; size: 438 * pu, kb.h1; corner: 14 * pu } }
            box { at: spx + 219 * pu, kb.t1 + kb.h1 / 2; size: 438 * pu, kb.h1; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); text "KEYBINDS" { at: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(kb.xr + 0.5), floor(sby + 13 * pu + 0.5); text kb_where { at: floor(kb.xr + 0.5), floor(sby + 13 * pu + 0.5); anchor: right center; align: right; size: 13; width: (260 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 219 * pu + 0.5), floor(kb.t1 + 40 * pu + 0.5); text "No keybinds found in this window manager's file" { at: floor(spx + 219 * pu + 0.5), floor(kb.t1 + 40 * pu + 0.5); anchor: center; align: center; size: 15.5; color: faint; family: "Space Grotesk"; show: not kb_ok } }

            repeat i in 0..12 {
                let kbi.y = kb.t1 + 7 * pu + i * kb.rh + kb.rh / 2
                group {
                    show: kb_rows.count > i
                    box { at: spx + 219 * pu, kbi.y; size: 426 * pu, 24 * pu; corner: 9 * pu; color: mint; opacity: if(kb_sel == i, 18%, 0%) + 8% * kb_hit.$i.hover * if(kb_sel == i, 0, 1) }
                    group { scale: rs; pivot: floor(spx + 16 * pu + 0.5), floor(kbi.y + 0.5); text kb_rows.$i.name { at: floor(spx + 16 * pu + 0.5), floor(kbi.y + 0.5); anchor: left center; size: 16; weight: 600; width: (220 * pu) / rs; lines: 1; color: if(kb_sel == i, mint, ink); family: "Space Grotesk" } }
                    //  The keys, as caps (up to four: the modifiers and the key), the last at the right.
                    box { at: kb.xr - kb_rows.$i.rd * pu, kbi.y; size: kb_rows.$i.wd * pu, 17 * pu; corner: 6 * pu; color: ink; opacity: 14%; show: kb_rows.$i.wd > 0 }
                    box { at: kb.xr - kb_rows.$i.rc * pu, kbi.y; size: kb_rows.$i.wc * pu, 17 * pu; corner: 6 * pu; color: ink; opacity: 14%; show: kb_rows.$i.wc > 0 }
                    box { at: kb.xr - kb_rows.$i.rb * pu, kbi.y; size: kb_rows.$i.wb * pu, 17 * pu; corner: 6 * pu; color: ink; opacity: 14%; show: kb_rows.$i.wb > 0 }
                    box { at: kb.xr - kb_rows.$i.ra * pu, kbi.y; size: kb_rows.$i.wa * pu, 17 * pu; corner: 6 * pu; color: ink; opacity: 14%; show: kb_rows.$i.wa > 0 }
                    group { scale: rs; pivot: floor(kb.xr - kb_rows.$i.rd * pu + 0.5), floor(kbi.y + 0.5); text kb_rows.$i.d { at: floor(kb.xr - kb_rows.$i.rd * pu + 0.5), floor(kbi.y + 0.5); anchor: center; align: center; size: 14.5; weight: 600; color: ink; family: "Space Grotesk" } }
                    group { scale: rs; pivot: floor(kb.xr - kb_rows.$i.rc * pu + 0.5), floor(kbi.y + 0.5); text kb_rows.$i.c { at: floor(kb.xr - kb_rows.$i.rc * pu + 0.5), floor(kbi.y + 0.5); anchor: center; align: center; size: 14.5; weight: 600; color: ink; family: "Space Grotesk" } }
                    group { scale: rs; pivot: floor(kb.xr - kb_rows.$i.rb * pu + 0.5), floor(kbi.y + 0.5); text kb_rows.$i.b { at: floor(kb.xr - kb_rows.$i.rb * pu + 0.5), floor(kbi.y + 0.5); anchor: center; align: center; size: 14.5; weight: 600; color: ink; family: "Space Grotesk" } }
                    group { scale: rs; pivot: floor(kb.xr - kb_rows.$i.ra * pu + 0.5), floor(kbi.y + 0.5); text kb_rows.$i.a { at: floor(kb.xr - kb_rows.$i.ra * pu + 0.5), floor(kbi.y + 0.5); anchor: center; align: center; size: 14.5; weight: 600; color: ink; family: "Space Grotesk" } }
                    ellipse { at: spx + 8 * pu, kbi.y; radius: 2.2 * pu; color: mint; show: kb_rows.$i.chg }
                }
                zone box kb_hit.$i { at: spx + 219 * pu, kbi.y; size: 430 * pu, 24 * pu; corner: 9 * pu; cursor: pointer; active: kb_rows.count > i and set_pgy > 0.5 and not kb_cap }
                on press kb_hit.$i { emit kb_select(i) }
            }

            //  Card two: the editor.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, kb.t2 + kb.h2 / 2; size: 438 * pu, kb.h2; corner: 14 * pu } }
            box { at: spx + 219 * pu, kb.t2 + kb.h2 / 2; size: 438 * pu, kb.h2; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(kb.t2 + 22 * pu + 0.5); text "Press a row to change its keys" { at: floor(spx + 14 * pu + 0.5), floor(kb.t2 + 22 * pu + 0.5); anchor: left center; size: 15.5; color: faint; family: "Space Grotesk"; show: kb_sel < 0 } }
            group {
                show: kb_sel >= 0
                //  Which one, and what the chips and the box now say.
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(kb.t2 + 18 * pu + 0.5); text "CHANGE" { at: floor(spx + 14 * pu + 0.5), floor(kb.t2 + 18 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(spx + 70 * pu + 0.5), floor(kb.t2 + 18 * pu + 0.5); text kb_name { at: floor(spx + 70 * pu + 0.5), floor(kb.t2 + 18 * pu + 0.5); anchor: left center; size: 16.5; weight: 700; width: (340 * pu) / rs; lines: 1; color: ink; family: "Space Grotesk" } }
                //  The modifiers: four chips that switch on and off.
                repeat m in 0..4 {
                    let kbm.x = spx + 14 * pu + m * 68 * pu
                    let kbm.on = mod(floor(kb_mod / pick(m, 1, 2, 4, 8)), 2)
                    box { from: kbm.x, kb.t2 + 38 * pu; size: 62 * pu, 26 * pu; corner: 13 * pu; color: if(kbm.on, mint, ink); opacity: if(kbm.on, 26%, 8% + 10% * kb_chip.$m.hover) }
                    PPillOutline((kbm.x) + 31 * pu, (kb.t2 + 38 * pu) + 13 * pu, 62 * pu, 26 * pu, 13 * pu, kb_chip.$m.hover, clamp(3 * (if(kbm.on, 26%, 8% + 10% * kb_chip.$m.hover)), 0, 1), pu)
                    box { from: kbm.x, kb.t2 + 38 * pu; size: 62 * pu, 26 * pu; corner: 13 * pu; stroke: 1.2 * pu; color: mint; opacity: if(kbm.on, 70%, 0%) }
                    group { scale: rs; pivot: floor(kbm.x + 31 * pu + 0.5), floor(kb.t2 + 51 * pu + 0.5); text pick(m, "Super", "Shift", "Ctrl", "Alt") { at: floor(kbm.x + 31 * pu + 0.5), floor(kb.t2 + 51 * pu + 0.5); anchor: center; align: center; size: 15; weight: 600; color: if(kbm.on, mint, ink); family: "Space Grotesk" } }
                    zone box kb_chip.$m { from: kbm.x, kb.t2 + 38 * pu; size: 62 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: kb_sel >= 0 and set_pgy > 0.5 }
                    on press kb_chip.$m { emit kb_mod_toggle(pick(m, 1, 2, 4, 8)) }
                }
                group { scale: rs; pivot: floor(spx + 290 * pu + 0.5), floor(kb.t2 + 51 * pu + 0.5); text "+" { at: floor(spx + 290 * pu + 0.5), floor(kb.t2 + 51 * pu + 0.5); anchor: center; align: center; size: 19; weight: 600; color: faint; family: "Space Grotesk" } }
                //  The key: a box that waits for the next key pressed once it is pressed.
                box { from: spx + 304 * pu, kb.t2 + 38 * pu; size: 120 * pu, 26 * pu; corner: 9 * pu; color: if(kb_cap, mint, ink); opacity: if(kb_cap, 20% + 8% * sin(time * 220), 10% + 8% * kb_key_hit.hover) }
                PPillOutline((spx + 304 * pu) + 60 * pu, (kb.t2 + 38 * pu) + 13 * pu, 120 * pu, 26 * pu, 9 * pu, kb_key_hit.hover, clamp(3 * (if(kb_cap, 20% + 8% * sin(time * 220), 10% + 8% * kb_key_hit.hover)), 0, 1), pu)
                box { from: spx + 304 * pu, kb.t2 + 38 * pu; size: 120 * pu, 26 * pu; corner: 9 * pu; stroke: 1.2 * pu; color: mint; opacity: if(kb_cap, 80%, 0%) }
                group { scale: rs; pivot: floor(spx + 364 * pu + 0.5), floor(kb.t2 + 51 * pu + 0.5); text "Press a key…" { at: floor(spx + 364 * pu + 0.5), floor(kb.t2 + 51 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; color: mint; family: "Space Grotesk"; show: kb_cap } }
                group { scale: rs; pivot: floor(spx + 364 * pu + 0.5), floor(kb.t2 + 51 * pu + 0.5); text "Choose a key" { at: floor(spx + 364 * pu + 0.5), floor(kb.t2 + 51 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; color: faint; family: "Space Grotesk"; show: not kb_cap and not kb_has } }
                group { scale: rs; pivot: floor(spx + 364 * pu + 0.5), floor(kb.t2 + 51 * pu + 0.5); text kb_key { at: floor(spx + 364 * pu + 0.5), floor(kb.t2 + 51 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (112 * pu) / rs; lines: 1; color: ink; family: "Space Grotesk"; show: not kb_cap and kb_has } }
                zone box kb_key_hit { from: spx + 304 * pu, kb.t2 + 38 * pu; size: 120 * pu, 26 * pu; corner: 9 * pu; cursor: pointer; active: kb_sel >= 0 and set_pgy > 0.5 and not kb_cap }
                on press kb_key_hit { kb_cap = true }
                //  Save, Reset and Cancel, and a line about how it went.
                box { from: spx + 14 * pu, kb.t2 + 76 * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: if(kb_dirty, 26% + 12% * kb_save_hit.hover, 8%) }
                PPillOutline((spx + 14 * pu) + 39 * pu, (kb.t2 + 76 * pu) + 13 * pu, 78 * pu, 26 * pu, 13 * pu, kb_save_hit.hover, clamp(3 * (if(kb_dirty, 26% + 12% * kb_save_hit.hover, 8%)), 0, 1), pu)
                group { scale: rs; pivot: floor(spx + 53 * pu + 0.5), floor(kb.t2 + 89 * pu + 0.5); text "Save" { at: floor(spx + 53 * pu + 0.5), floor(kb.t2 + 89 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; color: mint; opacity: if(kb_dirty, 100%, 40%); family: "Space Grotesk" } }
                zone box kb_save_hit { from: spx + 14 * pu, kb.t2 + 76 * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: kb_dirty and set_pgy > 0.5 }
                on press kb_save_hit { emit kb_save }
                box { from: spx + 98 * pu, kb.t2 + 76 * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: ink; opacity: 8% + 10% * kb_reset_hit.hover }
                PPillOutline((spx + 98 * pu) + 39 * pu, (kb.t2 + 76 * pu) + 13 * pu, 78 * pu, 26 * pu, 13 * pu, kb_reset_hit.hover, clamp(3 * (8% + 10% * kb_reset_hit.hover), 0, 1), pu)
                group { scale: rs; pivot: floor(spx + 137 * pu + 0.5), floor(kb.t2 + 89 * pu + 0.5); text "Reset" { at: floor(spx + 137 * pu + 0.5), floor(kb.t2 + 89 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" } }
                zone box kb_reset_hit { from: spx + 98 * pu, kb.t2 + 76 * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: kb_sel >= 0 and set_pgy > 0.5 }
                on press kb_reset_hit { emit kb_reset }
                box { from: spx + 182 * pu, kb.t2 + 76 * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: ink; opacity: 8% + 10% * kb_cancel_hit.hover }
                PPillOutline((spx + 182 * pu) + 39 * pu, (kb.t2 + 76 * pu) + 13 * pu, 78 * pu, 26 * pu, 13 * pu, kb_cancel_hit.hover, clamp(3 * (8% + 10% * kb_cancel_hit.hover), 0, 1), pu)
                group { scale: rs; pivot: floor(spx + 221 * pu + 0.5), floor(kb.t2 + 89 * pu + 0.5); text "Cancel" { at: floor(spx + 221 * pu + 0.5), floor(kb.t2 + 89 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; color: ink; opacity: 85%; family: "Space Grotesk" } }
                zone box kb_cancel_hit { from: spx + 182 * pu, kb.t2 + 76 * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: kb_sel >= 0 and set_pgy > 0.5 }
                on press kb_cancel_hit { emit kb_cancel }
                //  Delete takes the bind out of the file (it stays there as a comment; Restore, in the list, puts it back).
                box { from: spx + 266 * pu, kb.t2 + 76 * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: #ff6b6b; opacity: 10% + 16% * kb_delete_hit.hover }
                PPillOutline((spx + 266 * pu) + 39 * pu, (kb.t2 + 76 * pu) + 13 * pu, 78 * pu, 26 * pu, 13 * pu, kb_delete_hit.hover, clamp(3 * (10% + 16% * kb_delete_hit.hover), 0, 1), pu)
                group { scale: rs; pivot: floor(spx + 305 * pu + 0.5), floor(kb.t2 + 89 * pu + 0.5); text "Delete" { at: floor(spx + 305 * pu + 0.5), floor(kb.t2 + 89 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; color: #ff6b6b; family: "Space Grotesk" } }
                zone box kb_delete_hit { from: spx + 266 * pu, kb.t2 + 76 * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; label: "Delete this keybind"; active: kb_sel >= 0 and set_pgy > 0.5 }
                on press kb_delete_hit { emit kb_delete }
            }
            //  Every bind of the shell's back to the key it ships with (a second press confirms: it overwrites the keys that were changed).
            group {
                show: kb_sel < 0
                box { from: kb.xr - 140 * pu, kb.t2 + 9 * pu; size: 140 * pu, 26 * pu; corner: 13 * pu; color: if(kb_arm, #ff6b6b, mint); opacity: 12% + 14% * kb_defaults_hit.hover + 14% * if(kb_arm, 1, 0) }
                PPillOutline((kb.xr - 140 * pu) + 70 * pu, (kb.t2 + 9 * pu) + 13 * pu, 140 * pu, 26 * pu, 13 * pu, kb_defaults_hit.hover, clamp(3 * (12% + 14% * kb_defaults_hit.hover + 14% * if(kb_arm, 1, 0)), 0, 1), pu)
                group { scale: rs; pivot: floor(kb.xr - 70 * pu + 0.5), floor(kb.t2 + 22 * pu + 0.5); text pick(if(kb_arm, 1, 0), "Reset to defaults", "Press again to reset") { at: floor(kb.xr - 70 * pu + 0.5), floor(kb.t2 + 22 * pu + 0.5); anchor: center; align: center; size: 15; weight: 600; color: if(kb_arm, #ff6b6b, mint); family: "Space Grotesk" } }
                zone box kb_defaults_hit { from: kb.xr - 140 * pu, kb.t2 + 9 * pu; size: 140 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; label: "Reset every keybind to the default"; active: kb_sel < 0 and set_pgy > 0.5 }
                on press kb_defaults_hit { emit kb_defaults }
            }
            //  How the last save went (or why it did not).
            group { scale: rs; pivot: floor(kb.xr + 0.5), floor(kb.t2 + kb.h2 + 14 * pu + 0.5); text kb_msg { at: floor(kb.xr + 0.5), floor(kb.t2 + kb.h2 + 14 * pu + 0.5); anchor: right center; align: right; size: 14.5; width: (420 * pu) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(kb.t2 + kb.h2 + 14 * pu + 0.5); text "The system keeps some keys for itself: those cannot be recorded here" { at: floor(spx + 14 * pu + 0.5), floor(kb.t2 + kb.h2 + 14 * pu + 0.5); anchor: left center; size: 13; width: (420 * pu) / rs; lines: 1; color: faint; opacity: 80%; family: "Space Grotesk"; show: kb_cap } }

            include "keybinds_keys.plm"
        }
}
