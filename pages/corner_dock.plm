part CornerDock {
    //  The corner dock's icons (the glass is in bar_shapes.plm, `cdk.*` in vitreus.plm): one row along the screen's horizontal edge (down a side strip, one column along the vertical one), drawn upright where the mirror
    //  image of the glass falls on the right and the bottom (`rt`, `bt`). The zone under them is the pill itself, so it can be taken hold of by what is between the icons.
    follow dk_lv = if(cdk_bg.hover > 0.01 or adk_bg.hover > 0.01 or cdk_down > 0.5 or adk_down > 0.5 or cdk_drag > 0.5 or adk_drag > 0.5 or (cdk_ga > 0.002 and cdk_ga < 0.998) or (adk_ga > 0.002 and adk_ga < 0.998), 1, 0)
    //  The dock's bulge (`cdb_*`, vitreus.plm; the glass is in bar_shapes.plm): slivers along the pill, under its own zone and its icons, that say where along it the pointer is.
    //  Every one's leaving is before any one's entering: going from one to the next is both in the same frame, and the rule declared last is the one that counts.
    repeat i in 0..10 {
        zone box cdk_bz.$i { at: cdk.rcx + (1 - lm) * ((i + 0.5) * mix(cdk.W, cdk.H, lm) / 10 - mix(cdk.W, cdk.H, lm) / 2), cdk.rcy + lm * ((i + 0.5) * mix(cdk.W, cdk.H, lm) / 10 - mix(cdk.W, cdk.H, lm) / 2); size: mix(mix(cdk.W, cdk.H, lm) / 10, cdk.W, lm), mix(cdk.H, mix(cdk.W, cdk.H, lm) / 10, lm); active: cdk.g > 0.6 and bar_bulge }
        on leave cdk_bz.$i { cdb_hot.$screen: 0 }
    }
    repeat i in 0..10 {
        on enter cdk_bz.$i { cdb_hot.$screen: 1; cdb_x.$screen: mix(cdk.rcx + (1 - lm) * (clamp((i + 0.5) * mix(cdk.W, cdk.H, lm) / 10 - mix(cdk.W, cdk.H, lm) / 2, 0 - max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu), max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu))), screen.width - (cdk.rcx + (1 - lm) * (clamp((i + 0.5) * mix(cdk.W, cdk.H, lm) / 10 - mix(cdk.W, cdk.H, lm) / 2, 0 - max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu), max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu)))), rt); cdb_y.$screen: mix(cdk.rcy + lm * (clamp((i + 0.5) * mix(cdk.W, cdk.H, lm) / 10 - mix(cdk.W, cdk.H, lm) / 2, 0 - max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu), max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu))), yo + vb - (cdk.rcy + lm * (clamp((i + 0.5) * mix(cdk.W, cdk.H, lm) / 10 - mix(cdk.W, cdk.H, lm) / 2, 0 - max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu), max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu)))), bt); cdb_l.$screen: min(52 * dbu, mix(cdk.W, cdk.H, lm)) }
        on enter cdk_bz.$i while cdb_hot.$screen < 0.04 { cdb_x.$screen: mix(cdk.rcx + (1 - lm) * (clamp((i + 0.5) * mix(cdk.W, cdk.H, lm) / 10 - mix(cdk.W, cdk.H, lm) / 2, 0 - max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu), max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu))), screen.width - (cdk.rcx + (1 - lm) * (clamp((i + 0.5) * mix(cdk.W, cdk.H, lm) / 10 - mix(cdk.W, cdk.H, lm) / 2, 0 - max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu), max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu)))), rt) ~16ms; cdb_y.$screen: mix(cdk.rcy + lm * (clamp((i + 0.5) * mix(cdk.W, cdk.H, lm) / 10 - mix(cdk.W, cdk.H, lm) / 2, 0 - max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu), max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu))), yo + vb - (cdk.rcy + lm * (clamp((i + 0.5) * mix(cdk.W, cdk.H, lm) / 10 - mix(cdk.W, cdk.H, lm) / 2, 0 - max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu), max(0, mix(cdk.W, cdk.H, lm) / 2 - 26 * dbu)))), bt) ~16ms; cdb_l.$screen: min(52 * dbu, mix(cdk.W, cdk.H, lm)) ~16ms }
    }
    zone box cdk_bg { label: "The corner dock: drag to move it"; at: cdk.rcx, cdk.rcy; size: cdk.W, cdk.H; cursor: pointer; active: cdk.g > 0.6 and dkm < 0.5 }
    on press cdk_bg { cdk_down = 1; cdk_drag = 0; cdk_hx = pointer.x - cdk.rcx; cdk_hy = pointer.y - cdk.rcy }
    on drag cdk_bg while cdk_down > 0.5 { cdk_px = clamp(pointer.x - cdk_hx, 0, screen.width); cdk_py = clamp(pointer.y - cdk_hy, 0, screen.height); cdk_drag = if(cdk_drag > 0.5 or abs(drag.dx) + abs(drag.dy) > 8, 1, 0) }
    on release cdk_bg while cdk_down > 0.5 { cdk_corner = if(cdk_drag > 0.5, cdk.pick, cdk_corner); cdk_down = 0; cdk_drag = 0 }
    group {
        glow: 2.4 * dbu, 110%, deep
        row cdk_row {
            at: floor(mix(pick(screen.index, cdk_cx.0, cdk_cx.1) - cdk.L / 2 + 7 * dbu, screen.width - (pick(screen.index, cdk_cx.0, cdk_cx.1) - cdk.L / 2 + 7 * dbu) - (cdk.L - 14 * dbu), rt) + 0.5), floor(mix(pick(screen.index, cdk_cy.0, cdk_cy.1) - cdk.s / 2, yo + vb - pick(screen.index, cdk_cy.0, cdk_cy.1) - cdk.s / 2, bt) + 0.5)
            gap: floor(6 * dbu + 0.5)
            show: cdk_ga * sb > 0.02 and lm < 0.5
            opacity: clamp(cdk_ga * sb * 2 - 1, 0, 1)
            for t in cdk_pins { CdkIcon(t, 0) }
        }
        //  Down a side strip the pill stands upright: the same icons in a column along the edge.
        column cdk_col {
            at: floor(mix(pick(screen.index, cdk_cx.0, cdk_cx.1) - cdk.s / 2, screen.width - pick(screen.index, cdk_cx.0, cdk_cx.1) - cdk.s / 2, rt) + 0.5), floor(mix(pick(screen.index, cdk_cy.0, cdk_cy.1) - cdk.L / 2 + 7 * dbu, yo + vb - (pick(screen.index, cdk_cy.0, cdk_cy.1) - cdk.L / 2 + 7 * dbu) - (cdk.L - 14 * dbu), bt) + 0.5)
            gap: floor(6 * dbu + 0.5)
            show: cdk_ga * sb > 0.02 and lm > 0.5
            opacity: clamp(cdk_ga * sb * 2 - 1, 0, 1)
            for t in cdk_pins { CdkIcon(t, 1) }
        }
    }
}
