            //  How strongly the wallpaper's accent is pushed, for the first one.
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 410 * pu + 0.5); text "ACCENT STRENGTH" { at: floor(spx + 14 * pu + 0.5), floor(sby + 410 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; opacity: 40% + 60% * if(theme_sel == 0, 1, 0); family: "Space Grotesk" } }
            repeat k in 0..3 {
                let cx_ = spx + (130 + k * 100) * pu
                group {
                    opacity: 40% + 60% * if(theme_sel == 0, 1, 0)
                    box { at: cx_, sby + 410 * pu; size: 92 * pu, 26 * pu; corner: 13 * pu; color: if(iris_int == k, mint, ink); opacity: if(iris_int == k, 24%, 8% + 9% * iris_int_hit.$k.hover) }
                    group { scale: rs; pivot: floor(cx_ + 0.5), floor(sby + 410 * pu + 0.5); text pick(k, "Subtle", "Medium", "Bold") { at: floor(cx_ + 0.5), floor(sby + 410 * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: if(iris_int == k, mint, ink); opacity: if(iris_int == k, 100%, 85%); family: "Space Grotesk" } }
                    zone box iris_int_hit.$k { at: cx_, sby + 410 * pu; size: 94 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: theme_sel == 0 }
                    on press iris_int_hit.$k { emit iris_int_set(k) }
                }
            }
        }
}
