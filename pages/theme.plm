            ellipse { at: spx + 326 * pu - -3 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 326 * pu + 86 * pu, sby + 168 * pu - 24 * pu; radius: 8 * pu; color: mint; opacity: if(theme_sel == 3, 100%, 0) }
            path { at: spx + 326 * pu + 86 * pu, sby + 168 * pu - 24 * pu; stroke: 1.6 * pu; color: onmint; opacity: if(theme_sel == 3, 100%, 0); move -3.4 * pu, 0; line -1 * pu, 2.8 * pu; line 3.6 * pu, -3 * pu }
            zone box theme_hit.3 { at: spx + 326 * pu, sby + 168 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu; cursor: pointer }
