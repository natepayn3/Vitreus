            ellipse { at: spx + 326 * pu - 41 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; color: #ebdbb2 }
            ellipse { at: spx + 326 * pu - 41 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 326 * pu - 19 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; color: #fabd2f }
            ellipse { at: spx + 326 * pu - 19 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
