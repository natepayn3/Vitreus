part Theme {
        //  The Theme page: the shell's colours. Either Iris reads them off the wallpaper, or one of the named palettes is chosen (logic: `theme_pick`);
        //  every palette goes through the same legibility floor, and the lock screen, the window borders and the rest follow it. Monochrome is Iris off.
        group {
            show: set_pgp > 0.01
            opacity: set_pgp
            text "Theme" { at: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: left center; size: 17.5; weight: 700; color: ink; family: "Space Grotesk" }
            text "Changes apply right away." { at: floor(spx + 424 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: right center; size: 13.5; color: faint; opacity: 80%; family: "Space Grotesk" }
            //  From the wallpaper
            box { at: spx + 112 * pu, sby + 84 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu; color: ink; opacity: veil + 5% * theme_hit.0.hover }
            box { at: spx + 112 * pu, sby + 84 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu; stroke: 1.6 * pu; color: mint; opacity: if(theme_sel == 0, 90%, 0) }
            text "From the wallpaper" { at: floor(spx + 112 * pu - 93 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; width: 150 * pu; lines: 1; color: if(theme_sel == 0, mint, ink); family: "Space Grotesk" }
            text "Colours picked from the picture" { at: floor(spx + 112 * pu - 93 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); anchor: left center; size: 12; weight: 500; width: 190 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            ellipse { at: spx + 112 * pu - 85 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: tint }
            ellipse { at: spx + 112 * pu - 85 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu - 63 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: panel }
            ellipse { at: spx + 112 * pu - 63 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu - 41 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: ink }
            ellipse { at: spx + 112 * pu - 41 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu - 19 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: mint }
            ellipse { at: spx + 112 * pu - 19 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu - -3 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: alert }
            ellipse { at: spx + 112 * pu - -3 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu + 86 * pu, sby + 84 * pu - 24 * pu; radius: 8 * pu; color: mint; opacity: if(theme_sel == 0, 100%, 0) }
            path { at: spx + 112 * pu + 86 * pu, sby + 84 * pu - 24 * pu; stroke: 1.6 * pu; color: onmint; opacity: if(theme_sel == 0, 100%, 0); move -3.4 * pu, 0; line -1 * pu, 2.8 * pu; line 3.6 * pu, -3 * pu }
            zone box theme_hit.0 { at: spx + 112 * pu, sby + 84 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu; cursor: pointer }
            on press theme_hit.0 { emit theme_pick(0) }
            //  Tokyo Night
            box { at: spx + 326 * pu, sby + 84 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu; color: ink; opacity: veil + 5% * theme_hit.1.hover }
            box { at: spx + 326 * pu, sby + 84 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu; stroke: 1.6 * pu; color: mint; opacity: if(theme_sel == 1, 90%, 0) }
            text "Tokyo Night" { at: floor(spx + 326 * pu - 93 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; width: 150 * pu; lines: 1; color: if(theme_sel == 1, mint, ink); family: "Space Grotesk" }
            text "A named palette" { at: floor(spx + 326 * pu - 93 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); anchor: left center; size: 12; weight: 500; width: 190 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            ellipse { at: spx + 326 * pu - 85 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: #1a1b26 }
