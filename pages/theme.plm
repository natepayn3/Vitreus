            ellipse { at: spx + 326 * pu - 41 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: #c0caf5 }
            ellipse { at: spx + 326 * pu - 41 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
