            path { at: spx + 112 * pu + 86 * pu, sby + 168 * pu - 24 * pu; stroke: 1.6 * pu; color: onmint; opacity: if(theme_sel == 2, 100%, 0); move -3.4 * pu, 0; line -1 * pu, 2.8 * pu; line 3.6 * pu, -3 * pu }
            zone box theme_hit.2 { at: spx + 112 * pu, sby + 168 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu; cursor: pointer }
            on press theme_hit.2 { emit theme_pick(2) }
            //  Gruvbox
