            ellipse { at: spx + 326 * pu - -3 * pu, sby + 336 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 326 * pu + 86 * pu, sby + 336 * pu - 24 * pu; radius: 8 * pu; color: mint; opacity: if(theme_sel == 7, 100%, 0) }
            path { at: spx + 326 * pu + 86 * pu, sby + 336 * pu - 24 * pu; stroke: 1.6 * pu; color: onmint; opacity: if(theme_sel == 7, 100%, 0); move -3.4 * pu, 0; line -1 * pu, 2.8 * pu; line 3.6 * pu, -3 * pu }
            zone box theme_hit.7 { at: spx + 326 * pu, sby + 336 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu; cursor: pointer }
            on press theme_hit.7 { emit theme_pick(7) }
            //  How strongly the wallpaper's accent is pushed, for the first one.
            text "ACCENT STRENGTH" { at: floor(spx + 14 * pu + 0.5), floor(sby + 410 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; opacity: 40% + 60% * if(theme_sel == 0, 1, 0); family: "Space Grotesk" }
            repeat k in 0..3 {
                let cx_ = spx + (130 + k * 100) * pu
                group {
                    opacity: 40% + 60% * if(theme_sel == 0, 1, 0)
                    box { at: cx_, sby + 410 * pu; size: 92 * pu, 26 * pu; corner: 13 * pu; color: if(iris_int == k, mint, ink); opacity: if(iris_int == k, 24%, 8% + 9% * iris_int_hit.$k.hover) }
                    text pick(k, "Subtle", "Medium", "Bold") { at: floor(cx_ + 0.5), floor(sby + 410 * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: if(iris_int == k, mint, ink); opacity: if(iris_int == k, 100%, 85%); family: "Space Grotesk" }
                    zone box iris_int_hit.$k { at: cx_, sby + 410 * pu; size: 94 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: theme_sel == 0 }
                    on press iris_int_hit.$k { emit iris_int_set(k) }
                }
            }
        }
}
