            group {
                clip inset 0 box { at: spx + 326 * pu, sby + 168 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu }
                body { gradient: spx + 326 * pu - 103 * pu, sby + 168 * pu to spx + 326 * pu + 103 * pu, sby + 168 * pu, mix(#282828, #000000, 0.66), mix(#282828, #000000, 0.54) 55%, mix(#282828, #000000, 0.1); path { at: spx + 326 * pu, sby + 168 * pu; move -182.9 * pu, -38 * pu; line -44.7 * pu, -38 * pu; line -78.9 * pu, 38 * pu; line -217.1 * pu, 38 * pu; close } }
                body { gradient: spx + 326 * pu - 103 * pu, sby + 168 * pu to spx + 326 * pu + 103 * pu, sby + 168 * pu, mix(#3c3836, #000000, 0.66), mix(#3c3836, #000000, 0.54) 55%, mix(#3c3836, #000000, 0.1); path { at: spx + 326 * pu, sby + 168 * pu; move -44.7 * pu, -38 * pu; line -3.5 * pu, -38 * pu; line -37.7 * pu, 38 * pu; line -78.9 * pu, 38 * pu; close } }
                body { gradient: spx + 326 * pu - 103 * pu, sby + 168 * pu to spx + 326 * pu + 103 * pu, sby + 168 * pu, mix(#ebdbb2, #000000, 0.66), mix(#ebdbb2, #000000, 0.54) 55%, mix(#ebdbb2, #000000, 0.1); path { at: spx + 326 * pu, sby + 168 * pu; move -3.5 * pu, -38 * pu; line 37.7 * pu, -38 * pu; line 3.5 * pu, 38 * pu; line -37.7 * pu, 38 * pu; close } }
