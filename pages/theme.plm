part Theme {
        //  The Theme page: the shell's colours. Either Iris reads them off the wallpaper, or one of the named palettes is chosen (logic: `theme_pick`);
        //  every palette goes through the same legibility floor, and the lock screen, the window borders and the rest follow it. Monochrome is Iris off.
        group {
            show: set_pgp > 0.01
            opacity: set_pgp
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); text "Theme" { at: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: left center; size: 17.5; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 16 * pu + 0.5); text "Changes apply right away." { at: floor(spx + 424 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: right center; size: 13.5; color: faint; opacity: 80%; family: "Space Grotesk" } }
            //  From the wallpaper
            //  Its five colours as broad slanted stripes, fading from dark on the left, where the words are, to their true colours on the right.
            group {
                clip inset 0 box { at: spx + 112 * pu, sby + 84 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu }
                body { gradient: spx + 112 * pu - 103 * pu, sby + 84 * pu to spx + 112 * pu + 103 * pu, sby + 84 * pu, mix(wcol.tint, #000000, 0.66), mix(wcol.tint, #000000, 0.54) 55%, mix(wcol.tint, #000000, 0.1); path { at: spx + 112 * pu, sby + 84 * pu; move -182.9 * pu, -38 * pu; line -44.7 * pu, -38 * pu; line -78.9 * pu, 38 * pu; line -217.1 * pu, 38 * pu; close } }
                body { gradient: spx + 112 * pu - 103 * pu, sby + 84 * pu to spx + 112 * pu + 103 * pu, sby + 84 * pu, mix(wcol.panel, #000000, 0.66), mix(wcol.panel, #000000, 0.54) 55%, mix(wcol.panel, #000000, 0.1); path { at: spx + 112 * pu, sby + 84 * pu; move -44.7 * pu, -38 * pu; line -3.5 * pu, -38 * pu; line -37.7 * pu, 38 * pu; line -78.9 * pu, 38 * pu; close } }
                body { gradient: spx + 112 * pu - 103 * pu, sby + 84 * pu to spx + 112 * pu + 103 * pu, sby + 84 * pu, mix(wcol.ink, #000000, 0.66), mix(wcol.ink, #000000, 0.54) 55%, mix(wcol.ink, #000000, 0.1); path { at: spx + 112 * pu, sby + 84 * pu; move -3.5 * pu, -38 * pu; line 37.7 * pu, -38 * pu; line 3.5 * pu, 38 * pu; line -37.7 * pu, 38 * pu; close } }
                body { gradient: spx + 112 * pu - 103 * pu, sby + 84 * pu to spx + 112 * pu + 103 * pu, sby + 84 * pu, mix(wcol.mint, #000000, 0.66), mix(wcol.mint, #000000, 0.54) 55%, mix(wcol.mint, #000000, 0.1); path { at: spx + 112 * pu, sby + 84 * pu; move 37.7 * pu, -38 * pu; line 78.9 * pu, -38 * pu; line 44.7 * pu, 38 * pu; line 3.5 * pu, 38 * pu; close } }
                body { gradient: spx + 112 * pu - 103 * pu, sby + 84 * pu to spx + 112 * pu + 103 * pu, sby + 84 * pu, mix(wcol.alert, #000000, 0.66), mix(wcol.alert, #000000, 0.54) 55%, mix(wcol.alert, #000000, 0.1); path { at: spx + 112 * pu, sby + 84 * pu; move 78.9 * pu, -38 * pu; line 217.1 * pu, -38 * pu; line 182.9 * pu, 38 * pu; line 44.7 * pu, 38 * pu; close } }
                box { at: spx + 112 * pu, sby + 84 * pu; size: 206 * pu, 76 * pu; color: #ffffff; opacity: 8% * theme_hit.0.hover }
            }
            box { at: spx + 112 * pu, sby + 84 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu; stroke: 1.6 * pu; color: mint; opacity: if(theme_sel == 0, 90%, 0) }
            group { scale: rs; pivot: floor(spx + 112 * pu - 93 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); text "From the wallpaper" { at: floor(spx + 112 * pu - 93 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; width: (150 * pu) / rs; lines: 1; color: if(theme_sel == 0, mint, ink); family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 112 * pu - 93 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); text "Colours picked from the picture" { at: floor(spx + 112 * pu - 93 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); anchor: left center; size: 12; weight: 500; width: (190 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            ellipse { at: spx + 112 * pu - 85 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: wcol.tint }
            ellipse { at: spx + 112 * pu - 85 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu - 63 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: wcol.panel }
            ellipse { at: spx + 112 * pu - 63 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu - 41 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: wcol.ink }
            ellipse { at: spx + 112 * pu - 41 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu - 19 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: wcol.mint }
            ellipse { at: spx + 112 * pu - 19 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu - -3 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: wcol.alert }
            ellipse { at: spx + 112 * pu - -3 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu + 86 * pu, sby + 84 * pu - 24 * pu; radius: 8 * pu; color: mint; opacity: if(theme_sel == 0, 100%, 0) }
            path { at: spx + 112 * pu + 86 * pu, sby + 84 * pu - 24 * pu; stroke: 1.6 * pu; color: onmint; opacity: if(theme_sel == 0, 100%, 0); move -3.4 * pu, 0; line -1 * pu, 2.8 * pu; line 3.6 * pu, -3 * pu }
            zone box theme_hit.0 { at: spx + 112 * pu, sby + 84 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu; cursor: pointer }
            on press theme_hit.0 { emit theme_pick(0) }
            //  Tokyo Night
            //  Its five colours as broad slanted stripes, fading from dark on the left, where the words are, to their true colours on the right.
            group {
                clip inset 0 box { at: spx + 326 * pu, sby + 84 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu }
                body { gradient: spx + 326 * pu - 103 * pu, sby + 84 * pu to spx + 326 * pu + 103 * pu, sby + 84 * pu, mix(#1a1b26, #000000, 0.66), mix(#1a1b26, #000000, 0.54) 55%, mix(#1a1b26, #000000, 0.1); path { at: spx + 326 * pu, sby + 84 * pu; move -182.9 * pu, -38 * pu; line -44.7 * pu, -38 * pu; line -78.9 * pu, 38 * pu; line -217.1 * pu, 38 * pu; close } }
                body { gradient: spx + 326 * pu - 103 * pu, sby + 84 * pu to spx + 326 * pu + 103 * pu, sby + 84 * pu, mix(#24283b, #000000, 0.66), mix(#24283b, #000000, 0.54) 55%, mix(#24283b, #000000, 0.1); path { at: spx + 326 * pu, sby + 84 * pu; move -44.7 * pu, -38 * pu; line -3.5 * pu, -38 * pu; line -37.7 * pu, 38 * pu; line -78.9 * pu, 38 * pu; close } }
                body { gradient: spx + 326 * pu - 103 * pu, sby + 84 * pu to spx + 326 * pu + 103 * pu, sby + 84 * pu, mix(#c0caf5, #000000, 0.66), mix(#c0caf5, #000000, 0.54) 55%, mix(#c0caf5, #000000, 0.1); path { at: spx + 326 * pu, sby + 84 * pu; move -3.5 * pu, -38 * pu; line 37.7 * pu, -38 * pu; line 3.5 * pu, 38 * pu; line -37.7 * pu, 38 * pu; close } }
                body { gradient: spx + 326 * pu - 103 * pu, sby + 84 * pu to spx + 326 * pu + 103 * pu, sby + 84 * pu, mix(#7aa2f7, #000000, 0.66), mix(#7aa2f7, #000000, 0.54) 55%, mix(#7aa2f7, #000000, 0.1); path { at: spx + 326 * pu, sby + 84 * pu; move 37.7 * pu, -38 * pu; line 78.9 * pu, -38 * pu; line 44.7 * pu, 38 * pu; line 3.5 * pu, 38 * pu; close } }
                body { gradient: spx + 326 * pu - 103 * pu, sby + 84 * pu to spx + 326 * pu + 103 * pu, sby + 84 * pu, mix(#f7768e, #000000, 0.66), mix(#f7768e, #000000, 0.54) 55%, mix(#f7768e, #000000, 0.1); path { at: spx + 326 * pu, sby + 84 * pu; move 78.9 * pu, -38 * pu; line 217.1 * pu, -38 * pu; line 182.9 * pu, 38 * pu; line 44.7 * pu, 38 * pu; close } }
                box { at: spx + 326 * pu, sby + 84 * pu; size: 206 * pu, 76 * pu; color: #ffffff; opacity: 8% * theme_hit.1.hover }
            }
            box { at: spx + 326 * pu, sby + 84 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu; stroke: 1.6 * pu; color: mint; opacity: if(theme_sel == 1, 90%, 0) }
            group { scale: rs; pivot: floor(spx + 326 * pu - 93 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); text "Tokyo Night" { at: floor(spx + 326 * pu - 93 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; width: (150 * pu) / rs; lines: 1; color: if(theme_sel == 1, mint, ink); family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 326 * pu - 93 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); text "A named palette" { at: floor(spx + 326 * pu - 93 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); anchor: left center; size: 12; weight: 500; width: (190 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            ellipse { at: spx + 326 * pu - 85 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: #1a1b26 }
            ellipse { at: spx + 326 * pu - 85 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 326 * pu - 63 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: #24283b }
            ellipse { at: spx + 326 * pu - 63 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 326 * pu - 41 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: #c0caf5 }
            ellipse { at: spx + 326 * pu - 41 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 326 * pu - 19 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: #7aa2f7 }
            ellipse { at: spx + 326 * pu - 19 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 326 * pu - -3 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; color: #f7768e }
            ellipse { at: spx + 326 * pu - -3 * pu, sby + 84 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 326 * pu + 86 * pu, sby + 84 * pu - 24 * pu; radius: 8 * pu; color: mint; opacity: if(theme_sel == 1, 100%, 0) }
            path { at: spx + 326 * pu + 86 * pu, sby + 84 * pu - 24 * pu; stroke: 1.6 * pu; color: onmint; opacity: if(theme_sel == 1, 100%, 0); move -3.4 * pu, 0; line -1 * pu, 2.8 * pu; line 3.6 * pu, -3 * pu }
            zone box theme_hit.1 { at: spx + 326 * pu, sby + 84 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu; cursor: pointer }
            on press theme_hit.1 { emit theme_pick(1) }
            //  Catppuccin Mocha
            //  Its five colours as broad slanted stripes, fading from dark on the left, where the words are, to their true colours on the right.
            group {
                clip inset 0 box { at: spx + 112 * pu, sby + 168 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu }
                body { gradient: spx + 112 * pu - 103 * pu, sby + 168 * pu to spx + 112 * pu + 103 * pu, sby + 168 * pu, mix(#1e1e2e, #000000, 0.66), mix(#1e1e2e, #000000, 0.54) 55%, mix(#1e1e2e, #000000, 0.1); path { at: spx + 112 * pu, sby + 168 * pu; move -182.9 * pu, -38 * pu; line -44.7 * pu, -38 * pu; line -78.9 * pu, 38 * pu; line -217.1 * pu, 38 * pu; close } }
                body { gradient: spx + 112 * pu - 103 * pu, sby + 168 * pu to spx + 112 * pu + 103 * pu, sby + 168 * pu, mix(#313244, #000000, 0.66), mix(#313244, #000000, 0.54) 55%, mix(#313244, #000000, 0.1); path { at: spx + 112 * pu, sby + 168 * pu; move -44.7 * pu, -38 * pu; line -3.5 * pu, -38 * pu; line -37.7 * pu, 38 * pu; line -78.9 * pu, 38 * pu; close } }
                body { gradient: spx + 112 * pu - 103 * pu, sby + 168 * pu to spx + 112 * pu + 103 * pu, sby + 168 * pu, mix(#cdd6f4, #000000, 0.66), mix(#cdd6f4, #000000, 0.54) 55%, mix(#cdd6f4, #000000, 0.1); path { at: spx + 112 * pu, sby + 168 * pu; move -3.5 * pu, -38 * pu; line 37.7 * pu, -38 * pu; line 3.5 * pu, 38 * pu; line -37.7 * pu, 38 * pu; close } }
                body { gradient: spx + 112 * pu - 103 * pu, sby + 168 * pu to spx + 112 * pu + 103 * pu, sby + 168 * pu, mix(#cba6f7, #000000, 0.66), mix(#cba6f7, #000000, 0.54) 55%, mix(#cba6f7, #000000, 0.1); path { at: spx + 112 * pu, sby + 168 * pu; move 37.7 * pu, -38 * pu; line 78.9 * pu, -38 * pu; line 44.7 * pu, 38 * pu; line 3.5 * pu, 38 * pu; close } }
                body { gradient: spx + 112 * pu - 103 * pu, sby + 168 * pu to spx + 112 * pu + 103 * pu, sby + 168 * pu, mix(#f38ba8, #000000, 0.66), mix(#f38ba8, #000000, 0.54) 55%, mix(#f38ba8, #000000, 0.1); path { at: spx + 112 * pu, sby + 168 * pu; move 78.9 * pu, -38 * pu; line 217.1 * pu, -38 * pu; line 182.9 * pu, 38 * pu; line 44.7 * pu, 38 * pu; close } }
                box { at: spx + 112 * pu, sby + 168 * pu; size: 206 * pu, 76 * pu; color: #ffffff; opacity: 8% * theme_hit.2.hover }
            }
            box { at: spx + 112 * pu, sby + 168 * pu; size: 206 * pu, 76 * pu; corner: 14 * pu; stroke: 1.6 * pu; color: mint; opacity: if(theme_sel == 2, 90%, 0) }
            group { scale: rs; pivot: floor(spx + 112 * pu - 93 * pu + 0.5), floor(sby + 168 * pu - 17 * pu + 0.5); text "Catppuccin Mocha" { at: floor(spx + 112 * pu - 93 * pu + 0.5), floor(sby + 168 * pu - 17 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; width: (150 * pu) / rs; lines: 1; color: if(theme_sel == 2, mint, ink); family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 112 * pu - 93 * pu + 0.5), floor(sby + 168 * pu + 4 * pu + 0.5); text "A named palette" { at: floor(spx + 112 * pu - 93 * pu + 0.5), floor(sby + 168 * pu + 4 * pu + 0.5); anchor: left center; size: 12; weight: 500; width: (190 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            ellipse { at: spx + 112 * pu - 85 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; color: #1e1e2e }
            ellipse { at: spx + 112 * pu - 85 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu - 63 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; color: #313244 }
            ellipse { at: spx + 112 * pu - 63 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu - 41 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; color: #cdd6f4 }
            ellipse { at: spx + 112 * pu - 41 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu - 19 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; color: #cba6f7 }
            ellipse { at: spx + 112 * pu - 19 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 112 * pu - -3 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; color: #f38ba8 }
            ellipse { at: spx + 112 * pu - -3 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
