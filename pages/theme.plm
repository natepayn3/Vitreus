            group { scale: rs; pivot: floor(spx + 326 * pu - 93 * pu + 0.5), floor(sby + 168 * pu - 17 * pu + 0.5); text "Gruvbox" { at: floor(spx + 326 * pu - 93 * pu + 0.5), floor(sby + 168 * pu - 17 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; width: (150 * pu) / rs; lines: 1; color: if(theme_sel == 3, mint, ink); family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 326 * pu - 93 * pu + 0.5), floor(sby + 168 * pu + 4 * pu + 0.5); text "A named palette" { at: floor(spx + 326 * pu - 93 * pu + 0.5), floor(sby + 168 * pu + 4 * pu + 0.5); anchor: left center; size: 12; weight: 500; width: (190 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            ellipse { at: spx + 326 * pu - 85 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; color: #282828 }
            ellipse { at: spx + 326 * pu - 85 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 326 * pu - 63 * pu, sby + 168 * pu + 24 * pu; radius: 8 * pu; color: #3c3836 }
