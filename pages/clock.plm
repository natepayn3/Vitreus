                gradient: 0, sby + (770 + (sy_my - 1) * 22) * pu - 7 * pu to 0, sby + (770 + (sy_my - 1) * 22) * pu + 7 * pu, minthi, mintlo
                rim: 45%
                shadow: 0, 0, 6 * pu, 30%, mint
                box { at: spx + (74 + (sy_mx - 1) * 40) * pu, sby + (770 + (sy_my - 1) * 22) * pu; size: 28 * pu, 14 * pu; corner: 4 * pu }
            }
            group { scale: rs; pivot: floor(spx + 156 * pu + 0.5), floor(sby + 724 * pu + 0.5); text "Glass" { at: floor(spx + 156 * pu + 0.5), floor(sby + 724 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" } }
            box { at: spx + 187 * pu, sby + 746 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, syc0); opacity: 8% + 20% * syc0 + 6% * sy_c0.hover }
            group { scale: rs; pivot: floor(spx + 187 * pu + 0.5), floor(sby + 746 * pu + 0.5); text "Clear" { at: floor(spx + 187 * pu + 0.5), floor(sby + 746 * pu + 0.5); anchor: center; align: center; size: 12.5; weight: 700; width: (58 * pu) / rs; lines: 1; color: mix(ink, mint, syc0); family: "Space Grotesk" } }
            zone box sy_c0 { at: spx + 187 * pu, sby + 746 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 746 * pu) - ck.off > sby and (sby + 746 * pu) - ck.off < sby + set.h * pu }
            on press sy_c0 { emit sy_cl_set(0) }
            box { at: spx + 253 * pu, sby + 746 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, syc1); opacity: 8% + 20% * syc1 + 6% * sy_c1.hover }
            group { scale: rs; pivot: floor(spx + 253 * pu + 0.5), floor(sby + 746 * pu + 0.5); text "Soft" { at: floor(spx + 253 * pu + 0.5), floor(sby + 746 * pu + 0.5); anchor: center; align: center; size: 12.5; weight: 700; width: (58 * pu) / rs; lines: 1; color: mix(ink, mint, syc1); family: "Space Grotesk" } }
            zone box sy_c1 { at: spx + 253 * pu, sby + 746 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 746 * pu) - ck.off > sby and (sby + 746 * pu) - ck.off < sby + set.h * pu }
            on press sy_c1 { emit sy_cl_set(1) }
            box { at: spx + 319 * pu, sby + 746 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, syc2); opacity: 8% + 20% * syc2 + 6% * sy_c2.hover }
            group { scale: rs; pivot: floor(spx + 319 * pu + 0.5), floor(sby + 746 * pu + 0.5); text "Full" { at: floor(spx + 319 * pu + 0.5), floor(sby + 746 * pu + 0.5); anchor: center; align: center; size: 12.5; weight: 700; width: (58 * pu) / rs; lines: 1; color: mix(ink, mint, syc2); family: "Space Grotesk" } }
            zone box sy_c2 { at: spx + 319 * pu, sby + 746 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 746 * pu) - ck.off > sby and (sby + 746 * pu) - ck.off < sby + set.h * pu }
            on press sy_c2 { emit sy_cl_set(2) }

            }

            let ck.thh = set.h * set.h / max(set.h, ck.h)
            let ck.thy = ck.thh / 2 + ck.sc / max(1, ck.h - set.h) * (set.h - ck.thh)
            box { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: if(ck.h > set.h, 6%, 0%) }
            box { at: spx + 442 * pu, sby + ck.thy * pu; size: 3 * pu, ck.thh * pu; corner: 1.5 * pu; color: mint; opacity: if(ck.h > set.h, 55%, 0%) }
            let ck.cue = clamp((ck.h - set.h - ck.sc) / 24, 0, 1)
            let ck.cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * ck.cue }
            }
            box { at: spx + 224 * pu, ck.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * ck.cue }
            box { at: spx + 224 * pu, ck.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * ck_cue_hit.hover) * ck.cue }
            path { at: spx + 204 * pu, ck.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: ck.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, ck.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: ck.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            group { scale: rs; pivot: floor(spx + 232 * pu + 0.5), floor(ck.cuey + 0.5); text "More" { at: floor(spx + 232 * pu + 0.5), floor(ck.cuey + 0.5); anchor: center; size: 15; weight: 700; color: ink; opacity: ck.cue; family: "Space Grotesk" } }
            zone box ck_cue_hit { at: spx + 224 * pu, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: ck.cue > 0.5 }
            on press ck_cue_hit { ck_scroll_to = clamp(ck_scroll_to + 342, 0, max(0, ck.h - set.h)) }
            zone box ck_bar_hit { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: ck.h > set.h }
            on press ck_bar_hit { ck_scroll_to = clamp(((pointer.y - sby) / pu - ck.thh / 2) / max(1, set.h - ck.thh) * (ck.h - set.h), 0, max(0, ck.h - set.h)) }
            on drag ck_bar_hit { ck_scroll_to = clamp(((pointer.y - sby) / pu - ck.thh / 2) / max(1, set.h - ck.thh) * (ck.h - set.h), 0, max(0, ck.h - set.h)) }
        }
        //  ── Widgets page: END ──
}
