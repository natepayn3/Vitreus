part Clock {
        //  ── Widgets page: BEGIN ──
        //  Settings > Widgets. First the desktop clock (desktopclock/): its switch, the layout as badges (each one is the real clock face, small), where it sits
        //  on a grid of the screen, its size and hours, and its look. The scene keeps the settings (desktopclock.json); the logic asks it for them when the
        //  page opens and tells it each change. See "Settings > Clock" in the logic. Then the desktop system monitor (desktopsysmon/), the same way. The page scrolls like the Lock screen's.
        group {
            show: set_pgk > 0.01
            opacity: set_pgk
            let ck.sc = clamp(ck_scroll, 0, max(0, ck.h - set.h))
            let ck.off = floor(ck.sc * pu + 0.5)        // whole pixels: text that is shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pu, sby + set.h / 2 * pu; size: 456 * pu, set.h * pu }
            zone box ck_wheel { at: spx + 219 * pu, sby + set.h / 2 * pu; size: 446 * pu, set.h * pu }
            on scroll ck_wheel { ck_scroll_to = clamp(ck_scroll_to - wheel * 44, 0, max(0, ck.h - set.h)) }
            group {
            move: 0, -ck.off
            let ckl0 = if(ck_lay == 0, 1, 0)
            let ckl1 = if(ck_lay == 1, 1, 0)
            let ckl2 = if(ck_lay == 2, 1, 0)
            let ckl3 = if(ck_lay == 3, 1, 0)
            let ckl4 = if(ck_lay == 4, 1, 0)
            let ckl5 = if(ck_lay == 5, 1, 0)
            let cks0 = if(ck_px < 180, 1, 0)
            let cks1 = if(ck_px >= 180 and ck_px < 250, 1, 0)
            let cks2 = if(ck_px >= 250 and ck_px < 310, 1, 0)
            let cks3 = if(ck_px >= 310, 1, 0)
            let ckh12 = if(ck_12h, 1, 0)
            let ckh24 = 1 - ckh12
            let ckw0 = if(ck_wt == 0, 1, 0)
            let ckw1 = if(ck_wt == 1, 1, 0)
            let ckw2 = if(ck_wt == 2, 1, 0)
            let ckc0 = if(ck_cl == 0, 1, 0)
            let ckc1 = if(ck_cl == 1, 1, 0)
            let ckc2 = if(ck_cl == 2, 1, 0)
            let gl_s0 = if(gl_sel == 0, 1, 0)
            let gl_s1 = if(gl_sel == 1, 1, 0)
            let gl_s2 = if(gl_sel == 2, 1, 0)
            let gwb0f = if(gl_w == 0, 1, 0)
            let gwb1f = if(gl_w == 1, 1, 0)
            let gwb2f = if(gl_w == 2, 1, 0)
            let gwb3f = if(gl_w == 3, 1, 0)
            let gwb4f = if(gl_w == 4, 1, 0)
            let gzb0f = if(gl_z == 0, 1, 0)
            let gzb1f = if(gl_z == 1, 1, 0)
            let gzb2f = if(gl_z == 2, 1, 0)
            let gzb3f = if(gl_z == 3, 1, 0)
            let gzb4f = if(gl_z == 4, 1, 0)
            let gcb0f = if(gl_c == 0, 1, 0)
            let gcb1f = if(gl_c == 1, 1, 0)
            let gcb2f = if(gl_c == 2, 1, 0)
            let gcb3f = if(gl_c == 3, 1, 0)
            let gcb4f = if(gl_c == 4, 1, 0)
            let syc0 = if(sy_cl == 0, 1, 0)
            let syc1 = if(sy_cl == 1, 1, 0)
            let syc2 = if(sy_cl == 2, 1, 0)

            //  The switch.
            box { at: spx + 219 * pu, sby + 34 * pu; size: 438 * pu, 56 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Desktop clock" { at: floor(spx + 14 * pu + 0.5), floor(sby + 24 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Digits of glass on your wallpaper, under the windows" { at: floor(spx + 14 * pu + 0.5), floor(sby + 44 * pu + 0.5); anchor: left center; size: 12.5; color: faint; show: ck_ok; family: "Space Grotesk" }
            text "Not running: turn the switch on to start it" { at: floor(spx + 14 * pu + 0.5), floor(sby + 44 * pu + 0.5); anchor: left center; size: 12.5; color: faint; show: not ck_ok; family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(ck_pill, 0, 1))
                box { at: spx + 405 * pu, sby + 34 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu }
            }
            box { at: spx + 397 * pu + ck_pill * 16 * pu, sby + 34 * pu; size: (17 + 9 * clamp(4 * ck_pill * (1 - ck_pill), 0, 1)) * pu, (17 - 3 * clamp(4 * ck_pill * (1 - ck_pill), 0, 1)) * pu; corner: 7 * pu; color: ink }
            zone box ck_hit { at: spx + 405 * pu, sby + 34 * pu; size: 46 * pu, 30 * pu; cursor: pointer; active: (sby + 34 * pu) - ck.off > sby and (sby + 34 * pu) - ck.off < sby + set.h * pu }
            on press ck_hit { emit ck_toggle }

            //  The layouts: a badge each.
            box { at: spx + 219 * pu, sby + 120 * pu; size: 438 * pu, 100 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Layout" { at: floor(spx + 14 * pu + 0.5), floor(sby + 84 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: spx + 46 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; color: mix(ink, mint, ckl0); opacity: 7% + 20% * ckl0 + 6% * ck_l0.hover }
            box { at: spx + 46 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; stroke: 1.3 * pu; color: mint; opacity: 75% * ckl0 }
            ClockFace(0.145 * pu, 0, 1, 2, 3, 4, spx + 46 * pu, sby + 125 * pu, mix(ink, mint, ckl0), 0, 0.5, 60% + 40% * ckl0, 1)
            zone box ck_l0 { at: spx + 46 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 125 * pu) - ck.off > sby and (sby + 125 * pu) - ck.off < sby + set.h * pu }
            on press ck_l0 { emit ck_lay_set(0) }
            text "Pipe" { at: floor(spx + 46 * pu + 0.5), floor(sby + 160 * pu + 0.5); anchor: center; size: 11.5; weight: 600; color: mix(faint, mint, ckl0); family: "Space Grotesk" }
            box { at: spx + 116 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; color: mix(ink, mint, ckl1); opacity: 7% + 20% * ckl1 + 6% * ck_l1.hover }
            box { at: spx + 116 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; stroke: 1.3 * pu; color: mint; opacity: 75% * ckl1 }
            ClockFace(0.145 * pu, 1, 1, 2, 3, 4, spx + 116 * pu, sby + 125 * pu, mix(ink, mint, ckl1), 0, 0.5, 60% + 40% * ckl1, 1)
            zone box ck_l1 { at: spx + 116 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 125 * pu) - ck.off > sby and (sby + 125 * pu) - ck.off < sby + set.h * pu }
            on press ck_l1 { emit ck_lay_set(1) }
            text "Rule" { at: floor(spx + 116 * pu + 0.5), floor(sby + 160 * pu + 0.5); anchor: center; size: 11.5; weight: 600; color: mix(faint, mint, ckl1); family: "Space Grotesk" }
            box { at: spx + 186 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; color: mix(ink, mint, ckl2); opacity: 7% + 20% * ckl2 + 6% * ck_l2.hover }
            box { at: spx + 186 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; stroke: 1.3 * pu; color: mint; opacity: 75% * ckl2 }
            ClockFace(0.145 * pu, 2, 1, 2, 3, 4, spx + 186 * pu, sby + 125 * pu, mix(ink, mint, ckl2), 0, 0.5, 60% + 40% * ckl2, 1)
            zone box ck_l2 { at: spx + 186 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 125 * pu) - ck.off > sby and (sby + 125 * pu) - ck.off < sby + set.h * pu }
            on press ck_l2 { emit ck_lay_set(2) }
            text "Tower" { at: floor(spx + 186 * pu + 0.5), floor(sby + 160 * pu + 0.5); anchor: center; size: 11.5; weight: 600; color: mix(faint, mint, ckl2); family: "Space Grotesk" }
            box { at: spx + 256 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; color: mix(ink, mint, ckl3); opacity: 7% + 20% * ckl3 + 6% * ck_l3.hover }
            box { at: spx + 256 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; stroke: 1.3 * pu; color: mint; opacity: 75% * ckl3 }
            ClockFace(0.145 * pu, 3, 1, 2, 3, 4, spx + 256 * pu, sby + 125 * pu, mix(ink, mint, ckl3), 0, 0.5, 60% + 40% * ckl3, 1)
            zone box ck_l3 { at: spx + 256 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 125 * pu) - ck.off > sby and (sby + 125 * pu) - ck.off < sby + set.h * pu }
            on press ck_l3 { emit ck_lay_set(3) }
            text "Digital" { at: floor(spx + 256 * pu + 0.5), floor(sby + 160 * pu + 0.5); anchor: center; size: 11.5; weight: 600; color: mix(faint, mint, ckl3); family: "Space Grotesk" }
            box { at: spx + 326 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; color: mix(ink, mint, ckl4); opacity: 7% + 20% * ckl4 + 6% * ck_l4.hover }
            box { at: spx + 326 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; stroke: 1.3 * pu; color: mint; opacity: 75% * ckl4 }
            ClockFace(0.145 * pu, 4, 1, 2, 3, 4, spx + 326 * pu, sby + 125 * pu, mix(ink, mint, ckl4), 0, 0.5, 60% + 40% * ckl4, 1)
            zone box ck_l4 { at: spx + 326 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 125 * pu) - ck.off > sby and (sby + 125 * pu) - ck.off < sby + set.h * pu }
            on press ck_l4 { emit ck_lay_set(4) }
            text "Slash" { at: floor(spx + 326 * pu + 0.5), floor(sby + 160 * pu + 0.5); anchor: center; size: 11.5; weight: 600; color: mix(faint, mint, ckl4); family: "Space Grotesk" }
            box { at: spx + 396 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; color: mix(ink, mint, ckl5); opacity: 7% + 20% * ckl5 + 6% * ck_l5.hover }
            box { at: spx + 396 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; stroke: 1.3 * pu; color: mint; opacity: 75% * ckl5 }
            ClockFace(0.145 * pu, 5, 1, 2, 3, 4, spx + 396 * pu, sby + 125 * pu, mix(ink, mint, ckl5), 0, 0.5, 60% + 40% * ckl5, 1)
            zone box ck_l5 { at: spx + 396 * pu, sby + 125 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 125 * pu) - ck.off > sby and (sby + 125 * pu) - ck.off < sby + set.h * pu }
            on press ck_l5 { emit ck_lay_set(5) }
            text "Hero" { at: floor(spx + 396 * pu + 0.5), floor(sby + 160 * pu + 0.5); anchor: center; size: 11.5; weight: 600; color: mix(faint, mint, ckl5); family: "Space Grotesk" }

            //  Where it sits: the screen as a grid of nine, and the clock's marker on one of them.
            box { at: spx + 219 * pu, sby + 232 * pu; size: 438 * pu, 104 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Position" { at: floor(spx + 14 * pu + 0.5), floor(sby + 194 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" }
            body {
                color: deep
                rim: 14%
                box { at: spx + 74 * pu, sby + 240 * pu; size: 120 * pu, 66 * pu; corner: 7 * pu }
            }
            ellipse { at: spx + 34 * pu, sby + 218 * pu; radius: 1.8 * pu; color: ink; opacity: 25% + 45% * ck_pc0.hover }
            zone box ck_pc0 { at: spx + 34 * pu, sby + 218 * pu; size: 40 * pu, 22 * pu; cursor: pointer; active: (sby + 218 * pu) - ck.off > sby and (sby + 218 * pu) - ck.off < sby + set.h * pu }
            on press ck_pc0 { emit ck_pos_set(0) }
            ellipse { at: spx + 74 * pu, sby + 218 * pu; radius: 1.8 * pu; color: ink; opacity: 25% + 45% * ck_pc1.hover }
            zone box ck_pc1 { at: spx + 74 * pu, sby + 218 * pu; size: 40 * pu, 22 * pu; cursor: pointer; active: (sby + 218 * pu) - ck.off > sby and (sby + 218 * pu) - ck.off < sby + set.h * pu }
            on press ck_pc1 { emit ck_pos_set(1) }
            ellipse { at: spx + 114 * pu, sby + 218 * pu; radius: 1.8 * pu; color: ink; opacity: 25% + 45% * ck_pc2.hover }
            zone box ck_pc2 { at: spx + 114 * pu, sby + 218 * pu; size: 40 * pu, 22 * pu; cursor: pointer; active: (sby + 218 * pu) - ck.off > sby and (sby + 218 * pu) - ck.off < sby + set.h * pu }
            on press ck_pc2 { emit ck_pos_set(2) }
            ellipse { at: spx + 34 * pu, sby + 240 * pu; radius: 1.8 * pu; color: ink; opacity: 25% + 45% * ck_pc3.hover }
            zone box ck_pc3 { at: spx + 34 * pu, sby + 240 * pu; size: 40 * pu, 22 * pu; cursor: pointer; active: (sby + 240 * pu) - ck.off > sby and (sby + 240 * pu) - ck.off < sby + set.h * pu }
            on press ck_pc3 { emit ck_pos_set(3) }
            ellipse { at: spx + 74 * pu, sby + 240 * pu; radius: 1.8 * pu; color: ink; opacity: 25% + 45% * ck_pc4.hover }
            zone box ck_pc4 { at: spx + 74 * pu, sby + 240 * pu; size: 40 * pu, 22 * pu; cursor: pointer; active: (sby + 240 * pu) - ck.off > sby and (sby + 240 * pu) - ck.off < sby + set.h * pu }
            on press ck_pc4 { emit ck_pos_set(4) }
            ellipse { at: spx + 114 * pu, sby + 240 * pu; radius: 1.8 * pu; color: ink; opacity: 25% + 45% * ck_pc5.hover }
            zone box ck_pc5 { at: spx + 114 * pu, sby + 240 * pu; size: 40 * pu, 22 * pu; cursor: pointer; active: (sby + 240 * pu) - ck.off > sby and (sby + 240 * pu) - ck.off < sby + set.h * pu }
            on press ck_pc5 { emit ck_pos_set(5) }
            ellipse { at: spx + 34 * pu, sby + 262 * pu; radius: 1.8 * pu; color: ink; opacity: 25% + 45% * ck_pc6.hover }
            zone box ck_pc6 { at: spx + 34 * pu, sby + 262 * pu; size: 40 * pu, 22 * pu; cursor: pointer; active: (sby + 262 * pu) - ck.off > sby and (sby + 262 * pu) - ck.off < sby + set.h * pu }
            on press ck_pc6 { emit ck_pos_set(6) }
            ellipse { at: spx + 74 * pu, sby + 262 * pu; radius: 1.8 * pu; color: ink; opacity: 25% + 45% * ck_pc7.hover }
            zone box ck_pc7 { at: spx + 74 * pu, sby + 262 * pu; size: 40 * pu, 22 * pu; cursor: pointer; active: (sby + 262 * pu) - ck.off > sby and (sby + 262 * pu) - ck.off < sby + set.h * pu }
            on press ck_pc7 { emit ck_pos_set(7) }
            ellipse { at: spx + 114 * pu, sby + 262 * pu; radius: 1.8 * pu; color: ink; opacity: 25% + 45% * ck_pc8.hover }
            zone box ck_pc8 { at: spx + 114 * pu, sby + 262 * pu; size: 40 * pu, 22 * pu; cursor: pointer; active: (sby + 262 * pu) - ck.off > sby and (sby + 262 * pu) - ck.off < sby + set.h * pu }
            on press ck_pc8 { emit ck_pos_set(8) }
            body {
                gradient: 0, sby + (240 + (ck_my - 1) * 22) * pu - 7 * pu to 0, sby + (240 + (ck_my - 1) * 22) * pu + 7 * pu, minthi, mintlo
                rim: 45%
                shadow: 0, 0, 6 * pu, 30%, mint
                box { at: spx + (74 + (ck_mx - 1) * 40) * pu, sby + (240 + (ck_my - 1) * 22) * pu; size: 28 * pu, 14 * pu; corner: 4 * pu }
            }
            text "Size" { at: floor(spx + 156 * pu + 0.5), floor(sby + 194 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: spx + 187 * pu, sby + 216 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, cks0); opacity: 8% + 20% * cks0 + 6% * ck_s0.hover }
            text "Small" { at: floor(spx + 187 * pu + 0.5), floor(sby + 216 * pu + 0.5); anchor: center; align: center; size: 12.5; weight: 700; width: 58 * pu; lines: 1; color: mix(ink, mint, cks0); family: "Space Grotesk" }
            zone box ck_s0 { at: spx + 187 * pu, sby + 216 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 216 * pu) - ck.off > sby and (sby + 216 * pu) - ck.off < sby + set.h * pu }
            on press ck_s0 { emit ck_size_set(0) }
            box { at: spx + 253 * pu, sby + 216 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, cks1); opacity: 8% + 20% * cks1 + 6% * ck_s1.hover }
            text "Medium" { at: floor(spx + 253 * pu + 0.5), floor(sby + 216 * pu + 0.5); anchor: center; align: center; size: 12.5; weight: 700; width: 58 * pu; lines: 1; color: mix(ink, mint, cks1); family: "Space Grotesk" }
            zone box ck_s1 { at: spx + 253 * pu, sby + 216 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 216 * pu) - ck.off > sby and (sby + 216 * pu) - ck.off < sby + set.h * pu }
            on press ck_s1 { emit ck_size_set(1) }
            box { at: spx + 319 * pu, sby + 216 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, cks2); opacity: 8% + 20% * cks2 + 6% * ck_s2.hover }
            text "Large" { at: floor(spx + 319 * pu + 0.5), floor(sby + 216 * pu + 0.5); anchor: center; align: center; size: 12.5; weight: 700; width: 58 * pu; lines: 1; color: mix(ink, mint, cks2); family: "Space Grotesk" }
            zone box ck_s2 { at: spx + 319 * pu, sby + 216 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 216 * pu) - ck.off > sby and (sby + 216 * pu) - ck.off < sby + set.h * pu }
            on press ck_s2 { emit ck_size_set(2) }
            box { at: spx + 385 * pu, sby + 216 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, cks3); opacity: 8% + 20% * cks3 + 6% * ck_s3.hover }
            text "Huge" { at: floor(spx + 385 * pu + 0.5), floor(sby + 216 * pu + 0.5); anchor: center; align: center; size: 12.5; weight: 700; width: 58 * pu; lines: 1; color: mix(ink, mint, cks3); family: "Space Grotesk" }
            zone box ck_s3 { at: spx + 385 * pu, sby + 216 * pu; size: 62 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 216 * pu) - ck.off > sby and (sby + 216 * pu) - ck.off < sby + set.h * pu }
            on press ck_s3 { emit ck_size_set(3) }
            text "Hours" { at: floor(spx + 156 * pu + 0.5), floor(sby + 244 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: spx + 206 * pu, sby + 266 * pu; size: 100 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, ckh12); opacity: 8% + 20% * ckh12 + 6% * ck_h0.hover }
            text "12-hour" { at: floor(spx + 206 * pu + 0.5), floor(sby + 266 * pu + 0.5); anchor: center; align: center; size: 13; weight: 700; width: 96 * pu; lines: 1; color: mix(ink, mint, ckh12); family: "Space Grotesk" }
            zone box ck_h0 { at: spx + 206 * pu, sby + 266 * pu; size: 100 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 266 * pu) - ck.off > sby and (sby + 266 * pu) - ck.off < sby + set.h * pu }
            on press ck_h0 { emit ck_12h_set(1) }
            box { at: spx + 316 * pu, sby + 266 * pu; size: 100 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, ckh24); opacity: 8% + 20% * ckh24 + 6% * ck_h1.hover }
            text "24-hour" { at: floor(spx + 316 * pu + 0.5), floor(sby + 266 * pu + 0.5); anchor: center; align: center; size: 13; weight: 700; width: 96 * pu; lines: 1; color: mix(ink, mint, ckh24); family: "Space Grotesk" }
            zone box ck_h1 { at: spx + 316 * pu, sby + 266 * pu; size: 100 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 266 * pu) - ck.off > sby and (sby + 266 * pu) - ck.off < sby + set.h * pu }
            on press ck_h1 { emit ck_12h_set(0) }

            //  How it looks.
            box { at: spx + 219 * pu, sby + 328 * pu; size: 438 * pu, 72 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Weight" { at: floor(spx + 14 * pu + 0.5), floor(sby + 312 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: spx + 194 * pu, sby + 312 * pu; size: 88 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, ckw0); opacity: 8% + 20% * ckw0 + 6% * ck_w0.hover }
            text "Thin" { at: floor(spx + 194 * pu + 0.5), floor(sby + 312 * pu + 0.5); anchor: center; align: center; size: 13; weight: 700; width: 84 * pu; lines: 1; color: mix(ink, mint, ckw0); family: "Space Grotesk" }
            zone box ck_w0 { at: spx + 194 * pu, sby + 312 * pu; size: 88 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 312 * pu) - ck.off > sby and (sby + 312 * pu) - ck.off < sby + set.h * pu }
            on press ck_w0 { emit ck_wt_set(0) }
            box { at: spx + 286 * pu, sby + 312 * pu; size: 88 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, ckw1); opacity: 8% + 20% * ckw1 + 6% * ck_w1.hover }
            text "Regular" { at: floor(spx + 286 * pu + 0.5), floor(sby + 312 * pu + 0.5); anchor: center; align: center; size: 13; weight: 700; width: 84 * pu; lines: 1; color: mix(ink, mint, ckw1); family: "Space Grotesk" }
            zone box ck_w1 { at: spx + 286 * pu, sby + 312 * pu; size: 88 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 312 * pu) - ck.off > sby and (sby + 312 * pu) - ck.off < sby + set.h * pu }
