part Clock {
        //  ── Widgets page: BEGIN ──
        //  Settings > Widgets. First the desktop clock (desktopclock/): its switch, the layout as badges (each one is the real clock face, small), where it sits
        //  on a grid of the screen, its size and hours, and its look. The scene keeps the settings (desktopclock.json); the logic asks it for them when the
        //  page opens and tells it each change. See "Settings > Clock" in the logic. Then the desktop system monitor (desktopsysmon/), the same way. The page scrolls like the Lock screen's.
        group {
            show: set_pgk > 0.01
            opacity: set_pgk
            let ck.sc = clamp(ck_scroll, 0, max(0, ck.h - set.h))
            let ck.off = floor(ck.sc * pu + 0.5)        // whole pixels: text that is shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pu, sby + set.h / 2 * pu; size: 456 * pu, set.h * pu }
            zone box ck_wheel { at: spx + 219 * pu, sby + set.h / 2 * pu; size: 446 * pu, set.h * pu }
            on scroll ck_wheel { ck_scroll_to = clamp(ck_scroll_to - wheel * 44, 0, max(0, ck.h - set.h)) }
            group {
            move: 0, -ck.off
            let ckl0 = if(ck_lay == 0, 1, 0)
            let ckl1 = if(ck_lay == 1, 1, 0)
            let ckl2 = if(ck_lay == 2, 1, 0)
            let ckl3 = if(ck_lay == 3, 1, 0)
            let ckl4 = if(ck_lay == 4, 1, 0)
            let ckl5 = if(ck_lay == 5, 1, 0)
            let cks0 = if(ck_px < 180, 1, 0)
            let cks1 = if(ck_px >= 180 and ck_px < 250, 1, 0)
            let cks2 = if(ck_px >= 250 and ck_px < 310, 1, 0)
            let cks3 = if(ck_px >= 310, 1, 0)
            let ckh12 = if(ck_12h, 1, 0)
            let ckh24 = 1 - ckh12
            let ckc0 = if(ck_cl == 0, 1, 0)
            let ckc1 = if(ck_cl == 1, 1, 0)
            let ckc2 = if(ck_cl == 2, 1, 0)
            let syc0 = if(sy_cl == 0, 1, 0)
            let syc1 = if(sy_cl == 1, 1, 0)
            let syc2 = if(sy_cl == 2, 1, 0)

            //  The switch.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 34 * pu; size: 438 * pu, 56 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 34 * pu; size: 438 * pu, 56 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 24 * pu + 0.5); text "Desktop clock" { at: floor(spx + 14 * pu + 0.5), floor(sby + 24 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 44 * pu + 0.5); text "Digits of glass on your wallpaper, under the windows" { at: floor(spx + 14 * pu + 0.5), floor(sby + 44 * pu + 0.5); anchor: left center; size: 12.5; color: faint; show: ck_ok; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 44 * pu + 0.5); text "Not running: turn the switch on to start it" { at: floor(spx + 14 * pu + 0.5), floor(sby + 44 * pu + 0.5); anchor: left center; size: 12.5; color: faint; show: not ck_ok; family: "Space Grotesk" } }
            body {
                color: mix(off, mint, clamp(ck_pill, 0, 1))
                box { at: spx + 405 * pu, sby + 34 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu }
            }
            box { at: spx + 397 * pu + ck_pill * 16 * pu, sby + 34 * pu; size: (17 + 9 * clamp(4 * ck_pill * (1 - ck_pill), 0, 1)) * pu, (17 - 3 * clamp(4 * ck_pill * (1 - ck_pill), 0, 1)) * pu; corner: 7 * pu; color: ink }
            zone box ck_hit { at: spx + 405 * pu, sby + 34 * pu; size: 46 * pu, 30 * pu; cursor: pointer; active: (sby + 34 * pu) - ck.off > sby and (sby + 34 * pu) - ck.off < sby + set.h * pu }
            on press ck_hit { emit ck_toggle }

            //  The example clock: the real layout, the real style of each part, with a fixed time. Click the hours, the minutes or the divider to pick it, and
            //  change it in the card under it. The picked one has an outline, and the others show one when the pointer is over them. (The logic keeps `ghw`...`gsc`
            //  in step with what the clock scene holds.)
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 147 * pu; size: 438 * pu, 150 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 147 * pu; size: 438 * pu, 150 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            //  What the style adds (the same sums as the clock face, for a scale of 1): how far each part grows towards its neighbours, so that the example fits the card at
            //  its biggest and the outlines follow the parts where the face moved them.
            let pv.wt = if(ck_wt == 0, 0.62, if(ck_wt == 2, 1.4, 1))
            let pv.m1 = if(ck_lay == 2, 0.6, 1)
            let pv.m2 = if(ck_lay == 2, 0.6, if(ck_lay == 5, 0.5, 1))
            let u.geh = max(0, 1.4 * pv.m1 * (ghz * (23 + 6.5 * pv.wt * ghw) - (23 + 6.5 * pv.wt)))
            let u.gev = max(0, 1.4 * pv.m1 * (ghz * (44 + 6.5 * pv.wt * ghw) - (44 + 6.5 * pv.wt)))
            let u.meh = max(0, 1.4 * pv.m2 * (gmz * (23 + 6.5 * pv.wt * gmw) - (23 + 6.5 * pv.wt)))
            let u.mev = max(0, 1.4 * pv.m2 * (gmz * (44 + 6.5 * pv.wt * gmw) - (44 + 6.5 * pv.wt)))
            let u.dv = max(0, 4.2 * pv.wt * (gsw * gsz - 1))
            let u.dc = max(0, 9.8 * pv.wt * (gsw * gsz - 1))
            let pv.hw = pick(ck_lay, 149, 61, 31, 152, 130, 61) + 14 + 2 * max(u.geh, u.meh) + 1.5 * max(u.dv, u.dc)
            let pv.hh = pick(ck_lay, 59, 111, 131, 44, 112, 84) + 12 + 2.2 * max(u.gev, u.mev) + 1.5 * u.dv
            let pv.k  = min(min(1.1, 196 / pv.hw), 60 / pv.hh) * pu
            let pv.cx = spx + 219 * pu
            let pv.cy = sby + 142 * pu
            ClockFaceStyled(pv.k, ck_lay, 1, 0, 4, 3, pv.cx, pv.cy, mix(ink, deep, 0.35), 0, 0.5, 100%, pv.wt, mint, ink, alert, faint)
            //  Where each part is, for this layout (in the face's own units, from its middle): the hours, the minutes and the divider, each a middle and a size.
            let pr0x = pick(ck_lay, -88 - u.geh - u.dv, 0, 0, -91 - u.geh - u.dc, -69 - u.geh - u.dv, 0)
            let pr0y = pick(ck_lay, 0, -67 - u.gev - u.dv, -71.8 - u.gev - u.dv - u.gev / 2, 0, -68 - u.gev - u.dv, -40 - u.gev - u.dv)
            let pr0w = pick(ck_lay, 138, 138, 56, 138, 138, 138) + 1.5 * u.geh
            let pr0h = pick(ck_lay, 104, 104, 133, 104, 104, 104) + 1.5 * u.gev + pick(ck_lay, 0, 0, 2 * u.gev, 0, 0, 0)
            let pr1x = pick(ck_lay, 88 + u.meh + u.dv, 0, 0, 91 + u.meh + u.dc, 69 + u.meh + u.dv, 30.5)
            let pr1y = pick(ck_lay, 0, 67 + u.mev + u.dv, 71.8 + u.mev + u.dv + u.mev / 2, 0, 68 + u.mev + u.dv, 62 + u.mev + u.dv)
            let pr1w = pick(ck_lay, 138, 138, 56, 138, 138, 77) + 1.5 * u.meh
            let pr1h = pick(ck_lay, 104, 104, 133, 104, 104, 60) + 1.5 * u.mev + pick(ck_lay, 0, 0, 2 * u.mev, 0, 0, 0)
            let pr2x = 0
            let pr2y = pick(ck_lay, 0, 0, 0, 0, 0, 22)
            let pr2w = pick(ck_lay, 30 + 2 * u.dv, 130 * gsz, 70 * gsz, 44 + 2 * u.dc, 64 * gsz + 2 * u.dv, 130 * gsz)
            let pr2h = pick(ck_lay, 126 * gsz, 22 + 2 * u.dv, 26 + 2 * u.dv, 84 * gsz, 46 * gsz + 2 * u.dv, 22 + 2 * u.dv)
            repeat i in 0..3 {
                let rx = pv.cx + pick(i, pr0x, pr1x, pr2x) * pv.k
                let ry = pv.cy + pick(i, pr0y, pr1y, pr2y) * pv.k
                let rw = pick(i, pr0w, pr1w, pr2w) * pv.k
                let rh = pick(i, pr0h, pr1h, pr2h) * pv.k
                box { at: rx, ry; size: rw, rh; corner: 10 * pu; stroke: 1.6 * pu; color: mint; opacity: if(gl_sel == i, 90%, 0%) + 35% * gl_pv.$i.hover * if(gl_sel == i, 0, 1) }
                zone box gl_pv.$i { at: rx, ry; size: rw, rh; corner: 10 * pu; cursor: pointer; active: (ry - ck.off > sby) and (ry - ck.off < sby + set.h * pu) }
                on press gl_pv.$i { emit gl_pick(i) }
            }
            group { scale: rs; pivot: floor(spx + 219 * pu + 0.5), floor(sby + 208 * pu + 0.5); text "Click the hours, the minutes or the divider" { at: floor(spx + 219 * pu + 0.5), floor(sby + 208 * pu + 0.5); anchor: center; align: center; size: 11.5; color: faint; family: "Space Grotesk" } }

            //  The picked part's style: its weight, its size and its tint.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 301 * pu; size: 438 * pu, 138 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 301 * pu; size: 438 * pu, 138 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 246 * pu + 0.5); text pick(gl_sel, "Hours", "Minutes", "Divider") { at: floor(spx + 14 * pu + 0.5), floor(sby + 246 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; color: mint; family: "Space Grotesk" } }
            box { at: spx + 340 * pu, sby + 246 * pu; size: 56 * pu, 22 * pu; corner: 8 * pu; color: ink; opacity: 8% + 6% * gl_rs1.hover }
            group { scale: rs; pivot: floor(spx + 340 * pu + 0.5), floor(sby + 246 * pu + 0.5); text "Reset" { at: floor(spx + 340 * pu + 0.5), floor(sby + 246 * pu + 0.5); anchor: center; align: center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" } }
            zone box gl_rs1 { at: spx + 340 * pu, sby + 246 * pu; size: 56 * pu, 22 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 246 * pu) - ck.off > sby and (sby + 246 * pu) - ck.off < sby + set.h * pu }
            on press gl_rs1 { emit gl_reset }
            box { at: spx + 405 * pu, sby + 246 * pu; size: 62 * pu, 22 * pu; corner: 8 * pu; color: ink; opacity: 8% + 6% * gl_rs2.hover }
            group { scale: rs; pivot: floor(spx + 405 * pu + 0.5), floor(sby + 246 * pu + 0.5); text "Reset all" { at: floor(spx + 405 * pu + 0.5), floor(sby + 246 * pu + 0.5); anchor: center; align: center; size: 11.5; weight: 700; color: faint; family: "Space Grotesk" } }
            zone box gl_rs2 { at: spx + 405 * pu, sby + 246 * pu; size: 62 * pu, 22 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 246 * pu) - ck.off > sby and (sby + 246 * pu) - ck.off < sby + set.h * pu }
            on press gl_rs2 { emit gl_reset_all }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 278 * pu + 0.5); text "Weight" { at: floor(spx + 14 * pu + 0.5), floor(sby + 278 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: ink; opacity: 85%; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 308 * pu + 0.5); text "Size" { at: floor(spx + 14 * pu + 0.5), floor(sby + 308 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: ink; opacity: 85%; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 336 * pu + 0.5); text "Tint" { at: floor(spx + 14 * pu + 0.5), floor(sby + 336 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: ink; opacity: 85%; family: "Space Grotesk" } }
            repeat j in 0..5 {
                let gx = spx + (129 + j * 62) * pu
                let gw = if(gl_w == j, 1, 0)
                let gz = if(gl_z == j, 1, 0)
                let gc = if(gl_c == j, 1, 0)
                box { at: gx, sby + 278 * pu; size: 58 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, gw); opacity: 8% + 20% * gw + 6% * gl_wb.$j.hover }
                group { scale: rs; pivot: floor(gx + 0.5), floor(sby + 278 * pu + 0.5); text pick(j, "Thin", "Light", "Normal", "Bold", "Heavy") { at: floor(gx + 0.5), floor(sby + 278 * pu + 0.5); anchor: center; align: center; size: 12.5; weight: 700; width: (54 * pu) / rs; lines: 1; color: mix(ink, mint, gw); family: "Space Grotesk" } }
                zone box gl_wb.$j { at: gx, sby + 278 * pu; size: 58 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 278 * pu) - ck.off > sby and (sby + 278 * pu) - ck.off < sby + set.h * pu }
                on press gl_wb.$j { emit gl_w_set(j) }
                box { at: gx, sby + 308 * pu; size: 58 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, gz); opacity: 8% + 20% * gz + 6% * gl_zb.$j.hover }
                group { scale: rs; pivot: floor(gx + 0.5), floor(sby + 308 * pu + 0.5); text pick(j, "XS", "S", "M", "L", "XL") { at: floor(gx + 0.5), floor(sby + 308 * pu + 0.5); anchor: center; align: center; size: 12.5; weight: 700; width: (54 * pu) / rs; lines: 1; color: mix(ink, mint, gz); family: "Space Grotesk" } }
                zone box gl_zb.$j { at: gx, sby + 308 * pu; size: 58 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 308 * pu) - ck.off > sby and (sby + 308 * pu) - ck.off < sby + set.h * pu }
                on press gl_zb.$j { emit gl_z_set(j) }
                //  The tints are drawn in their colours, with a ring round the one in use and its name under it.
                ellipse { at: gx, sby + 336 * pu; radius: 9.5 * pu; color: pick(j, mix(ink, deep, 0.35), mint, ink, alert, faint) }
                ellipse { at: gx, sby + 336 * pu; radius: 9.5 * pu; stroke: 1 * pu; color: ink; opacity: 25% }
                ellipse { at: gx, sby + 336 * pu; radius: 13.5 * pu; stroke: 1.8 * pu; color: mint; opacity: gc * 100% + 40% * gl_cb.$j.hover * (1 - gc) }
                zone box gl_cb.$j { at: gx, sby + 336 * pu; size: 34 * pu, 30 * pu; corner: 15 * pu; cursor: pointer; active: (sby + 336 * pu) - ck.off > sby and (sby + 336 * pu) - ck.off < sby + set.h * pu }
                on press gl_cb.$j { emit gl_c_set(j) }
                group { scale: rs; pivot: floor(gx + 0.5), floor(sby + 354 * pu + 0.5); text pick(j, "Glass", "Mint", "Light", "Rose", "Grey") { at: floor(gx + 0.5), floor(sby + 354 * pu + 0.5); anchor: center; align: center; size: 10.5; weight: 600; color: if(gc > 0.5, mint, faint); family: "Space Grotesk" } }
            }

            //  The layouts: a badge each.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 424 * pu; size: 438 * pu, 100 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 424 * pu; size: 438 * pu, 100 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 388 * pu + 0.5); text "Layout" { at: floor(spx + 14 * pu + 0.5), floor(sby + 388 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" } }
            box { at: spx + 46 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; color: mix(ink, mint, ckl0); opacity: 7% + 20% * ckl0 + 6% * ck_l0.hover }
            box { at: spx + 46 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; stroke: 1.3 * pu; color: mint; opacity: 75% * ckl0 }
            ClockFace(0.145 * pu, 0, 1, 2, 3, 4, spx + 46 * pu, sby + 429 * pu, mix(ink, mint, ckl0), 0, 0.5, 60% + 40% * ckl0, 1)
            zone box ck_l0 { at: spx + 46 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 429 * pu) - ck.off > sby and (sby + 429 * pu) - ck.off < sby + set.h * pu }
            on press ck_l0 { emit ck_lay_set(0) }
            group { scale: rs; pivot: floor(spx + 46 * pu + 0.5), floor(sby + 464 * pu + 0.5); text "Pipe" { at: floor(spx + 46 * pu + 0.5), floor(sby + 464 * pu + 0.5); anchor: center; size: 11.5; weight: 600; color: mix(faint, mint, ckl0); family: "Space Grotesk" } }
            box { at: spx + 116 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; color: mix(ink, mint, ckl1); opacity: 7% + 20% * ckl1 + 6% * ck_l1.hover }
            box { at: spx + 116 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; stroke: 1.3 * pu; color: mint; opacity: 75% * ckl1 }
            ClockFace(0.145 * pu, 1, 1, 2, 3, 4, spx + 116 * pu, sby + 429 * pu, mix(ink, mint, ckl1), 0, 0.5, 60% + 40% * ckl1, 1)
            zone box ck_l1 { at: spx + 116 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 429 * pu) - ck.off > sby and (sby + 429 * pu) - ck.off < sby + set.h * pu }
            on press ck_l1 { emit ck_lay_set(1) }
            group { scale: rs; pivot: floor(spx + 116 * pu + 0.5), floor(sby + 464 * pu + 0.5); text "Rule" { at: floor(spx + 116 * pu + 0.5), floor(sby + 464 * pu + 0.5); anchor: center; size: 11.5; weight: 600; color: mix(faint, mint, ckl1); family: "Space Grotesk" } }
            box { at: spx + 186 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; color: mix(ink, mint, ckl2); opacity: 7% + 20% * ckl2 + 6% * ck_l2.hover }
            box { at: spx + 186 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; stroke: 1.3 * pu; color: mint; opacity: 75% * ckl2 }
            ClockFace(0.145 * pu, 2, 1, 2, 3, 4, spx + 186 * pu, sby + 429 * pu, mix(ink, mint, ckl2), 0, 0.5, 60% + 40% * ckl2, 1)
            zone box ck_l2 { at: spx + 186 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 429 * pu) - ck.off > sby and (sby + 429 * pu) - ck.off < sby + set.h * pu }
            on press ck_l2 { emit ck_lay_set(2) }
            group { scale: rs; pivot: floor(spx + 186 * pu + 0.5), floor(sby + 464 * pu + 0.5); text "Tower" { at: floor(spx + 186 * pu + 0.5), floor(sby + 464 * pu + 0.5); anchor: center; size: 11.5; weight: 600; color: mix(faint, mint, ckl2); family: "Space Grotesk" } }
            box { at: spx + 256 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; color: mix(ink, mint, ckl3); opacity: 7% + 20% * ckl3 + 6% * ck_l3.hover }
            box { at: spx + 256 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; stroke: 1.3 * pu; color: mint; opacity: 75% * ckl3 }
            ClockFace(0.145 * pu, 3, 1, 2, 3, 4, spx + 256 * pu, sby + 429 * pu, mix(ink, mint, ckl3), 0, 0.5, 60% + 40% * ckl3, 1)
            zone box ck_l3 { at: spx + 256 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 429 * pu) - ck.off > sby and (sby + 429 * pu) - ck.off < sby + set.h * pu }
            on press ck_l3 { emit ck_lay_set(3) }
            group { scale: rs; pivot: floor(spx + 256 * pu + 0.5), floor(sby + 464 * pu + 0.5); text "Digital" { at: floor(spx + 256 * pu + 0.5), floor(sby + 464 * pu + 0.5); anchor: center; size: 11.5; weight: 600; color: mix(faint, mint, ckl3); family: "Space Grotesk" } }
            box { at: spx + 326 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; color: mix(ink, mint, ckl4); opacity: 7% + 20% * ckl4 + 6% * ck_l4.hover }
            box { at: spx + 326 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; stroke: 1.3 * pu; color: mint; opacity: 75% * ckl4 }
            ClockFace(0.145 * pu, 4, 1, 2, 3, 4, spx + 326 * pu, sby + 429 * pu, mix(ink, mint, ckl4), 0, 0.5, 60% + 40% * ckl4, 1)
            zone box ck_l4 { at: spx + 326 * pu, sby + 429 * pu; size: 64 * pu, 54 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 429 * pu) - ck.off > sby and (sby + 429 * pu) - ck.off < sby + set.h * pu }
            on press ck_l4 { emit ck_lay_set(4) }
            group { scale: rs; pivot: floor(spx + 326 * pu + 0.5), floor(sby + 464 * pu + 0.5); text "Slash" { at: floor(spx + 326 * pu + 0.5), floor(sby + 464 * pu + 0.5); anchor: center; size: 11.5; weight: 600; color: mix(faint, mint, ckl4); family: "Space Grotesk" } }
