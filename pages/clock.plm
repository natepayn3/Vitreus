            text "Soft" { at: floor(spx + 286 * pu + 0.5), floor(sby + 344 * pu + 0.5); anchor: center; align: center; size: 13; weight: 700; width: 84 * pu; lines: 1; color: mix(ink, mint, ckc1); family: "Space Grotesk" }
            zone box ck_c1 { at: spx + 286 * pu, sby + 344 * pu; size: 88 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 344 * pu) - ck.off > sby and (sby + 344 * pu) - ck.off < sby + set.h * pu }
