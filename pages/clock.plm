            box { at: spx + 378 * pu, sby + 312 * pu; size: 88 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, ckw2); opacity: 8% + 20% * ckw2 + 6% * ck_w2.hover }
            text "Bold" { at: floor(spx + 378 * pu + 0.5), floor(sby + 312 * pu + 0.5); anchor: center; align: center; size: 13; weight: 700; width: 84 * pu; lines: 1; color: mix(ink, mint, ckw2); family: "Space Grotesk" }
            zone box ck_w2 { at: spx + 378 * pu, sby + 312 * pu; size: 88 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 312 * pu) - ck.off > sby and (sby + 312 * pu) - ck.off < sby + set.h * pu }
            on press ck_w2 { emit ck_wt_set(2) }
            text "Glass" { at: floor(spx + 14 * pu + 0.5), floor(sby + 344 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: spx + 194 * pu, sby + 344 * pu; size: 88 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, ckc0); opacity: 8% + 20% * ckc0 + 6% * ck_c0.hover }
            text "Clear" { at: floor(spx + 194 * pu + 0.5), floor(sby + 344 * pu + 0.5); anchor: center; align: center; size: 13; weight: 700; width: 84 * pu; lines: 1; color: mix(ink, mint, ckc0); family: "Space Grotesk" }
            zone box ck_c0 { at: spx + 194 * pu, sby + 344 * pu; size: 88 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 344 * pu) - ck.off > sby and (sby + 344 * pu) - ck.off < sby + set.h * pu }
