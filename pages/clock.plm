            }
            zone box fw_b_hit { at: fws.x0 + fws.w / 2, sby + 1144 * pu; size: fws.w + 28 * pu, 26 * pu; cursor: pointer; active: (sby + 1144 * pu) - ck.off > sby and (sby + 1144 * pu) - ck.off < sby + set.h * pu; label: "Blend" }
            on press fw_b_hit { emit fw_bl_set(clamp(((pointer.x - tx.pnl) - fws.x0) / fws.w, 0, 1)) }
            on drag fw_b_hit { emit fw_bl_set(clamp(((pointer.x - tx.pnl) - fws.x0) / fws.w, 0, 1)) }
            on scroll fw_b_hit { ck_scroll_to = clamp(ck_scroll_to - wheel * 44, 0, max(0, ck.h - set.h)) }
            //  Which monitor shows it: all of them, or one (the chips are the system monitor's, `cv_m.*`). logic/visualizer.luau keeps it (framewave.json `mon`).
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 1180 * pu + 0.5); text "Show on" { at: floor(spx + 14 * pu + 0.5), floor(sby + 1180 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" } }
            box { at: spx + 156 * pu, sby + 1180 * pu; size: 50 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, if(fw_mon == 0, 1, 0)); opacity: 8% + 20% * if(fw_mon == 0, 1, 0) + 6% * fw_mn_all.hover }
            PPillOutline(spx + 156 * pu, sby + 1180 * pu, 50 * pu, 24 * pu, 8 * pu, fw_mn_all.hover, clamp(3 * (8% + 20% * if(fw_mon == 0, 1, 0) + 6% * fw_mn_all.hover), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 156 * pu + 0.5), floor(sby + 1180 * pu + 0.5); text "All" { at: floor(spx + 156 * pu + 0.5), floor(sby + 1180 * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; width: (46 * pu) / rs; lines: 1; color: mix(ink, mint, if(fw_mon == 0, 1, 0)); family: "Space Grotesk" } }
            zone box fw_mn_all { at: spx + 156 * pu, sby + 1180 * pu; size: 50 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; label: "Audio visualiser: show on every monitor"; active: (sby + 1180 * pu) - ck.off > sby and (sby + 1180 * pu) - ck.off < sby + set.h * pu }
            on press fw_mn_all { emit fw_mon_set(0) }
            repeat k in 0..4 {
                let fwmx = spx + (210 + k * 54) * pu
                box { at: fwmx, sby + 1180 * pu; size: 50 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, if(fw_mon == k + 1, 1, 0)); opacity: if(cv_m.$k.on, 8% + 20% * if(fw_mon == k + 1, 1, 0) + 6% * fw_mn.$k.hover, 0%) }
                PPillOutline(fwmx, sby + 1180 * pu, 50 * pu, 24 * pu, 8 * pu, fw_mn.$k.hover, clamp(3 * (if(cv_m.$k.on, 8% + 20% * if(fw_mon == k + 1, 1, 0) + 6% * fw_mn.$k.hover, 0%)), 0, 1), pu)
                group { scale: rs; pivot: floor(fwmx + 0.5), floor(sby + 1180 * pu + 0.5); text cv_m.$k.name { at: floor(fwmx + 0.5), floor(sby + 1180 * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; width: (46 * pu) / rs; lines: 1; color: mix(ink, mint, if(fw_mon == k + 1, 1, 0)); show: cv_m.$k.on; family: "Space Grotesk" } }
                zone box fw_mn.$k { at: fwmx, sby + 1180 * pu; size: 50 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; label: "Audio visualiser: show on this monitor"; active: (cv_m.$k.on) and (sby + 1180 * pu) - ck.off > sby and (sby + 1180 * pu) - ck.off < sby + set.h * pu }
                on press fw_mn.$k { emit fw_mon_set(k + 1) }
            }
            }

            let ck.thh = set.h * set.h / max(set.h, ck.h)
            let ck.thy = ck.thh / 2 + ck.sc / max(1, ck.h - set.h) * (set.h - ck.thh)
            box { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: if(ck.h > set.h, 6%, 0%) }
            box { at: spx + 442 * pu, sby + ck.thy * pu; size: 3 * pu, ck.thh * pu; corner: 1.5 * pu; color: mint; opacity: if(ck.h > set.h, 55%, 0%) }
            let ck.cue = clamp((ck.h - set.h - ck.sc) / 24, 0, 1)
            let ck.cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * ck.cue }
            }
            box { at: spx + 224 * pu, ck.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * ck.cue }
            box { at: spx + 224 * pu, ck.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * ck_cue_hit.hover) * ck.cue }
            path { at: spx + 204 * pu, ck.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: ck.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, ck.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: ck.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            group { scale: rs; pivot: floor(spx + 232 * pu + 0.5), floor(ck.cuey + 0.5); text "More" { at: floor(spx + 232 * pu + 0.5), floor(ck.cuey + 0.5); anchor: center; size: 16.5; weight: 700; color: ink; opacity: ck.cue; family: "Space Grotesk" } }
            zone box ck_cue_hit { at: spx + 224 * pu, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: ck.cue > 0.5 }
            on press ck_cue_hit { ck_scroll_to = clamp(ck_scroll_to + 342, 0, max(0, ck.h - set.h)) }
            zone box ck_bar_hit { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: ck.h > set.h }
            on press ck_bar_hit { ck_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - ck.thh / 2) / max(1, set.h - ck.thh) * (ck.h - set.h), 0, max(0, ck.h - set.h)) }
            on drag ck_bar_hit { ck_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - ck.thh / 2) / max(1, set.h - ck.thh) * (ck.h - set.h), 0, max(0, ck.h - set.h)) }
        }
        //  ── Widgets page: END ──
}
