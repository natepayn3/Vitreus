            //  The desktop system monitor (desktopsysmon/): its switch, where it sits on a grid of the screen, and its glass. Like the clock, its scene keeps
            //  the settings (desktopsysmon.json); the logic asks it for them when the page opens and tells it each change.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 674 * pu; size: 438 * pu, 56 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 674 * pu; size: 438 * pu, 56 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 664 * pu + 0.5); text "Desktop system monitor" { at: floor(spx + 14 * pu + 0.5), floor(sby + 664 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 684 * pu + 0.5); text "Processor, memory, graphics and network on your wallpaper" { at: floor(spx + 14 * pu + 0.5), floor(sby + 684 * pu + 0.5); anchor: left center; size: 12.5; color: faint; show: sy_ok; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 684 * pu + 0.5); text "Not running: turn the switch on to start it" { at: floor(spx + 14 * pu + 0.5), floor(sby + 684 * pu + 0.5); anchor: left center; size: 12.5; color: faint; show: not sy_ok; family: "Space Grotesk" } }
            body {
                color: mix(off, mint, clamp(sy_pill, 0, 1))
                box { at: spx + 405 * pu, sby + 674 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu }
            }
            box { at: spx + 397 * pu + sy_pill * 16 * pu, sby + 674 * pu; size: (17 + 9 * clamp(4 * sy_pill * (1 - sy_pill), 0, 1)) * pu, (17 - 3 * clamp(4 * sy_pill * (1 - sy_pill), 0, 1)) * pu; corner: 7 * pu; color: ink }
            zone box sy_hit { at: spx + 405 * pu, sby + 674 * pu; size: 46 * pu, 30 * pu; cursor: pointer; active: (sby + 674 * pu) - ck.off > sby and (sby + 674 * pu) - ck.off < sby + set.h * pu }
            on press sy_hit { emit sy_toggle }

