part Idle {
        //  The Idle page (Screen): after how long without input the screen locks, goes dark and the machine sleeps (Never is 0). The sequence is drawn as three stops, each set
        //  with a slider along a short list of times. logic/idle.luau writes what hypridle waits for.
        group {
            show: set_pgi > 0.01
            opacity: set_pgi
            let idx0 = spx + 14 * pu
            let idw = 410 * pu

            //  Card one: what it is.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 26 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 26 * pu, 438 * pu, 52 * pu, 165.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 26 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 26 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); text "Idle and sleep" { at: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 35 * pu + 0.5); text "Counted from the last key or touch; Caffeine and playing video hold all three off" { at: floor(spx + 14 * pu + 0.5), floor(sby + 35 * pu + 0.5); anchor: left center; size: 13.5; color: faint; width: (410 * pu) / rs; lines: 1; family: "Space Grotesk" } }

            //  Card two: the sequence. Each stop lights up when its time is set and dims when it is Never.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 106 * pu; size: 438 * pu, 92 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 106 * pu, 438 * pu, 92 * pu, 214.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 106 * pu; size: 438 * pu, 92 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 106 * pu; size: 438 * pu, 92 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            line { from: spx + 76 * pu + 22 * pu, sby + 101 * pu; to: spx + 219 * pu - 22 * pu, sby + 101 * pu; width: 1.6 * pu; color: ink; opacity: 22% }
            line { from: spx + 219 * pu + 22 * pu, sby + 101 * pu; to: spx + 362 * pu - 22 * pu, sby + 101 * pu; width: 1.6 * pu; color: ink; opacity: 22% }
            ellipse { at: spx + 76 * pu, sby + 101 * pu; radius: 19 * pu; color: mint; opacity: 0.2 * (if(idle_lock > 0, 1, 0)) }
            ellipse { at: spx + 76 * pu, sby + 101 * pu; radius: 19 * pu; color: ink; opacity: 0.1 * (1 - (if(idle_lock > 0, 1, 0))) }
            ellipse { at: spx + 76 * pu, sby + 101 * pu; radius: 19 * pu; stroke: 1.2 * pu; color: ink; opacity: 0.28 * (1 - (if(idle_lock > 0, 1, 0))) }
            ellipse { at: spx + 76 * pu, sby + 101 * pu; radius: 19 * pu; stroke: 1.4 * pu; color: mint; opacity: (if(idle_lock > 0, 1, 0)) }
            box { at: spx + 76 * pu, sby + 104 * pu; size: 12 * pu, 9 * pu; corner: 2 * pu; color: mix(ink, mint, (if(idle_lock > 0, 1, 0))) }
            path { at: spx + 76 * pu, sby + 99 * pu; stroke: 1.5 * pu; color: mix(ink, mint, (if(idle_lock > 0, 1, 0))); move -3.5 * pu, 0; line -3.5 * pu, -3 * pu; line -2 * pu, -4.5 * pu; line 2 * pu, -4.5 * pu; line 3.5 * pu, -3 * pu; line 3.5 * pu, 0 }
            group { scale: rs; pivot: floor(spx + 76 * pu + 0.5), floor(sby + 134 * pu + 0.5); text idle_lock_t { at: floor(spx + 76 * pu + 0.5), floor(sby + 134 * pu + 0.5); anchor: center; size: 15.5; weight: 700; color: ink; align: center; width: (110 * pu) / rs; lines: 1; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 76 * pu + 0.5), floor(sby + 77 * pu + 0.5); text "LOCK" { at: floor(spx + 76 * pu + 0.5), floor(sby + 77 * pu + 0.5); anchor: center; size: 12; weight: 700; color: faint; align: center; width: (110 * pu) / rs; lines: 1; family: "Space Grotesk" } }
            ellipse { at: spx + 219 * pu, sby + 101 * pu; radius: 19 * pu; color: mint; opacity: 0.2 * (if(idle_off > 0, 1, 0)) }
            ellipse { at: spx + 219 * pu, sby + 101 * pu; radius: 19 * pu; color: ink; opacity: 0.1 * (1 - (if(idle_off > 0, 1, 0))) }
            ellipse { at: spx + 219 * pu, sby + 101 * pu; radius: 19 * pu; stroke: 1.2 * pu; color: ink; opacity: 0.28 * (1 - (if(idle_off > 0, 1, 0))) }
            ellipse { at: spx + 219 * pu, sby + 101 * pu; radius: 19 * pu; stroke: 1.4 * pu; color: mint; opacity: (if(idle_off > 0, 1, 0)) }
            box { at: spx + 219 * pu, sby + 99 * pu; size: 15 * pu, 11 * pu; corner: 2 * pu; stroke: 1.5 * pu; color: mix(ink, mint, (if(idle_off > 0, 1, 0))) }
            line { from: spx + 219 * pu, sby + 105 * pu; to: spx + 219 * pu, sby + 108 * pu; width: 1.5 * pu; color: mix(ink, mint, (if(idle_off > 0, 1, 0))) }
            line { from: spx + 219 * pu - 4 * pu, sby + 109 * pu; to: spx + 219 * pu + 4 * pu, sby + 109 * pu; width: 1.5 * pu; color: mix(ink, mint, (if(idle_off > 0, 1, 0))) }
            group { scale: rs; pivot: floor(spx + 219 * pu + 0.5), floor(sby + 134 * pu + 0.5); text idle_off_t { at: floor(spx + 219 * pu + 0.5), floor(sby + 134 * pu + 0.5); anchor: center; size: 15.5; weight: 700; color: ink; align: center; width: (110 * pu) / rs; lines: 1; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 219 * pu + 0.5), floor(sby + 77 * pu + 0.5); text "SCREEN OFF" { at: floor(spx + 219 * pu + 0.5), floor(sby + 77 * pu + 0.5); anchor: center; size: 12; weight: 700; color: faint; align: center; width: (110 * pu) / rs; lines: 1; family: "Space Grotesk" } }
            ellipse { at: spx + 362 * pu, sby + 101 * pu; radius: 19 * pu; color: mint; opacity: 0.2 * (if(idle_sleep > 0, 1, 0)) }
            ellipse { at: spx + 362 * pu, sby + 101 * pu; radius: 19 * pu; color: ink; opacity: 0.1 * (1 - (if(idle_sleep > 0, 1, 0))) }
            ellipse { at: spx + 362 * pu, sby + 101 * pu; radius: 19 * pu; stroke: 1.2 * pu; color: ink; opacity: 0.28 * (1 - (if(idle_sleep > 0, 1, 0))) }
            ellipse { at: spx + 362 * pu, sby + 101 * pu; radius: 19 * pu; stroke: 1.4 * pu; color: mint; opacity: (if(idle_sleep > 0, 1, 0)) }
            group { scale: rs; pivot: floor(spx + 362 * pu + 0.5), floor(sby + 101 * pu + 0.5); text "zZ" { at: floor(spx + 362 * pu + 0.5), floor(sby + 101 * pu + 0.5); anchor: center; size: 16; weight: 700; color: mix(ink, mint, (if(idle_sleep > 0, 1, 0))); align: center; width: (110 * pu) / rs; lines: 1; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 362 * pu + 0.5), floor(sby + 134 * pu + 0.5); text idle_sleep_t { at: floor(spx + 362 * pu + 0.5), floor(sby + 134 * pu + 0.5); anchor: center; size: 15.5; weight: 700; color: ink; align: center; width: (110 * pu) / rs; lines: 1; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 362 * pu + 0.5), floor(sby + 77 * pu + 0.5); text "SLEEP" { at: floor(spx + 362 * pu + 0.5), floor(sby + 77 * pu + 0.5); anchor: center; size: 12; weight: 700; color: faint; align: center; width: (110 * pu) / rs; lines: 1; family: "Space Grotesk" } }

            //  Card three: the sliders.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 258 * pu; size: 438 * pu, 196 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 258 * pu, 438 * pu, 196 * pu, 431.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 258 * pu; size: 438 * pu, 196 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 258 * pu; size: 438 * pu, 196 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(idx0 + 0.5), floor(sby + 178 * pu + 0.5); text "Lock the screen" { at: floor(idx0 + 0.5), floor(sby + 178 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(idx0 + 0.5), floor(sby + 195 * pu + 0.5); text "Locked until you sign in" { at: floor(idx0 + 0.5), floor(sby + 195 * pu + 0.5); anchor: left center; size: 13.5; color: faint; width: (300 * pu) / rs; lines: 1; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 178 * pu + 0.5); text idle_lock_t { at: floor(spx + 424 * pu + 0.5), floor(sby + 178 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            box { at: idx0 + idw / 2, sby + 216 * pu; size: idw, 12 * pu; corner: 6 * pu; color: mint; opacity: 14% }
            repeat k in 0..14 { ellipse { at: idx0 + (k / 13) * idw * 0.96 + idw * 0.02, sby + 216 * pu; radius: 1.1 * pu; color: ink; opacity: 30% } }
            PSlider(idx0, sby + 216 * pu, idw, clamp(idle_lock_i / 13, 0, 1), idle_s0.hover, cu, 12 * pu, 0)
            zone box idle_s0 { at: idx0 + idw / 2, sby + 216 * pu; size: idw + 24 * pu, 28 * pu; cursor: pointer; label: "Lock the screen" }
            on press idle_s0 { emit idle_set(0 + floor(clamp(((pointer.x - tx.pnl) - idx0) / idw, 0, 1) * 13 + 0.5)) }
            on drag idle_s0 { emit idle_set(0 + floor(clamp(((pointer.x - tx.pnl) - idx0) / idw, 0, 1) * 13 + 0.5)) }
            group { scale: rs; pivot: floor(idx0 + 0.5), floor(sby + 240 * pu + 0.5); text "Turn the screen off" { at: floor(idx0 + 0.5), floor(sby + 240 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(idx0 + 0.5), floor(sby + 257 * pu + 0.5); text "Any key or touch wakes it" { at: floor(idx0 + 0.5), floor(sby + 257 * pu + 0.5); anchor: left center; size: 13.5; color: faint; width: (300 * pu) / rs; lines: 1; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 240 * pu + 0.5); text idle_off_t { at: floor(spx + 424 * pu + 0.5), floor(sby + 240 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            box { at: idx0 + idw / 2, sby + 278 * pu; size: idw, 12 * pu; corner: 6 * pu; color: mint; opacity: 14% }
            repeat k in 0..14 { ellipse { at: idx0 + (k / 13) * idw * 0.96 + idw * 0.02, sby + 278 * pu; radius: 1.1 * pu; color: ink; opacity: 30% } }
            PSlider(idx0, sby + 278 * pu, idw, clamp(idle_off_i / 13, 0, 1), idle_s1.hover, cu, 12 * pu, 0)
            zone box idle_s1 { at: idx0 + idw / 2, sby + 278 * pu; size: idw + 24 * pu, 28 * pu; cursor: pointer; label: "Turn the screen off" }
            on press idle_s1 { emit idle_set(100 + floor(clamp(((pointer.x - tx.pnl) - idx0) / idw, 0, 1) * 13 + 0.5)) }
            on drag idle_s1 { emit idle_set(100 + floor(clamp(((pointer.x - tx.pnl) - idx0) / idw, 0, 1) * 13 + 0.5)) }
            group { scale: rs; pivot: floor(idx0 + 0.5), floor(sby + 302 * pu + 0.5); text "Sleep (suspend)" { at: floor(idx0 + 0.5), floor(sby + 302 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(idx0 + 0.5), floor(sby + 319 * pu + 0.5); text "Locks first, so waking never lands on an open desktop" { at: floor(idx0 + 0.5), floor(sby + 319 * pu + 0.5); anchor: left center; size: 13.5; color: faint; width: (300 * pu) / rs; lines: 1; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 302 * pu + 0.5); text idle_sleep_t { at: floor(spx + 424 * pu + 0.5), floor(sby + 302 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            box { at: idx0 + idw / 2, sby + 340 * pu; size: idw, 12 * pu; corner: 6 * pu; color: mint; opacity: 14% }
            repeat k in 0..14 { ellipse { at: idx0 + (k / 13) * idw * 0.96 + idw * 0.02, sby + 340 * pu; radius: 1.1 * pu; color: ink; opacity: 30% } }
            PSlider(idx0, sby + 340 * pu, idw, clamp(idle_sleep_i / 13, 0, 1), idle_s2.hover, cu, 12 * pu, 0)
            zone box idle_s2 { at: idx0 + idw / 2, sby + 340 * pu; size: idw + 24 * pu, 28 * pu; cursor: pointer; label: "Sleep (suspend)" }
            on press idle_s2 { emit idle_set(200 + floor(clamp(((pointer.x - tx.pnl) - idx0) / idw, 0, 1) * 13 + 0.5)) }
            on drag idle_s2 { emit idle_set(200 + floor(clamp(((pointer.x - tx.pnl) - idx0) / idw, 0, 1) * 13 + 0.5)) }

            //  Card four: lock even while a video plays (ignore_inhibit on the lock listener, written by logic/idle.luau).
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 390 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 390 * pu, 438 * pu, 52 * pu, 520.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 390 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 390 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(idx0 + 0.5), floor(sby + 382 * pu + 0.5); text "Lock even while video plays" { at: floor(idx0 + 0.5), floor(sby + 382 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(idx0 + 0.5), floor(sby + 399 * pu + 0.5); text "Otherwise a stream or video keeps the lock off too" { at: floor(idx0 + 0.5), floor(sby + 399 * pu + 0.5); anchor: left center; size: 13.5; color: faint; width: (330 * pu) / rs; lines: 1; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pu, sby + 390 * pu, idle_k, idle_tg.pressed, idle_tg.hover, mint)
            zone box idle_tg { at: spx + 219 * pu, sby + 390 * pu; size: 430 * pu, 44 * pu; corner: 10 * pu; cursor: pointer; label: "Lock even while video plays" }
            on press idle_tg { emit idle_toggle(1) }

            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 429 * pu + 0.5); text "On pleamar-wm the screen-off time is used from the next login." { at: floor(spx + 14 * pu + 0.5), floor(sby + 429 * pu + 0.5); anchor: left center; size: 13.5; color: faint; width: (410 * pu) / rs; lines: 1; family: "Space Grotesk" } }
        }
}
