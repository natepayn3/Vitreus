            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + (1337 - sm.ds - sm.dt) * pu + 0.5); text "BUSIEST PROGRAMS" { at: floor(spx + 14 * pw + 0.5), floor(sby + (1337 - sm.ds - sm.dt) * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 372 * pw + 0.5), floor(sby + (1337 - sm.ds - sm.dt) * pu + 0.5); text "CPU" { at: floor(spx + 372 * pw + 0.5), floor(sby + (1337 - sm.ds - sm.dt) * pu + 0.5); anchor: right center; size: 13; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + (1337 - sm.ds - sm.dt) * pu + 0.5); text "MEMORY" { at: floor(spx + 424 * pw + 0.5), floor(sby + (1337 - sm.ds - sm.dt) * pu + 0.5); anchor: right center; size: 13; weight: 700; color: faint; family: "Space Grotesk" } }
            repeat r in 0..8 {
                let ry = 1375 - sm.ds - sm.dt + r * 26
                group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + ry * pu + 0.5); text sm_proc.$r.name { at: floor(spx + 14 * pw + 0.5), floor(sby + ry * pu + 0.5); anchor: left center; size: 17; weight: 600; width: (130 * pw) / rs; lines: 1; color: ink; family: "Space Grotesk"; show: r < sm_proc.count } }
                box { at: spx + 228 * pw, sby + ry * pu; size: 140 * pu, 7 * pu; corner: 3.5 * pu; color: ink; opacity: 8%; show: r < sm_proc.count }
                box { from: spx + 158 * pw, sby + (ry - 3.5) * pu; size: max(7, 140 * clamp(sm_proc.$r.cpu, 0, 1)) * pu, 7 * pu; corner: 3.5 * pu; color: mix(mint, alert, clamp((sm_proc.$r.cpu - 0.75) / 0.25, 0, 1)); show: r < sm_proc.count }
                group { scale: rs; pivot: floor(spx + 372 * pw + 0.5), floor(sby + ry * pu + 0.5); text sm_proc.$r.cpu_txt { at: floor(spx + 372 * pw + 0.5), floor(sby + ry * pu + 0.5); anchor: right center; align: right; size: 15.5; weight: 700; width: (56 * pw) / rs; lines: 1; color: ink; family: "Space Grotesk"; show: r < sm_proc.count } }
                group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + ry * pu + 0.5); text sm_proc.$r.mem_txt { at: floor(spx + 424 * pw + 0.5), floor(sby + ry * pu + 0.5); anchor: right center; align: right; size: 15.5; weight: 500; width: (50 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk"; show: r < sm_proc.count } }
            }
            }
            let sm.thh = set.h * set.h / sm.h
            let sm.thy = sm.thh / 2 + sm.sc / max(1, sm.h - set.h) * (set.h - sm.thh)
            box { at: spx + 442 * pw, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: 6% }
            box { at: spx + 442 * pw, sby + sm.thy * pu; size: 3 * pu, sm.thh * pu; corner: 1.5 * pu; color: mint; opacity: 55% }
            let sm.cue = clamp((sm.h - set.h - sm.sc) / 24, 0, 1)
            let sm.cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pw, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pw, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * sm.cue }
            }
            box { at: spx + 224 * pw, sm.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * sm.cue }
            box { at: spx + 224 * pw, sm.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * sm_cue_hit.hover) * sm.cue }
            path { at: spx + 204 * pw, sm.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: sm.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pw, sm.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: sm.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            group { scale: rs; pivot: floor(spx + 232 * pw + 0.5), floor(sm.cuey + 0.5); text "More" { at: floor(spx + 232 * pw + 0.5), floor(sm.cuey + 0.5); anchor: center; size: 16.5; weight: 700; color: ink; opacity: sm.cue; family: "Space Grotesk" } }
            zone box sm_cue_hit { at: spx + 224 * pw, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: sm.cue > 0.5 }
            on press sm_cue_hit { sm_scroll_to = clamp(sm_scroll_to + 342, 0, max(0, sm.h - set.h)) }
            zone box sm_bar_hit { at: spx + 442 * pw, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: sm.h > set.h }
            on press sm_bar_hit { sm_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - sm.thh / 2) / max(1, set.h - sm.thh) * (sm.h - set.h), 0, max(0, sm.h - set.h)) }
            on drag sm_bar_hit { sm_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - sm.thh / 2) / max(1, set.h - sm.thh) * (sm.h - set.h), 0, max(0, sm.h - set.h)) }
        }
        //  ── System monitor page: END ──
}
