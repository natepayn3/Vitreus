part Sysmon {
        //  ── System monitor page: BEGIN (generated; see bin/vitreus-sysmon) ──
        //  The page scrolls like Display's: a clipped viewport as tall as the Wallpaper page, the content moved up by `sm.off`, and the wheel
        //  caught by the zone under it. Nothing on it is pressed, so nothing has to be kept from a click when it is out of sight.
        group {
            show: set_pgs > 0.01
            opacity: set_pgs
            let sm.sc = clamp(sm_scroll, 0, max(0, sm.h - set.h))
            let sm.off = floor(sm.sc * pu + 0.5)        // whole pixels: text that is shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pw, sby + set.h / 2 * pu; size: 456 * pw, set.h * pu }
            zone box sm_wheel { at: spx + 219 * pw, sby + set.h / 2 * pu; size: 446 * pw, set.h * pu }
            on scroll sm_wheel { sm_scroll_to = clamp(sm_scroll_to - wheel * 44, 0, max(0, sm.h - set.h)) }
            group {
                move: 0, -sm.off
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 40 * pu; size: 438 * pw, 68 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 40 * pu, 438 * pw, 68 * pu, 40.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 40 * pu; size: 438 * pw, 68 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 40 * pu; size: 438 * pw, 68 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 40 * pu; size: 438 * pw, 68 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 25 * pu + 0.5); text sm_host { at: floor(spx + 14 * pw + 0.5), floor(sby + 25 * pu + 0.5); anchor: left center; size: 24; weight: 700; width: (300 * pw) / rs; lines: 1; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 42 * pu + 0.5); text sm_cpu_name { at: floor(spx + 14 * pw + 0.5), floor(sby + 42 * pu + 0.5); anchor: left center; size: 15; weight: 500; width: (410 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 61 * pu + 0.5); text "UPTIME" { at: floor(spx + 14 * pw + 0.5), floor(sby + 61 * pu + 0.5); anchor: left center; size: 13; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 62 * pw + 0.5), floor(sby + 61 * pu + 0.5); text sm_uptime { at: floor(spx + 62 * pw + 0.5), floor(sby + 61 * pu + 0.5); anchor: left center; size: 16.5; weight: 600; width: (84 * pw) / rs; lines: 1; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 152 * pw + 0.5), floor(sby + 61 * pu + 0.5); text "LOAD" { at: floor(spx + 152 * pw + 0.5), floor(sby + 61 * pu + 0.5); anchor: left center; size: 13; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 200 * pw + 0.5), floor(sby + 61 * pu + 0.5); text sm_load { at: floor(spx + 200 * pw + 0.5), floor(sby + 61 * pu + 0.5); anchor: left center; size: 16.5; weight: 600; width: (84 * pw) / rs; lines: 1; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 292 * pw + 0.5), floor(sby + 61 * pu + 0.5); text "KERNEL" { at: floor(spx + 292 * pw + 0.5), floor(sby + 61 * pu + 0.5); anchor: left center; size: 13; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 346 * pw + 0.5), floor(sby + 61 * pu + 0.5); text sm_kernel { at: floor(spx + 346 * pw + 0.5), floor(sby + 61 * pu + 0.5); anchor: left center; size: 16.5; weight: 600; width: (84 * pw) / rs; lines: 1; color: ink; family: "Space Grotesk" } }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 190.5 * pu; size: 438 * pw, 173 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 190.5 * pu, 438 * pw, 173 * pu, 124.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 190.5 * pu; size: 438 * pw, 173 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 190.5 * pu; size: 438 * pw, 173 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 190.5 * pu; size: 438 * pw, 173 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 91 * pu + 0.5); text "PROCESSOR" { at: floor(spx + 14 * pw + 0.5), floor(sby + 91 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + 91 * pu + 0.5); text sm_cpu_meta { at: floor(spx + 424 * pw + 0.5), floor(sby + 91 * pu + 0.5); anchor: right center; size: 15; weight: 500; width: (260 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk"; align: right } }
            arc { at: spx + 74 * pw, sby + 181 * pu; radius: 44 * pu; span: 270deg; width: 9 * pu; color: ink; opacity: 9%; rotate: 0deg }
            arc { at: spx + 74 * pw, sby + 181 * pu; radius: 44 * pu; span: (270 * clamp(sm_cpu_p, 0.004, 1)) * 1deg; width: (9 * pu) * 2.1; opacity: 0.13; color: mix(mint, alert, clamp((sm_cpu_p - 0.75) / 0.25, 0, 1)); rotate: (-135 + 135 * clamp(sm_cpu_p, 0.004, 1)) * 1deg }
            arc { at: spx + 74 * pw, sby + 181 * pu; radius: 44 * pu; span: (270 * clamp(sm_cpu_p, 0.004, 1)) * 1deg; width: 9 * pu; color: mix(mint, alert, clamp((sm_cpu_p - 0.75) / 0.25, 0, 1)); rotate: (-135 + 135 * clamp(sm_cpu_p, 0.004, 1)) * 1deg }
            group { scale: rs; pivot: floor(spx + 74 * pw + 0.5), floor(sby + 176 * pu + 0.5); text sm_cpu_txt { at: floor(spx + 74 * pw + 0.5), floor(sby + 176 * pu + 0.5); anchor: center center; size: 32.5; weight: 700; width: (80 * pw) / rs; lines: 1; color: ink; family: "Space Grotesk"; align: center } }
            group { scale: rs; pivot: floor(spx + 74 * pw + 0.5), floor(sby + 198 * pu + 0.5); text "CPU" { at: floor(spx + 74 * pw + 0.5), floor(sby + 198 * pu + 0.5); anchor: center center; size: 13; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 74 * pw + 0.5), floor(sby + 257 * pu + 0.5); text sm_threads { at: floor(spx + 74 * pw + 0.5), floor(sby + 257 * pu + 0.5); anchor: center center; size: 15; weight: 500; width: (110 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk"; align: center } }
            box { at: spx + 286 * pw, sby + 153.5 * pu; size: 276 * pw, 0.6 * pu; color: ink; opacity: 7% }
            box { at: spx + 286 * pw, sby + 142 * pu; size: 276 * pw, 0.6 * pu; color: ink; opacity: 7% }
            box { at: spx + 286 * pw, sby + 130.5 * pu; size: 276 * pw, 0.6 * pu; color: ink; opacity: 7% }
            box { at: spx + 286 * pw, sby + 165 * pu; size: 276 * pw, 0.8 * pu; color: ink; opacity: 14% }
            repeat i in 0..60 {
                let k = i + 60 - sm_hist.count
                let hh = max(1.6, clamp(sm_hist.$i.cpu, 0, 1) * 46)
                box { at: spx + 148 * pw + (k + 0.5) * 4.6 * pu, sby + 165 * pu - hh / 2 * pu; size: 3.4 * pu, hh * pu; corner: 1.2 * pu; color: mix(mint, alert, clamp((sm_hist.$i.cpu - 0.75) / 0.25, 0, 1)); opacity: (22% + 70% * k / 60); show: i < sm_hist.count }
            }
            group { scale: rs; pivot: floor(spx + 148 * pw + 0.5), floor(sby + 177 * pu + 0.5); text "CORES" { at: floor(spx + 148 * pw + 0.5), floor(sby + 177 * pu + 0.5); anchor: left center; size: 13; weight: 700; color: faint; family: "Space Grotesk" } }
            repeat c in 0..16 {
                let cc = mod(c, 8)
                let cr = floor(c / 8)
                let cxx = 148 + cc * 35 + 13
                let cyy = 186 + cr * 42
                let cp = clamp(sm_core.$c.pct, 0, 1)
                box { at: spx + cxx * pu, sby + (cyy + 13) * pu; size: 26 * pu, 26 * pu; corner: 7 * pu; color: ink; opacity: 8%; show: c < sm_core.count }
                box { at: spx + cxx * pu, sby + (cyy + 26 - max(3, 26 * cp) / 2) * pu; size: 26 * pu, max(3, 26 * cp) * pu; corner: 7 * pu; color: mix(mint, alert, clamp((cp - 0.75) / 0.25, 0, 1)); opacity: 60% + 40% * cp; show: c < sm_core.count }
                group { scale: rs; pivot: floor(spx + cxx * pu + 0.5), floor(sby + (cyy + 34) * pu + 0.5); text number(c, 0, "") { at: floor(spx + cxx * pu + 0.5), floor(sby + (cyy + 34) * pu + 0.5); anchor: center; size: 12; color: faint; family: "Space Grotesk"; show: c < sm_core.count } }
            }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 378.5 * pu; size: 438 * pw, 143 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 378.5 * pu, 438 * pw, 143 * pu, 348.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 378.5 * pu; size: 438 * pw, 143 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 378.5 * pu; size: 438 * pw, 143 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 378.5 * pu; size: 438 * pw, 143 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 294 * pu + 0.5); text "MEMORY" { at: floor(spx + 14 * pw + 0.5), floor(sby + 294 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + 294 * pu + 0.5); text sm_mem_total { at: floor(spx + 424 * pw + 0.5), floor(sby + 294 * pu + 0.5); anchor: right center; size: 15; weight: 500; width: (200 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk"; align: right } }
            arc { at: spx + 74 * pw, sby + 374 * pu; radius: 40 * pu; span: 359deg; width: 11 * pu; color: ink; opacity: 9%; rotate: 0deg }
            arc { at: spx + 74 * pw, sby + 374 * pu; radius: 40 * pu; span: (360 * clamp(sm_cache_p, 0.004, 1)) * 1deg; width: (11 * pu) * 2.1; color: mint; opacity: (42%) * 0.12; rotate: (360 * clamp(sm_mem_p, 0, 1) + 180 * clamp(sm_cache_p, 0.004, 1)) * 1deg }
            arc { at: spx + 74 * pw, sby + 374 * pu; radius: 40 * pu; span: (360 * clamp(sm_cache_p, 0.004, 1)) * 1deg; width: 11 * pu; color: mint; opacity: 42%; rotate: (360 * clamp(sm_mem_p, 0, 1) + 180 * clamp(sm_cache_p, 0.004, 1)) * 1deg }
            arc { at: spx + 74 * pw, sby + 374 * pu; radius: 40 * pu; span: (360 * clamp(sm_mem_p, 0.004, 1)) * 1deg; width: (11 * pu) * 2.1; opacity: 0.12; color: mix(mint, alert, clamp((sm_mem_p - 0.85) / 0.15000000000000002, 0, 1)); rotate: (180 * clamp(sm_mem_p, 0.004, 1)) * 1deg }
            arc { at: spx + 74 * pw, sby + 374 * pu; radius: 40 * pu; span: (360 * clamp(sm_mem_p, 0.004, 1)) * 1deg; width: 11 * pu; color: mix(mint, alert, clamp((sm_mem_p - 0.85) / 0.15000000000000002, 0, 1)); rotate: (180 * clamp(sm_mem_p, 0.004, 1)) * 1deg }
            group { scale: rs; pivot: floor(spx + 74 * pw + 0.5), floor(sby + 370 * pu + 0.5); text sm_mem_pct { at: floor(spx + 74 * pw + 0.5), floor(sby + 370 * pu + 0.5); anchor: center center; size: 30; weight: 700; width: (80 * pw) / rs; lines: 1; color: ink; family: "Space Grotesk"; align: center } }
            group { scale: rs; pivot: floor(spx + 74 * pw + 0.5), floor(sby + 389 * pu + 0.5); text "IN USE" { at: floor(spx + 74 * pw + 0.5), floor(sby + 389 * pu + 0.5); anchor: center center; size: 13; weight: 700; color: faint; family: "Space Grotesk" } }
            ellipse { at: spx + 148 * pw, sby + 326 * pu; radius: 3.2 * pu; color: mint; opacity: 100% }
            group { scale: rs; pivot: floor(spx + 160 * pw + 0.5), floor(sby + 326 * pu + 0.5); text "Used" { at: floor(spx + 160 * pw + 0.5), floor(sby + 326 * pu + 0.5); anchor: left center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk"; opacity: 85% } }
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + 326 * pu + 0.5); text sm_mem_used { at: floor(spx + 424 * pw + 0.5), floor(sby + 326 * pu + 0.5); anchor: right center; size: 16.5; weight: 600; width: (200 * pw) / rs; lines: 1; color: ink; family: "Space Grotesk"; align: right } }
            ellipse { at: spx + 148 * pw, sby + 345 * pu; radius: 3.2 * pu; color: mint; opacity: 42% }
            group { scale: rs; pivot: floor(spx + 160 * pw + 0.5), floor(sby + 345 * pu + 0.5); text "Cache" { at: floor(spx + 160 * pw + 0.5), floor(sby + 345 * pu + 0.5); anchor: left center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk"; opacity: 85% } }
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + 345 * pu + 0.5); text sm_mem_cache { at: floor(spx + 424 * pw + 0.5), floor(sby + 345 * pu + 0.5); anchor: right center; size: 16.5; weight: 600; width: (200 * pw) / rs; lines: 1; color: ink; family: "Space Grotesk"; align: right } }
            ellipse { at: spx + 148 * pw, sby + 364 * pu; radius: 3.2 * pu; color: ink; opacity: 22% }
            group { scale: rs; pivot: floor(spx + 160 * pw + 0.5), floor(sby + 364 * pu + 0.5); text "Free" { at: floor(spx + 160 * pw + 0.5), floor(sby + 364 * pu + 0.5); anchor: left center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk"; opacity: 85% } }
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + 364 * pu + 0.5); text sm_mem_free { at: floor(spx + 424 * pw + 0.5), floor(sby + 364 * pu + 0.5); anchor: right center; size: 16.5; weight: 600; width: (200 * pw) / rs; lines: 1; color: ink; family: "Space Grotesk"; align: right } }
            group { scale: rs; pivot: floor(spx + 148 * pw + 0.5), floor(sby + 388 * pu + 0.5); text "SWAP" { at: floor(spx + 148 * pw + 0.5), floor(sby + 388 * pu + 0.5); anchor: left center; size: 13; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + 388 * pu + 0.5); text sm_swap_txt { at: floor(spx + 424 * pw + 0.5), floor(sby + 388 * pu + 0.5); anchor: right center; size: 15; weight: 500; width: (230 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk"; align: right } }
            box { at: spx + 286 * pw, sby + 400 * pu; size: 276 * pw, 6 * pu; corner: 3 * pu; color: ink; opacity: 8% }
            box { from: spx + 148 * pw, sby + 397 * pu; size: max(6, 276 * clamp(sm_swap_p, 0, 1)) * pu, 6 * pu; corner: 3 * pu; color: mint }
            box { at: spx + 286 * pw, sby + 442 * pu; size: 276 * pw, 0.8 * pu; color: ink; opacity: 14% }
            repeat i in 0..60 {
                let k = i + 60 - sm_hist.count
                let hh = max(1.6, clamp(sm_hist.$i.mem, 0, 1) * 30)
                box { at: spx + 148 * pw + (k + 0.5) * 4.6 * pu, sby + 442 * pu - hh / 2 * pu; size: 3.4 * pu, hh * pu; corner: 1.2 * pu; color: mint; opacity: (22% + 70% * k / 60); show: i < sm_hist.count }
            }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 554.5 * pu; size: 438 * pw, 149 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 554.5 * pu, 438 * pw, 149 * pu, 572.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 554.5 * pu; size: 438 * pw, 149 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 554.5 * pu; size: 438 * pw, 149 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 554.5 * pu; size: 438 * pw, 149 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 467 * pu + 0.5); text "GRAPHICS" { at: floor(spx + 14 * pw + 0.5), floor(sby + 467 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + 467 * pu + 0.5); text sm_gpu_name { at: floor(spx + 424 * pw + 0.5), floor(sby + 467 * pu + 0.5); anchor: right center; size: 15; weight: 500; width: (300 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk"; align: right; show: sm_gpu_on } }
            group { scale: rs; pivot: floor(spx + 219 * pw + 0.5), floor(sby + 551 * pu + 0.5); text "No GPU sensors found" { at: floor(spx + 219 * pw + 0.5), floor(sby + 551 * pu + 0.5); anchor: center center; size: 18; weight: 500; width: (300 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk"; align: center; show: not sm_gpu_on } }
            group {
                show: sm_gpu_on
            arc { at: spx + 74 * pw, sby + 553 * pu; radius: 44 * pu; span: 270deg; width: 8 * pu; color: ink; opacity: 9%; rotate: 0deg }
            arc { at: spx + 74 * pw, sby + 553 * pu; radius: 44 * pu; span: (270 * clamp(sm_gpu_p, 0.004, 1)) * 1deg; width: (8 * pu) * 2.1; opacity: 0.13; color: mix(mint, alert, clamp((sm_gpu_p - 0.8) / 0.19999999999999996, 0, 1)); rotate: (-135 + 135 * clamp(sm_gpu_p, 0.004, 1)) * 1deg }
            arc { at: spx + 74 * pw, sby + 553 * pu; radius: 44 * pu; span: (270 * clamp(sm_gpu_p, 0.004, 1)) * 1deg; width: 8 * pu; color: mix(mint, alert, clamp((sm_gpu_p - 0.8) / 0.19999999999999996, 0, 1)); rotate: (-135 + 135 * clamp(sm_gpu_p, 0.004, 1)) * 1deg }
            arc { at: spx + 74 * pw, sby + 553 * pu; radius: 30 * pu; span: 270deg; width: 6 * pu; color: ink; opacity: 8%; rotate: 0deg }
            arc { at: spx + 74 * pw, sby + 553 * pu; radius: 30 * pu; span: (270 * clamp(sm_vram_p, 0.004, 1)) * 1deg; width: (6 * pu) * 2.1; opacity: 0.13; color: mix(mint, ink, 0.25); rotate: (-135 + 135 * clamp(sm_vram_p, 0.004, 1)) * 1deg }
            arc { at: spx + 74 * pw, sby + 553 * pu; radius: 30 * pu; span: (270 * clamp(sm_vram_p, 0.004, 1)) * 1deg; width: 6 * pu; color: mix(mint, ink, 0.25); rotate: (-135 + 135 * clamp(sm_vram_p, 0.004, 1)) * 1deg }
            group { scale: rs; pivot: floor(spx + 74 * pw + 0.5), floor(sby + 550 * pu + 0.5); text sm_gpu_txt { at: floor(spx + 74 * pw + 0.5), floor(sby + 550 * pu + 0.5); anchor: center center; size: 25.5; weight: 700; width: (64 * pw) / rs; lines: 1; color: ink; family: "Space Grotesk"; align: center } }
            group { scale: rs; pivot: floor(spx + 74 * pw + 0.5), floor(sby + 567 * pu + 0.5); text "GPU" { at: floor(spx + 74 * pw + 0.5), floor(sby + 567 * pu + 0.5); anchor: center center; size: 13; weight: 700; color: faint; family: "Space Grotesk" } }
