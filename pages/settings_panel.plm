        zone box side_ao { at: sl + 75 * pu, sby + side.ao * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_ao { set_page = pg_addons }
        //  Theme: a palette with its three dabs of colour.
        group {
            opacity: 65% + 35% * set_pgp
            pivot: sl + 30 * pu, sby + side.th * pu
            scale: 1 + 0.28 * set_pgp + 0.03 * set_pgp * sin(floor(time * 5) * 47)
            move: set_pgp * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgp * 0.6 * pu * sin(floor(time * 5) * 61)
            box { at: sl + 30 * pu, sby + side.th * pu; size: 15 * pu, 12 * pu; corner: 5 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgp) }
            ellipse { at: sl + 27.5 * pu, sby + (side.th - 1.5) * pu; radius: 1.3 * pu; color: mix(ink, mint, set_pgp) }
            ellipse { at: sl + 31 * pu, sby + (side.th - 2.5) * pu; radius: 1.3 * pu; color: mix(ink, mint, set_pgp) }
            ellipse { at: sl + 32.5 * pu, sby + (side.th + 1.5) * pu; radius: 1.3 * pu; color: mix(ink, mint, set_pgp) }
        }
        group { scale: rs * (1 + 0.28 * set_pgp); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.th * pu + 0.5); text "Theme" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.th * pu + 0.5); anchor: left center; size: 18; weight: 700; width: (102 * pu) / rs; lines: 1; color: mix(ink, mint, set_pgp); opacity: 85% + 15% * set_pgp; family: "Space Grotesk" } }
        zone box side_th { at: sl + 75 * pu, sby + side.th * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_th { set_page = pg_theme }
        //  VPN: a shield.
