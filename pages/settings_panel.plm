        zone box side_vpn { at: sl + 75 * pu, sby + side.vpn * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_vpn { set_page = pg_vpn }
        //  Keybinds: a keyboard, a plate of keys.
        group {
            opacity: 65% + 35% * set_pgy
            pivot: sl + 30 * pu, sby + side.ky * pu
            scale: 1 + 0.28 * set_pgy + 0.03 * set_pgy * sin(floor(time * 5) * 47)
            move: set_pgy * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgy * 0.6 * pu * sin(floor(time * 5) * 61)
            box { at: sl + 30 * pu, sby + side.ky * pu; size: 16 * pu, 11 * pu; corner: 2.5 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgy) }
            repeat k in 0..3 { ellipse { at: sl + (6 + 20.5 + k * 3.5) * pu, sby + (side.ky - 2) * pu; radius: 0.8 * pu; color: mix(ink, mint, set_pgy) } }
            line { from: sl + 27 * pu, sby + (side.ky + 2.2) * pu; to: sl + 33 * pu, sby + (side.ky + 2.2) * pu; width: 1.2 * pu; color: mix(ink, mint, set_pgy) }
        }
        group { scale: rs * (1 + 0.28 * set_pgy); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.ky * pu + 0.5); text "Keybinds" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.ky * pu + 0.5); anchor: left center; size: 18; weight: 700; width: (102 * pu) / rs; lines: 1; color: mix(ink, mint, set_pgy); opacity: 85% + 15% * set_pgy; family: "Space Grotesk" } }
        zone box side_ky { at: sl + 75 * pu, sby + side.ky * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_ky { set_page = pg_keys }
        zone box side_lk { at: sl + 75 * pu, sby + side.lk * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_lk { set_page = pg_lock }
        zone box side_ck { at: sl + 75 * pu, sby + side.ck * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_ck { set_page = pg_clock }
        zone box side_nt2 { at: sl + 75 * pu, sby + side.nt * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_nt2 { set_page = pg_nt }
        zone box side_sy { at: sl + 75 * pu, sby + side.mon * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_sy { set_page = pg_sys }
        zone box side_ab { at: sl + 75 * pu, sby + side.ab * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_ab { set_page = pg_about }
        zone box side_hy { at: sl + 75 * pu, sby + side.hy * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer; show: wm_hypr or wm_niri }
        on press side_hy { set_page = pg_hypr }
        zone box side_dp { at: sl + 75 * pu, sby + side.dp * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_dp { set_page = pg_disp }
        zone box side_bar { at: sl + 75 * pu, sby + side.bar * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_bar { set_page = pg_bar }
        zone box side_wp { at: sl + 75 * pu, sby + side.wp * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        zone box side_gl { at: sl + 75 * pu, sby + side.gl * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_wp { set_page = pg_wall }
        on press side_gl { set_page = pg_glass }

        include "wallpaper.plm"

        include "glass.plm"

        include "bar.plm"

        //  The Lock screen page (System): an example of the password bar, what a typed character becomes and its colours, then how blurred the
        //  wallpaper is, the clock, the date and the player. These are the lock screen scene's own settings (`lockscreen.json`): the logic asks
        //  it for them when this page opens and tells it each change. The page scrolls like System monitor's, and its zones are only live
        //  while they are in the window.
        include "lockscreen.plm"

        include "nightmode.plm"
        include "idle.plm"

        //  The About page: the build (this shell's commit and pleamar's version) and the way to update it.
        //  Checking is a `git fetch`, updating a `git pull --ff-only`, and after that the shell starts again.
        group {
            show: set_pga > 0.01
            opacity: set_pga

            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 70 * pu; size: 438 * pu, 140 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 70 * pu; size: 438 * pu, 140 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 201 * pu; size: 438 * pu, 98 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 201 * pu; size: 438 * pu, 98 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); text "BUILD" { at: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 165 * pu + 0.5); text "UPDATE" { at: floor(spx + 14 * pu + 0.5), floor(sby + 165 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }

            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 40 * pu + 0.5); text "Vitreus" { at: floor(spx + 14 * pu + 0.5), floor(sby + 40 * pu + 0.5); anchor: left center; size: 16.5; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 40 * pu + 0.5); text about_commit { at: floor(spx + 424 * pu + 0.5), floor(sby + 40 * pu + 0.5); anchor: right center; size: 18; weight: 600; width: (300 * pu) / rs; lines: 1; align: right; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 66 * pu + 0.5); text "Committed" { at: floor(spx + 14 * pu + 0.5), floor(sby + 66 * pu + 0.5); anchor: left center; size: 16.5; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 66 * pu + 0.5); text about_date { at: floor(spx + 424 * pu + 0.5), floor(sby + 66 * pu + 0.5); anchor: right center; size: 18; weight: 600; width: (300 * pu) / rs; lines: 1; align: right; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 92 * pu + 0.5); text "Last change" { at: floor(spx + 14 * pu + 0.5), floor(sby + 92 * pu + 0.5); anchor: left center; size: 16.5; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 92 * pu + 0.5); text about_sub { at: floor(spx + 424 * pu + 0.5), floor(sby + 92 * pu + 0.5); anchor: right center; size: 16.5; width: (300 * pu) / rs; lines: 1; align: right; color: ink; opacity: 85%; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 118 * pu + 0.5); text "pleamar" { at: floor(spx + 14 * pu + 0.5), floor(sby + 118 * pu + 0.5); anchor: left center; size: 16.5; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 118 * pu + 0.5); text about_pl { at: floor(spx + 424 * pu + 0.5), floor(sby + 118 * pu + 0.5); anchor: right center; size: 18; weight: 600; width: (300 * pu) / rs; lines: 1; align: right; color: ink; family: "Space Grotesk" } }

            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 190 * pu + 0.5); text about_msg { at: floor(spx + 14 * pu + 0.5), floor(sby + 190 * pu + 0.5); anchor: left center; size: 16.5; width: (410 * pu) / rs; lines: 1; color: if(about_behind > 0, mint, faint); family: "Space Grotesk" } }

            //  Check for updates.
            box { at: spx + 78 * pu, sby + 226 * pu; size: 128 * pu, 24 * pu; corner: 12 * pu; color: ink; opacity: if(about_busy, 5%, 8% + 10% * about_chk_hit.hover) }
            PPillOutline(spx + 78 * pu, sby + 226 * pu, 128 * pu, 24 * pu, 12 * pu, about_chk_hit.hover, clamp(3 * (if(about_busy, 5%, 8% + 10% * about_chk_hit.hover)), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 78 * pu + 0.5), floor(sby + 226 * pu + 0.5); text "Check for updates" { at: floor(spx + 78 * pu + 0.5), floor(sby + 226 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (124 * pu) / rs; lines: 1; color: ink; opacity: if(about_restarting, 40%, 85%); family: "Space Grotesk" } }
            zone box about_chk_hit { at: spx + 78 * pu, sby + 226 * pu; size: 130 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: not about_busy }
            on press about_chk_hit { emit about_check }

            //  Update, and start again: only when there is something to pull.
            box { at: spx + 219 * pu, sby + 226 * pu; size: 128 * pu, 24 * pu; corner: 12 * pu; color: mint; opacity: if(about_behind > 0 and not about_busy, 24% + 12% * about_upd_hit.hover, 6%) }
            PPillOutline(spx + 219 * pu, sby + 226 * pu, 128 * pu, 24 * pu, 12 * pu, about_upd_hit.hover, clamp(3 * (if(about_behind > 0 and not about_busy, 24% + 12% * about_upd_hit.hover, 6%)), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 219 * pu + 0.5), floor(sby + 226 * pu + 0.5); text "Update & restart" { at: floor(spx + 219 * pu + 0.5), floor(sby + 226 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (124 * pu) / rs; lines: 1; color: mint; opacity: if(about_behind > 0 and not about_busy, 100%, 35%); family: "Space Grotesk" } }
            zone box about_upd_hit { at: spx + 219 * pu, sby + 226 * pu; size: 130 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: about_behind > 0 and not about_busy }
            on press about_upd_hit { emit about_update }

            //  Restart.
            box { at: spx + 360 * pu, sby + 226 * pu; size: 128 * pu, 24 * pu; corner: 12 * pu; color: ink; opacity: if(about_restarting, 5%, 8% + 10% * about_rst_hit.hover) }
            PPillOutline(spx + 360 * pu, sby + 226 * pu, 128 * pu, 24 * pu, 12 * pu, about_rst_hit.hover, clamp(3 * (if(about_restarting, 5%, 8% + 10% * about_rst_hit.hover)), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 360 * pu + 0.5), floor(sby + 226 * pu + 0.5); text "Restart shell" { at: floor(spx + 360 * pu + 0.5), floor(sby + 226 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (124 * pu) / rs; lines: 1; color: ink; opacity: if(about_restarting, 40%, 85%); family: "Space Grotesk" } }
            zone box about_rst_hit { at: spx + 360 * pu, sby + 226 * pu; size: 130 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: not about_restarting }
            on press about_rst_hit { emit about_restart }
        }

        include "hyprland.plm"

        include "niri.plm"

        include "pleamar_wm.plm"

        include "notifications.plm"

        include "clock.plm"
        include "addons.plm"

        include "theme.plm"

        include "vpn.plm"

        include "keybinds.plm"

        include "sysmon.plm"

        include "display.plm"
    }
}
