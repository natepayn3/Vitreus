            move: set_pgv * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgv * 0.6 * pu * sin(floor(time * 5) * 61)
            path { at: sl + 30 * pu, sby + side.vpn * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgv); move 0, -7 * pu; line 6 * pu, -4.5 * pu; line 6 * pu, 1 * pu; line 0, 7.5 * pu; line -6 * pu, 1 * pu; line -6 * pu, -4.5 * pu; close }
        }
