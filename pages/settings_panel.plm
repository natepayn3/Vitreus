part SettingsPanel {
    //  ── the settings panel ──
    //  Laid out as a header with an icon badge, the title and a breadcrumb chip; under
    //  it a sidebar of sections next to the page, which is a stack of cards. The wallpaper picker is the
    //  first (and, for now, only) page.
    group {
        shader: pixelate, px.ds
        clip inset 2 box { at: mix(pcx, ds.gx, fm), mix(bar.y + ss.hh / 2, lp.cy, fm); size: mix(ss.w, ds.gw, fm), mix(ss.hh, ds.gh, fm); corner: 26 * pu * (1 - 0.73 * sq) }
        opacity: fs * pown
        move: rt * (screen.width - 2 * pcx), (1 - fs) * 12 * pu + bt * (yo + vb - 2 * lp.cy)
        let hy = ck + 26 * pu                              // the header's middle
        let sby = ck + 52 * pu                              // the top of the sidebar and the page
        let sl = pcx - 298 * pu                             // their left edge
        let spx = sl + 158 * pu                             // the page's left edge

        //  Header: a badge with a gear, SETTINGS, the breadcrumb, and a cross.
        box { at: sl + 16 * pu, hy; size: 32 * pu, 32 * pu; corner: 9 * pu; color: mint; opacity: 20% }
        group {
            //  The gear is drawn in pencil, as the notification's bell and the volume's smiley are (lines drawn again, a hair off, about eight times a second: `ic_hot` runs
            //  the clock for a couple of seconds after the panel opens or the page changes, and the lines rest after). It turns half a turn as the panel opens (on `ds`, which
            //  overshoots) and clicks one tooth round for each page you go to (`gr_t`, a spring that overshoots, like a ratchet).
            pivot: sl + 16 * pu, hy
            rotate: -200deg * (1 - ds) + gr_t * 45deg
            let gfr = floor(time * 8)
            let gcx = sl + 16 * pu
            repeat k in 0..14 {
                let ga0 = k * 25.7 + 6
                let ga1 = ga0 + 28
                let gr0 = 6 * pu * (1 + 0.07 * sin(gfr * 53 + k * 97))
                let gr1 = 6 * pu * (1 + 0.07 * sin(gfr * 53 + (k + 1) * 97))
                line { from: gcx + gr0 * cos(ga0), hy + gr0 * sin(ga0); to: gcx + gr1 * cos(ga1), hy + gr1 * sin(ga1); width: 2 * pu; color: mint; opacity: 92% }
            }
            repeat k in 0..9 {
                let gb0 = k * 40 + 70
                let gb1 = gb0 + 44
                let gs0 = 5.3 * pu * (1 + 0.08 * sin(gfr * 41 + k * 131 + 40))
                let gs1 = 5.3 * pu * (1 + 0.08 * sin(gfr * 41 + (k + 1) * 131 + 40))
                line { from: gcx + 0.8 * pu + gs0 * cos(gb0), hy - 0.5 * pu + gs0 * sin(gb0); to: gcx + 0.8 * pu + gs1 * cos(gb1), hy - 0.5 * pu + gs1 * sin(gb1); width: 1.2 * pu; color: mint; opacity: 34% }
            }
            ellipse { at: gcx + 0.4 * pu * sin(gfr * 71), hy + 0.4 * pu * sin(gfr * 83 + 20); radius: 2 * pu; color: mint }
            repeat i in 0..8 {
                group {
                    pivot: gcx, hy
                    rotate: i * 45deg
                    line { from: gcx + 0.5 * pu * sin(gfr * 61 + i * 50), hy - 6.8 * pu; to: gcx + 0.5 * pu * sin(gfr * 67 + i * 30), hy - 10.8 * pu; width: 3 * pu; color: mint }
                    line { from: gcx + 1.1 * pu + 0.4 * pu * sin(gfr * 47 + i * 70), hy - 7.2 * pu; to: gcx + 1.1 * pu + 0.4 * pu * sin(gfr * 53 + i * 90), hy - 10.4 * pu; width: 1.1 * pu; color: mint; opacity: 34% }
                }
            }
        }
        group { scale: rs; pivot: floor(sl + 40 * pu + 0.5), floor(hy + 0.5); text "SETTINGS" { at: floor(sl + 40 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 21; weight: 700; color: ink; family: "Space Grotesk" } }
        path { at: sl + 110 * pu, hy; stroke: 1.3 * pu; color: faint; move -2 * pu, -3.5 * pu; line 2 * pu, 0; line -2 * pu, 3.5 * pu }
        group { scale: rs; pivot: floor(sl + 122 * pu + 0.5), floor(hy + 0.5); text "LOOK" { at: floor(sl + 122 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; opacity: 1 - set_pgh + set_pga + set_pgs + set_pgw + set_pgv + set_pgy - set_pgb + set_pgk + set_pgt + set_pgl - set_pgd + set_pgn - set_pgi; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 122 * pu + 0.5), floor(hy + 0.5); text "SHELL" { at: floor(sl + 122 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; opacity: set_pgb + set_pgk + set_pgt + set_pgl; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 122 * pu + 0.5), floor(hy + 0.5); text "SCREEN" { at: floor(sl + 122 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; opacity: set_pgd + set_pgn + set_pgi; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 122 * pu + 0.5), floor(hy + 0.5); text "SYSTEM" { at: floor(sl + 122 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; opacity: set_pgh + set_pga + set_pgs + set_pgw + set_pgv + set_pgy; family: "Space Grotesk" } }
        path { at: sl + 168 * pu, hy; stroke: 1.3 * pu; color: faint; move -2 * pu, -3.5 * pu; line 2 * pu, 0; line -2 * pu, 3.5 * pu }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "Wallpaper" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: 1 - set_pg - set_pgd - set_pgb - set_pgn - set_pgh - set_pga - set_pgs - set_pgt - set_pgl - set_pgw - set_pgv - set_pgk - set_pgp - set_pgy - set_pgo - set_pgi; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "Display" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgd; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "Glass" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pg; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); show: wm_hypr; text "Hyprland" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgh; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); show: wm_niri; text "niri" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgh; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "Pleamar-WM" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgw; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "Bar" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgb; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "About" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pga; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "Idle" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgi; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "Night mode" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgn; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "System monitor" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgs; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "Notifications" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgt; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "VPN" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgv; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "Lock screen" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgl; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "Widgets" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgk; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "Theme" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgp; family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); text "Keybinds" { at: floor(sl + 176 * pu + 0.5), floor(hy + 0.5); anchor: left center; size: 14.5; weight: 700; color: mint; opacity: set_pgy; family: "Space Grotesk" } }
        ellipse { at: pcx + 282 * pu, hy; radius: 13 * pu; color: ink; opacity: 5% + 10% * set_x.hover }
        line { from: pcx + 277.5 * pu, hy - 4.5 * pu; to: pcx + 286.5 * pu, hy + 4.5 * pu; width: 1.5 * pu; color: ink; opacity: 60% + 40% * set_x.hover }
        line { from: pcx + 286.5 * pu, hy - 4.5 * pu; to: pcx + 277.5 * pu, hy + 4.5 * pu; width: 1.5 * pu; color: ink; opacity: 60% + 40% * set_x.hover }
        zone box set_x { at: pcx + 282 * pu, hy; size: 28 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
        on press set_x { panel = none }

        //  Sidebar: the sections, grouped. One so far.
        //  Obsidian: the sidebar is a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
        body { color: mix(mix(obsidian, ink, 4% * 1.6), dd_p2, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: sl + 75 * pu, sby + set.h / 2 * pu; size: 150 * pu, set.h * pu; corner: 14 * pu } }
        box { at: sl + 75 * pu, sby + set.h / 2 * pu; size: 150 * pu, set.h * pu; corner: 14 * pu; color: ink; opacity: 4% * (1 - obs) }
        group { scale: rs; pivot: sl + 15.8 * pu, sby + side.h1 * pu + 1.6 * pu; text "LOOK" { at: sl + 15.8 * pu, sby + side.h1 * pu + 1.6 * pu; anchor: left center; size: 15.5; weight: 700; color: ink; opacity: 32%; letter_move: letter * 4 * pu, 0.9 * pu * sin(letter * 2.4 + 1.3); letter_scale: 1 + 0.07 * sin(letter * 3.7 + 0.5); family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 14 * pu + 0.5), floor(sby + side.h1 * pu + 0.5); text "LOOK" { at: floor(sl + 14 * pu + 0.5), floor(sby + side.h1 * pu + 0.5); anchor: left center; size: 17; weight: 700; gradient: sl + 14 * pu, sby + side.h1 * pu to sl + 72 * pu, sby + side.h1 * pu, mintlo, minthi; opacity: 100%; letter_move: letter * 4 * pu, 0.9 * pu * sin(letter * 2.4 + 1.3); letter_scale: 1 + 0.07 * sin(letter * 3.7 + 0.5); family: "Space Grotesk" } }
        group { scale: rs; pivot: sl + 15.8 * pu, sby + side.h2 * pu + 1.6 * pu; text "SHELL" { at: sl + 15.8 * pu, sby + side.h2 * pu + 1.6 * pu; anchor: left center; size: 15.5; weight: 700; color: ink; opacity: 32%; letter_move: letter * 4 * pu, 0.9 * pu * sin(letter * 2.4 + 1.3); letter_scale: 1 + 0.07 * sin(letter * 3.7 + 0.5); family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 14 * pu + 0.5), floor(sby + side.h2 * pu + 0.5); text "SHELL" { at: floor(sl + 14 * pu + 0.5), floor(sby + side.h2 * pu + 0.5); anchor: left center; size: 17; weight: 700; gradient: sl + 14 * pu, sby + side.h2 * pu to sl + 86 * pu, sby + side.h2 * pu, mintlo, minthi; opacity: 100%; letter_move: letter * 4 * pu, 0.9 * pu * sin(letter * 2.4 + 1.3); letter_scale: 1 + 0.07 * sin(letter * 3.7 + 0.5); family: "Space Grotesk" } }
        group { scale: rs; pivot: sl + 15.8 * pu, sby + side.h3 * pu + 1.6 * pu; text "SCREEN" { at: sl + 15.8 * pu, sby + side.h3 * pu + 1.6 * pu; anchor: left center; size: 15.5; weight: 700; color: ink; opacity: 32%; letter_move: letter * 4 * pu, 0.9 * pu * sin(letter * 2.4 + 1.3); letter_scale: 1 + 0.07 * sin(letter * 3.7 + 0.5); family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 14 * pu + 0.5), floor(sby + side.h3 * pu + 0.5); text "SCREEN" { at: floor(sl + 14 * pu + 0.5), floor(sby + side.h3 * pu + 0.5); anchor: left center; size: 17; weight: 700; gradient: sl + 14 * pu, sby + side.h3 * pu to sl + 104 * pu, sby + side.h3 * pu, mintlo, minthi; opacity: 100%; letter_move: letter * 4 * pu, 0.9 * pu * sin(letter * 2.4 + 1.3); letter_scale: 1 + 0.07 * sin(letter * 3.7 + 0.5); family: "Space Grotesk" } }
        //  A line down the side of each group, in its own colour.
        box { at: sl + 5.2 * pu, sby + (side.wp - 14 + side.gl + 14) / 2 * pu; size: 2.5 * pu, (side.gl + 14 - side.wp + 14) * pu; corner: 1.25 * pu; color: mint; opacity: 70% }
        box { at: sl + 5.2 * pu, sby + (side.bar - 14 + side.lk + 14) / 2 * pu; size: 2.5 * pu, (side.lk + 14 - side.bar + 14) * pu; corner: 1.25 * pu; color: mintlo; opacity: 90% }
        box { at: sl + 5.2 * pu, sby + (side.dp - 14 + side.id + 14) / 2 * pu; size: 2.5 * pu, (side.id + 14 - side.dp + 14) * pu; corner: 1.25 * pu; color: minthi; opacity: 70% }
        box { at: sl + 5.2 * pu, sby + (side.hy - 14 + side.ab + 14) / 2 * pu; size: 2.5 * pu, (side.ab + 14 - side.hy + 14) * pu; corner: 1.25 * pu; color: faint; opacity: 60% }
        //  The highlight's place is each page's own selection (a spring, 0 or 1) times its row, summed: a straight line from one row to the next.
        //  (Nested `mix`es bent it: the old row's value falling while the new one rises dragged it back towards the top row and down again.)
        box { at: sl + 75 * pu, sby + (side.wp + (side.gl - side.wp) * set_pg + (side.dp - side.wp) * set_pgd + (side.bar - side.wp) * set_pgb + (side.nm - side.wp) * set_pgn + (side.hy - side.wp) * set_pgh + (side.wm - side.wp) * set_pgw + (side.mon - side.wp) * set_pgs + (side.nt - side.wp) * set_pgt + (side.lk - side.wp) * set_pgl + (side.vpn - side.wp) * set_pgv + (side.ck - side.wp) * set_pgk + (side.th - side.wp) * set_pgp + (side.ky - side.wp) * set_pgy + (side.ao - side.wp) * set_pgo + (side.id - side.wp) * set_pgi + (side.ab - side.wp) * set_pga) * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; color: mint; opacity: 16% }
        group {
            opacity: 65% + 35% * (1 - clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw + set_pgv + set_pgk + set_pgp + set_pgy + set_pgo + set_pgi, 0, 1))
            pivot: sl + 30 * pu, sby + side.wp * pu
            scale: 1 + 0.28 * (1 - clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw + set_pgv + set_pgk + set_pgp + set_pgy + set_pgo + set_pgi, 0, 1)) + 0.03 * (1 - clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw + set_pgv + set_pgk + set_pgp + set_pgy + set_pgo + set_pgi, 0, 1)) * sin(floor(time * 5) * 47)
            move: (1 - clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw + set_pgv + set_pgk + set_pgp + set_pgy + set_pgo + set_pgi, 0, 1)) * 0.6 * pu * sin(floor(time * 5) * 53 + 40), (1 - clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw + set_pgv + set_pgk + set_pgp + set_pgy + set_pgo + set_pgi, 0, 1)) * 0.6 * pu * sin(floor(time * 5) * 61)
            box { at: sl + 30 * pu, sby + side.wp * pu; size: 13 * pu, 10 * pu; corner: 2 * pu; stroke: 1.3 * pu; color: mix(mint, ink, clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw + set_pgv + set_pgk + set_pgp + set_pgy + set_pgo + set_pgi, 0, 1)) }
            path { at: sl + 30 * pu, sby + side.wp * pu; color: mix(mint, ink, clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw + set_pgv + set_pgk + set_pgp + set_pgy + set_pgo + set_pgi, 0, 1)); move -5 * pu, 3 * pu; line -1.5 * pu, -1 * pu; line 1 * pu, 1.5 * pu; line 2.5 * pu, -1.5 * pu; line 5 * pu, 3 * pu; close }
            ellipse { at: sl + 33 * pu, sby + (side.wp - 3) * pu; radius: 1.2 * pu; color: mix(mint, ink, clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw + set_pgv + set_pgk + set_pgp + set_pgy + set_pgo + set_pgi, 0, 1)) }
        }
        group { scale: rs * (1 + 0.28 * (1 - clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw + set_pgv + set_pgk + set_pgp + set_pgy + set_pgo + set_pgi, 0, 1))); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.wp * pu + 0.5); text "Wallpaper" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.wp * pu + 0.5); anchor: left center; size: 18; weight: 700; color: mix(mint, ink, clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw + set_pgv + set_pgk + set_pgp + set_pgy + set_pgo + set_pgi, 0, 1)); opacity: 100% - 15% * clamp(set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw + set_pgv + set_pgk + set_pgp + set_pgy + set_pgo + set_pgi, 0, 1); family: "Space Grotesk" } }
        //  Glass: a pane with a highlight across its corner.
        group {
            opacity: 65% + 35% * set_pg
            pivot: sl + 30 * pu, sby + side.gl * pu
            scale: 1 + 0.28 * set_pg + 0.03 * set_pg * sin(floor(time * 5) * 47)
            move: set_pg * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pg * 0.6 * pu * sin(floor(time * 5) * 61)
            box { at: sl + 30 * pu, sby + side.gl * pu; size: 13 * pu, 13 * pu; corner: 3.5 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pg) }
            line { from: sl + 26.5 * pu, sby + (side.gl + 2.5) * pu; to: sl + 30.5 * pu, sby + (side.gl - 3) * pu; width: 1.1 * pu; color: mix(ink, mint, set_pg); opacity: 80% }
        }
        group { scale: rs * (1 + 0.28 * set_pg); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.gl * pu + 0.5); text "Glass" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.gl * pu + 0.5); anchor: left center; size: 18; weight: 700; color: mix(ink, mint, set_pg); opacity: 85% + 15% * set_pg; family: "Space Grotesk" } }
        //  Display: a screen on its stand.
        group {
            opacity: 65% + 35% * set_pgd
            pivot: sl + 30 * pu, sby + side.dp * pu
            scale: 1 + 0.28 * set_pgd + 0.03 * set_pgd * sin(floor(time * 5) * 47)
            move: set_pgd * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgd * 0.6 * pu * sin(floor(time * 5) * 61)
            box { at: sl + 30 * pu, sby + (side.dp - 2) * pu; size: 14 * pu, 9.5 * pu; corner: 2 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgd) }
            line { from: sl + 30 * pu, sby + (side.dp + 3.5) * pu; to: sl + 30 * pu, sby + (side.dp + 6) * pu; width: 1.3 * pu; color: mix(ink, mint, set_pgd) }
            line { from: sl + 26.5 * pu, sby + (side.dp + 6.5) * pu; to: sl + 33.5 * pu, sby + (side.dp + 6.5) * pu; width: 1.3 * pu; color: mix(ink, mint, set_pgd) }
        }
        group { scale: rs * (1 + 0.28 * set_pgd); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.dp * pu + 0.5); text "Display" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.dp * pu + 0.5); anchor: left center; size: 18; weight: 700; color: mix(ink, mint, set_pgd); opacity: 85% + 15% * set_pgd; family: "Space Grotesk" } }
        //  Bar: a pill with its three dots, the bar itself.
        group {
            opacity: 65% + 35% * set_pgb
            pivot: sl + 30 * pu, sby + side.bar * pu
            scale: 1 + 0.28 * set_pgb + 0.03 * set_pgb * sin(floor(time * 5) * 47)
            move: set_pgb * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgb * 0.6 * pu * sin(floor(time * 5) * 61)
            box { at: sl + 30 * pu, sby + side.bar * pu; size: 16 * pu, 8 * pu; corner: 4 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgb) }
            repeat k in 0..3 { ellipse { at: sl + (6 + 21 + k * 3) * pu, sby + side.bar * pu; radius: 0.9 * pu; color: mix(ink, mint, set_pgb) } }
        }
        group { scale: rs * (1 + 0.28 * set_pgb); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.bar * pu + 0.5); text "Bar" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.bar * pu + 0.5); anchor: left center; size: 18; weight: 700; color: mix(ink, mint, set_pgb); opacity: 85% + 15% * set_pgb; family: "Space Grotesk" } }
        //  Night mode: the same crescent as the Power window's Sleep button, a little smaller.
        group {
            opacity: 65% + 35% * set_pgn
            pivot: sl + 30 * pu, sby + side.nm * pu
            scale: 1 + 0.28 * set_pgn + 0.03 * set_pgn * sin(floor(time * 5) * 47)
            move: set_pgn * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgn * 0.6 * pu * sin(floor(time * 5) * 61)
            path { at: sl + 30 * pu, sby + side.nm * pu; stroke: 1.6 * pu; color: mix(ink, mint, set_pgn); move 5.97 * pu, 2.28 * pu; line 5.59 * pu, 3.07 * pu; line 5.10 * pu, 3.80 * pu; line 4.51 * pu, 4.45 * pu; line 3.84 * pu, 5.02 * pu; line 3.09 * pu, 5.48 * pu; line 2.29 * pu, 5.83 * pu; line 1.44 * pu, 6.06 * pu; line 0.57 * pu, 6.18 * pu; line -0.30 * pu, 6.16 * pu; line -1.17 * pu, 6.03 * pu; line -2.01 * pu, 5.77 * pu; line -2.81 * pu, 5.40 * pu; line -3.54 * pu, 4.92 * pu; line -4.20 * pu, 4.34 * pu; line -4.77 * pu, 3.68 * pu; line -5.24 * pu, 2.94 * pu; line -5.60 * pu, 2.14 * pu; line -5.85 * pu, 1.30 * pu; line -5.97 * pu, 0.42 * pu; line -5.96 * pu, -0.45 * pu; line -5.84 * pu, -1.32 * pu; line -5.59 * pu, -2.16 * pu; line -5.23 * pu, -2.96 * pu; line -4.76 * pu, -3.70 * pu; line -4.18 * pu, -4.36 * pu; line -3.53 * pu, -4.94 * pu; line -2.79 * pu, -5.42 * pu; line -1.99 * pu, -5.79 * pu; line -1.15 * pu, -6.04 * pu; line -0.29 * pu, -6.18 * pu; line -0.70 * pu, -5.70 * pu; line -1.05 * pu, -5.18 * pu; line -1.34 * pu, -4.63 * pu; line -1.56 * pu, -4.05 * pu; line -1.71 * pu, -3.44 * pu; line -1.79 * pu, -2.82 * pu; line -1.80 * pu, -2.20 * pu; line -1.73 * pu, -1.57 * pu; line -1.59 * pu, -0.96 * pu; line -1.38 * pu, -0.37 * pu; line -1.10 * pu, 0.19 * pu; line -0.76 * pu, 0.71 * pu; line -0.36 * pu, 1.20 * pu; line 0.09 * pu, 1.63 * pu; line 0.60 * pu, 2.00 * pu; line 1.14 * pu, 2.31 * pu; line 1.71 * pu, 2.56 * pu; line 2.31 * pu, 2.74 * pu; line 2.93 * pu, 2.84 * pu; line 3.56 * pu, 2.87 * pu; line 4.18 * pu, 2.84 * pu; line 4.80 * pu, 2.72 * pu; line 5.39 * pu, 2.53 * pu; line 5.97 * pu, 2.28 * pu; line 5.97 * pu, 2.28 * pu }
        }
        group { scale: rs * (1 + 0.28 * set_pgn); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.nm * pu + 0.5); text "Night mode" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.nm * pu + 0.5); anchor: left center; size: 18; weight: 700; color: mix(ink, mint, set_pgn); opacity: 85% + 15% * set_pgn; family: "Space Grotesk" } }
        zone box side_nt { at: sl + 75 * pu, sby + side.nm * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_nt { set_page = pg_night }
        //  Idle: a small clock face.
        group {
            opacity: 65% + 35% * set_pgi
            pivot: sl + 30 * pu, sby + side.id * pu
            scale: 1 + 0.28 * set_pgi + 0.03 * set_pgi * sin(floor(time * 5) * 47)
            move: set_pgi * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgi * 0.6 * pu * sin(floor(time * 5) * 61)
            ellipse { at: sl + 30 * pu, sby + side.id * pu; radius: 6.5 * pu; stroke: 1.5 * pu; color: mix(ink, mint, set_pgi) }
            line { from: sl + 30 * pu, sby + side.id * pu; to: sl + 30 * pu, sby + (side.id - 3.6) * pu; width: 1.4 * pu; color: mix(ink, mint, set_pgi) }
            line { from: sl + 30 * pu, sby + side.id * pu; to: sl + 32.6 * pu, sby + (side.id + 1.6) * pu; width: 1.4 * pu; color: mix(ink, mint, set_pgi) }
        }
        group { scale: rs * (1 + 0.28 * set_pgi); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.id * pu + 0.5); text "Idle" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.id * pu + 0.5); anchor: left center; size: 18; weight: 700; color: mix(ink, mint, set_pgi); opacity: 85% + 15% * set_pgi; family: "Space Grotesk" } }
        zone box side_id { at: sl + 75 * pu, sby + side.id * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer }
        on press side_id { set_page = pg_idle }
        group { scale: rs; pivot: sl + 15.8 * pu, sby + side.h4 * pu + 1.6 * pu; text "SYSTEM" { at: sl + 15.8 * pu, sby + side.h4 * pu + 1.6 * pu; anchor: left center; size: 15.5; weight: 700; color: ink; opacity: 32%; letter_move: letter * 4 * pu, 0.9 * pu * sin(letter * 2.4 + 1.3); letter_scale: 1 + 0.07 * sin(letter * 3.7 + 0.5); family: "Space Grotesk" } }
        group { scale: rs; pivot: floor(sl + 14 * pu + 0.5), floor(sby + side.h4 * pu + 0.5); text "SYSTEM" { at: floor(sl + 14 * pu + 0.5), floor(sby + side.h4 * pu + 0.5); anchor: left center; size: 17; weight: 700; gradient: sl + 14 * pu, sby + side.h4 * pu to sl + 106 * pu, sby + side.h4 * pu, mintlo, minthi; opacity: 100%; letter_move: letter * 4 * pu, 0.9 * pu * sin(letter * 2.4 + 1.3); letter_scale: 1 + 0.07 * sin(letter * 3.7 + 0.5); family: "Space Grotesk" } }
        //  Hyprland: a window with its title bar.
        group {
            opacity: 65% + 35% * set_pgh
            pivot: sl + 30 * pu, sby + side.hy * pu
            scale: 1 + 0.28 * set_pgh + 0.03 * set_pgh * sin(floor(time * 5) * 47)
            move: set_pgh * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgh * 0.6 * pu * sin(floor(time * 5) * 61)
            box { at: sl + 30 * pu, sby + side.hy * pu; size: 14 * pu, 11 * pu; corner: 2 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgh); show: wm_hypr or wm_niri }
            line { from: sl + 23 * pu, sby + (side.hy - 2) * pu; to: sl + 37 * pu, sby + (side.hy - 2) * pu; width: 1.3 * pu; color: mix(ink, mint, set_pgh); show: wm_hypr or wm_niri }
        }
        group { scale: rs * (1 + 0.28 * set_pgh); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.hy * pu + 0.5); show: wm_hypr; text "Hyprland" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.hy * pu + 0.5); anchor: left center; size: 18; weight: 700; color: mix(ink, mint, set_pgh); opacity: 85% + 15% * set_pgh; family: "Space Grotesk" } }
        group { scale: rs * (1 + 0.28 * set_pgh); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.hy * pu + 0.5); show: wm_niri; text "niri" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.hy * pu + 0.5); anchor: left center; size: 18; weight: 700; color: mix(ink, mint, set_pgh); opacity: 85% + 15% * set_pgh; family: "Space Grotesk" } }
        //  Pleamar-WM: two tiles side by side.
        group {
            opacity: 65% + 35% * set_pgw
            pivot: sl + 30 * pu, sby + side.wm * pu
            scale: 1 + 0.28 * set_pgw + 0.03 * set_pgw * sin(floor(time * 5) * 47)
            move: set_pgw * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgw * 0.6 * pu * sin(floor(time * 5) * 61)
            box { at: sl + 30 * pu, sby + side.wm * pu; size: 14 * pu, 11 * pu; corner: 2 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgw); show: wm_pwm }
            line { from: sl + 32 * pu, sby + (side.wm - 5.5) * pu; to: sl + 32 * pu, sby + (side.wm + 5.5) * pu; width: 1.3 * pu; color: mix(ink, mint, set_pgw); show: wm_pwm }
        }
        group { scale: rs * (1 + 0.28 * set_pgw); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.wm * pu + 0.5); show: wm_pwm; text "Pleamar-WM" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.wm * pu + 0.5); anchor: left center; size: 18; weight: 700; width: (102 * pu) / rs; lines: 1; color: mix(ink, mint, set_pgw); opacity: 85% + 15% * set_pgw; family: "Space Grotesk" } }
        zone box side_wm { at: sl + 75 * pu, sby + side.wm * pu; size: 134 * pu, 28 * pu; corner: 10 * pu; cursor: pointer; show: wm_pwm }
        on press side_wm { set_page = pg_wm }
        //  About: an i in a circle.
        group {
            opacity: 65% + 35% * set_pga
            pivot: sl + 30 * pu, sby + side.ab * pu
            scale: 1 + 0.28 * set_pga + 0.03 * set_pga * sin(floor(time * 5) * 47)
            move: set_pga * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pga * 0.6 * pu * sin(floor(time * 5) * 61)
            ellipse { at: sl + 30 * pu, sby + side.ab * pu; radius: 6.5 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pga) }
            line { from: sl + 30 * pu, sby + side.ab * pu; to: sl + 30 * pu, sby + (side.ab + 3.5) * pu; width: 1.3 * pu; color: mix(ink, mint, set_pga) }
            ellipse { at: sl + 30 * pu, sby + (side.ab - 3.2) * pu; radius: 0.9 * pu; color: mix(ink, mint, set_pga) }
        }
        group { scale: rs * (1 + 0.28 * set_pga); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.ab * pu + 0.5); text "About" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.ab * pu + 0.5); anchor: left center; size: 18; weight: 700; color: mix(ink, mint, set_pga); opacity: 85% + 15% * set_pga; family: "Space Grotesk" } }
        //  System monitor: a pulse line.
        group {
            opacity: 65% + 35% * set_pgs
            pivot: sl + 30 * pu, sby + side.mon * pu
            scale: 1 + 0.28 * set_pgs + 0.03 * set_pgs * sin(floor(time * 5) * 47)
            move: set_pgs * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgs * 0.6 * pu * sin(floor(time * 5) * 61)
            path { at: sl + 30 * pu, sby + side.mon * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgs); move -7 * pu, 1 * pu; line -3.5 * pu, 1 * pu; line -1.5 * pu, -5 * pu; line 1.5 * pu, 5 * pu; line 3.5 * pu, -1 * pu; line 7 * pu, -1 * pu }
        }
        group { scale: rs * (1 + 0.28 * set_pgs); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.mon * pu + 0.5); text "System monitor" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.mon * pu + 0.5); anchor: left center; size: 18; weight: 700; width: (102 * pu) / rs; lines: 1; color: mix(ink, mint, set_pgs); opacity: 85% + 15% * set_pgs; family: "Space Grotesk" } }
        //  Notifications: a bell.
        group {
            opacity: 65% + 35% * set_pgt
            pivot: sl + 30 * pu, sby + side.nt * pu
            scale: 1 + 0.28 * set_pgt + 0.03 * set_pgt * sin(floor(time * 5) * 47)
            move: set_pgt * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgt * 0.6 * pu * sin(floor(time * 5) * 61)
            path { at: sl + 30 * pu, sby + side.nt * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgt); move -5.5 * pu, 4 * pu; line -5.5 * pu, 3 * pu; line -4 * pu, 1.5 * pu; line -4 * pu, -2.5 * pu; curve 4 * pu, -2.5 * pu via 0, -9 * pu; line 4 * pu, 1.5 * pu; line 5.5 * pu, 3 * pu; line 5.5 * pu, 4 * pu; close }
            ellipse { at: sl + 30 * pu, sby + (side.nt + 6.5) * pu; radius: 1.6 * pu; color: mix(ink, mint, set_pgt) }
        }
        group { scale: rs * (1 + 0.28 * set_pgt); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.nt * pu + 0.5); text "Notifications" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.nt * pu + 0.5); anchor: left center; size: 18; weight: 700; width: (102 * pu) / rs; lines: 1; color: mix(ink, mint, set_pgt); opacity: 85% + 15% * set_pgt; family: "Space Grotesk" } }
        //  Lock screen: a padlock.
        group {
            opacity: 65% + 35% * set_pgl
            pivot: sl + 30 * pu, sby + side.lk * pu
            scale: 1 + 0.28 * set_pgl + 0.03 * set_pgl * sin(floor(time * 5) * 47)
            move: set_pgl * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgl * 0.6 * pu * sin(floor(time * 5) * 61)
            path { at: sl + 30 * pu, sby + side.lk * pu - 2.5 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgl); move -3.5 * pu, -1 * pu; line -3.5 * pu, -4 * pu; curve 3.5 * pu, -4 * pu via 0 * pu, -10.5 * pu; line 3.5 * pu, -1 * pu }
            box { at: sl + 30 * pu, sby + side.lk * pu + 2 * pu; size: 12 * pu, 8.5 * pu; corner: 2.2 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgl) }
        }
        group { scale: rs * (1 + 0.28 * set_pgl); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.lk * pu + 0.5); text "Lock screen" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.lk * pu + 0.5); anchor: left center; size: 18; weight: 700; width: (102 * pu) / rs; lines: 1; color: mix(ink, mint, set_pgl); opacity: 85% + 15% * set_pgl; family: "Space Grotesk" } }
        //  Widgets: four small tiles.
        group {
            opacity: 65% + 35% * set_pgk
            pivot: sl + 30 * pu, sby + side.ck * pu
            scale: 1 + 0.28 * set_pgk + 0.03 * set_pgk * sin(floor(time * 5) * 47)
            move: set_pgk * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgk * 0.6 * pu * sin(floor(time * 5) * 61)
            box { at: sl + 26.5 * pu, sby + (side.ck - 3.5) * pu; size: 5.5 * pu, 5.5 * pu; corner: 1.5 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgk) }
            box { at: sl + 33.5 * pu, sby + (side.ck - 3.5) * pu; size: 5.5 * pu, 5.5 * pu; corner: 1.5 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgk) }
            box { at: sl + 26.5 * pu, sby + (side.ck + 3.5) * pu; size: 5.5 * pu, 5.5 * pu; corner: 1.5 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgk) }
            box { at: sl + 33.5 * pu, sby + (side.ck + 3.5) * pu; size: 5.5 * pu, 5.5 * pu; corner: 1.5 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgk) }
        }
        group { scale: rs * (1 + 0.28 * set_pgk); pivot: floor(sl + 46 * pu + 0.5), floor(sby + side.ck * pu + 0.5); text "Widgets" { at: floor(sl + 46 * pu + 0.5), floor(sby + side.ck * pu + 0.5); anchor: left center; size: 18; weight: 700; width: (102 * pu) / rs; lines: 1; color: mix(ink, mint, set_pgk); opacity: 85% + 15% * set_pgk; family: "Space Grotesk" } }
        //  Add-ons: a tile with a plus, a place for more.
        group {
            opacity: 65% + 35% * set_pgo
