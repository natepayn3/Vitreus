            scale: 1 + 0.28 * set_pgo + 0.03 * set_pgo * sin(floor(time * 5) * 47)
            move: set_pgo * 0.6 * pu * sin(floor(time * 5) * 53 + 40), set_pgo * 0.6 * pu * sin(floor(time * 5) * 61)
            box { at: sl + 30 * pu, sby + side.ao * pu; size: 14 * pu, 14 * pu; corner: 4 * pu; stroke: 1.3 * pu; color: mix(ink, mint, set_pgo) }
