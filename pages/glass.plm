part Glass {
        //  The Glass page. Sliders that act on the bar and every drawer at once, as they are dragged. Edge thickness and Rainbow fringe
        //  are dimmed until "Bend what's behind the glass" is on: they only do something to glass that bends. The blur is Hyprland's.
        group {
            show: set_pg > 0.01
            opacity: set_pg
            let gsl.x0 = spx + 14 * pu
            let gsl.w = 336 * pu
            let gh = 10 * pu
            let gl.sc = clamp(gl_scroll, 0, max(0, gl.h - set.h))
            let gl.off = floor(gl.sc * pu + 0.5)        // whole pixels: text that is shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pu, sby + set.h / 2 * pu; size: 456 * pu, set.h * pu }
            //  A scroll goes to the zone declared last under the pointer, and the rows' zones cover most of the page: each one scrolls it too.
            zone box gl_wheel { at: spx + 219 * pu, sby + set.h / 2 * pu; size: 446 * pu, set.h * pu }
            on scroll gl_wheel { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }
            group {
            move: 0, -gl.off

            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); text "Glass" { at: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: left center; size: 19.5; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 16 * pu + 0.5); text "Changes apply right away." { at: floor(spx + 424 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: right center; size: 15; color: faint; opacity: 80%; family: "Space Grotesk" } }

            //  Glass on or off. Off is a flat, solid obsidian, and everything below it is greyed out and stops answering.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 67 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 67 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 67 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu; color: mint; opacity: 6% * glass_on_pill + 5% * glass_obs_hit.hover }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 59 * pu + 0.5); text "Glass" { at: floor(spx + 14 * pu + 0.5), floor(sby + 59 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 75 * pu + 0.5); text "Off for a solid obsidian look, with no glass at all" { at: floor(spx + 14 * pu + 0.5), floor(sby + 75 * pu + 0.5); anchor: left center; size: 14; color: faint; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pu, sby + 67 * pu, glass_on_pill, glass_obs_hit.pressed, glass_obs_hit.hover, mint)
            zone box glass_obs_hit { at: spx + 219 * pu, sby + 67 * pu; size: 430 * pu, 46 * pu; corner: 14 * pu; cursor: pointer; active: (sby + 67 * pu) - gl.off > sby and (sby + 67 * pu) - gl.off < sby + set.h * pu }
            on press glass_obs_hit { emit glass_obs_toggle }
            on scroll glass_obs_hit { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }

            //  Blur.  (always available: it also blurs behind the obsidian shell)
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 225 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 225 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 209 * pu + 0.5); text "Blur" { at: floor(spx + 14 * pu + 0.5), floor(sby + 209 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; opacity: 100%; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 224 * pu + 0.5); text "Hyprland's blur, for the flat look and glass that doesn't bend; see Frost" { at: floor(spx + 14 * pu + 0.5), floor(sby + 224 * pu + 0.5); anchor: left center; size: 14; color: faint; opacity: 100%; family: "Space Grotesk" } }
            group {
                opacity: 100%
                PSlider(gsl.x0, sby + 241 * pu, gsl.w, clamp(clamp(hy_blur / 20, 0, 1), 0, 1), glass_hit2.hover, cu, gh, 0)
            }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 212 * pu + 0.5); text hy_blur_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 212 * pu + 0.5); anchor: right center; size: 20; weight: 600; color: ink; opacity: 100%; family: "Space Grotesk" } }
            zone box glass_hit2 { at: gsl.x0 + gsl.w / 2, sby + 241 * pu; size: gsl.w + 28 * pu, 26 * pu; cursor: pointer; active: (sby + 241 * pu) - gl.off > sby and (sby + 241 * pu) - gl.off < sby + set.h * pu }
            on press glass_hit2 { emit glass_blur_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }
            on scroll glass_hit2 { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }
            on drag glass_hit2 { emit glass_blur_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }

            //  Everything the glass is made of: greyed out while the glass is off.
            group {
                opacity: 1 - 0.65 * obs
            //  Glass.

            //  Opacity.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 283 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 283 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 267 * pu + 0.5); text "Opacity" { at: floor(spx + 14 * pu + 0.5), floor(sby + 267 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; opacity: 100%; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 282 * pu + 0.5); text "How solid; the first 30% can't be picked, the glass would vanish" { at: floor(spx + 14 * pu + 0.5), floor(sby + 282 * pu + 0.5); anchor: left center; size: 14; color: faint; opacity: 100%; family: "Space Grotesk" } }
            group {
                opacity: 100%
                PSlider(gsl.x0, sby + 299 * pu, gsl.w, clamp(clamp(glass_op, 0, 1), 0, 1), glass_hit1.hover, cu, gh, 0)
            }
            //  The first 30 % of this track cannot be picked: it is shaded, with a tick where the range starts.
            box { from: gsl.x0, sby + 299 * pu - gh / 2; size: gsl.w * 0.3, gh; corner: gh / 2; color: #000000; opacity: 38% }
            box { at: gsl.x0 + gsl.w * 0.3, sby + 299 * pu; size: 1.5 * pu, gh + 6 * pu; corner: 0.75 * pu; color: ink; opacity: 45% }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 270 * pu + 0.5); text glass_op_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 270 * pu + 0.5); anchor: right center; size: 20; weight: 600; color: ink; opacity: 100%; family: "Space Grotesk" } }
            zone box glass_hit1 { at: gsl.x0 + gsl.w / 2, sby + 299 * pu; size: gsl.w + 28 * pu, 26 * pu; cursor: pointer; active: (obs < 0.5) and (sby + 299 * pu) - gl.off > sby and (sby + 299 * pu) - gl.off < sby + set.h * pu }
            on press glass_hit1 { emit glass_op_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }
            on scroll glass_hit1 { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }
            on drag glass_hit1 { emit glass_op_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }

            //  Edge light.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 341 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 341 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 325 * pu + 0.5); text "Edge light" { at: floor(spx + 14 * pu + 0.5), floor(sby + 325 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; opacity: 100%; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 340 * pu + 0.5); text "How bright the light along the glass edge is" { at: floor(spx + 14 * pu + 0.5), floor(sby + 340 * pu + 0.5); anchor: left center; size: 14; color: faint; opacity: 100%; family: "Space Grotesk" } }
            group {
                opacity: 100%
                PSlider(gsl.x0, sby + 357 * pu, gsl.w, clamp(clamp(glass_rim / 2, 0, 1), 0, 1), glass_hit3.hover, cu, gh, 0)
            }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 328 * pu + 0.5); text glass_rim_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 328 * pu + 0.5); anchor: right center; size: 20; weight: 600; color: ink; opacity: 100%; family: "Space Grotesk" } }
            zone box glass_hit3 { at: gsl.x0 + gsl.w / 2, sby + 357 * pu; size: gsl.w + 28 * pu, 26 * pu; cursor: pointer; active: (obs < 0.5) and (sby + 357 * pu) - gl.off > sby and (sby + 357 * pu) - gl.off < sby + set.h * pu }
            on press glass_hit3 { emit glass_rim_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }
            on scroll glass_hit3 { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }
            on drag glass_hit3 { emit glass_rim_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }

            //  Edge thickness.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 399 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 399 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 383 * pu + 0.5); text "Edge thickness" { at: floor(spx + 14 * pu + 0.5), floor(sby + 383 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; opacity: 100% * (0.35 + 0.65 * glass_bend_k); family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 398 * pu + 0.5); text "How much the edge bends what is behind it" { at: floor(spx + 14 * pu + 0.5), floor(sby + 398 * pu + 0.5); anchor: left center; size: 14; color: faint; opacity: 100% * (0.35 + 0.65 * glass_bend_k); family: "Space Grotesk" } }
            group {
                opacity: 100% * (0.35 + 0.65 * glass_bend_k)
                PSlider(gsl.x0, sby + 415 * pu, gsl.w, clamp(clamp(glass_refr / 3, 0, 1), 0, 1), glass_hit4.hover, cu, gh, 0)
            }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 386 * pu + 0.5); text glass_refr_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 386 * pu + 0.5); anchor: right center; size: 20; weight: 600; color: ink; opacity: 100% * (0.35 + 0.65 * glass_bend_k); family: "Space Grotesk" } }
            zone box glass_hit4 { at: gsl.x0 + gsl.w / 2, sby + 415 * pu; size: gsl.w + 28 * pu, 26 * pu; cursor: pointer; active: (obs < 0.5) and (sby + 415 * pu) - gl.off > sby and (sby + 415 * pu) - gl.off < sby + set.h * pu }
            on press glass_hit4 { emit glass_refr_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }
            on scroll glass_hit4 { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }
            on drag glass_hit4 { emit glass_refr_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }

            //  Rainbow fringe.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 457 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 457 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 441 * pu + 0.5); text "Rainbow fringe" { at: floor(spx + 14 * pu + 0.5), floor(sby + 441 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; opacity: 100% * (0.35 + 0.65 * glass_bend_k); family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 456 * pu + 0.5); text "How far red, green and blue split at the edge" { at: floor(spx + 14 * pu + 0.5), floor(sby + 456 * pu + 0.5); anchor: left center; size: 14; color: faint; opacity: 100% * (0.35 + 0.65 * glass_bend_k); family: "Space Grotesk" } }
            group {
                opacity: 100% * (0.35 + 0.65 * glass_bend_k)
                PSlider(gsl.x0, sby + 473 * pu, gsl.w, clamp(clamp(glass_disp / 2.5, 0, 1), 0, 1), glass_hit5.hover, cu, gh, 0)
            }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 444 * pu + 0.5); text glass_disp_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 444 * pu + 0.5); anchor: right center; size: 20; weight: 600; color: ink; opacity: 100% * (0.35 + 0.65 * glass_bend_k); family: "Space Grotesk" } }
            zone box glass_hit5 { at: gsl.x0 + gsl.w / 2, sby + 473 * pu; size: gsl.w + 28 * pu, 26 * pu; cursor: pointer; active: (obs < 0.5) and (sby + 473 * pu) - gl.off > sby and (sby + 473 * pu) - gl.off < sby + set.h * pu }
            on press glass_hit5 { emit glass_disp_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }
            on scroll glass_hit5 { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }
            on drag glass_hit5 { emit glass_disp_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }

            //  Bend what is behind the glass: swaps the compositor's blur for real bending (it takes a screenshot of what is
            //  behind the bar while anything moves, so it costs more power).
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 118 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 118 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group {
                opacity: 100% * (1 - 0.6 * glass_live_k)
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 110 * pu + 0.5); text "X-Bend" { at: floor(spx + 14 * pu + 0.5), floor(sby + 110 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 126 * pu + 0.5); text "Show wallpaper but not live windows. Light GPU load." { at: floor(spx + 14 * pu + 0.5), floor(sby + 126 * pu + 0.5); anchor: left center; size: 14; weight: 600; color: faint; family: "Space Grotesk" } }
                SettingsSwitch(spx + 424 * pu, sby + 118 * pu, glass_bend_pill, glass_bend_hit.pressed, glass_bend_hit.hover, mint)
            }
            zone box glass_bend_hit { at: spx + 219 * pu, sby + 118 * pu; size: 430 * pu, 40 * pu; corner: 12 * pu; cursor: pointer; active: (obs < 0.5 and not glass_live) and (sby + 118 * pu) - gl.off > sby and (sby + 118 * pu) - gl.off < sby + set.h * pu }
            on press glass_bend_hit { emit glass_bend_toggle }
            on scroll glass_bend_hit { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }

            //  Live bend: the glass bends the live windows behind it (a capture) instead of the wallpaper copy (`lens = image ... while`): real, but a screencopy each time something moves.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 168 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 168 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group {
                opacity: 100%
                path { at: spx + 26 * pu, sby + 168 * pu; stroke: 1.8 * pu; color: alert; move 0, -9 * pu; line 10 * pu, 8 * pu; line -10 * pu, 8 * pu; line 0, -9 * pu }
                path { at: spx + 26 * pu, sby + 168 * pu; stroke: 1.8 * pu; color: alert; move 0, -3 * pu; line 0, 2.5 * pu }
                ellipse { at: spx + 26 * pu, sby + 171.5 * pu; radius: 1.1 * pu; color: alert }
            }
            group { scale: rs; pivot: floor(spx + 46 * pu + 0.5), floor(sby + 160 * pu + 0.5); text "Live bend" { at: floor(spx + 46 * pu + 0.5), floor(sby + 160 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; opacity: 100%; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 46 * pu + 0.5), floor(sby + 176 * pu + 0.5); text "Bends the live windows. Heavy GPU load." { at: floor(spx + 46 * pu + 0.5), floor(sby + 176 * pu + 0.5); anchor: left center; size: 14; weight: 600; color: alert; opacity: 100%; family: "Space Grotesk" } }
            group {
                opacity: 100%
                SettingsSwitch(spx + 424 * pu, sby + 168 * pu, glass_live_pill, glass_live_hit.pressed, glass_live_hit.hover, mint)
            }
            zone box glass_live_hit { at: spx + 219 * pu, sby + 168 * pu; size: 430 * pu, 40 * pu; corner: 12 * pu; cursor: pointer; active: (obs < 0.5) and (sby + 168 * pu) - gl.off > sby and (sby + 168 * pu) - gl.off < sby + set.h * pu }
            on press glass_live_hit { emit glass_live_toggle }
            on scroll glass_live_hit { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }

            //  Frost: how frosted it is inside the edge, 0% being clear glass (pleamar's `frost:`; only the glass that bends has it, so it is dimmed with that off, and while Auto decides).
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 515 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 515 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 499 * pu + 0.5); text "Frost" { at: floor(spx + 14 * pu + 0.5), floor(sby + 499 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; opacity: 100% * (0.35 + 0.65 * glass_bend_k) * (1 - 0.55 * glass_auto_pill); family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 514 * pu + 0.5); text "How frosted inside the edge; 0% is clear glass" { at: floor(spx + 14 * pu + 0.5), floor(sby + 514 * pu + 0.5); anchor: left center; size: 14; color: faint; opacity: 100% * (0.35 + 0.65 * glass_bend_k) * (1 - 0.55 * glass_auto_pill); family: "Space Grotesk" } }
            group {
                opacity: 100% * (0.35 + 0.65 * glass_bend_k) * (1 - 0.55 * glass_auto_pill)
                PSlider(gsl.x0, sby + 531 * pu, gsl.w, clamp(clamp(glass_clear, 0, 1), 0, 1), glass_hit6.hover, cu, gh, 0)
            }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 502 * pu + 0.5); text glass_clear_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 502 * pu + 0.5); anchor: right center; size: 20; weight: 600; color: ink; opacity: 100% * (0.35 + 0.65 * glass_bend_k) * (1 - 0.55 * glass_auto_pill); family: "Space Grotesk" } }
            zone box glass_hit6 { at: gsl.x0 + gsl.w / 2, sby + 531 * pu; size: gsl.w + 28 * pu, 26 * pu; cursor: pointer; active: (obs < 0.5 and glass_bend and not glass_auto) and (sby + 531 * pu) - gl.off > sby and (sby + 531 * pu) - gl.off < sby + set.h * pu }
            on press glass_hit6 { emit glass_clear_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }
            on scroll glass_hit6 { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }
            on drag glass_hit6 { emit glass_clear_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }


            //  Auto frost: frosted only where what is behind is busy (words, a window), clear over a wallpaper. `frost: auto` cannot come from an expression, so
            //  this swaps to a copy of each glass with it (see the bodies in bar_glass.plm). Dimmed while the glass does not bend.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 568 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 568 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group {
                opacity: 100% * (0.45 + 0.55 * glass_bend_k)
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 560 * pu + 0.5); text "Frost only where it's busy" { at: floor(spx + 14 * pu + 0.5), floor(sby + 560 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 576 * pu + 0.5); text "Clear over the wallpaper, frosted behind words and windows" { at: floor(spx + 14 * pu + 0.5), floor(sby + 576 * pu + 0.5); anchor: left center; size: 14; weight: 600; color: alert; family: "Space Grotesk" } }
                SettingsSwitch(spx + 424 * pu, sby + 568 * pu, glass_auto_pill, glass_auto_hit.pressed, glass_auto_hit.hover, mint)
            }
            zone box glass_auto_hit { at: spx + 219 * pu, sby + 568 * pu; size: 430 * pu, 40 * pu; corner: 12 * pu; cursor: pointer; active: (obs < 0.5 and glass_bend) and (sby + 568 * pu) - gl.off > sby and (sby + 568 * pu) - gl.off < sby + set.h * pu }
            on press glass_auto_hit { emit glass_auto_toggle }
            on scroll glass_auto_hit { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }

            //  Dome.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 627 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 627 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 611 * pu + 0.5); text "Dome" { at: floor(spx + 14 * pu + 0.5), floor(sby + 611 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; opacity: 100%; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 626 * pu + 0.5); text "Magnifies what is behind, towards the middle" { at: floor(spx + 14 * pu + 0.5), floor(sby + 626 * pu + 0.5); anchor: left center; size: 14; color: faint; opacity: 100%; family: "Space Grotesk" } }
            group {
                opacity: 100%
                PSlider(gsl.x0, sby + 643 * pu, gsl.w, clamp(clamp(glass_dome / 1.5, 0, 1), 0, 1), glass_hit7.hover, cu, gh, 0)
            }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 614 * pu + 0.5); text glass_dome_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 614 * pu + 0.5); anchor: right center; size: 20; weight: 600; color: ink; opacity: 100%; family: "Space Grotesk" } }
            zone box glass_hit7 { at: gsl.x0 + gsl.w / 2, sby + 643 * pu; size: gsl.w + 28 * pu, 26 * pu; cursor: pointer; active: (obs < 0.5) and (sby + 643 * pu) - gl.off > sby and (sby + 643 * pu) - gl.off < sby + set.h * pu }
            on press glass_hit7 { emit glass_dome_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }
            on scroll glass_hit7 { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }
            on drag glass_hit7 { emit glass_dome_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }


            //  Milk.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 691 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 691 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 675 * pu + 0.5); text "Milk" { at: floor(spx + 14 * pu + 0.5), floor(sby + 675 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; opacity: 100%; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 690 * pu + 0.5); text "A milky veil inside the glass" { at: floor(spx + 14 * pu + 0.5), floor(sby + 690 * pu + 0.5); anchor: left center; size: 14; color: faint; opacity: 100%; family: "Space Grotesk" } }
            group {
                opacity: 100%
                PSlider(gsl.x0, sby + 707 * pu, gsl.w, clamp(clamp(glass_milk / 1, 0, 1), 0, 1), glass_hit8.hover, cu, gh, 0)
            }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 678 * pu + 0.5); text glass_milk_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 678 * pu + 0.5); anchor: right center; size: 20; weight: 600; color: ink; opacity: 100%; family: "Space Grotesk" } }
            zone box glass_hit8 { at: gsl.x0 + gsl.w / 2, sby + 707 * pu; size: gsl.w + 28 * pu, 26 * pu; cursor: pointer; active: (obs < 0.5) and (sby + 707 * pu) - gl.off > sby and (sby + 707 * pu) - gl.off < sby + set.h * pu }
            on press glass_hit8 { emit glass_milk_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }
            on scroll glass_hit8 { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }
            on drag glass_hit8 { emit glass_milk_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }

            //  Live bend refresh (the Milk card, copied): the least time between two captures of the screen.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 891 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 891 * pu; size: 438 * pu, 54 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 875 * pu + 0.5); text "Live bend refresh" { at: floor(spx + 14 * pu + 0.5), floor(sby + 875 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; opacity: 100%; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 890 * pu + 0.5); text "Least time between two captures: longer is lighter on the panels" { at: floor(spx + 14 * pu + 0.5), floor(sby + 890 * pu + 0.5); anchor: left center; size: 14; color: faint; opacity: 100%; family: "Space Grotesk" } }
            group {
                opacity: 100%
                PSlider(gsl.x0, sby + 907 * pu, gsl.w, clamp((lens_interval_ms - 50) / 950, 0, 1), glass_hit9.hover, cu, gh, 0)
            }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 878 * pu + 0.5); text glass_cap_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 878 * pu + 0.5); anchor: right center; size: 20; weight: 600; color: ink; opacity: 100%; family: "Space Grotesk" } }
            zone box glass_hit9 { at: gsl.x0 + gsl.w / 2, sby + 907 * pu; size: gsl.w + 28 * pu, 26 * pu; cursor: pointer; active: (obs < 0.5) and (sby + 907 * pu) - gl.off > sby and (sby + 907 * pu) - gl.off < sby + set.h * pu }
            on press glass_hit9 { emit glass_cap_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }
            on scroll glass_hit9 { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }
            on drag glass_hit9 { emit glass_cap_set(clamp(((pointer.x - tx.pnl) - gsl.x0) / gsl.w, 0, 1)) }

            //  Bend on: which monitors the bend is on. A lit tile is the only monitor that bends; none lit is all of them. The tiles are the Bar page's.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 791 * pu; size: 438 * pu, 116 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 791 * pu; size: 438 * pu, 116 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 749 * pu + 0.5); text "Bend on" { at: floor(spx + 14 * pu + 0.5), floor(sby + 749 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; opacity: 100% * (0.35 + 0.65 * glass_bend_k); family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 764 * pu + 0.5); text "Pick one monitor to bend only there; none picked is all" { at: floor(spx + 14 * pu + 0.5), floor(sby + 764 * pu + 0.5); anchor: left center; size: 14; color: faint; opacity: 100% * (0.35 + 0.65 * glass_bend_k); family: "Space Grotesk" } }
            repeat i in 0..4 {
                let gbx = spx + (52 + i * 83) * pu
                let gby = sby + 812 * pu
                let gblit = if(glass_bm.$i, 1, 0)
                group {
                    show: bar_m.$i.on
                    opacity: 100% * (0.35 + 0.65 * glass_bend_k)
                    box { at: gbx, gby; size: 66 * pu, 56 * pu; corner: 12 * pu; color: if(gblit > 0, mint, ink); opacity: if(gblit > 0, 24%, 6% + 10% * glass_bm_hit.$i.hover) }
                    box { at: gbx, gby; size: 66 * pu, 56 * pu; corner: 12 * pu; stroke: 1.5 * pu; color: mint; opacity: gblit * 100% }
                    box { at: gbx, gby - 10 * pu; size: 30 * pu, 18 * pu; corner: 3 * pu; stroke: 1.2 * pu; color: mix(ink, mint, gblit) }
                    group { scale: rs; pivot: floor(gbx + 0.5), floor(gby + 14 * pu + 0.5); text bar_m.$i.name { at: floor(gbx + 0.5), floor(gby + 14 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 700; width: (64 * pu) / rs; lines: 1; color: mix(ink, mint, gblit); family: "Space Grotesk" } }
                    zone box glass_bm_hit.$i { at: gbx, gby; size: 66 * pu, 56 * pu; corner: 12 * pu; cursor: pointer; active: (obs < 0.5 and glass_bend and bar_m.$i.on) and gby - gl.off > sby and gby - gl.off < sby + set.h * pu }
                    on press glass_bm_hit.$i { emit glass_bend_mon(i) }
                    on scroll glass_bm_hit.$i { gl_scroll_to = clamp(gl_scroll_to - wheel * 44, 0, max(0, gl.h - set.h)) }
                }
            }



            }
            }

            let gl.thh = set.h * set.h / max(set.h, gl.h)
            let gl.thy = gl.thh / 2 + gl.sc / max(1, gl.h - set.h) * (set.h - gl.thh)
            box { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: if(gl.h > set.h, 6%, 0%) }
            box { at: spx + 442 * pu, sby + gl.thy * pu; size: 3 * pu, gl.thh * pu; corner: 1.5 * pu; color: mint; opacity: if(gl.h > set.h, 55%, 0%) }
            let gl.cue = clamp((gl.h - set.h - gl.sc) / 24, 0, 1)
            let gl.cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let gfk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * gfk * gfk * gl.cue }
            }
            box { at: spx + 224 * pu, gl.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * gl.cue }
            box { at: spx + 224 * pu, gl.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * gl_cue_hit.hover) * gl.cue }
            path { at: spx + 204 * pu, gl.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: gl.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, gl.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: gl.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            group { scale: rs; pivot: floor(spx + 232 * pu + 0.5), floor(gl.cuey + 0.5); text "More" { at: floor(spx + 232 * pu + 0.5), floor(gl.cuey + 0.5); anchor: center; size: 16.5; weight: 700; color: ink; opacity: gl.cue; family: "Space Grotesk" } }
            zone box gl_cue_hit { at: spx + 224 * pu, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: gl.cue > 0.5 }
            on press gl_cue_hit { gl_scroll_to = clamp(gl_scroll_to + 342, 0, max(0, gl.h - set.h)) }
            zone box gl_bar_hit { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: gl.h > set.h }
            on press gl_bar_hit { gl_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - gl.thh / 2) / max(1, set.h - gl.thh) * (gl.h - set.h), 0, max(0, gl.h - set.h)) }
            on drag gl_bar_hit { gl_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - gl.thh / 2) / max(1, set.h - gl.thh) * (gl.h - set.h), 0, max(0, gl.h - set.h)) }

        }
}
