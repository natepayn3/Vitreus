            text "Normal" { at: floor(spx + 272 * pu + 0.5), floor(sby + (1012 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 92 * pu; lines: 1; color: if(nta_urg == 2, mint, ink); opacity: if(nta_urg == 2, 100%, 85%); family: "Space Grotesk" }
