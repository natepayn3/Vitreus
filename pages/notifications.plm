            box { at: spx + 52 * pw, sby + (1178 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * nta_s5.hover }
            group { scale: rs; pivot: floor(spx + 52 * pw + 0.5), floor(sby + (1178 - nt.ds) * pu + 0.5); text "Done" { at: floor(spx + 52 * pw + 0.5), floor(sby + (1178 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (72 * pw) / rs; lines: 1; color: if(nta_snd == 5, mint, ink); opacity: if(nta_snd == 5, 100%, 85%); family: "Space Grotesk" } }
            zone box nta_s5 { at: spx + 52 * pw, sby + (1178 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
