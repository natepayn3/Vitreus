            text "STAYS ON SCREEN" { at: floor(spx + 14 * pu + 0.5), floor(sby + (1046 - nt.ds) * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            box { at: spx + 52 * pu, sby + (1066 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: if(nta_to == 0, mint, ink); opacity: if(nta_to == 0, 24%, 8% + 9% * nta_t0.hover) }
            text "Usual" { at: floor(spx + 52 * pu + 0.5), floor(sby + (1066 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 72 * pu; lines: 1; color: if(nta_to == 0, mint, ink); opacity: if(nta_to == 0, 100%, 85%); family: "Space Grotesk" }
            zone box nta_t0 { at: spx + 52 * pu, sby + (1066 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
