            group { scale: rs; pivot: floor(spx + 219 * pw + 0.5), floor(sby + (1178 - nt.ds) * pu + 0.5); text "Alarm" { at: floor(spx + 219 * pw + 0.5), floor(sby + (1178 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (72 * pw) / rs; lines: 1; color: if(nta_snd == 7, mint, ink); opacity: if(nta_snd == 7, 100%, 85%); family: "Space Grotesk" } }
            zone box nta_s7 { at: spx + 219 * pw, sby + (1178 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_s7 { emit nta_sound(7) }
            box { at: spx + 302.5 * pw, sby + (1178 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * nta_s8.hover }
            group { scale: rs; pivot: floor(spx + 302.5 * pw + 0.5), floor(sby + (1178 - nt.ds) * pu + 0.5); text "Warning" { at: floor(spx + 302.5 * pw + 0.5), floor(sby + (1178 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (72 * pw) / rs; lines: 1; color: if(nta_snd == 8, mint, ink); opacity: if(nta_snd == 8, 100%, 85%); family: "Space Grotesk" } }
            zone box nta_s8 { at: spx + 302.5 * pw, sby + (1178 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_s8 { emit nta_sound(8) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + (1204 - nt.ds) * pu + 0.5); text nta_explain { at: floor(spx + 14 * pw + 0.5), floor(sby + (1204 - nt.ds) * pu + 0.5); anchor: left top; size: 15.5; width: (410 * pw) / rs; lines: 3; color: faint; family: "Space Grotesk" } }
            box { at: spx + 79 * pw, sby + (1264 - nt.ds) * pu; size: 130 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: if(0, mint, ink); opacity: if(0, 24%, 8% + 9% * nta_reset_hit.hover) }
            PPillOutline(spx + 79 * pw, sby + (1264 - nt.ds) * pu, 130 * pu, 26 * pu, 13 * pu, nta_reset_hit.hover, clamp(3 * (if(0, 24%, 8% + 9% * nta_reset_hit.hover)), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 79 * pw + 0.5), floor(sby + (1264 - nt.ds) * pu + 0.5); text "Reset to defaults" { at: floor(spx + 79 * pw + 0.5), floor(sby + (1264 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (124 * pw) / rs; lines: 1; color: if(0, mint, ink); opacity: if(0, 100%, 85%); family: "Space Grotesk" } }
            zone box nta_reset_hit { at: spx + 79 * pw, sby + (1264 - nt.ds) * pu; size: 132 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: nta_has_rule }
            on press nta_reset_hit { emit nta_reset }
            }
            }
            }
            let nt.thh = set.h * set.h / nt.h
            let nt.thy = nt.thh / 2 + nt.sc / max(1, nt.h - set.h) * (set.h - nt.thh)
            box { at: spx + 442 * pw, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: 6% }
            box { at: spx + 442 * pw, sby + nt.thy * pu; size: 3 * pu, nt.thh * pu; corner: 1.5 * pu; color: mint; opacity: 55% }
            let nt.cue = clamp((nt.h - set.h - nt.sc) / 24, 0, 1)
            let nt.cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pw, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pw, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * nt.cue }
            }
            box { at: spx + 224 * pw, nt.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * nt.cue }
            box { at: spx + 224 * pw, nt.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * nt_cue_hit.hover) * nt.cue }
            path { at: spx + 204 * pw, nt.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: nt.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pw, nt.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: nt.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            group { scale: rs; pivot: floor(spx + 232 * pw + 0.5), floor(nt.cuey + 0.5); text "More" { at: floor(spx + 232 * pw + 0.5), floor(nt.cuey + 0.5); anchor: center; size: 16.5; weight: 700; color: ink; opacity: nt.cue; family: "Space Grotesk" } }
            zone box nt_cue_hit { at: spx + 224 * pw, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: nt.cue > 0.5 }
            on press nt_cue_hit { nt_scroll_to = clamp(nt_scroll_to + 342, 0, max(0, nt.h - set.h)) }
            zone box nt_bar_hit { at: spx + 442 * pw, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: nt.h > set.h }
            on press nt_bar_hit { nt_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - nt.thh / 2) / max(1, set.h - nt.thh) * (nt.h - set.h), 0, max(0, nt.h - set.h)) }
            on drag nt_bar_hit { nt_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - nt.thh / 2) / max(1, set.h - nt.thh) * (nt.h - set.h), 0, max(0, nt.h - set.h)) }
        }
        //  ── Notifications page: END ──
}
