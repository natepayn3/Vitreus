            group { scale: rs; pivot: floor(spx + 215.25 * pw + 0.5), floor(sby + (1086 - nt.ds) * pu + 0.5); text "8 s" { at: floor(spx + 215.25 * pw + 0.5), floor(sby + (1086 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (72 * pw) / rs; lines: 1; color: if(nta_to == 2, mint, ink); opacity: if(nta_to == 2, 100%, 85%); family: "Space Grotesk" } }
            zone box nta_t2 { at: spx + 215.25 * pw, sby + (1086 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
