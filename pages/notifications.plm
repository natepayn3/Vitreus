            group { scale: rs; pivot: floor(spx + 135.5 * pw + 0.5), floor(sby + (1178 - nt.ds) * pu + 0.5); text "Device" { at: floor(spx + 135.5 * pw + 0.5), floor(sby + (1178 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (72 * pw) / rs; lines: 1; color: if(nta_snd == 6, mint, ink); opacity: if(nta_snd == 6, 100%, 85%); family: "Space Grotesk" } }
