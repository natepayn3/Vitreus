            box { at: spx + 135.5 * pu, sby + (1066 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: if(nta_to == 1, mint, ink); opacity: if(nta_to == 1, 24%, 8% + 9% * nta_t1.hover) }
            text "4 s" { at: floor(spx + 135.5 * pu + 0.5), floor(sby + (1066 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 72 * pu; lines: 1; color: if(nta_to == 1, mint, ink); opacity: if(nta_to == 1, 100%, 85%); family: "Space Grotesk" }
            zone box nta_t1 { at: spx + 135.5 * pu, sby + (1066 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_t1 { emit nta_timeout(1) }
            box { at: spx + 219 * pu, sby + (1066 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: if(nta_to == 2, mint, ink); opacity: if(nta_to == 2, 24%, 8% + 9% * nta_t2.hover) }
            text "8 s" { at: floor(spx + 219 * pu + 0.5), floor(sby + (1066 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 72 * pu; lines: 1; color: if(nta_to == 2, mint, ink); opacity: if(nta_to == 2, 100%, 85%); family: "Space Grotesk" }
