            box { at: spx + 302.5 * pu, sby + (1066 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; color: if(nta_to == 3, mint, ink); opacity: if(nta_to == 3, 24%, 8% + 9% * nta_t3.hover) }
            text "15 s" { at: floor(spx + 302.5 * pu + 0.5), floor(sby + (1066 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 72 * pu; lines: 1; color: if(nta_to == 3, mint, ink); opacity: if(nta_to == 3, 100%, 85%); family: "Space Grotesk" }
