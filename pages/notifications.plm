            group { scale: rs; pivot: floor(spx + 131.75 * pw + 0.5), floor(sby + (1146 - nt.ds) * pu + 0.5); text "Message" { at: floor(spx + 131.75 * pw + 0.5), floor(sby + (1146 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (72 * pw) / rs; lines: 1; color: if(nta_snd == 1, mint, ink); opacity: if(nta_snd == 1, 100%, 85%); family: "Space Grotesk" } }
            zone box nta_s1 { at: spx + 131.75 * pw, sby + (1146 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_s1 { emit nta_sound(1) }
            box { at: spx + 215.25 * pw, sby + (1146 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * nta_s2.hover }
            group { scale: rs; pivot: floor(spx + 215.25 * pw + 0.5), floor(sby + (1146 - nt.ds) * pu + 0.5); text "Soft" { at: floor(spx + 215.25 * pw + 0.5), floor(sby + (1146 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (72 * pw) / rs; lines: 1; color: if(nta_snd == 2, mint, ink); opacity: if(nta_snd == 2, 100%, 85%); family: "Space Grotesk" } }
            zone box nta_s2 { at: spx + 215.25 * pw, sby + (1146 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_s2 { emit nta_sound(2) }
            box { at: spx + 298.75 * pw, sby + (1146 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * nta_s3.hover }
            group { scale: rs; pivot: floor(spx + 298.75 * pw + 0.5), floor(sby + (1146 - nt.ds) * pu + 0.5); text "Bell" { at: floor(spx + 298.75 * pw + 0.5), floor(sby + (1146 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (72 * pw) / rs; lines: 1; color: if(nta_snd == 3, mint, ink); opacity: if(nta_snd == 3, 100%, 85%); family: "Space Grotesk" } }
            zone box nta_s3 { at: spx + 298.75 * pw, sby + (1146 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_s3 { emit nta_sound(3) }
            box { at: spx + 382.25 * pw, sby + (1146 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * nta_s4.hover }
            group { scale: rs; pivot: floor(spx + 382.25 * pw + 0.5), floor(sby + (1146 - nt.ds) * pu + 0.5); text "Info" { at: floor(spx + 382.25 * pw + 0.5), floor(sby + (1146 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (72 * pw) / rs; lines: 1; color: if(nta_snd == 4, mint, ink); opacity: if(nta_snd == 4, 100%, 85%); family: "Space Grotesk" } }
            zone box nta_s4 { at: spx + 382.25 * pw, sby + (1146 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
