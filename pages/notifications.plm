            box { at: spx + 298.75 * pw, sby + (1086 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * nta_t3.hover }
            group { scale: rs; pivot: floor(spx + 298.75 * pw + 0.5), floor(sby + (1086 - nt.ds) * pu + 0.5); text "15 s" { at: floor(spx + 298.75 * pw + 0.5), floor(sby + (1086 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (72 * pw) / rs; lines: 1; color: if(nta_to == 3, mint, ink); opacity: if(nta_to == 3, 100%, 85%); family: "Space Grotesk" } }
            zone box nta_t3 { at: spx + 298.75 * pw, sby + (1086 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_t3 { emit nta_timeout(3) }
            box { at: spx + 382.25 * pw, sby + (1086 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * nta_t4.hover }
            group { scale: rs; pivot: floor(spx + 382.25 * pw + 0.5), floor(sby + (1086 - nt.ds) * pu + 0.5); text "Until closed" { at: floor(spx + 382.25 * pw + 0.5), floor(sby + (1086 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (72 * pw) / rs; lines: 1; color: if(nta_to == 4, mint, ink); opacity: if(nta_to == 4, 100%, 85%); family: "Space Grotesk" } }
            zone box nta_t4 { at: spx + 382.25 * pw, sby + (1086 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press nta_t4 { emit nta_timeout(4) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + (1120 - nt.ds) * pu + 0.5); text "Sound" { at: floor(spx + 14 * pw + 0.5), floor(sby + (1120 - nt.ds) * pu + 0.5); anchor: left center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk" } }
            SetPick(spx + 48.25 * pw, sby + (1146 - nt.ds) * pu, 83.5 * pw, 5, 26 * pu, nta_snd - 5 * floor(nta_snd / 5), clamp(nta_s0.hover + nta_s1.hover + nta_s2.hover + nta_s3.hover + nta_s4.hover + nta_s5.hover + nta_s6.hover + nta_s7.hover + nta_s8.hover, 0, 1), pu, 2, 32 * pu, floor(nta_snd / 5), clamp(if(nta_snd >= 0 and nta_snd < 9, 1, 0), 0, 1))
            box { at: spx + 48.25 * pw, sby + (1146 - nt.ds) * pu; size: 78 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * nta_s0.hover }
            group { scale: rs; pivot: floor(spx + 48.25 * pw + 0.5), floor(sby + (1146 - nt.ds) * pu + 0.5); text "Default" { at: floor(spx + 48.25 * pw + 0.5), floor(sby + (1146 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (72 * pw) / rs; lines: 1; color: if(nta_snd == 0, mint, ink); opacity: if(nta_snd == 0, 100%, 85%); family: "Space Grotesk" } }
            zone box nta_s0 { at: spx + 48.25 * pw, sby + (1146 - nt.ds) * pu; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
