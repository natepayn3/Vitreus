part Notifications {
        //  ── Notifications page: BEGIN (generated) ──
        //  Scrolls like the System monitor page: a clipped viewport, the content moved by a whole-pixel `nt.off`, the wheel caught under it.
        group {
            show: set_pgt > 0.01
            opacity: set_pgt
            let nt.sc = clamp(nt_scroll, 0, max(0, nt.h - set.h))
            let nt.off = floor(nt.sc * pu + 0.5)
            clip box { at: spx + 224 * pw, sby + set.h / 2 * pu; size: 456 * pw, set.h * pu }
            zone box nt_wheel { at: spx + 219 * pw, sby + set.h / 2 * pu; size: 446 * pw, set.h * pu }
            on scroll nt_wheel { nt_scroll_to = clamp(nt_scroll_to - wheel * 44, 0, max(0, nt.h - set.h)) }
            group {
                move: 0, -nt.off
            //  Quiet hours: Do Not Disturb that turns itself on, by the clock, and while a window is fullscreen.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 104.5 * pu; size: 438 * pw, 167 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 104.5 * pu, 438 * pw, 167 * pu, 120.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 104.5 * pu; size: 438 * pw, 167 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 104.5 * pu; size: 438 * pw, 167 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 104.5 * pu; size: 438 * pw, 167 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 8 * pu + 0.5); text "QUIET HOURS" { at: floor(spx + 14 * pw + 0.5), floor(sby + 8 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            measure ldr_notb1
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 43 * pu + 0.5); text "Hold notifications back" { at: floor(spx + 14 * pw + 0.5), floor(sby + 43 * pu + 0.5); measure: ldr_notb1; anchor: left center; size: 18; weight: 600; color: ink; family: "Space Grotesk" } }
            measure ldh_notb1
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 59 * pu + 0.5); text "Between these times, every day (kept in the history)" { at: floor(spx + 14 * pw + 0.5), floor(sby + 59 * pu + 0.5); measure: ldh_notb1; anchor: left center; size: 14.5; color: faint; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pw, sby + 50 * pu, ntq0, ntq_hit0.pressed, ntq_hit0.hover, mint)
            PLeader(spx + 14 * pw + max(ldr_notb1.width, ldh_notb1.width) * rs + 8 * pu, spx + 424 * pw - 40 * cu, sby + 50 * pu, ntq_hit0.hover, pu)
            zone box ntq_hit0 { at: spx + 424 * pw - 19 * cu, sby + 50 * pu; size: 44 * cu, 28 * cu; corner: 14 * cu; cursor: pointer }
            on press ntq_hit0 { emit nt_q_toggle }
            //  When: a 24-hour track, midnight to midnight, with the quiet stretch lit (in two pieces when it runs past midnight) and a handle at each end.
            //  Pressing anywhere on it takes the nearer handle there; dragging moves it in half hours. Each time rides above its handle, the two pushed apart when close.
            let ntq.x0 = spx + 22 * pw
            let ntq.w = 394 * pw
            let ntq.ax = ntq.x0 + ntq_a / 1440 * ntq.w
            let ntq.bx = ntq.x0 + ntq_b / 1440 * ntq.w
            let ntq.wrap = if(ntq_a > ntq_b, 1, 0)
            let ntq.lw = 82 * pu
            let ntq.d = ntq.bx - ntq.ax
            let ntq.near = if(abs(ntq.d) < ntq.lw, 1, 0)
            let ntq.c = clamp((ntq.ax + ntq.bx) / 2, spx + 4 * pw + ntq.lw, spx + 434 * pw - ntq.lw)
            let ntq.la = if(ntq.near > 0, ntq.c - ntq.lw / 2 * if(ntq.d >= 0, 1, -1), clamp(ntq.ax, spx + 4 * pw + ntq.lw / 2, spx + 434 * pw - ntq.lw / 2))
            let ntq.lb = if(ntq.near > 0, ntq.c + ntq.lw / 2 * if(ntq.d >= 0, 1, -1), clamp(ntq.bx, spx + 4 * pw + ntq.lw / 2, spx + 434 * pw - ntq.lw / 2))
            let ntq.now = ntq.x0 + (now.hour * 60 + now.minute) / 1440 * ntq.w
            group {
                opacity: 40% + 60% * clamp(ntq0, 0, 1)
                box { at: ntq.x0 + ntq.w / 2, sby + 104 * pu; size: ntq.w, 6 * pu; corner: 3 * pu; color: ink; opacity: 10% }
                ellipse { at: ntq.x0 + 1 * ntq.w / 8, sby + 104 * pu; radius: 1.4 * pu; color: ink; opacity: 30% }
                ellipse { at: ntq.x0 + 2 * ntq.w / 8, sby + 104 * pu; radius: 1.4 * pu; color: ink; opacity: 30% }
                ellipse { at: ntq.x0 + 3 * ntq.w / 8, sby + 104 * pu; radius: 1.4 * pu; color: ink; opacity: 30% }
                ellipse { at: ntq.x0 + 4 * ntq.w / 8, sby + 104 * pu; radius: 1.4 * pu; color: ink; opacity: 30% }
                ellipse { at: ntq.x0 + 5 * ntq.w / 8, sby + 104 * pu; radius: 1.4 * pu; color: ink; opacity: 30% }
                ellipse { at: ntq.x0 + 6 * ntq.w / 8, sby + 104 * pu; radius: 1.4 * pu; color: ink; opacity: 30% }
                ellipse { at: ntq.x0 + 7 * ntq.w / 8, sby + 104 * pu; radius: 1.4 * pu; color: ink; opacity: 30% }
                box { at: (ntq.ax + if(ntq.wrap > 0, ntq.x0 + ntq.w, ntq.bx)) / 2, sby + 104 * pu; size: abs(if(ntq.wrap > 0, ntq.x0 + ntq.w, ntq.bx) - ntq.ax), 6 * pu; corner: 3 * pu; color: mix(ink, mint, clamp(ntq0, 0, 1)); opacity: 85% }
                box { at: (ntq.x0 + ntq.bx) / 2, sby + 104 * pu; size: ntq.bx - ntq.x0, 6 * pu; corner: 3 * pu; color: mix(ink, mint, clamp(ntq0, 0, 1)); opacity: 85%; show: ntq.wrap > 0 }
                box { at: ntq.now, sby + 104 * pu; size: 2 * pu, 14 * pu; corner: 1 * pu; color: ink; opacity: 55% }
                ellipse { at: ntq.ax, sby + 104 * pu; radius: (9 + 2 * ntq_ga) * pu; color: mix(ink, mix(mint, #ffffff, 55%), clamp(ntq0, 0, 1)) }
                ellipse { at: ntq.ax, sby + 104 * pu; radius: (6.5 + 1.5 * ntq_ga) * pu; color: mix(ink, mint, clamp(ntq0, 0, 1)) }
                ellipse { at: ntq.bx, sby + 104 * pu; radius: (9 + 2 * ntq_gb) * pu; color: mix(ink, mix(mint, #ffffff, 55%), clamp(ntq0, 0, 1)) }
                ellipse { at: ntq.bx, sby + 104 * pu; radius: (6.5 + 1.5 * ntq_gb) * pu; color: mix(ink, mint, clamp(ntq0, 0, 1)) }
                box { at: ntq.la, sby + 81 * pu; size: 76 * pu, 22 * pu; corner: 11 * pu; color: ink; opacity: 8% + 6% * ntq_ga }
                group { scale: rs; pivot: floor(ntq.la + 0.5), floor(sby + 81 * pu + 0.5); text nt_qfrom_t { at: floor(ntq.la + 0.5), floor(sby + 81 * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; width: (72 * pu) / rs; lines: 1; color: mix(ink, mint, clamp(ntq0, 0, 1)); family: "Space Grotesk" } }
                box { at: ntq.lb, sby + 81 * pu; size: 76 * pu, 22 * pu; corner: 11 * pu; color: ink; opacity: 8% + 6% * ntq_gb }
                group { scale: rs; pivot: floor(ntq.lb + 0.5), floor(sby + 81 * pu + 0.5); text nt_qto_t { at: floor(ntq.lb + 0.5), floor(sby + 81 * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; width: (72 * pu) / rs; lines: 1; color: mix(ink, mint, clamp(ntq0, 0, 1)); family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(ntq.x0 + 0 / 1440 * ntq.w + 0.5), floor(sby + 123 * pu + 0.5); text "12 AM" { at: floor(ntq.x0 + 0 / 1440 * ntq.w + 0.5), floor(sby + 123 * pu + 0.5); anchor: center; size: 12.5; weight: 600; color: faint; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(ntq.x0 + 360 / 1440 * ntq.w + 0.5), floor(sby + 123 * pu + 0.5); text "6 AM" { at: floor(ntq.x0 + 360 / 1440 * ntq.w + 0.5), floor(sby + 123 * pu + 0.5); anchor: center; size: 12.5; weight: 600; color: faint; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(ntq.x0 + 720 / 1440 * ntq.w + 0.5), floor(sby + 123 * pu + 0.5); text "Noon" { at: floor(ntq.x0 + 720 / 1440 * ntq.w + 0.5), floor(sby + 123 * pu + 0.5); anchor: center; size: 12.5; weight: 600; color: faint; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(ntq.x0 + 1080 / 1440 * ntq.w + 0.5), floor(sby + 123 * pu + 0.5); text "6 PM" { at: floor(ntq.x0 + 1080 / 1440 * ntq.w + 0.5), floor(sby + 123 * pu + 0.5); anchor: center; size: 12.5; weight: 600; color: faint; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(ntq.x0 + 1440 / 1440 * ntq.w + 0.5), floor(sby + 123 * pu + 0.5); text "12 AM" { at: floor(ntq.x0 + 1440 / 1440 * ntq.w + 0.5), floor(sby + 123 * pu + 0.5); anchor: center; size: 12.5; weight: 600; color: faint; family: "Space Grotesk" } }
            }
            zone box ntq_track { at: ntq.x0 + ntq.w / 2, sby + 96 * pu; size: ntq.w + 26 * pu, 48 * pu; cursor: if(nt_qdk > 0, grabbing, pointer); label: "Quiet hours: drag the start or the end" }
            on press ntq_track {
                nt_qdk = if(abs(local.x - ntq.ax) <= abs(local.x - ntq.bx), 1, 2)
                nt_qdm = clamp(floor((local.x - ntq.x0) / ntq.w * 48 + 0.5), 0, 47) * 30
                emit nt_q_set(if(abs(local.x - ntq.ax) <= abs(local.x - ntq.bx), 1, 2) * 10000 + clamp(floor((local.x - ntq.x0) / ntq.w * 48 + 0.5), 0, 47) * 30)
            }
            on drag ntq_track { nt_qdm = clamp(floor((local.x - ntq.x0) / ntq.w * 48 + 0.5), 0, 47) * 30 }
            on change nt_qdm while nt_qdk > 0 { emit nt_q_set(nt_qdk * 10000 + nt_qdm) }
            on release ntq_track { nt_qdk = 0 }
            measure ldr_notb2
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 150 * pu + 0.5); text "Silence while a window is fullscreen" { at: floor(spx + 14 * pw + 0.5), floor(sby + 150 * pu + 0.5); measure: ldr_notb2; anchor: left center; size: 18; weight: 600; color: ink; family: "Space Grotesk" } }
            measure ldh_notb2
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 166 * pu + 0.5); text "A game, a video or a presentation: nothing pops up over it" { at: floor(spx + 14 * pw + 0.5), floor(sby + 166 * pu + 0.5); measure: ldh_notb2; anchor: left center; size: 14.5; color: faint; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pw, sby + 157 * pu, ntq1, ntq_hit1.pressed, ntq_hit1.hover, mint)
            PLeader(spx + 14 * pw + max(ldr_notb2.width, ldh_notb2.width) * rs + 8 * pu, spx + 424 * pw - 40 * cu, sby + 157 * pu, ntq_hit1.hover, pu)
            zone box ntq_hit1 { at: spx + 424 * pw - 19 * cu, sby + 157 * pu; size: 44 * cu, 28 * cu; corner: 14 * cu; cursor: pointer }
            on press ntq_hit1 { emit nt_fs_toggle }
            group {
                move: 0, 197 * pu
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 133 * pu; size: 438 * pw, 224 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 133 * pu, 438 * pw, 224 * pu, 393.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 133 * pu; size: 438 * pw, 224 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 133 * pu; size: 438 * pw, 224 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 133 * pu; size: 438 * pw, 224 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 8 * pu + 0.5); text "DELIVERY" { at: floor(spx + 14 * pw + 0.5), floor(sby + 8 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            measure ldr_notb3
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 43 * pu + 0.5); text "Play a sound" { at: floor(spx + 14 * pw + 0.5), floor(sby + 43 * pu + 0.5); measure: ldr_notb3; anchor: left center; size: 18; weight: 600; color: ink; family: "Space Grotesk" } }
            measure ldh_notb3
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 59 * pu + 0.5); text "When a notification is shown" { at: floor(spx + 14 * pw + 0.5), floor(sby + 59 * pu + 0.5); measure: ldh_notb3; anchor: left center; size: 14.5; color: faint; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pw, sby + 50 * pu, ntk0, ntg_snd_hit.pressed, ntg_snd_hit.hover, mint)
            PLeader(spx + 14 * pw + max(ldr_notb3.width, ldh_notb3.width) * rs + 8 * pu, spx + 424 * pw - 40 * cu, sby + 50 * pu, ntg_snd_hit.hover, pu)
            zone box ntg_snd_hit { at: spx + 424 * pw - 19 * cu, sby + 50 * pu; size: 44 * cu, 28 * cu; corner: 14 * cu; cursor: pointer }
            on press ntg_snd_hit { emit ntg_flag(0) }
            measure ldr_notb4
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 81 * pu + 0.5); text "Let critical ones through Do Not Disturb" { at: floor(spx + 14 * pw + 0.5), floor(sby + 81 * pu + 0.5); measure: ldr_notb4; anchor: left center; size: 18; weight: 600; color: ink; family: "Space Grotesk" } }
            measure ldh_notb4
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 97 * pu + 0.5); text "A low battery, a build that broke: the ones you would want" { at: floor(spx + 14 * pw + 0.5), floor(sby + 97 * pu + 0.5); measure: ldh_notb4; anchor: left center; size: 14.5; color: faint; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pw, sby + 88 * pu, ntk1, ntg_crit_hit.pressed, ntg_crit_hit.hover, mint)
            PLeader(spx + 14 * pw + max(ldr_notb4.width, ldh_notb4.width) * rs + 8 * pu, spx + 424 * pw - 40 * cu, sby + 88 * pu, ntg_crit_hit.hover, pu)
            zone box ntg_crit_hit { at: spx + 424 * pw - 19 * cu, sby + 88 * pu; size: 44 * cu, 28 * cu; corner: 14 * cu; cursor: pointer }
            on press ntg_crit_hit { emit ntg_flag(1) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 119 * pu + 0.5); text "Default sound" { at: floor(spx + 14 * pw + 0.5), floor(sby + 119 * pu + 0.5); anchor: left center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk" } }
            SetPick(spx + 58.25 * pw, sby + 150 * pu, 104.5 * pw, 4, 26 * pu, ntg_snd - 4 * floor(ntg_snd / 4), clamp(ntg_s0.hover + ntg_s1.hover + ntg_s2.hover + ntg_s3.hover + ntg_s4.hover + ntg_s5.hover + ntg_s6.hover + ntg_s7.hover, 0, 1), pu, 2, 32 * pu, floor(ntg_snd / 4), clamp(if(ntg_snd >= 0 and ntg_snd < 8, 1, 0), 0, 1))
            box { at: spx + 58.25 * pw, sby + 150 * pu; size: 98 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * ntg_s0.hover }
            group { scale: rs; pivot: floor(spx + 58.25 * pw + 0.5), floor(sby + 150 * pu + 0.5); text "Message" { at: floor(spx + 58.25 * pw + 0.5), floor(sby + 150 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (92 * pw) / rs; lines: 1; color: if(ntg_snd == 0, mint, ink); opacity: if(ntg_snd == 0, 100%, 85%); family: "Space Grotesk" } }
            zone box ntg_s0 { at: spx + 58.25 * pw, sby + 150 * pu; size: 100 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press ntg_s0 { emit ntg_sound(0) }
            box { at: spx + 162.75 * pw, sby + 150 * pu; size: 98 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * ntg_s1.hover }
            group { scale: rs; pivot: floor(spx + 162.75 * pw + 0.5), floor(sby + 150 * pu + 0.5); text "Soft" { at: floor(spx + 162.75 * pw + 0.5), floor(sby + 150 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (92 * pw) / rs; lines: 1; color: if(ntg_snd == 1, mint, ink); opacity: if(ntg_snd == 1, 100%, 85%); family: "Space Grotesk" } }
            zone box ntg_s1 { at: spx + 162.75 * pw, sby + 150 * pu; size: 100 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press ntg_s1 { emit ntg_sound(1) }
            box { at: spx + 267.25 * pw, sby + 150 * pu; size: 98 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * ntg_s2.hover }
            group { scale: rs; pivot: floor(spx + 267.25 * pw + 0.5), floor(sby + 150 * pu + 0.5); text "Bell" { at: floor(spx + 267.25 * pw + 0.5), floor(sby + 150 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (92 * pw) / rs; lines: 1; color: if(ntg_snd == 2, mint, ink); opacity: if(ntg_snd == 2, 100%, 85%); family: "Space Grotesk" } }
            zone box ntg_s2 { at: spx + 267.25 * pw, sby + 150 * pu; size: 100 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press ntg_s2 { emit ntg_sound(2) }
            box { at: spx + 371.75 * pw, sby + 150 * pu; size: 98 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * ntg_s3.hover }
            group { scale: rs; pivot: floor(spx + 371.75 * pw + 0.5), floor(sby + 150 * pu + 0.5); text "Info" { at: floor(spx + 371.75 * pw + 0.5), floor(sby + 150 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (92 * pw) / rs; lines: 1; color: if(ntg_snd == 3, mint, ink); opacity: if(ntg_snd == 3, 100%, 85%); family: "Space Grotesk" } }
            zone box ntg_s3 { at: spx + 371.75 * pw, sby + 150 * pu; size: 100 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press ntg_s3 { emit ntg_sound(3) }
            box { at: spx + 58.25 * pw, sby + 182 * pu; size: 98 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * ntg_s4.hover }
            group { scale: rs; pivot: floor(spx + 58.25 * pw + 0.5), floor(sby + 182 * pu + 0.5); text "Done" { at: floor(spx + 58.25 * pw + 0.5), floor(sby + 182 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (92 * pw) / rs; lines: 1; color: if(ntg_snd == 4, mint, ink); opacity: if(ntg_snd == 4, 100%, 85%); family: "Space Grotesk" } }
            zone box ntg_s4 { at: spx + 58.25 * pw, sby + 182 * pu; size: 100 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press ntg_s4 { emit ntg_sound(4) }
            box { at: spx + 162.75 * pw, sby + 182 * pu; size: 98 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * ntg_s5.hover }
            group { scale: rs; pivot: floor(spx + 162.75 * pw + 0.5), floor(sby + 182 * pu + 0.5); text "Device" { at: floor(spx + 162.75 * pw + 0.5), floor(sby + 182 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (92 * pw) / rs; lines: 1; color: if(ntg_snd == 5, mint, ink); opacity: if(ntg_snd == 5, 100%, 85%); family: "Space Grotesk" } }
            zone box ntg_s5 { at: spx + 162.75 * pw, sby + 182 * pu; size: 100 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press ntg_s5 { emit ntg_sound(5) }
            box { at: spx + 267.25 * pw, sby + 182 * pu; size: 98 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * ntg_s6.hover }
            group { scale: rs; pivot: floor(spx + 267.25 * pw + 0.5), floor(sby + 182 * pu + 0.5); text "Alarm" { at: floor(spx + 267.25 * pw + 0.5), floor(sby + 182 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (92 * pw) / rs; lines: 1; color: if(ntg_snd == 6, mint, ink); opacity: if(ntg_snd == 6, 100%, 85%); family: "Space Grotesk" } }
            zone box ntg_s6 { at: spx + 267.25 * pw, sby + 182 * pu; size: 100 * pu, 28 * pu; corner: 14 * pu; cursor: pointer }
            on press ntg_s6 { emit ntg_sound(6) }
