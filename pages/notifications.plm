            text "Until closed" { at: floor(spx + 386 * pu + 0.5), floor(sby + (1066 - nt.ds) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 72 * pu; lines: 1; color: if(nta_to == 4, mint, ink); opacity: if(nta_to == 4, 100%, 85%); family: "Space Grotesk" }
