part Niri {
        //  The niri page: gaps, corners and borders, where columns go, animations and input. It is the Hyprland page's twin on niri (same facts for what both have).
        //  Every change is written to ~/.config/niri/vitreus.kdl (see "Settings > niri" in vitreus.luau), which niri reloads by itself. It is a little taller than the page, so it scrolls as the Hyprland page does (the same `hy_scroll`, `hy.h`: the two never show together).
        group {
            show: set_pgh > 0.01 and wm_niri
            opacity: set_pgh
            let nsl.x0 = spx + 122 * pw
            let nsl.w = 250 * pw
            let nh = 12 * pu
            let ni.sc = clamp(hy_scroll, 0, max(0, hy.h - set.h))
            let ni.off = floor(ni.sc * pu + 0.5)        // whole pixels: text that is shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pw, sby + set.h / 2 * pu; size: 456 * pw, set.h * pu }
            //  A scroll goes to the zone declared last under the pointer, and the rows' zones cover most of the page: each one scrolls it too.
            zone box ni_wheel { at: spx + 219 * pw, sby + set.h / 2 * pu; size: 446 * pw, set.h * pu }
            on scroll ni_wheel { hy_scroll_to = clamp(hy_scroll_to - wheel * 44, 0, max(0, hy.h - set.h)) }
            group {
            move: 0, -ni.off


            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 137.75 * pu; size: 438 * pw, 233.5 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 137.75 * pu, 438 * pw, 233.5 * pu, 965.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 137.75 * pu; size: 438 * pw, 233.5 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 137.75 * pu; size: 438 * pw, 233.5 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 137.75 * pu; size: 438 * pw, 233.5 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 313.5 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 313.5 * pu, 438 * pw, 58 * pu, 993.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 313.5 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 313.5 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 313.5 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 436.25 * pu; size: 438 * pw, 127.5 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 436.25 * pu, 438 * pw, 127.5 * pu, 24.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 436.25 * pu; size: 438 * pw, 127.5 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 436.25 * pu; size: 438 * pw, 127.5 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 436.25 * pu; size: 438 * pw, 127.5 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 8 * pu + 0.5); text "GENERAL & LAYOUT" { at: floor(spx + 14 * pw + 0.5), floor(sby + 8 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 271.5 * pu + 0.5); text "ANIMATIONS" { at: floor(spx + 14 * pw + 0.5), floor(sby + 271.5 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 359.5 * pu + 0.5); text "INPUT" { at: floor(spx + 14 * pw + 0.5), floor(sby + 359.5 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }

            measure ldr_nir1
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 47 * pu + 0.5); text "Gaps" { at: floor(spx + 14 * pw + 0.5), floor(sby + 47 * pu + 0.5); measure: ldr_nir1; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(nsl.x0, sby + 47 * pu, nsl.w, clamp(hy_gaps / 30, 0, 1), ni_gaps_hit.hover, cu, nh, 0)
            PLeader(spx + 14 * pw + ldr_nir1.width * rs + 8 * pu, nsl.x0 - 6 * pu, sby + 47 * pu, ni_gaps_hit.hover, pu)
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + 47 * pu + 0.5); text hy_gaps_text { at: floor(spx + 424 * pw + 0.5), floor(sby + 47 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box ni_gaps_hit { at: nsl.x0 + nsl.w / 2, sby + 47 * pu; size: nsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press ni_gaps_hit { emit hy_gaps_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            on scroll ni_gaps_hit { hy_scroll_to = clamp(hy_scroll_to - wheel * 44, 0, max(0, hy.h - set.h)) }
            on drag ni_gaps_hit { emit hy_gaps_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            measure ldr_nir2
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 82 * pu + 0.5); text "Corner rounding" { at: floor(spx + 14 * pw + 0.5), floor(sby + 82 * pu + 0.5); measure: ldr_nir2; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(nsl.x0, sby + 82 * pu, nsl.w, clamp(hy_round / 30, 0, 1), ni_round_hit.hover, cu, nh, 0)
            PLeader(spx + 14 * pw + ldr_nir2.width * rs + 8 * pu, nsl.x0 - 6 * pu, sby + 82 * pu, ni_round_hit.hover, pu)
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + 82 * pu + 0.5); text hy_round_text { at: floor(spx + 424 * pw + 0.5), floor(sby + 82 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box ni_round_hit { at: nsl.x0 + nsl.w / 2, sby + 82 * pu; size: nsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press ni_round_hit { emit hy_round_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            on scroll ni_round_hit { hy_scroll_to = clamp(hy_scroll_to - wheel * 44, 0, max(0, hy.h - set.h)) }
            on drag ni_round_hit { emit hy_round_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            measure ldr_nir3
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 117 * pu + 0.5); text "Border thickness" { at: floor(spx + 14 * pw + 0.5), floor(sby + 117 * pu + 0.5); measure: ldr_nir3; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(nsl.x0, sby + 117 * pu, nsl.w, clamp(hy_border / 10, 0, 1), ni_border_hit.hover, cu, nh, 0)
            PLeader(spx + 14 * pw + ldr_nir3.width * rs + 8 * pu, nsl.x0 - 6 * pu, sby + 117 * pu, ni_border_hit.hover, pu)
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + 117 * pu + 0.5); text hy_border_text { at: floor(spx + 424 * pw + 0.5), floor(sby + 117 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box ni_border_hit { at: nsl.x0 + nsl.w / 2, sby + 117 * pu; size: nsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press ni_border_hit { emit hy_border_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            on scroll ni_border_hit { hy_scroll_to = clamp(hy_scroll_to - wheel * 44, 0, max(0, hy.h - set.h)) }
            on drag ni_border_hit { emit hy_border_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            measure ldr_nir4
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 152.5 * pu + 0.5); text "Center column" { at: floor(spx + 14 * pw + 0.5), floor(sby + 152.5 * pu + 0.5); measure: ldr_nir4; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            zone box ni_ce_hit_sl { at: spx + 199 * pw + (3 - 1) * 90 * pw / 2, sby + 152.5 * pu + (1 - 1) * 0 / 2; size: 3 * 90 * pw, 24 * pu + (1 - 1) * 0 }
            SetPick(spx + 199 * pw, sby + 152.5 * pu, 90 * pw, 3, 24 * pu, ni_center, ni_ce_hit_sl.hover, pu)
            PLeader(spx + 14 * pw + ldr_nir4.width * rs + 8 * pu, spx + 199 * pw - 90 * pw / 2 - 6 * pu, sby + 152.5 * pu, ni_ce_hit_sl.hover, pu)
            repeat i in 0..3 {
                let px = spx + 199 * pw + i * 90 * pw
                box { at: px, sby + 152.5 * pu; size: 84 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * ni_ce_hit.$i.hover }
                group { scale: rs; pivot: floor(px + 0.5), floor(sby + 152.5 * pu + 0.5); text pick(i, "Never", "Always", "Overflow") { at: floor(px + 0.5), floor(sby + 152.5 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (80 * pw) / rs; lines: 1; color: if(ni_center == i, mint, ink); family: "Space Grotesk" } }
                zone box ni_ce_hit.$i { at: px, sby + 152.5 * pu; size: 86 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
                on press ni_ce_hit.$i { emit ni_center_set(i) }
                on scroll ni_ce_hit.$i { hy_scroll_to = clamp(hy_scroll_to - wheel * 44, 0, max(0, hy.h - set.h)) }
            }
            measure ldr_nir5
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 188.5 * pu + 0.5); text "Column width" { at: floor(spx + 14 * pw + 0.5), floor(sby + 188.5 * pu + 0.5); measure: ldr_nir5; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            zone box ni_cw_hit_sl { at: spx + 193 * pw + (4 - 1) * 66 * pw / 2, sby + 188.5 * pu + (1 - 1) * 0 / 2; size: 4 * 66 * pw, 24 * pu + (1 - 1) * 0 }
            SetPick(spx + 193 * pw, sby + 188.5 * pu, 66 * pw, 4, 24 * pu, ni_colw, ni_cw_hit_sl.hover, pu)
            PLeader(spx + 14 * pw + ldr_nir5.width * rs + 8 * pu, spx + 193 * pw - 66 * pw / 2 - 6 * pu, sby + 188.5 * pu, ni_cw_hit_sl.hover, pu)
            repeat i in 0..4 {
                let px = spx + 193 * pw + i * 66 * pw
                box { at: px, sby + 188.5 * pu; size: 60 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * ni_cw_hit.$i.hover }
                group { scale: rs; pivot: floor(px + 0.5), floor(sby + 188.5 * pu + 0.5); text pick(i, "1/3", "1/2", "2/3", "Full") { at: floor(px + 0.5), floor(sby + 188.5 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (56 * pw) / rs; lines: 1; color: if(ni_colw == i, mint, ink); family: "Space Grotesk" } }
                zone box ni_cw_hit.$i { at: px, sby + 188.5 * pu; size: 62 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
                on press ni_cw_hit.$i { emit ni_colw_set(i) }
                on scroll ni_cw_hit.$i { hy_scroll_to = clamp(hy_scroll_to - wheel * 44, 0, max(0, hy.h - set.h)) }
            }
            measure ldr_nir6
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 398.5 * pu + 0.5); text "Sensitivity" { at: floor(spx + 14 * pw + 0.5), floor(sby + 398.5 * pu + 0.5); measure: ldr_nir6; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(nsl.x0, sby + 398.5 * pu, nsl.w, clamp((hy_sens + 1) / 2, 0, 1), ni_sens_hit.hover, cu, nh, 0)
            PLeader(spx + 14 * pw + ldr_nir6.width * rs + 8 * pu, nsl.x0 - 6 * pu, sby + 398.5 * pu, ni_sens_hit.hover, pu)
            box { at: nsl.x0 + nsl.w / 2, sby + 398.5 * pu; size: 1.5 * pu, nh + 6 * pu; corner: 0.75 * pu; color: ink; opacity: 40% }
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + 398.5 * pu + 0.5); text hy_sens_text { at: floor(spx + 424 * pw + 0.5), floor(sby + 398.5 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box ni_sens_hit { at: nsl.x0 + nsl.w / 2, sby + 398.5 * pu; size: nsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press ni_sens_hit { emit hy_sens_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            on scroll ni_sens_hit { hy_scroll_to = clamp(hy_scroll_to - wheel * 44, 0, max(0, hy.h - set.h)) }
            on drag ni_sens_hit { emit hy_sens_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            measure ldr_nir7
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 434 * pu + 0.5); text "Follow mouse" { at: floor(spx + 14 * pw + 0.5), floor(sby + 434 * pu + 0.5); measure: ldr_nir7; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            zone box ni_fol_hit_sl { at: spx + 325 * pw + (2 - 1) * 66 * pw / 2, sby + 434 * pu + (1 - 1) * 0 / 2; size: 2 * 66 * pw, 24 * pu + (1 - 1) * 0 }
            SetPick(spx + 325 * pw, sby + 434 * pu, 66 * pw, 2, 24 * pu, hy_follow, ni_fol_hit_sl.hover, pu)
            PLeader(spx + 14 * pw + ldr_nir7.width * rs + 8 * pu, spx + 325 * pw - 66 * pw / 2 - 6 * pu, sby + 434 * pu, ni_fol_hit_sl.hover, pu)
            repeat i in 0..2 {
                let px = spx + 325 * pw + i * 66 * pw
                box { at: px, sby + 434 * pu; size: 60 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * ni_fol_hit.$i.hover }
                group { scale: rs; pivot: floor(px + 0.5), floor(sby + 434 * pu + 0.5); text pick(i, "Off", "On") { at: floor(px + 0.5), floor(sby + 434 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (56 * pw) / rs; lines: 1; color: if(hy_follow == i, mint, ink); family: "Space Grotesk" } }
                zone box ni_fol_hit.$i { at: px, sby + 434 * pu; size: 62 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
                on press ni_fol_hit.$i { emit hy_follow_set(i) }
                on scroll ni_fol_hit.$i { hy_scroll_to = clamp(hy_scroll_to - wheel * 44, 0, max(0, hy.h - set.h)) }
            }

            //  The switches: a lone column in the middle, animations, natural scroll.
            repeat i in 0..3 {
                let ty = sby + pick(i, 224.5, 313.5, 470) * pu
                let tk = pick(i, ni_k0, hy_k2, hy_k3)
                measure ldr_nir8.$i
                group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(ty - 6 * pu + 0.5); text pick(i, "Center a lone column", "Window manager animations", "Natural scroll (touchpad)") { at: floor(spx + 14 * pw + 0.5), floor(ty - 6 * pu + 0.5); measure: ldr_nir8.$i; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
                measure ldh_nir8.$i
                group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(ty + 8 * pu + 0.5); text pick(i, "A single column sits in the middle of the screen", "niri's own window and workspace motion", "Reverses the touchpad's scroll direction") { at: floor(spx + 14 * pw + 0.5), floor(ty + 8 * pu + 0.5); measure: ldh_nir8.$i; anchor: left center; size: 14.5; color: faint; family: "Space Grotesk" } }
                SettingsSwitch(spx + 424 * pw, ty, tk, ni_tg_hit.$i.pressed, ni_tg_hit.$i.hover, mint)
                PLeader(spx + 14 * pw + max(ldr_nir8.$i.width, ldh_nir8.$i.width) * rs + 8 * pu, spx + 424 * pw - 40 * cu, ty, ni_tg_hit.$i.hover, pu)
                zone box ni_tg_hit.$i { at: spx + 424 * pw - 19 * cu, ty; size: 44 * cu, 28 * cu; corner: 14 * cu; cursor: pointer; label: pick(i, "Center a lone column", "Window manager animations", "Natural scroll (touchpad)") }
                on press ni_tg_hit.$i { emit ni_toggle(i) }
                on scroll ni_tg_hit.$i { hy_scroll_to = clamp(hy_scroll_to - wheel * 44, 0, max(0, hy.h - set.h)) }
            }
            }
        }
}
