part Niri {
        //  The niri page: gaps, corners and borders, where columns go, animations and input. It is the Hyprland page's twin on niri (same facts for what both have).
        //  Every change is written to ~/.config/niri/vitreus.kdl (see "Settings > niri" in vitreus.luau), which niri reloads by itself. It fits the page, so it does not scroll.
        group {
            show: set_pgh > 0.01 and wm_niri
            opacity: set_pgh
            let nsl.x0 = spx + 122 * pu
            let nsl.w = 250 * pu
            let nh = 12 * pu


            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 115 * pu; size: 438 * pu, 230 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 115 * pu, 438 * pu, 230 * pu, 965.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 115 * pu; size: 438 * pu, 230 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 115 * pu; size: 438 * pu, 230 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 278 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 278 * pu, 438 * pu, 44 * pu, 993.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 278 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 278 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 395 * pu; size: 438 * pu, 138 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 395 * pu, 438 * pu, 138 * pu, 24.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 395 * pu; size: 438 * pu, 138 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 395 * pu; size: 438 * pu, 138 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); text "GENERAL & LAYOUT" { at: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 243 * pu + 0.5); text "ANIMATIONS" { at: floor(spx + 14 * pu + 0.5), floor(sby + 243 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 313 * pu + 0.5); text "INPUT" { at: floor(spx + 14 * pu + 0.5), floor(sby + 313 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }

            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 42 * pu + 0.5); text "Gaps" { at: floor(spx + 14 * pu + 0.5), floor(sby + 42 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(nsl.x0, sby + 42 * pu, nsl.w, clamp(hy_gaps / 30, 0, 1), ni_gaps_hit.hover, cu, nh, 0)
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 42 * pu + 0.5); text hy_gaps_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 42 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box ni_gaps_hit { at: nsl.x0 + nsl.w / 2, sby + 42 * pu; size: nsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press ni_gaps_hit { emit hy_gaps_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            on drag ni_gaps_hit { emit hy_gaps_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 74 * pu + 0.5); text "Corner rounding" { at: floor(spx + 14 * pu + 0.5), floor(sby + 74 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(nsl.x0, sby + 74 * pu, nsl.w, clamp(hy_round / 30, 0, 1), ni_round_hit.hover, cu, nh, 0)
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 74 * pu + 0.5); text hy_round_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 74 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box ni_round_hit { at: nsl.x0 + nsl.w / 2, sby + 74 * pu; size: nsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press ni_round_hit { emit hy_round_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            on drag ni_round_hit { emit hy_round_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 106 * pu + 0.5); text "Border thickness" { at: floor(spx + 14 * pu + 0.5), floor(sby + 106 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(nsl.x0, sby + 106 * pu, nsl.w, clamp(hy_border / 10, 0, 1), ni_border_hit.hover, cu, nh, 0)
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 106 * pu + 0.5); text hy_border_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 106 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box ni_border_hit { at: nsl.x0 + nsl.w / 2, sby + 106 * pu; size: nsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press ni_border_hit { emit hy_border_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            on drag ni_border_hit { emit hy_border_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 138 * pu + 0.5); text "Center column" { at: floor(spx + 14 * pu + 0.5), floor(sby + 138 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            zone box ni_ce_hit_sl { at: spx + 164 * pu + (3 - 1) * 90 * pu / 2, sby + 138 * pu + (1 - 1) * 0 / 2; size: 3 * 90 * pu, 24 * pu + (1 - 1) * 0 }
            SetPick(spx + 164 * pu, sby + 138 * pu, 90 * pu, 3, 24 * pu, ni_center, ni_ce_hit_sl.hover, pu)
            repeat i in 0..3 {
                let px = spx + 164 * pu + i * 90 * pu
                box { at: px, sby + 138 * pu; size: 84 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * ni_ce_hit.$i.hover }
                group { scale: rs; pivot: floor(px + 0.5), floor(sby + 138 * pu + 0.5); text pick(i, "Never", "Always", "Overflow") { at: floor(px + 0.5), floor(sby + 138 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (80 * pu) / rs; lines: 1; color: if(ni_center == i, mint, ink); family: "Space Grotesk" } }
                zone box ni_ce_hit.$i { at: px, sby + 138 * pu; size: 86 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
                on press ni_ce_hit.$i { emit ni_center_set(i) }
            }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 170 * pu + 0.5); text "Column width" { at: floor(spx + 14 * pu + 0.5), floor(sby + 170 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            zone box ni_cw_hit_sl { at: spx + 164 * pu + (4 - 1) * 66 * pu / 2, sby + 170 * pu + (1 - 1) * 0 / 2; size: 4 * 66 * pu, 24 * pu + (1 - 1) * 0 }
            SetPick(spx + 164 * pu, sby + 170 * pu, 66 * pu, 4, 24 * pu, ni_colw, ni_cw_hit_sl.hover, pu)
            repeat i in 0..4 {
                let px = spx + 164 * pu + i * 66 * pu
                box { at: px, sby + 170 * pu; size: 60 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * ni_cw_hit.$i.hover }
                group { scale: rs; pivot: floor(px + 0.5), floor(sby + 170 * pu + 0.5); text pick(i, "1/3", "1/2", "2/3", "Full") { at: floor(px + 0.5), floor(sby + 170 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (56 * pu) / rs; lines: 1; color: if(ni_colw == i, mint, ink); family: "Space Grotesk" } }
                zone box ni_cw_hit.$i { at: px, sby + 170 * pu; size: 62 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
                on press ni_cw_hit.$i { emit ni_colw_set(i) }
            }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 346 * pu + 0.5); text "Sensitivity" { at: floor(spx + 14 * pu + 0.5), floor(sby + 346 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(nsl.x0, sby + 346 * pu, nsl.w, clamp((hy_sens + 1) / 2, 0, 1), ni_sens_hit.hover, cu, nh, 0)
            box { at: nsl.x0 + nsl.w / 2, sby + 346 * pu; size: 1.5 * pu, nh + 6 * pu; corner: 0.75 * pu; color: ink; opacity: 40% }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 346 * pu + 0.5); text hy_sens_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 346 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box ni_sens_hit { at: nsl.x0 + nsl.w / 2, sby + 346 * pu; size: nsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press ni_sens_hit { emit hy_sens_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            on drag ni_sens_hit { emit hy_sens_set(clamp(((pointer.x - tx.pnl) - nsl.x0) / nsl.w, 0, 1)) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 382 * pu + 0.5); text "Follow mouse" { at: floor(spx + 14 * pu + 0.5), floor(sby + 382 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            zone box ni_fol_hit_sl { at: spx + 152 * pu + (2 - 1) * 66 * pu / 2, sby + 382 * pu + (1 - 1) * 0 / 2; size: 2 * 66 * pu, 24 * pu + (1 - 1) * 0 }
            SetPick(spx + 152 * pu, sby + 382 * pu, 66 * pu, 2, 24 * pu, hy_follow, ni_fol_hit_sl.hover, pu)
            repeat i in 0..2 {
                let px = spx + 152 * pu + i * 66 * pu
                box { at: px, sby + 382 * pu; size: 60 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * ni_fol_hit.$i.hover }
                group { scale: rs; pivot: floor(px + 0.5), floor(sby + 382 * pu + 0.5); text pick(i, "Off", "On") { at: floor(px + 0.5), floor(sby + 382 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (56 * pu) / rs; lines: 1; color: if(hy_follow == i, mint, ink); family: "Space Grotesk" } }
                zone box ni_fol_hit.$i { at: px, sby + 382 * pu; size: 62 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
                on press ni_fol_hit.$i { emit hy_follow_set(i) }
            }

            //  The switches: a lone column in the middle, animations, natural scroll.
            repeat i in 0..3 {
                let ty = sby + pick(i, 206, 272, 418) * pu
                let tk = pick(i, ni_k0, hy_k2, hy_k3)
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(ty - 6 * pu + 0.5); text pick(i, "Center a lone column", "Window manager animations", "Natural scroll (touchpad)") { at: floor(spx + 14 * pu + 0.5), floor(ty - 6 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(ty + 8 * pu + 0.5); text pick(i, "A single column sits in the middle of the screen", "niri's own window and workspace motion", "Reverses the touchpad's scroll direction") { at: floor(spx + 14 * pu + 0.5), floor(ty + 8 * pu + 0.5); anchor: left center; size: 14.5; color: faint; family: "Space Grotesk" } }
                SettingsSwitch(spx + 424 * pu, ty, tk, ni_tg_hit.$i.pressed, ni_tg_hit.$i.hover, mint)
                zone box ni_tg_hit.$i { at: spx + 219 * pu, ty; size: 430 * pu, 32 * pu; corner: 10 * pu; cursor: pointer }
                on press ni_tg_hit.$i { emit ni_toggle(i) }
            }
        }
}
