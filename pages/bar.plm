part Bar {
    let bar_fm = clamp(bar_lm + bar_tm, 0, 1)      // how far the bar is a Frame, on any of the four edges: only the Island can be rearranged
        //  The Bar page: how the bar itself is set up. So far, which monitors it shows on: one or two.
        //  Choosing restarts the bar there (see the Bar section of vitreus.luau).
        group {
            show: set_pgb > 0.01
            opacity: set_pgb
            let br.sc = clamp(br_scroll, 0, max(0, br.h - set.h))
            let br.off = floor(br.sc * pu + 0.5)        // whole pixels: text that is shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pu, sby + set.h / 2 * pu; size: 456 * pu, set.h * pu }
            //  A scroll goes to the zone declared last under the pointer, and the cards' zones cover most of the page: each one scrolls it too.
            zone box br_wheel { at: spx + 219 * pu, sby + set.h / 2 * pu; size: 446 * pu, set.h * pu }
            on scroll br_wheel { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
            group {
            move: 0, -br.off
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 88 * pu; size: 438 * pu, 124 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 88 * pu, 438 * pu, 124 * pu, 236.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 88 * pu; size: 438 * pu, 124 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 88 * pu; size: 438 * pu, 124 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); text "SHOW THE BAR ON" { at: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }

            //  Beside the title, as the Island layout's Reset is: with monitors left over, whether they keep the frame alone (the notches stay on the bar's monitor)
            //  (launcher, Settings, desk) or show nothing. It changes at once, without restarting the bar. Faded while the bar is on every monitor there is.
            group {
                opacity: if(bar_rest, 1, 0.45)
                group { scale: rs; pivot: floor(spx + 380 * pu + 0.5), floor(sby + 13 * pu + 0.5); text "Frame on the other monitors" { at: floor(spx + 380 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: right center; align: right; size: 15; width: (240 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                SettingsSwitch(spx + 424 * pu, sby + 13 * pu, bar_oth_pill, bar_oth_hit.pressed, bar_oth_hit.hover, mint)
                zone box bar_oth_hit { at: spx + 405 * pu, sby + 13 * pu; size: 46 * pu, 26 * pu; cursor: pointer; active: bar_rest and br.off < 12 * pu }
                on scroll bar_oth_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
                on press bar_oth_hit { emit bar_others_toggle }
            }

            //  One tile per monitor that is plugged in: a screen with the bar across its top. The lit ones are the ones the bar is on; a lit one is let go by pressing it again.
            repeat i in 0..4 {
                let bmx = spx + (52 + i * 83) * pu
                let bmlit = if(bar_sel.$i, 1, 0)
                group {
                    show: bar_m.$i.on
                    box { at: bmx, sby + 76 * pu; size: 66 * pu, 64 * pu; corner: 12 * pu; color: if(bmlit > 0, mint, ink); opacity: if(bmlit > 0, 24%, 6% + 10% * bar_m_hit.$i.hover) }
                    box { at: bmx, sby + 76 * pu; size: 66 * pu, 64 * pu; corner: 12 * pu; stroke: 1.5 * pu; color: mint; opacity: bmlit * 100% }
                    box { at: bmx, sby + 60 * pu; size: 18 * pu, 12 * pu; corner: 2 * pu; stroke: 1.2 * pu; color: mix(ink, mint, bmlit) }
                    box { at: bmx, sby + 56.2 * pu; size: 12 * pu, 1.8 * pu; corner: 0.9 * pu; color: mix(ink, mint, bmlit) }
                    group { scale: rs; pivot: floor(bmx + 0.5), floor(sby + 82 * pu + 0.5); text bar_m.$i.name { at: floor(bmx + 0.5), floor(sby + 82 * pu + 0.5); anchor: center; align: center; size: 16.5; weight: 700; width: (64 * pu) / rs; lines: 1; color: mix(ink, mint, bmlit); family: "Space Grotesk" } }
                    group { scale: rs; pivot: floor(bmx + 0.5), floor(sby + 95 * pu + 0.5); text bar_m.$i.sub { at: floor(bmx + 0.5), floor(sby + 95 * pu + 0.5); anchor: center; align: center; size: 13.5; width: (70 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                    zone box bar_m_hit.$i { at: bmx, sby + 76 * pu; size: 66 * pu, 64 * pu; corner: 12 * pu; cursor: pointer; active: br.off < 60 * pu }
                    on scroll bar_m_hit.$i { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
                    on press bar_m_hit.$i { emit bar_pick_scr(i) }
                }
            }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 121 * pu + 0.5); text "Any of your monitors. It moves at once." { at: floor(spx + 14 * pu + 0.5), floor(sby + 121 * pu + 0.5); anchor: left center; size: 15; width: (410 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 136 * pu + 0.5); text bar_msg { at: floor(spx + 14 * pu + 0.5), floor(sby + 136 * pu + 0.5); anchor: left center; size: 15; width: (410 * pu) / rs; lines: 1; color: mint; family: "Space Grotesk" } }

            //  ── Where the bar is: along the top (the default), or down the left edge with a frame round the screen ──
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 206 * pu; size: 438 * pu, 96 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 206 * pu, 438 * pu, 96 * pu, 502.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 206 * pu; size: 438 * pu, 96 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 206 * pu; size: 438 * pu, 96 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 168 * pu + 0.5); text "BAR POSITION" { at: floor(spx + 14 * pu + 0.5), floor(sby + 168 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            repeat k in 0..6 {
                let bpx = spx + (38 + k * 70) * pu
                let bpy = sby + 215 * pu
                let bplit = if((k == 0 and bar_anchor == top and not bar_frame) or (k == 1 and bar_anchor == left) or (k == 2 and bar_anchor == right) or (k == 3 and bar_anchor == top and bar_frame and not bar_seg) or (k == 4 and bar_anchor == bottom) or (k == 5 and bar_anchor == top and bar_frame and bar_seg), 1, 0)
                box { at: bpx, bpy; size: 66 * pu, 64 * pu; corner: 12 * pu; color: if(bplit > 0, mint, ink); opacity: if(bplit > 0, 24%, 6% + 10% * bar_pos_hit.$k.hover) }
                box { at: bpx, bpy; size: 66 * pu, 64 * pu; corner: 12 * pu; stroke: 1.5 * pu; color: mint; opacity: bplit * 100% }
                //  A small screen. With the bar along the top: a bar across its top. Down the left: a strip, and the frame round the rest.
                box { at: bpx, bpy - 12 * pu; size: 36 * pu, 24 * pu; corner: 3 * pu; stroke: 1.2 * pu; color: mix(ink, mint, bplit) }
                box { at: bpx, bpy - 21 * pu; size: 28 * pu, 3.2 * pu; corner: 1.6 * pu; color: mix(ink, mint, bplit); show: k == 0 }
                box { at: bpx - 15.6 * pu, bpy - 12 * pu; size: 3.6 * pu, 24 * pu; corner: 1.8 * pu; color: mix(ink, mint, bplit); show: k == 1 }
                box { at: bpx + 1.8 * pu, bpy - 12 * pu; size: 28 * pu, 19.6 * pu; corner: 3 * pu; stroke: 0.9 * pu; color: mix(ink, mint, bplit); opacity: 60%; show: k == 1 }
                box { at: bpx + 15.6 * pu, bpy - 12 * pu; size: 3.6 * pu, 24 * pu; corner: 1.8 * pu; color: mix(ink, mint, bplit); show: k == 2 }
                box { at: bpx - 1.8 * pu, bpy - 12 * pu; size: 28 * pu, 19.6 * pu; corner: 3 * pu; stroke: 0.9 * pu; color: mix(ink, mint, bplit); opacity: 60%; show: k == 2 }
                box { at: bpx, bpy - 21.6 * pu; size: 36 * pu, 3.6 * pu; corner: 1.8 * pu; color: mix(ink, mint, bplit); show: k == 3 }
                box { at: bpx, bpy - 10.2 * pu; size: 28 * pu, 16 * pu; corner: 3 * pu; stroke: 0.9 * pu; color: mix(ink, mint, bplit); opacity: 60%; show: k == 3 }
                box { at: bpx, bpy - 2.4 * pu; size: 36 * pu, 3.6 * pu; corner: 1.8 * pu; color: mix(ink, mint, bplit); show: k == 4 }
                //  Notches: the thin frame along the top, and three glass notches hanging from it (a wider one in the middle, and a smaller one in each of the four corners, all inside the screen's outline), well clear of the window below.
                box { at: bpx, bpy - 22.8 * pu; size: 36 * pu, 2.4 * pu; corner: 1.2 * pu; color: mix(ink, mint, bplit); show: k == 5 }
                box { at: bpx - 14.4 * pu, bpy - 21 * pu; size: 6 * pu, 4.8 * pu; corner: 2.4 * pu; color: mix(ink, mint, bplit); show: k == 5 }
                box { at: bpx, bpy - 19.8 * pu; size: 14 * pu, 7.2 * pu; corner: 2.4 * pu; color: mix(ink, mint, bplit); show: k == 5 }
                box { at: bpx + 14.4 * pu, bpy - 21 * pu; size: 6 * pu, 4.8 * pu; corner: 2.4 * pu; color: mix(ink, mint, bplit); show: k == 5 }
                box { at: bpx + 14.4 * pu, bpy - 3 * pu; size: 6 * pu, 4.8 * pu; corner: 2.4 * pu; color: mix(ink, mint, bplit); show: k == 5 }
                box { at: bpx - 14.4 * pu, bpy - 3 * pu; size: 6 * pu, 4.8 * pu; corner: 2.4 * pu; color: mix(ink, mint, bplit); show: k == 5 }
                box { at: bpx, bpy - 8.6 * pu; size: 22 * pu, 12 * pu; corner: 3 * pu; stroke: 0.9 * pu; color: mix(ink, mint, bplit); opacity: 60%; show: k == 5 }
                box { at: bpx, bpy - 13.8 * pu; size: 28 * pu, 16 * pu; corner: 3 * pu; stroke: 0.9 * pu; color: mix(ink, mint, bplit); opacity: 60%; show: k == 4 }
                group { scale: rs; pivot: floor(bpx + 0.5), floor(bpy + 13 * pu + 0.5); text pick(k, "Island", "Frame", "Frame", "Frame", "Frame", "Notches") { at: floor(bpx + 0.5), floor(bpy + 13 * pu + 0.5); anchor: center; align: center; size: 16.5; weight: 700; width: (64 * pu) / rs; lines: 1; color: mix(ink, mint, bplit); family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(bpx + 0.5), floor(bpy + 26 * pu + 0.5); text pick(k, "along the top", "left edge", "right edge", "top edge", "bottom edge", "top, split") { at: floor(bpx + 0.5), floor(bpy + 26 * pu + 0.5); anchor: center; align: center; size: 13.5; width: (70 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                zone box bar_pos_hit.$k { at: bpx, bpy; size: 66 * pu, 64 * pu; corner: 12 * pu; cursor: pointer }
                on scroll bar_pos_hit.$k { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
                on press bar_pos_hit.$k { emit bar_pick_pos(k) }
            }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 267.5 * pu + 0.5); text "It moves at once; windows make room for the strip." { at: floor(spx + 14 * pu + 0.5), floor(sby + 267.5 * pu + 0.5); anchor: left center; size: 15; width: (410 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            //  Which icons the bar shows: four buttons, one for each icon (click to show or hide it; a hidden one is greyed out). Kept by logic/bar_layout.luau.
            let mscy = sby + 319 * pu
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, mscy; size: 438 * pu, 76 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, mscy, 438 * pu, 76 * pu, 885.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, mscy; size: 438 * pu, 76 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, mscy; size: 438 * pu, 76 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(mscy - 27 * pu + 0.5); text "ICONS ON THE BAR  ·  click one to show or hide it" { at: floor(spx + 14 * pu + 0.5), floor(mscy - 27 * pu + 0.5); anchor: left center; size: 12.5; weight: 600; color: faint; family: "Space Grotesk" } }
            //  Desk: a button, lit (mint outline) while the icon is on the bar, and greyed out while it is not
            let msx0 = spx + 47 * pu
            box { at: msx0, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; color: mix(ink, mint, bsh_dsk_pill); opacity: 7% + 9% * bsh_dsk_pill + 8% * bsh_dsk_hit.hover }
            box { at: msx0, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; stroke: 1.5 * pu; color: mint; opacity: bsh_dsk_pill * 100% }
            group {
                opacity: 28% + 72% * bsh_dsk_pill
                group { pivot: msx0, mscy + 1 * pu; scale: 0.62
                    GBox(msx0, mscy + 1 * pu, -9, -8, -1.5, 8, 11, 1.1 * pu, ink, 90%, 0)
                    GBox(msx0, mscy + 1 * pu, 2, -8, 9, -1.5, 15, 1.1 * pu, ink, 90%, 0)
                    GBox(msx0, mscy + 1 * pu, 2, 1.5, 9, 8, 19, 1.1 * pu, ink, 90%, 0)
                }
                group { scale: rs; pivot: floor(msx0 + 0.5), floor(mscy + 19 * pu + 0.5); text "Desk" { at: floor(msx0 + 0.5), floor(mscy + 19 * pu + 0.5); anchor: center; size: 12.5; color: ink; family: "Space Grotesk" } }
            }
            zone box bsh_dsk_hit { at: msx0, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; cursor: pointer; label: "Desk: show or hide" }
            on scroll bsh_dsk_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
            on press bsh_dsk_hit { emit bar_show_dsk }
            //  Battery: a button, lit (mint outline) while the icon is on the bar, and greyed out while it is not
            let msxb = spx + 131 * pu
            box { at: msxb, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; color: mix(ink, mint, bsh_bat_pill); opacity: 7% + 9% * bsh_bat_pill + 8% * bsh_bat_hit.hover }
            box { at: msxb, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; stroke: 1.5 * pu; color: mint; opacity: bsh_bat_pill * 100% }
            group {
                opacity: 28% + 72% * bsh_bat_pill
                group { pivot: msxb, mscy + 1 * pu; scale: 0.95
                    GBattery(msxb, mscy + 1 * pu, 0.69, 1.1 * pu, ink, 90%, 0)
                }
                group { scale: rs; pivot: floor(msxb + 0.5), floor(mscy + 19 * pu + 0.5); text "Battery" { at: floor(msxb + 0.5), floor(mscy + 19 * pu + 0.5); anchor: center; size: 12.5; color: ink; family: "Space Grotesk" } }
            }
            zone box bsh_bat_hit { at: msxb, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; cursor: pointer; label: "Battery: show or hide" }
            on scroll bsh_bat_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
            on press bsh_bat_hit { emit bar_show_bat }
            //  Search: a button, lit (mint outline) while the icon is on the bar, and greyed out while it is not
            let msx1 = spx + 215 * pu
            box { at: msx1, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; color: mix(ink, mint, bsh_sr_pill); opacity: 7% + 9% * bsh_sr_pill + 8% * bsh_sr_hit.hover }
            box { at: msx1, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; stroke: 1.5 * pu; color: mint; opacity: bsh_sr_pill * 100% }
            group {
                opacity: 28% + 72% * bsh_sr_pill
                PBSearch(msx1, mscy + 1 * pu, 0, 1.1 * pu, 0)
                group { scale: rs; pivot: floor(msx1 + 0.5), floor(mscy + 19 * pu + 0.5); text "Search" { at: floor(msx1 + 0.5), floor(mscy + 19 * pu + 0.5); anchor: center; size: 12.5; color: ink; family: "Space Grotesk" } }
            }
            zone box bsh_sr_hit { at: msx1, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; cursor: pointer; label: "Search: show or hide" }
            on scroll bsh_sr_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
            on press bsh_sr_hit { emit bar_show_sr }
            //  Settings: a button, lit (mint outline) while the icon is on the bar, and greyed out while it is not
            let msx2 = spx + 299 * pu
            box { at: msx2, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; color: mix(ink, mint, bsh_set_pill); opacity: 7% + 9% * bsh_set_pill + 8% * bsh_set_hit.hover }
            box { at: msx2, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; stroke: 1.5 * pu; color: mint; opacity: bsh_set_pill * 100% }
            group {
                opacity: 28% + 72% * bsh_set_pill
                PBGear(msx2, mscy + 1 * pu, 0, 1.1 * pu, 0)
                group { scale: rs; pivot: floor(msx2 + 0.5), floor(mscy + 19 * pu + 0.5); text "Settings" { at: floor(msx2 + 0.5), floor(mscy + 19 * pu + 0.5); anchor: center; size: 12.5; color: ink; family: "Space Grotesk" } }
            }
            zone box bsh_set_hit { at: msx2, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; cursor: pointer; label: "Settings: show or hide" }
            on scroll bsh_set_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
            on press bsh_set_hit { emit bar_show_set }
            //  Controls: a button, lit (mint outline) while the icon is on the bar, and greyed out while it is not
            let msx3 = spx + 383 * pu
            box { at: msx3, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; color: mix(ink, mint, bsh_ctl_pill); opacity: 7% + 9% * bsh_ctl_pill + 8% * bsh_ctl_hit.hover }
            box { at: msx3, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; stroke: 1.5 * pu; color: mint; opacity: bsh_ctl_pill * 100% }
            group {
                opacity: 28% + 72% * bsh_ctl_pill
                PBCtl(msx3, mscy + 1 * pu, 0, 1.1 * pu, 0)
                group { scale: rs; pivot: floor(msx3 + 0.5), floor(mscy + 19 * pu + 0.5); text "Controls" { at: floor(msx3 + 0.5), floor(mscy + 19 * pu + 0.5); anchor: center; size: 12.5; color: ink; family: "Space Grotesk" } }
            }
            zone box bsh_ctl_hit { at: msx3, mscy + 7 * pu; size: 64 * pu, 42 * pu; corner: 11 * pu; cursor: pointer; label: "Controls: show or hide" }
            on scroll bsh_ctl_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
            on press bsh_ctl_hit { emit bar_show_ctl }
            //  The Island moving to the music: it swells and sends a wave along itself on the bass (cava runs only while it is on). Only the Island does it, so on any other layout the row is dimmed and does nothing.
            let bbz = sby + 424 * pu
            group {
                opacity: if(bar_frame, 0.45, 1)
                body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, bbz; size: 438 * pu, 34 * pu; corner: 14 * pu } }
                DdCard(spx + 219 * pu, bbz, 438 * pu, 34 * pu, 881.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
                box { at: spx + 219 * pu, bbz; size: 438 * pu, 34 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
                box { at: spx + 219 * pu, bbz; size: 438 * pu, 34 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(bbz + 0.5); text "Island moves to the music" { at: floor(spx + 14 * pu + 0.5), floor(bbz + 0.5); anchor: left center; size: 16.5; width: (340 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                SettingsSwitch(spx + 424 * pu, bbz, bar_beat_pill, bar_beat_hit.pressed, bar_beat_hit.hover, mint)
                zone box bar_beat_hit { at: spx + 405 * pu, bbz; size: 46 * pu, 26 * pu; cursor: pointer; active: not bar_frame; label: "Island moves to the music" }
                on scroll bar_beat_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
                on press bar_beat_hit { emit bar_beat_toggle }
            }
            //  Size: how big the bar is, 70 to 100 % (`bz` in vitreus.plm), a slider on a row of its own under the layouts.
            let bzy = sby + 382 * pu
            let bzx0 = spx + 120 * pu
            let bzw = 250 * pu
            let bzh = 12 * pu
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, bzy; size: 438 * pu, 34 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, bzy, 438 * pu, 34 * pu, 789.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, bzy; size: 438 * pu, 34 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, bzy; size: 438 * pu, 34 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(bzy + 0.5); text "Bar size" { at: floor(spx + 14 * pu + 0.5), floor(bzy + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(bzx0, bzy, bzw, clamp((bar_size - 0.7) / 0.3, 0, 1), bar_size_hit.hover, cu, bzh, 0)
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(bzy + 0.5); text bar_size_text { at: floor(spx + 424 * pu + 0.5), floor(bzy + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box bar_size_hit { at: bzx0 + bzw / 2, bzy; size: bzw + 24 * pu, 30 * pu; cursor: pointer; label: "Bar size" }
            on scroll bar_size_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
            on press bar_size_hit { emit bar_pick_size(clamp(((pointer.x - tx.pnl) - bzx0) / bzw, 0, 1)) }
            on drag bar_size_hit { emit bar_pick_size(clamp(((pointer.x - tx.pnl) - bzx0) / bzw, 0, 1)) }

            //  Room for the docks: off (the default), windows keep clear of the app dock and the add-on pill while they are out (on the edge opposite the bar); on, the docks overlap windows. The fact `bar_dockroom` is the room, so the switch is its opposite.
            let drz = sby + 466 * pu
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, drz; size: 438 * pu, 34 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, drz, 438 * pu, 34 * pu, 880.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, drz; size: 438 * pu, 34 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, drz; size: 438 * pu, 34 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(drz + 0.5); text "Corner docks overlap windows" { at: floor(spx + 14 * pu + 0.5), floor(drz + 0.5); anchor: left center; size: 16.5; width: (340 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pu, drz, bar_dr_pill, bar_dr_hit.pressed, bar_dr_hit.hover, mint)
            zone box bar_dr_hit { at: spx + 405 * pu, drz; size: 46 * pu, 26 * pu; cursor: pointer; label: "Corner docks overlap windows" }
            on scroll bar_dr_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
            on press bar_dr_hit { emit bar_dockroom_toggle }


            //  ── How the workspace marks look: a card each, with the marks drawn small (one of four in view, one with a window), as they are on the bar ──
            //  One centred dock (Island only): the app dock and the add-on pill become one pill in the middle of the bottom edge, which is then not pulled about. Dimmed, and does nothing, on the other layouts.
            let dmz = sby + 508 * pu
            group {
                opacity: if(bar_frame, 0.45, 1)
                body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, dmz; size: 438 * pu, 34 * pu; corner: 14 * pu } }
                DdCard(spx + 219 * pu, dmz, 438 * pu, 34 * pu, 882.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
                box { at: spx + 219 * pu, dmz; size: 438 * pu, 34 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
                box { at: spx + 219 * pu, dmz; size: 438 * pu, 34 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(dmz + 0.5); text "Docks as one, centred" { at: floor(spx + 14 * pu + 0.5), floor(dmz + 0.5); anchor: left center; size: 16.5; width: (340 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                SettingsSwitch(spx + 424 * pu, dmz, dock_mid_pill, dock_mid_hit.pressed, dock_mid_hit.hover, mint)
                zone box dock_mid_hit { at: spx + 405 * pu, dmz; size: 46 * pu, 26 * pu; cursor: pointer; active: not bar_frame; label: "Docks as one, centred" }
                on scroll dock_mid_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
                on press dock_mid_hit { emit dock_mid_toggle }
            }

            let axz = sby + 550 * pu
            group {
                opacity: if(bar_frame, 0.45, 1)
                body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, axz; size: 438 * pu, 34 * pu; corner: 14 * pu } }
                DdCard(spx + 219 * pu, axz, 438 * pu, 34 * pu, 883.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
                box { at: spx + 219 * pu, axz; size: 438 * pu, 34 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
                box { at: spx + 219 * pu, axz; size: 438 * pu, 34 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(axz + 0.5); text "Add-on icons on the bar" { at: floor(spx + 14 * pu + 0.5), floor(axz + 0.5); anchor: left center; size: 16.5; width: (340 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                SettingsSwitch(spx + 424 * pu, axz, bar_ax_pill, bar_ax_hit.pressed, bar_ax_hit.hover, mint)
                zone box bar_ax_hit { at: spx + 405 * pu, axz; size: 46 * pu, 26 * pu; cursor: pointer; active: not bar_frame; label: "Add-on icons on the bar" }
                on scroll bar_ax_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
                on press bar_ax_hit { emit bar_ax_toggle }
            }
            let cdz = sby + 592 * pu
            group {
                opacity: 1
                body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, cdz; size: 438 * pu, 34 * pu; corner: 14 * pu } }
                DdCard(spx + 219 * pu, cdz, 438 * pu, 34 * pu, 884.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
                box { at: spx + 219 * pu, cdz; size: 438 * pu, 34 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
                box { at: spx + 219 * pu, cdz; size: 438 * pu, 34 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(cdz + 0.5); text "Show the corner dock" { at: floor(spx + 14 * pu + 0.5), floor(cdz + 0.5); anchor: left center; size: 16.5; width: (340 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                SettingsSwitch(spx + 424 * pu, cdz, cdk_pill, cdk_hit.pressed, cdk_hit.hover, mint)
                zone box cdk_hit { at: spx + 405 * pu, cdz; size: 46 * pu, 26 * pu; cursor: pointer; active: true; label: "Show the corner dock" }
                on scroll cdk_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
                on press cdk_hit { emit cdk_show_toggle }
            }
            }
            let br.thh = set.h * set.h / max(set.h, br.h)
            let br.thy = br.thh / 2 + br.sc / max(1, br.h - set.h) * (set.h - br.thh)
            box { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: if(br.h > set.h, 6%, 0%) }
            box { at: spx + 442 * pu, sby + br.thy * pu; size: 3 * pu, br.thh * pu; corner: 1.5 * pu; color: mint; opacity: if(br.h > set.h, 55%, 0%) }
            let br.cue = clamp((br.h - set.h - br.sc) / 24, 0, 1)
            let br.cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let bfk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * bfk * bfk * br.cue }
            }
            box { at: spx + 224 * pu, br.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * br.cue }
            box { at: spx + 224 * pu, br.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * br_cue_hit.hover) * br.cue }
            path { at: spx + 204 * pu, br.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: br.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, br.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: br.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            group { scale: rs; pivot: floor(spx + 232 * pu + 0.5), floor(br.cuey + 0.5); text "More" { at: floor(spx + 232 * pu + 0.5), floor(br.cuey + 0.5); anchor: center; size: 16.5; weight: 700; color: ink; opacity: br.cue; family: "Space Grotesk" } }
            zone box br_cue_hit { at: spx + 224 * pu, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: br.cue > 0.5; label: "More" }
            on press br_cue_hit { br_scroll_to = clamp(br_scroll_to + 342, 0, max(0, br.h - set.h)) }
            zone box br_bar_hit { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: br.h > set.h; label: "Scroll the Bar page" }
            on press br_bar_hit { br_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - br.thh / 2) / max(1, set.h - br.thh) * (br.h - set.h), 0, max(0, br.h - set.h)) }
            on drag br_bar_hit { br_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - br.thh / 2) / max(1, set.h - br.thh) * (br.h - set.h), 0, max(0, br.h - set.h)) }
        }
}
