part Bar {
    let bar_fm = clamp(bar_lm + bar_tm, 0, 1)      // how far the bar is a Frame, on any of the four edges: only the Island can be rearranged
        //  The Bar page: how the bar itself is set up. So far, which monitors it shows on: one or two.
        //  Choosing restarts the bar there (see the Bar section of vitreus.luau).
        group {
            show: set_pgb > 0.01
            opacity: set_pgb
            let br.sc = clamp(br_scroll, 0, max(0, br.h - set.h))
            let br.off = floor(br.sc * pu + 0.5)        // whole pixels: text that is shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pu, sby + set.h / 2 * pu; size: 456 * pu, set.h * pu }
            //  A scroll goes to the zone declared last under the pointer, and the cards' zones cover most of the page: each one scrolls it too.
            zone box br_wheel { at: spx + 219 * pu, sby + set.h / 2 * pu; size: 446 * pu, set.h * pu }
            on scroll br_wheel { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
            group {
            move: 0, -br.off
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 88 * pu; size: 438 * pu, 124 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 88 * pu; size: 438 * pu, 124 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); text "SHOW THE BAR ON" { at: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }

            //  Beside the title, as the Island layout's Reset is: with monitors left over, whether they keep the frame alone (the notches stay on the bar's monitor)
            //  (launcher, Settings, desk) or show nothing. It changes at once, without restarting the bar. Faded while the bar is on every monitor there is.
            group {
                opacity: if(bar_rest, 1, 0.45)
                group { scale: rs; pivot: floor(spx + 380 * pu + 0.5), floor(sby + 13 * pu + 0.5); text "Frame on the other monitors" { at: floor(spx + 380 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: right center; align: right; size: 15; width: (240 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                SettingsSwitch(spx + 424 * pu, sby + 13 * pu, bar_oth_pill, bar_oth_hit.pressed, bar_oth_hit.hover, mint)
                zone box bar_oth_hit { at: spx + 405 * pu, sby + 13 * pu; size: 46 * pu, 26 * pu; cursor: pointer; active: bar_rest and br.off < 12 * pu }
                on scroll bar_oth_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
                on press bar_oth_hit { emit bar_others_toggle }
            }

            //  One tile per monitor that is plugged in: a screen with the bar across its top. The lit ones are the ones the bar is on; a lit one is let go by pressing it again.
            repeat i in 0..4 {
                let bmx = spx + (52 + i * 83) * pu
                let bmlit = if(bar_sel.$i, 1, 0)
                group {
                    show: bar_m.$i.on
                    box { at: bmx, sby + 76 * pu; size: 66 * pu, 64 * pu; corner: 12 * pu; color: if(bmlit > 0, mint, ink); opacity: if(bmlit > 0, 24%, 6% + 10% * bar_m_hit.$i.hover) }
                    box { at: bmx, sby + 76 * pu; size: 66 * pu, 64 * pu; corner: 12 * pu; stroke: 1.5 * pu; color: mint; opacity: bmlit * 100% }
                    box { at: bmx, sby + 60 * pu; size: 18 * pu, 12 * pu; corner: 2 * pu; stroke: 1.2 * pu; color: mix(ink, mint, bmlit) }
                    box { at: bmx, sby + 56.2 * pu; size: 12 * pu, 1.8 * pu; corner: 0.9 * pu; color: mix(ink, mint, bmlit) }
                    group { scale: rs; pivot: floor(bmx + 0.5), floor(sby + 82 * pu + 0.5); text bar_m.$i.name { at: floor(bmx + 0.5), floor(sby + 82 * pu + 0.5); anchor: center; align: center; size: 16.5; weight: 700; width: (64 * pu) / rs; lines: 1; color: mix(ink, mint, bmlit); family: "Space Grotesk" } }
                    group { scale: rs; pivot: floor(bmx + 0.5), floor(sby + 95 * pu + 0.5); text bar_m.$i.sub { at: floor(bmx + 0.5), floor(sby + 95 * pu + 0.5); anchor: center; align: center; size: 13.5; width: (70 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                    zone box bar_m_hit.$i { at: bmx, sby + 76 * pu; size: 66 * pu, 64 * pu; corner: 12 * pu; cursor: pointer; active: br.off < 60 * pu }
                    on scroll bar_m_hit.$i { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
                    on press bar_m_hit.$i { emit bar_pick_scr(i) }
                }
            }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 121 * pu + 0.5); text "Any of your monitors. It moves at once." { at: floor(spx + 14 * pu + 0.5), floor(sby + 121 * pu + 0.5); anchor: left center; size: 15; width: (410 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 136 * pu + 0.5); text bar_msg { at: floor(spx + 14 * pu + 0.5), floor(sby + 136 * pu + 0.5); anchor: left center; size: 15; width: (410 * pu) / rs; lines: 1; color: mint; family: "Space Grotesk" } }

            //  ── Where the bar is: along the top (the default), or down the left edge with a frame round the screen ──
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 360 * pu; size: 438 * pu, 96 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 360 * pu; size: 438 * pu, 96 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 322 * pu + 0.5); text "BAR POSITION" { at: floor(spx + 14 * pu + 0.5), floor(sby + 322 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            repeat k in 0..6 {
                let bpx = spx + (38 + k * 70) * pu
                let bpy = sby + 369 * pu
                let bplit = if((k == 0 and bar_anchor == top and not bar_frame) or (k == 1 and bar_anchor == left) or (k == 2 and bar_anchor == right) or (k == 3 and bar_anchor == top and bar_frame and not bar_seg) or (k == 4 and bar_anchor == bottom) or (k == 5 and bar_anchor == top and bar_frame and bar_seg), 1, 0)
                box { at: bpx, bpy; size: 66 * pu, 64 * pu; corner: 12 * pu; color: if(bplit > 0, mint, ink); opacity: if(bplit > 0, 24%, 6% + 10% * bar_pos_hit.$k.hover) }
                box { at: bpx, bpy; size: 66 * pu, 64 * pu; corner: 12 * pu; stroke: 1.5 * pu; color: mint; opacity: bplit * 100% }
                //  A small screen. With the bar along the top: a bar across its top. Down the left: a strip, and the frame round the rest.
                box { at: bpx, bpy - 12 * pu; size: 36 * pu, 24 * pu; corner: 3 * pu; stroke: 1.2 * pu; color: mix(ink, mint, bplit) }
                box { at: bpx, bpy - 21 * pu; size: 28 * pu, 3.2 * pu; corner: 1.6 * pu; color: mix(ink, mint, bplit); show: k == 0 }
                box { at: bpx - 15.6 * pu, bpy - 12 * pu; size: 3.6 * pu, 24 * pu; corner: 1.8 * pu; color: mix(ink, mint, bplit); show: k == 1 }
                box { at: bpx + 1.8 * pu, bpy - 12 * pu; size: 28 * pu, 19.6 * pu; corner: 3 * pu; stroke: 0.9 * pu; color: mix(ink, mint, bplit); opacity: 60%; show: k == 1 }
                box { at: bpx + 15.6 * pu, bpy - 12 * pu; size: 3.6 * pu, 24 * pu; corner: 1.8 * pu; color: mix(ink, mint, bplit); show: k == 2 }
                box { at: bpx - 1.8 * pu, bpy - 12 * pu; size: 28 * pu, 19.6 * pu; corner: 3 * pu; stroke: 0.9 * pu; color: mix(ink, mint, bplit); opacity: 60%; show: k == 2 }
                box { at: bpx, bpy - 21.6 * pu; size: 36 * pu, 3.6 * pu; corner: 1.8 * pu; color: mix(ink, mint, bplit); show: k == 3 }
                box { at: bpx, bpy - 10.2 * pu; size: 28 * pu, 16 * pu; corner: 3 * pu; stroke: 0.9 * pu; color: mix(ink, mint, bplit); opacity: 60%; show: k == 3 }
                box { at: bpx, bpy - 2.4 * pu; size: 36 * pu, 3.6 * pu; corner: 1.8 * pu; color: mix(ink, mint, bplit); show: k == 4 }
                //  Notches: the thin frame along the top, and three glass notches hanging from it (a wider one in the middle, and a smaller one in each of the four corners, all inside the screen's outline), well clear of the window below.
                box { at: bpx, bpy - 22.8 * pu; size: 36 * pu, 2.4 * pu; corner: 1.2 * pu; color: mix(ink, mint, bplit); show: k == 5 }
                box { at: bpx - 14.4 * pu, bpy - 21 * pu; size: 6 * pu, 4.8 * pu; corner: 2.4 * pu; color: mix(ink, mint, bplit); show: k == 5 }
                box { at: bpx, bpy - 19.8 * pu; size: 14 * pu, 7.2 * pu; corner: 2.4 * pu; color: mix(ink, mint, bplit); show: k == 5 }
                box { at: bpx + 14.4 * pu, bpy - 21 * pu; size: 6 * pu, 4.8 * pu; corner: 2.4 * pu; color: mix(ink, mint, bplit); show: k == 5 }
                box { at: bpx + 14.4 * pu, bpy - 3 * pu; size: 6 * pu, 4.8 * pu; corner: 2.4 * pu; color: mix(ink, mint, bplit); show: k == 5 }
                box { at: bpx - 14.4 * pu, bpy - 3 * pu; size: 6 * pu, 4.8 * pu; corner: 2.4 * pu; color: mix(ink, mint, bplit); show: k == 5 }
                box { at: bpx, bpy - 8.6 * pu; size: 22 * pu, 12 * pu; corner: 3 * pu; stroke: 0.9 * pu; color: mix(ink, mint, bplit); opacity: 60%; show: k == 5 }
                box { at: bpx, bpy - 13.8 * pu; size: 28 * pu, 16 * pu; corner: 3 * pu; stroke: 0.9 * pu; color: mix(ink, mint, bplit); opacity: 60%; show: k == 4 }
                group { scale: rs; pivot: floor(bpx + 0.5), floor(bpy + 13 * pu + 0.5); text pick(k, "Island", "Frame", "Frame", "Frame", "Frame", "Notches") { at: floor(bpx + 0.5), floor(bpy + 13 * pu + 0.5); anchor: center; align: center; size: 16.5; weight: 700; width: (64 * pu) / rs; lines: 1; color: mix(ink, mint, bplit); family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(bpx + 0.5), floor(bpy + 26 * pu + 0.5); text pick(k, "along the top", "left edge", "right edge", "top edge", "bottom edge", "top, split") { at: floor(bpx + 0.5), floor(bpy + 26 * pu + 0.5); anchor: center; align: center; size: 13.5; width: (70 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                zone box bar_pos_hit.$k { at: bpx, bpy; size: 66 * pu, 64 * pu; corner: 12 * pu; cursor: pointer }
                on scroll bar_pos_hit.$k { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
                on press bar_pos_hit.$k { emit bar_pick_pos(k) }
            }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 418 * pu + 0.5); text "It moves at once; windows make room for the strip." { at: floor(spx + 14 * pu + 0.5), floor(sby + 418 * pu + 0.5); anchor: left center; size: 15; width: (410 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            //  Size: how big the bar is, 70 to 100 % (`bz` in vitreus.plm), a slider on a row of its own under the layouts.
            let bzy = sby + 446 * pu
            let bzx0 = spx + 120 * pu
            let bzw = 250 * pu
            let bzh = 12 * pu
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, bzy; size: 438 * pu, 34 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, bzy; size: 438 * pu, 34 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(bzy + 0.5); text "Bar size" { at: floor(spx + 14 * pu + 0.5), floor(bzy + 0.5); anchor: left center; size: 16.5; color: faint; family: "Space Grotesk" } }
            PSlider(bzx0, bzy, bzw, clamp((bar_size - 0.7) / 0.3, 0, 1), bar_size_hit.hover, cu, bzh, 0)
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(bzy + 0.5); text bar_size_text { at: floor(spx + 424 * pu + 0.5), floor(bzy + 0.5); anchor: right center; size: 19.5; weight: 600; color: ink; family: "Space Grotesk" } }
            zone box bar_size_hit { at: bzx0 + bzw / 2, bzy; size: bzw + 24 * pu, 30 * pu; cursor: pointer; label: "Bar size" }
            on scroll bar_size_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
            on press bar_size_hit { emit bar_pick_size(clamp(((pointer.x - tx.pnl) - bzx0) / bzw, 0, 1)) }
            on drag bar_size_hit { emit bar_pick_size(clamp(((pointer.x - tx.pnl) - bzx0) / bzw, 0, 1)) }

            //  Room for the docks: off (the default), windows keep clear of the app dock and the add-on pill while they are out (on the edge opposite the bar); on, the docks overlap windows. The fact `bar_dockroom` is the room, so the switch is its opposite.
            let drz = sby + 486 * pu
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, drz; size: 438 * pu, 34 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, drz; size: 438 * pu, 34 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(drz + 0.5); text "Corner docks overlap windows" { at: floor(spx + 14 * pu + 0.5), floor(drz + 0.5); anchor: left center; size: 16.5; width: (340 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pu, drz, bar_dr_pill, bar_dr_hit.pressed, bar_dr_hit.hover, mint)
            zone box bar_dr_hit { at: spx + 405 * pu, drz; size: 46 * pu, 26 * pu; cursor: pointer; label: "Corner docks overlap windows" }
            on scroll bar_dr_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
            on press bar_dr_hit { emit bar_dockroom_toggle }

            //  ── How many frames a second the bar paints ─────────────────────────────────────────────────────────
            //  A 240 Hz screen makes the shell paint a panel 240 times a second, which costs what a 240 Hz game costs
            //  while it lasts. The animations are the same length either way: fewer frames is less current, not less
            //  movement. `Screen` is no cap at all (the scene leaves it to the monitor).
            let bfy = sby + 556 * pu
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 526 * pu + 0.5); text "FRAME RATE" { at: floor(spx + 14 * pu + 0.5), floor(sby + 526 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, bfy; size: 438 * pu, 44 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, bfy; size: 438 * pu, 44 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(bfy + 0.5); text "Frames a second" { at: floor(spx + 14 * pu + 0.5), floor(bfy + 0.5); anchor: left center; size: 15; weight: 700; width: (150 * pu) / rs; lines: 1; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 150 * pu + 0.5), floor(bfy + 0.5); text "Fewer frames, same movement" { at: floor(spx + 150 * pu + 0.5), floor(bfy + 0.5); anchor: left center; size: 13.5; width: (140 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            repeat f in 0..2 {
                let bfv = pick(f, 480, 120)
                let bfx = spx + (316 + f * 60) * pu
                let bflit = if(bar_fps == bfv, 1, 0)
                box { at: bfx, bfy; size: 56 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, bflit); opacity: 8% + 20% * bflit + 6% * bar_fps_hit.$f.hover }
                PPillOutline(bfx, bfy, 56 * pu, 24 * pu, 8 * pu, bar_fps_hit.$f.hover, clamp(3 * (8% + 20% * bflit + 6% * bar_fps_hit.$f.hover), 0, 1), pu)
                group { scale: rs; pivot: floor(bfx + 0.5), floor(bfy + 0.5); text pick(f, "Screen", "120") { at: floor(bfx + 0.5), floor(bfy + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (52 * pu) / rs; lines: 1; color: mix(ink, mint, bflit); family: "Space Grotesk" } }
                zone box bar_fps_hit.$f { at: bfx, bfy; size: 56 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; label: pick(f, "The monitor's own rate", "120 frames a second") }
                on scroll bar_fps_hit.$f { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
                on press bar_fps_hit.$f { emit bar_pick_fps(bfv) }
            }

            //  ── The Island's layout: a small copy of the bar, and under it a tray for the pieces that are hidden. The Frame has a fixed one (see the end). ──
            //  Drag a piece along the bar to move it, or down into the tray to hide it (all but the settings gear,
            //  the way back here). The logic places the chips and makes room where the dragged one would land.
            let mbx = spx + 14 * pu                         // the editor's origin: the small bar's top-left
            let mby = sby + 190 * pu
            group {
            //  The Frame has a fixed layout, so the editor is faded while it is the one in use (and its zones are off: see `active:`).
            opacity: 100% - 68% * clamp(bar_fm, 0, 1)
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 244 * pu; size: 438 * pu, 132 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 244 * pu; size: 438 * pu, 132 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 166 * pu + 0.5); text "ISLAND LAYOUT" { at: floor(spx + 14 * pu + 0.5), floor(sby + 166 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            box { at: spx + 400 * pu, sby + 166 * pu; size: 48 * pu, 20 * pu; corner: 10 * pu; color: ink; opacity: 8% + 10% * blay_reset_hit.hover }
            PPillOutline(spx + 400 * pu, sby + 166 * pu, 48 * pu, 20 * pu, 10 * pu, blay_reset_hit.hover, clamp(3 * (8% + 10% * blay_reset_hit.hover), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 400 * pu + 0.5), floor(sby + 166 * pu + 0.5); text "Reset" { at: floor(spx + 400 * pu + 0.5), floor(sby + 166 * pu + 0.5); anchor: center; align: center; size: 15; weight: 600; width: (44 * pu) / rs; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" } }
            zone box blay_reset_hit { at: spx + 400 * pu, sby + 166 * pu; size: 50 * pu, 22 * pu; corner: 11 * pu; cursor: pointer; active: bar_fm < 0.5 }
            on scroll blay_reset_hit { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
            on press blay_reset_hit { emit bar_lay_reset }
            //  The small bar, and the tray: lit while the dragged piece would land in it.
            box { from: mbx, mby; size: 410 * pu, 36 * pu; corner: 12 * pu; color: ink; opacity: 5% }
            box { from: mbx, mby; size: 410 * pu, 36 * pu; corner: 12 * pu; stroke: 1 * pu; color: mix(ink, mint, if(bdrag >= 0 and not bdrop_tray, 1, 0)); opacity: if(bdrag >= 0 and not bdrop_tray, 60%, 14%) }
            box { from: mbx, mby + 52 * pu; size: 410 * pu, 36 * pu; corner: 12 * pu; color: ink; opacity: 3% }
            box { from: mbx, mby + 52 * pu; size: 410 * pu, 36 * pu; corner: 12 * pu; stroke: 1 * pu; color: mix(ink, mint, if(bdrop_tray, 1, 0)); opacity: if(bdrag >= 0 and bdrop_tray, 60%, 10%) }
            group { scale: rs; pivot: floor(mbx + 205 * pu + 0.5), floor(mby + 70 * pu + 0.5); text "Hidden: drag a piece here to take it off the bar" { at: floor(mbx + 205 * pu + 0.5), floor(mby + 70 * pu + 0.5); anchor: center; align: center; size: 15; width: (400 * pu) / rs; lines: 1; color: faint; opacity: if(btray_n < 1 and not bdrop_tray, 70%, 0%); family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 296 * pu + 0.5); text "Drag to move. The window title stretches and holds the media buttons." { at: floor(spx + 14 * pu + 0.5), floor(sby + 296 * pu + 0.5); anchor: left center; size: 14; width: (410 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }

            //  The drag is followed by a zone that stays still, under the chips: a drag reaches every zone that was
            //  under the press, and one that moves itself (a chip following the pointer) loses it at the first jump.
            zone box blay_area { from: mbx - 8 * pu, mby - 8 * pu; size: 426 * pu, 104 * pu; active: bar_fm < 0.5 }     // the small bar and the tray, not Reset
            on scroll blay_area { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
            on drag blay_area { bdx = ((pointer.x - tx.pnl) - mbx) / pu; bdy = ((pointer.y - ty.set) - mby) / pu; emit bar_lay_drag }
            //  The chips' zones, apart from their drawing: pressing one takes it.
            repeat i in 0..9 {
                let zx = mbx + if(bdrag == i, bdx - bgx, bcx.$i) * pu
                let zy = mby + if(bdrag == i, bdy - bgy, bcy.$i) * pu
                zone box bchip.$i { from: zx, zy; size: bcw.$i * pu, 28 * pu; corner: 9 * pu; cursor: if(bchip.$i.pressed > 0.5, grabbing, grab); active: bar_fm < 0.5 and i != 2 }
                on press bchip.$i { bgx = ((pointer.x - tx.pnl) - zx) / pu; bgy = ((pointer.y - ty.set) - zy) / pu; bdx = ((pointer.x - tx.pnl) - mbx) / pu; bdy = ((pointer.y - ty.set) - mby) / pu; bdrag = i; emit bar_lay_grab }
                on release bchip.$i { emit bar_lay_drop }
            }
            repeat pass in 0..2 {
            repeat i in 0..9 {
                let dragging = bdrag == i
              group {
                show: i != 2 and ((pass == 0 and not dragging) or (pass == 1 and dragging))
                let chx = mbx + if(dragging, bdx - bgx, bcx.$i) * pu     // the chip's top-left and size
                let chy = mby + if(dragging, bdy - bgy, bcy.$i) * pu
                let chw = bcw.$i * pu
                let chh = 28 * pu
                let ccx = chx + chw / 2
                let ccy = chy + chh / 2
                let lit = if(dragging, 1, 0)
                let ink2 = mix(ink, mint, lit)
                box { from: chx, chy; size: chw, chh; corner: 9 * pu; color: mix(ink, mint, lit); opacity: if(lit > 0, 24%, 8%) }
                box { from: chx, chy; size: chw, chh; corner: 9 * pu; stroke: 1.5 * pu; color: mint; opacity: 100% * lit }
                //  What each one is, drawn small, as it is on the bar.
                group {
                    show: i == 0
                    box { at: ccx - 13 * pu, ccy; size: 3.5 * pu, 3.5 * pu; corner: 1.75 * pu; color: ink2; opacity: 60% }
                    box { at: ccx - 3 * pu, ccy; size: 10 * pu, 3.5 * pu; corner: 1.75 * pu; color: mix(mint, ink2, 0) }
                    box { at: ccx + 7 * pu, ccy; size: 3.5 * pu, 3.5 * pu; corner: 1.75 * pu; color: ink2; opacity: 60% }
                    box { at: ccx + 14 * pu, ccy; size: 3.5 * pu, 3.5 * pu; corner: 1.75 * pu; color: ink2; opacity: 60% }
                }
                group { scale: rs; pivot: floor(ccx + 0.5), floor(ccy + 0.5); text "Window title" { at: floor(ccx + 0.5), floor(ccy + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (max(10 * pu, chw - 12 * pu)) / rs; lines: 1; color: ink2; opacity: 85%; show: i == 1; family: "Space Grotesk" } }
                group {
                    show: i == 2
                    path { at: ccx - 12 * pu, ccy; color: ink2; move 2.5 * pu, -3 * pu; line -2 * pu, 0; line 2.5 * pu, 3 * pu; close }
                    path { at: ccx, ccy; color: ink2; move -2.5 * pu, -3.5 * pu; line 6 * pu, 0; line -2.5 * pu, 3.5 * pu; close }
                    path { at: ccx + 12 * pu, ccy; color: ink2; move -2.5 * pu, -3 * pu; line 2 * pu, 0; line -2.5 * pu, 3 * pu; close }
                }
                group {
                    show: i == 3
                    ellipse { at: ccx, ccy; radius: 3.6 * pu; stroke: 1.7 * pu; color: ink2 }
                    repeat k in 0..8 {
                        group {
                            pivot: ccx, ccy
                            rotate: k * 45deg
                            box { at: ccx, ccy - 6 * pu; size: 2 * pu, 2.6 * pu; corner: 0.7 * pu; color: ink2 }
                        }
                    }
                }
                group {
                    show: i == 4
                    ellipse { at: ccx - 1.2 * pu, ccy - 1.2 * pu; radius: 4 * pu; stroke: 1.6 * pu; color: ink2 }
                    line { from: ccx + 1.8 * pu, ccy + 1.8 * pu; to: ccx + 5 * pu, ccy + 5 * pu; width: 1.8 * pu; color: ink2 }
                }
                group {
                    show: i == 5
                    box { at: ccx, ccy - 3.5 * pu; size: 13 * pu, 1.5 * pu; corner: 0.75 * pu; color: ink2 }
                    box { at: ccx, ccy + 3.5 * pu; size: 13 * pu, 1.5 * pu; corner: 0.75 * pu; color: ink2 }
                    ellipse { at: ccx + 2.5 * pu, ccy - 3.5 * pu; radius: 2.4 * pu; color: ink2 }
                    ellipse { at: ccx - 2.5 * pu, ccy + 3.5 * pu; radius: 2.4 * pu; color: ink2 }
                }
                group {
                    show: i == 8
                    //  the add-ons: four small tiles, one of them the accent
                    box { at: ccx - 3.6 * pu, ccy - 3.6 * pu; size: 5.6 * pu, 5.6 * pu; corner: 1.8 * pu; color: ink2 }
                    box { at: ccx + 3.6 * pu, ccy - 3.6 * pu; size: 5.6 * pu, 5.6 * pu; corner: 1.8 * pu; color: ink2; opacity: 60% }
                    box { at: ccx - 3.6 * pu, ccy + 3.6 * pu; size: 5.6 * pu, 5.6 * pu; corner: 1.8 * pu; color: ink2; opacity: 60% }
                    box { at: ccx + 3.6 * pu, ccy + 3.6 * pu; size: 5.6 * pu, 5.6 * pu; corner: 1.8 * pu; color: mix(mint, ink2, lit) }
                }
                group {
                    show: i == 7
                    ellipse { at: ccx - 9 * pu, ccy; radius: 3 * pu; color: ink2 }
                    ellipse { at: ccx, ccy; radius: 3 * pu; color: ink2 }
                    ellipse { at: ccx + 9 * pu, ccy; radius: 3 * pu; color: ink2 }
                }
                group { scale: rs; pivot: floor(ccx + 0.5), floor(ccy + 0.5); text "4:20" { at: floor(ccx + 0.5), floor(ccy + 0.5); anchor: center; align: center; size: 19.5; weight: 700; width: (chw) / rs; lines: 1; color: mix(mint, ink, 0.25); show: i == 6; family: "Space Grotesk" } }
              }
            }
            }
            }
            //  The Frame's layout is fixed: its pieces are where the strip puts them, so there is nothing to drag. Say so, over the faded editor.
            group {
                opacity: clamp(bar_fm, 0, 1)
                show: bar_fm > 0.01
                group { scale: rs; pivot: floor(spx + 219 * pu + 0.5), floor(sby + 224 * pu + 0.5); text "The Frame layout cannot be adjusted" { at: floor(spx + 219 * pu + 0.5), floor(sby + 224 * pu + 0.5); anchor: center; align: center; size: 18; weight: 700; width: (420 * pu) / rs; lines: 1; color: ink; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(spx + 219 * pu + 0.5), floor(sby + 246 * pu + 0.5); text "Its pieces have fixed places. Switch to Island to rearrange the bar." { at: floor(spx + 219 * pu + 0.5), floor(sby + 246 * pu + 0.5); anchor: center; align: center; size: 15; width: (420 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            }

            //  ── How the workspace marks look: a card each, with the marks drawn small (one of four in view, one with a window), as they are on the bar ──
            let bwc = sby + 640 * pu
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, bwc; size: 438 * pu, 96 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, bwc; size: 438 * pu, 96 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(bwc - 38 * pu + 0.5); text "WORKSPACES" { at: floor(spx + 14 * pu + 0.5), floor(bwc - 38 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            repeat w in 0..4 {
                let bwx = spx + (62 + w * 104) * pu
                let bwy = bwc + 9 * pu
                let bwlit = if(ws_style == w, 1, 0)
                let bwk = mix(ink, mint, bwlit)
                box { at: bwx, bwy; size: 96 * pu, 64 * pu; corner: 12 * pu; color: if(bwlit > 0, mint, ink); opacity: if(bwlit > 0, 24%, 6% + 10% * bar_ws_hit.$w.hover) }
                box { at: bwx, bwy; size: 96 * pu, 64 * pu; corner: 12 * pu; stroke: 1.5 * pu; color: mint; opacity: bwlit * 100% }
                //  The marks: the second is the one in view, the third has a window.
                group {
                    show: w == 0
                    box { at: bwx - 30 * pu, bwy - 12 * pu; size: 7 * pu, 7 * pu; corner: 2.1 * pu; color: bwk; opacity: 45% }
                    box { at: bwx - 10 * pu, bwy - 12 * pu; size: 18 * pu, 12 * pu; corner: 3.6 * pu; color: mint }
                    box { at: bwx + 10 * pu, bwy - 12 * pu; size: 7 * pu, 10.5 * pu; corner: 2.1 * pu; color: bwk; opacity: 80% }
                    box { at: bwx + 28 * pu, bwy - 12 * pu; size: 7 * pu, 7 * pu; corner: 2.1 * pu; color: bwk; opacity: 45% }
                }
                group {
                    show: w == 1
                    box { at: bwx - 30 * pu, bwy - 12 * pu; size: 7 * pu, 7 * pu; corner: 3.5 * pu; color: bwk; opacity: 45% }
                    box { at: bwx - 10 * pu, bwy - 12 * pu; size: 18 * pu, 7 * pu; corner: 3.5 * pu; color: mint }
                    box { at: bwx + 10 * pu, bwy - 12 * pu; size: 7 * pu, 7 * pu; corner: 3.5 * pu; color: bwk; opacity: 80% }
                    box { at: bwx + 28 * pu, bwy - 12 * pu; size: 7 * pu, 7 * pu; corner: 3.5 * pu; color: bwk; opacity: 45% }
                }
                group {
                    show: w == 2
                    box { at: bwx - 10 * pu, bwy - 12 * pu; size: 22 * pu, 16 * pu; corner: 6 * pu; color: mint; opacity: 30% }
                    group { scale: rs; pivot: floor(bwx - 30 * pu + 0.5), floor(bwy - 12 * pu + 0.5); text "1" { at: floor(bwx - 30 * pu + 0.5), floor(bwy - 12 * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; color: bwk; opacity: 50%; family: "Space Grotesk" } }
                    group { scale: rs; pivot: floor(bwx - 10 * pu + 0.5), floor(bwy - 12 * pu + 0.5); text "2" { at: floor(bwx - 10 * pu + 0.5), floor(bwy - 12 * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; color: mint; family: "Space Grotesk" } }
                    group { scale: rs; pivot: floor(bwx + 10 * pu + 0.5), floor(bwy - 12 * pu + 0.5); text "3" { at: floor(bwx + 10 * pu + 0.5), floor(bwy - 12 * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; color: bwk; opacity: 85%; family: "Space Grotesk" } }
                    group { scale: rs; pivot: floor(bwx + 28 * pu + 0.5), floor(bwy - 12 * pu + 0.5); text "4" { at: floor(bwx + 28 * pu + 0.5), floor(bwy - 12 * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; color: bwk; opacity: 50%; family: "Space Grotesk" } }
                }
                group {
                    show: w == 3
                    box { at: bwx - 30 * pu, bwy - 12 * pu; size: 8 * pu, 3 * pu; corner: 1.5 * pu; color: bwk; opacity: 45% }
                    box { at: bwx - 10 * pu, bwy - 12 * pu; size: 20 * pu, 4 * pu; corner: 2 * pu; color: mint }
                    box { at: bwx + 10 * pu, bwy - 12 * pu; size: 8 * pu, 3 * pu; corner: 1.5 * pu; color: bwk; opacity: 80% }
                    box { at: bwx + 28 * pu, bwy - 12 * pu; size: 8 * pu, 3 * pu; corner: 1.5 * pu; color: bwk; opacity: 45% }
                }
                group { scale: rs; pivot: floor(bwx + 0.5), floor(bwy + 13 * pu + 0.5); text pick(w, "Squares", "Dots", "Numbers", "Lines") { at: floor(bwx + 0.5), floor(bwy + 13 * pu + 0.5); anchor: center; align: center; size: 16.5; weight: 700; width: (90 * pu) / rs; lines: 1; color: mix(ink, mint, bwlit); family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(bwx + 0.5), floor(bwy + 26 * pu + 0.5); text pick(w, "glass, the default", "small and light", "the workspace's own", "thin strokes") { at: floor(bwx + 0.5), floor(bwy + 26 * pu + 0.5); anchor: center; align: center; size: 13.5; width: (92 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                zone box bar_ws_hit.$w { at: bwx, bwy; size: 96 * pu, 64 * pu; corner: 12 * pu; cursor: pointer; active: bwy - br.off > sby and bwy - br.off < sby + set.h * pu; label: pick(w, "Glass squares", "Dots", "Numbers", "Lines") }
                on scroll bar_ws_hit.$w { br_scroll_to = clamp(br_scroll_to - wheel * 44, 0, max(0, br.h - set.h)) }
                on press bar_ws_hit.$w { emit bar_pick_ws(w) }
            }
            }
            let br.thh = set.h * set.h / max(set.h, br.h)
            let br.thy = br.thh / 2 + br.sc / max(1, br.h - set.h) * (set.h - br.thh)
            box { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: if(br.h > set.h, 6%, 0%) }
            box { at: spx + 442 * pu, sby + br.thy * pu; size: 3 * pu, br.thh * pu; corner: 1.5 * pu; color: mint; opacity: if(br.h > set.h, 55%, 0%) }
            let br.cue = clamp((br.h - set.h - br.sc) / 24, 0, 1)
            let br.cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let bfk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * bfk * bfk * br.cue }
            }
            box { at: spx + 224 * pu, br.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * br.cue }
            box { at: spx + 224 * pu, br.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * br_cue_hit.hover) * br.cue }
            path { at: spx + 204 * pu, br.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: br.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, br.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: br.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            group { scale: rs; pivot: floor(spx + 232 * pu + 0.5), floor(br.cuey + 0.5); text "More" { at: floor(spx + 232 * pu + 0.5), floor(br.cuey + 0.5); anchor: center; size: 16.5; weight: 700; color: ink; opacity: br.cue; family: "Space Grotesk" } }
            zone box br_cue_hit { at: spx + 224 * pu, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: br.cue > 0.5; label: "More" }
            on press br_cue_hit { br_scroll_to = clamp(br_scroll_to + 342, 0, max(0, br.h - set.h)) }
            zone box br_bar_hit { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: br.h > set.h; label: "Scroll the Bar page" }
            on press br_bar_hit { br_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - br.thh / 2) / max(1, set.h - br.thh) * (br.h - set.h), 0, max(0, br.h - set.h)) }
            on drag br_bar_hit { br_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - br.thh / 2) / max(1, set.h - br.thh) * (br.h - set.h), 0, max(0, br.h - set.h)) }
        }
}
