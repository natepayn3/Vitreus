            measure ldr_loc4
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 498 * pu + 0.5); text "Clock size" { at: floor(spx + 14 * pw + 0.5), floor(sby + 498 * pu + 0.5); measure: ldr_loc4; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
