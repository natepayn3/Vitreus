            ellipse { at: spx + 107.0 * pw, sby + 254 * pu; radius: 3.2 * pu; color: mint }
            box { at: spx + 219 * pw, sby + 254 * pu; size: 76 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_c2.hover }
            group { scale: rs; pivot: floor(spx + 221 * pw + 0.5), floor(sby + 254 * pu + 0.5); text "Neon" { at: floor(spx + 221 * pw + 0.5), floor(sby + 254 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (62 * pw) / rs; lines: 1; color: mix(ink, mint, lkc2); family: "Space Grotesk" } }
            zone box lk_c2 { at: spx + 219 * pw, sby + 254 * pu; size: 76 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 254 * pu) - lk.off > sby and (sby + 254 * pu) - lk.off < sby + set.h * pu }
