            box { at: spx + 394 * pw, sby + 317 * pu; size: 56 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_b2.hover }
            group { scale: rs; pivot: floor(spx + 394 * pw + 0.5), floor(sby + 317 * pu + 0.5); text "Heavy" { at: floor(spx + 394 * pw + 0.5), floor(sby + 317 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (52 * pw) / rs; lines: 1; color: mix(ink, mint, lkb2); family: "Space Grotesk" } }
            zone box lk_b2 { at: spx + 394 * pw, sby + 317 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 317 * pu) - lk.off > sby and (sby + 317 * pu) - lk.off < sby + set.h * pu }
            on press lk_b2 { emit lk_blur_set(2) }

            //  Card five: the clock. The AM/PM pill only means something on a 12 hour clock.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 450 * pu; size: 438 * pw, 148 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 450 * pu, 438 * pw, 148 * pu, 926.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
