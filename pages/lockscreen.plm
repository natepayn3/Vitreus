            zone box lk_t12 { at: spx + 319 * pw, sby + 402 * pu; size: 66 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 402 * pu) - lk.off > sby and (sby + 402 * pu) - lk.off < sby + set.h * pu }
            on press lk_t12 { emit lk_12h_set(1) }
            box { at: spx + 389 * pw, sby + 402 * pu; size: 66 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_t24.hover }
            group { scale: rs; pivot: floor(spx + 389 * pw + 0.5), floor(sby + 402 * pu + 0.5); text "24-hour" { at: floor(spx + 389 * pw + 0.5), floor(sby + 402 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (62 * pw) / rs; lines: 1; color: mix(ink, mint, lkt24); family: "Space Grotesk" } }
            zone box lk_t24 { at: spx + 389 * pw, sby + 402 * pu; size: 66 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 402 * pu) - lk.off > sby and (sby + 402 * pu) - lk.off < sby + set.h * pu }
            on press lk_t24 { emit lk_12h_set(0) }
            group {
                opacity: 40% + 60% * lkt12
                measure ldr_loc2
                group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 435 * pu + 0.5); text "AM/PM pill" { at: floor(spx + 14 * pw + 0.5), floor(sby + 435 * pu + 0.5); measure: ldr_loc2; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            }
            SettingsSwitch(spx + 424 * pw, sby + 435 * pu, lk_pill_am, lk_am_hit.pressed, lk_am_hit.hover, mint)
            PLeader(spx + 14 * pw + ldr_loc2.width * rs + 8 * pu, spx + 424 * pw - 40 * cu, sby + 435 * pu, lk_am_hit.hover, pu)
            zone box lk_am_hit { at: spx + 424 * pw - 19 * cu, sby + 435 * pu; size: 44 * cu, 28 * cu; cursor: pointer; active: (sby + 435 * pu) - lk.off > sby and (sby + 435 * pu) - lk.off < sby + set.h * pu; label: "AM/PM pill" }
