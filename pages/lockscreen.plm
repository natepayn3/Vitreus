            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 554 * pu + 0.5); text "Date style" { at: floor(spx + 14 * pw + 0.5), floor(sby + 554 * pu + 0.5); anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            SetPick(spx + 67 * pw, sby + 584 * pu, 102 * pw, 4, 24 * pu, lkd1 + 2 * lkd2 + 3 * lkd3, clamp(lk_d0.hover + lk_d1.hover + lk_d2.hover + lk_d3.hover, 0, 1), pu, 1, 0, 0, clamp(lkd0 + lkd1 + lkd2 + lkd3, 0, 1))
            box { at: spx + 67 * pw, sby + 584 * pu; size: 96 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_d0.hover }
            group { scale: rs; pivot: floor(spx + 67 * pw + 0.5), floor(sby + 584 * pu + 0.5); text "Long" { at: floor(spx + 67 * pw + 0.5), floor(sby + 584 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (92 * pw) / rs; lines: 1; color: mix(ink, mint, lkd0); family: "Space Grotesk" } }
            zone box lk_d0 { at: spx + 67 * pw, sby + 584 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 584 * pu) - lk.off > sby and (sby + 584 * pu) - lk.off < sby + set.h * pu }
            on press lk_d0 { emit lk_date_set(0) }
            box { at: spx + 169 * pw, sby + 584 * pu; size: 96 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_d1.hover }
            group { scale: rs; pivot: floor(spx + 169 * pw + 0.5), floor(sby + 584 * pu + 0.5); text "Standard" { at: floor(spx + 169 * pw + 0.5), floor(sby + 584 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (92 * pw) / rs; lines: 1; color: mix(ink, mint, lkd1); family: "Space Grotesk" } }
            zone box lk_d1 { at: spx + 169 * pw, sby + 584 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 584 * pu) - lk.off > sby and (sby + 584 * pu) - lk.off < sby + set.h * pu }
            on press lk_d1 { emit lk_date_set(1) }
            box { at: spx + 271 * pw, sby + 584 * pu; size: 96 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_d2.hover }
            group { scale: rs; pivot: floor(spx + 271 * pw + 0.5), floor(sby + 584 * pu + 0.5); text "Day first" { at: floor(spx + 271 * pw + 0.5), floor(sby + 584 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (92 * pw) / rs; lines: 1; color: mix(ink, mint, lkd2); family: "Space Grotesk" } }
            zone box lk_d2 { at: spx + 271 * pw, sby + 584 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 584 * pu) - lk.off > sby and (sby + 584 * pu) - lk.off < sby + set.h * pu }
            on press lk_d2 { emit lk_date_set(2) }
            box { at: spx + 373 * pw, sby + 584 * pu; size: 96 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_d3.hover }
            group { scale: rs; pivot: floor(spx + 373 * pw + 0.5), floor(sby + 584 * pu + 0.5); text "ISO 8601" { at: floor(spx + 373 * pw + 0.5), floor(sby + 584 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (92 * pw) / rs; lines: 1; color: mix(ink, mint, lkd3); family: "Space Grotesk" } }
            zone box lk_d3 { at: spx + 373 * pw, sby + 584 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 584 * pu) - lk.off > sby and (sby + 584 * pu) - lk.off < sby + set.h * pu }
            on press lk_d3 { emit lk_date_set(3) }

            //  Card seven: the player under the password bar.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 647 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 647 * pu, 438 * pw, 58 * pu, 433.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 647 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 647 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 647 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            measure ldr_locb2
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 639 * pu + 0.5); text "Media player" { at: floor(spx + 14 * pw + 0.5), floor(sby + 639 * pu + 0.5); measure: ldr_locb2; anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            measure ldh_locb2
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 656 * pu + 0.5); text "What is playing, under the password bar" { at: floor(spx + 14 * pw + 0.5), floor(sby + 656 * pu + 0.5); measure: ldh_locb2; anchor: left center; size: 15; color: faint; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pw, sby + 647 * pu, lk_pill_md, lk_md_hit.pressed, lk_md_hit.hover, mint)
            PLeader(spx + 14 * pw + max(ldr_locb2.width, ldh_locb2.width) * rs + 8 * pu, spx + 424 * pw - 40 * cu, sby + 647 * pu, lk_md_hit.hover, pu)
            zone box lk_md_hit { at: spx + 424 * pw - 19 * cu, sby + 647 * pu; size: 44 * cu, 28 * cu; cursor: pointer; active: (sby + 647 * pu) - lk.off > sby and (sby + 647 * pu) - lk.off < sby + set.h * pu; label: "Media player" }
            on press lk_md_hit { emit lk_media_toggle }

            //  Card eight: the power buttons. Each is held for a second on the lock screen.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 713 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 713 * pu, 438 * pw, 58 * pu, 510.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 713 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 713 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 713 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            measure ldr_locb3
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 705 * pu + 0.5); text "Power buttons" { at: floor(spx + 14 * pw + 0.5), floor(sby + 705 * pu + 0.5); measure: ldr_locb3; anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            measure ldh_locb3
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 722 * pu + 0.5); text "Sleep, restart and power off, at the bottom of the screen" { at: floor(spx + 14 * pw + 0.5), floor(sby + 722 * pu + 0.5); measure: ldh_locb3; anchor: left center; size: 15; color: faint; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pw, sby + 713 * pu, lk_pill_pw, lk_pw_hit.pressed, lk_pw_hit.hover, mint)
            PLeader(spx + 14 * pw + max(ldr_locb3.width, ldh_locb3.width) * rs + 8 * pu, spx + 424 * pw - 40 * cu, sby + 713 * pu, lk_pw_hit.hover, pu)
            zone box lk_pw_hit { at: spx + 424 * pw - 19 * cu, sby + 713 * pu; size: 44 * cu, 28 * cu; cursor: pointer; active: (sby + 713 * pu) - lk.off > sby and (sby + 713 * pu) - lk.off < sby + set.h * pu; label: "Power buttons" }
            on press lk_pw_hit { emit lk_power_toggle }

            //  Card nine: which monitor has the clock and the password bar. The others keep the wallpaper.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 799 * pu; size: 438 * pw, 98 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 799 * pu, 438 * pw, 98 * pu, 587.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 799 * pu; size: 438 * pw, 98 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 799 * pu; size: 438 * pw, 98 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 799 * pu; size: 438 * pw, 98 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 772 * pu + 0.5); text "Show on" { at: floor(spx + 14 * pw + 0.5), floor(sby + 772 * pu + 0.5); anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 791 * pu + 0.5); text "The clock and password bar go on one monitor; the rest show the wallpaper" { at: floor(spx + 14 * pw + 0.5), floor(sby + 791 * pu + 0.5); anchor: left center; size: 15; width: (410 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            let lkya = sby + 821 * pu
            let lkm_n = (1 + (if(lk_m.0.on, 1, 0) + if(lk_m.1.on, 1, 0) + if(lk_m.2.on, 1, 0) + if(lk_m.3.on, 1, 0)))          // how many choices there are: the row is laid out from the card's right edge, as every picker is
            zone box lk_mn_sl { at: spx + (424 - lkm_n * 82 / 2) * pw, lkya; size: lkm_n * 82 * pw, 24 * pu }
            SetPick(spx + (424 - (lkm_n - 0.5) * 82) * pw, lkya, 82 * pw, 1 + (if(lk_m.0.on, 1, 0) + if(lk_m.1.on, 1, 0) + if(lk_m.2.on, 1, 0) + if(lk_m.3.on, 1, 0)), 24 * pu, lk_mon, lk_mn_sl.hover, pu)
            box { at: spx + (424 - (lkm_n - 0.5) * 82) * pw, lkya; size: 76 * pw, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_mn_all.hover }
            group { scale: rs; pivot: floor(spx + (424 - (lkm_n - 0.5) * 82) * pw + 0.5), floor(lkya + 0.5); text "All" { at: floor(spx + (424 - (lkm_n - 0.5) * 82) * pw + 0.5), floor(lkya + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (70 * pw) / rs; lines: 1; color: if(lk_mon == 0, mint, ink); family: "Space Grotesk" } }
            zone box lk_mn_all { at: spx + (424 - (lkm_n - 0.5) * 82) * pw, lkya; size: 82 * pw, 24 * pu; corner: 8 * pu; cursor: pointer; active: lkya - lk.off > sby and lkya - lk.off < sby + set.h * pu }
            on press lk_mn_all { emit lk_mon_set(0) }
            repeat k in 0..4 {
                let lkx = spx + (424 - (lkm_n - 0.5) * 82 + (k + 1) * 82) * pw
                box { at: lkx, lkya; size: 76 * pw, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_mn.$k.hover }
                group { scale: rs; pivot: floor(lkx + 0.5), floor(lkya + 0.5); text lk_m.$k.name { at: floor(lkx + 0.5), floor(lkya + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (70 * pw) / rs; lines: 1; color: if(lk_mon == k + 1, mint, ink); show: lk_m.$k.on; family: "Space Grotesk" } }
                zone box lk_mn.$k { at: lkx, lkya; size: 82 * pw, 24 * pu; corner: 8 * pu; cursor: pointer; active: (lk_m.$k.on) and lkya - lk.off > sby and lkya - lk.off < sby + set.h * pu }
                on press lk_mn.$k { emit lk_mon_set(k + 1) }
            }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 865 * pu + 0.5); text "The lock screen is not running: start it to change these" { at: floor(spx + 14 * pw + 0.5), floor(sby + 865 * pu + 0.5); anchor: left center; size: 15; width: (400 * pw) / rs; lines: 1; color: #ef4444; family: "Space Grotesk"; show: not lk_ok } }
            }

            let lk.thh = set.h * set.h / max(set.h, lk.h)
            let lk.thy = lk.thh / 2 + lk.sc / max(1, lk.h - set.h) * (set.h - lk.thh)
            box { at: spx + 442 * pw, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: if(lk.h > set.h, 6%, 0%) }
            box { at: spx + 442 * pw, sby + lk.thy * pu; size: 3 * pu, lk.thh * pu; corner: 1.5 * pu; color: mint; opacity: if(lk.h > set.h, 55%, 0%) }
            let lk.cue = clamp((lk.h - set.h - lk.sc) / 24, 0, 1)
            let lk.cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pw, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pw, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * lk.cue }
            }
            box { at: spx + 224 * pw, lk.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * lk.cue }
            box { at: spx + 224 * pw, lk.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * lk_cue_hit.hover) * lk.cue }
            path { at: spx + 204 * pw, lk.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: lk.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pw, lk.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: lk.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            group { scale: rs; pivot: floor(spx + 232 * pw + 0.5), floor(lk.cuey + 0.5); text "More" { at: floor(spx + 232 * pw + 0.5), floor(lk.cuey + 0.5); anchor: center; size: 16.5; weight: 700; color: ink; opacity: lk.cue; family: "Space Grotesk" } }
            zone box lk_cue_hit { at: spx + 224 * pw, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: lk.cue > 0.5 }
            on press lk_cue_hit { lk_scroll_to = clamp(lk_scroll_to + 342, 0, max(0, lk.h - set.h)) }
            zone box lk_bar_hit { at: spx + 442 * pw, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: lk.h > set.h }
            on press lk_bar_hit { lk_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - lk.thh / 2) / max(1, set.h - lk.thh) * (lk.h - set.h), 0, max(0, lk.h - set.h)) }
            on drag lk_bar_hit { lk_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - lk.thh / 2) / max(1, set.h - lk.thh) * (lk.h - set.h), 0, max(0, lk.h - set.h)) }
        }
}
