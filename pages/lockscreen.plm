            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 309 * pu + 0.5); text "Wallpaper blur" { at: floor(spx + 14 * pw + 0.5), floor(sby + 309 * pu + 0.5); measure: ldr_locb1; anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            measure ldh_locb1
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 326 * pu + 0.5); text "How soft the picture behind the lock is" { at: floor(spx + 14 * pw + 0.5), floor(sby + 326 * pu + 0.5); measure: ldh_locb1; anchor: left center; size: 15; color: faint; family: "Space Grotesk" } }
            SetPick(spx + 274 * pw, sby + 317 * pu, 60 * pw, 3, 24 * pu, lkb1 + 2 * lkb2, clamp(lk_b0.hover + lk_b1.hover + lk_b2.hover, 0, 1), pu, 1, 0, 0, clamp(lkb0 + lkb1 + lkb2, 0, 1))
            PLeader(spx + 14 * pw + max(ldr_locb1.width, ldh_locb1.width) * rs + 8 * pu, spx + 274 * pw - 60 * pw / 2 - 6 * pu, sby + 317 * pu, clamp(lk_b0.hover + lk_b1.hover + lk_b2.hover, 0, 1), pu)
            box { at: spx + 274 * pw, sby + 317 * pu; size: 56 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_b0.hover }
            group { scale: rs; pivot: floor(spx + 274 * pw + 0.5), floor(sby + 317 * pu + 0.5); text "Light" { at: floor(spx + 274 * pw + 0.5), floor(sby + 317 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (52 * pw) / rs; lines: 1; color: mix(ink, mint, lkb0); family: "Space Grotesk" } }
