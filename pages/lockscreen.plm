            group { scale: rs; pivot: floor(spx + 139 * pw + 0.5), floor(sby + 254 * pu + 0.5); text "Accent" { at: floor(spx + 139 * pw + 0.5), floor(sby + 254 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (62 * pw) / rs; lines: 1; color: mix(ink, mint, lkc1); family: "Space Grotesk" } }
