part LockScreen {
        group {
            show: set_pgl > 0.01
            opacity: set_pgl
            let lk.sc = clamp(lk_scroll, 0, max(0, lk.h - set.h))
            let lk.off = floor(lk.sc * pu + 0.5)        // whole pixels: text that is shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pw, sby + set.h / 2 * pu; size: 456 * pw, set.h * pu }
            zone box lk_wheel { at: spx + 219 * pw, sby + set.h / 2 * pu; size: 446 * pw, set.h * pu }
            on scroll lk_wheel { lk_scroll_to = clamp(lk_scroll_to - wheel * 44, 0, max(0, lk.h - set.h)) }
            group {
            move: 0, -lk.off
            let lkb0 = if(lk_blur < 27, 1, 0)
            let lkb1 = if(lk_blur >= 27 and lk_blur < 48, 1, 0)
            let lkb2 = if(lk_blur >= 48, 1, 0)
            let lkt12 = if(lk_12h, 1, 0)
            let lkt24 = 1 - lkt12
            let lkd0 = if(lk_date == lkd_long, 1, 0)
            let lkd1 = if(lk_date == lkd_std, 1, 0)
            let lkd2 = if(lk_date == lkd_day, 1, 0)
            let lkd3 = if(lk_date == lkd_iso, 1, 0)
            let lkm0 = if(lk_mask == lkm_shapes, 1, 0)
            let lkm1 = if(lk_mask == lkm_dots, 1, 0)
            let lkm2 = if(lk_mask == lkm_stars, 1, 0)
            let lkm3 = if(lk_mask == lkm_special, 1, 0)
            let lksz0 = if(lk_px < 125, 1, 0)
            let lksz1 = if(lk_px >= 125 and lk_px < 175, 1, 0)
            let lksz2 = if(lk_px >= 175, 1, 0)
            let lkc0 = if(lk_pal == lkc_vibrant, 1, 0)
            let lkc1 = if(lk_pal == lkc_accent, 1, 0)
            let lkc2 = if(lk_pal == lkc_neon, 1, 0)
            let lkc3 = if(lk_pal == lkc_pastel, 1, 0)
            let lkc4 = if(lk_pal == lkc_mono, 1, 0)

            //  Card one: the example bar. Type into it; Enter pretends the password was right.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 54 * pu; size: 438 * pw, 108 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 54 * pu, 438 * pw, 108 * pu, 733.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 54 * pu; size: 438 * pw, 108 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 54 * pu; size: 438 * pw, 108 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 54 * pu; size: 438 * pw, 108 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 22 * pu + 0.5); text "Example bar" { at: floor(spx + 14 * pw + 0.5), floor(sby + 22 * pu + 0.5); anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            //  Test lock: locks now, in the lock screen's safe mode, so Esc on an empty bar (or a minute) opens it. It is only a test of one lock.
            box { at: spx + 388 * pw, sby + 27 * pu; size: 90 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: mint; opacity: 16% + 16% * lk_test_hit.hover }
            PPillOutline(spx + 388 * pw, sby + 27 * pu, 90 * pu, 26 * pu, 13 * pu, lk_test_hit.hover, clamp(3 * (16% + 16% * lk_test_hit.hover), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 388 * pw + 0.5), floor(sby + 27 * pu + 0.5); text "Test lock" { at: floor(spx + 388 * pw + 0.5), floor(sby + 27 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (84 * pw) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
            zone box lk_test_hit { at: spx + 388 * pw, sby + 27 * pu; size: 90 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (sby + 27 * pu) - lk.off > sby and (sby + 27 * pu) - lk.off < sby + set.h * pu }
            on press lk_test_hit { emit lk_test }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 41 * pu + 0.5); text "Type to see your glyphs. Enter pretends to unlock." { at: floor(spx + 14 * pw + 0.5), floor(sby + 41 * pu + 0.5); anchor: left center; size: 15; width: (260 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            box { at: spx + 219 * pw, sby + 75 * pu; size: 410 * pw, 38 * pu; corner: 19 * pu; color: ink; opacity: 8% }
            box { at: spx + 219 * pw, sby + 75 * pu; size: 410 * pw, 38 * pu; corner: 19 * pu; stroke: 1.2 * pu; color: mix(mint, #10b981, lb_okt); opacity: 40% }
            group { scale: rs; pivot: floor(spx + 36 * pw + 0.5), floor(sby + 75 * pu + 0.5); text "Type to try the bar…" { at: floor(spx + 36 * pw + 0.5), floor(sby + 75 * pu + 0.5); anchor: left center; size: 18; color: faint; opacity: 70%; family: "Space Grotesk"; show: lb.count < 1 } }
            //  Only while the bar is in the window: a field above the window would be over the bar.
            group {
                show: lk.off < 104 * pu
                input lb_pw { at: spx + 30 * pw, sby + 66 * pu; width: 380 * pu; size: 19; color: ink; opacity: 0; secret: true; family: "Space Grotesk" }
                on submit lb_pw { emit lb_submit }
            }
            group {
                clip box { from: spx + 26 * pw, sby + 59 * pu; size: 386 * pw, 32 * pu }
                row lb_row {
                    at: spx + 30 * pw - max(0, lb_row.width - 378 * pu), sby + 62 * pu
                    gap: 8 * pu
                    for s in lb {
                        group {
                            size: 26 * pu, 26 * pu
                            let gc5 = mod(s.ci, 5)
                            let gc4 = mod(s.ci, 4)
                            let gv = mix(mix(mix(mix(#00f0ff, #7000ff, if(gc5 == 1, 1, 0)), #ff0055, if(gc5 == 2, 1, 0)), #00ff66, if(gc5 == 3, 1, 0)), #ffcc00, if(gc5 == 4, 1, 0))
                            let gn = mix(mix(mix(#ff0055, #00ffff, if(gc4 == 1, 1, 0)), #ffff00, if(gc4 == 2, 1, 0)), #ff00ff, if(gc4 == 3, 1, 0))
                            let gp = mix(mix(mix(#c4b5fd, #93c5fd, if(gc4 == 1, 1, 0)), #fbcfe8, if(gc4 == 2, 1, 0)), #fed7aa, if(gc4 == 3, 1, 0))
                            let gcol = mix(mix(mix(mix(gv, mint, if(lk_pal == lkc_accent, 1, 0)), gn, if(lk_pal == lkc_neon, 1, 0)), gp, if(lk_pal == lkc_pastel, 1, 0)), #ffffff, if(lk_pal == lkc_mono, 1, 0))
                            let tint = mix(gcol, #10b981, lb_okt)
                                figure lkshp.s0 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 0 and not s.outline }
                                figure lkshp.s0 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 0 and s.outline }
                                figure lkshp.s1 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 1 and not s.outline }
                                figure lkshp.s1 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 1 and s.outline }
                                figure lkshp.s2 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 2 and not s.outline }
                                figure lkshp.s2 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 2 and s.outline }
                                figure lkshp.s3 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 3 and not s.outline }
                                figure lkshp.s3 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 3 and s.outline }
                                figure lkshp.s4 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 4 and not s.outline }
                                figure lkshp.s4 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 4 and s.outline }
                                figure lkshp.s5 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 5 and not s.outline }
                                figure lkshp.s5 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 5 and s.outline }
                                figure lkshp.s6 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 6 and not s.outline }
                                figure lkshp.s6 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 6 and s.outline }
                                figure lkshp.s7 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 7 and not s.outline }
                                figure lkshp.s7 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 7 and s.outline }
                                figure lkshp.s8 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 8 and not s.outline }
                                figure lkshp.s8 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 8 and s.outline }
                                figure lkshp.s9 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 9 and not s.outline }
                                figure lkshp.s9 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 9 and s.outline }
                                figure lkshp.s10 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 10 and not s.outline }
                                figure lkshp.s10 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 10 and s.outline }
                                figure lkshp.s11 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 11 and not s.outline }
                                figure lkshp.s11 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 11 and s.outline }
                                figure lkshp.s12 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 12 and not s.outline }
                                figure lkshp.s12 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 12 and s.outline }
                                figure lkshp.s13 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 13 and not s.outline }
                                figure lkshp.s13 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 13 and s.outline }
                                figure lkshp.s14 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 14 and not s.outline }
                                figure lkshp.s14 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 14 and s.outline }
                                figure lkshp.s15 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 15 and not s.outline }
                                figure lkshp.s15 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 15 and s.outline }
                            ellipse { at: 13 * pu, 13 * pu; radius: 5.5 * pu; color: tint; show: lk_mask == lkm_dots and not s.outline }
                            ellipse { at: 13 * pu, 13 * pu; radius: 5 * pu; stroke: 2 * pu; color: tint; show: lk_mask == lkm_dots and s.outline }
                            group {
                                show: lk_mask == lkm_stars
                                line { from: 5 * pu, 13 * pu; to: 21 * pu, 13 * pu; width: 2.4 * pu; color: tint }
                                line { from: 9 * pu, 6.07 * pu; to: 17 * pu, 19.93 * pu; width: 2.4 * pu; color: tint }
                                line { from: 17 * pu, 6.07 * pu; to: 9 * pu, 19.93 * pu; width: 2.4 * pu; color: tint }
                            }
                            group { scale: rs; pivot: 13 * pu, 13 * pu; text s.sym { at: 13 * pu, 13 * pu; anchor: center; align: center; size: 30; weight: 700; color: tint; family: "Space Grotesk"; show: lk_mask == lkm_special } }
                        }
                    }
                }
            }

            //  Card two: what a typed character becomes.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 155 * pu; size: 438 * pw, 78 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 155 * pu, 438 * pw, 78 * pu, 317.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 155 * pu; size: 438 * pw, 78 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 155 * pu; size: 438 * pw, 78 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 155 * pu; size: 438 * pw, 78 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 138 * pu + 0.5); text "Mask style" { at: floor(spx + 14 * pw + 0.5), floor(sby + 138 * pu + 0.5); anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            SetPick(spx + 67 * pw, sby + 168 * pu, 102 * pw, 4, 24 * pu, lkm1 + 2 * lkm2 + 3 * lkm3, clamp(lk_m0.hover + lk_m1.hover + lk_m2.hover + lk_m3.hover, 0, 1), pu, 1, 0, 0, clamp(lkm0 + lkm1 + lkm2 + lkm3, 0, 1))
            box { at: spx + 67 * pw, sby + 168 * pu; size: 96 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_m0.hover }
            group { scale: rs; pivot: floor(spx + 67 * pw + 0.5), floor(sby + 168 * pu + 0.5); text "Shapes" { at: floor(spx + 67 * pw + 0.5), floor(sby + 168 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (92 * pw) / rs; lines: 1; color: mix(ink, mint, lkm0); family: "Space Grotesk" } }
            zone box lk_m0 { at: spx + 67 * pw, sby + 168 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 168 * pu) - lk.off > sby and (sby + 168 * pu) - lk.off < sby + set.h * pu }
            on press lk_m0 { emit lk_mask_set(0) }
            box { at: spx + 169 * pw, sby + 168 * pu; size: 96 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_m1.hover }
            group { scale: rs; pivot: floor(spx + 169 * pw + 0.5), floor(sby + 168 * pu + 0.5); text "Dots" { at: floor(spx + 169 * pw + 0.5), floor(sby + 168 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (92 * pw) / rs; lines: 1; color: mix(ink, mint, lkm1); family: "Space Grotesk" } }
            zone box lk_m1 { at: spx + 169 * pw, sby + 168 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 168 * pu) - lk.off > sby and (sby + 168 * pu) - lk.off < sby + set.h * pu }
            on press lk_m1 { emit lk_mask_set(1) }
            box { at: spx + 271 * pw, sby + 168 * pu; size: 96 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_m2.hover }
            group { scale: rs; pivot: floor(spx + 271 * pw + 0.5), floor(sby + 168 * pu + 0.5); text "Asterisks" { at: floor(spx + 271 * pw + 0.5), floor(sby + 168 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (92 * pw) / rs; lines: 1; color: mix(ink, mint, lkm2); family: "Space Grotesk" } }
            zone box lk_m2 { at: spx + 271 * pw, sby + 168 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 168 * pu) - lk.off > sby and (sby + 168 * pu) - lk.off < sby + set.h * pu }
            on press lk_m2 { emit lk_mask_set(2) }
            box { at: spx + 373 * pw, sby + 168 * pu; size: 96 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_m3.hover }
            group { scale: rs; pivot: floor(spx + 373 * pw + 0.5), floor(sby + 168 * pu + 0.5); text "Special" { at: floor(spx + 373 * pw + 0.5), floor(sby + 168 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (92 * pw) / rs; lines: 1; color: mix(ink, mint, lkm3); family: "Space Grotesk" } }
            zone box lk_m3 { at: spx + 373 * pw, sby + 168 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 168 * pu) - lk.off > sby and (sby + 168 * pu) - lk.off < sby + set.h * pu }
            on press lk_m3 { emit lk_mask_set(3) }

            //  Card three: the colours. Each character takes one of them at random.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 241 * pu; size: 438 * pw, 78 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 241 * pu, 438 * pw, 78 * pu, 506.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 241 * pu; size: 438 * pw, 78 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 241 * pu; size: 438 * pw, 78 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 241 * pu; size: 438 * pw, 78 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 224 * pu + 0.5); text "Colours" { at: floor(spx + 14 * pw + 0.5), floor(sby + 224 * pu + 0.5); anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            SetPick(spx + 55 * pw, sby + 254 * pu, 82 * pw, 5, 24 * pu, lkc1 + 2 * lkc2 + 3 * lkc3 + 4 * lkc4, clamp(lk_c0.hover + lk_c1.hover + lk_c2.hover + lk_c3.hover + lk_c4.hover, 0, 1), pu, 1, 0, 0, clamp(lkc0 + lkc1 + lkc2 + lkc3 + lkc4, 0, 1))
            box { at: spx + 55 * pw, sby + 254 * pu; size: 76 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_c0.hover }
            group { scale: rs; pivot: floor(spx + 57 * pw + 0.5), floor(sby + 254 * pu + 0.5); text "Vibrant" { at: floor(spx + 57 * pw + 0.5), floor(sby + 254 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (62 * pw) / rs; lines: 1; color: mix(ink, mint, lkc0); family: "Space Grotesk" } }
