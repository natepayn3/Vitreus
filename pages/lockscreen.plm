            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 465 * pu + 0.5); text "Show seconds" { at: floor(spx + 14 * pw + 0.5), floor(sby + 465 * pu + 0.5); measure: ldr_loc3; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pw, sby + 465 * pu, lk_pill_sec, lk_sec_hit.pressed, lk_sec_hit.hover, mint)
            PLeader(spx + 14 * pw + ldr_loc3.width * rs + 8 * pu, spx + 424 * pw - 40 * cu, sby + 465 * pu, lk_sec_hit.hover, pu)
            zone box lk_sec_hit { at: spx + 424 * pw - 19 * cu, sby + 465 * pu; size: 44 * cu, 28 * cu; cursor: pointer; active: (sby + 465 * pu) - lk.off > sby and (sby + 465 * pu) - lk.off < sby + set.h * pu; label: "Show seconds" }
