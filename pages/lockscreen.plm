            box { at: spx + 334 * pw, sby + 317 * pu; size: 56 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_b1.hover }
            group { scale: rs; pivot: floor(spx + 334 * pw + 0.5), floor(sby + 317 * pu + 0.5); text "Medium" { at: floor(spx + 334 * pw + 0.5), floor(sby + 317 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (52 * pw) / rs; lines: 1; color: mix(ink, mint, lkb1); family: "Space Grotesk" } }
            zone box lk_b1 { at: spx + 334 * pw, sby + 317 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 317 * pu) - lk.off > sby and (sby + 317 * pu) - lk.off < sby + set.h * pu }
