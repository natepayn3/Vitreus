part LockScreen {
        group {
            show: set_pgl > 0.01
            opacity: set_pgl
            let lk.sc = clamp(lk_scroll, 0, max(0, lk.h - set.h))
            let lk.off = floor(lk.sc * pu + 0.5)        // whole pixels: text that is shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pu, sby + set.h / 2 * pu; size: 456 * pu, set.h * pu }
            zone box lk_wheel { at: spx + 219 * pu, sby + set.h / 2 * pu; size: 446 * pu, set.h * pu }
            on scroll lk_wheel { lk_scroll_to = clamp(lk_scroll_to - wheel * 44, 0, max(0, lk.h - set.h)) }
            group {
            move: 0, -lk.off
            let lkb0 = if(lk_blur < 27, 1, 0)
            let lkb1 = if(lk_blur >= 27 and lk_blur < 48, 1, 0)
            let lkb2 = if(lk_blur >= 48, 1, 0)
            let lkt12 = if(lk_12h, 1, 0)
            let lkt24 = 1 - lkt12
            let lkd0 = if(lk_date == lkd_long, 1, 0)
            let lkd1 = if(lk_date == lkd_std, 1, 0)
            let lkd2 = if(lk_date == lkd_day, 1, 0)
            let lkd3 = if(lk_date == lkd_iso, 1, 0)
            let lkm0 = if(lk_mask == lkm_shapes, 1, 0)
            let lkm1 = if(lk_mask == lkm_dots, 1, 0)
            let lkm2 = if(lk_mask == lkm_stars, 1, 0)
            let lkm3 = if(lk_mask == lkm_special, 1, 0)
            let lksz0 = if(lk_px < 125, 1, 0)
            let lksz1 = if(lk_px >= 125 and lk_px < 175, 1, 0)
            let lksz2 = if(lk_px >= 175, 1, 0)
            let lkc0 = if(lk_pal == lkc_vibrant, 1, 0)
            let lkc1 = if(lk_pal == lkc_accent, 1, 0)
            let lkc2 = if(lk_pal == lkc_neon, 1, 0)
            let lkc3 = if(lk_pal == lkc_pastel, 1, 0)
            let lkc4 = if(lk_pal == lkc_mono, 1, 0)

            //  Card one: the example bar. Type into it; Enter pretends the password was right.
            box { at: spx + 219 * pu, sby + 48 * pu; size: 438 * pu, 96 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Example bar" { at: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            //  Test lock: locks now, in the lock screen's safe mode, so Esc on an empty bar (or a minute) opens it. It is only a test of one lock.
            box { at: spx + 388 * pu, sby + 18 * pu; size: 90 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: 16% + 16% * lk_test_hit.hover }
            text "Test lock" { at: floor(spx + 388 * pu + 0.5), floor(sby + 18 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 84 * pu; lines: 1; color: mint; family: "Space Grotesk" }
            zone box lk_test_hit { at: spx + 388 * pu, sby + 18 * pu; size: 90 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (sby + 18 * pu) - lk.off > sby and (sby + 18 * pu) - lk.off < sby + set.h * pu }
            on press lk_test_hit { emit lk_test }
            text "Type to see your glyphs. Enter pretends to unlock." { at: floor(spx + 14 * pu + 0.5), floor(sby + 35 * pu + 0.5); anchor: left center; size: 13.5; width: 260 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            box { at: spx + 219 * pu, sby + 68 * pu; size: 410 * pu, 38 * pu; corner: 19 * pu; color: ink; opacity: 8% }
            box { at: spx + 219 * pu, sby + 68 * pu; size: 410 * pu, 38 * pu; corner: 19 * pu; stroke: 1.2 * pu; color: mix(mint, #10b981, lb_okt); opacity: 40% }
            text "Type to try the bar…" { at: floor(spx + 36 * pu + 0.5), floor(sby + 68 * pu + 0.5); anchor: left center; size: 16; color: faint; opacity: 70%; family: "Space Grotesk"; show: lb.count < 1 }
            //  Only while the bar is in the window: a field above the window would be over the bar.
            group {
                show: lk.off < 96 * pu
                input lb_pw { at: spx + 30 * pu, sby + 59 * pu; width: 380 * pu; size: 19; color: ink; opacity: 0; secret: true; family: "Space Grotesk" }
                on submit lb_pw { emit lb_submit }
            }
            group {
                clip box { from: spx + 26 * pu, sby + 52 * pu; size: 386 * pu, 32 * pu }
                row lb_row {
                    at: spx + 30 * pu - max(0, lb_row.width - 378 * pu), sby + 55 * pu
                    gap: 8 * pu
                    for s in lb {
                        group {
                            size: 26 * pu, 26 * pu
                            let gc5 = mod(s.ci, 5)
                            let gc4 = mod(s.ci, 4)
                            let gv = mix(mix(mix(mix(#00f0ff, #7000ff, if(gc5 == 1, 1, 0)), #ff0055, if(gc5 == 2, 1, 0)), #00ff66, if(gc5 == 3, 1, 0)), #ffcc00, if(gc5 == 4, 1, 0))
                            let gn = mix(mix(mix(#ff0055, #00ffff, if(gc4 == 1, 1, 0)), #ffff00, if(gc4 == 2, 1, 0)), #ff00ff, if(gc4 == 3, 1, 0))
                            let gp = mix(mix(mix(#c4b5fd, #93c5fd, if(gc4 == 1, 1, 0)), #fbcfe8, if(gc4 == 2, 1, 0)), #fed7aa, if(gc4 == 3, 1, 0))
                            let gcol = mix(mix(mix(mix(gv, mint, if(lk_pal == lkc_accent, 1, 0)), gn, if(lk_pal == lkc_neon, 1, 0)), gp, if(lk_pal == lkc_pastel, 1, 0)), #ffffff, if(lk_pal == lkc_mono, 1, 0))
                            let tint = mix(gcol, #10b981, lb_okt)
                                figure lkshp.s0 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 0 and not s.outline }
                                figure lkshp.s0 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 0 and s.outline }
                                figure lkshp.s1 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 1 and not s.outline }
                                figure lkshp.s1 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 1 and s.outline }
                                figure lkshp.s2 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 2 and not s.outline }
                                figure lkshp.s2 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 2 and s.outline }
                                figure lkshp.s3 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 3 and not s.outline }
                                figure lkshp.s3 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 3 and s.outline }
                                figure lkshp.s4 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 4 and not s.outline }
                                figure lkshp.s4 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 4 and s.outline }
                                figure lkshp.s5 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 5 and not s.outline }
                                figure lkshp.s5 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 5 and s.outline }
                                figure lkshp.s6 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 6 and not s.outline }
                                figure lkshp.s6 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 6 and s.outline }
                                figure lkshp.s7 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 7 and not s.outline }
                                figure lkshp.s7 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 7 and s.outline }
                                figure lkshp.s8 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 8 and not s.outline }
                                figure lkshp.s8 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 8 and s.outline }
                                figure lkshp.s9 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 9 and not s.outline }
                                figure lkshp.s9 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 9 and s.outline }
                                figure lkshp.s10 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 10 and not s.outline }
                                figure lkshp.s10 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 10 and s.outline }
                                figure lkshp.s11 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 11 and not s.outline }
                                figure lkshp.s11 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 11 and s.outline }
                                figure lkshp.s12 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 12 and not s.outline }
                                figure lkshp.s12 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 12 and s.outline }
                                figure lkshp.s13 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 13 and not s.outline }
                                figure lkshp.s13 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 13 and s.outline }
                                figure lkshp.s14 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 14 and not s.outline }
                                figure lkshp.s14 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 14 and s.outline }
                                figure lkshp.s15 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; show: lk_mask == lkm_shapes and s.idx == 15 and not s.outline }
                                figure lkshp.s15 { at: 13 * pu, 13 * pu; size: 20 * pu, 20 * pu; rotate: s.rot * 1deg; color: tint; stroke: 2.5 * pu; show: lk_mask == lkm_shapes and s.idx == 15 and s.outline }
                            ellipse { at: 13 * pu, 13 * pu; radius: 5.5 * pu; color: tint; show: lk_mask == lkm_dots and not s.outline }
                            ellipse { at: 13 * pu, 13 * pu; radius: 5 * pu; stroke: 2 * pu; color: tint; show: lk_mask == lkm_dots and s.outline }
                            group {
                                show: lk_mask == lkm_stars
                                line { from: 5 * pu, 13 * pu; to: 21 * pu, 13 * pu; width: 2.4 * pu; color: tint }
                                line { from: 9 * pu, 6.07 * pu; to: 17 * pu, 19.93 * pu; width: 2.4 * pu; color: tint }
                                line { from: 17 * pu, 6.07 * pu; to: 9 * pu, 19.93 * pu; width: 2.4 * pu; color: tint }
                            }
                            text s.sym { at: 13 * pu, 13 * pu; anchor: center; align: center; size: 27; weight: 700; color: tint; family: "Space Grotesk"; show: lk_mask == lkm_special }
                        }
                    }
                }
            }

            //  Card two: what a typed character becomes.
            box { at: spx + 219 * pu, sby + 141 * pu; size: 438 * pu, 70 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Mask style" { at: floor(spx + 14 * pu + 0.5), floor(sby + 122 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: spx + 62 * pu, sby + 152 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkm0); opacity: 8% + 20% * lkm0 + 6% * lk_m0.hover }
            text "Shapes" { at: floor(spx + 62 * pu + 0.5), floor(sby + 152 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 92 * pu; lines: 1; color: mix(ink, mint, lkm0); family: "Space Grotesk" }
            zone box lk_m0 { at: spx + 62 * pu, sby + 152 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 152 * pu) - lk.off > sby and (sby + 152 * pu) - lk.off < sby + set.h * pu }
            on press lk_m0 { emit lk_mask_set(0) }
            box { at: spx + 164 * pu, sby + 152 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkm1); opacity: 8% + 20% * lkm1 + 6% * lk_m1.hover }
            text "Dots" { at: floor(spx + 164 * pu + 0.5), floor(sby + 152 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 92 * pu; lines: 1; color: mix(ink, mint, lkm1); family: "Space Grotesk" }
            zone box lk_m1 { at: spx + 164 * pu, sby + 152 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 152 * pu) - lk.off > sby and (sby + 152 * pu) - lk.off < sby + set.h * pu }
            on press lk_m1 { emit lk_mask_set(1) }
            box { at: spx + 266 * pu, sby + 152 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkm2); opacity: 8% + 20% * lkm2 + 6% * lk_m2.hover }
            text "Asterisks" { at: floor(spx + 266 * pu + 0.5), floor(sby + 152 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 92 * pu; lines: 1; color: mix(ink, mint, lkm2); family: "Space Grotesk" }
            zone box lk_m2 { at: spx + 266 * pu, sby + 152 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 152 * pu) - lk.off > sby and (sby + 152 * pu) - lk.off < sby + set.h * pu }
            on press lk_m2 { emit lk_mask_set(2) }
            box { at: spx + 368 * pu, sby + 152 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkm3); opacity: 8% + 20% * lkm3 + 6% * lk_m3.hover }
            text "Special" { at: floor(spx + 368 * pu + 0.5), floor(sby + 152 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 92 * pu; lines: 1; color: mix(ink, mint, lkm3); family: "Space Grotesk" }
            zone box lk_m3 { at: spx + 368 * pu, sby + 152 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 152 * pu) - lk.off > sby and (sby + 152 * pu) - lk.off < sby + set.h * pu }
            on press lk_m3 { emit lk_mask_set(3) }

            //  Card three: the colours. Each character takes one of them at random.
            box { at: spx + 219 * pu, sby + 221 * pu; size: 438 * pu, 70 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Colours" { at: floor(spx + 14 * pu + 0.5), floor(sby + 202 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: spx + 52 * pu, sby + 232 * pu; size: 76 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkc0); opacity: 8% + 20% * lkc0 + 6% * lk_c0.hover }
            text "Vibrant" { at: floor(spx + 57 * pu + 0.5), floor(sby + 232 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 62 * pu; lines: 1; color: mix(ink, mint, lkc0); family: "Space Grotesk" }
            zone box lk_c0 { at: spx + 52 * pu, sby + 232 * pu; size: 76 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 232 * pu) - lk.off > sby and (sby + 232 * pu) - lk.off < sby + set.h * pu }
            on press lk_c0 { emit lk_pal_set(0) }
            ellipse { at: spx + 25.0 * pu, sby + 232 * pu; radius: 3.2 * pu; color: #00f0ff }
            box { at: spx + 134 * pu, sby + 232 * pu; size: 76 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkc1); opacity: 8% + 20% * lkc1 + 6% * lk_c1.hover }
            text "Accent" { at: floor(spx + 139 * pu + 0.5), floor(sby + 232 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 62 * pu; lines: 1; color: mix(ink, mint, lkc1); family: "Space Grotesk" }
            zone box lk_c1 { at: spx + 134 * pu, sby + 232 * pu; size: 76 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 232 * pu) - lk.off > sby and (sby + 232 * pu) - lk.off < sby + set.h * pu }
            on press lk_c1 { emit lk_pal_set(1) }
            ellipse { at: spx + 107.0 * pu, sby + 232 * pu; radius: 3.2 * pu; color: mint }
            box { at: spx + 216 * pu, sby + 232 * pu; size: 76 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkc2); opacity: 8% + 20% * lkc2 + 6% * lk_c2.hover }
            text "Neon" { at: floor(spx + 221 * pu + 0.5), floor(sby + 232 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 62 * pu; lines: 1; color: mix(ink, mint, lkc2); family: "Space Grotesk" }
            zone box lk_c2 { at: spx + 216 * pu, sby + 232 * pu; size: 76 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 232 * pu) - lk.off > sby and (sby + 232 * pu) - lk.off < sby + set.h * pu }
            on press lk_c2 { emit lk_pal_set(2) }
            ellipse { at: spx + 189.0 * pu, sby + 232 * pu; radius: 3.2 * pu; color: #ff0055 }
            box { at: spx + 298 * pu, sby + 232 * pu; size: 76 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkc3); opacity: 8% + 20% * lkc3 + 6% * lk_c3.hover }
            text "Pastel" { at: floor(spx + 303 * pu + 0.5), floor(sby + 232 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 62 * pu; lines: 1; color: mix(ink, mint, lkc3); family: "Space Grotesk" }
            zone box lk_c3 { at: spx + 298 * pu, sby + 232 * pu; size: 76 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 232 * pu) - lk.off > sby and (sby + 232 * pu) - lk.off < sby + set.h * pu }
            on press lk_c3 { emit lk_pal_set(3) }
            ellipse { at: spx + 271.0 * pu, sby + 232 * pu; radius: 3.2 * pu; color: #c4b5fd }
            box { at: spx + 380 * pu, sby + 232 * pu; size: 76 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkc4); opacity: 8% + 20% * lkc4 + 6% * lk_c4.hover }
            text "Mono" { at: floor(spx + 385 * pu + 0.5), floor(sby + 232 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 62 * pu; lines: 1; color: mix(ink, mint, lkc4); family: "Space Grotesk" }
            zone box lk_c4 { at: spx + 380 * pu, sby + 232 * pu; size: 76 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 232 * pu) - lk.off > sby and (sby + 232 * pu) - lk.off < sby + set.h * pu }
            on press lk_c4 { emit lk_pal_set(4) }
            ellipse { at: spx + 353.0 * pu, sby + 232 * pu; radius: 3.2 * pu; color: #ffffff }

            //  Card four: the wallpaper's blur.
            box { at: spx + 219 * pu, sby + 292 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Wallpaper blur" { at: floor(spx + 14 * pu + 0.5), floor(sby + 282 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "How soft the picture behind the lock is" { at: floor(spx + 14 * pu + 0.5), floor(sby + 301 * pu + 0.5); anchor: left center; size: 13.5; width: 230 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            box { at: spx + 276 * pu, sby + 292 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkb0); opacity: 8% + 20% * lkb0 + 6% * lk_b0.hover }
            text "Light" { at: floor(spx + 276 * pu + 0.5), floor(sby + 292 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 52 * pu; lines: 1; color: mix(ink, mint, lkb0); family: "Space Grotesk" }
            zone box lk_b0 { at: spx + 276 * pu, sby + 292 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 292 * pu) - lk.off > sby and (sby + 292 * pu) - lk.off < sby + set.h * pu }
            on press lk_b0 { emit lk_blur_set(0) }
            box { at: spx + 336 * pu, sby + 292 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkb1); opacity: 8% + 20% * lkb1 + 6% * lk_b1.hover }
            text "Medium" { at: floor(spx + 336 * pu + 0.5), floor(sby + 292 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 52 * pu; lines: 1; color: mix(ink, mint, lkb1); family: "Space Grotesk" }
            zone box lk_b1 { at: spx + 336 * pu, sby + 292 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 292 * pu) - lk.off > sby and (sby + 292 * pu) - lk.off < sby + set.h * pu }
            on press lk_b1 { emit lk_blur_set(1) }
            box { at: spx + 396 * pu, sby + 292 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkb2); opacity: 8% + 20% * lkb2 + 6% * lk_b2.hover }
            text "Heavy" { at: floor(spx + 396 * pu + 0.5), floor(sby + 292 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 52 * pu; lines: 1; color: mix(ink, mint, lkb2); family: "Space Grotesk" }
            zone box lk_b2 { at: spx + 396 * pu, sby + 292 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 292 * pu) - lk.off > sby and (sby + 292 * pu) - lk.off < sby + set.h * pu }
            on press lk_b2 { emit lk_blur_set(2) }

            //  Card five: the clock. The AM/PM pill only means something on a 12 hour clock.
            box { at: spx + 219 * pu, sby + 410 * pu; size: 438 * pu, 164 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Clock" { at: floor(spx + 14 * pu + 0.5), floor(sby + 342 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Time format" { at: floor(spx + 14 * pu + 0.5), floor(sby + 370 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            box { at: spx + 321 * pu, sby + 370 * pu; size: 66 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkt12); opacity: 8% + 20% * lkt12 + 6% * lk_t12.hover }
            text "12-hour" { at: floor(spx + 321 * pu + 0.5), floor(sby + 370 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 62 * pu; lines: 1; color: mix(ink, mint, lkt12); family: "Space Grotesk" }
            zone box lk_t12 { at: spx + 321 * pu, sby + 370 * pu; size: 66 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 370 * pu) - lk.off > sby and (sby + 370 * pu) - lk.off < sby + set.h * pu }
            on press lk_t12 { emit lk_12h_set(1) }
            box { at: spx + 391 * pu, sby + 370 * pu; size: 66 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkt24); opacity: 8% + 20% * lkt24 + 6% * lk_t24.hover }
            text "24-hour" { at: floor(spx + 391 * pu + 0.5), floor(sby + 370 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 62 * pu; lines: 1; color: mix(ink, mint, lkt24); family: "Space Grotesk" }
            zone box lk_t24 { at: spx + 391 * pu, sby + 370 * pu; size: 66 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 370 * pu) - lk.off > sby and (sby + 370 * pu) - lk.off < sby + set.h * pu }
            on press lk_t24 { emit lk_12h_set(0) }
            group {
                opacity: 40% + 60% * lkt12
                text "AM/PM pill" { at: floor(spx + 14 * pu + 0.5), floor(sby + 404 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            }
            body {
                color: mix(off, mint, clamp(lk_pill_am, 0, 1))
                box { at: spx + 405 * pu, sby + 404 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu }
            }
            box { at: spx + 397 * pu + lk_pill_am * 16 * pu, sby + 404 * pu; size: (17 + 9 * clamp(4 * lk_pill_am * (1 - lk_pill_am), 0, 1)) * pu, (17 - 3 * clamp(4 * lk_pill_am * (1 - lk_pill_am), 0, 1)) * pu; corner: (8.5 - 1.5 * clamp(4 * lk_pill_am * (1 - lk_pill_am), 0, 1)) * pu; color: ink }
            zone box lk_am_hit { at: spx + 405 * pu, sby + 404 * pu; size: 46 * pu, 30 * pu; cursor: pointer; active: (sby + 404 * pu) - lk.off > sby and (sby + 404 * pu) - lk.off < sby + set.h * pu }
            on press lk_am_hit { emit lk_ampm_toggle }
            text "Show seconds" { at: floor(spx + 14 * pu + 0.5), floor(sby + 438 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(lk_pill_sec, 0, 1))
                box { at: spx + 405 * pu, sby + 438 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu }
            }
            box { at: spx + 397 * pu + lk_pill_sec * 16 * pu, sby + 438 * pu; size: (17 + 9 * clamp(4 * lk_pill_sec * (1 - lk_pill_sec), 0, 1)) * pu, (17 - 3 * clamp(4 * lk_pill_sec * (1 - lk_pill_sec), 0, 1)) * pu; corner: (8.5 - 1.5 * clamp(4 * lk_pill_sec * (1 - lk_pill_sec), 0, 1)) * pu; color: ink }
            zone box lk_sec_hit { at: spx + 405 * pu, sby + 438 * pu; size: 46 * pu, 30 * pu; cursor: pointer; active: (sby + 438 * pu) - lk.off > sby and (sby + 438 * pu) - lk.off < sby + set.h * pu }
            on press lk_sec_hit { emit lk_secs_toggle }
            text "Clock size" { at: floor(spx + 14 * pu + 0.5), floor(sby + 472 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            box { at: spx + 298 * pu, sby + 472 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lksz0); opacity: 8% + 20% * lksz0 + 6% * lk_z0.hover }
            text "100" { at: floor(spx + 298 * pu + 0.5), floor(sby + 472 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 52 * pu; lines: 1; color: mix(ink, mint, lksz0); family: "Space Grotesk" }
            zone box lk_z0 { at: spx + 298 * pu, sby + 472 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 472 * pu) - lk.off > sby and (sby + 472 * pu) - lk.off < sby + set.h * pu }
            on press lk_z0 { emit lk_size_set(0) }
            box { at: spx + 358 * pu, sby + 472 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lksz1); opacity: 8% + 20% * lksz1 + 6% * lk_z1.hover }
            text "150" { at: floor(spx + 358 * pu + 0.5), floor(sby + 472 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 52 * pu; lines: 1; color: mix(ink, mint, lksz1); family: "Space Grotesk" }
            zone box lk_z1 { at: spx + 358 * pu, sby + 472 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 472 * pu) - lk.off > sby and (sby + 472 * pu) - lk.off < sby + set.h * pu }
            on press lk_z1 { emit lk_size_set(1) }
            box { at: spx + 418 * pu, sby + 472 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lksz2); opacity: 8% + 20% * lksz2 + 6% * lk_z2.hover }
            text "200" { at: floor(spx + 418 * pu + 0.5), floor(sby + 472 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 52 * pu; lines: 1; color: mix(ink, mint, lksz2); family: "Space Grotesk" }
            zone box lk_z2 { at: spx + 418 * pu, sby + 472 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 472 * pu) - lk.off > sby and (sby + 472 * pu) - lk.off < sby + set.h * pu }
            on press lk_z2 { emit lk_size_set(2) }

            //  Card six: the date.
            box { at: spx + 219 * pu, sby + 539 * pu; size: 438 * pu, 74 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Date style" { at: floor(spx + 14 * pu + 0.5), floor(sby + 518 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            box { at: spx + 62 * pu, sby + 552 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkd0); opacity: 8% + 20% * lkd0 + 6% * lk_d0.hover }
            text "Long" { at: floor(spx + 62 * pu + 0.5), floor(sby + 552 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 92 * pu; lines: 1; color: mix(ink, mint, lkd0); family: "Space Grotesk" }
            zone box lk_d0 { at: spx + 62 * pu, sby + 552 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 552 * pu) - lk.off > sby and (sby + 552 * pu) - lk.off < sby + set.h * pu }
            on press lk_d0 { emit lk_date_set(0) }
            box { at: spx + 164 * pu, sby + 552 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkd1); opacity: 8% + 20% * lkd1 + 6% * lk_d1.hover }
            text "Standard" { at: floor(spx + 164 * pu + 0.5), floor(sby + 552 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 92 * pu; lines: 1; color: mix(ink, mint, lkd1); family: "Space Grotesk" }
            zone box lk_d1 { at: spx + 164 * pu, sby + 552 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 552 * pu) - lk.off > sby and (sby + 552 * pu) - lk.off < sby + set.h * pu }
            on press lk_d1 { emit lk_date_set(1) }
            box { at: spx + 266 * pu, sby + 552 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkd2); opacity: 8% + 20% * lkd2 + 6% * lk_d2.hover }
            text "Day first" { at: floor(spx + 266 * pu + 0.5), floor(sby + 552 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 92 * pu; lines: 1; color: mix(ink, mint, lkd2); family: "Space Grotesk" }
            zone box lk_d2 { at: spx + 266 * pu, sby + 552 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 552 * pu) - lk.off > sby and (sby + 552 * pu) - lk.off < sby + set.h * pu }
            on press lk_d2 { emit lk_date_set(2) }
            box { at: spx + 368 * pu, sby + 552 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; color: mix(ink, mint, lkd3); opacity: 8% + 20% * lkd3 + 6% * lk_d3.hover }
            text "ISO 8601" { at: floor(spx + 368 * pu + 0.5), floor(sby + 552 * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 92 * pu; lines: 1; color: mix(ink, mint, lkd3); family: "Space Grotesk" }
            zone box lk_d3 { at: spx + 368 * pu, sby + 552 * pu; size: 96 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 552 * pu) - lk.off > sby and (sby + 552 * pu) - lk.off < sby + set.h * pu }
            on press lk_d3 { emit lk_date_set(3) }

            //  Card seven: the player under the password bar.
            box { at: spx + 219 * pu, sby + 612 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Media player" { at: floor(spx + 14 * pu + 0.5), floor(sby + 602 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "What is playing, under the password bar" { at: floor(spx + 14 * pu + 0.5), floor(sby + 621 * pu + 0.5); anchor: left center; size: 13.5; width: 300 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(lk_pill_md, 0, 1))
                box { at: spx + 405 * pu, sby + 612 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu }
            }
            box { at: spx + 397 * pu + lk_pill_md * 16 * pu, sby + 612 * pu; size: (17 + 9 * clamp(4 * lk_pill_md * (1 - lk_pill_md), 0, 1)) * pu, (17 - 3 * clamp(4 * lk_pill_md * (1 - lk_pill_md), 0, 1)) * pu; corner: (8.5 - 1.5 * clamp(4 * lk_pill_md * (1 - lk_pill_md), 0, 1)) * pu; color: ink }
            zone box lk_md_hit { at: spx + 405 * pu, sby + 612 * pu; size: 46 * pu, 30 * pu; cursor: pointer; active: (sby + 612 * pu) - lk.off > sby and (sby + 612 * pu) - lk.off < sby + set.h * pu }
            on press lk_md_hit { emit lk_media_toggle }

            //  Card eight: the power buttons. Each is held for a second on the lock screen.
            box { at: spx + 219 * pu, sby + 674 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Power buttons" { at: floor(spx + 14 * pu + 0.5), floor(sby + 664 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Sleep, restart and power off, at the bottom of the screen" { at: floor(spx + 14 * pu + 0.5), floor(sby + 683 * pu + 0.5); anchor: left center; size: 13.5; width: 300 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(lk_pill_pw, 0, 1))
                box { at: spx + 405 * pu, sby + 674 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu }
            }
            box { at: spx + 397 * pu + lk_pill_pw * 16 * pu, sby + 674 * pu; size: (17 + 9 * clamp(4 * lk_pill_pw * (1 - lk_pill_pw), 0, 1)) * pu, (17 - 3 * clamp(4 * lk_pill_pw * (1 - lk_pill_pw), 0, 1)) * pu; corner: (8.5 - 1.5 * clamp(4 * lk_pill_pw * (1 - lk_pill_pw), 0, 1)) * pu; color: ink }
            zone box lk_pw_hit { at: spx + 405 * pu, sby + 674 * pu; size: 46 * pu, 30 * pu; cursor: pointer; active: (sby + 674 * pu) - lk.off > sby and (sby + 674 * pu) - lk.off < sby + set.h * pu }
            on press lk_pw_hit { emit lk_power_toggle }

            //  Card nine: which monitor has the clock and the password bar. The others keep the wallpaper.
            box { at: spx + 219 * pu, sby + 748 * pu; size: 438 * pu, 74 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "Show on" { at: floor(spx + 14 * pu + 0.5), floor(sby + 722 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "The clock and password bar go on one monitor; the rest show the wallpaper" { at: floor(spx + 14 * pu + 0.5), floor(sby + 741 * pu + 0.5); anchor: left center; size: 13.5; width: 410 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            let lkya = sby + 768 * pu
            box { at: spx + 14 * pu + 38 * pu, lkya; size: 76 * pu, 24 * pu; corner: 8 * pu; color: if(lk_mon == 0, mint, ink); opacity: 8% + 20% * if(lk_mon == 0, 1, 0) + 6% * lk_mn_all.hover }
            text "All" { at: floor(spx + 14 * pu + 38 * pu + 0.5), floor(lkya + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 70 * pu; lines: 1; color: if(lk_mon == 0, mint, ink); family: "Space Grotesk" }
            zone box lk_mn_all { at: spx + 14 * pu + 38 * pu, lkya; size: 76 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: lkya - lk.off > sby and lkya - lk.off < sby + set.h * pu }
            on press lk_mn_all { emit lk_mon_set(0) }
            repeat k in 0..4 {
                let lkx = spx + 14 * pu + 38 * pu + (k + 1) * 82 * pu
                box { at: lkx, lkya; size: 76 * pu, 24 * pu; corner: 8 * pu; color: if(lk_mon == k + 1, mint, ink); opacity: if(lk_m.$k.on, 8% + 20% * if(lk_mon == k + 1, 1, 0) + 6% * lk_mn.$k.hover, 0%) }
                text lk_m.$k.name { at: floor(lkx + 0.5), floor(lkya + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: 70 * pu; lines: 1; color: if(lk_mon == k + 1, mint, ink); show: lk_m.$k.on; family: "Space Grotesk" }
                zone box lk_mn.$k { at: lkx, lkya; size: 76 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (lk_m.$k.on) and lkya - lk.off > sby and lkya - lk.off < sby + set.h * pu }
                on press lk_mn.$k { emit lk_mon_set(k + 1) }
            }
            text "The lock screen is not running: start it to change these" { at: floor(spx + 14 * pu + 0.5), floor(sby + 796 * pu + 0.5); anchor: left center; size: 13.5; width: 400 * pu; lines: 1; color: #ef4444; family: "Space Grotesk"; show: not lk_ok }
            }

            let lk.thh = set.h * set.h / max(set.h, lk.h)
            let lk.thy = lk.thh / 2 + lk.sc / max(1, lk.h - set.h) * (set.h - lk.thh)
            box { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: if(lk.h > set.h, 6%, 0%) }
            box { at: spx + 442 * pu, sby + lk.thy * pu; size: 3 * pu, lk.thh * pu; corner: 1.5 * pu; color: mint; opacity: if(lk.h > set.h, 55%, 0%) }
            let lk.cue = clamp((lk.h - set.h - lk.sc) / 24, 0, 1)
            let lk.cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (400 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * lk.cue }
            }
            box { at: spx + 224 * pu, lk.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * lk.cue }
            box { at: spx + 224 * pu, lk.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * lk_cue_hit.hover) * lk.cue }
            path { at: spx + 204 * pu, lk.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: lk.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, lk.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: lk.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            text "More" { at: floor(spx + 232 * pu + 0.5), floor(lk.cuey + 0.5); anchor: center; size: 15; weight: 700; color: ink; opacity: lk.cue; family: "Space Grotesk" }
            zone box lk_cue_hit { at: spx + 224 * pu, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: lk.cue > 0.5 }
            on press lk_cue_hit { lk_scroll_to = clamp(lk_scroll_to + 342, 0, max(0, lk.h - set.h)) }
            zone box lk_bar_hit { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: lk.h > set.h }
            on press lk_bar_hit { lk_scroll_to = clamp(((pointer.y - sby) / pu - lk.thh / 2) / max(1, set.h - lk.thh) * (lk.h - set.h), 0, max(0, lk.h - set.h)) }
            on drag lk_bar_hit { lk_scroll_to = clamp(((pointer.y - sby) / pu - lk.thh / 2) / max(1, set.h - lk.thh) * (lk.h - set.h), 0, max(0, lk.h - set.h)) }
        }
}
