            PLeader(spx + 14 * pw + ldr_loc4.width * rs + 8 * pu, spx + 274 * pw - 60 * pw / 2 - 6 * pu, sby + 498 * pu, clamp(lk_z0.hover + lk_z1.hover + lk_z2.hover, 0, 1), pu)
            box { at: spx + 274 * pw, sby + 498 * pu; size: 56 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_z0.hover }
            group { scale: rs; pivot: floor(spx + 274 * pw + 0.5), floor(sby + 498 * pu + 0.5); text "100" { at: floor(spx + 274 * pw + 0.5), floor(sby + 498 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (52 * pw) / rs; lines: 1; color: mix(ink, mint, lksz0); family: "Space Grotesk" } }
            zone box lk_z0 { at: spx + 274 * pw, sby + 498 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 498 * pu) - lk.off > sby and (sby + 498 * pu) - lk.off < sby + set.h * pu }
