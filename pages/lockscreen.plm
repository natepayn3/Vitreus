            group { scale: rs; pivot: floor(spx + 334 * pw + 0.5), floor(sby + 498 * pu + 0.5); text "150" { at: floor(spx + 334 * pw + 0.5), floor(sby + 498 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (52 * pw) / rs; lines: 1; color: mix(ink, mint, lksz1); family: "Space Grotesk" } }
            zone box lk_z1 { at: spx + 334 * pw, sby + 498 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 498 * pu) - lk.off > sby and (sby + 498 * pu) - lk.off < sby + set.h * pu }
            on press lk_z1 { emit lk_size_set(1) }
            box { at: spx + 394 * pw, sby + 498 * pu; size: 56 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_z2.hover }
            group { scale: rs; pivot: floor(spx + 394 * pw + 0.5), floor(sby + 498 * pu + 0.5); text "200" { at: floor(spx + 394 * pw + 0.5), floor(sby + 498 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (52 * pw) / rs; lines: 1; color: mix(ink, mint, lksz2); family: "Space Grotesk" } }
            zone box lk_z2 { at: spx + 394 * pw, sby + 498 * pu; size: 56 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 498 * pu) - lk.off > sby and (sby + 498 * pu) - lk.off < sby + set.h * pu }
            on press lk_z2 { emit lk_size_set(2) }

            //  Card six: the date.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 571 * pu; size: 438 * pw, 78 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 571 * pu, 438 * pw, 78 * pu, 244.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 571 * pu; size: 438 * pw, 78 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
