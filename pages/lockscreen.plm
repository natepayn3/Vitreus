            box { at: spx + 301 * pw, sby + 254 * pu; size: 76 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_c3.hover }
            group { scale: rs; pivot: floor(spx + 303 * pw + 0.5), floor(sby + 254 * pu + 0.5); text "Pastel" { at: floor(spx + 303 * pw + 0.5), floor(sby + 254 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (62 * pw) / rs; lines: 1; color: mix(ink, mint, lkc3); family: "Space Grotesk" } }
            zone box lk_c3 { at: spx + 301 * pw, sby + 254 * pu; size: 76 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 254 * pu) - lk.off > sby and (sby + 254 * pu) - lk.off < sby + set.h * pu }
            on press lk_c3 { emit lk_pal_set(3) }
            ellipse { at: spx + 271.0 * pw, sby + 254 * pu; radius: 3.2 * pu; color: #c4b5fd }
            box { at: spx + 383 * pw, sby + 254 * pu; size: 76 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * lk_c4.hover }
            group { scale: rs; pivot: floor(spx + 385 * pw + 0.5), floor(sby + 254 * pu + 0.5); text "Mono" { at: floor(spx + 385 * pw + 0.5), floor(sby + 254 * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; width: (62 * pw) / rs; lines: 1; color: mix(ink, mint, lkc4); family: "Space Grotesk" } }
            zone box lk_c4 { at: spx + 383 * pw, sby + 254 * pu; size: 76 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + 254 * pu) - lk.off > sby and (sby + 254 * pu) - lk.off < sby + set.h * pu }
            on press lk_c4 { emit lk_pal_set(4) }
            ellipse { at: spx + 353.0 * pw, sby + 254 * pu; radius: 3.2 * pu; color: #ffffff }

            //  Card four: the wallpaper's blur.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 317 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 317 * pu, 438 * pw, 58 * pu, 765.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 317 * pu; size: 438 * pw, 58 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
