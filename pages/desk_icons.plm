    component DGHome(cx: number, cy: number, hot: number, k: number, c: color, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        group {
            pivot: cx, cy
            scale: 1 + 0.08 * a
            let bj = (0.2 + 0.3 * a) * k * sin(fr * 53 + 23)
            let bk = (0.2 + 0.3 * a) * k * sin(fr * 61 + 67)
            path { at: 0, 0; color: c; opacity: 0.24 * o; move cx + -7 * k, cy + -1.5 * k; line cx + 0 * k, cy + -8.5 * k; line cx + 7 * k, cy + -1.5 * k; line cx + 7 * k, cy + 9.5 * k; line cx + -7 * k, cy + 9.5 * k; close }
