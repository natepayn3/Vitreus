                path { at: bo, bo * 0.5; stroke: if(bp == 0, 1, 0.72) * 1.7 * k; color: c; opacity: if(bp == 0, 90%, 34%) * o; move cx + 1.742 * k + bj, cy + 6.986 * k + bk; line cx + 1.683 * k + bk, cy + 10.06 * k + bj; line cx + -1.683 * k + bj, cy + 10.06 * k + bk; line cx + -1.742 * k + bk, cy + 6.986 * k + bj; line cx + -3.708 * k + bj, cy + 6.172 * k + bk }
