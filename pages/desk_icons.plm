            path { at: 0, 0; stroke: 1 * k; color: c; opacity: 0.6 * o; move cx + -5.2 * k + bj, cy + 2.4 * k + bk; line cx + -4.7 * k + bk, cy + 5.6 * k + bj }
            path { at: 0, 0; stroke: 1 * k; color: c; opacity: 0.5 * o; move cx + -3.5 * k + bj, cy + 3.4 * k + bk; line cx + -3.1 * k + bk, cy + 6.2 * k + bj }
        }
    }
    component DGCamera(cx: number, cy: number, hot: number, k: number, c: color, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        group {
            pivot: cx, cy
            scale: 1 + 0.08 * a
            let bj = (0.2 + 0.3 * a) * k * sin(fr * 53 + 23)
            let bk = (0.2 + 0.3 * a) * k * sin(fr * 61 + 67)
            path { at: 0, 0; color: c; opacity: 0.22 * o; move cx + -7 * k, cy + -5 * k; line cx + -4 * k, cy + -5 * k; line cx + -2.5 * k, cy + -8 * k; line cx + 3 * k, cy + -8 * k; line cx + 4.5 * k, cy + -5 * k; line cx + 7 * k, cy + -5 * k; curve cx + 10 * k, cy + -2 * k via cx + 10 * k, cy + -5 * k; line cx + 10 * k, cy + 5 * k; curve cx + 7 * k, cy + 8 * k via cx + 10 * k, cy + 8 * k; line cx + -7 * k, cy + 8 * k; curve cx + -10 * k, cy + 5 * k via cx + -10 * k, cy + 8 * k; line cx + -10 * k, cy + -2 * k; curve cx + -7 * k, cy + -5 * k via cx + -10 * k, cy + -5 * k; close }
            repeat bp in 0..2 {
                let bo = bp * 0.7 * k
                let bj = (0.2 + 0.3 * a) * k * sin(fr * 53 + bp * 137 + 23)
                let bk = (0.2 + 0.3 * a) * k * sin(fr * 61 + bp * 71 + 67)
                path { at: bo, bo * 0.5; stroke: if(bp == 0, 1, 0.72) * 1.8 * k; color: c; opacity: if(bp == 0, 90%, 34%) * o; move cx + -7 * k + bj, cy + -5 * k + bk; line cx + -4 * k + bk, cy + -5 * k + bj; line cx + -2.5 * k + bj, cy + -8 * k + bk; line cx + 3 * k + bk, cy + -8 * k + bj; line cx + 4.5 * k + bj, cy + -5 * k + bk; line cx + 7 * k + bk, cy + -5 * k + bj; curve cx + 10 * k, cy + -2 * k via cx + 10 * k, cy + -5 * k; line cx + 10 * k + bk, cy + 5 * k + bj; curve cx + 7 * k, cy + 8 * k via cx + 10 * k, cy + 8 * k; line cx + -7 * k + bk, cy + 8 * k + bj; curve cx + -10 * k, cy + 5 * k via cx + -10 * k, cy + 8 * k; line cx + -10 * k + bk, cy + -2 * k + bj; curve cx + -7 * k, cy + -5 * k via cx + -10 * k, cy + -5 * k; close }
                ellipse { at: cx + 0 * k + bo + bj, cy + 1.5 * k + bo * 0.5 + bk; radius: 4.8 * k; stroke: if(bp == 0, 1, 0.72) * 1.8 * k; color: c; opacity: if(bp == 0, 90%, 34%) * o }
            }
            ellipse { at: cx + 0 * k + bj, cy + 1.5 * k + bk; radius: 2.6 * k; stroke: 1.1 * k; color: c; opacity: 0.65 * o }
            ellipse { at: cx + 0 * k + bj, cy + 1.5 * k + bk; radius: 2.1 * k; color: c; opacity: 0.45 * o }
            ellipse { at: cx + -1 * k + bj, cy + 0.5 * k + bk; radius: 0.7 * k; color: c; opacity: 1 * o }
            ellipse { at: cx + 7 * k + bj, cy + -2.5 * k + bk; radius: 1.1 * k; color: c; opacity: 1 * o }
            path { at: 0, 0; stroke: 1.1 * k; color: c; opacity: 0.65 * o; move cx + -8 * k + bj, cy + -1 * k + bk; line cx + -7.5 * k + bk, cy + 4 * k + bj }
            path { at: 0, 0; stroke: 1.1 * k; color: c; opacity: 0.65 * o; move cx + -6.5 * k + bj, cy + 0.5 * k + bk; line cx + -6 * k + bk, cy + 5.5 * k + bj }
            path { at: 0, 0; stroke: 1.1 * k; color: c; opacity: 0.6 * o; move cx + 5.5 * k + bj, cy + -6.4 * k + bk; line cx + 8 * k + bk, cy + -6.4 * k + bj }
        }
    }
    component DGMemos(cx: number, cy: number, hot: number, k: number, c: color, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        group {
            pivot: cx, cy
            scale: 1 + 0.08 * a
            let bj = (0.2 + 0.3 * a) * k * sin(fr * 53 + 23)
