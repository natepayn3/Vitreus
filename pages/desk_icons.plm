                let bo = bp * 0.7 * k
                let bj = (0.2 + 0.3 * a) * k * sin(fr * 53 + bp * 137 + 23)
                let bk = (0.2 + 0.3 * a) * k * sin(fr * 61 + bp * 71 + 67)
                path { at: bo, bo * 0.5; stroke: if(bp == 0, 1, 0.72) * 1.8 * k; color: c; opacity: if(bp == 0, 90%, 34%) * o; move cx + -10.5 * k + bj, cy + 0 * k + bk; line cx + 0 * k + bk, cy + -9.6 * k + bj; line cx + 10.5 * k + bj, cy + 0 * k + bk }
                path { at: bo, bo * 0.5; stroke: if(bp == 0, 1, 0.72) * 1.7 * k; color: c; opacity: if(bp == 0, 90%, 34%) * o; move cx + -7 * k + bj, cy + -2 * k + bk; line cx + -7 * k + bk, cy + 9.5 * k + bj; line cx + 7 * k + bj, cy + 9.5 * k + bk; line cx + 7 * k + bk, cy + -2 * k + bj }
                box { at: cx + 4.8 * k + bo + bj, cy + 1 * k + bo * 0.5 + bk; size: 2.4 * k, 2.4 * k; corner: 0.4 * k; stroke: if(bp == 0, 1, 0.72) * 1.1 * k; color: c; opacity: if(bp == 0, 90%, 34%) * o }
            }
            path { at: 0, 0; stroke: 1.4 * k; color: c; opacity: 0.9 * o; move cx + 4.5 * k + bj, cy + -5.6 * k + bk; line cx + 4.5 * k + bk, cy + -9.2 * k + bj; line cx + 7.2 * k + bj, cy + -9.2 * k + bk; line cx + 7.2 * k + bk, cy + -3.6 * k + bj }
            path { at: 0, 0; stroke: 1.4 * k; color: c; opacity: 0.9 * o; move cx + -2.3 * k + bj, cy + 9.5 * k + bk; line cx + -2.3 * k + bk, cy + 4.2 * k + bj; curve cx + 2.3 * k, cy + 4.2 * k via cx + 0 * k, cy + 1 * k; line cx + 2.3 * k + bk, cy + 9.5 * k + bj }
            path { at: 0, 0; stroke: 1 * k; color: c; opacity: 0.6 * o; move cx + -5.8 * k + bj, cy + 1.5 * k + bk; line cx + -5.2 * k + bk, cy + 5.5 * k + bj }
            path { at: 0, 0; stroke: 1 * k; color: c; opacity: 0.5 * o; move cx + -4.2 * k + bj, cy + 2 * k + bk; line cx + -3.6 * k + bk, cy + 6 * k + bj }
