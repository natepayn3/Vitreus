part PanelFrame {
    // ── the panel ────────────────────────────────────────────────
    group {
        //  The calendar's content is clipped to the calendar's shape.
        opacity: pown
        move: rt * (screen.width - 2 * pcx), bt * (yo + vb - 2 * (th.t + lp.hd / 2))
        clip inset 2 box { at: mix(mix(mix(pcx, dc.gx, lm), 2 * pcx - mix(pcx, dc.gx, lm), rt), dc.tex, tu), mix(mix(bar.y + dc.hh / 2, lp.cy, lm), dc.tey, tu) + bt * (2 * (th.t + lp.hd / 2) - 2 * mix(mix(bar.y + dc.hh / 2, lp.cy, lm), dc.tey, tu)); size: mix(mix(dc.w, dc.gw, lm), dc.tew, tu), mix(mix(dc.hh, dc.gh, lm), dc.teh, tu); corner: 26 * cu * (1 - 0.73 * sq) }
        //  Down the left it comes out of the strip: what is inside grows with the drawer's shape (`dc.lf`), from the strip's edge at the panel's middle, instead of waiting still under the clip.
        group {
            shader: pixelate, px.dc
            pivot: mix(mix(lp.xl, 2 * pcx - lp.xl, rt), pcx, tu), mix(lp.cy, bar.y + bar.h / 2 + bt * lp.hd, tu)
            scale: mix(1, max(dc.lf, 0.05), att)
        //  ── the Calendar tab ──
        group {
            show: tf.cal > 0.005
            opacity: tf.cal
            move: 0, 44 * cu
        //  Three plates like the volume and media ones, each 8% white and 12 from the panel's
        //  edges: the time and date, the chosen day with its reminders, and the month. The two
        //  on the left and the one on the right share a top and a bottom.
        group {
            opacity: f1
            move: 0, (1 - f1) * 12 * cu + floor(68 * cu + 0.5)
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_p0, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: pcx - 130 * cu, cy - 76 * cu; size: 166 * cu, 72 * cu; corner: pr } }
            DdCard(pcx - 130 * cu, cy - 76 * cu, 166 * cu, 72 * cu, 548.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_p0, dd_k), (obs) * dd_k, cu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: pcx - 130 * cu, cy - 76 * cu; size: 166 * cu, 72 * cu; corner: pr; color: ink; opacity: (veil) * (1 - obs) }
            box { at: pcx - 130 * cu, cy - 76 * cu; size: 166 * cu, 72 * cu; corner: pr; stroke: 1 * cu; color: ink; opacity: hair * (1 - dd_k) }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_p1, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: pcx - 130 * cu, cy + 43 * cu; size: 166 * cu, 154 * cu; corner: pr } }
            DdCard(pcx - 130 * cu, cy + 43 * cu, 166 * cu, 154 * cu, 576.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_p1, dd_k), (obs) * dd_k, cu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: pcx - 130 * cu, cy + 43 * cu; size: 166 * cu, 154 * cu; corner: pr; color: ink; opacity: (veil) * (1 - obs) }
            box { at: pcx - 130 * cu, cy + 43 * cu; size: 166 * cu, 154 * cu; corner: pr; stroke: 1 * cu; color: ink; opacity: hair * (1 - dd_k) }
            //  The clock card: big numerals, the am/pm tucked small at their top-right in the accent, and under
            //  them, indented a little, the date as weekday | month day with the pipe in the accent.
            text clock_hm { at: floor(pcx - 201 * cu + 0.5), floor(cy - 88 * cu + 0.5); anchor: left center; size: 64.5; weight: 700; measure: hmw; color: ink; family: "Space Grotesk" }
            //  The am/pm is a small pill in the accent, vertically centred on the numerals and set against their right side.
            box { at: floor(pcx - 201 * cu + hmw.width + 8 * cu + 17 + 0.5), floor(cy - 88 * cu + 0.5); size: 34, 20; corner: 10; color: mint; opacity: 20% }
            text clock_ap { at: floor(pcx - 201 * cu + hmw.width + 8 * cu + 17 + 0.5), floor(cy - 88 * cu + 0.5); anchor: center; align: center; size: 14; weight: 700; width: 34; lines: 1; color: mint; family: "Space Grotesk" }
            //  The date is right-aligned to the card's inner edge (pcx - 59): the month and day first, then the pipe
            //  and the weekday laid out leftwards from it, each placed from the measured width of the one after.
            text date_md { at: floor(pcx - 59 * cu + 0.5), floor(cy - 55 * cu + 0.5); anchor: right center; size: 14; weight: 700; measure: mdw; color: ink; family: "Space Grotesk" }
            text "|" { at: floor(pcx - 59 * cu - mdw.width - 8 * cu + 0.5), floor(cy - 55 * cu + 0.5); anchor: right center; size: 16; weight: 300; color: mint; family: "Space Grotesk" }
            text date_wd { at: floor(pcx - 59 * cu - mdw.width - 20 * cu + 0.5), floor(cy - 55 * cu + 0.5); anchor: right center; size: 14; weight: 700; color: faint; family: "Space Grotesk" }
            text cal.sel_title { at: floor(pcx - 201 * cu + 0.5), floor(cy - 14 * cu + 0.5); anchor: left center; size: 15; weight: 600; width: 142 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            text cal.sel_sub { at: floor(pcx - 201 * cu + 0.5), floor(cy + 1 * cu + 0.5); anchor: left center; size: 12; width: 142 * cu; lines: 1; color: faint; opacity: 75%; family: "Space Grotesk" }
            column cal_list {
                at: floor(pcx - 207 * cu + 0.5), floor(cy + 14 * cu + 0.5)
                view: 154 * cu, 106 * cu
                gap: 4
                for e in cal_events { CalRow(e, tick: cal_check, gone: cal_delete) }
            }
            text "Add one below" { at: floor(pcx - 201 * cu + 0.5), floor(cy + 28 * cu + 0.5); anchor: left center; size: 13; color: faint; opacity: 55%; family: "Space Grotesk"; show: cal_events.count < 1 }
        }
        group {
            opacity: f4
            move: 0, (1 - f4) * 12 * cu
            let cal.cw = 33 * cu
            let cal.ch = 27 * cu
            let cal.gx = pcx - 13 * cu                 // the middle of the first column
            let cal.gy = cy - 42 * cu                 // the middle of the first row
            group {
                move: 0, floor(68 * cu + 0.5)        // the month sits 68 lower, under the weather strip (a whole number of pixels)
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: pcx + 86 * cu, cy + 4 * cu; size: 254 * cu, 232 * cu; corner: pr } }
            DdCard(pcx + 86 * cu, cy + 4 * cu, 254 * cu, 232 * cu, 814.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, cu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: pcx + 86 * cu, cy + 4 * cu; size: 254 * cu, 232 * cu; corner: pr; color: ink; opacity: (veil) * (1 - obs) }
            box { at: pcx + 86 * cu, cy + 4 * cu; size: 254 * cu, 232 * cu; corner: pr; stroke: 1 * cu; color: ink; opacity: hair * (1 - dd_k) }
            //  Month, and the three buttons that move it.
            text cal.month { at: floor(pcx - 30 * cu + 0.5), floor(cy - 92 * cu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            path { at: pcx + 141.5 * cu, cy - 92 * cu; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * cal_prev_btn.hover; move 2.5 * cu, -5 * cu; line -2.5 * cu, 0; line 2.5 * cu, 5 * cu }
            box { at: pcx + 170.5 * cu, cy - 92 * cu; size: 40 * cu, 20 * cu; corner: (10 * cu) * (1 - 0.85 * dd_k); color: ink; opacity: 8% + 10% * cal_today_btn.hover }
            PPillOutline(pcx + 170.5 * cu, cy - 92 * cu, 40 * cu, 20 * cu, 10 * cu, cal_today_btn.hover, clamp(3 * (8% + 10% * cal_today_btn.hover), 0, 1), cu)
            text "Today" { at: floor(pcx + 170.5 * cu + 0.5), floor(cy - 92 * cu + 0.5); anchor: center; size: 13; weight: 600; color: ink; opacity: 80%; family: "Space Grotesk" }
            path { at: pcx + 199.5 * cu, cy - 92 * cu; color: ink; stroke: 1.6 * cu; opacity: 55% + 45% * cal_next_btn.hover; move -2.5 * cu, -5 * cu; line 2.5 * cu, 0; line -2.5 * cu, 5 * cu }
            zone box cal_prev_btn { label: "Previous month"; at: pcx + 141.5 * cu, cy - 92 * cu; size: 26 * cu, 26 * cu; corner: 13 * cu; cursor: pointer }
            zone box cal_today_btn { at: pcx + 170.5 * cu, cy - 92 * cu; size: 42 * cu, 24 * cu; corner: 12 * cu; cursor: pointer }
            zone box cal_next_btn { label: "Next month"; at: pcx + 199.5 * cu, cy - 92 * cu; size: 26 * cu, 26 * cu; corner: 13 * cu; cursor: pointer }
            on press cal_prev_btn { emit cal_prev }
            on press cal_today_btn { emit cal_today }
            on press cal_next_btn { emit cal_next }
            //  The weekdays.
            repeat w in 1..8 {
                text cal.wd.$w { at: floor(cal.gx + (w - 1) * cal.cw + 0.5), floor(cy - 66 * cu + 0.5); anchor: center; size: 11; weight: 600; color: faint; opacity: 65%; family: "Space Grotesk" }
            }
            //  The days.
            repeat k in 0..42 {
                let dx = cal.gx + mod(k, 7) * cal.cw
                let dy = cal.gy + floor(k / 7) * cal.ch
                prop cal.pick.$k = 0 ~lively
                follow cal.pick.$k = if(cal.sel == k, 1, 0)
                group {
                    opacity: 38% + 62% * if(cal.in.$k, 1, 0)
                    pivot: dx, dy
                    scale: 1 + 0.08 * cal.pick.$k
                    ellipse { at: dx, dy; radius: 12 * cu; color: ink; opacity: 9% * cal_cell.$k.hover * (1 - cal.pick.$k) }
                    ellipse { at: dx, dy; radius: 12 * cu; color: mint; opacity: cal.pick.$k * 100% }
                    ellipse { at: dx, dy; radius: 13 * cu; stroke: 4.5 * cu; color: mint; opacity: 22%; show: cal.today.$k }
                    ellipse { at: dx, dy; radius: 13 * cu; stroke: 1.5 * cu; color: mint; show: cal.today.$k }
                    ellipse { at: dx, dy + 8.5 * cu; radius: 1.5 * cu; color: mix(mint, onmint, cal.pick.$k); opacity: if(cal.n.$k > 0, 100%, 0) }
                }
                //  The day's number is not inside the group that grows when it is picked: a scaled text is resampled and comes out soft, so it
                //  stays its size (a text's `size` takes plain numbers only: a prop or a `let` in it counts as 1), and is drawn on whole pixels.
                text number(cal.day.$k, 0) { at: floor(dx + 0.5), floor(dy - 0.5 * cu + 0.5); anchor: center; size: 13; weight: 500 + 200 * if(cal.today.$k, 1, 0)
                                             color: mix(ink, onmint, cal.pick.$k); opacity: 38% + 62% * if(cal.in.$k, 1, 0); family: "Space Grotesk" }
                zone box cal_cell.$k { at: dx, dy; size: 30 * cu, 26 * cu; corner: 13 * cu; cursor: pointer }
                on press cal_cell.$k { emit cal_pick(k) }
            }
            }
            //  The weather, at the very top: what it is now, on the left, and the week, on the right.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: pcx, cy - 82 * cu; size: 426 * cu, 60 * cu; corner: pr } }
            DdCard(pcx, cy - 82 * cu, 426 * cu, 60 * cu, 139.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, cu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: pcx, cy - 82 * cu; size: 426 * cu, 60 * cu; corner: pr; color: ink; opacity: (veil) * (1 - obs) }
            box { at: pcx, cy - 82 * cu; size: 426 * cu, 60 * cu; corner: pr; stroke: 1 * cu; color: ink; opacity: hair * (1 - dd_k) }
            text "Loading weather…" { at: floor(pcx + 0.5), floor(cy - 82 * cu + 0.5); anchor: center; align: center; size: 13; width: 300 * cu; lines: 1; color: faint; family: "Space Grotesk"; show: not wx_ok }
            group {
                show: wx_ok
                group {
                    pivot: pcx - 190 * cu, cy - 90 * cu
                    scale: 1.5
                    column wx_now { at: pcx - 203 * cu, cy - 100 * cu; WxIcon(wx_kind) }
                }
                text wx_temp { at: floor(pcx - 160 * cu + 0.5), floor(cy - 92 * cu + 0.5); anchor: left center; size: 22; weight: 700; width: 70 * cu; lines: 1; color: ink; family: "Space Grotesk" }
                text wx_desc { at: floor(pcx - 160 * cu + 0.5), floor(cy - 73 * cu + 0.5); anchor: left center; size: 11.5; width: 100 * cu; lines: 1; color: faint; family: "Space Grotesk" }
                box { at: pcx - 96 * cu, cy - 82 * cu; size: 1 * cu, 40 * cu; color: ink; opacity: 12% }
                row wx_row {
                    at: floor(pcx - 90 * cu + 0.5), floor(cy - 107 * cu + 0.5)
                    gap: 1
                    for d in wx_days { WxDay(d) }
                }
            }

            //  Writing one: the field, and a button. Enter saves it as well.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: pcx, cy + 213 * cu; size: 426 * cu, 34 * cu; corner: pr } }
            DdCard(pcx, cy + 213 * cu, 426 * cu, 34 * cu, 300.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, cu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: pcx, cy + 213 * cu; size: 426 * cu, 34 * cu; corner: pr; color: ink; opacity: (veil) * (1 - obs) }
            box { at: pcx, cy + 213 * cu; size: 426 * cu, 34 * cu; corner: pr; stroke: 1 * cu; color: ink; opacity: hair * (1 - dd_k) }
            ellipse { at: pcx - 201 * cu, cy + 213 * cu; radius: 4 * cu; color: mint; opacity: 85% }
            //  An input's `at` is not its middle: it is lifted 6.3 so its text sits on the row's centre.
            input cal_new { at: floor(pcx - 189 * cu + 0.5), floor(cy + 206.7 * cu + 0.5); width: 330 * cu; size: 15; color: ink; family: "Space Grotesk"
                            placeholder: "New reminder: 3:30pm Call mom"; selection: mintlo }
            box { at: pcx + 178 * cu, cy + 213 * cu; size: 46 * cu, 24 * cu; corner: (12 * cu) * (1 - 0.85 * dd_k); color: mint; opacity: 80% + 20% * cal_add_btn.hover }
            PPillOutline(pcx + 178 * cu, cy + 213 * cu, 46 * cu, 24 * cu, 12 * cu, cal_add_btn.hover, clamp(3 * (80% + 20% * cal_add_btn.hover), 0, 1), cu)
            text "Add" { at: floor(pcx + 178 * cu + 0.5), floor(cy + 213 * cu + 0.5); anchor: center; size: 14; weight: 700; color: onmint; family: "Space Grotesk" }
            zone box cal_add_btn { at: pcx + 178 * cu, cy + 213 * cu; size: 48 * cu, 28 * cu; corner: pr; cursor: pointer }
            on press cal_add_btn { emit cal_add }
        }
        }
        //  ── the dashboard's tab row and the other two tabs ──
        //  A recessed rail with an accent capsule that slides to the tab in use, stretching with its speed and overshooting a little; each tab has a small drawn
        //  icon (a calendar, a note, a grid of apps) that takes the capsule's ink while it is under it.
        group {
            opacity: f1
            move: 0, (1 - f1) * 12 * cu
            let ty = ck + 26 * cu
            let tv = clamp(abs(vel(dtab_x)) * 0.06, 0, 0.4)
            box { at: pcx, ty; size: 356 * cu, 34 * cu; corner: (17 * cu) * (1 - 0.7 * dd_k); color: #000000; opacity: 22% }
            box { at: pcx, ty; size: 356 * cu, 34 * cu; corner: (17 * cu) * (1 - 0.7 * dd_k); stroke: 1.2 * cu; color: ink; opacity: 14% }
            box { at: pcx + (dtab_x - 1) * 118 * cu, ty; size: 122 * cu * (1 + tv), 38 * cu * (1 - 0.25 * tv); corner: (19 * cu) * (1 - 0.7 * dd_k); color: mint; opacity: 16% }
            box { at: pcx + (dtab_x - 1) * 118 * cu, ty; size: 110 * cu * (1 + tv), 28 * cu * (1 - 0.25 * tv); corner: (14 * cu) * (1 - 0.7 * dd_k); color: mint }
            repeat t in 0..3 {
                let tx = pcx + (t - 1) * 118 * cu
                let tk = if(t == 0, tf.cal, if(t == 1, tf.med, tf.app))
                let ic = mix(ink, onmint, tk)
                text pick(t, "Calendar", "Media", "Apps") { at: floor(tx + 7 * cu + 0.5), floor(ty + 0.5); anchor: center; align: center; size: 14; weight: 600 + 100 * tk; measure: dtw.$t; color: ic; opacity: 70% + 30% * max(tk, dtab_z.$t.hover); family: "Space Grotesk" }
                let ix = floor(tx + 7 * cu - dtw.$t.width / 2 - 12 * cu + 0.5)
                group {
                    pivot: ix, ty
                    scale: 1 + 0.12 * tk + 0.08 * dtab_z.$t.hover
                    opacity: 70% + 30% * max(tk, dtab_z.$t.hover)
                    //  Drawn in pencil like the other glyphs (pencil-glyphs.plm): it boils, redrawn about eight times a second, while the tab is in use or under the pointer.
                    let tz = 0.7 * cu
                    let tfm = if(tk > 0.5 or dtab_z.$t.hover > 0.5, floor(time * 8), 0)
                    group {
                        show: t == 0
                        GBox(ix, ty, -8, -6, 8, 9, 201, tz, ic, 1, tfm)
                        GLn(ix, ty, -8, -1, 8, -1, 205, tz, ic, 1, tfm)
                        GLn(ix, ty, -4, -9, -4, -4, 206, tz, ic, 1, tfm)
                        GLn(ix, ty, 4, -9, 4, -4, 207, tz, ic, 1, tfm)
                        GArc(ix, ty, 0, 4, 1.4, 0, 360, 208, tz, ic, 1, tfm)
                    }
                    group {
                        show: t == 1
                        //  The pair of beamed notes, the shape of the Music workspace's mark (PBNote).
                        GLn(ix, ty, -4.5, 5, -4.5, -7, 211, tz, ic, 1, tfm)
                        GLn(ix, ty, 4.5, 3, 4.5, -9, 212, tz, ic, 1, tfm)
                        GLn(ix, ty, -4.5, -7, 4.5, -9, 213, tz, ic, 1, tfm)
                        GLn(ix, ty, -4.5, -4.5, 4.5, -6.5, 214, tz, ic, 1, tfm)
                        GArc(ix, ty, -7, 6, 2.6, 0, 360, 215, tz, ic, 1, tfm)
                        GArc(ix, ty, -7, 6, 1.3, 0, 360, 216, tz, ic, 1, tfm)
                        GArc(ix, ty, 2, 4, 2.6, 0, 360, 217, tz, ic, 1, tfm)
                        GArc(ix, ty, 2, 4, 1.3, 0, 360, 218, tz, ic, 1, tfm)
                    }
                    group {
                        show: t == 2
                        GBox(ix, ty, -8, -8, -1, -1, 221, tz, ic, 1, tfm)
                        GBox(ix, ty, 1, -8, 8, -1, 225, tz, ic, 1, tfm)
                        GBox(ix, ty, -8, 1, -1, 8, 229, tz, ic, 1, tfm)
                        GBox(ix, ty, 1, 1, 8, 8, 233, tz, ic, 1, tfm)
                    }
                }
                zone box dtab_z.$t { at: tx, ty; size: 116 * cu, 32 * cu; corner: 16 * cu; cursor: pointer }
            }
            on press dtab_z.0 { dash_tab = dtab_cal }
            on press dtab_z.1 { dash_tab = dtab_med }
            on press dtab_z.2 { dash_tab = dtab_app }
        }
        //  The Media tab: the player's card centre stage (it is drawn on its own, made larger, see `MediaFloat`, with the spectrum in it; a plate says so here while there is none).
        group {
            show: tf.med > 0.005
            opacity: tf.med * f1
            move: 0, (1 - f1) * 12 * cu
            let mty = ck + 52 * cu                                      // the tab's top
            DmPlate(pcx, mty + 109.5 * cu, 426 * cu, md_ch * cu, 915.5, clamp(mfl, 0, 1))      // only while the card floats: with nothing playing the empty player is here
            text "The player is floating" { at: floor(pcx + 0.5), floor(mty + 101.5 * cu + 0.5); anchor: center; align: center; size: 15; color: faint; opacity: 100% - 100% * mdk; family: "Space Grotesk"; show: media_open > 0.5 and mdk < 0.5 }
            text "Drop it here to put it back" { at: floor(pcx + 0.5), floor(mty + 122.5 * cu + 0.5); anchor: center; align: center; size: 12.5; color: faint; opacity: 70% - 70% * mdk; family: "Space Grotesk"; show: media_open > 0.5 and mdk < 0.5 }
        }
        //  The Apps tab: the running windows as a map of the workspaces, a row for each one that has windows, with its number in a pill and an icon for each window (the one
        //  under the pointer opens out to show its title); then the apps that only live in the tray as a row of icons the wheel moves.
        group {
            show: tf.app > 0.005
            opacity: tf.app * f1
            move: 0, (1 - f1) * 12 * cu
            text "RUNNING WINDOWS" { at: floor(pcx - 207 * cu + 0.5), floor(ck + (aw_y + 10) * cu + 0.5); anchor: left center; size: 13.5; weight: 700; color: ink; family: "Space Grotesk" }
            text number(tasks.count, 0, " open") { at: floor(pcx + 207 * cu + 0.5), floor(ck + (aw_y + 10) * cu + 0.5); anchor: right center; align: right; size: 12; weight: 600; color: faint; family: "Space Grotesk" }
            text "No active windows" { at: floor(pcx + 0.5), floor(ck + (aw_g + 20) * cu + 0.5); anchor: center; size: 14; color: faint; family: "Space Grotesk"; show: wv_n < 1 }
            row {
                at: floor(pcx - 213 * cu + 0.5), floor(ck + aw_g * cu + 0.5)
                wrap: 2
                gap: floor(12 * cu + 0.5)
                repeat k in 1..9 {
                    group {
                        size: floor(207 * cu + 0.5), floor(wh.all * cu + 0.5)
                        show: tw.$k > 0
                        let wka = if(tw_map, if(twa.$k, 1, 0), if(ws.active == k, 1, 0))
                        box { from: 0, 0; size: 207 * cu, 128 * cu; corner: 12 * cu; color: ink; opacity: 7% + 6% * wka + 4% * wc_z.$k.hover }
                        box { from: 0, 0; size: 207 * cu, 128 * cu; corner: 12 * cu; stroke: 1.6 * cu; color: mix(ink, mint, wka); opacity: 20% + 80% * wka }
                        box { from: 6 * cu, 6 * cu; size: 195 * cu, 100 * cu; corner: 7 * cu; color: #000000; opacity: 38% }
                        box { at: 103.5 * cu, 134 * cu; size: 16 * cu, 12 * cu; corner: 2 * cu; color: ink; opacity: 12% }
                        box { at: 103.5 * cu, 138.5 * cu; size: 70 * cu, 5 * cu; corner: 2.5 * cu; color: ink; opacity: 16% }
                        zone box wc_z.$k { from: 0, 0; size: 207 * cu, 140 * cu; corner: pr; cursor: pointer; label: "Go to workspace" }
                        on press wc_z.$k { emit wcard(k) }
                        text twl.$k { at: floor(16 * cu + 0.5), floor(117 * cu + 0.5); anchor: left center; size: 14; weight: 700; color: mix(faint, mint, wka); family: "Space Grotesk" }
                        ellipse { at: 34 * cu, 117 * cu; radius: 3 * cu; color: alert; opacity: if(ws.$k.urgent and not tw_map, 100%, 0%) }
                        text number(tw.$k, 0, " windows") { at: floor(193 * cu + 0.5), floor(117 * cu + 0.5); anchor: right center; align: right; size: 11.5; weight: 600; color: faint; show: tw.$k > 1; family: "Space Grotesk" }
                        text "1 window" { at: floor(193 * cu + 0.5), floor(117 * cu + 0.5); anchor: right center; align: right; size: 11.5; weight: 600; color: faint; show: tw.$k == 1; family: "Space Grotesk" }
                        for w in tasks { MiniWin(w, k, tw.$k, focus: task_focus, kill: task_close) { show: w.wsn == k } }
                    }
                }
            }
            group {
                show: tw.9 > 0
                let wo_y = ck + (aw_g + wg_h + 12) * cu
                box { at: pcx, wo_y + wo_h * cu / 2; size: 426 * cu, wo_h * cu; corner: pr; color: ink; opacity: 6% }
                text "Other" { at: floor(pcx - 199 * cu + 0.5), floor(wo_y + 15 * cu + 0.5); anchor: left center; size: 14; weight: 700; color: faint; family: "Space Grotesk" }
                row {
                    at: floor(pcx - 203 * cu + 0.5), floor(wo_y + 30 * cu + 0.5)
                    wrap: 10
                    gap: floor(6 * cu + 0.5)
                    for w in tasks { WinChip(w, 9, focus: task_focus, kill: task_close) { show: w.wsn == 9 } }
                }
            }
            group {
                show: trays.count > 0
                text "BACKGROUND APPS" { at: floor(pcx - 207 * cu + 0.5), floor(ck + (at_y + 10) * cu + 0.5); anchor: left center; size: 13.5; weight: 700; color: ink; family: "Space Grotesk" }
                box { at: pcx + 168 * cu, ck + (at_y + 10) * cu; size: 86 * cu, 20 * cu; corner: (10 * cu) * (1 - 0.85 * dd_k); color: if(tray_only_pinned, mint, ink); opacity: if(tray_only_pinned, 22%, 8% + 10% * tray_mode_hit.hover) }
                PPillOutline(pcx + 168 * cu, ck + (at_y + 10) * cu, 86 * cu, 20 * cu, 10 * cu, tray_mode_hit.hover, clamp(3 * (if(tray_only_pinned, 22%, 8% + 10% * tray_mode_hit.hover)), 0, 1), cu)
                text "Bar: pinned" { at: floor(pcx + 168 * cu + 0.5), floor(ck + (at_y + 10) * cu + 0.5); anchor: center; align: center; size: 13; weight: 600; width: 82 * cu; lines: 1; color: mint; show: tray_only_pinned; family: "Space Grotesk" }
                text "Bar: all" { at: floor(pcx + 168 * cu + 0.5), floor(ck + (at_y + 10) * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 82 * cu; lines: 1; color: ink; opacity: 85%; show: not tray_only_pinned; family: "Space Grotesk" }
                zone box tray_mode_hit { at: pcx + 168 * cu, ck + (at_y + 10) * cu; size: 88 * cu, 22 * cu; corner: 11 * cu; cursor: pointer }
                on press tray_mode_hit { emit tray_mode }
                row tray_row {
                    at: floor(pcx - 213 * cu + 0.5), floor(ck + at_g * cu - 26 * cu + 0.5)
                    view: 426 * cu, 60 * cu
                    align: end
                    gap: floor(6 * cu + 0.5)
                    for a in trays { TrayIcon(a, click: tray_click, pin: tray_pin, menu: tray_menu_open) }
                }
            }
        }
        //  Opening the calendar puts the cursor in the field and the grid back on today.
        on change panel while panel == calendar { focus cal_new; emit cal_open }
        }
    }
}
