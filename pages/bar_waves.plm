            box { at: fwx_17 + fwdx_17 * fwh_17 * 0.5 + if(fwh_17 > 1, 0, 30000), fwy_17 + fwdy_17 * fwh_17 * 0.5; size: fw.bw * 0.4 + fwh_17 * 0.09, fw.bw * 0.4 + fwh_17 * 0.09; corner: 0; rotate: (45 + fwh_17 * 0.3) * 1deg; blend: fw.bl * u * bk * 0.3 }
