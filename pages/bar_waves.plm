            box { at: fwx_11 + fwdx_11 * fwh_11 * 0.5 + if(fwh_11 > 1, 0, 30000), fwy_11 + fwdy_11 * fwh_11 * 0.5; size: fw.bw * 0.4 + fwh_11 * 0.09, fw.bw * 0.4 + fwh_11 * 0.09; corner: 0; rotate: (45 + fwh_11 * 0.3) * 1deg; blend: fw.bl * u * bk * 0.3 }
