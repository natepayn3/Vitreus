            box { at: fwx_21 + fwdx_21 * fwh_21 * 0.5 + if(fwh_21 > 1, 0, 30000), fwy_21 + fwdy_21 * fwh_21 * 0.5; size: fw.bw * 0.5 + fwh_21 * 0.12, fw.bw * 0.5 + fwh_21 * 0.12; corner: fw.bw * 0.1; rotate: fwh_21 * 0.4 * 1deg; blend: fw.bl * u * bk * 0.3 }
            ellipse { at: fwx_22 + fwdx_22 * fwh_22 * 0.5 + if(fwh_22 > 1, 0, 30000), fwy_22 + fwdy_22 * fwh_22 * 0.5; radius: fw.bw * 0.25 + fwh_22 * 0.06; blend: fw.bl * u * bk * 0.3 }
            box { at: fwx_23 + fwdx_23 * fwh_23 * 0.5 + if(fwh_23 > 1, 0, 30000), fwy_23 + fwdy_23 * fwh_23 * 0.5; size: fw.bw * 0.4 + fwh_23 * 0.09, fw.bw * 0.4 + fwh_23 * 0.09; corner: 0; rotate: (45 + fwh_23 * 0.3) * 1deg; blend: fw.bl * u * bk * 0.3 }
            box { at: fwx_24 + fwdx_24 * fwh_24 * 0.5 + if(fwh_24 > 1, 0, 30000), fwy_24 + fwdy_24 * fwh_24 * 0.5; size: fw.bw * 0.5 + fwh_24 * 0.12, fw.bw * 0.5 + fwh_24 * 0.12; corner: fw.bw * 0.1; rotate: fwh_24 * 0.4 * 1deg; blend: fw.bl * u * bk * 0.3 }
