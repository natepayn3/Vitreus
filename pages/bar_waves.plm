part BarWaves {
            //  The audio visualiser: the edge of the screen rising into the music, as columns of the same glass standing on the frame's inner edge and melted into it (and into each other) like a drawer's neck.
            //  Where each stands, which way it points and how long it is are worked out in vitreus.plm (`fwx_*`, `fwy_*`, `fwdx_*`, `fwdy_*`, `fwh_*`) from the options (Settings > Widgets): along the bottom, the top,
            //  the left or the right, or fanned out of the four corners. Without the frame (the Island) they stand on the screen's edge. Moved off the screen while a column has no length (`show:` does not take a shape off the glass).
            box { at: fwx_0 + fwdx_0 * fwh_0 * 0.5 + if(fwh_0 > 1, 0, 30000), fwy_0 + fwdy_0 * fwh_0 * 0.5; size: fw.bw * 0.5 + fwh_0 * 0.12, fw.bw * 0.5 + fwh_0 * 0.12; corner: fw.bw * 0.1; rotate: fwh_0 * 0.4 * 1deg; blend: fw.bl * u * bk * 0.3 }
            ellipse { at: fwx_1 + fwdx_1 * fwh_1 * 0.5 + if(fwh_1 > 1, 0, 30000), fwy_1 + fwdy_1 * fwh_1 * 0.5; radius: fw.bw * 0.25 + fwh_1 * 0.06; blend: fw.bl * u * bk * 0.3 }
            box { at: fwx_2 + fwdx_2 * fwh_2 * 0.5 + if(fwh_2 > 1, 0, 30000), fwy_2 + fwdy_2 * fwh_2 * 0.5; size: fw.bw * 0.4 + fwh_2 * 0.09, fw.bw * 0.4 + fwh_2 * 0.09; corner: 0; rotate: (45 + fwh_2 * 0.3) * 1deg; blend: fw.bl * u * bk * 0.3 }
            box { at: fwx_3 + fwdx_3 * fwh_3 * 0.5 + if(fwh_3 > 1, 0, 30000), fwy_3 + fwdy_3 * fwh_3 * 0.5; size: fw.bw * 0.5 + fwh_3 * 0.12, fw.bw * 0.5 + fwh_3 * 0.12; corner: fw.bw * 0.1; rotate: fwh_3 * 0.4 * 1deg; blend: fw.bl * u * bk * 0.3 }
            ellipse { at: fwx_4 + fwdx_4 * fwh_4 * 0.5 + if(fwh_4 > 1, 0, 30000), fwy_4 + fwdy_4 * fwh_4 * 0.5; radius: fw.bw * 0.25 + fwh_4 * 0.06; blend: fw.bl * u * bk * 0.3 }
            box { at: fwx_5 + fwdx_5 * fwh_5 * 0.5 + if(fwh_5 > 1, 0, 30000), fwy_5 + fwdy_5 * fwh_5 * 0.5; size: fw.bw * 0.4 + fwh_5 * 0.09, fw.bw * 0.4 + fwh_5 * 0.09; corner: 0; rotate: (45 + fwh_5 * 0.3) * 1deg; blend: fw.bl * u * bk * 0.3 }
            box { at: fwx_6 + fwdx_6 * fwh_6 * 0.5 + if(fwh_6 > 1, 0, 30000), fwy_6 + fwdy_6 * fwh_6 * 0.5; size: fw.bw * 0.5 + fwh_6 * 0.12, fw.bw * 0.5 + fwh_6 * 0.12; corner: fw.bw * 0.1; rotate: fwh_6 * 0.4 * 1deg; blend: fw.bl * u * bk * 0.3 }
            ellipse { at: fwx_7 + fwdx_7 * fwh_7 * 0.5 + if(fwh_7 > 1, 0, 30000), fwy_7 + fwdy_7 * fwh_7 * 0.5; radius: fw.bw * 0.25 + fwh_7 * 0.06; blend: fw.bl * u * bk * 0.3 }
            box { at: fwx_8 + fwdx_8 * fwh_8 * 0.5 + if(fwh_8 > 1, 0, 30000), fwy_8 + fwdy_8 * fwh_8 * 0.5; size: fw.bw * 0.4 + fwh_8 * 0.09, fw.bw * 0.4 + fwh_8 * 0.09; corner: 0; rotate: (45 + fwh_8 * 0.3) * 1deg; blend: fw.bl * u * bk * 0.3 }
            box { at: fwx_9 + fwdx_9 * fwh_9 * 0.5 + if(fwh_9 > 1, 0, 30000), fwy_9 + fwdy_9 * fwh_9 * 0.5; size: fw.bw * 0.5 + fwh_9 * 0.12, fw.bw * 0.5 + fwh_9 * 0.12; corner: fw.bw * 0.1; rotate: fwh_9 * 0.4 * 1deg; blend: fw.bl * u * bk * 0.3 }
