part Vpn {
        //  ── VPN page: BEGIN ──
        //  Settings > VPN. Scrolls like Notifications: a clipped viewport, the content moved by a whole-pixel `vpn.off`. Three cards: what is
        //  connected, the profiles NetworkManager holds, and the form to add one (WireGuard, OpenVPN, or a file). See "Settings > VPN" in the logic.
        group {
            show: set_pgv > 0.01
            opacity: set_pgv
            let vpn.h = vpn.ab + 84 + vpn.fh + 44 + 12
            let vpn.sc = clamp(vpn_scroll, 0, max(0, vpn.h - set.h))
            let vpn.off = floor(vpn.sc * pu + 0.5)
            clip box { at: spx + 224 * pu, sby + set.h / 2 * pu; size: 456 * pu, set.h * pu }
            zone box vpn_wheel { at: spx + 219 * pu, sby + set.h / 2 * pu; size: 446 * pu, set.h * pu }
            on scroll vpn_wheel while not (vpn_mode == vpm_imp and vpn_fmore and vpn_fwheel.hover) { vpn_scroll_to = clamp(vpn_scroll_to - wheel * 44, 0, max(0, vpn.h - set.h)) }
            group {
                move: 0, -vpn.off
            box { at: spx + 219 * pu, sby + 42 * pu; size: 438 * pu, 68 * pu; corner: 14 * pu; color: ink; opacity: veil }
            box { at: spx + 36 * pu, sby + 42 * pu; size: 40 * pu, 40 * pu; corner: 12 * pu; color: if(vpn_on, mint, ink); opacity: if(vpn_on, 22%, 8%) }
            path { at: spx + 36 * pu, sby + 42 * pu; stroke: 1.8 * pu; color: if(vpn_on, mint, faint); move 0, -9 * pu; line 8 * pu, -6 * pu; line 8 * pu, 1 * pu; line 0, 10 * pu; line -8 * pu, 1 * pu; line -8 * pu, -6 * pu; close }
            path { at: spx + 36 * pu, sby + 43 * pu; stroke: 1.8 * pu; color: if(vpn_on, mint, faint); opacity: if(vpn_on, 100%, 0%); move -3.5 * pu, 0; line -1 * pu, 2.5 * pu; line 4 * pu, -3 * pu }
            text "STATUS" { at: floor(spx + 70 * pu + 0.5), floor(sby + (24) * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text vpn_title { at: floor(spx + 70 * pu + 0.5), floor(sby + 43 * pu + 0.5); anchor: left center; size: 17.5; weight: 700; width: 230 * pu; lines: 1; color: if(vpn_on, mint, ink); family: "Space Grotesk" }
            text vpn_sub { at: floor(spx + 70 * pu + 0.5), floor(sby + 60 * pu + 0.5); anchor: left center; size: 13.5; width: 230 * pu; lines: 1; color: faint; family: "Space Grotesk" }
            group {
                show: vpn_on
                box { at: spx + 380 * pu, sby + 42 * pu; size: 96 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 10% + 10% * vpn_dn_hit.hover }
                text "Disconnect" { at: floor(spx + 380 * pu + 0.5), floor(sby + 42 * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: ink; family: "Space Grotesk" }
            }
            zone box vpn_dn_hit { at: spx + 380 * pu, sby + 42 * pu; size: 98 * pu, 30 * pu; corner: 15 * pu; cursor: pointer; active: vpn_on and not vpn_busy }
            on press vpn_dn_hit { emit vpn_down }
            box { at: spx + 219 * pu, sby + (vpn.pb + vpn.pbh / 2) * pu; size: 438 * pu, vpn.pbh * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "PROFILES" { at: floor(spx + 14 * pu + 0.5), floor(sby + (vpn.pb + 18) * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            box { at: spx + 424 * pu - 11 * pu, sby + (vpn.pb + 18) * pu; size: 22 * pu, 16 * pu; corner: 8 * pu; color: ink; opacity: 10% }
            text number(vpn_count, 0) { at: floor(spx + 413 * pu + 0.5), floor(sby + (vpn.pb + 18) * pu + 0.5); anchor: center; align: center; size: 12; weight: 700; color: ink; family: "Space Grotesk" }
            text "No VPN profiles yet: add one below" { at: floor(spx + 219 * pu + 0.5), floor(sby + (vpn.pb + 50) * pu + 0.5); anchor: center; align: center; size: 14.5; color: faint; show: vpn_count < 1; family: "Space Grotesk" }
            repeat i in 0..8 {
                let ry = vpn.pb + 34 + i * 32 + 16
                ellipse { at: spx + 24 * pu, sby + ry * pu; radius: 3.5 * pu; color: if(vpn_r.$i.active, mint, faint); opacity: if(vpn_r.$i.on, if(vpn_r.$i.active, 100%, 45%), 0%) }
                text vpn_r.$i.name { at: floor(spx + 38 * pu + 0.5), floor(sby + ry * pu + 0.5); anchor: left center; size: 15.5; weight: 700; width: 150 * pu; lines: 1; color: if(vpn_r.$i.active, mint, ink); show: vpn_r.$i.on; family: "Space Grotesk" }
                box { at: spx + 232 * pu, sby + ry * pu; size: 72 * pu, 20 * pu; corner: 10 * pu; color: ink; opacity: if(vpn_r.$i.on, 8%, 0%) }
                text vpn_r.$i.sub { at: floor(spx + 232 * pu + 0.5), floor(sby + ry * pu + 0.5); anchor: center; align: center; size: 12.5; width: 68 * pu; lines: 1; color: faint; show: vpn_r.$i.on; family: "Space Grotesk" }
                box { at: spx + 330 * pu, sby + ry * pu; size: 96 * pu, 24 * pu; corner: 12 * pu; color: if(vpn_r.$i.active, ink, mint); opacity: if(vpn_r.$i.on and vpn_arm != i, if(vpn_r.$i.active, 10% + 9% * vpn_tg_hit.$i.hover, 18% + 14% * vpn_tg_hit.$i.hover), 0%) }
                text "Disconnect" { at: floor(spx + 330 * pu + 0.5), floor(sby + ry * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 600; color: if(vpn_r.$i.active, ink, mint); show: vpn_r.$i.on and vpn_r.$i.active and vpn_arm != i; family: "Space Grotesk" }
                text "Connect" { at: floor(spx + 330 * pu + 0.5), floor(sby + ry * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 600; color: if(vpn_r.$i.active, ink, mint); show: vpn_r.$i.on and not vpn_r.$i.active and vpn_arm != i; family: "Space Grotesk" }
                zone box vpn_tg_hit.$i { at: spx + 330 * pu, sby + ry * pu; size: 98 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (vpn_r.$i.on and vpn_arm != i and not vpn_busy) and (((ry) * pu - vpn.off) > 14 * pu and ((ry) * pu - vpn.off) < 440 * pu) }
                on press vpn_tg_hit.$i { emit vpn_toggle(i) }
                box { at: spx + 330 * pu, sby + ry * pu; size: 96 * pu, 24 * pu; corner: 12 * pu; color: alert; opacity: if(vpn_r.$i.on and vpn_arm == i, 26% + 14% * vpn_dl_hit.$i.hover, 0%) }
                text "Delete?" { at: floor(spx + 330 * pu + 0.5), floor(sby + ry * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; color: alert; show: vpn_r.$i.on and vpn_arm == i; family: "Space Grotesk" }
                zone box vpn_dl_hit.$i { at: spx + 330 * pu, sby + ry * pu; size: 98 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (vpn_r.$i.on and vpn_arm == i and not vpn_busy) and (((ry) * pu - vpn.off) > 14 * pu and ((ry) * pu - vpn.off) < 440 * pu) }
                on press vpn_dl_hit.$i { emit vpn_delete(i) }
                line { from: spx + 415.5 * pu, sby + (ry - 3.5) * pu; to: spx + 422.5 * pu, sby + (ry + 3.5) * pu; width: 1.4 * pu; color: ink; opacity: if(vpn_r.$i.on, 45% + 45% * vpn_x_hit.$i.hover, 0%) }
                line { from: spx + 422.5 * pu, sby + (ry - 3.5) * pu; to: spx + 415.5 * pu, sby + (ry + 3.5) * pu; width: 1.4 * pu; color: ink; opacity: if(vpn_r.$i.on, 45% + 45% * vpn_x_hit.$i.hover, 0%) }
                zone box vpn_x_hit.$i { at: spx + 419 * pu, sby + ry * pu; size: 22 * pu, 22 * pu; corner: 11 * pu; cursor: pointer; active: (vpn_r.$i.on and not vpn_busy) and (((ry) * pu - vpn.off) > 14 * pu and ((ry) * pu - vpn.off) < 440 * pu) }
                on press vpn_x_hit.$i { emit vpn_arm_ask(i) }
            }
            box { at: spx + 219 * pu, sby + (vpn.ab + (84 + vpn.fh + 44) / 2) * pu; size: 438 * pu, (84 + vpn.fh + 44) * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "ADD A PROFILE" { at: floor(spx + 14 * pu + 0.5), floor(sby + (vpn.ab + 20) * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            box { at: spx + 79.7 * pu, sby + (vpn.ab + 52) * pu; size: 131.3 * pu, 26 * pu; corner: 13 * pu; color: if(vpn_mode == vpm_wg, mint, ink); opacity: if(vpn_mode == vpm_wg, 24%, 8% + 9% * vpn_m0_hit.hover) }
            text "WireGuard" { at: floor(spx + 79.7 * pu + 0.5), floor(sby + (vpn.ab + 52) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: if(vpn_mode == vpm_wg, mint, ink); opacity: if(vpn_mode == vpm_wg, 100%, 85%); family: "Space Grotesk" }
            zone box vpn_m0_hit { at: spx + 79.7 * pu, sby + (vpn.ab + 52) * pu; size: 130 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: (((vpn.ab + 52) * pu - vpn.off) > 14 * pu and ((vpn.ab + 52) * pu - vpn.off) < 440 * pu) }
            on press vpn_m0_hit { vpn_mode = vpm_wg }
            box { at: spx + 219 * pu, sby + (vpn.ab + 52) * pu; size: 131.3 * pu, 26 * pu; corner: 13 * pu; color: if(vpn_mode == vpm_ovpn, mint, ink); opacity: if(vpn_mode == vpm_ovpn, 24%, 8% + 9% * vpn_m1_hit.hover) }
            text "OpenVPN" { at: floor(spx + 219 * pu + 0.5), floor(sby + (vpn.ab + 52) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: if(vpn_mode == vpm_ovpn, mint, ink); opacity: if(vpn_mode == vpm_ovpn, 100%, 85%); family: "Space Grotesk" }
            zone box vpn_m1_hit { at: spx + 219 * pu, sby + (vpn.ab + 52) * pu; size: 130 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: (((vpn.ab + 52) * pu - vpn.off) > 14 * pu and ((vpn.ab + 52) * pu - vpn.off) < 440 * pu) }
            on press vpn_m1_hit { vpn_mode = vpm_ovpn }
            box { at: spx + 358.3 * pu, sby + (vpn.ab + 52) * pu; size: 131.3 * pu, 26 * pu; corner: 13 * pu; color: if(vpn_mode == vpm_imp, mint, ink); opacity: if(vpn_mode == vpm_imp, 24%, 8% + 9% * vpn_m2_hit.hover) }
            text "Import file" { at: floor(spx + 358.3 * pu + 0.5), floor(sby + (vpn.ab + 52) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: if(vpn_mode == vpm_imp, mint, ink); opacity: if(vpn_mode == vpm_imp, 100%, 85%); family: "Space Grotesk" }
            zone box vpn_m2_hit { at: spx + 358.3 * pu, sby + (vpn.ab + 52) * pu; size: 130 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: (((vpn.ab + 52) * pu - vpn.off) > 14 * pu and ((vpn.ab + 52) * pu - vpn.off) < 440 * pu) }
            on press vpn_m2_hit { vpn_mode = vpm_imp }
            group {
                show: vpn_mode == vpm_wg
            box { at: spx + 113.5 * pu, sby + (vpn.ab + 84 + 0 * 36 + 17) * pu; size: 199 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_wg and (((vpn.ab + 84 + 0 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 0 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpnw_name { at: floor(spx + 26.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 0 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 175 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "Name" }
            }
            group {
                show: vpn_mode == vpm_wg
            box { at: spx + 324.5 * pu, sby + (vpn.ab + 84 + 0 * 36 + 17) * pu; size: 199 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_wg and (((vpn.ab + 84 + 0 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 0 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpnw_addr { at: floor(spx + 237.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 0 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 175 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "Address (10.2.0.2/32)" }
            }
            group {
                show: vpn_mode == vpm_wg
            box { at: spx + 219 * pu, sby + (vpn.ab + 84 + 1 * 36 + 17) * pu; size: 410 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_wg and (((vpn.ab + 84 + 1 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 1 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpnw_key { at: floor(spx + 26.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 1 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 386 * pu; size: 14; color: ink; family: "Space Grotesk"; secret: true; placeholder: "Your private key" }
            }
            group {
                show: vpn_mode == vpm_wg
            box { at: spx + 219 * pu, sby + (vpn.ab + 84 + 2 * 36 + 17) * pu; size: 410 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_wg and (((vpn.ab + 84 + 2 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 2 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpnw_peer { at: floor(spx + 26.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 2 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 386 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "Server's public key" }
            }
            group {
                show: vpn_mode == vpm_wg
            box { at: spx + 113.5 * pu, sby + (vpn.ab + 84 + 3 * 36 + 17) * pu; size: 199 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_wg and (((vpn.ab + 84 + 3 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 3 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpnw_end { at: floor(spx + 26.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 3 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 175 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "Endpoint (host:51820)" }
            }
            group {
                show: vpn_mode == vpm_wg
            box { at: spx + 324.5 * pu, sby + (vpn.ab + 84 + 3 * 36 + 17) * pu; size: 199 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_wg and (((vpn.ab + 84 + 3 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 3 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpnw_dns { at: floor(spx + 237.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 3 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 175 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "DNS (optional)" }
            }
            group {
                show: vpn_mode == vpm_wg
            box { at: spx + 113.5 * pu, sby + (vpn.ab + 84 + 4 * 36 + 17) * pu; size: 199 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_wg and (((vpn.ab + 84 + 4 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 4 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpnw_ips { at: floor(spx + 26.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 4 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 175 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "Allowed IPs (all traffic)" }
            }
            group {
                show: vpn_mode == vpm_wg
                box { at: spx + 324.5 * pu, sby + (vpn.ab + 84 + 4 * 36 + 17) * pu; size: 199 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_wg and (((vpn.ab + 84 + 4 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 4 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpnw_psk { at: floor(spx + 237.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 4 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 175 * pu; size: 14; color: ink; family: "Space Grotesk"; secret: true; placeholder: "Preshared key (optional)" }
                on submit vpnw_psk { emit vpn_add_wg }
            }
            group {
                show: vpn_mode == vpm_ovpn
            box { at: spx + 113.5 * pu, sby + (vpn.ab + 84 + 0 * 36 + 17) * pu; size: 199 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_ovpn and (((vpn.ab + 84 + 0 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 0 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpno_name { at: floor(spx + 26.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 0 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 175 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "Name" }
            }
            group {
                show: vpn_mode == vpm_ovpn
            box { at: spx + 324.5 * pu, sby + (vpn.ab + 84 + 0 * 36 + 17) * pu; size: 199 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_ovpn and (((vpn.ab + 84 + 0 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 0 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpno_server { at: floor(spx + 237.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 0 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 175 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "Server (host or address)" }
            }
            group {
                show: vpn_mode == vpm_ovpn
            box { at: spx + 113.5 * pu, sby + (vpn.ab + 84 + 1 * 36 + 17) * pu; size: 199 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_ovpn and (((vpn.ab + 84 + 1 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 1 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpno_port { at: floor(spx + 26.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 1 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 175 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "Port (1194)" }
            }
            group {
                show: vpn_mode == vpm_ovpn
            box { at: spx + 113.5 * pu, sby + (vpn.ab + 84 + 2 * 36 + 17) * pu; size: 199 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_ovpn and (((vpn.ab + 84 + 2 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 2 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpno_user { at: floor(spx + 26.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 2 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 175 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "User name" }
            }
            group {
                show: vpn_mode == vpm_ovpn
            box { at: spx + 324.5 * pu, sby + (vpn.ab + 84 + 2 * 36 + 17) * pu; size: 199 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_ovpn and (((vpn.ab + 84 + 2 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 2 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpno_pw { at: floor(spx + 237.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 2 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 175 * pu; size: 14; color: ink; family: "Space Grotesk"; secret: true; placeholder: "Password" }
            }
            group {
                show: vpn_mode == vpm_ovpn
                box { at: spx + 219 * pu, sby + (vpn.ab + 84 + 3 * 36 + 17) * pu; size: 410 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_ovpn and (((vpn.ab + 84 + 3 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 3 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpno_ca { at: floor(spx + 26.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 3 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 386 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "CA certificate file (optional)" }
                on submit vpno_ca { emit vpn_add_ovpn }
            }
            group {
                show: vpn_mode == vpm_imp
                box { at: spx + 219 * pu, sby + (vpn.ab + 84 + 0 * 36 + 17) * pu; size: 410 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% }
            }
            group {
                show: vpn_mode == vpm_imp and (((vpn.ab + 84 + 0 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 0 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpn_file { at: floor(spx + 26.0 * pu + 0.5), floor(sby + (vpn.ab + 84 + 0 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 386 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "Pick a file below, or paste its path" }
                on submit vpn_file { emit vpn_import }
            }
            group {
                show: vpn_mode == vpm_ovpn
                box { at: spx + 273 * pu, sby + (vpn.ab + 84 + 1 * 36 + 17) * pu; size: 98 * pu, 26 * pu; corner: 13 * pu; color: if(not vpn_tcp, mint, ink); opacity: if(not vpn_tcp, 24%, 8% + 9% * vpn_p0_hit.hover) }
                text "UDP" { at: floor(spx + 273 * pu + 0.5), floor(sby + (vpn.ab + 84 + 1 * 36 + 17) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: if(not vpn_tcp, mint, ink); family: "Space Grotesk" }
            }
            zone box vpn_p0_hit { at: spx + 273 * pu, sby + (vpn.ab + 84 + 1 * 36 + 17) * pu; size: 100 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: vpn_mode == vpm_ovpn and (((vpn.ab + 84 + 1 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 1 * 36 + 17) * pu - vpn.off) < 440 * pu) }
            on press vpn_p0_hit { vpn_tcp = false }
            group {
                show: vpn_mode == vpm_ovpn
                box { at: spx + 375 * pu, sby + (vpn.ab + 84 + 1 * 36 + 17) * pu; size: 98 * pu, 26 * pu; corner: 13 * pu; color: if(vpn_tcp, mint, ink); opacity: if(vpn_tcp, 24%, 8% + 9% * vpn_p1_hit.hover) }
                text "TCP" { at: floor(spx + 375 * pu + 0.5), floor(sby + (vpn.ab + 84 + 1 * 36 + 17) * pu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: if(vpn_tcp, mint, ink); family: "Space Grotesk" }
            }
            zone box vpn_p1_hit { at: spx + 375 * pu, sby + (vpn.ab + 84 + 1 * 36 + 17) * pu; size: 100 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: vpn_mode == vpm_ovpn and (((vpn.ab + 84 + 1 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 1 * 36 + 17) * pu - vpn.off) < 440 * pu) }
            on press vpn_p1_hit { vpn_tcp = true }
            group {
                show: vpn_mode == vpm_imp
                text vpn_dir { at: floor(spx + 14 * pu + 0.5), floor(sby + (vpn.ab + 84 + 48) * pu + 0.5); anchor: left center; size: 12.5; weight: 600; width: 410 * pu; lines: 1; color: faint; family: "Space Grotesk" }
                box { at: spx + 219 * pu, sby + (vpn.ab + 84 + 62 + 108) * pu; size: 410 * pu, 216 * pu; corner: 12 * pu; color: ink; opacity: 6% }
                text "No folders or .conf / .ovpn files here" { at: floor(spx + 219 * pu + 0.5), floor(sby + (vpn.ab + 84 + 62 + 108) * pu + 0.5); anchor: center; align: center; size: 14; color: faint; show: not vpn_f.0.on; family: "Space Grotesk" }
            }
            zone box vpn_fwheel { at: spx + 219 * pu, sby + (vpn.ab + 84 + 62 + 108) * pu; size: 410 * pu, 216 * pu; active: vpn_mode == vpm_imp and vpn_fmore and (((vpn.ab + 84 + 170) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + 170) * pu - vpn.off) < 440 * pu) }
            on scroll vpn_fwheel { emit vpn_fscroll(wheel) }
            repeat i in 0..8 {
                let fy = vpn.ab + 84 + 62 + 4 + i * 26 + 13
                box { at: spx + 219 * pu, sby + fy * pu; size: 402 * pu, 24 * pu; corner: 9 * pu; color: mint; opacity: if(vpn_mode == vpm_imp and vpn_f.$i.on, 14% * vpn_ff_hit.$i.hover, 0%) }
                group {
                    show: vpn_mode == vpm_imp and vpn_f.$i.on and vpn_f.$i.dir
                    box { at: spx + 30 * pu, sby + (fy + 1) * pu; size: 14 * pu, 10 * pu; corner: 2 * pu; stroke: 1.3 * pu; color: faint }
                    box { at: spx + 26.5 * pu, sby + (fy - 5.5) * pu; size: 6 * pu, 3 * pu; corner: 1 * pu; color: faint }
                }
                group {
                    show: vpn_mode == vpm_imp and vpn_f.$i.on and not vpn_f.$i.dir
                    box { at: spx + 30 * pu, sby + fy * pu; size: 11 * pu, 14 * pu; corner: 2 * pu; stroke: 1.3 * pu; color: mint }
                    line { from: spx + 27.5 * pu, sby + (fy - 1.5) * pu; to: spx + 32.5 * pu, sby + (fy - 1.5) * pu; width: 1.1 * pu; color: mint }
                    line { from: spx + 27.5 * pu, sby + (fy + 2) * pu; to: spx + 32.5 * pu, sby + (fy + 2) * pu; width: 1.1 * pu; color: mint }
                }
                text vpn_f.$i.name { at: floor(spx + 46 * pu + 0.5), floor(sby + fy * pu + 0.5); anchor: left center; size: 14.5; weight: 600; width: 360 * pu; lines: 1; color: if(vpn_f.$i.dir, ink, mint); show: vpn_mode == vpm_imp and vpn_f.$i.on; family: "Space Grotesk" }
                zone box vpn_ff_hit.$i { at: spx + 219 * pu, sby + fy * pu; size: 402 * pu, 24 * pu; corner: 9 * pu; cursor: pointer; active: (vpn_mode == vpm_imp and vpn_f.$i.on) and (((fy) * pu - vpn.off) > 14 * pu and ((fy) * pu - vpn.off) < 440 * pu) }
                on press vpn_ff_hit.$i { emit vpn_fpick(i) }
            }
            text vpn_msg { at: floor(spx + 14 * pu + 0.5), floor(sby + (vpn.ab + 84 + vpn.fh + 24) * pu + 0.5); anchor: left center; size: 13; width: 290 * pu; lines: 2; color: mint; family: "Space Grotesk" }
            box { at: spx + 370 * pu, sby + (vpn.ab + 84 + vpn.fh + 24) * pu; size: 108 * pu, 28 * pu; corner: 14 * pu; color: mint; opacity: if(vpn_busy, 35%, 85% + 15% * vpn_add_hit.hover) }
            text "Add profile" { at: floor(spx + 370 * pu + 0.5), floor(sby + (vpn.ab + 84 + vpn.fh + 24) * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; color: onmint; show: vpn_mode != vpm_imp; family: "Space Grotesk" }
            text "Import" { at: floor(spx + 370 * pu + 0.5), floor(sby + (vpn.ab + 84 + vpn.fh + 24) * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; color: onmint; show: vpn_mode == vpm_imp; family: "Space Grotesk" }
            zone box vpn_add_hit { at: spx + 370 * pu, sby + (vpn.ab + 84 + vpn.fh + 24) * pu; size: 110 * pu, 30 * pu; corner: 15 * pu; cursor: pointer; active: not vpn_busy and (((vpn.ab + 84 + vpn.fh + 24) * pu - vpn.off) > 14 * pu and ((vpn.ab + 84 + vpn.fh + 24) * pu - vpn.off) < 440 * pu) }
            on press vpn_add_hit while vpn_mode == vpm_wg { emit vpn_add_wg }
            on press vpn_add_hit while vpn_mode == vpm_ovpn { emit vpn_add_ovpn }
            on press vpn_add_hit while vpn_mode == vpm_imp { emit vpn_import }
            }
            let vpn.thh = set.h * set.h / vpn.h
            let vpn.thy = vpn.thh / 2 + vpn.sc / max(1, vpn.h - set.h) * (set.h - vpn.thh)
            box { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: 6% }
            box { at: spx + 442 * pu, sby + vpn.thy * pu; size: 3 * pu, vpn.thh * pu; corner: 1.5 * pu; color: mint; opacity: 55% }
            let vpn.cue = clamp((vpn.h - set.h - vpn.sc) / 24, 0, 1)
            let vpn.cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * vpn.cue }
            }
            box { at: spx + 224 * pu, vpn.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * vpn.cue }
            box { at: spx + 224 * pu, vpn.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * vpn_cue_hit.hover) * vpn.cue }
            path { at: spx + 204 * pu, vpn.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: vpn.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, vpn.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: vpn.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            text "More" { at: floor(spx + 232 * pu + 0.5), floor(vpn.cuey + 0.5); anchor: center; size: 15; weight: 700; color: ink; opacity: vpn.cue; family: "Space Grotesk" }
            zone box vpn_cue_hit { at: spx + 224 * pu, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: vpn.cue > 0.5 }
            on press vpn_cue_hit { vpn_scroll_to = clamp(vpn_scroll_to + 342, 0, max(0, vpn.h - set.h)) }
            zone box vpn_bar_hit { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: vpn.h > set.h }
            on press vpn_bar_hit { vpn_scroll_to = clamp(((pointer.y - sby) / pu - vpn.thh / 2) / max(1, set.h - vpn.thh) * (vpn.h - set.h), 0, max(0, vpn.h - set.h)) }
            on drag vpn_bar_hit { vpn_scroll_to = clamp(((pointer.y - sby) / pu - vpn.thh / 2) / max(1, set.h - vpn.thh) * (vpn.h - set.h), 0, max(0, vpn.h - set.h)) }
        }
        //  ── VPN page: END ──
}
