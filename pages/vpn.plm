part Vpn {
        //  ── VPN page: BEGIN ──
        //  Settings > VPN. Scrolls like Notifications: a clipped viewport, the content moved by a whole-pixel `vpn.off`. Three cards (four with NordVPN): what is
        //  connected, NordVPN when it is installed, the profiles NetworkManager holds, and the form to add one (WireGuard, OpenVPN, or a file). See "Settings > VPN" in the logic.
        group {
            show: set_pgv > 0.01
            opacity: set_pgv
            let vpn.wt = vpn.ab + 59 + vpn.fh + 52 + 30        // the weather card, under the add card and its own name
            let vpn.h = vpn.wt + 122 + 12
            let wxcf0 = if(wx_c, 0, 1)
            let wxcf1 = if(wx_c, 1, 0)
            let vpn.sc = clamp(vpn_scroll, 0, max(0, vpn.h - set.h))
            let vpn.off = floor(vpn.sc * pu + 0.5)
            clip box { at: spx + 224 * pw, sby + set.h / 2 * pu; size: 456 * pw, set.h * pu }
            zone box vpn_wheel { at: spx + 219 * pw, sby + set.h / 2 * pu; size: 446 * pw, set.h * pu }
            on scroll vpn_wheel while not (vpn_mode == vpm_imp and vpn_fmore and vpn_fwheel.hover) { vpn_scroll_to = clamp(vpn_scroll_to - wheel * 44, 0, max(0, vpn.h - set.h)) }
            group {
                move: 0, -vpn.off
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 55 * pu; size: 438 * pw, 68 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 55 * pu, 438 * pw, 68 * pu, 330.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 55 * pu; size: 438 * pw, 68 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 55 * pu; size: 438 * pw, 68 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 55 * pu; size: 438 * pw, 68 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            box { at: spx + 36 * pw, sby + 55 * pu; size: 40 * pu, 40 * pu; corner: 12 * pu; color: if(vpn_on, mint, ink); opacity: if(vpn_on, 22%, 8%) }
            path { at: spx + 36 * pw, sby + 55 * pu; stroke: 1.8 * pu; color: if(vpn_on, mint, faint); move 0, -9 * pu; line 8 * pu, -6 * pu; line 8 * pu, 1 * pu; line 0, 10 * pu; line -8 * pu, 1 * pu; line -8 * pu, -6 * pu; close }
            path { at: spx + 36 * pw, sby + 56 * pu; stroke: 1.8 * pu; color: if(vpn_on, mint, faint); opacity: if(vpn_on, 100%, 0%); move -3.5 * pu, 0; line -1 * pu, 2.5 * pu; line 4 * pu, -3 * pu }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 8 * pu + 0.5); text "STATUS" { at: floor(spx + 14 * pw + 0.5), floor(sby + 8 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 70 * pw + 0.5), floor(sby + 47 * pu + 0.5); text vpn_title { at: floor(spx + 70 * pw + 0.5), floor(sby + 47 * pu + 0.5); anchor: left center; size: 19.5; weight: 700; width: (230 * pw) / rs; lines: 1; color: if(vpn_on, mint, ink); family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 70 * pw + 0.5), floor(sby + 65 * pu + 0.5); text vpn_sub { at: floor(spx + 70 * pw + 0.5), floor(sby + 65 * pu + 0.5); anchor: left center; size: 15; width: (230 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            group {
                show: vpn_on
                box { at: spx + 380 * pw, sby + 55 * pu; size: 96 * pu, 28 * pu; corner: (14 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 10% + 10% * vpn_dn_hit.hover }
                PPillOutline(spx + 380 * pw, sby + 55 * pu, 96 * pu, 28 * pu, 14 * pu, vpn_dn_hit.hover, clamp(3 * (10% + 10% * vpn_dn_hit.hover), 0, 1), pu)
                group { scale: rs; pivot: floor(spx + 380 * pw + 0.5), floor(sby + 55 * pu + 0.5); text "Disconnect" { at: floor(spx + 380 * pw + 0.5), floor(sby + 55 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk" } }
            }
            zone box vpn_dn_hit { at: spx + 380 * pw, sby + 55 * pu; size: 98 * pu, 30 * pu; corner: 15 * pu; cursor: pointer; active: vpn_on and not vpn_busy }
            on press vpn_dn_hit { emit vpn_down }
            //  NordVPN (its own CLI and daemon, not a NetworkManager profile): what it is connected to, Quick connect or Disconnect, and a field for a
            //  country or a city. Only while `nordvpn` is installed (`vpn_nord`); the cards below move down to make room (`vpn.pb`).
            group {
                show: vpn_nord
                //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
                body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + (vpn.nb + vpn.nh / 2) * pu; size: 438 * pw, vpn.nh * pu; corner: 14 * pu } }
                DdCard(spx + 219 * pw, sby + (vpn.nb + vpn.nh / 2) * pu, 438 * pw, vpn.nh * pu, 390.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
                box { at: spx + 219 * pw, sby + (vpn.nb + vpn.nh / 2) * pu; size: 438 * pw, vpn.nh * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
                box { at: spx + 219 * pw, sby + (vpn.nb + vpn.nh / 2) * pu; size: 438 * pw, vpn.nh * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
                box { at: spx + 219 * pw, sby + (vpn.nb + vpn.nh / 2) * pu; size: 438 * pw, vpn.nh * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
                //  The section is named above the card, as every section is; what it connects by (NordLynx, OpenVPN) sits at the other end of that line.
                group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.nb - 13) * pu + 0.5); text "NORDVPN" { at: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.nb - 13) * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + (vpn.nb - 13) * pu + 0.5); text vpn_nd_note { at: floor(spx + 424 * pw + 0.5), floor(sby + (vpn.nb - 13) * pu + 0.5); anchor: right center; align: right; size: 14; weight: 600; width: (200 * pw) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
                ellipse { at: spx + 24 * pw, sby + (vpn.nb + 22) * pu; radius: 3.5 * pu; color: if(vpn_nd_on, mint, faint); opacity: if(vpn_nd_on, 100%, 45%) }
                group { scale: rs; pivot: floor(spx + 38 * pw + 0.5), floor(sby + (vpn.nb + 22) * pu + 0.5); text vpn_nd_title { at: floor(spx + 38 * pw + 0.5), floor(sby + (vpn.nb + 22) * pu + 0.5); anchor: left center; size: 17; weight: 700; width: (250 * pw) / rs; lines: 1; color: if(vpn_nd_on, mint, ink); family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(spx + 38 * pw + 0.5), floor(sby + (vpn.nb + 41) * pu + 0.5); text vpn_nd_sub { at: floor(spx + 38 * pw + 0.5), floor(sby + (vpn.nb + 41) * pu + 0.5); anchor: left center; size: 14; width: (262 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                //  Quick connect, or Disconnect while it is connected.
                box { at: spx + 366 * pw, sby + (vpn.nb + 30) * pu; size: 108 * pu, 28 * pu; corner: 14 * pu; color: if(vpn_nd_on, ink, mint); opacity: if(vpn_nd_on, 10% + 10% * vpn_nd_btn_hit.hover, 18% + 14% * vpn_nd_btn_hit.hover) }
                PPillOutline(spx + 366 * pw, sby + (vpn.nb + 30) * pu, 108 * pu, 28 * pu, 14 * pu, vpn_nd_btn_hit.hover, clamp(3 * (if(vpn_nd_on, 10% + 10% * vpn_nd_btn_hit.hover, 18% + 14% * vpn_nd_btn_hit.hover)), 0, 1), pu)
                group { scale: rs; pivot: floor(spx + 366 * pw + 0.5), floor(sby + (vpn.nb + 30) * pu + 0.5); text pick(if(vpn_nd_on, 1, 0), "Quick connect", "Disconnect") { at: floor(spx + 366 * pw + 0.5), floor(sby + (vpn.nb + 30) * pu + 0.5); anchor: center; align: center; size: 15; weight: 600; width: (104 * pw) / rs; lines: 1; color: if(vpn_nd_on, ink, mint); family: "Space Grotesk" } }
                zone box vpn_nd_btn_hit { at: spx + 366 * pw, sby + (vpn.nb + 30) * pu; size: 110 * pu, 30 * pu; corner: 15 * pu; cursor: pointer; label: "NordVPN quick connect or disconnect"; active: vpn_nord and not vpn_busy and ((((vpn.nb + 30)) * pu - vpn.off) > 14 * pu and (((vpn.nb + 30)) * pu - vpn.off) < 440 * pu) }
                on press vpn_nd_btn_hit while vpn_nd_on { emit vpn_nd_down }
                on press vpn_nd_btn_hit while not vpn_nd_on { emit vpn_nd_quick }
                //  A country or a city: Connect, or Enter, goes there (spaces become underscores, as `nordvpn connect` writes them).
                box { at: spx + 149 * pw, sby + (vpn.nb + 74) * pu; size: 270 * pw, 28 * pu; corner: 9 * pu; color: ink; opacity: 8% }
                group {
                    show: (((vpn.nb + 74) * pu - vpn.off) > 14 * pu and ((vpn.nb + 74) * pu - vpn.off) < (set.h - 14) * pu)
                    input vpn_nd_q { at: floor(spx + 26 * pw + 0.5), floor(sby + (vpn.nb + 74) * pu - 6.5 * pu + 0.5); width: 250 * pw; size: 14; color: ink; family: "Space Grotesk"; placeholder: "A country or city: Japan, Tokyo, United States" }
                }
                box { at: spx + 366 * pw, sby + (vpn.nb + 74) * pu; size: 108 * pu, 28 * pu; corner: 14 * pu; color: mint; opacity: 18% + 8% * vpn_nd_go_hit.hover }
                PPillOutline(spx + 366 * pw, sby + (vpn.nb + 74) * pu, 108 * pu, 28 * pu, 14 * pu, vpn_nd_go_hit.hover, clamp(3 * (18% + 8% * vpn_nd_go_hit.hover), 0, 1), pu)
                group { scale: rs; pivot: floor(spx + 366 * pw + 0.5), floor(sby + (vpn.nb + 74) * pu + 0.5); text "Connect" { at: floor(spx + 366 * pw + 0.5), floor(sby + (vpn.nb + 74) * pu + 0.5); anchor: center; align: center; size: 14.5; weight: 700; width: (104 * pw) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
                zone box vpn_nd_go_hit { at: spx + 366 * pw, sby + (vpn.nb + 74) * pu; size: 110 * pu, 30 * pu; corner: 15 * pu; cursor: pointer; label: "NordVPN connect to the country or city typed"; active: vpn_nord and not vpn_busy and ((((vpn.nb + 74)) * pu - vpn.off) > 14 * pu and (((vpn.nb + 74)) * pu - vpn.off) < 440 * pu) }
                on press vpn_nd_go_hit { emit vpn_nd_go }
            }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + (vpn.pb + vpn.pbh / 2) * pu; size: 438 * pw, vpn.pbh * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + (vpn.pb + vpn.pbh / 2) * pu, 438 * pw, vpn.pbh * pu, 456.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + (vpn.pb + vpn.pbh / 2) * pu; size: 438 * pw, vpn.pbh * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + (vpn.pb + vpn.pbh / 2) * pu; size: 438 * pw, vpn.pbh * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + (vpn.pb + vpn.pbh / 2) * pu; size: 438 * pw, vpn.pbh * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.pb - 13) * pu + 0.5); text "PROFILES" { at: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.pb - 13) * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            box { at: spx + 424 * pw - 11 * pu, sby + (vpn.pb - 13) * pu; size: 22 * pu, 16 * pu; corner: 8 * pu; color: ink; opacity: 10% }
            group { scale: rs; pivot: floor(spx + 413 * pw + 0.5), floor(sby + (vpn.pb - 13) * pu + 0.5); text number(vpn_count, 0) { at: floor(spx + 413 * pw + 0.5), floor(sby + (vpn.pb - 13) * pu + 0.5); anchor: center; align: center; size: 13.5; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 219 * pw + 0.5), floor(sby + (vpn.pb + 26) * pu + 0.5); text "No VPN profiles yet: add one below" { at: floor(spx + 219 * pw + 0.5), floor(sby + (vpn.pb + 26) * pu + 0.5); anchor: center; align: center; size: 16; color: faint; show: vpn_count < 1; family: "Space Grotesk" } }
            repeat i in 0..8 {
                let ry = vpn.pb + 26 + i * 32
                ellipse { at: spx + 24 * pw, sby + ry * pu; radius: 3.5 * pu; color: if(vpn_r.$i.active, mint, faint); opacity: if(vpn_r.$i.on, if(vpn_r.$i.active, 100%, 45%), 0%) }
                //  The kind (WireGuard, OpenVPN) as a badge right after the name, as wide as its word: both are measured by copies nobody sees (the name shown is cut at 150).
                measure vnm.$i
                measure vsb.$i
                group { scale: rs; text vpn_r.$i.name { at: 0, -2000; size: 17; weight: 700; measure: vnm.$i; opacity: 0; family: "Space Grotesk" } }
                group { scale: rs; text vpn_r.$i.sub { at: 0, -2000; size: 14; measure: vsb.$i; opacity: 0; family: "Space Grotesk" } }
                let vbw = vsb.$i.width * rs + 20 * pu
                let vbx = spx + 38 * pw + min(vnm.$i.width * rs, 150 * pw) + 10 * pu + vbw / 2
                group { scale: rs; pivot: floor(spx + 38 * pw + 0.5), floor(sby + ry * pu + 0.5); text vpn_r.$i.name { at: floor(spx + 38 * pw + 0.5), floor(sby + ry * pu + 0.5); anchor: left center; size: 17; weight: 700; width: (150 * pw) / rs; lines: 1; color: if(vpn_r.$i.active, mint, ink); show: vpn_r.$i.on; family: "Space Grotesk" } }
                box { at: vbx, sby + ry * pu; size: vbw, 20 * pu; corner: 10 * pu; color: ink; opacity: if(vpn_r.$i.on, 8%, 0%) }
                group { scale: rs; pivot: floor(vbx + 0.5), floor(sby + ry * pu + 0.5); text vpn_r.$i.sub { at: floor(vbx + 0.5), floor(sby + ry * pu + 0.5); anchor: center; align: center; size: 14; color: faint; show: vpn_r.$i.on; family: "Space Grotesk" } }
                box { at: spx + 424 * pw - 132 * pu, sby + ry * pu; size: 96 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: if(vpn_r.$i.active, ink, mint); opacity: if(vpn_r.$i.on and not vpn_r.$i.active, 18% + 14% * vpn_tg_hit.$i.hover, 0%) }
                PPillOutline(spx + 424 * pw - 132 * pu, sby + ry * pu, 96 * pu, 24 * pu, 12 * pu, vpn_tg_hit.$i.hover, clamp(3 * (if(vpn_r.$i.on and not vpn_r.$i.active, 18% + 14% * vpn_tg_hit.$i.hover, 0%)), 0, 1), pu)
                group { scale: rs; pivot: floor(spx + 424 * pw - 132 * pu + 0.5), floor(sby + ry * pu + 0.5); text "Connect" { at: floor(spx + 424 * pw - 132 * pu + 0.5), floor(sby + ry * pu + 0.5); anchor: center; align: center; size: 15; weight: 600; color: if(vpn_r.$i.active, ink, mint); show: vpn_r.$i.on and not vpn_r.$i.active and vpn_arm != i; family: "Space Grotesk" } }
                zone box vpn_tg_hit.$i { at: spx + 424 * pw - 132 * pu, sby + ry * pu; size: 98 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; label: "Connect"; active: (vpn_r.$i.on and not vpn_r.$i.active and vpn_arm < 0 and not vpn_busy) and (((ry) * pu - vpn.off) > 14 * pu and ((ry) * pu - vpn.off) < 440 * pu) }
                on press vpn_tg_hit.$i { emit vpn_toggle(i) }
                //  Delete: at the row's right end, in the alert colour. It only asks (the dialog under the page); nothing is deleted until that is accepted.
                box { at: spx + 424 * pw - 38 * pu, sby + ry * pu; size: 76 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: alert; opacity: if(vpn_r.$i.on, 12% + 14% * vpn_x_hit.$i.hover, 0%) }
                PPillOutline(spx + 424 * pw - 38 * pu, sby + ry * pu, 76 * pu, 24 * pu, 12 * pu, vpn_x_hit.$i.hover, if(vpn_r.$i.on, 0.5 + 0.4 * vpn_x_hit.$i.hover, 0), pu)
                group { scale: rs; pivot: floor(spx + 424 * pw - 38 * pu + 0.5), floor(sby + ry * pu + 0.5); text "Delete" { at: floor(spx + 424 * pw - 38 * pu + 0.5), floor(sby + ry * pu + 0.5); anchor: center; align: center; size: 15; weight: 700; color: alert; show: vpn_r.$i.on; family: "Space Grotesk" } }
                zone box vpn_x_hit.$i { at: spx + 424 * pw - 38 * pu, sby + ry * pu; size: 78 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; label: "Delete this profile"; agent: no; active: (vpn_r.$i.on and vpn_arm < 0 and not vpn_busy) and (((ry) * pu - vpn.off) > 14 * pu and ((ry) * pu - vpn.off) < 440 * pu) }
                on press vpn_x_hit.$i { emit vpn_arm_ask(i) }
            }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + (vpn.ab + (59 + vpn.fh + 52) / 2) * pu; size: 438 * pw, (59 + vpn.fh + 52) * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + (vpn.ab + (59 + vpn.fh + 52) / 2) * pu, 438 * pw, (59 + vpn.fh + 52) * pu, 666.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + (vpn.ab + (59 + vpn.fh + 52) / 2) * pu; size: 438 * pw, (59 + vpn.fh + 52) * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + (vpn.ab + (59 + vpn.fh + 52) / 2) * pu; size: 438 * pw, (59 + vpn.fh + 52) * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + (vpn.ab + (59 + vpn.fh + 52) / 2) * pu; size: 438 * pw, (59 + vpn.fh + 52) * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.ab - 13) * pu + 0.5); text "ADD A PROFILE" { at: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.ab - 13) * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            SetPick(spx + 82.25 * pw, sby + (vpn.ab + 27) * pu, 136.7 * pw, 3, 26 * pu, if(vpn_mode == vpm_ovpn, 1, 0) + 2 * if(vpn_mode == vpm_imp, 1, 0), clamp(vpn_m0_hit.hover + vpn_m1_hit.hover + vpn_m2_hit.hover, 0, 1), pu, 1, 0, 0, clamp(if(vpn_mode == vpm_wg, 1, 0) + if(vpn_mode == vpm_ovpn, 1, 0) + if(vpn_mode == vpm_imp, 1, 0), 0, 1))
            box { at: spx + 82.25 * pw, sby + (vpn.ab + 27) * pu; size: 128.7 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * vpn_m0_hit.hover }
            group { scale: rs; pivot: floor(spx + 82.25 * pw + 0.5), floor(sby + (vpn.ab + 27) * pu + 0.5); text "WireGuard" { at: floor(spx + 82.25 * pw + 0.5), floor(sby + (vpn.ab + 27) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; color: if(vpn_mode == vpm_wg, mint, ink); opacity: if(vpn_mode == vpm_wg, 100%, 85%); family: "Space Grotesk" } }
            zone box vpn_m0_hit { at: spx + 82.25 * pw, sby + (vpn.ab + 27) * pu; size: 128 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: (((vpn.ab + 27) * pu - vpn.off) > 14 * pu and ((vpn.ab + 27) * pu - vpn.off) < 440 * pu) }
