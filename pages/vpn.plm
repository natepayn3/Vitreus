                show: vpn_mode == vpm_ovpn and (((vpn.ab + 59 + 2 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 59 + 2 * 36 + 17) * pu - vpn.off) < 440 * pu)
                input vpno_pw { at: floor(spx + 237.0 * pw + 0.5), floor(sby + (vpn.ab + 59 + 2 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 175 * pu; size: 14; color: ink; family: "Space Grotesk"; secret: true; placeholder: "Password" }
