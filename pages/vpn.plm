                on submit vpn_file { emit vpn_import }
            }
            group {
                show: vpn_mode == vpm_ovpn
                SetPick(spx + 271 * pw, sby + (vpn.ab + 59 + 1 * 36 + 17) * pu, 102 * pw, 2, 26 * pu, if(vpn_tcp, 1, 0), clamp(vpn_p0_hit.hover + vpn_p1_hit.hover, 0, 1), pu, 1, 0, 0, clamp(if(not vpn_tcp, 1, 0) + if(vpn_tcp, 1, 0), 0, 1))
                box { at: spx + 271 * pw, sby + (vpn.ab + 59 + 1 * 36 + 17) * pu; size: 98 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * vpn_p0_hit.hover }
                group { scale: rs; pivot: floor(spx + 271 * pw + 0.5), floor(sby + (vpn.ab + 59 + 1 * 36 + 17) * pu + 0.5); text "UDP" { at: floor(spx + 271 * pw + 0.5), floor(sby + (vpn.ab + 59 + 1 * 36 + 17) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; color: if(not vpn_tcp, mint, ink); family: "Space Grotesk" } }
            }
            zone box vpn_p0_hit { at: spx + 271 * pw, sby + (vpn.ab + 59 + 1 * 36 + 17) * pu; size: 100 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: vpn_mode == vpm_ovpn and (((vpn.ab + 59 + 1 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 59 + 1 * 36 + 17) * pu - vpn.off) < 440 * pu) }
            on press vpn_p0_hit { vpn_tcp = false }
            group {
                show: vpn_mode == vpm_ovpn
                box { at: spx + 373 * pw, sby + (vpn.ab + 59 + 1 * 36 + 17) * pu; size: 98 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * vpn_p1_hit.hover }
                group { scale: rs; pivot: floor(spx + 373 * pw + 0.5), floor(sby + (vpn.ab + 59 + 1 * 36 + 17) * pu + 0.5); text "TCP" { at: floor(spx + 373 * pw + 0.5), floor(sby + (vpn.ab + 59 + 1 * 36 + 17) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; color: if(vpn_tcp, mint, ink); family: "Space Grotesk" } }
            }
            zone box vpn_p1_hit { at: spx + 373 * pw, sby + (vpn.ab + 59 + 1 * 36 + 17) * pu; size: 100 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: vpn_mode == vpm_ovpn and (((vpn.ab + 59 + 1 * 36 + 17) * pu - vpn.off) > 14 * pu and ((vpn.ab + 59 + 1 * 36 + 17) * pu - vpn.off) < 440 * pu) }
            on press vpn_p1_hit { vpn_tcp = true }
            group {
                show: vpn_mode == vpm_imp
                group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.ab + 59 + 48) * pu + 0.5); text vpn_dir { at: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.ab + 59 + 48) * pu + 0.5); anchor: left center; size: 14; weight: 600; width: (410 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                box { at: spx + 219 * pw, sby + (vpn.ab + 59 + 62 + 108) * pu; size: 410 * pw, 216 * pu; corner: 12 * pu; color: ink; opacity: 6% }
                group { scale: rs; pivot: floor(spx + 219 * pw + 0.5), floor(sby + (vpn.ab + 59 + 62 + 108) * pu + 0.5); text "No folders or .conf / .ovpn files here" { at: floor(spx + 219 * pw + 0.5), floor(sby + (vpn.ab + 59 + 62 + 108) * pu + 0.5); anchor: center; align: center; size: 15.5; color: faint; show: not vpn_f.0.on; family: "Space Grotesk" } }
            }
            zone box vpn_fwheel { at: spx + 219 * pw, sby + (vpn.ab + 59 + 62 + 108) * pu; size: 410 * pw, 216 * pu; active: vpn_mode == vpm_imp and vpn_fmore and (((vpn.ab + 59 + 170) * pu - vpn.off) > 14 * pu and ((vpn.ab + 59 + 170) * pu - vpn.off) < 440 * pu) }
            on scroll vpn_fwheel { emit vpn_fscroll(wheel) }
            repeat i in 0..8 {
                let fy = vpn.ab + 59 + 62 + 4 + i * 26 + 13
                box { at: spx + 219 * pw, sby + fy * pu; size: 402 * pw, 24 * pu; corner: 9 * pu; color: mint; opacity: if(vpn_mode == vpm_imp and vpn_f.$i.on, 14% * vpn_ff_hit.$i.hover, 0%) }
                group {
                    show: vpn_mode == vpm_imp and vpn_f.$i.on and vpn_f.$i.dir
                    box { at: spx + 30 * pw, sby + (fy + 1) * pu; size: 14 * pu, 10 * pu; corner: 2 * pu; stroke: 1.3 * pu; color: faint }
                    box { at: spx + 26.5 * pw, sby + (fy - 5.5) * pu; size: 6 * pu, 3 * pu; corner: 1 * pu; color: faint }
                }
                group {
                    show: vpn_mode == vpm_imp and vpn_f.$i.on and not vpn_f.$i.dir
                    box { at: spx + 30 * pw, sby + fy * pu; size: 11 * pu, 14 * pu; corner: 2 * pu; stroke: 1.3 * pu; color: mint }
                    line { from: spx + 27.5 * pw, sby + (fy - 1.5) * pu; to: spx + 32.5 * pw, sby + (fy - 1.5) * pu; width: 1.1 * pu; color: mint }
                    line { from: spx + 27.5 * pw, sby + (fy + 2) * pu; to: spx + 32.5 * pw, sby + (fy + 2) * pu; width: 1.1 * pu; color: mint }
                }
                group { scale: rs; pivot: floor(spx + 46 * pw + 0.5), floor(sby + fy * pu + 0.5); text vpn_f.$i.name { at: floor(spx + 46 * pw + 0.5), floor(sby + fy * pu + 0.5); anchor: left center; size: 16; weight: 600; width: (360 * pw) / rs; lines: 1; color: if(vpn_f.$i.dir, ink, mint); show: vpn_mode == vpm_imp and vpn_f.$i.on; family: "Space Grotesk" } }
                zone box vpn_ff_hit.$i { at: spx + 219 * pw, sby + fy * pu; size: 402 * pw, 24 * pu; corner: 9 * pu; cursor: pointer; active: (vpn_mode == vpm_imp and vpn_f.$i.on) and (((fy) * pu - vpn.off) > 14 * pu and ((fy) * pu - vpn.off) < 440 * pu) }
                on press vpn_ff_hit.$i { emit vpn_fpick(i) }
            }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.ab + 59 + vpn.fh + 24) * pu + 0.5); text vpn_msg { at: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.ab + 59 + vpn.fh + 24) * pu + 0.5); anchor: left center; size: 14.5; width: (290 * pw) / rs; lines: 2; color: mint; family: "Space Grotesk" } }
            box { at: spx + 370 * pw, sby + (vpn.ab + 59 + vpn.fh + 24) * pu; size: 108 * pu, 28 * pu; corner: (14 * pu) * (1 - 0.85 * dd_k); color: mint; opacity: if(vpn_busy, 35%, 85% + 15% * vpn_add_hit.hover) }
            PPillOutline(spx + 370 * pw, sby + (vpn.ab + 59 + vpn.fh + 24) * pu, 108 * pu, 28 * pu, 14 * pu, vpn_add_hit.hover, clamp(3 * (if(vpn_busy, 35%, 85% + 15% * vpn_add_hit.hover)), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 370 * pw + 0.5), floor(sby + (vpn.ab + 59 + vpn.fh + 24) * pu + 0.5); text "Add profile" { at: floor(spx + 370 * pw + 0.5), floor(sby + (vpn.ab + 59 + vpn.fh + 24) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 700; color: onmint; show: vpn_mode != vpm_imp; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 370 * pw + 0.5), floor(sby + (vpn.ab + 59 + vpn.fh + 24) * pu + 0.5); text "Import" { at: floor(spx + 370 * pw + 0.5), floor(sby + (vpn.ab + 59 + vpn.fh + 24) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 700; color: onmint; show: vpn_mode == vpm_imp; family: "Space Grotesk" } }
            zone box vpn_add_hit { at: spx + 370 * pw, sby + (vpn.ab + 59 + vpn.fh + 24) * pu; size: 110 * pu, 30 * pu; corner: 15 * pu; cursor: pointer; active: not vpn_busy and (((vpn.ab + 59 + vpn.fh + 24) * pu - vpn.off) > 14 * pu and ((vpn.ab + 59 + vpn.fh + 24) * pu - vpn.off) < 440 * pu) }
            on press vpn_add_hit while vpn_mode == vpm_wg { emit vpn_add_wg }
            on press vpn_add_hit while vpn_mode == vpm_ovpn { emit vpn_add_ovpn }
            on press vpn_add_hit while vpn_mode == vpm_imp { emit vpn_import }
            //  The weather's place (the calendar's strip): a city or a ZIP code typed here, found by name, so that the VPN's exit does not move it. Set, or Enter, looks it up.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + (vpn.wt + 61) * pu; size: 438 * pw, 122 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + (vpn.wt + 61) * pu, 438 * pw, 122 * pu, 37.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + (vpn.wt + 61) * pu; size: 438 * pw, 122 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + (vpn.wt + 61) * pu; size: 438 * pw, 122 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + (vpn.wt + 61) * pu; size: 438 * pw, 122 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.wt - 13) * pu + 0.5); text "WEATHER" { at: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.wt - 13) * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + (vpn.wt - 13) * pu + 0.5); text wx_name { at: floor(spx + 424 * pw + 0.5), floor(sby + (vpn.wt - 13) * pu + 0.5); anchor: right center; align: right; size: 14.5; weight: 600; width: (260 * pw) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.wt + 22) * pu + 0.5); text "A city or ZIP code, typed here instead of found by IP, so a VPN does not move it" { at: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.wt + 22) * pu + 0.5); anchor: left center; size: 13.5; width: (410 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            box { from: spx + 14 * pw, sby + (vpn.wt + 42) * pu; size: 410 * pw - 136 * pu, 28 * pu; corner: 9 * pu; color: ink; opacity: 8% }
            group {
                show: (((vpn.wt + 56) * pu - vpn.off) > 14 * pu and ((vpn.wt + 56) * pu - vpn.off) < (set.h - 14) * pu)
                input wx_in { at: floor(spx + 14 * pw + 12 * pu + 0.5), floor(sby + (vpn.wt + 56) * pu - 6.5 * pu + 0.5); width: 410 * pw - 160 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "City or ZIP code" }
            }
            box { at: spx + 424 * pw - 97 * pu, sby + (vpn.wt + 56) * pu; size: 62 * pu, 28 * pu; corner: (9 * pu) * (1 - 0.85 * dd_k); color: mint; opacity: 18% + 8% * wx_set_hit.hover }
            PPillOutline(spx + 424 * pw - 97 * pu, sby + (vpn.wt + 56) * pu, 62 * pu, 28 * pu, 9 * pu, wx_set_hit.hover, clamp(3 * (18% + 8% * wx_set_hit.hover), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 424 * pw - 97 * pu + 0.5), floor(sby + (vpn.wt + 56) * pu + 0.5); text "Set" { at: floor(spx + 424 * pw - 97 * pu + 0.5), floor(sby + (vpn.wt + 56) * pu + 0.5); anchor: center; align: center; size: 14.5; weight: 700; width: (58 * pw) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
            zone box wx_set_hit { at: spx + 424 * pw - 97 * pu, sby + (vpn.wt + 56) * pu; size: 62 * pu, 28 * pu; corner: 9 * pu; cursor: pointer; active: (sby + (vpn.wt + 56) * pu) - vpn.off > sby and (sby + (vpn.wt + 56) * pu) - vpn.off < sby + set.h * pu }
            on press wx_set_hit { emit wx_set }
            box { at: spx + 424 * pw - 29 * pu, sby + (vpn.wt + 56) * pu; size: 58 * pu, 28 * pu; corner: (9 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 8% + 6% * wx_auto_hit.hover }
            PPillOutline(spx + 424 * pw - 29 * pu, sby + (vpn.wt + 56) * pu, 58 * pu, 28 * pu, 9 * pu, wx_auto_hit.hover, clamp(3 * (8% + 6% * wx_auto_hit.hover), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 424 * pw - 29 * pu + 0.5), floor(sby + (vpn.wt + 56) * pu + 0.5); text "Auto" { at: floor(spx + 424 * pw - 29 * pu + 0.5), floor(sby + (vpn.wt + 56) * pu + 0.5); anchor: center; align: center; size: 14.5; weight: 700; width: (54 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            zone box wx_auto_hit { at: spx + 424 * pw - 29 * pu, sby + (vpn.wt + 56) * pu; size: 58 * pu, 28 * pu; corner: 9 * pu; cursor: pointer; active: (sby + (vpn.wt + 56) * pu) - vpn.off > sby and (sby + (vpn.wt + 56) * pu) - vpn.off < sby + set.h * pu }
            on press wx_auto_hit { emit wx_auto }
            measure ldr_vpn1
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.wt + 94) * pu + 0.5); text "Units" { at: floor(spx + 14 * pw + 0.5), floor(sby + (vpn.wt + 94) * pu + 0.5); measure: ldr_vpn1; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            SetPick(spx + 286 * pw, sby + (vpn.wt + 94) * pu, 92 * pw, 2, 24 * pu, wxcf1, clamp(wx_u0.hover + wx_u1.hover, 0, 1), pu, 1, 0, 0, clamp(wxcf0 + wxcf1, 0, 1))
            PLeader(spx + 14 * pw + ldr_vpn1.width * rs + 8 * pu, spx + 286 * pw - 92 * pw / 2 - 6 * pu, sby + (vpn.wt + 94) * pu, clamp(wx_u0.hover + wx_u1.hover, 0, 1), pu)
            box { at: spx + 286 * pw, sby + (vpn.wt + 94) * pu; size: 88 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * wx_u0.hover }
            group { scale: rs; pivot: floor(spx + 286 * pw + 0.5), floor(sby + (vpn.wt + 94) * pu + 0.5); text "Fahrenheit" { at: floor(spx + 286 * pw + 0.5), floor(sby + (vpn.wt + 94) * pu + 0.5); anchor: center; align: center; size: 14.5; weight: 700; width: (84 * pw) / rs; lines: 1; color: mix(ink, mint, wxcf0); family: "Space Grotesk" } }
            zone box wx_u0 { at: spx + 286 * pw, sby + (vpn.wt + 94) * pu; size: 88 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + (vpn.wt + 94) * pu) - vpn.off > sby and (sby + (vpn.wt + 94) * pu) - vpn.off < sby + set.h * pu }
            on press wx_u0 { emit wx_units_set(0) }
            box { at: spx + 378 * pw, sby + (vpn.wt + 94) * pu; size: 88 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * wx_u1.hover }
            group { scale: rs; pivot: floor(spx + 378 * pw + 0.5), floor(sby + (vpn.wt + 94) * pu + 0.5); text "Celsius" { at: floor(spx + 378 * pw + 0.5), floor(sby + (vpn.wt + 94) * pu + 0.5); anchor: center; align: center; size: 14.5; weight: 700; width: (84 * pw) / rs; lines: 1; color: mix(ink, mint, wxcf1); family: "Space Grotesk" } }
            zone box wx_u1 { at: spx + 378 * pw, sby + (vpn.wt + 94) * pu; size: 88 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; active: (sby + (vpn.wt + 94) * pu) - vpn.off > sby and (sby + (vpn.wt + 94) * pu) - vpn.off < sby + set.h * pu }
            on press wx_u1 { emit wx_units_set(1) }
            }
            let vpn.thh = set.h * set.h / vpn.h
            let vpn.thy = vpn.thh / 2 + vpn.sc / max(1, vpn.h - set.h) * (set.h - vpn.thh)
            box { at: spx + 442 * pw, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: 6% }
            box { at: spx + 442 * pw, sby + vpn.thy * pu; size: 3 * pu, vpn.thh * pu; corner: 1.5 * pu; color: mint; opacity: 55% }
            let vpn.cue = clamp((vpn.h - set.h - vpn.sc) / 24, 0, 1)
            let vpn.cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pw, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pw, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * vpn.cue }
            }
            box { at: spx + 224 * pw, vpn.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * vpn.cue }
            box { at: spx + 224 * pw, vpn.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * vpn_cue_hit.hover) * vpn.cue }
            path { at: spx + 204 * pw, vpn.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: vpn.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pw, vpn.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: vpn.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            group { scale: rs; pivot: floor(spx + 232 * pw + 0.5), floor(vpn.cuey + 0.5); text "More" { at: floor(spx + 232 * pw + 0.5), floor(vpn.cuey + 0.5); anchor: center; size: 16.5; weight: 700; color: ink; opacity: vpn.cue; family: "Space Grotesk" } }
            zone box vpn_cue_hit { at: spx + 224 * pw, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: vpn.cue > 0.5 }
            on press vpn_cue_hit { vpn_scroll_to = clamp(vpn_scroll_to + 342, 0, max(0, vpn.h - set.h)) }
            zone box vpn_bar_hit { at: spx + 442 * pw, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: vpn.h > set.h }
            on press vpn_bar_hit { vpn_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - vpn.thh / 2) / max(1, set.h - vpn.thh) * (vpn.h - set.h), 0, max(0, vpn.h - set.h)) }
            on drag vpn_bar_hit { vpn_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - vpn.thh / 2) / max(1, set.h - vpn.thh) * (vpn.h - set.h), 0, max(0, vpn.h - set.h)) }

            //  Are you sure? Delete only asks (`vpn_arm`, the row it was pressed on): this dims the page and asks over it. Delete deletes; Cancel, a click anywhere
            //  else on the page, or Escape lets it go (the logic's `vpn_arm_ask` on the same row again clears it).
            group {
                opacity: vpn_dlg
                show: vpn_dlg > 0.01
                let dlg.y = sby + set.h / 2 * pu
                box { at: spx + 224 * pw, dlg.y; size: 456 * pw, set.h * pu; color: deep; opacity: 72% }
                zone box vpn_dlg_bg { at: spx + 224 * pw, dlg.y; size: 456 * pw, set.h * pu; active: vpn_arm >= 0 }
                on press vpn_dlg_bg { emit vpn_arm_ask(vpn_arm) }
                group {
                    scale: 0.94 + 0.06 * vpn_dlg
                    pivot: spx + 219 * pw, dlg.y
                    body { color: mix(obsidian, ink, 7%); border: 1 * pu, mix(ink, alert, 30%); shadow: 0, 6 * pu, 24 * pu, 55%, #000000; box { at: spx + 219 * pw, dlg.y; size: 300 * pw, 168 * pu; corner: 18 * pu } }
                    group { scale: rs; pivot: floor(spx + 219 * pw + 0.5), floor(dlg.y - 52 * pu + 0.5); text "Delete this profile?" { at: floor(spx + 219 * pw + 0.5), floor(dlg.y - 52 * pu + 0.5); anchor: center; align: center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
                    repeat k in 0..8 {
                        group { scale: rs; pivot: floor(spx + 219 * pw + 0.5), floor(dlg.y - 24 * pu + 0.5); text vpn_r.$k.name { at: floor(spx + 219 * pw + 0.5), floor(dlg.y - 24 * pu + 0.5); anchor: center; align: center; size: 17; weight: 700; width: (270 * pw) / rs; lines: 1; color: alert; show: vpn_arm == k; family: "Space Grotesk" } }
                    }
                    group { scale: rs; pivot: floor(spx + 219 * pw + 0.5), floor(dlg.y + 4 * pu + 0.5); text "It is removed from this computer. This cannot be undone." { at: floor(spx + 219 * pw + 0.5), floor(dlg.y + 4 * pu + 0.5); anchor: center; align: center; size: 13.5; width: (270 * pw) / rs; lines: 2; color: faint; family: "Space Grotesk" } }
                    //  Cancel on the left, Delete (the alert colour) on the right.
                    box { at: spx + 219 * pw - 62 * pu, dlg.y + 50 * pu; size: 108 * pu, 28 * pu; corner: (14 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 8% + 10% * vpn_dlg_no.hover }
                    PPillOutline(spx + 219 * pw - 62 * pu, dlg.y + 50 * pu, 108 * pu, 28 * pu, 14 * pu, vpn_dlg_no.hover, 0.6, pu)
                    group { scale: rs; pivot: floor(spx + 219 * pw - 62 * pu + 0.5), floor(dlg.y + 50 * pu + 0.5); text "Cancel" { at: floor(spx + 219 * pw - 62 * pu + 0.5), floor(dlg.y + 50 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk" } }
                    zone box vpn_dlg_no { at: spx + 219 * pw - 62 * pu, dlg.y + 50 * pu; size: 110 * pu, 30 * pu; corner: 15 * pu; cursor: pointer; active: vpn_arm >= 0 }
                    on press vpn_dlg_no { emit vpn_arm_ask(vpn_arm) }
                    box { at: spx + 219 * pw + 62 * pu, dlg.y + 50 * pu; size: 108 * pu, 28 * pu; corner: (14 * pu) * (1 - 0.85 * dd_k); color: alert; opacity: 26% + 16% * vpn_dlg_yes.hover }
                    PPillOutline(spx + 219 * pw + 62 * pu, dlg.y + 50 * pu, 108 * pu, 28 * pu, 14 * pu, vpn_dlg_yes.hover, 0.8, pu)
                    group { scale: rs; pivot: floor(spx + 219 * pw + 62 * pu + 0.5), floor(dlg.y + 50 * pu + 0.5); text "Delete" { at: floor(spx + 219 * pw + 62 * pu + 0.5), floor(dlg.y + 50 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 700; color: alert; family: "Space Grotesk" } }
                    zone box vpn_dlg_yes { at: spx + 219 * pw + 62 * pu, dlg.y + 50 * pu; size: 110 * pu, 30 * pu; corner: 15 * pu; cursor: pointer; label: "Delete the profile"; agent: no; active: vpn_arm >= 0 and not vpn_busy }
                    on press vpn_dlg_yes { emit vpn_delete(vpn_arm) }
                }
            }
            on key Escape while vpn_arm >= 0 and panel == settings { emit vpn_arm_ask(vpn_arm) }
            on change set_page while vpn_arm >= 0 { emit vpn_arm_ask(vpn_arm) }
            on change panel while vpn_arm >= 0 { emit vpn_arm_ask(vpn_arm) }
        }
        //  ── VPN page: END ──
}
