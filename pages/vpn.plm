                input vpno_user { at: floor(spx + 26.0 * pw + 0.5), floor(sby + (vpn.ab + 59 + 2 * 36 + 17) * pu - 6.5 * pu + 0.5); width: 175 * pu; size: 14; color: ink; family: "Space Grotesk"; placeholder: "User name" }
