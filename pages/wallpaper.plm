part Wallpaper {
        group {
            show: set_pg + set_pgd + set_pgb + set_pgn + set_pgh + set_pga + set_pgs + set_pgt + set_pgl + set_pgw + set_pgv + set_pgk + set_pgp + set_pgy + set_pgo + set_pgi < 0.99
            opacity: 1 - set_pg - set_pgd - set_pgb - set_pgn - set_pgh - set_pga - set_pgs - set_pgt - set_pgl - set_pgw - set_pgv - set_pgk - set_pgp - set_pgy - set_pgo - set_pgi
            let wp.sc = clamp(wp_scroll, 0, max(0, wp.h - set.h))      // how far the page is scrolled, unscaled
            let wp.off = floor(wp.sc * pu + 0.5)
            //  The page scrolls like Display's: everything moves up by `wp.off` inside a viewport as tall as the panel, and a control scrolled out of sight is not live.
            clip box { at: spx + 224 * pu, sby + set.h / 2 * pu; size: 456 * pu, set.h * pu }
            zone box wp_wheel { at: spx + 219 * pu, sby + set.h / 2 * pu; size: 446 * pu, set.h * pu }
            on scroll wp_wheel { wp_scroll_to = clamp(wp_scroll_to - wheel * 44, 0, max(0, wp.h - set.h)) }
            group {
                move: 0, -wp.off
            //  The wallpaper page. Card one: the wallpaper in use, and Random.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 46 * pu; size: 438 * pu, 92 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 46 * pu; size: 438 * pu, 92 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group {
                clip inset 0 box { at: spx + 77 * pu, sby + 46 * pu; size: 130 * pu, 73 * pu; corner: 10 * pu }
                image wp_cur { at: spx + 12 * pu, sby + 9.5 * pu; size: 130 * pu, 73 * pu }
            }
            group { scale: rs; pivot: floor(spx + 154 * pu + 0.5), floor(sby + 27 * pu + 0.5); text "ACTIVE WALLPAPER" { at: floor(spx + 154 * pu + 0.5), floor(sby + 27 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 154 * pu + 0.5), floor(sby + 46 * pu + 0.5); text wp_name { at: floor(spx + 154 * pu + 0.5), floor(sby + 46 * pu + 0.5); anchor: left center; size: 19.5; weight: 700; width: (150 * pu) / rs; lines: 1; color: ink; family: "Space Grotesk" } }
            //  The wallpaper folder, as a button: a folder, where it is, and "Browse". Pressed, it opens the folder browser (below, over the page).
            let wpf.x = spx + 154 * pu
            let wpf.y = sby + 71 * pu
            box { at: wpf.x + 77 * pu, wpf.y; size: 154 * pu, 22 * pu; corner: 11 * pu; color: mint; opacity: 10% + 10% * wp_dir_hit.hover }
            PPillOutline(wpf.x + 77 * pu, wpf.y, 154 * pu, 22 * pu, 11 * pu, wp_dir_hit.hover, clamp(3 * (10% + 10% * wp_dir_hit.hover), 0, 1), pu)
            box { at: wpf.x + 77 * pu, wpf.y; size: 154 * pu, 22 * pu; corner: 11 * pu; stroke: 1.2 * pu; color: mint; opacity: 55% + 30% * wp_dir_hit.hover }
            group { scale: rs; pivot: floor(wpf.x + 14 * pu + 0.5), floor(wpf.y + 0.5); GFolder(floor(wpf.x + 14 * pu + 0.5), floor(wpf.y + 0.5), (15.5) / 24, mint, 1, 0) }
            group { scale: rs; pivot: floor(wpf.x + 27 * pu + 0.5), floor(wpf.y + 0.5); text wp_dirtext { at: floor(wpf.x + 27 * pu + 0.5), floor(wpf.y + 0.5); anchor: left center; size: 14; width: (88 * pu) / rs; lines: 1; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(wpf.x + 146 * pu + 0.5), floor(wpf.y + 0.5); text "Browse" { at: floor(wpf.x + 146 * pu + 0.5), floor(wpf.y + 0.5); anchor: right center; size: 13.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box wp_dir_hit { at: wpf.x + 77 * pu, wpf.y; size: 154 * pu, 22 * pu; corner: 11 * pu; cursor: pointer; label: "Choose the wallpaper folder"; active: set_page == pg_wall and (wpf.y) - wp.off > sby + 12 * pu and (wpf.y) - wp.off < sby + (set.h - 12) * pu and not wpd_open }
            //  One row, centred on the card: the wallpaper's name, Random, and Iris. Random is a hexagon with softened corners, like the
            //  picker's tiles, with a die in it.
            let rhx = spx + 331 * pu
            let rhy = sby + 46 * pu
            let rhr = 18 * pu
            //  On a press it grows as the die turns and throbs back as it settles: `rth` is 0 at rest, 1 half way through the turn
            //  (how far `rand_spin` has come of the way to `rand_turn`), and dips under 0 where the spring overshoots.
            let rth = sin(clamp(1 - (rand_turn - rand_spin), 0, 1.3) * 180)
            group {
                pivot: rhx, rhy
                scale: 1 + 0.22 * rth
                path { at: rhx, rhy; color: mint; opacity: 16% + 16% * wp_rand_hit.hover + 22% * rth; move -0.260 * rhr, -0.850 * rhr; curve 0.260 * rhr, -0.850 * rhr via 0.000 * rhr, -1.000 * rhr; line 0.606 * rhr, -0.650 * rhr; curve 0.866 * rhr, -0.200 * rhr via 0.866 * rhr, -0.500 * rhr; line 0.866 * rhr, 0.200 * rhr; curve 0.606 * rhr, 0.650 * rhr via 0.866 * rhr, 0.500 * rhr; line 0.260 * rhr, 0.850 * rhr; curve -0.260 * rhr, 0.850 * rhr via 0.000 * rhr, 1.000 * rhr; line -0.606 * rhr, 0.650 * rhr; curve -0.866 * rhr, 0.200 * rhr via -0.866 * rhr, 0.500 * rhr; line -0.866 * rhr, -0.200 * rhr; curve -0.606 * rhr, -0.650 * rhr via -0.866 * rhr, -0.500 * rhr; close }
                path { at: rhx, rhy; stroke: 1.2 * pu; color: mint; opacity: 45% + 35% * wp_rand_hit.hover + 20% * rth; move -0.260 * rhr, -0.850 * rhr; curve 0.260 * rhr, -0.850 * rhr via 0.000 * rhr, -1.000 * rhr; line 0.606 * rhr, -0.650 * rhr; curve 0.866 * rhr, -0.200 * rhr via 0.866 * rhr, -0.500 * rhr; line 0.866 * rhr, 0.200 * rhr; curve 0.606 * rhr, 0.650 * rhr via 0.866 * rhr, 0.500 * rhr; line 0.260 * rhr, 0.850 * rhr; curve -0.260 * rhr, 0.850 * rhr via 0.000 * rhr, 1.000 * rhr; line -0.606 * rhr, 0.650 * rhr; curve -0.866 * rhr, 0.200 * rhr via -0.866 * rhr, 0.500 * rhr; line -0.866 * rhr, -0.200 * rhr; curve -0.606 * rhr, -0.650 * rhr via -0.866 * rhr, -0.500 * rhr; close }
                group {
                    pivot: rhx, rhy
                    rotate: rand_spin * 360deg
                    box { at: rhx, rhy; size: 12 * pu, 12 * pu; corner: 3 * pu; stroke: 1.3 * pu; color: mint }
                    ellipse { at: rhx - 2.6 * pu, rhy - 2.6 * pu; radius: 1.05 * pu; color: mint }
                    ellipse { at: rhx, rhy; radius: 1.05 * pu; color: mint }
                    ellipse { at: rhx + 2.6 * pu, rhy + 2.6 * pu; radius: 1.05 * pu; color: mint }
                }
            }
            zone box wp_rand_hit { at: rhx, rhy; size: 38 * pu, 38 * pu; corner: 14 * pu; cursor: pointer; active: set_page == pg_wall and (rhy) - wp.off > sby + 12 * pu and (rhy) - wp.off < sby + (set.h - 12) * pu }
            on press wp_rand_hit { emit wp_random; rand_turn = rand_turn + 1 }

            //  Iris, the palette from the wallpaper: a switch, as for the slideshow below. Off, the shell is monochrome. The window borders in
            //  Hyprland follow it too.
            group { scale: rs; pivot: floor(spx + 378 * pu + 0.5), floor(sby + 46 * pu + 0.5); text "Iris" { at: floor(spx + 378 * pu + 0.5), floor(sby + 46 * pu + 0.5); anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pu, sby + 46 * pu, iris_pill, wp_iris_hit.pressed, wp_iris_hit.hover, mint)
            zone box wp_iris_hit { at: spx + 405 * pu, sby + 46 * pu; size: 46 * pu, 30 * pu; cursor: pointer; active: set_page == pg_wall and (sby + 46 * pu) - wp.off > sby + 12 * pu and (sby + 46 * pu) - wp.off < sby + (set.h - 12) * pu }
            on press wp_iris_hit { emit iris_toggle }

            //  Card two: the slideshow. A switch, and how often: a stepper along a short list of intervals.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 122 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 122 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 113 * pu + 0.5); text "Slideshow" { at: floor(spx + 14 * pu + 0.5), floor(sby + 113 * pu + 0.5); anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 130 * pu + 0.5); text wp_show_sub { at: floor(spx + 14 * pu + 0.5), floor(sby + 130 * pu + 0.5); anchor: left center; size: 15; width: (190 * pu) / rs; lines: 1; color: if(wp_show, mint, faint); family: "Space Grotesk" } }
            group {
                opacity: 40% + 60% * wp_show_pill
                ellipse { at: spx + 250 * pu, sby + 122 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * wp_min_hit.hover }
                box { at: spx + 250 * pu, sby + 122 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 295 * pu, sby + 122 * pu; size: 58 * pu, 24 * pu; corner: 7 * pu; color: ink; opacity: 8% }
                group { scale: rs; pivot: floor(spx + 295 * pu + 0.5), floor(sby + 122 * pu + 0.5); text wp_mins_text { at: floor(spx + 295 * pu + 0.5), floor(sby + 122 * pu + 0.5); anchor: center; align: center; size: 16.5; weight: 700; width: (56 * pu) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
                ellipse { at: spx + 340 * pu, sby + 122 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * wp_plus_hit.hover }
                box { at: spx + 340 * pu, sby + 122 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 340 * pu, sby + 122 * pu; size: 1.6 * pu, 9 * pu; corner: 0.8 * pu; color: ink }
            }
            zone box wp_min_hit { at: spx + 250 * pu, sby + 122 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: set_page == pg_wall and (sby + 122 * pu) - wp.off > sby + 12 * pu and (sby + 122 * pu) - wp.off < sby + (set.h - 12) * pu }
            zone box wp_plus_hit { at: spx + 340 * pu, sby + 122 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: set_page == pg_wall and (sby + 122 * pu) - wp.off > sby + 12 * pu and (sby + 122 * pu) - wp.off < sby + (set.h - 12) * pu }
            on press wp_min_hit { emit wp_mins_step(-1) }
            on press wp_plus_hit { emit wp_mins_step(1) }
            SettingsSwitch(spx + 424 * pu, sby + 122 * pu, wp_show_pill, wp_show_hit.pressed, wp_show_hit.hover, mint)
            zone box wp_show_hit { at: spx + 405 * pu, sby + 122 * pu; size: 46 * pu, 30 * pu; cursor: pointer; active: set_page == pg_wall and (sby + 122 * pu) - wp.off > sby + 12 * pu and (sby + 122 * pu) - wp.off < sby + (set.h - 12) * pu }
            on press wp_show_hit { emit wp_show_toggle }

            //  Card three: the colour filter. Twelve swatches: the gallery, Random and the slideshow narrow to the
            //  wallpapers whose dominant colour it is; the lit one, pressed again, clears it.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 174 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 174 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 165 * pu + 0.5); text "COLOR" { at: floor(spx + 14 * pu + 0.5), floor(sby + 165 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 182 * pu + 0.5); text wp_count { at: floor(spx + 14 * pu + 0.5), floor(sby + 182 * pu + 0.5); anchor: left center; size: 14.5; width: (100 * pu) / rs; lines: 1; color: if(wp_filter >= 0, mint, faint); family: "Space Grotesk" } }
            repeat i in 0..12 {
                let swx = spx + 124 * pu + i * 26 * pu
                let lit = if(wp_filter == i, 1, 0)
                box { at: swx, sby + 174 * pu; size: (18 + 3 * lit) * pu, (18 + 3 * lit) * pu; corner: 5 * pu; color: pick(i, #e53935, #fb8c00, #fdd835, #43a047, #00acc1, #1e88e5, #8e24aa, #ec407a, #6d4c41, #f5f5f5, #9e9e9e, #212121) }
                box { at: swx, sby + 174 * pu; size: (18 + 3 * lit) * pu, (18 + 3 * lit) * pu; corner: 5 * pu; stroke: 1 * pu; color: #000000; opacity: 35% }
                box { at: swx, sby + 174 * pu; size: 25 * pu, 25 * pu; corner: 7 * pu; stroke: 2 * pu; color: mint; opacity: lit * 100% }
                zone box wp_sw.$i { at: swx, sby + 174 * pu; size: 24 * pu, 24 * pu; corner: 6 * pu; cursor: pointer; active: set_page == pg_wall and (sby + 174 * pu) - wp.off > sby + 12 * pu and (sby + 174 * pu) - wp.off < sby + (set.h - 12) * pu }
                on press wp_sw.$i { emit wp_filter_set(i) }
            }

            //  Card four: the gallery, sixteen at a time, with a pager.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 364.5 * pu; size: 438 * pu, 321 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 364.5 * pu; size: 438 * pu, 321 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            //  The source: a pill with two options, like Desk's Focus / Timer / Stopwatch. Gallery is the folder; Wallhaven puts a search's results in the same grid (logic/wallhaven.luau).
            let wsx = spx + 14 * pu + 43 * pu
            let wsy = sby + 226 * pu
            body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: wsx + 43 * pu, wsy; size: 176 * pu, 26 * pu; corner: 13 * pu } }
            box { at: wsx + 43 * pu, wsy; size: 176 * pu, 26 * pu; corner: 13 * pu; color: ink; opacity: (veil) * (1 - obs) }
            PPillOutline(wsx + 43 * pu, wsy, 176 * pu, 26 * pu, 13 * pu, 0, 1, pu)
            box { at: wsx + wp_srcz * 86 * pu, wsy; size: 80 * pu, 20 * pu; corner: 9 * pu; color: mint; opacity: 22% }
            PPillOutline(wsx + wp_srcz * 86 * pu, wsy, 80 * pu, 20 * pu, 9 * pu, 0, 1, pu)
            repeat i in 0..2 {
                let wsl = clamp(1 - abs(wp_srcz - i), 0, 1)
                group { scale: rs; pivot: floor(wsx + i * 86 * pu + 0.5), floor(wsy + 0.5); text pick(i, "Gallery", "Wallhaven") { at: floor(wsx + i * 86 * pu + 0.5), floor(wsy + 0.5); anchor: center; align: center; size: 13; weight: 600; color: ink; opacity: 55% + 45% * wsl + 25% * wp_src_z.$i.hover; family: "Space Grotesk" } }
                zone box wp_src_z.$i { at: wsx + i * 86 * pu, wsy; size: 86 * pu, 26 * pu; cursor: pointer; active: set_page == pg_wall; label: pick(i, "Show my wallpapers", "Search Wallhaven") }
                on press wp_src_z.$i { emit wp_src_set(i) }
            }
            //  Wallhaven's search and sort, beside the pill while it is on: Enter searches.
            group {
                show: wp_srcz > 0.02
                opacity: wp_srcz
                box { at: spx + 273 * pu, wsy; size: 156 * pu, 24 * pu; corner: 12 * pu; color: ink; opacity: 8% }
                input wh_q { at: floor(spx + 205 * pu + 0.5), floor(wsy - 6 * pu + 0.5); width: 136 * pu; size: 13; color: ink; family: "Space Grotesk"; placeholder: "Search, then Enter" }
                box { at: spx + 390 * pu, wsy; size: 62 * pu, 24 * pu; corner: 12 * pu; color: mint; opacity: 16% + 12% * wh_sort_hit.hover }
                group { scale: rs; pivot: floor(spx + 390 * pu + 0.5), floor(wsy + 0.5); text wh_sort_t { at: floor(spx + 390 * pu + 0.5), floor(wsy + 0.5); anchor: center; align: center; size: 12.5; weight: 700; color: mint; width: (58 * pu) / rs; lines: 1; family: "Space Grotesk" } }
                zone box wh_sort_hit { at: spx + 390 * pu, wsy; size: 62 * pu, 24 * pu; corner: 12 * pu; cursor: pointer; label: "Change the sort order"; active: set_page == pg_wall and wp_src == 1 }
                on press wh_sort_hit { toggle wh_dd }
            }
            on submit wh_q { emit wh_search }

            on press wp_dir_hit { wpd_open = true; emit wp_dir_browse }
            on key Escape while wpd_open { wpd_open = false }
            on change set_page { wpd_open = false }
            group { scale: rs; pivot: floor(spx + 219 * pu + 0.5), floor(sby + 364.5 * pu + 0.5); text "No wallpaper of this color" { at: floor(spx + 219 * pu + 0.5), floor(sby + 364.5 * pu + 0.5); anchor: center; size: 18; color: faint; family: "Space Grotesk"; show: wps.count < 1 and wp_src == 0 } }
            group { scale: rs; pivot: floor(spx + 219 * pu + 0.5), floor(sby + 364.5 * pu + 0.5); text wh_status { at: floor(spx + 219 * pu + 0.5), floor(sby + 364.5 * pu + 0.5); anchor: center; align: center; size: 16; color: faint; width: (380 * pu) / rs; lines: 2; show: wps.count < 1 and wp_src == 1; family: "Space Grotesk" } }
            row wp_grid {
                at: floor(spx + 15 * pu + 0.5), floor(sby + 245 * pu + 0.5)
                gap: 8 * pu
                wrap: 4
                for w in wps { WpThumb(w, pick: wp_pick) }
            }
            path { at: spx + 40 * pu, sby + 507 * pu; stroke: 1.6 * pu; color: ink; opacity: 55% + 45% * wp_prev_hit.hover; move 3 * pu, -5 * pu; line -3 * pu, 0; line 3 * pu, 5 * pu }
            group { scale: rs; pivot: floor(spx + 219 * pu + 0.5), floor(sby + 507 * pu + 0.5); text wp_pager { at: floor(spx + 219 * pu + 0.5), floor(sby + 507 * pu + 0.5); anchor: center; align: center; size: 16.5; weight: 600; width: (100 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            path { at: spx + 398 * pu, sby + 507 * pu; stroke: 1.6 * pu; color: ink; opacity: 55% + 45% * wp_next_hit.hover; move -3 * pu, -5 * pu; line 3 * pu, 0; line -3 * pu, 5 * pu }
            zone box wp_prev_hit { at: spx + 40 * pu, sby + 507 * pu; size: 30 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: set_page == pg_wall and (sby + 507 * pu) - wp.off > sby + 12 * pu and (sby + 507 * pu) - wp.off < sby + (set.h - 12) * pu }
            zone box wp_next_hit { at: spx + 398 * pu, sby + 507 * pu; size: 30 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: set_page == pg_wall and (sby + 507 * pu) - wp.off > sby + 12 * pu and (sby + 507 * pu) - wp.off < sby + (set.h - 12) * pu }
            on press wp_prev_hit { emit wp_prev }
            on press wp_next_hit { emit wp_next }
            //  Undo: for 10 s after a picture was sent to the trash, a pill at the right of the source row (where Wallhaven's sort pill is) puts the last one back.
            group {
                show: wp_undo and wp_src == 0
                box { at: spx + 379 * pu, wsy; size: 84 * pu, 24 * pu; corner: 12 * pu; color: mint; opacity: 16% + 14% * wp_undo_hit.hover }
                group { scale: rs; pivot: floor(spx + 379 * pu + 0.5), floor(wsy + 0.5); text "Undo delete" { at: floor(spx + 379 * pu + 0.5), floor(wsy + 0.5); anchor: center; align: center; size: 12.5; weight: 700; color: mint; width: (80 * pu) / rs; lines: 1; family: "Space Grotesk" } }
                zone box wp_undo_hit { at: spx + 379 * pu, wsy; size: 84 * pu, 24 * pu; corner: 12 * pu; cursor: pointer; label: "Put the last deleted wallpaper back"; active: set_page == pg_wall and wp_undo and wp_src == 0 }
                on press wp_undo_hit { emit wp_undo_do }
            }
            //  The sort order's menu, under its chip: all six at once. A press anywhere else puts it away.
            zone box wh_dd_catch { at: spx + 219 * pu, sby + 267 * pu; size: 438 * pu, 520 * pu; active: wh_dd }
            on press wh_dd_catch { wh_dd = false }
            on key Escape while wh_dd { wh_dd = false }
            group {
                show: wh_dd
                body { color: mix(obsidian, ink, 8%); shadow: 0, 4 * pu, 14 * pu, 55%, #000000; box { at: spx + 372 * pu, sby + 319 * pu; size: 104 * pu, 152 * pu; corner: 14 * pu } }
                box { at: spx + 372 * pu, sby + 319 * pu; size: 104 * pu, 152 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: 18% }
                box { at: spx + 372 * pu, sby + 259 * pu; size: 96 * pu, 22 * pu; corner: 11 * pu; color: mint; opacity: if(wh_sort_i == 0, 24%, 0%) + 14% * wh_dd_r0.hover }
                group { scale: rs; pivot: floor(spx + 372 * pu + 0.5), floor(sby + 259 * pu + 0.5); text "Top" { at: floor(spx + 372 * pu + 0.5), floor(sby + 259 * pu + 0.5); anchor: center; align: center; size: 13; weight: 600; color: if(wh_sort_i == 0, mint, ink); family: "Space Grotesk" } }
                zone box wh_dd_r0 { at: spx + 372 * pu, sby + 259 * pu; size: 100 * pu, 24 * pu; corner: 11 * pu; cursor: pointer; label: "Sort by Top"; active: wh_dd }
                on press wh_dd_r0 { emit wh_sort_set(0); wh_dd = false }
                box { at: spx + 372 * pu, sby + 283 * pu; size: 96 * pu, 22 * pu; corner: 11 * pu; color: mint; opacity: if(wh_sort_i == 1, 24%, 0%) + 14% * wh_dd_r1.hover }
                group { scale: rs; pivot: floor(spx + 372 * pu + 0.5), floor(sby + 283 * pu + 0.5); text "Latest" { at: floor(spx + 372 * pu + 0.5), floor(sby + 283 * pu + 0.5); anchor: center; align: center; size: 13; weight: 600; color: if(wh_sort_i == 1, mint, ink); family: "Space Grotesk" } }
                zone box wh_dd_r1 { at: spx + 372 * pu, sby + 283 * pu; size: 100 * pu, 24 * pu; corner: 11 * pu; cursor: pointer; label: "Sort by Latest"; active: wh_dd }
                on press wh_dd_r1 { emit wh_sort_set(1); wh_dd = false }
                box { at: spx + 372 * pu, sby + 307 * pu; size: 96 * pu, 22 * pu; corner: 11 * pu; color: mint; opacity: if(wh_sort_i == 2, 24%, 0%) + 14% * wh_dd_r2.hover }
                group { scale: rs; pivot: floor(spx + 372 * pu + 0.5), floor(sby + 307 * pu + 0.5); text "Most views" { at: floor(spx + 372 * pu + 0.5), floor(sby + 307 * pu + 0.5); anchor: center; align: center; size: 13; weight: 600; color: if(wh_sort_i == 2, mint, ink); family: "Space Grotesk" } }
                zone box wh_dd_r2 { at: spx + 372 * pu, sby + 307 * pu; size: 100 * pu, 24 * pu; corner: 11 * pu; cursor: pointer; label: "Sort by Most views"; active: wh_dd }
                on press wh_dd_r2 { emit wh_sort_set(2); wh_dd = false }
                box { at: spx + 372 * pu, sby + 331 * pu; size: 96 * pu, 22 * pu; corner: 11 * pu; color: mint; opacity: if(wh_sort_i == 3, 24%, 0%) + 14% * wh_dd_r3.hover }
                group { scale: rs; pivot: floor(spx + 372 * pu + 0.5), floor(sby + 331 * pu + 0.5); text "Favourites" { at: floor(spx + 372 * pu + 0.5), floor(sby + 331 * pu + 0.5); anchor: center; align: center; size: 13; weight: 600; color: if(wh_sort_i == 3, mint, ink); family: "Space Grotesk" } }
                zone box wh_dd_r3 { at: spx + 372 * pu, sby + 331 * pu; size: 100 * pu, 24 * pu; corner: 11 * pu; cursor: pointer; label: "Sort by Favourites"; active: wh_dd }
                on press wh_dd_r3 { emit wh_sort_set(3); wh_dd = false }
                box { at: spx + 372 * pu, sby + 355 * pu; size: 96 * pu, 22 * pu; corner: 11 * pu; color: mint; opacity: if(wh_sort_i == 4, 24%, 0%) + 14% * wh_dd_r4.hover }
                group { scale: rs; pivot: floor(spx + 372 * pu + 0.5), floor(sby + 355 * pu + 0.5); text "Random" { at: floor(spx + 372 * pu + 0.5), floor(sby + 355 * pu + 0.5); anchor: center; align: center; size: 13; weight: 600; color: if(wh_sort_i == 4, mint, ink); family: "Space Grotesk" } }
                zone box wh_dd_r4 { at: spx + 372 * pu, sby + 355 * pu; size: 100 * pu, 24 * pu; corner: 11 * pu; cursor: pointer; label: "Sort by Random"; active: wh_dd }
                on press wh_dd_r4 { emit wh_sort_set(4); wh_dd = false }
                box { at: spx + 372 * pu, sby + 379 * pu; size: 96 * pu, 22 * pu; corner: 11 * pu; color: mint; opacity: if(wh_sort_i == 5, 24%, 0%) + 14% * wh_dd_r5.hover }
                group { scale: rs; pivot: floor(spx + 372 * pu + 0.5), floor(sby + 379 * pu + 0.5); text "Best match" { at: floor(spx + 372 * pu + 0.5), floor(sby + 379 * pu + 0.5); anchor: center; align: center; size: 13; weight: 600; color: if(wh_sort_i == 5, mint, ink); family: "Space Grotesk" } }
                zone box wh_dd_r5 { at: spx + 372 * pu, sby + 379 * pu; size: 100 * pu, 24 * pu; corner: 11 * pu; cursor: pointer; label: "Sort by Best match"; active: wh_dd }
                on press wh_dd_r5 { emit wh_sort_set(5); wh_dd = false }
            }
            }
            //  The cue that there is more below: the page fades into the panel and a small "More" pill bobs at the
            //  foot of the view. It goes away at the end of the page, and pressing it scrolls a screenful down.
            let wcue = clamp((wp.h - set.h - wp.sc) / 24, 0, 1)
            let wcuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * wcue }
            }
            box { at: spx + 224 * pu, wcuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * wcue }
            box { at: spx + 224 * pu, wcuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * wp_cue_hit.hover) * wcue }
            path { at: spx + 204 * pu, wcuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: wcue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, wcuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: wcue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            group { scale: rs; pivot: floor(spx + 232 * pu + 0.5), floor(wcuey + 0.5); text "More" { at: floor(spx + 232 * pu + 0.5), floor(wcuey + 0.5); anchor: center; size: 16.5; weight: 700; color: ink; opacity: wcue; family: "Space Grotesk" } }
            zone box wp_cue_hit { at: spx + 224 * pu, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: wcue > 0.5 }
            on press wp_cue_hit { wp_scroll_to = clamp(wp_scroll_to + 342, 0, max(0, wp.h - set.h)) }
            //  ── The folder browser: the dashboard picture's (its logic lists and walks the folders: `face_*`), shown over this page: the folder's folders and pictures as a grid,
            //  scrolled with the wheel. A folder goes in when pressed; "Use this folder" keeps the one being looked at, "Default" goes back to ~/Pictures/Wallpapers. ──
            group {
                show: wpd_k > 0.004
                opacity: wpd_k
                let wd.l = spx
                let wd.t = sby + 12 * pu * (1 - wpd_k)
                let wd.w = 438 * pu
                let wd.h = 456 * pu
                let wd.vt = wd.t + 54 * pu
                let wd.vh = wd.h - 54 * pu - 56 * pu
                let wd.ch = ceil(face_pics.count / 4) * 104 * pu
                box { from: wd.l, wd.t; size: wd.w, wd.h; corner: 14 * pu; color: deep; opacity: 100% }
                body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { from: wd.l, wd.t; size: wd.w, wd.h; corner: 14 * pu } }
                box { from: wd.l, wd.t; size: wd.w, wd.h; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
                zone box wd_bg { from: wd.l, wd.t; size: wd.w, wd.h; active: wpd_open }
                on scroll wd_bg { fp_to = clamp(fp_to - wheel * 54, 0, max(0, wd.ch - wd.vh + 4 * pu)) }
                //  Up a folder, home, where we are, and the cross.
                ellipse { at: wd.l + 26 * pu, wd.t + 27 * pu; radius: 12 * pu; color: ink; opacity: (0.07 + 0.1 * wd_up.hover) * if(face_at_top, 0.4, 1) }
                group { scale: rs; pivot: floor(wd.l + 26 * pu + 0.5), floor(wd.t + 27 * pu + 0.5); GArrowTo(floor(wd.l + 26 * pu + 0.5), floor(wd.t + 27 * pu + 0.5), 270, (15.5) / 24, ink, if(face_at_top, 0.4, 1), 0) }
                zone ellipse wd_up { at: wd.l + 26 * pu, wd.t + 27 * pu; radius: 14 * pu; cursor: pointer; active: wpd_open and not face_at_top; label: "Up a folder" }
                on press wd_up { emit face_up }
                ellipse { at: wd.l + 56 * pu, wd.t + 27 * pu; radius: 12 * pu; color: ink; opacity: 0.07 + 0.1 * wd_home.hover }
                group { scale: rs; pivot: floor(wd.l + 56 * pu + 0.5), floor(wd.t + 27 * pu + 0.5); GHome(floor(wd.l + 56 * pu + 0.5), floor(wd.t + 27 * pu + 0.5), (15.5) / 24, ink, 1, 0) }
                zone ellipse wd_home { at: wd.l + 56 * pu, wd.t + 27 * pu; radius: 14 * pu; cursor: pointer; active: wpd_open; label: "Home folder" }
                on press wd_home { emit face_home }
                group { scale: rs; pivot: floor(wd.l + 82 * pu + 0.5), floor(wd.t + 27 * pu + 0.5); text face_path { at: floor(wd.l + 82 * pu + 0.5), floor(wd.t + 27 * pu + 0.5); anchor: left center; size: 16; weight: 600; width: (wd.w - 82 * pu - 48 * pu) / rs; lines: 1; family: "Space Grotesk"; color: ink } }
                ellipse { at: wd.l + wd.w - 26 * pu, wd.t + 27 * pu; radius: 12 * pu; color: ink; opacity: 0.07 + 0.1 * wd_x.hover }
                group { scale: rs; pivot: floor(wd.l + wd.w - 26 * pu + 0.5), floor(wd.t + 27 * pu + 0.5); GClose(floor(wd.l + wd.w - 26 * pu + 0.5), floor(wd.t + 27 * pu + 0.5), (15.5) / 24, ink, 1, 0) }
                zone ellipse wd_x { at: wd.l + wd.w - 26 * pu, wd.t + 27 * pu; radius: 14 * pu; cursor: pointer; active: wpd_open; label: "Close" }
                on press wd_x { wpd_open = false }
                group { scale: rs; pivot: floor(wd.l + wd.w / 2 + 0.5), floor(wd.t + wd.h / 2 + 0.5); text "Nothing here" { at: floor(wd.l + wd.w / 2 + 0.5), floor(wd.t + wd.h / 2 + 0.5); anchor: center; size: 15.5; family: "Space Grotesk"; color: faint; show: face_pics.count < 1 } }
                group {
                    clip inset 0 box { from: wd.l + 6 * pu, wd.vt; size: wd.w - 12 * pu, wd.vh; corner: 12 * pu }
                    repeat i in 0..72 {
                        let wdi.x = wd.l + 15 * pu + (i - floor(i / 4) * 4) * 106 * pu
                        let wdi.y = wd.vt + floor(i / 4) * 104 * pu - fp_s
                        group {
                            show: face_pics.count > i
                            box { from: wdi.x, wdi.y; size: 98 * pu, 98 * pu; corner: 14 * pu; color: ink; opacity: 0.07 }
                            group { scale: rs; pivot: floor(wdi.x + 49 * pu + 0.5), floor(wdi.y + 36 * pu + 0.5); group { show: face_pics.$i.dir; GFolder(floor(wdi.x + 49 * pu + 0.5), floor(wdi.y + 36 * pu + 0.5), (35.5) / 24, mint, 1, 0) } }
                            group { scale: rs; pivot: floor(wdi.x + 49 * pu + 0.5), floor(wdi.y + 76 * pu + 0.5); text face_pics.$i.name { at: floor(wdi.x + 49 * pu + 0.5), floor(wdi.y + 76 * pu + 0.5); anchor: center; align: center; size: 13.5; width: (90 * pu) / rs; lines: 1; family: "Space Grotesk"; color: ink; show: face_pics.$i.dir } }
                            group {
                                show: not face_pics.$i.dir
                                clip inset 0 box { from: wdi.x, wdi.y; size: 98 * pu, 98 * pu; corner: 14 * pu }
                                image face_pics.$i.thumb { at: wdi.x, wdi.y; size: 98 * pu, 98 * pu; opacity: 70% }
                            }
                            box { from: wdi.x, wdi.y; size: 98 * pu, 98 * pu; corner: 14 * pu; color: mint; opacity: 0.22 * wd_t.$i.hover; show: face_pics.$i.dir }
                        }
                        zone box wd_t.$i { from: wdi.x, wdi.y; size: 98 * pu, 98 * pu; corner: 14 * pu; cursor: pointer; active: wpd_open and face_pics.count > i and face_pics.$i.dir and wdi.y > wd.vt - 40 * pu and wdi.y < wd.vt + wd.vh - 40 * pu; label: "Open this folder" }
                        on press wd_t.$i { emit face_nav(i) }
                    }
                }
                box { from: wd.l + wd.w - 10 * pu, wd.vt + 4 * pu + fp_s / max(wd.ch, 1) * (wd.vh - 8 * pu); size: 3 * pu, (wd.vh - 8 * pu) * min(1, wd.vh / max(wd.ch, 1)); corner: 1.5 * pu; color: ink; opacity: 0.35; show: wd.ch > wd.vh }
                //  The two buttons under the grid.
                let wd.by = wd.t + wd.h - 28 * pu
                box { at: wd.l + wd.w - 15 * pu - 78 * pu, wd.by; size: 156 * pu, 28 * pu; corner: 14 * pu; color: mint; opacity: 22% + 12% * wd_use.hover }
                PPillOutline(wd.l + wd.w - 15 * pu - 78 * pu, wd.by, 156 * pu, 28 * pu, 14 * pu, wd_use.hover, clamp(3 * (22% + 12% * wd_use.hover), 0, 1), pu)
                box { at: wd.l + wd.w - 15 * pu - 78 * pu, wd.by; size: 156 * pu, 28 * pu; corner: 14 * pu; stroke: 1.2 * pu; color: mint; opacity: 70% }
                group { scale: rs; pivot: floor(wd.l + wd.w - 93 * pu + 0.5), floor(wd.by + 0.5); text "Use this folder" { at: floor(wd.l + wd.w - 93 * pu + 0.5), floor(wd.by + 0.5); anchor: center; align: center; size: 15.5; weight: 700; color: mint; family: "Space Grotesk" } }
                zone box wd_use { at: wd.l + wd.w - 93 * pu, wd.by; size: 156 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: wpd_open; label: "Use this folder" }
                on press wd_use { emit wp_dir_choose; wpd_open = false }
                box { at: wd.l + wd.w - 15 * pu - 156 * pu - 10 * pu - 40 * pu, wd.by; size: 80 * pu, 28 * pu; corner: 14 * pu; color: ink; opacity: 8% + 10% * wd_def.hover }
                PPillOutline(wd.l + wd.w - 15 * pu - 156 * pu - 10 * pu - 40 * pu, wd.by, 80 * pu, 28 * pu, 14 * pu, wd_def.hover, clamp(3 * (8% + 10% * wd_def.hover), 0, 1), pu)
                group { scale: rs; pivot: floor(wd.l + wd.w - 221 * pu + 0.5), floor(wd.by + 0.5); text "Default" { at: floor(wd.l + wd.w - 221 * pu + 0.5), floor(wd.by + 0.5); anchor: center; align: center; size: 15; weight: 600; color: ink; family: "Space Grotesk" } }
                zone box wd_def { at: wd.l + wd.w - 221 * pu, wd.by; size: 80 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: wpd_open; label: "Back to the default wallpaper folder" }
                on press wd_def { emit wp_dir_default; wpd_open = false }
            }
        }
}
