part BatteryCard {
    //  ── The battery panel: BEGIN ──
    //  What the bar's battery icon opens (`panel == battery`): the control center's own drawer (pages/controls_drawer.plm includes this inside its clip, so it
    //  drops out of the bar, and out of a strip or a frame's edge, exactly as the controls do), holding the charge as in the Power window, the battery's
    //  health (what it holds now against what it held new) and the charging options the firmware offers: its charge modes and, in Custom (or where there
    //  are no modes), the levels it charges between. The drawer's height is `bat_bot` (see `content_bot`). Logic: logic/battery_card.luau, through bin/vitreus-battery.
    //  Laid out in `cu` from the drawer's content top (`ck`), 276 wide about `pcx`, as the controls are.
    group {
        opacity: fb
        move: 0, (1 - fb) * 12 * cu
        let b.x0 = pcx - 138 * cu
        let b.t = ck + 8 * cu
        let b.ht = if(bc.health >= 80, #4cd964, if(bc.health >= 60, #f2c230, #e0655a))

        //  The charge: the Power window's card for this computer.
        group {
            move: floor(b.x0 + 0.5), floor(b.t + 0.5)
            BatCard("This computer", bat_pct / 100, bat_state, chg_now)
        }

        //  Health: the number big in its colour (green from 80 %, yellow from 60 %, red under), what it holds and a gauge of it, and what the battery is.
        text "HEALTH" { at: floor(b.x0 + 2 * cu + 0.5), floor(b.t + 66 * cu + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
        box { at: b.x0 + 138 * cu, b.t + 111 * cu; size: 276 * cu, 66 * cu; corner: 15 * cu; color: ink; opacity: 8% }
        box { at: b.x0 + 138 * cu, b.t + 111 * cu; size: 276 * cu, 66 * cu; corner: 15 * cu; stroke: 1 * cu; color: ink; opacity: 10% }
        text number(bc.health, 0, "%") { at: floor(b.x0 + 16 * cu + 0.5), floor(b.t + 102 * cu + 0.5); anchor: left center; size: 25; weight: 700; color: b.ht; family: "Space Grotesk"; show: bc.health >= 0 }
        text "—" { at: floor(b.x0 + 16 * cu + 0.5), floor(b.t + 102 * cu + 0.5); anchor: left center; size: 25; weight: 700; color: faint; family: "Space Grotesk"; show: bc.health < 0 }
        text bc_word { at: floor(b.x0 + 16 * cu + 0.5), floor(b.t + 126 * cu + 0.5); anchor: left center; size: 11; weight: 700; color: b.ht; opacity: 85%; family: "Space Grotesk" }
        text bc_cap { at: floor(b.x0 + 92 * cu + 0.5), floor(b.t + 97 * cu + 0.5); anchor: left center; size: 12; weight: 600; width: 172 * cu; lines: 1; color: ink; family: "Space Grotesk" }
        text bc_detail { at: floor(b.x0 + 92 * cu + 0.5), floor(b.t + 113 * cu + 0.5); anchor: left center; size: 11; width: 172 * cu; lines: 1; color: faint; family: "Space Grotesk" }
        box { from: b.x0 + 92 * cu, b.t + 127 * cu; size: 170 * cu, 4 * cu; corner: 2 * cu; color: ink; opacity: 14% }
        box { from: b.x0 + 92 * cu, b.t + 127 * cu; size: max(4 * cu, 170 * cu * clamp(bc.health / 100, 0, 1)), 4 * cu; corner: 2 * cu; color: b.ht; opacity: 85%; show: bc.health >= 0 }

        //  Charging: the firmware's modes in one picker (a thumb on the chosen one), a line on what it does, and the levels when they apply.
        text "CHARGING" { at: floor(b.x0 + 2 * cu + 0.5), floor(b.t + 160 * cu + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk"; show: bc.opt }
        let b.n = max(1, bc.nmodes)
        let b.pw = (276 - 4 * (b.n - 1)) / b.n
        //  (One slot and a thumb that travels to the mode in use, as the Settings' pickers: pages/SETTINGS-STYLE.md.)
        zone box bc_mz_sl { at: b.x0 + 138 * cu, b.t + 192 * cu; size: 276 * cu, 32 * cu; active: bc.nmodes > 0 and panel == battery }
        group {
            show: bc.nmodes > 0
            SetPick(b.x0 + b.pw / 2 * cu, b.t + 192 * cu, (b.pw + 4) * cu, b.n, 32 * cu, 1 * if(bc_modes.1.on, 1, 0) + 2 * if(bc_modes.2.on, 1, 0) + 3 * if(bc_modes.3.on, 1, 0) + 4 * if(bc_modes.4.on, 1, 0) + 5 * if(bc_modes.5.on, 1, 0), bc_mz_sl.hover, cu, 1, 0, 0, clamp(if(bc_modes.0.on, 1, 0) + if(bc_modes.1.on, 1, 0) + if(bc_modes.2.on, 1, 0) + if(bc_modes.3.on, 1, 0) + if(bc_modes.4.on, 1, 0) + if(bc_modes.5.on, 1, 0), 0, 1))
        }
        repeat i in 0..6 {
            let mx = b.x0 + (i * (b.pw + 4) + b.pw / 2) * cu
            let my = b.t + 192 * cu
            let on = if(bc_modes.$i.on, 1, 0)
            group {
                show: i < bc.nmodes
                box { at: mx, my; size: (b.pw - 2) * cu, 30 * cu; corner: 10 * cu * (1 - 0.85 * dd_k); color: ink; opacity: 7% * bc_mz.$i.hover }
                text bc_modes.$i.name { at: floor(mx + 0.5), floor(my + 0.5); anchor: center; align: center; size: 12; weight: 600; width: (b.pw - 4) * cu; lines: 1; color: mix(ink, mint, on); family: "Space Grotesk" }
                zone box bc_mz.$i { at: mx, my; size: b.pw * cu, 36 * cu; corner: 12 * cu; cursor: pointer; active: i < bc.nmodes and not bc.busy and panel == battery and fb > 0.9; label: bc_modes.$i.name }
                on press bc_mz.$i { emit bc_mode(i) }
            }
        }
        text bc_desc { at: floor(b.x0 + 2 * cu + 0.5), floor(b.t + 218 * cu + 0.5); anchor: left top; size: 11.5; width: 272 * cu; lines: 2; color: faint; family: "Space Grotesk"; show: bc.nmodes > 0 }

        //  The levels: a row each, its name, the value, and − / + either side of it (5 % a step; written a moment after the last press).
        repeat r in 0..2 {
            let ry = b.t + (bc.my + 18 + 36 * r) * cu
            let val = if(r == 0, bc.start, bc.end)
            group {
                show: bc.thr and (r == 1 or bc.hasstart)
                box { at: b.x0 + 138 * cu, ry; size: 276 * cu, 32 * cu; corner: 12 * cu; color: ink; opacity: 8% }
                text pick(r, "Start charging below", "Stop charging at") { at: floor(b.x0 + 14 * cu + 0.5), floor(ry + 0.5); anchor: left center; size: 12; weight: 600; width: 150 * cu; lines: 1; color: ink; family: "Space Grotesk" }
                text number(val, 0, " %") { at: floor(b.x0 + 222 * cu + 0.5), floor(ry + 0.5); anchor: center; align: center; size: 13; weight: 700; color: mint; family: "Space Grotesk" }
                repeat s in 0..2 {
                    let sx = b.x0 + (if(s == 0, 182, 262)) * cu
                    ellipse { at: sx, ry; radius: 11 * cu; color: ink; opacity: 10% + 12% * bc_sz.$r.$s.hover }
                    line { from: sx - 4.5 * cu, ry; to: sx + 4.5 * cu, ry; width: 1.6 * cu; color: ink }
                    line { from: sx, ry - 4.5 * cu; to: sx, ry + 4.5 * cu; width: 1.6 * cu; color: ink; show: s == 1 }
                    zone box bc_sz.$r.$s { at: sx, ry; size: 26 * cu, 26 * cu; corner: 13 * cu; cursor: pointer; active: bc.thr and panel == battery and fb > 0.9 and (r == 1 or bc.hasstart); label: pick(r * 2 + s, "Start charging lower", "Start charging higher", "Stop charging lower", "Stop charging higher") }
                    on press bc_sz.$r.$s { emit bc_step(r * 2 + s) }
                }
            }
        }
        text "Changes ask for your password" { at: floor(b.x0 + 2 * cu + 0.5), floor(b.t + (bc.ty + 6) * cu + 0.5); anchor: left center; size: 10.5; color: faint; opacity: 80%; family: "Space Grotesk"; show: bc.opt and bc.ask and not bc.bios and not bc.busy and not bc.err and not bc.pwask }
        text "Changes need your BIOS password" { at: floor(b.x0 + 2 * cu + 0.5), floor(b.t + (bc.ty + 6) * cu + 0.5); anchor: left center; size: 10.5; color: faint; opacity: 80%; family: "Space Grotesk"; show: bc.opt and bc.bios and not bc.busy and not bc.err and not bc.pwask }
        text bc_err { at: floor(b.x0 + 2 * cu + 0.5), floor(b.t + (bc.ty + 6) * cu + 0.5); anchor: left center; size: 10.5; width: 272 * cu; lines: 1; color: alert; family: "Space Grotesk"; show: bc.opt and not bc.busy and bc.err and not bc.pwask }
        //  The BIOS password, when a change waits for it: a field, Apply and Cancel, in place of the line above.
        group {
            show: bc.pwask
            let py = b.t + (bc.ty + 16) * cu
            box { at: b.x0 + 88 * cu, py; size: 176 * cu, 32 * cu; corner: 12 * cu; color: ink; opacity: 8% }
            box { at: b.x0 + 88 * cu, py; size: 176 * cu, 32 * cu; corner: 12 * cu; stroke: 1.2 * cu; color: mint; opacity: 45% }
            input bc_bpw { at: floor(b.x0 + 12 * cu + 0.5), floor(py - 7 * cu + 0.5); width: 152 * cu; size: 13; color: ink; family: "Space Grotesk"; placeholder: "BIOS password"; secret: true; label: "BIOS password"; agent: hidden }
            box { at: b.x0 + 213 * cu, py; size: 62 * cu, 32 * cu; corner: 12 * cu; color: mint; opacity: 75% + 25% * bc_bok.hover }
            text "Apply" { at: floor(b.x0 + 213 * cu + 0.5), floor(py + 0.5); anchor: center; align: center; size: 12; weight: 600; color: onmint; family: "Space Grotesk" }
            zone box bc_bok { at: b.x0 + 213 * cu, py; size: 62 * cu, 32 * cu; corner: 12 * cu; cursor: pointer; active: bc.pwask and panel == battery; label: "Apply"; agent: no }
            on press bc_bok { bc_bgo = true }
            ellipse { at: b.x0 + 262 * cu, py; radius: 13 * cu; color: ink; opacity: 10% + 12% * bc_bno.hover }
            line { from: b.x0 + 257.5 * cu, py - 4.5 * cu; to: b.x0 + 266.5 * cu, py + 4.5 * cu; width: 1.6 * cu; color: ink }
            line { from: b.x0 + 257.5 * cu, py + 4.5 * cu; to: b.x0 + 266.5 * cu, py - 4.5 * cu; width: 1.6 * cu; color: ink }
            zone box bc_bno { at: b.x0 + 262 * cu, py; size: 28 * cu, 28 * cu; corner: 14 * cu; cursor: pointer; active: bc.pwask and panel == battery; label: "Cancel" }
            on press bc_bno { emit bc_bcancel }
        }
        text "Applying…" { at: floor(b.x0 + 2 * cu + 0.5), floor(b.t + (bc.ty + 6) * cu + 0.5); anchor: left center; size: 10.5; color: mint; family: "Space Grotesk"; show: bc.opt and bc.busy }
    }
    //  ── The battery panel: END ──
}
