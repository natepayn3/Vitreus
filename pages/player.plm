part Player {
    //  The player's panel: it hangs from the window title, not from the middle of the bar, in
    //  the same glass as the bar. Its content is clipped to the drawer's shape.
    group {
        shader: pixelate, px.dm
        opacity: pown
        move: rt * (screen.width - 2 * pcx), bt * (yo + vb - 2 * (th.t + lp.hd / 2))
        clip inset 2 box { at: mix(mix(mix(pcx, dm.gx, lm), 2 * pcx - mix(pcx, dm.gx, lm), rt), dm.tex, tu), mix(mix(bar.y + dm.hh / 2, lp.cy, lm), dm.tey, tu) + bt * (2 * (th.t + lp.hd / 2) - 2 * mix(mix(bar.y + dm.hh / 2, lp.cy, lm), dm.tey, tu)); size: mix(mix(dm.w, dm.gw, lm), dm.tew, tu), mix(mix(dm.hh, dm.gh, lm), dm.teh, tu); corner: 26 * cu * (1 - 0.73 * sq) }
        //  Down the left it comes out of the strip: what is inside grows with the drawer's shape (`dm.lf`), from the strip's edge at the panel's middle, as the calendar's and the controls' do.
        group {
            pivot: mix(mix(lp.xl, 2 * pcx - lp.xl, rt), pcx, tu), mix(lp.cy, bar.y + bar.h / 2 + bt * lp.hd, tu)
            scale: mix(1, max(dm.lf, 0.05), att)
        //  ── the running windows ──
        group {
            show: dm_mode == dmm_player
            opacity: f3
            move: 0, (1 - f3) * 12 * cu
            text "No active windows" { at: floor(mdx + 0.5), floor(ck + tasks_list * cu + 16 * cu + 0.5); anchor: center; size: 14; color: faint; family: "Space Grotesk"; show: tasks.count < 1 }
            column task_col {
                at: floor(mdx - 144 * cu + 0.5), floor(ck + tasks_list * cu + 0.5)
                view: 288 * cu, (task_rows * 40 - 4) * cu
                gap: floor(4 * cu + 0.5)
                for w in tasks { TaskRow(w, focus: task_focus, kill: task_close) }
            }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: mdx + 147 * cu, ck + tasks_list * cu + task_col.scroll / max(task_col.content, 1) * ((task_rows * 40 - 4) * cu); size: 3 * cu, ((task_rows * 40 - 4) * cu) * ((task_rows * 40 - 4) * cu) / max(task_col.content, (task_rows * 40 - 4) * cu); corner: 1.5 * cu; color: ink; opacity: if(task_col.content > ((task_rows * 40 - 4) * cu) + 1, 35%, 0%) }
            //  The apps that only live in the tray: no window to list, so they get their own section.
            group {
                show: trays.count > 0
                text "BACKGROUND APPS" { at: floor(mdx - 138 * cu + 0.5), floor(ck + tray_top * cu + 11 * cu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" }
                column tray_col {
                    at: floor(mdx - 144 * cu + 0.5), floor(ck + tray_list * cu + 0.5)
                    view: 288 * cu, (max(1, tray_rows) * 40 - 4) * cu
                    gap: floor(4 * cu + 0.5)
                    for a in trays { TrayRow(a, click: tray_click, pin: tray_pin, menu: tray_menu_open) }
                }
                //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
                box { from: mdx + 147 * cu, ck + tray_list * cu + tray_col.scroll / max(tray_col.content, 1) * ((max(1, tray_rows) * 40 - 4) * cu); size: 3 * cu, ((max(1, tray_rows) * 40 - 4) * cu) * ((max(1, tray_rows) * 40 - 4) * cu) / max(tray_col.content, (max(1, tray_rows) * 40 - 4) * cu); corner: 1.5 * cu; color: ink; opacity: if(tray_col.content > ((max(1, tray_rows) * 40 - 4) * cu) + 1, 35%, 0%) }
                //  What the bar shows of them: every app, or only the pinned ones.
                box { at: mdx + 96 * cu, ck + tray_top * cu + 11 * cu; size: 86 * cu, 20 * cu; corner: 10 * cu; color: if(tray_only_pinned, mint, ink); opacity: if(tray_only_pinned, 22%, 8% + 10% * tray_mode_hit.hover) }
                PPillOutline(mdx + 96 * cu, ck + tray_top * cu + 11 * cu, 86 * cu, 20 * cu, 10 * cu, tray_mode_hit.hover, clamp(3 * (if(tray_only_pinned, 22%, 8% + 10% * tray_mode_hit.hover)), 0, 1), cu)
                text "Bar: pinned" { at: floor(mdx + 96 * cu + 0.5), floor(ck + tray_top * cu + 11 * cu + 0.5); anchor: center; align: center; size: 13; weight: 600; width: 82 * cu; lines: 1; color: mint; show: tray_only_pinned; family: "Space Grotesk" }
                text "Bar: all" { at: floor(mdx + 96 * cu + 0.5), floor(ck + tray_top * cu + 11 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 82 * cu; lines: 1; color: ink; opacity: 85%; show: not tray_only_pinned; family: "Space Grotesk" }
                zone box tray_mode_hit { at: mdx + 96 * cu, ck + tray_top * cu + 11 * cu; size: 88 * cu, 22 * cu; corner: 11 * cu; cursor: pointer }
                on press tray_mode_hit { emit tray_mode }
            }
        }

        //  ── a tray app's menu ──
        group {
            show: dm_mode == dmm_tray
            opacity: f3
            move: 0, (1 - f3) * 12 * cu
            let ty = ck + 34 * cu                           // the app plate's middle
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * cu * dd_k, ink; shadow: 0, 2 * cu, 7 * cu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: mdx, ty; size: 288 * cu, 52 * cu; corner: pr } }
            box { at: mdx, ty; size: 288 * cu, 52 * cu; corner: pr; color: ink; opacity: (veil) * (1 - obs) }
            image tm_icon { at: floor(mdx - 132 * cu + 0.5), floor(ty - 15 * cu + 0.5); size: floor(30 * cu + 0.5), floor(30 * cu + 0.5) }
            text tm_title { at: floor(mdx - 94 * cu + 0.5), floor(ty - 8 * cu + 0.5); anchor: left center; size: 15.5; weight: 700; width: 170 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            text tm_sub { at: floor(mdx - 94 * cu + 0.5), floor(ty + 9 * cu + 0.5); anchor: left center; size: 12; width: 170 * cu; lines: 1; color: faint; family: "Space Grotesk" }
            //  The pin: a thumbtack, filled while the app is kept on the bar.
            ellipse { at: mdx + 122 * cu, ty; radius: 14 * cu; color: ink; opacity: 6% + 10% * tm_pin_hit.hover }
            ellipse { at: mdx + 122 * cu, ty - 3 * cu; radius: 4 * cu; color: mix(ink, mint, if(tm_pinned, 1, 0)); opacity: if(tm_pinned, 100%, 0%) }
            ellipse { at: mdx + 122 * cu, ty - 3 * cu; radius: 4 * cu; stroke: 1.4 * cu; color: mix(ink, mint, if(tm_pinned, 1, 0)); opacity: if(tm_pinned, 0%, 70%) }
            line { from: mdx + 122 * cu, ty + 1 * cu; to: mdx + 122 * cu, ty + 7 * cu; width: 1.5 * cu; color: mix(ink, mint, if(tm_pinned, 1, 0)); opacity: if(tm_pinned, 100%, 70%) }
            zone box tm_pin_hit { at: mdx + 122 * cu, ty; size: 28 * cu, 28 * cu; corner: pr; cursor: pointer }
            on press tm_pin_hit { emit tm_pin }
            //  Open and Alt: what a left and a middle click on its icon would do.
            box { at: mdx - 71 * cu, ck + 79 * cu; size: 138 * cu, 26 * cu; corner: 9 * cu; color: ink; opacity: 8% + 10% * tm_open_hit.hover }
            PPillOutline(mdx - 71 * cu, ck + 79 * cu, 138 * cu, 26 * cu, 9 * cu, tm_open_hit.hover, clamp(3 * (8% + 10% * tm_open_hit.hover), 0, 1), cu)
            text "Open" { at: floor(mdx - 71 * cu + 0.5), floor(ck + 79 * cu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 130 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box tm_open_hit { at: mdx - 71 * cu, ck + 79 * cu; size: 140 * cu, 28 * cu; corner: 9 * cu; cursor: pointer }
            on press tm_open_hit { emit tm_open }
            box { at: mdx + 71 * cu, ck + 79 * cu; size: 138 * cu, 26 * cu; corner: 9 * cu; color: ink; opacity: 8% + 10% * tm_alt_hit.hover }
            PPillOutline(mdx + 71 * cu, ck + 79 * cu, 138 * cu, 26 * cu, 9 * cu, tm_alt_hit.hover, clamp(3 * (8% + 10% * tm_alt_hit.hover), 0, 1), cu)
            text "Alt" { at: floor(mdx + 71 * cu + 0.5), floor(ck + 79 * cu + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 130 * cu; lines: 1; color: ink; opacity: 85%; family: "Space Grotesk" }
            zone box tm_alt_hit { at: mdx + 71 * cu, ck + 79 * cu; size: 140 * cu, 28 * cu; corner: 9 * cu; cursor: pointer }
            on press tm_alt_hit { emit tm_alt }
            //  Its menu.
            text "This app provides no menu." { at: floor(mdx + 0.5), floor(ck + 115 * cu + 0.5); anchor: center; size: 14; color: faint; family: "Space Grotesk"; show: not tm_has_menu }
            column tm_col {
                at: floor(mdx - 144 * cu + 0.5), floor(ck + 100 * cu + 0.5)
                view: 288 * cu, tm.list * cu
                gap: floor(2 * cu + 0.5)
                for r in tray_menu { TmRow(r, pick: tray_menu_pick) }
            }
            //  A thin thumb beside the list while there is more of it than fits: how far it is scrolled, and how much is seen.
            box { from: mdx + 147 * cu, ck + 100 * cu + tm_col.scroll / max(tm_col.content, 1) * (tm.list * cu); size: 3 * cu, (tm.list * cu) * (tm.list * cu) / max(tm_col.content, tm.list * cu); corner: 1.5 * cu; color: ink; opacity: if(tm_col.content > (tm.list * cu) + 1, 35%, 0%) }
        }

        }
    }
}
