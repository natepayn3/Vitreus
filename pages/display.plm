part Display {
        //  The Display page: the monitors on a canvas you can drag them on, an inspector for the
        //  one that is selected (mode, refresh rate, scale, rotation, SDR levels), and saved profiles. What it
        //  edits is a draft; Apply sends it to Hyprland and the change is on trial until it is kept (see the Display
        //  section of vitreus.luau).
        group {
            show: set_pgd > 0.01
            opacity: set_pgd
            let disp.sc = clamp(disp_scroll, 0, max(0, disp.h - set.h))     // how far the page is scrolled, unscaled
            let disp.off = disp.sc * pu
            let cvx = spx + 219 * pw - 200 * pu            // the arrangement canvas (400 x 190, in `pu`: logic/display lays the monitors out on it), centred in the card
            let cvy = sby + 68 * pu
            let dtop = sby + 302 * pu                      // the inspector card's top
            let ptop = sby + 662 * pu                      // the profiles card's top

            //  The page scrolls: everything below moves up by `disp.off` inside a viewport as tall as the Wallpaper page
            //  (set.h), and only the controls that are in view are live, so one scrolled out of sight catches no click
            //  (a clip does not stop a zone). The wheel is caught by the zone under everything else.
            clip box { at: spx + 224 * pw, sby + set.h / 2 * pu; size: 456 * pw, set.h * pu }
            zone box disp_wheel { at: spx + 219 * pw, sby + set.h / 2 * pu; size: 446 * pw, set.h * pu }
            on scroll disp_wheel { disp_scroll_to = clamp(disp_scroll_to - wheel * 40, 0, max(0, disp.h - set.h)) }
            group {
                move: 0, -disp.off

            //  ── Card one: the monitors ──
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 149 * pu; size: 438 * pw, 246 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 149 * pu, 438 * pw, 246 * pu, 881.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 149 * pu; size: 438 * pw, 246 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 149 * pu; size: 438 * pw, 246 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 149 * pu; size: 438 * pw, 246 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 13 * pu + 0.5); text "MONITORS" { at: floor(spx + 14 * pw + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            box { at: spx + 394 * pw - 72 * pu, sby + 50 * pu; size: 92 * pu, 20 * pu; corner: (10 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: (8% + 10% * disp_arr_hit.hover) * (40% + 60% * clamp(disp_count - 1, 0, 1)) }
            PPillOutline(spx + 394 * pw - 72 * pu, sby + 50 * pu, 92 * pu, 20 * pu, 10 * pu, disp_arr_hit.hover, clamp(3 * ((8% + 10% * disp_arr_hit.hover) * (40% + 60% * clamp(disp_count - 1, 0, 1))), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 394 * pw - 72 * pu + 0.5), floor(sby + 50 * pu + 0.5); text "Auto-arrange" { at: floor(spx + 394 * pw - 72 * pu + 0.5), floor(sby + 50 * pu + 0.5); anchor: center; align: center; size: 15; weight: 600; width: (88 * pw) / rs; lines: 1; color: ink; opacity: 85% * (40% + 60% * clamp(disp_count - 1, 0, 1)); family: "Space Grotesk" } }
            zone box disp_arr_hit { at: spx + 394 * pw - 72 * pu, sby + 50 * pu; size: 94 * pu, 22 * pu; corner: 11 * pu; cursor: pointer; active: (disp_count > 1) and (sby + 50 * pu) - disp.off > sby and (sby + 50 * pu) - disp.off < sby + set.h * pu }
            on press disp_arr_hit { emit disp_arrange }
            box { at: spx + 394 * pw, sby + 50 * pu; size: 48 * pu, 20 * pu; corner: (10 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: (8% + 10% * disp_swap_hit.hover) * (40% + 60% * clamp(disp_count - 1, 0, 1)) }
            PPillOutline(spx + 394 * pw, sby + 50 * pu, 48 * pu, 20 * pu, 10 * pu, disp_swap_hit.hover, clamp(3 * ((8% + 10% * disp_swap_hit.hover) * (40% + 60% * clamp(disp_count - 1, 0, 1))), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 394 * pw + 0.5), floor(sby + 50 * pu + 0.5); text "Swap" { at: floor(spx + 394 * pw + 0.5), floor(sby + 50 * pu + 0.5); anchor: center; align: center; size: 15; weight: 600; width: (44 * pw) / rs; lines: 1; color: ink; opacity: 85% * (40% + 60% * clamp(disp_count - 1, 0, 1)); family: "Space Grotesk" } }
            zone box disp_swap_hit { at: spx + 394 * pw, sby + 50 * pu; size: 50 * pu, 22 * pu; corner: 11 * pu; cursor: pointer; active: (disp_count > 1) and (sby + 50 * pu) - disp.off > sby and (sby + 50 * pu) - disp.off < sby + set.h * pu }
            on press disp_swap_hit { emit disp_swap }
            box { at: cvx + 200 * pu, cvy + 95 * pu; size: 400 * pu, 190 * pu; corner: 10 * pu; color: #000000; opacity: 22% }
            repeat i in 0..4 {
                let bx = cvx + disp_b.$i.x * pu
                let by = cvy + disp_b.$i.y * pu
                let bw = disp_b.$i.w * pu
                let bh = disp_b.$i.h * pu
                box { from: bx, by; size: bw, bh; corner: 6 * pu; color: if(disp_b.$i.sel, mint, ink); opacity: if(disp_b.$i.on, if(disp_b.$i.sel, 26%, 12%) + 6% * disp_mz.$i.hover, 0%) }
                //  The wallpaper the monitor shows, cropped to fill the tile (the picture is 16:9: the larger of the tile's width and its height's worth).
                group {
                    show: disp_b.$i.on
                    clip inset 0 box { from: bx, by; size: bw, bh; corner: 6 * pu }
                    let wpw = max(bw, bh * 16 / 9)
                    let wph = wpw * 9 / 16
                    image disp_wpi.$i { at: bx + (bw - wpw) / 2, by + (bh - wph) / 2; size: wpw, wph; opacity: 85% }
                    box { from: bx, by; size: bw, bh; color: #000000; opacity: 40% - 12% * disp_mz.$i.hover - 10% * if(disp_b.$i.sel, 1, 0) }
                }
                box { from: bx, by; size: bw, bh; corner: 6 * pu; stroke: 1.5 * pu; color: mint; opacity: if(disp_b.$i.on and disp_b.$i.sel, 100%, 0%) }
                box { from: bx, by; size: bw, bh; corner: 6 * pu; stroke: 1 * pu; color: ink; opacity: if(disp_b.$i.on and not disp_b.$i.sel, 18%, 0%) }
                ellipse { at: bx + bw - 7 * pu, by + bh - 7 * pu; radius: 2.5 * pu; color: mint; opacity: if(disp_b.$i.on and disp_b.$i.dirty, 100%, 0%) }
                group { scale: rs; pivot: floor(bx + 8 * pu + 0.5), floor(by + 14 * pu + 0.5); text disp_b.$i.name { at: floor(bx + 8 * pu + 0.5), floor(by + 14 * pu + 0.5); anchor: left center; size: 16.5; weight: 700; width: (max(10 * pu, bw - 40 * pu)) / rs; lines: 1; color: ink; show: disp_b.$i.on; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(bx + 8 * pu + 0.5), floor(by + 30 * pu + 0.5); text disp_b.$i.mode { at: floor(bx + 8 * pu + 0.5), floor(by + 30 * pu + 0.5); anchor: left center; size: 13.5; width: (max(10 * pu, bw - 16 * pu)) / rs; lines: 1; color: ink; opacity: 75%; show: disp_b.$i.on and bh > 44 * pu; family: "Space Grotesk" } }
                //  Badges along the bottom: the main display (the one at the desk's origin) and the scale.
                box { at: bx + 8 * pu + 17 * pu, by + bh - 14 * pu; size: 34 * pu, 14 * pu; corner: 7 * pu; color: mint; opacity: if(disp_b.$i.on and disp_b.$i.main and bh > 52 * pu, 30%, 0%) }
                group { scale: rs; pivot: floor(bx + 25 * pu + 0.5), floor(by + bh - 14 * pu + 0.5); text "MAIN" { at: floor(bx + 25 * pu + 0.5), floor(by + bh - 14 * pu + 0.5); anchor: center; align: center; size: 11; weight: 700; color: mint; show: disp_b.$i.on and disp_b.$i.main and bh > 52 * pu; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(bx + bw - 8 * pu - if(disp_b.$i.dirty, 8 * pu, 0) + 0.5), floor(by + bh - 14 * pu + 0.5); text disp_b.$i.scale { at: floor(bx + bw - 8 * pu - if(disp_b.$i.dirty, 8 * pu, 0) + 0.5), floor(by + bh - 14 * pu + 0.5); anchor: right center; size: 12; weight: 600; color: ink; opacity: 70%; show: disp_b.$i.on and bh > 52 * pu; family: "Space Grotesk" } }
                //  Turn it a quarter: a ring in the corner.
                ellipse { at: bx + bw - 14 * pu, by + 14 * pu; radius: 9 * pu; color: ink; opacity: if(disp_b.$i.on, 14% + 22% * disp_rm.$i.hover, 0%) }
                arc { at: bx + bw - 14 * pu, by + 14 * pu - 1 * pu; radius: 4.5 * pu; span: 270deg; width: 1.5 * pu; rotate: 45deg; color: ink; opacity: if(disp_b.$i.on, 90%, 0%) }
                zone box disp_mz.$i { from: bx, by; size: bw, bh; cursor: if(disp_mz.$i.pressed > 0.5, grabbing, grab); active: (disp_b.$i.on) and (by + (bh) / 2) - disp.off > sby and (by + (bh) / 2) - disp.off < sby + set.h * pu }
                on press disp_mz.$i { disp_grab_i = i; disp_px = ((pointer.x - tx.pnl) - cvx) / pu; disp_py = ((pointer.y - ty.set) - (cvy - disp.off)) / pu; emit disp_grab }
                on drag disp_mz.$i { disp_px = ((pointer.x - tx.pnl) - cvx) / pu; disp_py = ((pointer.y - ty.set) - (cvy - disp.off)) / pu; emit disp_drag }
                on release disp_mz.$i { emit disp_drop }
                zone box disp_rm.$i { at: bx + bw - 14 * pu, by + 14 * pu; size: 22 * pu, 22 * pu; corner: 11 * pu; cursor: pointer; active: (disp_b.$i.on) and (by + 14 * pu) - disp.off > sby and (by + 14 * pu) - disp.off < sby + set.h * pu }
                on press disp_rm.$i { emit disp_rot_mon(i) }
            }

            //  ── Card two: the inspector ──
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, dtop + 165 * pu; size: 438 * pw, 330 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, dtop + 165 * pu, 438 * pw, 330 * pu, 248.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, dtop + 165 * pu; size: 438 * pw, 330 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, dtop + 165 * pu; size: 438 * pw, 330 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, dtop + 165 * pu; size: 438 * pw, 330 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(dtop - 13 * pu + 0.5); text "INSPECTOR" { at: floor(spx + 14 * pw + 0.5), floor(dtop - 13 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            repeat i in 0..4 {
                let pxx = spx + 392 * pw - (i - (4 - disp_count)) * 74 * pu      // the pills that are in use sit at the right, the size of Reset and Apply, the last one right over Apply (slot i is monitor 3 - i, so with fewer than four the low slots are empty)
                box { at: pxx, dtop + 24 * pu; size: 64 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: if(disp_sel == 3 - i, mint, ink); opacity: if(disp_pill.$i.on, if(disp_sel == 3 - i, 24%, 8% + 10% * disp_pill_hit.$i.hover), 0%) }
                PPillOutline(pxx, dtop + 24 * pu, 64 * pu, 24 * pu, 12 * pu, disp_pill_hit.$i.hover, clamp(3 * (if(disp_pill.$i.on, if(disp_sel == 3 - i, 24%, 8% + 10% * disp_pill_hit.$i.hover), 0%)), 0, 1), pu)
                group { scale: rs; pivot: floor(pxx + 0.5), floor(dtop + 24 * pu + 0.5); text disp_pill.$i.text { at: floor(pxx + 0.5), floor(dtop + 24 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (60 * pw) / rs; lines: 1; color: if(disp_sel == 3 - i, mint, ink); show: disp_pill.$i.on; family: "Space Grotesk" } }
                zone box disp_pill_hit.$i { at: pxx, dtop + 24 * pu; size: 66 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (disp_pill.$i.on) and (dtop + 24 * pu) - disp.off > sby and (dtop + 24 * pu) - disp.off < sby + set.h * pu }
                on press disp_pill_hit.$i { emit disp_pick_mon(3 - i) }
            }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(dtop + 24 * pu + 0.5); text disp_title { at: floor(spx + 14 * pw + 0.5), floor(dtop + 24 * pu + 0.5); anchor: left center; width: (if(disp_count > 1, 410 - 74 * disp_count - 10, 410) * pu) / rs; lines: 1; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(dtop + 40 * pu + 0.5); text disp_desc { at: floor(spx + 14 * pw + 0.5), floor(dtop + 40 * pu + 0.5); anchor: left center; size: 15; width: (410 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(dtop + 55 * pu + 0.5); text disp_cur { at: floor(spx + 14 * pw + 0.5), floor(dtop + 55 * pu + 0.5); anchor: left center; size: 15; width: (410 * pw) / rs; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk" } }

            //  Resolution: a dropdown of what the monitor offers, biggest first (the list itself is drawn last, below).
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(dtop + 86 * pu + 0.5); text "Resolution" { at: floor(spx + 14 * pw + 0.5), floor(dtop + 86 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            let rtw = disp_rw.width + 44 * pu                 // the trigger: its text and room for the chevron (always: the list opens even when it holds only one resolution)
            let rx0 = spx + 122 * pw                          // its left edge: the one every control below starts at, like the sliders
            box { from: rx0, dtop + 73 * pu; size: rtw, 26 * pu; corner: 13 * pu; color: ink; opacity: 8% + 8% * disp_res_hit.hover + 6% * disp_dd }
            box { from: rx0, dtop + 73 * pu; size: rtw, 26 * pu; corner: 13 * pu; stroke: 1.2 * pu; color: mint; opacity: 70% * disp_dd }
            text disp_res_text { at: floor(rx0 + 16 * pu + 0.5), floor(dtop + 86 * pu + 0.5); anchor: left center; size: 18; weight: 700; color: ink; measure: disp_rw; family: "Space Grotesk" }
            path { at: rx0 + rtw - 17 * pu, dtop + 86 * pu; stroke: 1.6 * pu; color: ink; opacity: 60% + 40% * disp_res_hit.hover; move -4 * pu, (-2 + 4 * disp_dd) * pu; line 0, (2 - 4 * disp_dd) * pu; line 4 * pu, (-2 + 4 * disp_dd) * pu }
            zone box disp_res_hit { from: rx0, dtop + 73 * pu; size: rtw, 26 * pu; corner: 13 * pu; cursor: pointer; active: (disp_res_count > 0) and (dtop + 73 * pu + (26 * pu) / 2) - disp.off > sby and (dtop + 73 * pu + (26 * pu) / 2) - disp.off < sby + set.h * pu }
            on press disp_res_hit { toggle disp_res_open }

            //  Refresh rate: the rates this resolution has.
            measure ldr_dis1
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(dtop + 122 * pu + 0.5); text "Refresh rate" { at: floor(spx + 14 * pw + 0.5), floor(dtop + 122 * pu + 0.5); measure: ldr_dis1; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            let dhz_n = max((if(disp_hz.0.on, 1, 0) + if(disp_hz.1.on, 1, 0) + if(disp_hz.2.on, 1, 0) + if(disp_hz.3.on, 1, 0) + if(disp_hz.4.on, 1, 0) + if(disp_hz.5.on, 1, 0)), 1)          // how many choices there are: the row is laid out from the card's right edge, as every picker is
            zone box disp_hz_sl { at: spx + (424 - dhz_n * 56 / 2) * pw, dtop + 122 * pu; size: dhz_n * 56 * pw, 24 * pu }
            SetPick(spx + (424 - (dhz_n - 0.5) * 56) * pw, dtop + 122 * pu, 56 * pw, max((if(disp_hz.0.on, 1, 0) + if(disp_hz.1.on, 1, 0) + if(disp_hz.2.on, 1, 0) + if(disp_hz.3.on, 1, 0) + if(disp_hz.4.on, 1, 0) + if(disp_hz.5.on, 1, 0)), 1), 24 * pu, (if(disp_hz.1.lit, 1, 0) + 2 * if(disp_hz.2.lit, 1, 0) + 3 * if(disp_hz.3.lit, 1, 0) + 4 * if(disp_hz.4.lit, 1, 0) + 5 * if(disp_hz.5.lit, 1, 0)), disp_hz_sl.hover, pu)
            PLeader(spx + 14 * pw + ldr_dis1.width * rs + 8 * pu, spx + (424 - (dhz_n - 0.5) * 56) * pw - 56 * pw / 2 - 6 * pu, dtop + 122 * pu, disp_hz_sl.hover, pu)
            repeat i in 0..6 {
                let hx = spx + (424 - (dhz_n - 0.5) * 56) * pw + i * 56 * pw                // 122 + half a chip: the shared left edge
                box { at: hx, dtop + 122 * pu; size: 52 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * disp_hz_hit.$i.hover }
                group { scale: rs; pivot: floor(hx + 0.5), floor(dtop + 122 * pu + 0.5); text disp_hz.$i.text { at: floor(hx + 0.5), floor(dtop + 122 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (50 * pw) / rs; lines: 1; color: if(disp_hz.$i.lit, mint, ink); show: disp_hz.$i.on; family: "Space Grotesk" } }
                zone box disp_hz_hit.$i { at: hx, dtop + 122 * pu; size: 54 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (disp_hz.$i.on) and (dtop + 122 * pu) - disp.off > sby and (dtop + 122 * pu) - disp.off < sby + set.h * pu }
                on press disp_hz_hit.$i { emit disp_pick_hz(i) }
            }

            //  Scale.
            measure ldr_dis2
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(dtop + 158 * pu + 0.5); text "Scale" { at: floor(spx + 14 * pw + 0.5), floor(dtop + 158 * pu + 0.5); measure: ldr_dis2; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            zone box disp_sc_hit_sl { at: spx + 144.5 * pw + (7 - 1) * 43 * pw / 2, dtop + 158 * pu + (1 - 1) * 0 / 2; size: 7 * 43 * pw, 24 * pu + (1 - 1) * 0 }
            SetPick(spx + 144.5 * pw, dtop + 158 * pu, 43 * pw, 7, 24 * pu, disp_scale, disp_sc_hit_sl.hover, pu)
            PLeader(spx + 14 * pw + ldr_dis2.width * rs + 8 * pu, spx + 144.5 * pw - 43 * pw / 2 - 6 * pu, dtop + 158 * pu, disp_sc_hit_sl.hover, pu)
            repeat i in 0..7 {
                let sx = spx + 144.5 * pw + i * 43 * pw
                box { at: sx, dtop + 158 * pu; size: 40 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * disp_sc_hit.$i.hover }
                group { scale: rs; pivot: floor(sx + 0.5), floor(dtop + 158 * pu + 0.5); text pick(i, "Auto", "1.0×", "1.25×", "1.33×", "1.5×", "1.75×", "2.0×") { at: floor(sx + 0.5), floor(dtop + 158 * pu + 0.5); anchor: center; align: center; size: 15; weight: 600; width: (38 * pw) / rs; lines: 1; color: if(disp_scale == i, mint, ink); family: "Space Grotesk" } }
                zone box disp_sc_hit.$i { at: sx, dtop + 158 * pu; size: 42 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (dtop + 158 * pu) - disp.off > sby and (dtop + 158 * pu) - disp.off < sby + set.h * pu }
                on press disp_sc_hit.$i { emit disp_pick_scale(i) }
            }

            //  Rotation.
            measure ldr_dis3
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(dtop + 194 * pu + 0.5); text "Rotation" { at: floor(spx + 14 * pw + 0.5), floor(dtop + 194 * pu + 0.5); measure: ldr_dis3; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            zone box disp_rot_hit_sl { at: spx + 193 * pw + (4 - 1) * 66 * pw / 2, dtop + 194 * pu + (1 - 1) * 0 / 2; size: 4 * 66 * pw, 24 * pu + (1 - 1) * 0 }
            SetPick(spx + 193 * pw, dtop + 194 * pu, 66 * pw, 4, 24 * pu, disp_rot, disp_rot_hit_sl.hover, pu)
            PLeader(spx + 14 * pw + ldr_dis3.width * rs + 8 * pu, spx + 193 * pw - 66 * pw / 2 - 6 * pu, dtop + 194 * pu, disp_rot_hit_sl.hover, pu)
            repeat i in 0..4 {
                let rx = spx + 193 * pw + i * 66 * pw
                box { at: rx, dtop + 194 * pu; size: 60 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * disp_rot_hit.$i.hover }
                group { scale: rs; pivot: floor(rx + 0.5), floor(dtop + 194 * pu + 0.5); text pick(i, "Normal", "90°", "180°", "270°") { at: floor(rx + 0.5), floor(dtop + 194 * pu + 0.5); anchor: center; align: center; size: 15; weight: 600; width: (56 * pw) / rs; lines: 1; color: if(disp_rot == i, mint, ink); family: "Space Grotesk" } }
                zone box disp_rot_hit.$i { at: rx, dtop + 194 * pu; size: 62 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (dtop + 194 * pu) - disp.off > sby and (dtop + 194 * pu) - disp.off < sby + set.h * pu }
                on press disp_rot_hit.$i { emit disp_pick_rot(i) }
            }

            //  SDR brightness (1.00 to 2.00) and saturation (0.90 to 1.10), for HDR modes.
            let dsl.x0 = spx + 122 * pw
            let dsl.w = 250 * pw
            let dh = 12 * pu
            measure ldr_dis4
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(dtop + 230 * pu + 0.5); text "SDR brightness" { at: floor(spx + 14 * pw + 0.5), floor(dtop + 230 * pu + 0.5); measure: ldr_dis4; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(dsl.x0, dtop + 230 * pu, dsl.w, clamp(clamp(disp_sdrb - 1, 0, 1), 0, 1), disp_sdrb_hit.hover, cu, dh, 0)
            PLeader(spx + 14 * pw + ldr_dis4.width * rs + 8 * pu, dsl.x0 - 6 * pu, dtop + 230 * pu, disp_sdrb_hit.hover, pu)
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(dtop + 230 * pu + 0.5); text disp_sdrb_text { at: floor(spx + 424 * pw + 0.5), floor(dtop + 230 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box disp_sdrb_hit { at: dsl.x0 + dsl.w / 2, dtop + 230 * pu; size: dsl.w + 24 * pu, 30 * pu; cursor: pointer; active: (dtop + 230 * pu) - disp.off > sby and (dtop + 230 * pu) - disp.off < sby + set.h * pu }
            on press disp_sdrb_hit { emit disp_sdrb_set(clamp(((pointer.x - tx.pnl) - dsl.x0) / dsl.w, 0, 1)) }
            on drag disp_sdrb_hit { emit disp_sdrb_set(clamp(((pointer.x - tx.pnl) - dsl.x0) / dsl.w, 0, 1)) }
            measure ldr_dis5
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(dtop + 266 * pu + 0.5); text "SDR saturation" { at: floor(spx + 14 * pw + 0.5), floor(dtop + 266 * pu + 0.5); measure: ldr_dis5; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(dsl.x0, dtop + 266 * pu, dsl.w, clamp(clamp((disp_sdrs - 0.9) / 0.2, 0, 1), 0, 1), disp_sdrs_hit.hover, cu, dh, 0)
            PLeader(spx + 14 * pw + ldr_dis5.width * rs + 8 * pu, dsl.x0 - 6 * pu, dtop + 266 * pu, disp_sdrs_hit.hover, pu)
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(dtop + 266 * pu + 0.5); text disp_sdrs_text { at: floor(spx + 424 * pw + 0.5), floor(dtop + 266 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box disp_sdrs_hit { at: dsl.x0 + dsl.w / 2, dtop + 266 * pu; size: dsl.w + 24 * pu, 30 * pu; cursor: pointer; active: (dtop + 266 * pu) - disp.off > sby and (dtop + 266 * pu) - disp.off < sby + set.h * pu }
            on press disp_sdrs_hit { emit disp_sdrs_set(clamp(((pointer.x - tx.pnl) - dsl.x0) / dsl.w, 0, 1)) }
            on drag disp_sdrs_hit { emit disp_sdrs_set(clamp(((pointer.x - tx.pnl) - dsl.x0) / dsl.w, 0, 1)) }

            //  The bottom row: what it says while nothing is on trial (and Reset, Apply), and while something is
            //  (and Keep, Revert): the question is here, where the eyes are after pressing Apply.
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(dtop + 296 * pu + 0.5); text disp_msg { at: floor(spx + 14 * pw + 0.5), floor(dtop + 296 * pu + 0.5); anchor: left center; size: 15; width: (250 * pw) / rs; lines: 1; color: mint; show: disp_trial <= 0; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(dtop + 310 * pu + 0.5); text "HDR is experimental in Hyprland: some apps look washed out." { at: floor(spx + 14 * pw + 0.5), floor(dtop + 310 * pu + 0.5); anchor: left center; size: 13.5; width: (300 * pw) / rs; lines: 1; color: faint; opacity: 80%; show: disp_trial <= 0; family: "Space Grotesk" } }
            box { at: spx + 392 * pw - 70 * pu, dtop + 304 * pu; size: 56 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: if(disp_trial <= 0, 8% + 10% * disp_reset_hit.hover, 0%) }
            PPillOutline(spx + 392 * pw - 70 * pu, dtop + 304 * pu, 56 * pu, 24 * pu, 12 * pu, disp_reset_hit.hover, clamp(3 * (if(disp_trial <= 0, 8% + 10% * disp_reset_hit.hover, 0%)), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 392 * pw - 70 * pu + 0.5), floor(dtop + 304 * pu + 0.5); text "Reset" { at: floor(spx + 392 * pw - 70 * pu + 0.5), floor(dtop + 304 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; color: ink; opacity: 85%; show: disp_trial <= 0; family: "Space Grotesk" } }
            zone box disp_reset_hit { at: spx + 392 * pw - 70 * pu, dtop + 304 * pu; size: 58 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (disp_trial <= 0) and (dtop + 304 * pu) - disp.off > sby and (dtop + 304 * pu) - disp.off < sby + set.h * pu }
            on press disp_reset_hit { emit disp_reset }
            box { at: spx + 392 * pw, dtop + 304 * pu; size: 64 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: mint; opacity: if(disp_trial <= 0, (35% + 65% * if(disp_dirty, 1, 0)) * (85% + 15% * disp_apply_hit.hover), 0%) }
            PPillOutline(spx + 392 * pw, dtop + 304 * pu, 64 * pu, 24 * pu, 12 * pu, disp_apply_hit.hover, clamp(3 * (if(disp_trial <= 0, (35% + 65% * if(disp_dirty, 1, 0)) * (85% + 15% * disp_apply_hit.hover), 0%)), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 392 * pw + 0.5), floor(dtop + 304 * pu + 0.5); text "Apply" { at: floor(spx + 392 * pw + 0.5), floor(dtop + 304 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 700; color: onmint; show: disp_trial <= 0; family: "Space Grotesk" } }
            zone box disp_apply_hit { at: spx + 392 * pw, dtop + 304 * pu; size: 66 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (disp_trial <= 0 and disp_dirty) and (dtop + 304 * pu) - disp.off > sby and (dtop + 304 * pu) - disp.off < sby + set.h * pu }
            on press disp_apply_hit { emit disp_apply }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(dtop + 304 * pu + 0.5); text disp_trial_text { at: floor(spx + 14 * pw + 0.5), floor(dtop + 304 * pu + 0.5); anchor: left center; size: 16.5; weight: 600; width: (250 * pw) / rs; lines: 1; color: mint; show: disp_trial > 0; family: "Space Grotesk" } }
            box { at: spx + 392 * pw - 70 * pu, dtop + 304 * pu; size: 64 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: if(disp_trial > 0, 8% + 12% * disp_revert_hit.hover, 0%) }
            PPillOutline(spx + 392 * pw - 70 * pu, dtop + 304 * pu, 64 * pu, 24 * pu, 12 * pu, disp_revert_hit.hover, clamp(3 * (if(disp_trial > 0, 8% + 12% * disp_revert_hit.hover, 0%)), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 392 * pw - 70 * pu + 0.5), floor(dtop + 304 * pu + 0.5); text "Revert" { at: floor(spx + 392 * pw - 70 * pu + 0.5), floor(dtop + 304 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; color: ink; show: disp_trial > 0; family: "Space Grotesk" } }
            zone box disp_revert_hit { at: spx + 392 * pw - 70 * pu, dtop + 304 * pu; size: 66 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (disp_trial > 0) and (dtop + 304 * pu) - disp.off > sby and (dtop + 304 * pu) - disp.off < sby + set.h * pu }
            on press disp_revert_hit { emit disp_revert }
            box { at: spx + 392 * pw, dtop + 304 * pu; size: 64 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: mint; opacity: if(disp_trial > 0, 85% + 15% * disp_keep_hit.hover, 0%) }
            PPillOutline(spx + 392 * pw, dtop + 304 * pu, 64 * pu, 24 * pu, 12 * pu, disp_keep_hit.hover, clamp(3 * (if(disp_trial > 0, 85% + 15% * disp_keep_hit.hover, 0%)), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 392 * pw + 0.5), floor(dtop + 304 * pu + 0.5); text "Keep" { at: floor(spx + 392 * pw + 0.5), floor(dtop + 304 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 700; color: onmint; show: disp_trial > 0; family: "Space Grotesk" } }
            zone box disp_keep_hit { at: spx + 392 * pw, dtop + 304 * pu; size: 66 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (disp_trial > 0) and (dtop + 304 * pu) - disp.off > sby and (dtop + 304 * pu) - disp.off < sby + set.h * pu }
            on press disp_keep_hit { emit disp_keep }

            //  ── Card three: the profiles ──
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, ptop + (disp.prows + 108) / 2 * pu; size: 438 * pw, (disp.prows + 108) * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, ptop + (disp.prows + 108) / 2 * pu, 438 * pw, (disp.prows + 108) * pu, 983.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, ptop + (disp.prows + 108) / 2 * pu; size: 438 * pw, (disp.prows + 108) * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, ptop + (disp.prows + 108) / 2 * pu; size: 438 * pw, (disp.prows + 108) * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, ptop + (disp.prows + 108) / 2 * pu; size: 438 * pw, (disp.prows + 108) * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(ptop - 13 * pu + 0.5); text "PROFILES" { at: floor(spx + 14 * pw + 0.5), floor(ptop - 13 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(ptop + 22.5 * pu + 0.5); text "Reapply automatically" { at: floor(spx + 14 * pw + 0.5), floor(ptop + 22.5 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(ptop + 36.5 * pu + 0.5); text "When the same displays are connected · now: {disp_topo}" { at: floor(spx + 14 * pw + 0.5), floor(ptop + 36.5 * pu + 0.5); anchor: left center; size: 13.5; width: (340 * pw) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pw, ptop + 29 * pu, disp_auto_pill, disp_auto_hit.pressed, disp_auto_hit.hover, mint)
            zone box disp_auto_hit { at: spx + 424 * pw - 19 * cu, ptop + 29 * pu; size: 44 * cu, 28 * cu; cursor: pointer; active: (ptop + 29 * pu) - disp.off > sby and (ptop + 29 * pu) - disp.off < sby + set.h * pu; label: "Reapply automatically" }
            on press disp_auto_hit { emit disp_auto_toggle }
            group { scale: rs; pivot: floor(spx + 219 * pw + 0.5), floor(ptop + 70 * pu + 0.5); text "No saved profiles yet" { at: floor(spx + 219 * pw + 0.5), floor(ptop + 70 * pu + 0.5); anchor: center; size: 16.5; color: faint; opacity: 1 - clamp(disp_pn_s, 0, 1); show: disp_pcount < 1; family: "Space Grotesk" } }
            repeat i in 0..4 {
                let ry = ptop + 58 * pu + i * 30 * pu
                let rowon = clamp(disp_pn_s - i, 0, 1)
                box { at: spx + 219 * pw, ry + 13 * pu; size: 410 * pw, 26 * pu; corner: 10 * pu; color: ink; opacity: if(disp_p.$i.on, 6% + 6% * disp_p.$i.active, 0%) * rowon }
                ellipse { at: spx + 30 * pw, ry + 13 * pu; radius: 3 * pu; color: mint; opacity: if(disp_p.$i.on and disp_p.$i.active, 100%, 0%) }
                group { scale: rs; pivot: floor(spx + 42 * pw + 0.5), floor(ry + 13 * pu + 0.5); text disp_p.$i.name { at: floor(spx + 42 * pw + 0.5), floor(ry + 13 * pu + 0.5); anchor: left center; size: 17; weight: 700; width: (130 * pw) / rs; lines: 1; color: ink; show: disp_p.$i.on; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(spx + 180 * pw + 0.5), floor(ry + 13 * pu + 0.5); text disp_p.$i.sub { at: floor(spx + 180 * pw + 0.5), floor(ry + 13 * pu + 0.5); anchor: left center; size: 15; width: (150 * pw) / rs; lines: 1; color: faint; show: disp_p.$i.on; family: "Space Grotesk" } }
                box { at: spx + 355 * pw, ry + 13 * pu; size: 52 * pu, 20 * pu; corner: (10 * pu) * (1 - 0.85 * dd_k); color: mint; opacity: if(disp_p.$i.on, 16% + 14% * disp_pa_hit.$i.hover, 0%) }
                PPillOutline(spx + 355 * pw, ry + 13 * pu, 52 * pu, 20 * pu, 10 * pu, disp_pa_hit.$i.hover, clamp(3 * (if(disp_p.$i.on, 16% + 14% * disp_pa_hit.$i.hover, 0%)), 0, 1), pu)
                group { scale: rs; pivot: floor(spx + 355 * pw + 0.5), floor(ry + 13 * pu + 0.5); text "Apply" { at: floor(spx + 355 * pw + 0.5), floor(ry + 13 * pu + 0.5); anchor: center; align: center; size: 15; weight: 600; color: mint; show: disp_p.$i.on; family: "Space Grotesk" } }
                zone box disp_pa_hit.$i { at: spx + 355 * pw, ry + 13 * pu; size: 54 * pu, 22 * pu; corner: 11 * pu; cursor: pointer; active: (disp_p.$i.on and disp_trial <= 0) and (ry + 13 * pu) - disp.off > sby and (ry + 13 * pu) - disp.off < sby + set.h * pu }
                on press disp_pa_hit.$i { emit disp_profile_apply(i) }
                line { from: spx + 400.5 * pw, ry + 9.5 * pu; to: spx + 407.5 * pw, ry + 16.5 * pu; width: 1.4 * pu; color: ink; opacity: if(disp_p.$i.on, 45% + 45% * disp_pd_hit.$i.hover, 0%) }
                line { from: spx + 407.5 * pw, ry + 9.5 * pu; to: spx + 400.5 * pw, ry + 16.5 * pu; width: 1.4 * pu; color: ink; opacity: if(disp_p.$i.on, 45% + 45% * disp_pd_hit.$i.hover, 0%) }
                zone box disp_pd_hit.$i { at: spx + 404 * pw, ry + 13 * pu; size: 22 * pu, 22 * pu; corner: 11 * pu; cursor: pointer; active: (disp_p.$i.on) and (ry + 13 * pu) - disp.off > sby and (ry + 13 * pu) - disp.off < sby + set.h * pu }
                on press disp_pd_hit.$i { emit disp_profile_delete(i) }
            }
            box { from: spx + 14 * pw, ptop + (81 + disp.prows) * pu - 13 * pu; size: 410 * pw - 114 * pu, 26 * pu; corner: 13 * pu; color: ink; opacity: 8% }      // the name field: from the card's left edge to 8 short of Save
            input disp_profile_name { at: floor(spx + 14 * pw + 12 * pu + 0.5), floor(ptop + (75.5 + disp.prows) * pu + 0.5); width: 410 * pw - 138 * pu; size: 15; color: ink; family: "Space Grotesk"; placeholder: "Name for the current arrangement" }
            box { at: spx + 424 * pw - 53 * pu, ptop + (81 + disp.prows) * pu; size: 106 * pu, 26 * pu; corner: (13 * pu) * (1 - 0.85 * dd_k); color: mint; opacity: 85% + 15% * disp_save_hit.hover }
            PPillOutline(spx + 424 * pw - 53 * pu, ptop + (81 + disp.prows) * pu, 106 * pu, 26 * pu, 13 * pu, disp_save_hit.hover, clamp(3 * (85% + 15% * disp_save_hit.hover), 0, 1), pu)
            group { scale: rs; pivot: floor(spx + 424 * pw - 53 * pu + 0.5), floor(ptop + (81 + disp.prows) * pu + 0.5); text "Save current" { at: floor(spx + 424 * pw - 53 * pu + 0.5), floor(ptop + (81 + disp.prows) * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 700; color: onmint; family: "Space Grotesk" } }
            zone box disp_save_hit { at: spx + 424 * pw - 53 * pu, ptop + (81 + disp.prows) * pu; size: 108 * pu, 28 * pu; corner: 14 * pu; cursor: pointer; active: (ptop + (81 + disp.prows) * pu) - disp.off > sby and (ptop + (81 + disp.prows) * pu) - disp.off < sby + set.h * pu }
            on press disp_save_hit { emit disp_profile_save }

            //  ── Card four: the graphics card (only on a machine with more than one; logic/gpu.luau) ──
            //  Which card draws the shell. The choice restarts the shell, and bin/vitreus-keep starts it with PLEAMAR_GPU set.
            let gtop = ptop + (disp.prows + 138) * pu
            let gon = if(gpu_has, 1, 0)
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs * gon) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs * gon > 0.004; box { at: spx + 219 * pw, gtop + 31 * pu; size: 438 * pw, 62 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, gtop + 31 * pu, 438 * pw, 62 * pu, 259.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs * gon) * dd_k, pu) { show: dd_k > 0.004 and (obs * gon > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, gtop + 31 * pu; size: 438 * pw, 62 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) * gon }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, gtop + 31 * pu; size: 438 * pw, 62 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) * gon }
            box { at: spx + 219 * pw, gtop + 31 * pu; size: 438 * pw, 62 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) * gon }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(gtop - 13 * pu + 0.5); text "GRAPHICS CARD" { at: floor(spx + 14 * pw + 0.5), floor(gtop - 13 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; show: gpu_has; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(gtop + 24.5 * pu + 0.5); text "Draw the shell on the discrete card" { at: floor(spx + 14 * pw + 0.5), floor(gtop + 24.5 * pu + 0.5); anchor: left center; size: 17; weight: 700; width: (380 * pw) / rs; lines: 1; color: ink; show: gpu_has; family: "Space Grotesk" } }
            group { show: gpu_has; SettingsSwitch(spx + 424 * pw, gtop + 31 * pu, gpu_pill * gon, gpu_hit.pressed, gpu_hit.hover, mint) }
            zone box gpu_hit { at: spx + 424 * pw - 19 * cu, gtop + 31 * pu; size: 44 * cu, 28 * cu; cursor: pointer; label: "Draw the shell on the discrete graphics card"; active: gpu_has and (gtop + 31 * pu) - disp.off > sby and (gtop + 31 * pu) - disp.off < sby + set.h * pu }
            on press gpu_hit { emit gpu_toggle }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(gtop + 38.5 * pu + 0.5); text gpu_note { at: floor(spx + 14 * pw + 0.5), floor(gtop + 38.5 * pu + 0.5); anchor: left center; size: 13.5; width: (410 * pw) / rs; lines: 1; color: faint; show: gpu_has; family: "Space Grotesk" } }

            //  ── Card five: how often the shell paints (Settings > Display; it is the whole shell, every screen, and takes at once: no Apply) ──
            //  A 240 Hz screen makes the shell paint a panel 240 times a second, which costs what a 240 Hz game costs while it lasts. The animations last
            //  the same either way: fewer frames is less current, not less movement. `Screen` is no cap (the scene leaves it to the monitor).
            let ftop = gtop + 92 * gon * pu
            let ffy = ftop + 30 * pu
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, ftop + 30 * pu; size: 438 * pw, 60 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, ftop + 30 * pu, 438 * pw, 60 * pu, 364.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, ftop + 30 * pu; size: 438 * pw, 60 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, ftop + 30 * pu; size: 438 * pw, 60 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, ftop + 30 * pu; size: 438 * pw, 60 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(ftop - 13 * pu + 0.5); text "SHELL FRAME RATE" { at: floor(spx + 14 * pw + 0.5), floor(ftop - 13 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            measure ldr_dis6
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(ffy - 6.5 * pu + 0.5); text "Frames a second" { at: floor(spx + 14 * pw + 0.5), floor(ffy - 6.5 * pu + 0.5); measure: ldr_dis6; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            measure ldh_dis6
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(ffy + 7.5 * pu + 0.5); text "Fewer frames, same movement" { at: floor(spx + 14 * pw + 0.5), floor(ffy + 7.5 * pu + 0.5); measure: ldh_dis6; anchor: left center; size: 13.5; color: faint; family: "Space Grotesk" } }
            zone box bar_fps_hit_sl { at: spx + 299 * pw + (3 - 1) * 50 * pw / 2, ffy + (1 - 1) * 0 / 2; size: 3 * 50 * pw, 24 * pu + (1 - 1) * 0 }
            SetPick(spx + 299 * pw, ffy, 50 * pw, 3, 24 * pu, if(bar_fps == 120, 1, 0) + 2 * if(bar_fps == 60, 1, 0), bar_fps_hit_sl.hover, pu)
            PLeader(spx + 14 * pw + max(ldr_dis6.width, ldh_dis6.width) * rs + 8 * pu, spx + 299 * pw - 50 * pw / 2 - 6 * pu, ffy, bar_fps_hit_sl.hover, pu)
            repeat f in 0..3 {
                let bfv = pick(f, 480, 120, 60)
                let bfx = spx + (299 + f * 50) * pw
                let bflit = if(bar_fps == bfv, 1, 0)
                box { at: bfx, ffy; size: 46 * pu, 24 * pu; corner: (8 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * bar_fps_hit.$f.hover }
                group { scale: rs; pivot: floor(bfx + 0.5), floor(ffy + 0.5); text pick(f, "Screen", "120", "60") { at: floor(bfx + 0.5), floor(ffy + 0.5); anchor: center; align: center; size: 13.5; weight: 700; width: (44 * pw) / rs; lines: 1; color: mix(ink, mint, bflit); family: "Space Grotesk" } }
                zone box bar_fps_hit.$f { at: bfx, ffy; size: 46 * pu, 24 * pu; corner: 8 * pu; cursor: pointer; label: pick(f, "The monitor's own rate", "120 frames a second", "60 frames a second"); active: (ffy) - disp.off > sby and (ffy) - disp.off < sby + set.h * pu }
                on scroll bar_fps_hit.$f { disp_scroll_to = clamp(disp_scroll_to - wheel * 40, 0, max(0, disp.h - set.h)) }
                on press bar_fps_hit.$f { emit bar_pick_fps(bfv) }
            }

            //  ── The resolution dropdown, drawn last so its rows win the press over everything under it ──
            zone box disp_res_catch { at: spx + 219 * pw, dtop + 165 * pu; size: 438 * pw, 330 * pu; active: (disp_res_open) and (dtop + 165 * pu) - disp.off > sby and (dtop + 165 * pu) - disp.off < sby + set.h * pu }
            on press disp_res_catch { disp_res_open = false }
            group {
                show: disp_dd > 0.02
                opacity: disp_dd
                move: 0, (disp_dd - 1) * 6 * pu
                let rdh = (disp_res_count * 24 + 10) * pu
                let rdw = max(rtw, (disp_res_chars * 7.4 + 34) * pu)   // its longest option, and never narrower than the trigger
                body {
                    color: card
                    rim: 12%
                    shadow: 0, 6 * pu, 18 * pu, 40%, #000000
                    box { at: rx0 + rdw / 2, dtop + 104 * pu + rdh / 2; size: rdw, rdh; corner: 14 * pu }
                }
                repeat i in 0..14 {
                    let ry = dtop + 104 * pu + 5 * pu + i * 24 * pu + 12 * pu
                    box { at: rx0 + rdw / 2, ry; size: rdw - 10 * pu, 22 * pu; corner: 11 * pu; color: if(disp_r.$i.lit, mint, ink); opacity: if(disp_r.$i.on, if(disp_r.$i.lit, 24%, 0%) + 10% * disp_rr_hit.$i.hover, 0%) }
                    group { scale: rs; pivot: floor(rx0 + 16 * pu + 0.5), floor(ry + 0.5); text disp_r.$i.text { at: floor(rx0 + 16 * pu + 0.5), floor(ry + 0.5); anchor: left center; size: 17; weight: 600; width: (rdw - 24 * pu) / rs; lines: 1; color: if(disp_r.$i.lit, mint, ink); show: disp_r.$i.on; family: "Space Grotesk" } }
                    zone box disp_rr_hit.$i { at: rx0 + rdw / 2, ry; size: rdw - 8 * pu, 24 * pu; corner: 12 * pu; cursor: pointer; active: (disp_r.$i.on and disp_res_open) and (ry) - disp.off > sby and (ry) - disp.off < sby + set.h * pu }
                    on press disp_rr_hit.$i { emit disp_pick_res(i); disp_res_open = false }
                }
            }
            }

            //  The scrollbar: a thumb as tall as the viewport is of the page, shown when there is something to scroll to.
            let thh = set.h * set.h / max(set.h, disp.h)
            let thy = thh / 2 + disp.sc / max(1, disp.h - set.h) * (set.h - thh)
            box { at: spx + 442 * pw, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: if(disp.h > set.h, 6%, 0%) }
            box { at: spx + 442 * pw, sby + thy * pu; size: 3 * pu, thh * pu; corner: 1.5 * pu; color: mint; opacity: if(disp.h > set.h, 55%, 0%) }
            //  The cue that there is more below: the page fades into the panel and a small "More" pill bobs at the
            //  foot of the view. It goes away at the end of the page, and pressing it scrolls a screenful down.
            let cue = clamp((disp.h - set.h - disp.sc) / 24, 0, 1)
            let cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pw, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pw, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * cue }
            }
            box { at: spx + 224 * pw, cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * cue }
            box { at: spx + 224 * pw, cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * disp_cue_hit.hover) * cue }
            path { at: spx + 204 * pw, cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pw, cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            group { scale: rs; pivot: floor(spx + 232 * pw + 0.5), floor(cuey + 0.5); text "More" { at: floor(spx + 232 * pw + 0.5), floor(cuey + 0.5); anchor: center; size: 16.5; weight: 700; color: ink; opacity: cue; family: "Space Grotesk" } }
            zone box disp_cue_hit { at: spx + 224 * pw, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: cue > 0.5 }
            on press disp_cue_hit { disp_scroll_to = clamp(disp_scroll_to + 342, 0, max(0, disp.h - set.h)) }
            zone box disp_bar_hit { at: spx + 442 * pw, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: disp.h > set.h }
            on press disp_bar_hit { disp_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - thh / 2) / max(1, set.h - thh) * (disp.h - set.h), 0, max(0, disp.h - set.h)) }
            on drag disp_bar_hit { disp_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - thh / 2) / max(1, set.h - thh) * (disp.h - set.h), 0, max(0, disp.h - set.h)) }
        }
}
