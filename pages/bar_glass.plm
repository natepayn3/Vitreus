                path { at: ex, wdz.t; color: #ff8fc8; move -14 * u, 5; line sg * 9 * u, -19 * u; line 14 * u, 5; close }
            }
            //  Whiskers: three on each side of the drawer, fanning out of its edges at the bottom corners.
            repeat wk in 0..6 {
                let wks = if(wk < 3, -1, 1)
                let wkx = if(wk < 3, wdz.l, wdz.r)
                let wky = wdz.b - 20 * u + (mod(wk, 3) - 1) * 7 * u
                line { from: wkx - wks * 6 * u, wky; to: wkx + wks * 26 * u, wky + (mod(wk, 3) - 1) * 6 * u; width: 4; color: deep }
                line { from: wkx - wks * 6 * u, wky; to: wkx + wks * 26 * u, wky + (mod(wk, 3) - 1) * 6 * u; width: 1.8; color: #ffffff }
            }
            repeat s in 0..3 {
                let sx = wdz.m + (s - 1) * 44 * u
                let sr = if(s == 1, 7, 5) * u
                group { scale: 1 + 0.22 * sin(time * 160 + s * 120); pivot: sx, wdz.t + 9
                    path { at: sx, wdz.t + 9; stroke: 3; color: deep; move 0, -sr; line 0.3 * sr, -0.3 * sr; line sr, 0; line 0.3 * sr, 0.3 * sr; line 0, sr; line -0.3 * sr, 0.3 * sr; line -sr, 0; line -0.3 * sr, -0.3 * sr; close }
                    path { at: sx, wdz.t + 9; color: pick(s, #ffe27a, #ffffff, #7fd3ff); move 0, -sr; line 0.3 * sr, -0.3 * sr; line sr, 0; line 0.3 * sr, 0.3 * sr; line 0, sr; line -0.3 * sr, 0.3 * sr; line -sr, 0; line -0.3 * sr, -0.3 * sr; close }
                }
            }
            repeat hh in 0..2 {
                let hx = wdz.l + (22 + hh * 22) * u
                let hy = wdz.b - 11
                let hr = if(hh == 0, 5.5, 4.5) * u
                group { scale: 1 + 0.13 * sin(time * 200 + hh * 150); pivot: hx, hy
                    ellipse { at: hx - 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62 + 1.5; color: deep }
                    ellipse { at: hx + 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62 + 1.5; color: deep }
                    path { at: hx, hy; stroke: 3; color: deep; move -1.12 * hr, -0.1 * hr; line 0, 1.2 * hr; line 1.12 * hr, -0.1 * hr; close }
                    ellipse { at: hx - 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62; color: pick(hh, #ff6eb4, #b69cff) }
                    ellipse { at: hx + 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62; color: pick(hh, #ff6eb4, #b69cff) }
                    path { at: hx, hy; color: pick(hh, #ff6eb4, #b69cff); move -1.1 * hr, -0.1 * hr; line 0, 1.15 * hr; line 1.1 * hr, -0.1 * hr; close }
                    ellipse { at: hx - 0.7 * hr, hy - 0.5 * hr; radius: hr * 0.2; color: #ffffff; opacity: 80% }
                }
            }
            repeat pw in 0..3 {
                let px = wdz.r - (26 + pw * 28) * u
                let py = wdz.b - 12 + if(mod(pw, 2) == 0, 0, -3)
                ellipse { at: px, py + 2.4; radius: 6; color: deep }
                ellipse { at: px - 6.4, py - 3.2; radius: 3.4; color: deep }
                ellipse { at: px - 2.4, py - 7.6; radius: 3.4; color: deep }
                ellipse { at: px + 2.4, py - 7.6; radius: 3.4; color: deep }
                ellipse { at: px + 6.4, py - 3.2; radius: 3.4; color: deep }
                ellipse { at: px, py + 2.4; radius: 4.6; color: #ff8fc8 }
                ellipse { at: px - 6.4, py - 3.2; radius: 2.2; color: #ff8fc8 }
                ellipse { at: px - 2.4, py - 7.6; radius: 2.2; color: #ff8fc8 }
                ellipse { at: px + 2.4, py - 7.6; radius: 2.2; color: #ff8fc8 }
                ellipse { at: px + 6.4, py - 3.2; radius: 2.2; color: #ff8fc8 }
            }
            particles { at: wdz.l + 36 * u, wdz.b - 16; area: 36 * u, 6; count: 16; life: 1.4s .. 2.6s; speed: 18 .. 42; direction: -90deg; spread: 40deg; size: 3.6, 1; colors: #ff6eb4, #b69cff; shape: spark }
        }
        //  The UwU's star burst, in place of the ripples the liquid sends along the strip's edge (switched off while it is on): when a drawer has closed, five small stars fan
        //  out from where it went back into the frame, shrink and fade. One clock for each drawer (`sb.*`, restarted by its closing; vitreus.plm).
        group {
            show: uwu_k > 0.01 and sb_dc < 0.995 and fm > 0.5
            opacity: uwu_k * 80%
            repeat st in 0..5 {
                let bdca = 0 + (st - 2) * 24
                let bdcd = (10 + 58 * (1 - (1 - sb_dc) * (1 - sb_dc))) * u
                let bdcr = (2 + 3.5 * (1 - sb_dc) * (1 - sb_dc) + 1.2 * mod(st, 2)) * u * clamp((1 - sb_dc) * 3, 0, 1)
                path { at: mix(lf.w + cos(bdca) * bdcd, pcx + sin(bdca) * bdcd, tm), mix(dc.ey + sin(bdca) * bdcd, lf.w + cos(bdca) * bdcd, tm); stroke: 2.4; color: deep; opacity: clamp((1 - sb_dc) * 3, 0, 1); move 0, -bdcr; line 0.3 * bdcr, -0.3 * bdcr; line bdcr, 0; line 0.3 * bdcr, 0.3 * bdcr; line 0, bdcr; line -0.3 * bdcr, 0.3 * bdcr; line -bdcr, 0; line -0.3 * bdcr, -0.3 * bdcr; close }
                path { at: mix(lf.w + cos(bdca) * bdcd, pcx + sin(bdca) * bdcd, tm), mix(dc.ey + sin(bdca) * bdcd, lf.w + cos(bdca) * bdcd, tm); color: pick(mod(st, 5), #ffe27a, #ff6eb4, #7fd3ff, #b69cff, #ffffff); opacity: clamp((1 - sb_dc) * 3, 0, 1); move 0, -bdcr; line 0.3 * bdcr, -0.3 * bdcr; line bdcr, 0; line 0.3 * bdcr, 0.3 * bdcr; line 0, bdcr; line -0.3 * bdcr, 0.3 * bdcr; line -bdcr, 0; line -0.3 * bdcr, -0.3 * bdcr; close }
            }
        }
        group {
            show: uwu_k > 0.01 and sb_dk < 0.995 and fm > 0.5
            opacity: uwu_k * 80%
            repeat st in 0..5 {
                let bdka = 0 + (st - 2) * 24
                let bdkd = (10 + 58 * (1 - (1 - sb_dk) * (1 - sb_dk))) * u
                let bdkr = (2 + 3.5 * (1 - sb_dk) * (1 - sb_dk) + 1.2 * mod(st, 2)) * u * clamp((1 - sb_dk) * 3, 0, 1)
                path { at: mix(lf.w + cos(bdka) * bdkd, pcx + sin(bdka) * bdkd, tm), mix(dk.ey + sin(bdka) * bdkd, lf.w + cos(bdka) * bdkd, tm); stroke: 2.4; color: deep; opacity: clamp((1 - sb_dk) * 3, 0, 1); move 0, -bdkr; line 0.3 * bdkr, -0.3 * bdkr; line bdkr, 0; line 0.3 * bdkr, 0.3 * bdkr; line 0, bdkr; line -0.3 * bdkr, 0.3 * bdkr; line -bdkr, 0; line -0.3 * bdkr, -0.3 * bdkr; close }
                path { at: mix(lf.w + cos(bdka) * bdkd, pcx + sin(bdka) * bdkd, tm), mix(dk.ey + sin(bdka) * bdkd, lf.w + cos(bdka) * bdkd, tm); color: pick(mod(st, 5), #ffe27a, #ff6eb4, #7fd3ff, #b69cff, #ffffff); opacity: clamp((1 - sb_dk) * 3, 0, 1); move 0, -bdkr; line 0.3 * bdkr, -0.3 * bdkr; line bdkr, 0; line 0.3 * bdkr, 0.3 * bdkr; line 0, bdkr; line -0.3 * bdkr, 0.3 * bdkr; line -bdkr, 0; line -0.3 * bdkr, -0.3 * bdkr; close }
            }
        }
        group {
            show: uwu_k > 0.01 and sb_dm < 0.995 and fm > 0.5
            opacity: uwu_k * 80%
            repeat st in 0..5 {
                let bdma = 0 + (st - 2) * 24
                let bdmd = (10 + 58 * (1 - (1 - sb_dm) * (1 - sb_dm))) * u
                let bdmr = (2 + 3.5 * (1 - sb_dm) * (1 - sb_dm) + 1.2 * mod(st, 2)) * u * clamp((1 - sb_dm) * 3, 0, 1)
                path { at: mix(lf.w + cos(bdma) * bdmd, pcx + sin(bdma) * bdmd, tm), mix(dm.ey + sin(bdma) * bdmd, lf.w + cos(bdma) * bdmd, tm); stroke: 2.4; color: deep; opacity: clamp((1 - sb_dm) * 3, 0, 1); move 0, -bdmr; line 0.3 * bdmr, -0.3 * bdmr; line bdmr, 0; line 0.3 * bdmr, 0.3 * bdmr; line 0, bdmr; line -0.3 * bdmr, 0.3 * bdmr; line -bdmr, 0; line -0.3 * bdmr, -0.3 * bdmr; close }
                path { at: mix(lf.w + cos(bdma) * bdmd, pcx + sin(bdma) * bdmd, tm), mix(dm.ey + sin(bdma) * bdmd, lf.w + cos(bdma) * bdmd, tm); color: pick(mod(st, 5), #ffe27a, #ff6eb4, #7fd3ff, #b69cff, #ffffff); opacity: clamp((1 - sb_dm) * 3, 0, 1); move 0, -bdmr; line 0.3 * bdmr, -0.3 * bdmr; line bdmr, 0; line 0.3 * bdmr, 0.3 * bdmr; line 0, bdmr; line -0.3 * bdmr, 0.3 * bdmr; line -bdmr, 0; line -0.3 * bdmr, -0.3 * bdmr; close }
            }
        }
        group {
            show: uwu_k > 0.01 and sb_ds < 0.995 and lm > 0.5
            opacity: uwu_k * 80%
            repeat st in 0..5 {
                let bdsa = -90 + (st - 2) * 24
                let bdsd = (10 + 58 * (1 - (1 - sb_ds) * (1 - sb_ds))) * u
                let bdsr = (2 + 3.5 * (1 - sb_ds) * (1 - sb_ds) + 1.2 * mod(st, 2)) * u * clamp((1 - sb_ds) * 3, 0, 1)
                path { at: ccx + cos(bdsa) * bdsd, vb - lf.t / 2 + sin(bdsa) * bdsd; stroke: 2.4; color: deep; opacity: clamp((1 - sb_ds) * 3, 0, 1); move 0, -bdsr; line 0.3 * bdsr, -0.3 * bdsr; line bdsr, 0; line 0.3 * bdsr, 0.3 * bdsr; line 0, bdsr; line -0.3 * bdsr, 0.3 * bdsr; line -bdsr, 0; line -0.3 * bdsr, -0.3 * bdsr; close }
                path { at: ccx + cos(bdsa) * bdsd, vb - lf.t / 2 + sin(bdsa) * bdsd; color: pick(mod(st, 5), #ffe27a, #ff6eb4, #7fd3ff, #b69cff, #ffffff); opacity: clamp((1 - sb_ds) * 3, 0, 1); move 0, -bdsr; line 0.3 * bdsr, -0.3 * bdsr; line bdsr, 0; line 0.3 * bdsr, 0.3 * bdsr; line 0, bdsr; line -0.3 * bdsr, 0.3 * bdsr; line -bdsr, 0; line -0.3 * bdsr, -0.3 * bdsr; close }
            }
        }
        group {
            show: uwu_k > 0.01 and sb_dl < 0.995 and lm > 0.5
            opacity: uwu_k * 80%
            repeat st in 0..5 {
                let bdla = 90 + (st - 2) * 24
                let bdld = (10 + 58 * (1 - (1 - sb_dl) * (1 - sb_dl))) * u
                let bdlr = (2 + 3.5 * (1 - sb_dl) * (1 - sb_dl) + 1.2 * mod(st, 2)) * u * clamp((1 - sb_dl) * 3, 0, 1)
                path { at: ccx + cos(bdla) * bdld, yo + lf.t / 2 + sin(bdla) * bdld; stroke: 2.4; color: deep; opacity: clamp((1 - sb_dl) * 3, 0, 1); move 0, -bdlr; line 0.3 * bdlr, -0.3 * bdlr; line bdlr, 0; line 0.3 * bdlr, 0.3 * bdlr; line 0, bdlr; line -0.3 * bdlr, 0.3 * bdlr; line -bdlr, 0; line -0.3 * bdlr, -0.3 * bdlr; close }
                path { at: ccx + cos(bdla) * bdld, yo + lf.t / 2 + sin(bdla) * bdld; color: pick(mod(st, 5), #ffe27a, #ff6eb4, #7fd3ff, #b69cff, #ffffff); opacity: clamp((1 - sb_dl) * 3, 0, 1); move 0, -bdlr; line 0.3 * bdlr, -0.3 * bdlr; line bdlr, 0; line 0.3 * bdlr, 0.3 * bdlr; line 0, bdlr; line -0.3 * bdlr, 0.3 * bdlr; line -bdlr, 0; line -0.3 * bdlr, -0.3 * bdlr; close }
            }
        }
        group {
            show: uwu_k > 0.01 and sb_dz < 0.995 and lm > 0.5
            opacity: uwu_k * 80%
            repeat st in 0..5 {
                let bdza = 180 + (st - 2) * 24
                let bdzd = (10 + 58 * (1 - (1 - sb_dz) * (1 - sb_dz))) * u
                let bdzr = (2 + 3.5 * (1 - sb_dz) * (1 - sb_dz) + 1.2 * mod(st, 2)) * u * clamp((1 - sb_dz) * 3, 0, 1)
                path { at: screen.width - lf.t + cos(bdza) * bdzd, dz.fcy + sin(bdza) * bdzd; stroke: 2.4; color: deep; opacity: clamp((1 - sb_dz) * 3, 0, 1); move 0, -bdzr; line 0.3 * bdzr, -0.3 * bdzr; line bdzr, 0; line 0.3 * bdzr, 0.3 * bdzr; line 0, bdzr; line -0.3 * bdzr, 0.3 * bdzr; line -bdzr, 0; line -0.3 * bdzr, -0.3 * bdzr; close }
                path { at: screen.width - lf.t + cos(bdza) * bdzd, dz.fcy + sin(bdza) * bdzd; color: pick(mod(st, 5), #ffe27a, #ff6eb4, #7fd3ff, #b69cff, #ffffff); opacity: clamp((1 - sb_dz) * 3, 0, 1); move 0, -bdzr; line 0.3 * bdzr, -0.3 * bdzr; line bdzr, 0; line 0.3 * bdzr, 0.3 * bdzr; line 0, bdzr; line -0.3 * bdzr, 0.3 * bdzr; line -bdzr, 0; line -0.3 * bdzr, -0.3 * bdzr; close }
            }
        }
        group {
            show: uwu_k > 0.01 and sb_do < 0.995 and lm > 0.5
            opacity: uwu_k * 80%
            repeat st in 0..5 {
                let bdoa = 180 + (st - 2) * 24
                let bdod = (10 + 58 * (1 - (1 - sb_do) * (1 - sb_do))) * u
                let bdor = (2 + 3.5 * (1 - sb_do) * (1 - sb_do) + 1.2 * mod(st, 2)) * u * clamp((1 - sb_do) * 3, 0, 1)
                path { at: screen.width - lf.t + cos(bdoa) * bdod, do.ey + sin(bdoa) * bdod; stroke: 2.4; color: deep; opacity: clamp((1 - sb_do) * 3, 0, 1); move 0, -bdor; line 0.3 * bdor, -0.3 * bdor; line bdor, 0; line 0.3 * bdor, 0.3 * bdor; line 0, bdor; line -0.3 * bdor, 0.3 * bdor; line -bdor, 0; line -0.3 * bdor, -0.3 * bdor; close }
                path { at: screen.width - lf.t + cos(bdoa) * bdod, do.ey + sin(bdoa) * bdod; color: pick(mod(st, 5), #ffe27a, #ff6eb4, #7fd3ff, #b69cff, #ffffff); opacity: clamp((1 - sb_do) * 3, 0, 1); move 0, -bdor; line 0.3 * bdor, -0.3 * bdor; line bdor, 0; line 0.3 * bdor, 0.3 * bdor; line 0, bdor; line -0.3 * bdor, 0.3 * bdor; line -bdor, 0; line -0.3 * bdor, -0.3 * bdor; close }
            }
        }
        //  Round the screen: confetti dots along the frame's bottom and right edges, and twinkling stars on its right corners.
        group {
            show: uwu_k > 0.01 and lm > 0.35
            opacity: uwu_k * lm
            repeat cd in 0..92 {
                ellipse { at: 14 * u + cd * 27 * u, vb - lf.t / 2; radius: 2.3; color: pick(mod(cd, 4), #ff6eb4, #b69cff, #7fd3ff, #ffe27a) }
            }
            repeat cd2 in 0..40 {
                ellipse { at: screen.width - lf.t / 2, yo + 40 * u + cd2 * 27 * u; radius: 2.3; color: pick(mod(cd2, 4), #7fd3ff, #ffe27a, #ff6eb4, #b69cff) }
            }
            repeat cs in 0..2 {
                let cy2 = if(cs == 0, yo + lf.t / 2, vb - lf.t / 2)
                let cx2 = screen.width - lf.t / 2
                group { scale: 1 + 0.25 * sin(time * 170 + cs * 140); pivot: cx2, cy2
                    path { at: cx2, cy2; color: #ffe27a; move 0, -6; line 1.8, -1.8; line 6, 0; line 1.8, 1.8; line 0, 6; line -1.8, 1.8; line -6, 0; line -1.8, -1.8; close }
                }
            }
        }
        //  The three dots on each tab (the volume card's hint): always there, in the frame while the tab is in it, and in the tab as it comes out;
        //  they fade out as the panel they open comes out.
        group {
            show: lm > 0.35 or fm > 0.35
            repeat i in 0..3 {
                ellipse { at: ccx + (i - 1) * 6.5 * cu, yo + lf.t / 2 + (lf.t + nt_d) / 2 * nt_vis_t.$screen; radius: 1.6 * cu; color: ink; opacity: (35% + 55% * ntn_t.hover) * (1 - clamp(dl, 0, 1)) * if(lm > 0.35 and sb > 0.5, 1, 0) }
                ellipse { at: ccx + (i - 1) * 6.5 * cu, vb - lf.t / 2 - (lf.t + nt_d) / 2 * nt_vis_b.$screen; radius: 1.6 * cu; color: ink; opacity: (35% + 55% * ntn_b.hover) * (1 - clamp(ds, 0, 1)) * if(fm > 0.35 and sb > 0.5, 1, 0) }
            }
        }
        //  The battery gauge, inside the bar with a thick margin of empty glass round it (`bf.m`). It is only there
        //  while `batt_open.$screen` (the pointer is on the bar, or the charge is under 20 %): it fades in and grows a little
        //  from its middle line. It is a tint of the accent that brightens towards its front (a red one while it is
        //  draining below 20 %), and its own rim gives it an edge. It follows the bar's shape (which swells with the
        //  beat) and never moves by itself: an animation here would keep the scene painting, and most of all when
        //  the battery is low.
        group {
            let bf.m = 7 * bu                                        // the margin between the gauge and the bar's edge
            //  In the Notches layout the pill is the middle notch (`sg.q0`..`sg.q1`, `sg.hc` deep from the top of the screen), not the whole strip.
            let bf.pw = mix(bar.w + pv * 10 * bu, sg.q1 - sg.q0, sg)   // the pill's width
            let bf.x = mix(cx - (bar.w + pv * 10 * bu) / 2, sg.q0, sg) + bf.m
            let bf.mid = mix(bar.y - bar.h / 2 + (bar.h + pop) / 2, yo + sg.hc / 2, sg)      // the pill's middle line
            let bf.nub = 6.6 * bu                                    // how far the nub on its far end sticks out
            let bf.full = bf.pw - 2 * bf.m - bf.nub   // the gauge's length at 100 %: the nub has the same margin at its end as the gauge has at the other
            let bf.tall = mix(bar.h + pop, sg.hc, sg) - 2 * bf.m   // the pill's height
            let bf.show = clamp(batt_open.$screen, 0, 1) * (1 - lm)
            let bf.hh = bf.tall * (0.7 + 0.3 * bf.show)
            let bf.len = max(0.1, bf.full * batt_fill)
            let bf.c = mix(mint, #e0655a, batt_low)
            //  The empty part of the gauge, very faint, the same size as the gauge at a full charge. The nub on its far end, like the terminal of a
            //  battery (it says what this is), is its own shape, below.
            body {
                color: bf.c
                rim: 10%
                opacity: 10% * bf.show * batt_on * (1 - px_k)
                box { from: bf.x, bf.mid - bf.hh / 2; size: bf.full, bf.hh; corner: min(bf.hh / 2, max(0.5, bar.rad - bf.m)) }
                box { at: bf.x + bf.full + 3.1 * bu, bf.mid; size: 7 * bu, 0.56 * bf.hh; corner: 2.6 * bu }
            }
            body {
                gradient: bf.x, 0 to bf.x + max(1, bf.len), 0, mix(tint, bf.c, 0.28), bf.c
                rim: 18%
                opacity: (19% + 9% * batt_low) * bf.show * batt_on * (1 - px_k)
                box { from: bf.x, bf.mid - bf.hh / 2; size: bf.len, bf.hh; corner: min(bf.hh / 2, max(0.5, bar.rad - bf.m)) }
            }
            //  The nub on the gauge's far end, like a battery's terminal. It is in the faint track too, so that it has the same two layers the fill has (the
            //  fill alone is not as bright as the fill over the track), in the colour the fill's gradient ends on, with the fill's opacity. Its edges are exactly the track nub's, it stops where the gauge starts, and it has no edge light of its own: the track's gives the edge,
            //  and a second one would draw a line across the joint.
            body {
                color: bf.c
                opacity: (19% + 9% * batt_low) * bf.show * batt_on * (1 - px_k)
                box { at: bf.x + bf.full + 3.3 * bu, bf.mid; size: 6.6 * bu, 0.56 * bf.hh; corner: 2.6 * bu }
            }
            //  The Proxy's gauge: the HP meter of the game's HUD, drawn as it is there. A black plate; a green bar that fades to yellow-green, tall on the left (leaning, its end cut on a slant)
            //  and a thin strip running out from its top. The charge fills the green. Every corner is rounded (a polygon pulled in by
            //  R and stroked 2R wide). Only while the pointer is on the bar or the charge is low, like the glass gauge it replaces.
            group {
                let pxg.pad = 3 * bu
                let pxg.w = bf.full + bf.nub
                let pxX = bf.x + pxg.pad
                let pxW = pxg.w - 2 * pxg.pad
                let pxH = min(bf.hh - 2 * pxg.pad, 22 * bu)
                let pxY = bf.mid - pxH / 2
                let pxR = 0.18 * pxH
                let pxg.len = batt_fill * pxW
                let pxg.c = mix(mix(#ff4d4d, #f2e11c, clamp((batt_fill - 0.2) / 0.2, 0, 1)), #3cf03c, clamp((batt_fill - 0.5) / 0.25, 0, 1))      // red under 20 %, yellow about 40 to 50 %, green from 75 %
                show: px_k > 0.01 and bf.show > 0.01 and batt_on > 0.01
                opacity: px_k * bf.show * batt_on * 0.5
                box { from: bf.x, pxY - pxg.pad; size: pxg.w, pxH + 2 * pxg.pad; corner: 4 * bu; color: #05070a }
                repeat pxk in 0..24 {
                    group {
                        clip inset 0 box { from: pxX + pxk * pxW / 24, pxY - 4 * bu; size: clamp(pxg.len - pxk * pxW / 24, 0.01, pxW / 24 + 0.7), pxH + 8 * bu }
                        path { at: pxX, pxY; color: mix(mix(pxg.c, #ffffff, 0.16), pxg.c, pxk / 23); move 0.022 * pxW + 1 * pxR, 0 * pxH + 1 * pxR; line 1 * pxW - 1 * pxR, 0 * pxH + 1 * pxR; line 1 * pxW - 1 * pxR, 0.38 * pxH - 1 * pxR; line 0.381 * pxW - 1 * pxR, 0.38 * pxH - 1 * pxR; line 0.355 * pxW - 1 * pxR, 1 * pxH - 1 * pxR; line 0 * pxW + 1 * pxR, 1 * pxH - 1 * pxR; close }
                        path { at: pxX, pxY; stroke: 2 * pxR; color: mix(mix(pxg.c, #ffffff, 0.16), pxg.c, pxk / 23); move 0.022 * pxW + 1 * pxR, 0 * pxH + 1 * pxR; line 1 * pxW - 1 * pxR, 0 * pxH + 1 * pxR; line 1 * pxW - 1 * pxR, 0.38 * pxH - 1 * pxR; line 0.381 * pxW - 1 * pxR, 0.38 * pxH - 1 * pxR; line 0.355 * pxW - 1 * pxR, 1 * pxH - 1 * pxR; line 0 * pxW + 1 * pxR, 1 * pxH - 1 * pxR; line 0.022 * pxW + 1 * pxR, 0 * pxH + 1 * pxR }
                    }
                }
            }
        }

        //  Down the left the strip is the gauge: it fills from the foot up, with the same margin of empty glass round it, the same colours, and
        //  the same rule for when it shows (the pointer on the strip, or a charge under 20 %).
        group {
            let bl.m = 7 * bu
            let bl.show = clamp(batt_open.$screen, 0, 1) * lm
            let bl.w = lf.w - 2 * bl.m
            let bl.bot = vb - lf.t - bl.m
            let bl.nub = 6.6 * bu                                    // how far the nub on its top end sticks out
            let bl.full = vh - 2 * (lf.t + bl.m) - bl.nub           // the gauge's length at 100 %: the nub has the same margin at its end as the gauge has at the other
            let bl.len = max(0.1, bl.full * batt_fill)
            let bl.c = mix(mint, #e0655a, batt_low)
            //  The empty part of the strip's gauge (the nub on its top end is part of the fill's shape, below).
            body {
                color: bl.c
                rim: 10%
                opacity: 10% * bl.show * batt_on
                box { from: bl.m, bl.bot - bl.full; size: bl.w, bl.full; corner: min(bl.w / 2, max(0.5, bar.rad - bl.m)); show: lm > 0.004 }
                box { at: lf.x, bl.bot - bl.full - 3.1 * bu; size: 0.56 * bl.w, 7 * bu; corner: 2.6 * bu; show: lm > 0.004 }
            }
            body {
                gradient: lf.x, bl.bot to lf.x, bl.bot - max(1, bl.len), mix(tint, bl.c, 0.28), bl.c
                rim: 18%
                opacity: (19% + 9% * batt_low) * bl.show * batt_on
                box { from: bl.m, bl.bot - bl.len; size: bl.w, bl.len; corner: min(bl.w / 2, max(0.5, bar.rad - bl.m)); show: lm > 0.004 }
            }
            //  The nub on the strip gauge's top end (see the bar's): its own body, in the colour the fill's gradient ends on.
            body {
                color: bl.c
                opacity: (19% + 9% * batt_low) * bl.show * batt_on
                box { at: lf.x, bl.bot - bl.full - 3.3 * bu; size: 0.56 * bl.w, 6.6 * bu; corner: 2.6 * bu; show: lm > 0.004 }
            }
        }

        //  The charging glint: a soft band of the accent that crosses the bar from left to right, inside its shape. Built
        //  of thin slices whose strength follows a bell, so it has no hard edge; it is strongest in the middle of the
        //  crossing and gone (opacity 0) whenever `charge_sweep` rests at 1.
        group {
            let cg.l = mix(cx - (bar.w + pv * 10 * bu) / 2, sg.q0, sg)             // the pill's edges: the bar's, or the middle notch's in the Notches layout
            let cg.r = mix(cx + (bar.w + pv * 10 * bu) / 2, sg.q1, sg)
            let cg.y = mix(bar.y - bar.h / 2 + (bar.h + pop) / 2, yo + sg.hc / 2, sg)
            let cg.h = mix(bar.h + pop, sg.hc, sg)
            clip inset 0 box { at: (cg.l + cg.r) / 2, cg.y; size: cg.r - cg.l, cg.h; corner: bar.rad }
            let cg.w = 130 * bu                                                   // the band's width
            let cg.x = mix(cg.l - cg.w / 2, cg.r + cg.w / 2, clamp(charge_sweep, 0, 1))
            let cg.a = sin(clamp(charge_sweep, 0, 1) * 180) * batt_on * (1 - lm)           // fades in and out over the crossing
            repeat k in 0..14 {
                box { at: cg.x + (k - 6.5) * cg.w / 14, cg.y; size: cg.w / 14 + 1, cg.h; color: mint; opacity: 15% * cg.a * sin((k + 0.5) / 14 * 180) }
            }
        }

        //  The strip's zones: none on a monitor that has only the frame (`sb`, vitreus.plm).
        group {
            show: sb > 0.5
        // ── the bar ──────────────────────────────────────────────────
        //  Under everything else on the bar (declared first, so the pieces win their presses): it only says that the
        //  pointer is over the bar, in the gaps between them.
        zone box bar_hover { at: cx, bar.y; size: bar.w, bar.h; active: lm < 0.5 }
        zone box lf_hover { at: lf.x, vc; size: lf.w, vh; active: lm > 0.5 }
        repeat i in 1..11 {
            //  A zone as long as the slot and its share of the gap, so the zones touch.
            let wa = if(i == 1, ws.a1, if(i == 2, ws.a2, if(i == 3, ws.a3, if(i == 4, ws.a4, if(i == 5, ws.a5, if(i == 6, ws.a6, if(i == 7, ws.a7, if(i == 8, ws.a8, if(i == 9, ws.a9, ws.a10)))))))))
            let wsz = (if(i == 1, ws.s1, if(i == 2, ws.s2, if(i == 3, ws.s3, if(i == 4, ws.s4, if(i == 5, ws.s5, if(i == 6, ws.s6, if(i == 7, ws.s7, if(i == 8, ws.s8, if(i == 9, ws.s9, ws.s10))))))))) + ws.g) * ws.vis.$i
            zone box ws.hit.$i { at: mix(wa, lf.x, lm), mix(bar.y, wa, lm); size: mix(wsz, 40 * bu, lm), mix(bar.h, wsz, lm); cursor: pointer; active: bs.ws > 0.5 and ws.vis.$i > 0.5 }
            on press ws.hit.$i { emit go(i) }
            follow wsh.$i.$screen = ws.hit.$i.hover
            follow wsp.$i.$screen = ws.hit.$i.hover
        }
        zone box ws_plus { at: mix(ws.a11, lf.x, lm), mix(bar.y, ws.a11, lm); size: mix(ws.sv11 + ws.g, 40 * bu, lm), mix(bar.h, ws.sv11 + ws.g, lm); cursor: pointer; active: bs.ws > 0.5 and ws.pv > 0.5 }
        on press ws_plus { emit go(ws.new) }
        follow wspl.$screen = ws_plus.hover
        zone box ov_btn { at: ob.x, ob.y; size: ob.s + 8 * bu, ob.s + 8 * bu; cursor: pointer; active: bs.ws > 0.5 }
        on press ov_btn { emit ov_toggle }
        follow ovp.$screen = ov_btn.hover

        //  What is in front: the app in small type above, the title under it, cut
        //  with an ellipsis where the clock starts.
        //  The title gives up room to the controls while something plays.

        //  The whole title area is a button: it opens the controls panel. Declared before
        //  the little player controls below, which sit over it and win where they overlap.
        //  It is only as wide as the text it holds (never past `win.w`, never thinner than a
        //  fingertip), not the whole gap up to the clock. Unseen copies, with no width limit,
        //  only to know how wide the app name and the title really are.
        text win.class { at: 0, 0; anchor: left center; size: 15 * bz; weight: 600; lines: 1; measure: vclw; opacity: 0; family: "Space Grotesk" }
    text win.title { at: 0, 0; anchor: left center; size: 14 * bz; weight: 500; lines: 1; measure: vtiw; opacity: 0; family: "Space Grotesk" }
    text win.class { at: floor(win.x + 0.5), floor(bar.y - 6.5 * bu + 0.5); anchor: left center; size: 17 * bz; weight: 600; lines: 1; measure: clsw; opacity: 0; family: "Space Grotesk" }
        text win.title { at: floor(win.x + 0.5), floor(bar.y + 8.75 * bu + 0.5); anchor: left center; size: 13.5 * bz; weight: 500; lines: 1; measure: titw; opacity: 0; family: "Space Grotesk" }
        //  While a player exists its buttons (previous, play, next: 48 wide) sit in this button's top right, beside the app name.
        //  With a name in front (`win.have` 1) the button is as wide as the name, with the player's buttons in its top right. With no window
        //  the texts are empty, and the button would be a narrow strip at the left: it then takes most of the gap and is centred in it, with the
        //  player's buttons in the middle.
        let win.have = clamp(max(clsw.width, titw.width) / (6 * bu), 0, 1)
        let win.zc = mix(win.cm, win.xs - 6 * bu + win.hw / 2, win.have)
        let win.zw = mix(max(48 * bu, win.w - 12 * bu), win.hw, win.have)
        let mcx = mix(win.cm, win.xs - 6 * bu + win.hw - 27.5 * bu, win.have)
        let mcy = mix(bar.y, bar.y - 6.5 * bu, win.have)
        zone box win_hit { at: win.zc, bar.y; size: win.zw, bar.h; cursor: pointer; active: bs.title > 0.5 }
        on press win_hit { pending = none; panel_scr = screen.index; panel = if(panel == player, none, player) }
        follow ptab_hold.$screen = if((pl_btn_z.hover > 0.5 or (win_hit.hover > 0.5 and lm < 0.5)) and panel != player, 1, 0)       // the title's tab (see `ptab_*`): the frame's zone or this one

        // ── the player, small, in the bar ────────────────────────────
        //  While there is a player, playing or paused; they fade in as the title gives them room.
        group {
            opacity: mshow * bs.media
            //  In the title button's top right (`mcx`, `mcy`), and small: 17 between centres.
            zone box bp.prev { at: mcx - 17 * bu, mcy; size: 17 * bu, 18 * bu; cursor: pointer }
            zone box bp.play { at: mcx, mcy; size: 17 * bu, 18 * bu; cursor: pointer }
            zone box bp.next { at: mcx + 17 * bu, mcy; size: 17 * bu, 18 * bu; cursor: pointer }
            on press bp.prev { emit mcmd(0) }
            on press bp.play { emit mcmd(1) }
            on press bp.next { emit mcmd(2) }
        }

        zone box vt_hit { at: lf.x, lv.tm; size: lf.w - 6 * bu, max(1, lv.span); cursor: pointer; active: lm > 0.5 and bv.title and lv.span > 20 * bu }
        on press vt_hit { pending = none; panel_scr = screen.index; panel = if(panel == player, none, player) }
        zone box vm_prev { at: lf.x, lv.mid + 17 * bcu; size: 30 * bcu, 17 * bcu; cursor: pointer; active: lm > 0.5 and bv.media and mshow > 0.5 }
        zone box vm_play { at: lf.x, lv.mid; size: 30 * bcu, 17 * bcu; cursor: pointer; active: lm > 0.5 and bv.media and mshow > 0.5 }
        zone box vm_next { at: lf.x, lv.mid - 17 * bcu; size: 30 * bcu, 17 * bcu; cursor: pointer; active: lm > 0.5 and bv.media and mshow > 0.5 }
        on press vm_prev { emit mcmd(0) }
        on press vm_play { emit mcmd(1) }
        on press vm_next { emit mcmd(2) }
        zone box set_hit { at: mix(set.x, lf.x, lm), mix(bar.y, lv.set, lm); size: mix(24 * bu, 36 * bu, lm), mix(bar.h, 30 * bu, lm); cursor: pointer }
        on press set_hit { panel_scr = screen.index; panel = if(panel == settings, none, settings) }

        zone box sr_hit { at: mix(sr.x, lf.x, lm), mix(bar.y, lv.sr, lm); size: mix(24 * bu, 36 * bu, lm), mix(bar.h, 30 * bu, lm); cursor: pointer; active: bs.sr > 0.5 }
        on press sr_hit { panel_scr = screen.index; panel = if(panel == launch, none, launch) }
        zone box ctl_hit { at: mix(ctl.x, lf.x, lm), mix(bar.y, lv.ctl, lm); size: mix(26 * bu, 36 * bu, lm), mix(bar.h, 30 * bu, lm); cursor: pointer; active: bs.ctl > 0.5 }
        on press ctl_hit { pending = none; panel_scr = screen.index; panel = if(panel == controls, none, controls) }

        //  The calendar's button is the clock and a little around it: 4 more at each side.
        zone box bar_hit { at: mix(at.clock, lf.x, lm), mix(bar.y, lv.clk + 30 * bu, lm); size: mix(fw.clock + 8 * bu, lf.w - 4 * bu, lm), mix(bar.h, 100 * bu, lm); cursor: pointer; active: bs.clock > 0.5 }
        on press bar_hit { pending = none; panel_scr = screen.index; panel = if(panel == calendar, none, calendar) }
        //  Right-click closes whatever is open. It also matters for a reason that
        //  has nothing to do with the calendar: pleamar treats an unclaimed right
        //  click, anywhere in a scene that never uses the right button at all, as
        //  an emergency exit and quits outright - which is exactly what looked
        //  like "everything crashes." Claiming it here, once, disarms that for
        //  the whole scene.
        on press right bar_hit { panel = none }
        }
        //  How open the battery gauge is (see `batt_open.$screen`): it lives here, where the bar's zones are, to read their hover.
        follow batt_open.$screen = if(max(max(max(max(max(max(max(max(max(max(max(max(max(max(max(max(max(max(max(bar_hover.hover, wsh.1.$screen), wsh.2.$screen), wsh.3.$screen), wsh.4.$screen), wsh.5.$screen), wsh.6.$screen), wsh.7.$screen), wsh.8.$screen), wsh.9.$screen), wsh.10.$screen), win_hit.hover), bp.prev.hover), bp.play.hover), bp.next.hover), set_hit.hover), sr_hit.hover), ctl_hit.hover), bar_hit.hover), lf_hover.hover) > 0.15 or (pwr.percent < 20 and pwr.present), 1, 0)
    }
}
