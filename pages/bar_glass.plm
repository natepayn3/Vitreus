part BarGlass {
    //  The whole bar, glass and all, is one group so the wave can bend it as one thing.
    group {
        //  Only while it does something: the Retro's pixelation, or a wave that can bend (not on the left, not with the panel half down, and while a beat or a ring is moving).
        //  The rest of the time the group goes without its shader and its full-surface pass (pleamar 0.3.12 and later).
        shader: wave, pv, mix(clamp(ring, 0, 1), 1, lm), mix((mc - (cx - bar.w / 2)) / bar.w, 0.5, clamp(ring_mid, 0, 1)), lf.w, 2.6 * u * (1 - min(1, drop * 2)) * (1 - lm) * (1 - sg), bar.w, pxa, lf.t while pxa > 1.5 or (lm < 0.999 and sg < 0.5 and drop < 0.5 and (pv > 0.001 or ring < 0.999))
        //  With the Retro on, a barely visible box over the whole surface makes the group's box the surface, so the pixelation (wave.wgsl) knows where the opening is.
        box { from: 0, 0; size: screen.width, screen.height; color: deep; opacity: 1.2% * cas_k }
        // ── the liquid ───────────────────────────────────────────────
        body {
            color: mix(tint, #000000, cy_dark * cy_k)
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend
            frost: glass_clear
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            rim: 10% * glass_rim + 14% * pv * glass_rim
            shine: pointer
            shadow: 0, 1 + 6 * drop + 3 * pv, 6 + 14 * drop + 8 * pv, 8% + 16% * drop + 8% * pv, deep
            show: (obs < 0.996 and not glass_auto) and fw_act < 0.5
            include "bar_shapes.plm"
        }
        body {
            color: mix(tint, #000000, cy_dark * cy_k)
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend
            frost: glass_clear
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            rim: 10% * glass_rim + 14% * pv * glass_rim
            shine: pointer
            shadow: 0, 1 + 6 * drop + 3 * pv, 6 + 14 * drop + 8 * pv, 8% + 16% * drop + 8% * pv, deep
            show: (obs < 0.996 and not glass_auto) and fw_act > 0.5 and fw_act < 1.5
            include "bar_shapes.plm"
            include "bar_waves_12.plm"
        }
        body {
            color: mix(tint, #000000, cy_dark * cy_k)
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend
            frost: glass_clear
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            rim: 10% * glass_rim + 14% * pv * glass_rim
            shine: pointer
            shadow: 0, 1 + 6 * drop + 3 * pv, 6 + 14 * drop + 8 * pv, 8% + 16% * drop + 8% * pv, deep
            show: (obs < 0.996 and not glass_auto) and fw_act > 1.5 and fw_act < 2.5
            include "bar_shapes.plm"
            include "bar_waves_24.plm"
        }
        body {
            color: mix(tint, #000000, cy_dark * cy_k)
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend
            frost: glass_clear
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            rim: 10% * glass_rim + 14% * pv * glass_rim
            shine: pointer
            shadow: 0, 1 + 6 * drop + 3 * pv, 6 + 14 * drop + 8 * pv, 8% + 16% * drop + 8% * pv, deep
            show: (obs < 0.996 and not glass_auto) and fw_act > 2.5 and fw_act < 3.5
            include "bar_shapes.plm"
            include "bar_waves.plm"
        }
        //  The same glass with `frost: auto` (frosted only where what is behind is busy): `frost:` cannot take `auto` from an expression, so it is a body of its own.
        body {
            color: mix(tint, #000000, cy_dark * cy_k)
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend
            frost: auto
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            rim: 10% * glass_rim + 14% * pv * glass_rim
            shine: pointer
            shadow: 0, 1 + 6 * drop + 3 * pv, 6 + 14 * drop + 8 * pv, 8% + 16% * drop + 8% * pv, deep
            show: (obs < 0.996 and glass_auto) and fw_act < 0.5
            include "bar_shapes.plm"
        }
        body {
            color: mix(tint, #000000, cy_dark * cy_k)
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend
            frost: auto
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            rim: 10% * glass_rim + 14% * pv * glass_rim
            shine: pointer
            shadow: 0, 1 + 6 * drop + 3 * pv, 6 + 14 * drop + 8 * pv, 8% + 16% * drop + 8% * pv, deep
            show: (obs < 0.996 and glass_auto) and fw_act > 0.5 and fw_act < 1.5
            include "bar_shapes.plm"
            include "bar_waves_12.plm"
        }
        body {
            color: mix(tint, #000000, cy_dark * cy_k)
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend
            frost: auto
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            rim: 10% * glass_rim + 14% * pv * glass_rim
            shine: pointer
            shadow: 0, 1 + 6 * drop + 3 * pv, 6 + 14 * drop + 8 * pv, 8% + 16% * drop + 8% * pv, deep
            show: (obs < 0.996 and glass_auto) and fw_act > 1.5 and fw_act < 2.5
            include "bar_shapes.plm"
            include "bar_waves_24.plm"
        }
        body {
            color: mix(tint, #000000, cy_dark * cy_k)
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend
            frost: auto
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            rim: 10% * glass_rim + 14% * pv * glass_rim
            shine: pointer
            shadow: 0, 1 + 6 * drop + 3 * pv, 6 + 14 * drop + 8 * pv, 8% + 16% * drop + 8% * pv, deep
            show: (obs < 0.996 and glass_auto) and fw_act > 2.5 and fw_act < 3.5
            include "bar_shapes.plm"
            include "bar_waves.plm"
        }
        //  The same shapes again, as flat obsidian: a body with no rim (`rim: 0%`). (Before pleamar 0.4.14 a `rim` that was an expression
        //  was read as its first number, so `rim: 40% * cas_k` kept 40% of light on the edge with the Cassette off; now it is worked out.)
        //  Blur behind the obsidian: a glass body asks the compositor for it (100 % glass at 34 %: the request needs glass x opacity of 30 % or more, and a more opaque layer would hide the blur), and the obsidian over it (60 % opaque while blur is on, solid when it is off) hides the glass's look.
        body {
            color: obsidian
            glass: 100%
            lens: false
            rim: 0%
            refraction: 0%
            dispersion: 0%
            shine: 9000, 9000
            opacity: obs * 0.34 * (1 - pk)
            show: (obs > 0.97) and fw_act < 0.5
            include "bar_shapes.plm"
        }
        body {
            color: obsidian
            glass: 100%
            lens: false
            rim: 0%
            refraction: 0%
            dispersion: 0%
            shine: 9000, 9000
            opacity: obs * 0.34 * (1 - pk)
            show: (obs > 0.97) and fw_act > 0.5 and fw_act < 1.5
            include "bar_shapes.plm"
            include "bar_waves_12.plm"
        }
        body {
            color: obsidian
            glass: 100%
            lens: false
            rim: 0%
            refraction: 0%
            dispersion: 0%
            shine: 9000, 9000
            opacity: obs * 0.34 * (1 - pk)
            show: (obs > 0.97) and fw_act > 1.5 and fw_act < 2.5
            include "bar_shapes.plm"
            include "bar_waves_24.plm"
        }
        body {
            color: obsidian
            glass: 100%
            lens: false
            rim: 0%
            refraction: 0%
            dispersion: 0%
            shine: 9000, 9000
            opacity: obs * 0.34 * (1 - pk)
            show: (obs > 0.97) and fw_act > 2.5 and fw_act < 3.5
            include "bar_shapes.plm"
            include "bar_waves.plm"
        }
        body {
            color: obsidian
            rim: 0%
            opacity: obs * (1 - 0.4 * clamp(hy_blur, 0, 1))
            shadow: 0, 3 + 6 * drop + 3 * pv, 14 + 14 * drop + 8 * pv, (30% + 16% * drop + 8% * pv) * (1 - pk), #000000
            show: (obs > 0.004) and fw_act < 0.5
            include "bar_shapes.plm"
        }
        body {
            color: obsidian
            rim: 0%
            opacity: obs * (1 - 0.4 * clamp(hy_blur, 0, 1))
            shadow: 0, 3 + 6 * drop + 3 * pv, 14 + 14 * drop + 8 * pv, (30% + 16% * drop + 8% * pv) * (1 - pk), #000000
            show: (obs > 0.004) and fw_act > 0.5 and fw_act < 1.5
            include "bar_shapes.plm"
            include "bar_waves_12.plm"
        }
        body {
            color: obsidian
            rim: 0%
            opacity: obs * (1 - 0.4 * clamp(hy_blur, 0, 1))
            shadow: 0, 3 + 6 * drop + 3 * pv, 14 + 14 * drop + 8 * pv, (30% + 16% * drop + 8% * pv) * (1 - pk), #000000
            show: (obs > 0.004) and fw_act > 1.5 and fw_act < 2.5
            include "bar_shapes.plm"
            include "bar_waves_24.plm"
        }
        body {
            color: obsidian
            rim: 0%
            opacity: obs * (1 - 0.4 * clamp(hy_blur, 0, 1))
            shadow: 0, 3 + 6 * drop + 3 * pv, 14 + 14 * drop + 8 * pv, (30% + 16% * drop + 8% * pv) * (1 - pk), #000000
            show: (obs > 0.004) and fw_act > 2.5 and fw_act < 3.5
            include "bar_shapes.plm"
            include "bar_waves.plm"
        }
        //  The Cassette's plastic over it (see `cas_k`): a lit lip, a dark outline, a hard shadow.
        body {
            color: obsidian
            rim: 40% * cas_k
            border: 1.7 * u * cas_k, deep
            shadow: 4.5 * u * cas_k, 5.5 * u * cas_k, 0, 55% * cas_k, deep
            opacity: cas_k
            show: (cas_k > 0.004) and fw_act < 0.5
            include "bar_shapes.plm"
        }
        body {
            color: obsidian
            rim: 40% * cas_k
            border: 1.7 * u * cas_k, deep
            shadow: 4.5 * u * cas_k, 5.5 * u * cas_k, 0, 55% * cas_k, deep
            opacity: cas_k
            show: (cas_k > 0.004) and fw_act > 0.5 and fw_act < 1.5
            include "bar_shapes.plm"
            include "bar_waves_12.plm"
        }
        body {
            color: obsidian
            rim: 40% * cas_k
            border: 1.7 * u * cas_k, deep
            shadow: 4.5 * u * cas_k, 5.5 * u * cas_k, 0, 55% * cas_k, deep
            opacity: cas_k
            show: (cas_k > 0.004) and fw_act > 1.5 and fw_act < 2.5
            include "bar_shapes.plm"
            include "bar_waves_24.plm"
        }
        body {
            color: obsidian
            rim: 40% * cas_k
            border: 1.7 * u * cas_k, deep
            shadow: 4.5 * u * cas_k, 5.5 * u * cas_k, 0, 55% * cas_k, deep
            opacity: cas_k
            show: (cas_k > 0.004) and fw_act > 2.5 and fw_act < 3.5
            include "bar_shapes.plm"
            include "bar_waves.plm"
        }
        //  The UwU's candy plastic over it: a pastel gradient across the whole screen (pink, lilac, sky, mint), a thick grape outline, a lit lip and a hard pink shadow.
        body {
            gradient: 0, 0 to screen.width, screen.height, #ffcfe8, #e6d6ff 38%, #cfeaff 68%, #d2fff0
            rim: 55% * uwu_k
            border: 3 * u * uwu_k, deep
            shadow: 4 * u * uwu_k, 5 * u * uwu_k, 0, 90% * uwu_k, mix(deep, #ff6ec7, 0.75)
            opacity: uwu_k
            show: (uwu_k > 0.004) and fw_act < 0.5
            include "bar_shapes.plm"
        }
        body {
            gradient: 0, 0 to screen.width, screen.height, #ffcfe8, #e6d6ff 38%, #cfeaff 68%, #d2fff0
            rim: 55% * uwu_k
            border: 3 * u * uwu_k, deep
            shadow: 4 * u * uwu_k, 5 * u * uwu_k, 0, 90% * uwu_k, mix(deep, #ff6ec7, 0.75)
            opacity: uwu_k
            show: (uwu_k > 0.004) and fw_act > 0.5 and fw_act < 1.5
            include "bar_shapes.plm"
            include "bar_waves_12.plm"
        }
        body {
            gradient: 0, 0 to screen.width, screen.height, #ffcfe8, #e6d6ff 38%, #cfeaff 68%, #d2fff0
            rim: 55% * uwu_k
            border: 3 * u * uwu_k, deep
            shadow: 4 * u * uwu_k, 5 * u * uwu_k, 0, 90% * uwu_k, mix(deep, #ff6ec7, 0.75)
            opacity: uwu_k
            show: (uwu_k > 0.004) and fw_act > 1.5 and fw_act < 2.5
            include "bar_shapes.plm"
            include "bar_waves_24.plm"
        }
        body {
            gradient: 0, 0 to screen.width, screen.height, #ffcfe8, #e6d6ff 38%, #cfeaff 68%, #d2fff0
            rim: 55% * uwu_k
            border: 3 * u * uwu_k, deep
            shadow: 4 * u * uwu_k, 5 * u * uwu_k, 0, 90% * uwu_k, mix(deep, #ff6ec7, 0.75)
            opacity: uwu_k
            show: (uwu_k > 0.004) and fw_act > 2.5 and fw_act < 3.5
            include "bar_shapes.plm"
            include "bar_waves.plm"
        }
        //  The Milk's body: two layers of the same pale material, one casting a white light up and to the left, the other a soft dark shade down and to the right.
        body {
            color: obsidian
            rim: 0%
            shadow: -3 * u * milk_k, -3 * u * milk_k, 8 * u * milk_k, 38% * milk_k, #ffffff
            opacity: milk_k
            show: (milk_k > 0.004) and fw_act < 0.5
            include "bar_shapes.plm"
        }
        body {
            color: obsidian
            rim: 0%
            shadow: 3 * u * milk_k, 4 * u * milk_k, 10 * u * milk_k, 28% * milk_k, deep
            opacity: milk_k
            show: (milk_k > 0.004) and fw_act < 0.5
            include "bar_shapes.plm"
        }
        body {
            color: obsidian
            rim: 0%
            shadow: -3 * u * milk_k, -3 * u * milk_k, 8 * u * milk_k, 38% * milk_k, #ffffff
            opacity: milk_k
            show: (milk_k > 0.004) and fw_act > 0.5 and fw_act < 1.5
            include "bar_shapes.plm"
            include "bar_waves_12.plm"
        }
        body {
            color: obsidian
            rim: 0%
            shadow: 3 * u * milk_k, 4 * u * milk_k, 10 * u * milk_k, 28% * milk_k, deep
            opacity: milk_k
            show: (milk_k > 0.004) and fw_act > 0.5 and fw_act < 1.5
            include "bar_shapes.plm"
            include "bar_waves_12.plm"
        }
        body {
            color: obsidian
            rim: 0%
            shadow: -3 * u * milk_k, -3 * u * milk_k, 8 * u * milk_k, 38% * milk_k, #ffffff
            opacity: milk_k
            show: (milk_k > 0.004) and fw_act > 1.5 and fw_act < 2.5
            include "bar_shapes.plm"
            include "bar_waves_24.plm"
        }
        body {
            color: obsidian
            rim: 0%
            shadow: 3 * u * milk_k, 4 * u * milk_k, 10 * u * milk_k, 28% * milk_k, deep
            opacity: milk_k
            show: (milk_k > 0.004) and fw_act > 1.5 and fw_act < 2.5
            include "bar_shapes.plm"
            include "bar_waves_24.plm"
        }
        body {
            color: obsidian
            rim: 0%
            shadow: -3 * u * milk_k, -3 * u * milk_k, 8 * u * milk_k, 38% * milk_k, #ffffff
            opacity: milk_k
            show: (milk_k > 0.004) and fw_act > 2.5 and fw_act < 3.5
            include "bar_shapes.plm"
            include "bar_waves.plm"
        }
        body {
            color: obsidian
            rim: 0%
            shadow: 3 * u * milk_k, 4 * u * milk_k, 10 * u * milk_k, 28% * milk_k, deep
            opacity: milk_k
            show: (milk_k > 0.004) and fw_act > 2.5 and fw_act < 3.5
            include "bar_shapes.plm"
            include "bar_waves.plm"
        }
        //  The Proxy's body: flat near-black plates with a thin pale outline and a hard offset edge in the second accent, like the HUD's own panels. Solid, so the glass is off (`obs`), as with the plastics.
        body {
            color: obsidian
            rim: 0%
            border: 1.4 * u * px_k, mix(#e8f1f5, obsidian, 0.4)
            shadow: 2.5 * u * px_k, 3 * u * px_k, 0, 85% * px_k, deep
            opacity: px_k
            show: (px_k > 0.004) and fw_act < 0.5
            include "bar_shapes.plm"
        }
        body {
            color: obsidian
            rim: 0%
            border: 1.4 * u * px_k, mix(#e8f1f5, obsidian, 0.4)
            shadow: 2.5 * u * px_k, 3 * u * px_k, 0, 85% * px_k, deep
            opacity: px_k
            show: (px_k > 0.004) and fw_act > 0.5 and fw_act < 1.5
            include "bar_shapes.plm"
            include "bar_waves_12.plm"
        }
        body {
            color: obsidian
            rim: 0%
            border: 1.4 * u * px_k, mix(#e8f1f5, obsidian, 0.4)
            shadow: 2.5 * u * px_k, 3 * u * px_k, 0, 85% * px_k, deep
            opacity: px_k
            show: (px_k > 0.004) and fw_act > 1.5 and fw_act < 2.5
            include "bar_shapes.plm"
            include "bar_waves_24.plm"
        }
        body {
            color: obsidian
            rim: 0%
            border: 1.4 * u * px_k, mix(#e8f1f5, obsidian, 0.4)
            shadow: 2.5 * u * px_k, 3 * u * px_k, 0, 85% * px_k, deep
            opacity: px_k
            show: (px_k > 0.004) and fw_act > 2.5 and fw_act < 3.5
            include "bar_shapes.plm"
            include "bar_waves.plm"
        }
        //  The Paper's body: a sheet of cream paper with a worn, brownish edge and a soft shadow underneath, as if laid on the desk. Solid, so the glass is off (`obs`), as with the plastics.
        body {
            color: obsidian
            rim: 0%
            border: 1.2 * u * pp_k, mix(deep, obsidian, 0.55)
            shadow: 1.5 * u * pp_k, 3.5 * u * pp_k, 9 * u * pp_k, 42% * pp_k, deep
            opacity: pp_k
            show: (pp_k > 0.004) and fw_act < 0.5
            include "bar_shapes.plm"
        }
        body {
            color: obsidian
            rim: 0%
            border: 1.2 * u * pp_k, mix(deep, obsidian, 0.55)
            shadow: 1.5 * u * pp_k, 3.5 * u * pp_k, 9 * u * pp_k, 42% * pp_k, deep
            opacity: pp_k
            show: (pp_k > 0.004) and fw_act > 0.5 and fw_act < 1.5
            include "bar_shapes.plm"
            include "bar_waves_12.plm"
        }
        body {
            color: obsidian
            rim: 0%
            border: 1.2 * u * pp_k, mix(deep, obsidian, 0.55)
            shadow: 1.5 * u * pp_k, 3.5 * u * pp_k, 9 * u * pp_k, 42% * pp_k, deep
            opacity: pp_k
            show: (pp_k > 0.004) and fw_act > 1.5 and fw_act < 2.5
            include "bar_shapes.plm"
            include "bar_waves_24.plm"
        }
        body {
            color: obsidian
            rim: 0%
            border: 1.2 * u * pp_k, mix(deep, obsidian, 0.55)
            shadow: 1.5 * u * pp_k, 3.5 * u * pp_k, 9 * u * pp_k, 42% * pp_k, deep
            opacity: pp_k
            show: (pp_k > 0.004) and fw_act > 2.5 and fw_act < 3.5
            include "bar_shapes.plm"
            include "bar_waves.plm"
        }
        //  The Doodle's body: a cream sticker with a thick charcoal outline (`ink`) and nothing else, no shadow, no rim. Solid, so the glass is off (`obs`).
        body {
            color: obsidian
            rim: 0%
            border: 4.5 * u * dd_k, ink
            opacity: dd_k
            show: (dd_k > 0.004) and fw_act < 0.5
            include "bar_shapes.plm"
        }
        body {
            color: obsidian
            rim: 0%
            border: 4.5 * u * dd_k, ink
            opacity: dd_k
            show: (dd_k > 0.004) and fw_act > 0.5 and fw_act < 1.5
            include "bar_shapes.plm"
            include "bar_waves_12.plm"
        }
        body {
            color: obsidian
            rim: 0%
            border: 4.5 * u * dd_k, ink
            opacity: dd_k
            show: (dd_k > 0.004) and fw_act > 1.5 and fw_act < 2.5
            include "bar_shapes.plm"
            include "bar_waves_24.plm"
        }
        body {
            color: obsidian
            rim: 0%
            border: 4.5 * u * dd_k, ink
            opacity: dd_k
            show: (dd_k > 0.004) and fw_act > 2.5 and fw_act < 3.5
            include "bar_shapes.plm"
            include "bar_waves.plm"
        }
        //  The Paper's torn edge, worn rim and grain on every drawer, from the first moment it opens: its box follows the drawer's own size and wobble (the same sums as its body in bar_shapes.plm), and its noise is tied to the panel's sides, so the edge opens, closes and jiggles with the panel.
        group {
            show: pp_k > 0.01 and dk0 > 0.004
            opacity: pp_k
            let pedkw = dk.ew * (1 + dj.stretch - 0.07 * dk.bell + 0.003 * wobble * (1 - sg)) * dk.tail
            let pedkh = (dk.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble * (1 - sg)) + sg.up) * dk.tail
            let pedkl = dk.ex - pedkw / 2
            let pedkt = dk.ey - sg.up / 2 - pedkh / 2
            shader paper { at: pedkl - 8, pedkt - 8; size: pedkw + 16, pedkh + 16; values: 1, 1, 8, mix(min(dk.ew, dk.eh) / 2, rc, clamp(dk0 * 1.6 - 0.1, 0, 1)); colors: obsidian, deep }
        }
        group {
            show: pp_k > 0.01 and dc0 > 0.004
            opacity: pp_k
            let pedcw = dc.ew * (1 + dj.stretch - 0.07 * dc.bell + 0.003 * wobble)
            let pedch = dc.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble) + sg.up
            let pedcl = dc.ex - pedcw / 2
            let pedct = dc.ey - sg.up / 2 - pedch / 2
            shader paper { at: pedcl - 8, pedct - 8; size: pedcw + 16, pedch + 16; values: 1, 4.7, 8, mix(min(dc.ew, dc.eh) / 2, rc, clamp(dc0 * 1.6 - 0.1, 0, 1)); colors: obsidian, deep }
        }
        group {
            show: pp_k > 0.01 and ds0 > 0.004
            opacity: pp_k
            let pedsw = ds.ew * (1 + dj.stretch - 0.07 * ds.bell + 0.003 * wobble)
            let pedsh = ds.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble)
            let pedsl = ds.ex - pedsw / 2
            let pedst = ds.ey - pedsh / 2
            shader paper { at: pedsl - 8, pedst - 8; size: pedsw + 16, pedsh + 16; values: 1, 8.4, 8, mix(min(ds.ew, ds.eh) / 2, rc, clamp(ds0 * 1.6 - 0.1, 0, 1)); colors: obsidian, deep }
        }
        group {
            show: pp_k > 0.01 and dl0 > 0.004
            opacity: pp_k
            let pedlw = dl.ew * (1 + dj.stretch - 0.07 * dl.bell + 0.003 * wobble)
            let pedlh = dl.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble)
            let pedll = dl.ex - pedlw / 2
            let pedlt = dl.ey - pedlh / 2
            shader paper { at: pedll - 8, pedlt - 8; size: pedlw + 16, pedlh + 16; values: 1, 12.1, 8, mix(min(dl.ew, dl.eh) / 2, rc, clamp(dl0 * 1.6 - 0.1, 0, 1)); colors: obsidian, deep }
        }
        group {
            show: pp_k > 0.01 and dm0 > 0.004
            opacity: pp_k
            let pedmw = dm.ew * (1 + dj.stretch - 0.07 * dm.bell + 0.003 * wobble)
            let pedmh = dm.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble) + sg.up
            let pedml = dm.ex - pedmw / 2
            let pedmt = dm.ey - sg.up / 2 - pedmh / 2
            shader paper { at: pedml - 8, pedmt - 8; size: pedmw + 16, pedmh + 16; values: 1, 15.8, 8, mix(min(dm.ew, dm.eh) / 2, rc, clamp(dm0 * 1.6 - 0.1, 0, 1)); colors: obsidian, deep }
        }
        group {
            show: pp_k > 0.01 and dz0 > 0.004
            opacity: pp_k
            let pedzw = dz.fw * (1 + dz.stretch - 0.07 * dz.bell)
            let pedzh = dz.fh * (1 - dz.stretch * 0.5)
            let pedzl = dz.fx - pedzw / 2
            let pedzt = dz.fcy - pedzh / 2
            shader paper { at: pedzl - 8, pedzt - 8; size: pedzw + 16, pedzh + 16; values: 1, 19.5, 8, mix(min(dz.fw, dz.fh) / 2, 26 * u * desk_s * (1 - 0.73 * sq), clamp(dz0 * 1.6 - 0.1, 0, 1)); colors: obsidian, deep }
        }
        //  The Paper's torn edge on the shell's notches and on the two docks (the app dock and the add-on dock), so they are worn like the drawers. The side that is buried in the frame
        //  is kept clean (the 100s in the seed are a mask of the sides, see paper.wgsl), so the tear only runs on the part that shows.
        //  The top frame in three pieces (see `sg.*`): the same torn edge on each piece. Its top (and the end that runs off the screen) is buried in the thin frame, so those sides are kept clean.
        group {
            show: pp_k > 0.01 and sg > 0.35
            opacity: pp_k * clamp(sg * 3 - 1, 0, 1)
            shader paper { at: -14 - 8, yo - 14 - 8; size: sg.lr + 14 + 16, sg.hc + 14 + 16; values: 1, 503.1, 8, (sg.hc + sg.r) * 0.34 * (1 - 0.73 * sq); colors: obsidian, deep }
            shader paper { at: sg.q0 - 8, yo - 14 - 8; size: sg.q1 - sg.q0 + 16, sg.hc + 14 + 16; values: 1, 410.6, 8, (sg.hc + sg.r) * 0.34 * (1 - 0.73 * sq); colors: obsidian, deep }
            shader paper { at: sg.rq - 8, yo - 14 - 8; size: screen.width + 14 - sg.rq + 16, sg.hc + 14 + 16; values: 1, 607.9, 8, (sg.hc + sg.r) * 0.34 * (1 - 0.73 * sq); colors: obsidian, deep }
        }
        group {
            show: pp_k > 0.01 and tm > 0.35 and nt_vis_l.$screen > 0.02
            opacity: pp_k * clamp(nt_vis_l.$screen * 3, 0, 1)
            shader paper { at: th.l - 22 - 8, vcc - nt_w / 2 - 8; size: 22 + nt_d * nt_vis_l.$screen + 16, nt_w + 16; values: 1, 101.5, 8, 9 * cu * (1 - 0.73 * sq); colors: obsidian, deep }
        }
        group {
            show: pp_k > 0.01 and lm > 0.35 and sb > 0.5 and nt_vis_t.$screen > 0.02
            opacity: pp_k * clamp(nt_vis_t.$screen * 3, 0, 1)
            shader paper { at: ccx - nt_w / 2 - 8, yo + lf.t - 22 - 8; size: nt_w + 16, 22 + nt_d * nt_vis_t.$screen + 16; values: 1, 405.9, 8, 9 * cu * (1 - 0.73 * sq); colors: obsidian, deep }
        }
        group {
            show: pp_k > 0.01 and fm > 0.35 and sb > 0.5 and nt_vis_b.$screen > 0.02
            opacity: pp_k * clamp(nt_vis_b.$screen * 3, 0, 1)
            shader paper { at: ccx - nt_w / 2 - 8, vb - th.b - nt_d * nt_vis_b.$screen - 8; size: nt_w + 16, 22 + nt_d * nt_vis_b.$screen + 16; values: 1, 810.3, 8, 9 * cu * (1 - 0.73 * sq); colors: obsidian, deep }
        }
        group {
            show: pp_k > 0.01 and fm > 0.35 and sb > 0.5 and nt_vis_r.$screen > 0.02
            opacity: pp_k * clamp(nt_vis_r.$screen * 3, 0, 1)
            shader paper { at: screen.width - th.r - nt_d * nt_vis_r.$screen - 8, vcc - nt_w / 2 - 8; size: 22 + nt_d * nt_vis_r.$screen + 16, nt_w + 16; values: 1, 214.7, 8, 9 * cu * (1 - 0.73 * sq); colors: obsidian, deep }
        }
        group {
            show: pp_k > 0.01 and cdk.g > 0.02
            opacity: pp_k * clamp(cdk.g * 3, 0, 1)
            let ppcdm = if(pick(screen.index, cdk_ax.0, cdk_ax.1) < -0.5, 1, 0) + 2 * if(pick(screen.index, cdk_ax.0, cdk_ax.1) > 0.5, 1, 0) + 4 * if(pick(screen.index, cdk_ay.0, cdk_ay.1) < -0.5, 1, 0) + 8 * if(pick(screen.index, cdk_ay.0, cdk_ay.1) > 0.5, 1, 0)
            shader paper { at: cdk.bx - max(0.3, cdk.bw) / 2 - 8, cdk.by - max(0.3, cdk.bh) / 2 - 8; size: max(0.3, cdk.bw) + 16, max(0.3, cdk.bh) + 16; values: 1, 6.2 + 100 * ppcdm, 8, cdk.cr; colors: obsidian, deep }
        }
        group {
            show: pp_k > 0.01 and adk.g > 0.02
            opacity: pp_k * clamp(adk.g * 3, 0, 1)
            let ppadm = if(pick(screen.index, adk_ax.0, adk_ax.1) < -0.5, 1, 0) + 2 * if(pick(screen.index, adk_ax.0, adk_ax.1) > 0.5, 1, 0) + 4 * if(pick(screen.index, adk_ay.0, adk_ay.1) < -0.5, 1, 0) + 8 * if(pick(screen.index, adk_ay.0, adk_ay.1) > 0.5, 1, 0)
            shader paper { at: adk.bx - max(0.3, adk.bw) / 2 - 8, adk.by - max(0.3, adk.bh) / 2 - 8; size: max(0.3, adk.bw) + 16, max(0.3, adk.bh) + 16; values: 1, 17.4 + 100 * ppadm, 8, cdk.cr; colors: obsidian, deep }
        }
        //  The Paper's worn sheet and tape on every drawer that is out: the shader rubs the edges and speckles the cream, and two strips of washi tape hold it down by its top corners.
        group {
            show: pp_k > 0.01 and dk0 > 0.9
            opacity: pp_k * clamp(dk0 * 3 - 2, 0, 1)
            let ppdkl = dk.ex - dk.ew / 2
            let ppdkr = dk.ex + dk.ew / 2
            let ppdkt = dk.ey - dk.eh / 2
            let ppdkb = min(dk.ey + dk.eh / 2, vb - lf.t - 1)
            box { at: ppdkl + 30 * u, ppdkt - 2; size: 60 * u, 19; rotate: -11deg; color: #e9dba8; opacity: 86% }
            box { at: ppdkl + 30 * u, ppdkt - 2; size: 60 * u, 19; rotate: -11deg; stroke: 1; color: deep; opacity: 22% }
            line { from: ppdkl + 30 * u - 30 * u, ppdkt - 2 - 4; to: ppdkl + 30 * u + 30 * u, ppdkt - 2 - 4; width: 1.2; color: #ffffff; opacity: 30%; rotate: -11deg }
            box { at: ppdkr - 58 * u, ppdkt + 4; size: 70 * u, 19; rotate: 3deg; color: #c9d8ec; opacity: 86% }
            box { at: ppdkr - 58 * u, ppdkt + 4; size: 70 * u, 19; rotate: 3deg; stroke: 1; color: deep; opacity: 22% }
            line { from: ppdkr - 58 * u - 35 * u, ppdkt + 4 - 4; to: ppdkr - 58 * u + 35 * u, ppdkt + 4 - 4; width: 1.2; color: #ffffff; opacity: 30%; rotate: 3deg }
        }
        group {
            show: pp_k > 0.01 and dc0 > 0.9
            opacity: pp_k * clamp(dc0 * 3 - 2, 0, 1)
            let ppdcl = dc.ex - dc.ew / 2
            let ppdcr = dc.ex + dc.ew / 2
            let ppdct = dc.ey - dc.eh / 2
            let ppdcb = min(dc.ey + dc.eh / 2, vb - lf.t - 1)
            box { at: ppdcl + 64 * u, ppdct + 5; size: 58 * u, 19; rotate: -3deg; color: #e8b9b4; opacity: 86% }
            box { at: ppdcl + 64 * u, ppdct + 5; size: 58 * u, 19; rotate: -3deg; stroke: 1; color: deep; opacity: 22% }
            line { from: ppdcl + 64 * u - 29 * u, ppdct + 5 - 4; to: ppdcl + 64 * u + 29 * u, ppdct + 5 - 4; width: 1.2; color: #ffffff; opacity: 30%; rotate: -3deg }
            box { at: ppdcr - 24 * u, ppdct - 3; size: 64 * u, 19; rotate: 8deg; color: #cfe0bf; opacity: 86% }
            box { at: ppdcr - 24 * u, ppdct - 3; size: 64 * u, 19; rotate: 8deg; stroke: 1; color: deep; opacity: 22% }
            line { from: ppdcr - 24 * u - 32 * u, ppdct - 3 - 4; to: ppdcr - 24 * u + 32 * u, ppdct - 3 - 4; width: 1.2; color: #ffffff; opacity: 30%; rotate: 8deg }
        }
        group {
            show: pp_k > 0.01 and ds0 > 0.9
            opacity: pp_k * clamp(ds0 * 3 - 2, 0, 1)
            let ppdsl = ds.ex - ds.ew / 2
            let ppdsr = ds.ex + ds.ew / 2
            let ppdst = ds.ey - ds.eh / 2
            let ppdsb = min(ds.ey + ds.eh / 2, vb - lf.t - 1)
            box { at: ppdsl + 18 * u, ppdst + 2; size: 72 * u, 19; rotate: -8deg; color: #e9dba8; opacity: 86% }
            box { at: ppdsl + 18 * u, ppdst + 2; size: 72 * u, 19; rotate: -8deg; stroke: 1; color: deep; opacity: 22% }
            line { from: ppdsl + 18 * u - 36 * u, ppdst + 2 - 4; to: ppdsl + 18 * u + 36 * u, ppdst + 2 - 4; width: 1.2; color: #ffffff; opacity: 30%; rotate: -8deg }
            box { at: ppdsr - 70 * u, ppdst + 6; size: 56 * u, 19; rotate: -2deg; color: #d9c6e6; opacity: 86% }
            box { at: ppdsr - 70 * u, ppdst + 6; size: 56 * u, 19; rotate: -2deg; stroke: 1; color: deep; opacity: 22% }
            line { from: ppdsr - 70 * u - 28 * u, ppdst + 6 - 4; to: ppdsr - 70 * u + 28 * u, ppdst + 6 - 4; width: 1.2; color: #ffffff; opacity: 30%; rotate: -2deg }
        }
        group {
            show: pp_k > 0.01 and dl0 > 0.9
            opacity: pp_k * clamp(dl0 * 3 - 2, 0, 1)
            let ppdll = dl.ex - dl.ew / 2
            let ppdlr = dl.ex + dl.ew / 2
            let ppdlt = dl.ey - dl.eh / 2
            let ppdlb = min(dl.ey + dl.eh / 2, vb - lf.t - 1)
            box { at: ppdll + 52 * u, ppdlt - 1; size: 64 * u, 19; rotate: 6deg; color: #c9d8ec; opacity: 86% }
            box { at: ppdll + 52 * u, ppdlt - 1; size: 64 * u, 19; rotate: 6deg; stroke: 1; color: deep; opacity: 22% }
            line { from: ppdll + 52 * u - 32 * u, ppdlt - 1 - 4; to: ppdll + 52 * u + 32 * u, ppdlt - 1 - 4; width: 1.2; color: #ffffff; opacity: 30%; rotate: 6deg }
            box { at: ppdlr - 34 * u, ppdlb - 14 - 6; size: 62 * u, 19; rotate: -6deg; color: #e9dba8; opacity: 86% }
            box { at: ppdlr - 34 * u, ppdlb - 14 - 6; size: 62 * u, 19; rotate: -6deg; stroke: 1; color: deep; opacity: 22% }
            line { from: ppdlr - 34 * u - 31 * u, ppdlb - 14 - 6 - 4; to: ppdlr - 34 * u + 31 * u, ppdlb - 14 - 6 - 4; width: 1.2; color: #ffffff; opacity: 30%; rotate: -6deg }
        }
        group {
            show: pp_k > 0.01 and dm0 > 0.9
            opacity: pp_k * clamp(dm0 * 3 - 2, 0, 1)
            let ppdml = dm.ex - dm.ew / 2
            let ppdmr = dm.ex + dm.ew / 2
            let ppdmt = dm.ey - dm.eh / 2
            let ppdmb = min(dm.ey + dm.eh / 2, vb - lf.t - 1)
            box { at: ppdml + 40 * u, ppdmt + 6; size: 56 * u, 19; rotate: -14deg; color: #cfe0bf; opacity: 86% }
            box { at: ppdml + 40 * u, ppdmt + 6; size: 56 * u, 19; rotate: -14deg; stroke: 1; color: deep; opacity: 22% }
            line { from: ppdml + 40 * u - 28 * u, ppdmt + 6 - 4; to: ppdml + 40 * u + 28 * u, ppdmt + 6 - 4; width: 1.2; color: #ffffff; opacity: 30%; rotate: -14deg }
            box { at: ppdmr - 46 * u, ppdmt - 2; size: 70 * u, 19; rotate: 5deg; color: #e8b9b4; opacity: 86% }
            box { at: ppdmr - 46 * u, ppdmt - 2; size: 70 * u, 19; rotate: 5deg; stroke: 1; color: deep; opacity: 22% }
            line { from: ppdmr - 46 * u - 35 * u, ppdmt - 2 - 4; to: ppdmr - 46 * u + 35 * u, ppdmt - 2 - 4; width: 1.2; color: #ffffff; opacity: 30%; rotate: 5deg }
        }
        group {
            show: pp_k > 0.01 and dz0 > 0.9
            opacity: pp_k * clamp(dz0 * 3 - 2, 0, 1)
            let ppdzl = dz.fx - dz.fw / 2
            let ppdzr = dz.fx + dz.fw / 2
            let ppdzt = dz.fcy - dz.fh / 2
            let ppdzb = min(dz.fcy + dz.fh / 2, vb - lf.t - 1)
            box { at: ppdzl + 28 * u, ppdzb - 14 - 4; size: 66 * u, 19; rotate: 7deg; color: #d9c6e6; opacity: 86% }
            box { at: ppdzl + 28 * u, ppdzb - 14 - 4; size: 66 * u, 19; rotate: 7deg; stroke: 1; color: deep; opacity: 22% }
            line { from: ppdzl + 28 * u - 33 * u, ppdzb - 14 - 4 - 4; to: ppdzl + 28 * u + 33 * u, ppdzb - 14 - 4 - 4; width: 1.2; color: #ffffff; opacity: 30%; rotate: 7deg }
            box { at: ppdzr - 62 * u, ppdzt + 3; size: 60 * u, 19; rotate: -4deg; color: #c9d8ec; opacity: 86% }
            box { at: ppdzr - 62 * u, ppdzt + 3; size: 60 * u, 19; rotate: -4deg; stroke: 1; color: deep; opacity: 22% }
            line { from: ppdzr - 62 * u - 30 * u, ppdzt + 3 - 4; to: ppdzr - 62 * u + 30 * u, ppdzt + 3 - 4; width: 1.2; color: #ffffff; opacity: 30%; rotate: -4deg }
        }
        //  The Cassette's detail on each drawer, only while it is plastic and the drawer is out: an accent-coloured tab at the top left (opposite the grips) (a console's button), a row of straight vertical grip slots in the bottom right
        //  corner (like the vents of a handheld: dark, with a lit edge) that run a few pixels past the drawer's bottom edge as if they wrapped round the base, and a screw in the bottom left.
        //  Inside the drawer they stay in its margin, so they never touch what it holds.
        group {
            show: cas_k > 0.01 and dk0 > 0.9
            opacity: cas_k * clamp(dk0 * 3 - 2, 0, 1)
            let gdk.l = dk.ex - dk.ew / 2
            let gdk.r = dk.ex + dk.ew / 2
            let gdk.t = dk.ey - dk.eh / 2
            let gdk.b = min(dk.ey + dk.eh / 2, vb - lf.t - 1)
            box { at: gdk.l + 58.5 * u + 2, gdk.t + 9 + 3; size: 58 * u, 24; corner: 5; color: deep; opacity: 38% }
            box { at: gdk.l + 58.5 * u, gdk.t + 9; size: 58 * u, 24; corner: 5; color: mintlo }
            box { at: gdk.l + 58.5 * u, gdk.t + 9 - 2.5; size: 58 * u, 24 - 5; corner: 5; color: mint }
            line { from: gdk.l + 58.5 * u - 24 * u, gdk.t + 9 - 2.5 - (24 - 5) / 2 + 4; to: gdk.l + 58.5 * u + 24 * u, gdk.t + 9 - 2.5 - (24 - 5) / 2 + 4; width: 2.2; color: minthi; opacity: 70% }
            box { at: gdk.l + 58.5 * u, gdk.t + 9; size: 58 * u, 24; corner: 5; stroke: 1.4; color: deep }
            repeat k in 0..8 {
                line { from: gdk.r - 20 * u - k * 11 * u, gdk.b + 4; to: gdk.r - 20 * u - k * 11 * u, gdk.b - 18; width: 6; color: mix(deep, #ffffff, 6%) }
                line { from: gdk.r - 20 * u - k * 11 * u + 3.6, gdk.b + 4; to: gdk.r - 20 * u - k * 11 * u + 3.6, gdk.b - 18; width: 1.2; color: #ffffff; opacity: 45% }
            }
            ellipse { at: gdk.l + 12, gdk.b - 12; radius: 3.6; color: mix(deep, #ffffff, 38%) }
            ellipse { at: gdk.l + 12, gdk.b - 12; radius: 3.6; stroke: 1.1; color: deep }
            line { from: gdk.l + 10, gdk.b - 10; to: gdk.l + 14, gdk.b - 14; width: 1.3; color: deep }
        }
        group {
            show: cas_k > 0.01 and dc0 > 0.9
            opacity: cas_k * clamp(dc0 * 3 - 2, 0, 1)
            let gdc.l = dc.ex - dc.ew / 2
            let gdc.r = dc.ex + dc.ew / 2
            let gdc.t = dc.ey - dc.eh / 2
            let gdc.b = min(dc.ey + dc.eh / 2, vb - lf.t - 1)
            box { at: gdc.l + 58.5 * u + 2, gdc.t + 9 + 3; size: 58 * u, 24; corner: 5; color: deep; opacity: 38% }
            box { at: gdc.l + 58.5 * u, gdc.t + 9; size: 58 * u, 24; corner: 5; color: mintlo }
            box { at: gdc.l + 58.5 * u, gdc.t + 9 - 2.5; size: 58 * u, 24 - 5; corner: 5; color: mint }
            line { from: gdc.l + 58.5 * u - 24 * u, gdc.t + 9 - 2.5 - (24 - 5) / 2 + 4; to: gdc.l + 58.5 * u + 24 * u, gdc.t + 9 - 2.5 - (24 - 5) / 2 + 4; width: 2.2; color: minthi; opacity: 70% }
            box { at: gdc.l + 58.5 * u, gdc.t + 9; size: 58 * u, 24; corner: 5; stroke: 1.4; color: deep }
            repeat k in 0..8 {
                line { from: gdc.r - 20 * u - k * 11 * u, gdc.b + 4; to: gdc.r - 20 * u - k * 11 * u, gdc.b - 18; width: 6; color: mix(deep, #ffffff, 6%) }
                line { from: gdc.r - 20 * u - k * 11 * u + 3.6, gdc.b + 4; to: gdc.r - 20 * u - k * 11 * u + 3.6, gdc.b - 18; width: 1.2; color: #ffffff; opacity: 45% }
            }
            ellipse { at: gdc.l + 12, gdc.b - 12; radius: 3.6; color: mix(deep, #ffffff, 38%) }
            ellipse { at: gdc.l + 12, gdc.b - 12; radius: 3.6; stroke: 1.1; color: deep }
            line { from: gdc.l + 10, gdc.b - 10; to: gdc.l + 14, gdc.b - 14; width: 1.3; color: deep }
        }
        group {
            show: cas_k > 0.01 and ds0 > 0.9
            opacity: cas_k * clamp(ds0 * 3 - 2, 0, 1)
            let gds.l = ds.ex - ds.ew / 2
            let gds.r = ds.ex + ds.ew / 2
            let gds.t = ds.ey - ds.eh / 2
            let gds.b = min(ds.ey + ds.eh / 2, vb - lf.t - 1)
            box { at: gds.l + 58.5 * u + 2, gds.t + 9 + 3; size: 58 * u, 24; corner: 5; color: deep; opacity: 38% }
            box { at: gds.l + 58.5 * u, gds.t + 9; size: 58 * u, 24; corner: 5; color: mintlo }
            box { at: gds.l + 58.5 * u, gds.t + 9 - 2.5; size: 58 * u, 24 - 5; corner: 5; color: mint }
            line { from: gds.l + 58.5 * u - 24 * u, gds.t + 9 - 2.5 - (24 - 5) / 2 + 4; to: gds.l + 58.5 * u + 24 * u, gds.t + 9 - 2.5 - (24 - 5) / 2 + 4; width: 2.2; color: minthi; opacity: 70% }
            box { at: gds.l + 58.5 * u, gds.t + 9; size: 58 * u, 24; corner: 5; stroke: 1.4; color: deep }
            repeat k in 0..8 {
                line { from: gds.r - 20 * u - k * 11 * u, gds.b + 4; to: gds.r - 20 * u - k * 11 * u, gds.b - 18; width: 6; color: mix(deep, #ffffff, 6%) }
                line { from: gds.r - 20 * u - k * 11 * u + 3.6, gds.b + 4; to: gds.r - 20 * u - k * 11 * u + 3.6, gds.b - 18; width: 1.2; color: #ffffff; opacity: 45% }
            }
            ellipse { at: gds.l + 12, gds.b - 12; radius: 3.6; color: mix(deep, #ffffff, 38%) }
            ellipse { at: gds.l + 12, gds.b - 12; radius: 3.6; stroke: 1.1; color: deep }
            line { from: gds.l + 10, gds.b - 10; to: gds.l + 14, gds.b - 14; width: 1.3; color: deep }
        }
        group {
            show: cas_k > 0.01 and dl0 > 0.9
            opacity: cas_k * clamp(dl0 * 3 - 2, 0, 1)
            let gdl.l = dl.ex - dl.ew / 2
            let gdl.r = dl.ex + dl.ew / 2
            let gdl.t = dl.ey - dl.eh / 2
            let gdl.b = min(dl.ey + dl.eh / 2, vb - lf.t - 1)
            box { at: gdl.l + 58.5 * u + 2, gdl.t + 9 + 3; size: 58 * u, 24; corner: 5; color: deep; opacity: 38% }
            box { at: gdl.l + 58.5 * u, gdl.t + 9; size: 58 * u, 24; corner: 5; color: mintlo }
            box { at: gdl.l + 58.5 * u, gdl.t + 9 - 2.5; size: 58 * u, 24 - 5; corner: 5; color: mint }
            line { from: gdl.l + 58.5 * u - 24 * u, gdl.t + 9 - 2.5 - (24 - 5) / 2 + 4; to: gdl.l + 58.5 * u + 24 * u, gdl.t + 9 - 2.5 - (24 - 5) / 2 + 4; width: 2.2; color: minthi; opacity: 70% }
            box { at: gdl.l + 58.5 * u, gdl.t + 9; size: 58 * u, 24; corner: 5; stroke: 1.4; color: deep }
            repeat k in 0..8 {
                line { from: gdl.r - 20 * u - k * 11 * u, gdl.b + 4; to: gdl.r - 20 * u - k * 11 * u, gdl.b - 18; width: 6; color: mix(deep, #ffffff, 6%) }
                line { from: gdl.r - 20 * u - k * 11 * u + 3.6, gdl.b + 4; to: gdl.r - 20 * u - k * 11 * u + 3.6, gdl.b - 18; width: 1.2; color: #ffffff; opacity: 45% }
            }
            ellipse { at: gdl.l + 12, gdl.b - 12; radius: 3.6; color: mix(deep, #ffffff, 38%) }
            ellipse { at: gdl.l + 12, gdl.b - 12; radius: 3.6; stroke: 1.1; color: deep }
            line { from: gdl.l + 10, gdl.b - 10; to: gdl.l + 14, gdl.b - 14; width: 1.3; color: deep }
        }
        group {
            show: cas_k > 0.01 and dm0 > 0.9
            opacity: cas_k * clamp(dm0 * 3 - 2, 0, 1)
            let gdm.l = dm.ex - dm.ew / 2
            let gdm.r = dm.ex + dm.ew / 2
            let gdm.t = dm.ey - dm.eh / 2
            let gdm.b = min(dm.ey + dm.eh / 2, vb - lf.t - 1)
            box { at: gdm.l + 58.5 * u + 2, gdm.t + 9 + 3; size: 58 * u, 24; corner: 5; color: deep; opacity: 38% }
            box { at: gdm.l + 58.5 * u, gdm.t + 9; size: 58 * u, 24; corner: 5; color: mintlo }
