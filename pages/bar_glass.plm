            box { at: gdz.l + 58.5 * u, gdz.t + 9; size: 58 * u, 24; corner: 5; stroke: 1.4; color: deep }
            repeat k in 0..8 {
                line { from: gdz.r - 20 * u - k * 11 * u, gdz.b + 4; to: gdz.r - 20 * u - k * 11 * u, gdz.b - 18; width: 6; color: mix(deep, #ffffff, 6%) }
                line { from: gdz.r - 20 * u - k * 11 * u + 3.6, gdz.b + 4; to: gdz.r - 20 * u - k * 11 * u + 3.6, gdz.b - 18; width: 1.2; color: #ffffff; opacity: 45% }
            }
            ellipse { at: gdz.l + 12, gdz.b - 12; radius: 3.6; color: mix(deep, #ffffff, 38%) }
            ellipse { at: gdz.l + 12, gdz.b - 12; radius: 3.6; stroke: 1.1; color: deep }
            line { from: gdz.l + 10, gdz.b - 10; to: gdz.l + 14, gdz.b - 14; width: 1.3; color: deep }
        }
        //  The Proxy's slanted plates, as ordinary paths and not shapes on the glass (the Proxy is solid, so nothing needs the glass blend; as glass shapes they sat in every copy of
        //  bar_shapes.plm and cost frame time with the theme off). Painted in three passes so that overlapping plates melt as the glass did: every hard offset shadow, then every outline
        //  (twice the width), then every fill over them, which hides the outlines inside another plate and the inner half of the rest.
        group { show: px_k > 0.01 and dk0 > 0.004; opacity: 85% * px_k * clamp((dk0 - 0.004) * 4, 0, 1); move: 2.5 * u, 3 * u
            path { at: dk.ex + if(px_k > 0.5 and (dk0 > 0.004), 0, 30000), dk.ey - sg.up / 2; color: deep; move pxk_drawer_r - pxk_drawer_w / 2 + pxk_drawer_sk / 2, 0 - pxk_drawer_h / 2; line pxk_drawer_w / 2 - pxk_drawer_r + pxk_drawer_sk / 2, 0 - pxk_drawer_h / 2; curve pxk_drawer_w / 2 + pxk_drawer_sk / 2 - pxk_drawer_r * pxk_drawer_sk / pxk_drawer_l, pxk_drawer_r * pxk_drawer_h / pxk_drawer_l - pxk_drawer_h / 2 via pxk_drawer_w / 2 + pxk_drawer_sk / 2, 0 - pxk_drawer_h / 2; line pxk_drawer_w / 2 - pxk_drawer_sk / 2 + pxk_drawer_r * pxk_drawer_sk / pxk_drawer_l, pxk_drawer_h / 2 - pxk_drawer_r * pxk_drawer_h / pxk_drawer_l; curve pxk_drawer_w / 2 - pxk_drawer_sk / 2 - pxk_drawer_r, pxk_drawer_h / 2 via pxk_drawer_w / 2 - pxk_drawer_sk / 2, pxk_drawer_h / 2; line pxk_drawer_r - pxk_drawer_w / 2 - pxk_drawer_sk / 2, pxk_drawer_h / 2; curve pxk_drawer_r * pxk_drawer_sk / pxk_drawer_l - pxk_drawer_w / 2 - pxk_drawer_sk / 2, pxk_drawer_h / 2 - pxk_drawer_r * pxk_drawer_h / pxk_drawer_l via 0 - pxk_drawer_w / 2 - pxk_drawer_sk / 2, pxk_drawer_h / 2; line pxk_drawer_sk / 2 - pxk_drawer_w / 2 - pxk_drawer_r * pxk_drawer_sk / pxk_drawer_l, pxk_drawer_r * pxk_drawer_h / pxk_drawer_l - pxk_drawer_h / 2; curve pxk_drawer_r - pxk_drawer_w / 2 + pxk_drawer_sk / 2, 0 - pxk_drawer_h / 2 via pxk_drawer_sk / 2 - pxk_drawer_w / 2, 0 - pxk_drawer_h / 2; close }
