            path { at: dz.fx + if(fm > 0.5, 0, 30000) + if(px_k > 0.5 and (dz0 > 0.004), 0, 30000), dz.fcy; color: obsidian; move pxk_zdrawer_r - pxk_zdrawer_w / 2 + pxk_zdrawer_sk / 2, 0 - pxk_zdrawer_h / 2; line pxk_zdrawer_w / 2 - pxk_zdrawer_r + pxk_zdrawer_sk / 2, 0 - pxk_zdrawer_h / 2; curve pxk_zdrawer_w / 2 + pxk_zdrawer_sk / 2 - pxk_zdrawer_r * pxk_zdrawer_sk / pxk_zdrawer_l, pxk_zdrawer_r * pxk_zdrawer_h / pxk_zdrawer_l - pxk_zdrawer_h / 2 via pxk_zdrawer_w / 2 + pxk_zdrawer_sk / 2, 0 - pxk_zdrawer_h / 2; line pxk_zdrawer_w / 2 - pxk_zdrawer_sk / 2 + pxk_zdrawer_r * pxk_zdrawer_sk / pxk_zdrawer_l, pxk_zdrawer_h / 2 - pxk_zdrawer_r * pxk_zdrawer_h / pxk_zdrawer_l; curve pxk_zdrawer_w / 2 - pxk_zdrawer_sk / 2 - pxk_zdrawer_r, pxk_zdrawer_h / 2 via pxk_zdrawer_w / 2 - pxk_zdrawer_sk / 2, pxk_zdrawer_h / 2; line pxk_zdrawer_r - pxk_zdrawer_w / 2 - pxk_zdrawer_sk / 2, pxk_zdrawer_h / 2; curve pxk_zdrawer_r * pxk_zdrawer_sk / pxk_zdrawer_l - pxk_zdrawer_w / 2 - pxk_zdrawer_sk / 2, pxk_zdrawer_h / 2 - pxk_zdrawer_r * pxk_zdrawer_h / pxk_zdrawer_l via 0 - pxk_zdrawer_w / 2 - pxk_zdrawer_sk / 2, pxk_zdrawer_h / 2; line pxk_zdrawer_sk / 2 - pxk_zdrawer_w / 2 - pxk_zdrawer_r * pxk_zdrawer_sk / pxk_zdrawer_l, pxk_zdrawer_r * pxk_zdrawer_h / pxk_zdrawer_l - pxk_zdrawer_h / 2; curve pxk_zdrawer_r - pxk_zdrawer_w / 2 + pxk_zdrawer_sk / 2, 0 - pxk_zdrawer_h / 2 via pxk_zdrawer_sk / 2 - pxk_zdrawer_w / 2, 0 - pxk_zdrawer_h / 2; close }
        }
        group { show: px_k > 0.01 and sg > 0.35; opacity: px_k * clamp((sg - 0.35) * 4, 0, 1)
            path { at: (sg.lr - sg.r) / 2 + if(sg > 0.35, 0, 30000) + if(px_k > 0.5, 0, 30000), yo + (sg.hc - sg.r) / 2; color: obsidian; move pxk_sgl_r - pxk_sgl_w / 2 + pxk_sgl_sk / 2, 0 - pxk_sgl_h / 2; line pxk_sgl_w / 2 - pxk_sgl_r + pxk_sgl_sk / 2, 0 - pxk_sgl_h / 2; curve pxk_sgl_w / 2 + pxk_sgl_sk / 2 - pxk_sgl_r * pxk_sgl_sk / pxk_sgl_l, pxk_sgl_r * pxk_sgl_h / pxk_sgl_l - pxk_sgl_h / 2 via pxk_sgl_w / 2 + pxk_sgl_sk / 2, 0 - pxk_sgl_h / 2; line pxk_sgl_w / 2 - pxk_sgl_sk / 2 + pxk_sgl_r * pxk_sgl_sk / pxk_sgl_l, pxk_sgl_h / 2 - pxk_sgl_r * pxk_sgl_h / pxk_sgl_l; curve pxk_sgl_w / 2 - pxk_sgl_sk / 2 - pxk_sgl_r, pxk_sgl_h / 2 via pxk_sgl_w / 2 - pxk_sgl_sk / 2, pxk_sgl_h / 2; line pxk_sgl_r - pxk_sgl_w / 2 - pxk_sgl_sk / 2, pxk_sgl_h / 2; curve pxk_sgl_r * pxk_sgl_sk / pxk_sgl_l - pxk_sgl_w / 2 - pxk_sgl_sk / 2, pxk_sgl_h / 2 - pxk_sgl_r * pxk_sgl_h / pxk_sgl_l via 0 - pxk_sgl_w / 2 - pxk_sgl_sk / 2, pxk_sgl_h / 2; line pxk_sgl_sk / 2 - pxk_sgl_w / 2 - pxk_sgl_r * pxk_sgl_sk / pxk_sgl_l, pxk_sgl_r * pxk_sgl_h / pxk_sgl_l - pxk_sgl_h / 2; curve pxk_sgl_r - pxk_sgl_w / 2 + pxk_sgl_sk / 2, 0 - pxk_sgl_h / 2 via pxk_sgl_sk / 2 - pxk_sgl_w / 2, 0 - pxk_sgl_h / 2; close }
        }
        group { show: px_k > 0.01 and sg > 0.35; opacity: px_k * clamp((sg - 0.35) * 4, 0, 1)
            path { at: (sg.q0 + sg.q1) / 2 + if(sg > 0.35, 0, 30000) + if(px_k > 0.5, 0, 30000), yo + (sg.hc - sg.r) / 2; color: obsidian; move pxk_sgc_r - pxk_sgc_w / 2 + pxk_sgc_sk / 2, 0 - pxk_sgc_h / 2; line pxk_sgc_w / 2 - pxk_sgc_r + pxk_sgc_sk / 2, 0 - pxk_sgc_h / 2; curve pxk_sgc_w / 2 + pxk_sgc_sk / 2 - pxk_sgc_r * pxk_sgc_sk / pxk_sgc_l, pxk_sgc_r * pxk_sgc_h / pxk_sgc_l - pxk_sgc_h / 2 via pxk_sgc_w / 2 + pxk_sgc_sk / 2, 0 - pxk_sgc_h / 2; line pxk_sgc_w / 2 - pxk_sgc_sk / 2 + pxk_sgc_r * pxk_sgc_sk / pxk_sgc_l, pxk_sgc_h / 2 - pxk_sgc_r * pxk_sgc_h / pxk_sgc_l; curve pxk_sgc_w / 2 - pxk_sgc_sk / 2 - pxk_sgc_r, pxk_sgc_h / 2 via pxk_sgc_w / 2 - pxk_sgc_sk / 2, pxk_sgc_h / 2; line pxk_sgc_r - pxk_sgc_w / 2 - pxk_sgc_sk / 2, pxk_sgc_h / 2; curve pxk_sgc_r * pxk_sgc_sk / pxk_sgc_l - pxk_sgc_w / 2 - pxk_sgc_sk / 2, pxk_sgc_h / 2 - pxk_sgc_r * pxk_sgc_h / pxk_sgc_l via 0 - pxk_sgc_w / 2 - pxk_sgc_sk / 2, pxk_sgc_h / 2; line pxk_sgc_sk / 2 - pxk_sgc_w / 2 - pxk_sgc_r * pxk_sgc_sk / pxk_sgc_l, pxk_sgc_r * pxk_sgc_h / pxk_sgc_l - pxk_sgc_h / 2; curve pxk_sgc_r - pxk_sgc_w / 2 + pxk_sgc_sk / 2, 0 - pxk_sgc_h / 2 via pxk_sgc_sk / 2 - pxk_sgc_w / 2, 0 - pxk_sgc_h / 2; close }
        }
        group { show: px_k > 0.01 and sg > 0.35; opacity: px_k * clamp((sg - 0.35) * 4, 0, 1)
            path { at: (sg.rq + screen.width + sg.r) / 2 + if(sg > 0.35, 0, 30000) + if(px_k > 0.5, 0, 30000), yo + (sg.hc - sg.r) / 2; color: obsidian; move pxk_sgr_r - pxk_sgr_w / 2 + pxk_sgr_sk / 2, 0 - pxk_sgr_h / 2; line pxk_sgr_w / 2 - pxk_sgr_r + pxk_sgr_sk / 2, 0 - pxk_sgr_h / 2; curve pxk_sgr_w / 2 + pxk_sgr_sk / 2 - pxk_sgr_r * pxk_sgr_sk / pxk_sgr_l, pxk_sgr_r * pxk_sgr_h / pxk_sgr_l - pxk_sgr_h / 2 via pxk_sgr_w / 2 + pxk_sgr_sk / 2, 0 - pxk_sgr_h / 2; line pxk_sgr_w / 2 - pxk_sgr_sk / 2 + pxk_sgr_r * pxk_sgr_sk / pxk_sgr_l, pxk_sgr_h / 2 - pxk_sgr_r * pxk_sgr_h / pxk_sgr_l; curve pxk_sgr_w / 2 - pxk_sgr_sk / 2 - pxk_sgr_r, pxk_sgr_h / 2 via pxk_sgr_w / 2 - pxk_sgr_sk / 2, pxk_sgr_h / 2; line pxk_sgr_r - pxk_sgr_w / 2 - pxk_sgr_sk / 2, pxk_sgr_h / 2; curve pxk_sgr_r * pxk_sgr_sk / pxk_sgr_l - pxk_sgr_w / 2 - pxk_sgr_sk / 2, pxk_sgr_h / 2 - pxk_sgr_r * pxk_sgr_h / pxk_sgr_l via 0 - pxk_sgr_w / 2 - pxk_sgr_sk / 2, pxk_sgr_h / 2; line pxk_sgr_sk / 2 - pxk_sgr_w / 2 - pxk_sgr_r * pxk_sgr_sk / pxk_sgr_l, pxk_sgr_r * pxk_sgr_h / pxk_sgr_l - pxk_sgr_h / 2; curve pxk_sgr_r - pxk_sgr_w / 2 + pxk_sgr_sk / 2, 0 - pxk_sgr_h / 2 via pxk_sgr_sk / 2 - pxk_sgr_w / 2, 0 - pxk_sgr_h / 2; close }
        }
        group { show: px_k > 0.01 and cdk.g > 0.02; opacity: px_k * clamp((cdk.g - 0.02) * 4, 0, 1)
            path { at: cdk.bx + if(cdk.g > 0.02, 0, 30000) + if(px_k > 0.5, 0, 30000), cdk.by; color: obsidian; move pxk_cdk_r - pxk_cdk_w / 2 + pxk_cdk_sk / 2, 0 - pxk_cdk_h / 2; line pxk_cdk_w / 2 - pxk_cdk_r + pxk_cdk_sk / 2, 0 - pxk_cdk_h / 2; curve pxk_cdk_w / 2 + pxk_cdk_sk / 2 - pxk_cdk_r * pxk_cdk_sk / pxk_cdk_l, pxk_cdk_r * pxk_cdk_h / pxk_cdk_l - pxk_cdk_h / 2 via pxk_cdk_w / 2 + pxk_cdk_sk / 2, 0 - pxk_cdk_h / 2; line pxk_cdk_w / 2 - pxk_cdk_sk / 2 + pxk_cdk_r * pxk_cdk_sk / pxk_cdk_l, pxk_cdk_h / 2 - pxk_cdk_r * pxk_cdk_h / pxk_cdk_l; curve pxk_cdk_w / 2 - pxk_cdk_sk / 2 - pxk_cdk_r, pxk_cdk_h / 2 via pxk_cdk_w / 2 - pxk_cdk_sk / 2, pxk_cdk_h / 2; line pxk_cdk_r - pxk_cdk_w / 2 - pxk_cdk_sk / 2, pxk_cdk_h / 2; curve pxk_cdk_r * pxk_cdk_sk / pxk_cdk_l - pxk_cdk_w / 2 - pxk_cdk_sk / 2, pxk_cdk_h / 2 - pxk_cdk_r * pxk_cdk_h / pxk_cdk_l via 0 - pxk_cdk_w / 2 - pxk_cdk_sk / 2, pxk_cdk_h / 2; line pxk_cdk_sk / 2 - pxk_cdk_w / 2 - pxk_cdk_r * pxk_cdk_sk / pxk_cdk_l, pxk_cdk_r * pxk_cdk_h / pxk_cdk_l - pxk_cdk_h / 2; curve pxk_cdk_r - pxk_cdk_w / 2 + pxk_cdk_sk / 2, 0 - pxk_cdk_h / 2 via pxk_cdk_sk / 2 - pxk_cdk_w / 2, 0 - pxk_cdk_h / 2; close }
        }
        group { show: px_k > 0.01 and adk.g > 0.02; opacity: px_k * clamp((adk.g - 0.02) * 4, 0, 1)
            path { at: adk.bx + if(adk.g > 0.02, 0, 30000) + if(px_k > 0.5, 0, 30000), adk.by; color: obsidian; move pxk_adk_r - pxk_adk_w / 2 + pxk_adk_sk / 2, 0 - pxk_adk_h / 2; line pxk_adk_w / 2 - pxk_adk_r + pxk_adk_sk / 2, 0 - pxk_adk_h / 2; curve pxk_adk_w / 2 + pxk_adk_sk / 2 - pxk_adk_r * pxk_adk_sk / pxk_adk_l, pxk_adk_r * pxk_adk_h / pxk_adk_l - pxk_adk_h / 2 via pxk_adk_w / 2 + pxk_adk_sk / 2, 0 - pxk_adk_h / 2; line pxk_adk_w / 2 - pxk_adk_sk / 2 + pxk_adk_r * pxk_adk_sk / pxk_adk_l, pxk_adk_h / 2 - pxk_adk_r * pxk_adk_h / pxk_adk_l; curve pxk_adk_w / 2 - pxk_adk_sk / 2 - pxk_adk_r, pxk_adk_h / 2 via pxk_adk_w / 2 - pxk_adk_sk / 2, pxk_adk_h / 2; line pxk_adk_r - pxk_adk_w / 2 - pxk_adk_sk / 2, pxk_adk_h / 2; curve pxk_adk_r * pxk_adk_sk / pxk_adk_l - pxk_adk_w / 2 - pxk_adk_sk / 2, pxk_adk_h / 2 - pxk_adk_r * pxk_adk_h / pxk_adk_l via 0 - pxk_adk_w / 2 - pxk_adk_sk / 2, pxk_adk_h / 2; line pxk_adk_sk / 2 - pxk_adk_w / 2 - pxk_adk_r * pxk_adk_sk / pxk_adk_l, pxk_adk_r * pxk_adk_h / pxk_adk_l - pxk_adk_h / 2; curve pxk_adk_r - pxk_adk_w / 2 + pxk_adk_sk / 2, 0 - pxk_adk_h / 2 via pxk_adk_sk / 2 - pxk_adk_w / 2, 0 - pxk_adk_h / 2; close }
        }
        //  The Proxy's HUD marks: on every drawer that is out, a slanted black plate hanging off its top left with a green-to-yellow health bar (a pink bar under it, a numbered cell at its start), a data pill with a round blue badge at the top right,
        //  and a hazard-stripe rail under it. They are drawn on the glass, outside it. The bar gets the combo tag and the round ability buttons.
        group {
            show: px_k > 0.01 and dk0 > 0.9
            opacity: px_k * clamp(dk0 * 3 - 2, 0, 1)
            let pxdkl = dk.ex - dk.ew / 2
            let pxdkr = dk.ex + dk.ew / 2
            let pxdkt = dk.ey - dk.eh / 2
            let pxdkb = min(dk.ey + dk.eh / 2, vb - lf.t - 1)
            box { from: pxdkl + 20 * u + 34 * u, pxdkb - 11; size: pxdkr - pxdkl - 40 * u - 2 * 34 * u, 9; color: #0b0d10 }
            repeat pxdkch in 0..130 {
                path { at: pxdkl + 20 * u + 34 * u + pxdkch * 16 * u, pxdkb - 11; color: #ffd21f; opacity: if(pxdkl + 20 * u + 34 * u + pxdkch * 16 * u + 8 * u + 5 < pxdkr - 20 * u - 34 * u, 100%, 0); move 5, 0; line 8 * u + 5, 0; line 8 * u, 9; line 0, 9; close }
            }
            repeat pxdkcc in 0..7 {
                repeat pxdkcw in 0..3 {
                    ellipse { at: pxdkl + 20 * u + pxdkcc * 34 * u / 7, pxdkb - 9.5 + pxdkcw * 3.6 + mod(pxdkcc, 2) * 1.8; radius: 0.5 + pxdkcc * 0.28; color: if(mod(pxdkcc, 2) == 0, #ffd21f, #0b0d10) }
                    ellipse { at: pxdkr - 20 * u - pxdkcc * 34 * u / 7, pxdkb - 9.5 + pxdkcw * 3.6 + mod(pxdkcc, 2) * 1.8; radius: 0.5 + pxdkcc * 0.28; color: if(mod(pxdkcc, 2) == 0, #ffd21f, #0b0d10) }
                }
            }
        }
        group {
            show: px_k > 0.01 and dc0 > 0.9
            opacity: px_k * clamp(dc0 * 3 - 2, 0, 1)
            let pxdcl = dc.ex - dc.ew / 2
            let pxdcr = dc.ex + dc.ew / 2
            let pxdct = dc.ey - dc.eh / 2
            let pxdcb = min(dc.ey + dc.eh / 2, vb - lf.t - 1)
            box { from: pxdcl + 20 * u + 34 * u, pxdcb - 11; size: pxdcr - pxdcl - 40 * u - 2 * 34 * u, 9; color: #0b0d10 }
            repeat pxdcch in 0..130 {
                path { at: pxdcl + 20 * u + 34 * u + pxdcch * 16 * u, pxdcb - 11; color: #ffd21f; opacity: if(pxdcl + 20 * u + 34 * u + pxdcch * 16 * u + 8 * u + 5 < pxdcr - 20 * u - 34 * u, 100%, 0); move 5, 0; line 8 * u + 5, 0; line 8 * u, 9; line 0, 9; close }
            }
            repeat pxdccc in 0..7 {
                repeat pxdccw in 0..3 {
                    ellipse { at: pxdcl + 20 * u + pxdccc * 34 * u / 7, pxdcb - 9.5 + pxdccw * 3.6 + mod(pxdccc, 2) * 1.8; radius: 0.5 + pxdccc * 0.28; color: if(mod(pxdccc, 2) == 0, #ffd21f, #0b0d10) }
                    ellipse { at: pxdcr - 20 * u - pxdccc * 34 * u / 7, pxdcb - 9.5 + pxdccw * 3.6 + mod(pxdccc, 2) * 1.8; radius: 0.5 + pxdccc * 0.28; color: if(mod(pxdccc, 2) == 0, #ffd21f, #0b0d10) }
                }
            }
        }
        group {
            show: px_k > 0.01 and ds0 > 0.9
            opacity: px_k * clamp(ds0 * 3 - 2, 0, 1)
            let pxdsl = ds.ex - ds.ew / 2
            let pxdsr = ds.ex + ds.ew / 2
            let pxdst = ds.ey - ds.eh / 2
            let pxdsb = min(ds.ey + ds.eh / 2, vb - lf.t - 1)
            box { from: pxdsl + 20 * u + 34 * u, pxdsb - 11; size: pxdsr - pxdsl - 40 * u - 2 * 34 * u, 9; color: #0b0d10 }
            repeat pxdsch in 0..130 {
                path { at: pxdsl + 20 * u + 34 * u + pxdsch * 16 * u, pxdsb - 11; color: #ffd21f; opacity: if(pxdsl + 20 * u + 34 * u + pxdsch * 16 * u + 8 * u + 5 < pxdsr - 20 * u - 34 * u, 100%, 0); move 5, 0; line 8 * u + 5, 0; line 8 * u, 9; line 0, 9; close }
            }
            repeat pxdscc in 0..7 {
                repeat pxdscw in 0..3 {
                    ellipse { at: pxdsl + 20 * u + pxdscc * 34 * u / 7, pxdsb - 9.5 + pxdscw * 3.6 + mod(pxdscc, 2) * 1.8; radius: 0.5 + pxdscc * 0.28; color: if(mod(pxdscc, 2) == 0, #ffd21f, #0b0d10) }
                    ellipse { at: pxdsr - 20 * u - pxdscc * 34 * u / 7, pxdsb - 9.5 + pxdscw * 3.6 + mod(pxdscc, 2) * 1.8; radius: 0.5 + pxdscc * 0.28; color: if(mod(pxdscc, 2) == 0, #ffd21f, #0b0d10) }
                }
            }
        }
        group {
            show: px_k > 0.01 and dl0 > 0.9
            opacity: px_k * clamp(dl0 * 3 - 2, 0, 1)
            let pxdll = dl.ex - dl.ew / 2
            let pxdlr = dl.ex + dl.ew / 2
            let pxdlt = dl.ey - dl.eh / 2
            let pxdlb = min(dl.ey + dl.eh / 2, vb - lf.t - 1)
            box { from: pxdll + 20 * u + 34 * u, pxdlb - 11; size: pxdlr - pxdll - 40 * u - 2 * 34 * u, 9; color: #0b0d10 }
            repeat pxdlch in 0..130 {
                path { at: pxdll + 20 * u + 34 * u + pxdlch * 16 * u, pxdlb - 11; color: #ffd21f; opacity: if(pxdll + 20 * u + 34 * u + pxdlch * 16 * u + 8 * u + 5 < pxdlr - 20 * u - 34 * u, 100%, 0); move 5, 0; line 8 * u + 5, 0; line 8 * u, 9; line 0, 9; close }
            }
            repeat pxdlcc in 0..7 {
                repeat pxdlcw in 0..3 {
                    ellipse { at: pxdll + 20 * u + pxdlcc * 34 * u / 7, pxdlb - 9.5 + pxdlcw * 3.6 + mod(pxdlcc, 2) * 1.8; radius: 0.5 + pxdlcc * 0.28; color: if(mod(pxdlcc, 2) == 0, #ffd21f, #0b0d10) }
                    ellipse { at: pxdlr - 20 * u - pxdlcc * 34 * u / 7, pxdlb - 9.5 + pxdlcw * 3.6 + mod(pxdlcc, 2) * 1.8; radius: 0.5 + pxdlcc * 0.28; color: if(mod(pxdlcc, 2) == 0, #ffd21f, #0b0d10) }
                }
            }
        }
        group {
            show: px_k > 0.01 and dm0 > 0.9
            opacity: px_k * clamp(dm0 * 3 - 2, 0, 1)
            let pxdml = dm.ex - dm.ew / 2
            let pxdmr = dm.ex + dm.ew / 2
            let pxdmt = dm.ey - dm.eh / 2
            let pxdmb = min(dm.ey + dm.eh / 2, vb - lf.t - 1)
            box { from: pxdml + 20 * u + 34 * u, pxdmb - 11; size: pxdmr - pxdml - 40 * u - 2 * 34 * u, 9; color: #0b0d10 }
            repeat pxdmch in 0..130 {
                path { at: pxdml + 20 * u + 34 * u + pxdmch * 16 * u, pxdmb - 11; color: #ffd21f; opacity: if(pxdml + 20 * u + 34 * u + pxdmch * 16 * u + 8 * u + 5 < pxdmr - 20 * u - 34 * u, 100%, 0); move 5, 0; line 8 * u + 5, 0; line 8 * u, 9; line 0, 9; close }
            }
            repeat pxdmcc in 0..7 {
                repeat pxdmcw in 0..3 {
                    ellipse { at: pxdml + 20 * u + pxdmcc * 34 * u / 7, pxdmb - 9.5 + pxdmcw * 3.6 + mod(pxdmcc, 2) * 1.8; radius: 0.5 + pxdmcc * 0.28; color: if(mod(pxdmcc, 2) == 0, #ffd21f, #0b0d10) }
                    ellipse { at: pxdmr - 20 * u - pxdmcc * 34 * u / 7, pxdmb - 9.5 + pxdmcw * 3.6 + mod(pxdmcc, 2) * 1.8; radius: 0.5 + pxdmcc * 0.28; color: if(mod(pxdmcc, 2) == 0, #ffd21f, #0b0d10) }
                }
            }
        }
        group {
            show: px_k > 0.01 and dz0 > 0.9
            opacity: px_k * clamp(dz0 * 3 - 2, 0, 1)
            let pxdzl = dz.fl
            let pxdzr = dz.fr
            let pxdzt = dz.ft
            let pxdzb = min(dz.fb, vb - lf.t - 1)
            box { from: pxdzl + 20 * u + 34 * u, pxdzb - 11; size: pxdzr - pxdzl - 40 * u - 2 * 34 * u, 9; color: #0b0d10 }
            repeat pxdzch in 0..130 {
                path { at: pxdzl + 20 * u + 34 * u + pxdzch * 16 * u, pxdzb - 11; color: #ffd21f; opacity: if(pxdzl + 20 * u + 34 * u + pxdzch * 16 * u + 8 * u + 5 < pxdzr - 20 * u - 34 * u, 100%, 0); move 5, 0; line 8 * u + 5, 0; line 8 * u, 9; line 0, 9; close }
            }
            repeat pxdzcc in 0..7 {
                repeat pxdzcw in 0..3 {
                    ellipse { at: pxdzl + 20 * u + pxdzcc * 34 * u / 7, pxdzb - 9.5 + pxdzcw * 3.6 + mod(pxdzcc, 2) * 1.8; radius: 0.5 + pxdzcc * 0.28; color: if(mod(pxdzcc, 2) == 0, #ffd21f, #0b0d10) }
                    ellipse { at: pxdzr - 20 * u - pxdzcc * 34 * u / 7, pxdzb - 9.5 + pxdzcw * 3.6 + mod(pxdzcc, 2) * 1.8; radius: 0.5 + pxdzcc * 0.28; color: if(mod(pxdzcc, 2) == 0, #ffd21f, #0b0d10) }
                }
            }
        }
        //  The Cyber's HUD marks: bright corner brackets (with a soft glow) round the bar and round every drawer that is out, and a little ruler of ticks under each. At each one's bottom right a terminal readout: hex digits that jump between three values, and a block cursor that blinks.
        //  They are drawn on the glass, outside it, and never outline it.
        group {
            show: cy_k > 0.01 and lm < 0.5
            opacity: cy_k * (1 - lm)
            let cybarl = cx - (bar.w + pv * 10 * u) / 2
            let cybarr = cx + (bar.w + pv * 10 * u) / 2
            let cybart = bar.y - bar.h / 2
            let cybarb = bar.y - bar.h / 2 + bar.h + pop
            //  (the bar itself has no corner brackets: only the drawers and the cards under it do; its ruler of ticks and its readout stay)
            repeat cybark in 0..13 {
                line { from: cybarl + 22 + cybark * 6 * u, cybarb + 6 * u + 1; to: cybarl + 22 + cybark * 6 * u, cybarb + 6 * u + 1 + if(mod(cybark, 4) == 0, 6 * u, 3 * u); width: 1.1; color: mint; opacity: 70% }
            }
        
            text "SYS 7F3A·9C21" { at: cybarr - 9 * u, cybarb + 6 * u + 11 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 0), 3) == 0, 85%, 0) }
            text "SYS A1E4·03BD" { at: cybarr - 9 * u, cybarb + 6 * u + 11 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 0), 3) == 1, 85%, 0) }
            text "SYS 5C90·E7F2" { at: cybarr - 9 * u, cybarb + 6 * u + 11 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 0), 3) == 2, 85%, 0) }
            box { at: cybarr - 3 * u, cybarb + 6 * u + 11 * u; size: 5 * u, 10 * u; color: minthi; opacity: cy_on * if(mod(time * 1.7, 1) < 0.5, 90%, 0) }
        }
        group {
            show: cy_k > 0.01 and dk0 > 0.9
            opacity: cy_k * clamp(dk0 * 3 - 2, 0, 1)
            let cydkl = dk.ex - dk.ew / 2
            let cydkr = dk.ex + dk.ew / 2
            let cydkt = dk.ey - dk.eh / 2
            let cydkb = min(dk.ey + dk.eh / 2, vb - lf.t - 1)
            shader matrix { at: cydkl, cydkt; size: cydkr - cydkl, cydkb - cydkt; corner: 24 * u; values: 0.28, 1; colors: mint, minthi }
            repeat cydkc in 0..4 {
                let cydkx = if(mod(cydkc, 2) == 0, cydkl - 7 * u, cydkr + 7 * u)
                let cydky = if(cydkc < 2, cydkt - 7 * u, cydkb + 7 * u)
                let cydksx = if(mod(cydkc, 2) == 0, -1, 1)
                let cydksy = if(cydkc < 2, -1, 1)
                path { at: cydkx, cydky; stroke: 5 * u; color: mint; opacity: 16%; move 0, -cydksy * 15 * u; line 0, 0; line -cydksx * 15 * u, 0 }
                path { at: cydkx, cydky; stroke: 1.7; color: minthi; move 0, -cydksy * 15 * u; line 0, 0; line -cydksx * 15 * u, 0 }
            }
            repeat cydkk in 0..13 {
                line { from: cydkl + 22 + cydkk * 6 * u, cydkb + 7 * u + 1; to: cydkl + 22 + cydkk * 6 * u, cydkb + 7 * u + 1 + if(mod(cydkk, 4) == 0, 6 * u, 3 * u); width: 1.1; color: mint; opacity: 70% }
            }
        
            text "SYS 2B6D·F418" { at: cydkr - 16 * u, cydkb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 1), 3) == 0, 85%, 0) }
            text "SYS E90C·57A3" { at: cydkr - 16 * u, cydkb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 1), 3) == 1, 85%, 0) }
            text "SYS 30D8·B166" { at: cydkr - 16 * u, cydkb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 1), 3) == 2, 85%, 0) }
            box { at: cydkr - 10 * u, cydkb - 9 * u; size: 5 * u, 10 * u; color: minthi; opacity: cy_on * if(mod(time * 1.7, 1) < 0.5, 90%, 0) }
        }
        group {
            show: cy_k > 0.01 and dc0 > 0.9
            opacity: cy_k * clamp(dc0 * 3 - 2, 0, 1)
            let cydcl = dc.ex - dc.ew / 2
            let cydcr = dc.ex + dc.ew / 2
            let cydct = dc.ey - dc.eh / 2
            let cydcb = min(dc.ey + dc.eh / 2, vb - lf.t - 1)
            shader matrix { at: cydcl, cydct; size: cydcr - cydcl, cydcb - cydct; corner: 24 * u; values: 0.28, 1; colors: mint, minthi }
            repeat cydcc in 0..4 {
                let cydcx = if(mod(cydcc, 2) == 0, cydcl - 7 * u, cydcr + 7 * u)
                let cydcy = if(cydcc < 2, cydct - 7 * u, cydcb + 7 * u)
                let cydcsx = if(mod(cydcc, 2) == 0, -1, 1)
                let cydcsy = if(cydcc < 2, -1, 1)
                path { at: cydcx, cydcy; stroke: 5 * u; color: mint; opacity: 16%; move 0, -cydcsy * 15 * u; line 0, 0; line -cydcsx * 15 * u, 0 }
                path { at: cydcx, cydcy; stroke: 1.7; color: minthi; move 0, -cydcsy * 15 * u; line 0, 0; line -cydcsx * 15 * u, 0 }
            }
            repeat cydck in 0..13 {
                line { from: cydcl + 22 + cydck * 6 * u, cydcb + 7 * u + 1; to: cydcl + 22 + cydck * 6 * u, cydcb + 7 * u + 1 + if(mod(cydck, 4) == 0, 6 * u, 3 * u); width: 1.1; color: mint; opacity: 70% }
            }
        
            text "SYS C4F1·0A9E" { at: cydcr - 16 * u, cydcb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 2), 3) == 0, 85%, 0) }
            text "SYS 18B7·D620" { at: cydcr - 16 * u, cydcb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 2), 3) == 1, 85%, 0) }
            text "SYS 9E05·4CF3" { at: cydcr - 16 * u, cydcb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 2), 3) == 2, 85%, 0) }
            box { at: cydcr - 10 * u, cydcb - 9 * u; size: 5 * u, 10 * u; color: minthi; opacity: cy_on * if(mod(time * 1.7, 1) < 0.5, 90%, 0) }
        }
        group {
            show: cy_k > 0.01 and ds0 > 0.9
            opacity: cy_k * clamp(ds0 * 3 - 2, 0, 1)
            let cydsl = ds.ex - ds.ew / 2
            let cydsr = ds.ex + ds.ew / 2
            let cydst = ds.ey - ds.eh / 2
            let cydsb = min(ds.ey + ds.eh / 2, vb - lf.t - 1)
            shader matrix { at: cydsl, cydst; size: cydsr - cydsl, cydsb - cydst; corner: 24 * u; values: 0.28, 1; colors: mint, minthi }
            repeat cydsc in 0..4 {
                let cydsx = if(mod(cydsc, 2) == 0, cydsl - 7 * u, cydsr + 7 * u)
                let cydsy = if(cydsc < 2, cydst - 7 * u, cydsb + 7 * u)
                let cydssx = if(mod(cydsc, 2) == 0, -1, 1)
                let cydssy = if(cydsc < 2, -1, 1)
                path { at: cydsx, cydsy; stroke: 5 * u; color: mint; opacity: 16%; move 0, -cydssy * 15 * u; line 0, 0; line -cydssx * 15 * u, 0 }
                path { at: cydsx, cydsy; stroke: 1.7; color: minthi; move 0, -cydssy * 15 * u; line 0, 0; line -cydssx * 15 * u, 0 }
            }
            repeat cydsk in 0..13 {
                line { from: cydsl + 22 + cydsk * 6 * u, cydsb + 7 * u + 1; to: cydsl + 22 + cydsk * 6 * u, cydsb + 7 * u + 1 + if(mod(cydsk, 4) == 0, 6 * u, 3 * u); width: 1.1; color: mint; opacity: 70% }
            }
        
            text "SYS 7F3A·9C21" { at: cydsr - 16 * u, cydsb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 3), 3) == 0, 85%, 0) }
            text "SYS A1E4·03BD" { at: cydsr - 16 * u, cydsb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 3), 3) == 1, 85%, 0) }
            text "SYS 5C90·E7F2" { at: cydsr - 16 * u, cydsb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 3), 3) == 2, 85%, 0) }
            box { at: cydsr - 10 * u, cydsb - 9 * u; size: 5 * u, 10 * u; color: minthi; opacity: cy_on * if(mod(time * 1.7, 1) < 0.5, 90%, 0) }
        }
        group {
            show: cy_k > 0.01 and dl0 > 0.9
            opacity: cy_k * clamp(dl0 * 3 - 2, 0, 1)
            let cydll = dl.ex - dl.ew / 2
            let cydlr = dl.ex + dl.ew / 2
            let cydlt = dl.ey - dl.eh / 2
            let cydlb = min(dl.ey + dl.eh / 2, vb - lf.t - 1)
            shader matrix { at: cydll, cydlt; size: cydlr - cydll, cydlb - cydlt; corner: 24 * u; values: 0.28, 1; colors: mint, minthi }
            repeat cydlc in 0..4 {
                let cydlx = if(mod(cydlc, 2) == 0, cydll - 7 * u, cydlr + 7 * u)
                let cydly = if(cydlc < 2, cydlt - 7 * u, cydlb + 7 * u)
                let cydlsx = if(mod(cydlc, 2) == 0, -1, 1)
                let cydlsy = if(cydlc < 2, -1, 1)
                path { at: cydlx, cydly; stroke: 5 * u; color: mint; opacity: 16%; move 0, -cydlsy * 15 * u; line 0, 0; line -cydlsx * 15 * u, 0 }
                path { at: cydlx, cydly; stroke: 1.7; color: minthi; move 0, -cydlsy * 15 * u; line 0, 0; line -cydlsx * 15 * u, 0 }
            }
            repeat cydlk in 0..13 {
                line { from: cydll + 22 + cydlk * 6 * u, cydlb + 7 * u + 1; to: cydll + 22 + cydlk * 6 * u, cydlb + 7 * u + 1 + if(mod(cydlk, 4) == 0, 6 * u, 3 * u); width: 1.1; color: mint; opacity: 70% }
            }
        
            text "SYS 2B6D·F418" { at: cydlr - 16 * u, cydlb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 4), 3) == 0, 85%, 0) }
            text "SYS E90C·57A3" { at: cydlr - 16 * u, cydlb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 4), 3) == 1, 85%, 0) }
            text "SYS 30D8·B166" { at: cydlr - 16 * u, cydlb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 4), 3) == 2, 85%, 0) }
            box { at: cydlr - 10 * u, cydlb - 9 * u; size: 5 * u, 10 * u; color: minthi; opacity: cy_on * if(mod(time * 1.7, 1) < 0.5, 90%, 0) }
        }
        group {
            show: cy_k > 0.01 and dm0 > 0.9
            opacity: cy_k * clamp(dm0 * 3 - 2, 0, 1)
            let cydml = dm.ex - dm.ew / 2
            let cydmr = dm.ex + dm.ew / 2
            let cydmt = dm.ey - dm.eh / 2
            let cydmb = min(dm.ey + dm.eh / 2, vb - lf.t - 1)
            shader matrix { at: cydml, cydmt; size: cydmr - cydml, cydmb - cydmt; corner: 24 * u; values: 0.28, 1; colors: mint, minthi }
            repeat cydmc in 0..4 {
                let cydmx = if(mod(cydmc, 2) == 0, cydml - 7 * u, cydmr + 7 * u)
                let cydmy = if(cydmc < 2, cydmt - 7 * u, cydmb + 7 * u)
                let cydmsx = if(mod(cydmc, 2) == 0, -1, 1)
                let cydmsy = if(cydmc < 2, -1, 1)
                path { at: cydmx, cydmy; stroke: 5 * u; color: mint; opacity: 16%; move 0, -cydmsy * 15 * u; line 0, 0; line -cydmsx * 15 * u, 0 }
                path { at: cydmx, cydmy; stroke: 1.7; color: minthi; move 0, -cydmsy * 15 * u; line 0, 0; line -cydmsx * 15 * u, 0 }
            }
            repeat cydmk in 0..13 {
                line { from: cydml + 22 + cydmk * 6 * u, cydmb + 7 * u + 1; to: cydml + 22 + cydmk * 6 * u, cydmb + 7 * u + 1 + if(mod(cydmk, 4) == 0, 6 * u, 3 * u); width: 1.1; color: mint; opacity: 70% }
            }
        
            text "SYS C4F1·0A9E" { at: cydmr - 16 * u, cydmb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 5), 3) == 0, 85%, 0) }
            text "SYS 18B7·D620" { at: cydmr - 16 * u, cydmb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 5), 3) == 1, 85%, 0) }
            text "SYS 9E05·4CF3" { at: cydmr - 16 * u, cydmb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 5), 3) == 2, 85%, 0) }
            box { at: cydmr - 10 * u, cydmb - 9 * u; size: 5 * u, 10 * u; color: minthi; opacity: cy_on * if(mod(time * 1.7, 1) < 0.5, 90%, 0) }
        }
        group {
            show: cy_k > 0.01 and dz0 > 0.9
            opacity: cy_k * clamp(dz0 * 3 - 2, 0, 1)
            //  The glass the Desk's body is drawn as (`dz.f*`, as `box zdrawer` has it), not the rectangle it would have along the top (`dz.s*`): in the frame
            //  layout the two differ by a few pixels, and the corner lines stood off the glass unevenly.
            let cydzl = dz.fl
            let cydzr = dz.fr
            let cydzt = dz.ft
            let cydzb = min(dz.fb, vb - lf.t - 1)
            shader matrix { at: cydzl, cydzt; size: cydzr - cydzl, cydzb - cydzt; corner: 24 * u; values: 0.28, 1; colors: mint, minthi }
            repeat cydzc in 0..4 {
                let cydzx = if(mod(cydzc, 2) == 0, cydzl - 7 * u, cydzr + 7 * u)
                let cydzy = if(cydzc < 2, cydzt - 7 * u, cydzb + 7 * u)
                let cydzsx = if(mod(cydzc, 2) == 0, -1, 1)
                let cydzsy = if(cydzc < 2, -1, 1)
                path { at: cydzx, cydzy; stroke: 5 * u; color: mint; opacity: 16%; move 0, -cydzsy * 15 * u; line 0, 0; line -cydzsx * 15 * u, 0 }
                path { at: cydzx, cydzy; stroke: 1.7; color: minthi; move 0, -cydzsy * 15 * u; line 0, 0; line -cydzsx * 15 * u, 0 }
            }
            repeat cydzk in 0..13 {
                line { from: cydzl + 22 + cydzk * 6 * u, cydzb + 7 * u + 1; to: cydzl + 22 + cydzk * 6 * u, cydzb + 7 * u + 1 + if(mod(cydzk, 4) == 0, 6 * u, 3 * u); width: 1.1; color: mint; opacity: 70% }
            }
        
            text "SYS 7F3A·9C21" { at: cydzr - 16 * u, cydzb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 6), 3) == 0, 85%, 0) }
            text "SYS A1E4·03BD" { at: cydzr - 16 * u, cydzb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 6), 3) == 1, 85%, 0) }
            text "SYS 5C90·E7F2" { at: cydzr - 16 * u, cydzb - 9 * u; anchor: right center; size: 10; weight: 500; color: minthi; family: "SpaceMono Nerd Font"; opacity: cy_on * if(mod(floor(time * 7 + 6), 3) == 2, 85%, 0) }
            box { at: cydzr - 10 * u, cydzb - 9 * u; size: 5 * u, 10 * u; color: minthi; opacity: cy_on * if(mod(time * 1.7, 1) < 0.5, 90%, 0) }
        }
        //  The UwU theme's graphics, on every drawer that is out (and round the screen, below): cat ears on its top corners, three twinkling stars along its
        //  top, two hearts that bob and a trail of paw prints in its bottom corners, and sparkles rising from the hearts. The ears are the only part outside
        //  the drawer; the rest sits in its margin and never touches what it holds. Each sticker has a grape outline, as the drawers have.
        group {
            show: uwu_k > 0.01 and dk0 > 0.9
            opacity: uwu_k * clamp(dk0 * 3 - 2, 0, 1)
            let wdk.l = dk.ex - dk.ew / 2
            let wdk.r = dk.ex + dk.ew / 2
            let wdk.t = dk.ey - dk.eh / 2
            let wdk.b = min(dk.ey + dk.eh / 2, vb - lf.t - 1)
            let wdk.m = (dk.ex)
            repeat side in 0..2 {
                let ex = if(side == 0, wdk.l + 50 * u, wdk.r - 50 * u)
                let sg = if(side == 0, -1, 1)
                path { at: ex, wdk.t; color: obsidian; move -23 * u, 8; line sg * 13 * u, -30 * u; line 23 * u, 8; close }
                path { at: ex, wdk.t; stroke: 3 * u; color: deep; move -23 * u, 8; line sg * 13 * u, -30 * u; line 23 * u, 8 }
                path { at: ex, wdk.t; color: #ff8fc8; move -14 * u, 5; line sg * 9 * u, -19 * u; line 14 * u, 5; close }
            }
            //  Whiskers: three on each side of the drawer, fanning out of its edges at the bottom corners.
            repeat wk in 0..6 {
                let wks = if(wk < 3, -1, 1)
                let wkx = if(wk < 3, wdk.l, wdk.r)
                let wky = wdk.b - 20 * u + (mod(wk, 3) - 1) * 7 * u
                line { from: wkx - wks * 6 * u, wky; to: wkx + wks * 26 * u, wky + (mod(wk, 3) - 1) * 6 * u; width: 4; color: deep }
                line { from: wkx - wks * 6 * u, wky; to: wkx + wks * 26 * u, wky + (mod(wk, 3) - 1) * 6 * u; width: 1.8; color: #ffffff }
            }
            repeat s in 0..3 {
                let sx = wdk.m + (s - 1) * 44 * u
                let sr = if(s == 1, 7, 5) * u
                group { scale: 1 + 0.22 * sin(time * 160 + s * 120); pivot: sx, wdk.t + 9
                    path { at: sx, wdk.t + 9; stroke: 3; color: deep; move 0, -sr; line 0.3 * sr, -0.3 * sr; line sr, 0; line 0.3 * sr, 0.3 * sr; line 0, sr; line -0.3 * sr, 0.3 * sr; line -sr, 0; line -0.3 * sr, -0.3 * sr; close }
                    path { at: sx, wdk.t + 9; color: pick(s, #ffe27a, #ffffff, #7fd3ff); move 0, -sr; line 0.3 * sr, -0.3 * sr; line sr, 0; line 0.3 * sr, 0.3 * sr; line 0, sr; line -0.3 * sr, 0.3 * sr; line -sr, 0; line -0.3 * sr, -0.3 * sr; close }
                }
            }
            repeat hh in 0..2 {
                let hx = wdk.l + (22 + hh * 22) * u
                let hy = wdk.b - 11
                let hr = if(hh == 0, 5.5, 4.5) * u
                group { scale: 1 + 0.13 * sin(time * 200 + hh * 150); pivot: hx, hy
                    ellipse { at: hx - 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62 + 1.5; color: deep }
                    ellipse { at: hx + 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62 + 1.5; color: deep }
                    path { at: hx, hy; stroke: 3; color: deep; move -1.12 * hr, -0.1 * hr; line 0, 1.2 * hr; line 1.12 * hr, -0.1 * hr; close }
                    ellipse { at: hx - 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62; color: pick(hh, #ff6eb4, #b69cff) }
                    ellipse { at: hx + 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62; color: pick(hh, #ff6eb4, #b69cff) }
                    path { at: hx, hy; color: pick(hh, #ff6eb4, #b69cff); move -1.1 * hr, -0.1 * hr; line 0, 1.15 * hr; line 1.1 * hr, -0.1 * hr; close }
                    ellipse { at: hx - 0.7 * hr, hy - 0.5 * hr; radius: hr * 0.2; color: #ffffff; opacity: 80% }
                }
            }
            repeat pw in 0..3 {
                let px = wdk.r - (26 + pw * 28) * u
                let py = wdk.b - 12 + if(mod(pw, 2) == 0, 0, -3)
                ellipse { at: px, py + 2.4; radius: 6; color: deep }
                ellipse { at: px - 6.4, py - 3.2; radius: 3.4; color: deep }
                ellipse { at: px - 2.4, py - 7.6; radius: 3.4; color: deep }
                ellipse { at: px + 2.4, py - 7.6; radius: 3.4; color: deep }
