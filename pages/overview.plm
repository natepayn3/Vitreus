part Overview {
    //  ── the workspace overview ────────────────────────────────────────────────────────────────────────────────────────────────
    //  Five glass cards in the middle of the screen (in a row, or wrapped on a narrow one), one for each workspace: its number, how many windows it has, and a 16:9
    //  screen on which its windows lie in a grid that grows with their number (one fills it, two sit side by side, up to nine in three by three),
    //  a picture of each. A window
    //  is clicked to go to it, or dragged onto another workspace to move it there; anywhere else on a column goes to the workspace.
    //  The logic fills `ovw`, nine slots a column.
    group {
        show: ov_show > 0.01
        opacity: ov_show
        //  How it fits this screen: five cards in a row if they can be drawn at 85% of their size or more, else three and two,
        //  two by two by one, or one under another (five rows), and whichever it is, scaled (up to a quarter larger than the rest of
        //  the shell) so that it fits with room to spare.
        let ovl.sw = screen.width - 48
        let ovl.sh = vh - 170
        let ovl.k5 = min(1.25, min(ovl.sw / (1506 * u), ovl.sh / (208 * u)))
        let ovl.k3 = min(1.25, min(ovl.sw / (898 * u), ovl.sh / (432 * u)))
        let ovl.k2 = min(1.25, min(ovl.sw / (594 * u), ovl.sh / (656 * u)))
        let ovl.k1 = min(1.25, min(ovl.sw / (290 * u), ovl.sh / (1104 * u)))
        let ovl.nc = if(ovl.k5 >= 0.85, 5, if(ovl.k3 >= 0.85, 3, if(ovl.k2 >= 0.85, 2, 1)))
        let ovl.k = if(ovl.nc == 5, ovl.k5, if(ovl.nc == 3, ovl.k3, if(ovl.nc == 2, ovl.k2, ovl.k1)))
        let ovl.rows = if(ovl.nc == 5, 1, if(ovl.nc == 3, 2, if(ovl.nc == 2, 3, 5)))
        let ovu = u * ovl.k
        let ovl.w = ((ovl.nc - 1) * 304 + 290) * ovu
        let ovl.h = (ovl.rows * 224 - 16) * ovu
        let ovl.cy = floor(yo + vh / 2 + 12 * ovu * (1 - ov_show) + 0.5)
        let ovl.l = floor(cx - ovl.w / 2 + 0.5)
        let ovl.t = floor(ovl.cy - ovl.h / 2 + 0.5)
        let ovl.moving = if(ov_drag >= 0 and length(ov_dx, ov_dy) > 8, 1, 0)
        //  The card under the pointer (-1 when it is off them all), for a drop.
        let ovm.x = ov_px + ov_dx                    // where the mouse is while a window is carried (no `cursor`: see `ctl_btn_z`)
        let ovm.y = ov_py + ov_dy
        let ovl.inside = if(ovm.x > ovl.l and ovm.x < ovl.l + ovl.w and ovm.y > ovl.t and ovm.y < ovl.t + ovl.h, 1, 0)
        let ovl.col = if(ovl.inside > 0, clamp(floor((ovm.y - ovl.t) / (224 * ovu)), 0, ovl.rows - 1) * ovl.nc + clamp(floor((ovm.x - ovl.l) / (304 * ovu)), 0, ovl.nc - 1), -1)
        repeat c in 0..5 {
            let ovc.row = floor(c / ovl.nc)
            let ovc.x = floor(ovl.l + (145 + (c - ovc.row * ovl.nc) * 304) * ovu + 0.5)
            let ovc.top = ovl.t + ovc.row * 224 * ovu
            let ovc.act = if(ws.active == c + 1, 1, 0)
            let ovc.drop = if(ovl.moving > 0 and ovl.col == c, 1, 0)
            zone box ov_hz.$c { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu * (1 - 0.73 * cy_k); cursor: pointer; active: ov_show > 0.5 }
            on press ov_hz.$c { ov_open = false; emit ov_go(c + 1) }
            body {
                color: mix(mix(tint, #000000, cy_dark * cy_k), #000000, 0.7 * glass_smoke)
                glass: 100%
                opacity: glass_op * (1 - obs)
                lens: glass_bend
                refraction: glass_refr
                dispersion: glass_disp
                dome: glass_dome
                milk: glass_milk
                smoke: glass_smoke
                tint: 22% + 45% * glass_smoke          // smoke: more of its own colour, darkened below, so it reads at the bar too
                rim: 14% * glass_rim
                shadow: 0, 14 * ovu, 36 * ovu, 45%, deep
                show: obs < 0.996
                box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu * (1 - 0.73 * cy_k) }
            }
            //  Blur behind the obsidian: a glass body asks the compositor for it (100 % glass at 34 %: the request needs glass x opacity of 30 % or more, and a more opaque layer would hide the blur), and the obsidian over it (60 % opaque while blur is on, solid when it is off) hides the glass's look.
            body {
                color: obsidian
                glass: 100%
                lens: false
                rim: 0%
                refraction: 0%
                dispersion: 0%
                shine: 9000, 9000
                opacity: obs * 0.34 * (1 - pk)
                show: obs > 0.97
                box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu * (1 - 0.73 * cy_k) }
            }
            body {
                color: obsidian
                rim: 0%
                opacity: obs * (1 - 0.4 * clamp(hy_blur, 0, 1))
                shadow: 0, 14 * ovu, 42 * ovu, (55%) * (1 - pk), #000000
                show: obs > 0.004
                box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu * (1 - 0.73 * cy_k) }
            }
            //  The Cassette's plastic over it (see `cas_k`): a lit lip, a dark outline, a hard shadow.
            body {
                color: obsidian
                rim: 40% * cas_k
                border: 1.7 * u * cas_k, deep
                shadow: 4.5 * u * cas_k, 5.5 * u * cas_k, 0, 55% * cas_k, deep
                opacity: cas_k
                show: cas_k > 0.004
                box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu * (1 - 0.73 * cy_k) }
            }
            //  The UwU's candy plastic over it: a pastel gradient across the whole screen (pink, lilac, sky, mint), a thick grape outline, a lit lip and a hard pink shadow.
            body {
                gradient: 0, 0 to screen.width, screen.height, #ffb3dc, #cfc4ff 38%, #aab4ff 68%, #ffd0ea
                rim: 55% * uwu_k
                border: 3 * u * uwu_k, deep
                shadow: 4 * u * uwu_k, 5 * u * uwu_k, 0, 90% * uwu_k, mix(deep, #ff6ec7, 0.75)
                opacity: uwu_k
                show: uwu_k > 0.004
                box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu * (1 - 0.73 * cy_k) }
            }
            //  The other solid themes, as their drawers are (bar_glass.plm). Milk: two layers of the pale material, a white light up and to the left, a soft shade down and to the right.
            body {
                color: obsidian
                rim: 0%
                shadow: -3 * u * milk_k, -3 * u * milk_k, 8 * u * milk_k, 38% * milk_k, #ffffff
                opacity: milk_k
                show: milk_k > 0.004
                box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu * (1 - 0.73 * cy_k) }
            }
            body {
                color: obsidian
                rim: 0%
                shadow: 3 * u * milk_k, 4 * u * milk_k, 10 * u * milk_k, 28% * milk_k, deep
                opacity: milk_k
                show: milk_k > 0.004
                box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu * (1 - 0.73 * cy_k) }
            }
            //  Proxy: a flat near-black plate, a thin pale outline and a hard offset edge.
            body {
                color: obsidian
                rim: 0%
                border: 1.4 * u * px_k, mix(#e8f1f5, obsidian, 0.4)
                shadow: 2.5 * u * px_k, 3 * u * px_k, 0, 85% * px_k, deep
                opacity: px_k
                show: px_k > 0.004
                box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu * (1 - 0.73 * cy_k) }
            }
            //  Paper: a cream sheet with a worn brownish edge and a soft shadow under it.
            body {
                color: obsidian
                rim: 0%
                border: 1.2 * u * pp_k, mix(deep, obsidian, 0.55)
                shadow: 1.5 * u * pp_k, 3.5 * u * pp_k, 9 * u * pp_k, 42% * pp_k, deep
                opacity: pp_k
                show: pp_k > 0.004
                box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu * (1 - 0.73 * cy_k) }
            }
            //  Doodle: a card drawn by hand (DdCard, in vitreus.plm).
            DdCard(ovc.x, ovc.top + 104 * ovu, 290 * ovu, 208 * ovu, 311.5, obsidian, dd_k, u) { show: dd_k > 0.004 }
            //  The Cyber's HUD over each card, as on its drawers (bar_glass.plm): a neon hairline outline and bright corner brackets, outside the glass.
            group {
                show: cy_k > 0.01
                opacity: cy_k
                shader matrix { at: ovc.x - 145 * ovu, ovc.top; size: 290 * ovu, 208 * ovu; corner: 18 * ovu * (1 - 0.73 * cy_k); values: 0.28, 1; colors: mint, minthi }
                repeat ovbc in 0..4 {
                    let ovbx = if(mod(ovbc, 2) == 0, ovc.x - 145 * ovu - 6 * ovu, ovc.x + 145 * ovu + 6 * ovu)
                    let ovby = if(ovbc < 2, ovc.top - 6 * ovu, ovc.top + 208 * ovu + 6 * ovu)
                    let ovbsx = if(mod(ovbc, 2) == 0, -1, 1)
                    let ovbsy = if(ovbc < 2, -1, 1)
                    path { at: ovbx, ovby; stroke: 4 * ovu; color: mint; opacity: 16%; move 0, -ovbsy * 12 * ovu; line 0, 0; line -ovbsx * 12 * ovu, 0 }
                    path { at: ovbx, ovby; stroke: 1.5; color: minthi; move 0, -ovbsy * 12 * ovu; line 0, 0; line -ovbsx * 12 * ovu, 0 }
                }
            }
            box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu * (1 - 0.73 * cy_k); color: mix(ink, mint, max(ovc.act, ovc.drop)); opacity: 6% + 9% * ovc.act + 14% * ovc.drop + 4% * ov_hz.$c.hover }
            box { at: ovc.x, ovc.top + 104 * ovu; size: 290 * ovu, 208 * ovu; corner: 18 * ovu * (1 - 0.73 * cy_k); stroke: 1.4 * ovu; color: mint; opacity: max(50% * ovc.act, 90% * ovc.drop) }
            //  The 16:9 screen the windows lie on.
            box { at: ovc.x, ovc.top + 120 * ovu; size: 270 * ovu, 152 * ovu; corner: 10 * ovu * (1 - 0.73 * cy_k); color: deep; opacity: 38% }
            text number(c + 1, 0, "") { at: floor(ovc.x - 128 * ovu + 0.5), floor(ovc.top + 22 * ovu + 0.5); anchor: left center; size: 22; weight: 700; color: mix(ink, mint, ovc.act); family: "Space Grotesk" }
            text number(ov_cnt.$c, 0, " windows") { at: floor(ovc.x + 130 * ovu + 0.5), floor(ovc.top + 22 * ovu + 0.5); anchor: right center; align: right; size: 10.5; width: 110 * ovu; lines: 1; color: faint; family: "Space Grotesk"; show: ov_cnt.$c != 1 }
            text "1 window" { at: floor(ovc.x + 130 * ovu + 0.5), floor(ovc.top + 22 * ovu + 0.5); anchor: right center; align: right; size: 10.5; width: 110 * ovu; lines: 1; color: faint; family: "Space Grotesk"; show: ov_cnt.$c == 1 }
            text "Nothing here" { at: floor(ovc.x + 0.5), floor(ovc.top + 120 * ovu + 0.5); anchor: center; align: center; size: 11.5; color: faint; opacity: 70%; family: "Space Grotesk"; show: ov_cnt.$c < 1 }
        }
        repeat n in 0..45 {
            let ovr.c = ovw.$n.ws
            let ovr.row = floor(ovr.c / ovl.nc)
            let ovr.col = ovr.c - ovr.row * ovl.nc
            //  The cell this window has in its workspace's grid (the logic says how big the grid is, and which cell), and the
            //  16:9 picture that fits it, in the middle of the cell.
            let ovr.pad = if(ovw.$n.gc == 1, 0, 5 * ovu)
            //  `max(1, …)`: an empty slot has a grid of 0 by 0, and dividing by it made the size NaN; a NaN is never equal to itself, so the
            //  scene thought it was always changing and worked itself out sixty times a second for nothing, with the overview shut.
            let ovr.cw = (270 * ovu - 2 * ovr.pad - (ovw.$n.gc - 1) * 5 * ovu) / max(1, ovw.$n.gc)
            let ovr.ch = (152 * ovu - 2 * ovr.pad - (ovw.$n.gr - 1) * 5 * ovu) / max(1, ovw.$n.gr)
            let ovr.tw = floor(min(ovr.cw, ovr.ch * 16 / 9) + 0.5)
            let ovr.th = floor(ovr.tw * 9 / 16 + 0.5)
            let ovr.x = floor(ovl.l + (10 + ovr.col * 304) * ovu + ovr.pad + ovw.$n.gx * (ovr.cw + 5 * ovu) + ovr.cw / 2 + 0.5)
            let ovr.y = floor(ovl.t + (44 + ovr.row * 224) * ovu + ovr.pad + ovw.$n.gy * (ovr.ch + 5 * ovu) + ovr.ch / 2 + 0.5)
            let ovr.on = n < ovw.count and ovw.$n.used
            let ovr.lift = if(ov_drag == n and ovl.moving > 0, 0.35, 1)
            group {
                show: ovr.on
                opacity: ovr.lift
                body {
                    color: deep
                    opacity: 40%
                    shadow: 0, 2 * ovu, 8 * ovu, 50%, #000000
                    box { at: ovr.x, ovr.y; size: ovr.tw, ovr.th; corner: 6 * ovu * (1 - 0.73 * cy_k) }
                }
                group {
                    clip box { at: ovr.x, ovr.y; size: ovr.tw, ovr.th; corner: 6 * ovu * (1 - 0.73 * cy_k) }
                    image wthumbs.$n.picture { at: ovr.x - ovr.tw / 2, ovr.y - ovr.th / 2; size: ovr.tw, ovr.th; opacity: if(wthumbs.$n.stale, 70%, 100%); show: ovw.$n.snap }
                    //  No picture taken yet: the app's icon.
                    image ovw.$n.icon { at: floor(ovr.x - 11 * ovu + 0.5), floor(ovr.y - 11 * ovu + 0.5); size: floor(22 * ovu + 0.5), floor(22 * ovu + 0.5); show: not ovw.$n.snap and ovr.tw > 100 * ovu }
                    box { at: ovr.x, ovr.y; size: ovr.tw, ovr.th; color: ink; opacity: 10% * ov_rz.$n.hover }
                }
                box { at: ovr.x, ovr.y; size: ovr.tw, ovr.th; corner: 6 * ovu * (1 - 0.73 * cy_k); stroke: if(ovw.$n.active, 2 * ovu, 1.2 * ovu); color: if(ovw.$n.active, mint, mix(ink, mint, cy_k)); opacity: if(ovw.$n.active, 100%, 16% + 34% * ov_rz.$n.hover + 24% * cy_k) }
            }
            zone box ov_rz.$n { at: ovr.x, ovr.y; size: ovr.tw, ovr.th; corner: 6 * ovu * (1 - 0.73 * cy_k); cursor: pointer; active: ovr.on and ov_show > 0.5 }
            on enter ov_rz.$n { ov_hot = n; ov_hotc = ovw.$n.ws }
            on away ov_rz.$n for 80ms while ov_hot == n { ov_hot = -1 }
            on press ov_rz.$n { ov_drag = n; ov_dx = 0; ov_dy = 0; ov_px = pointer.x; ov_py = pointer.y }
            on drag ov_rz.$n { ov_dx = drag.dx; ov_dy = drag.dy }
            //  Let go hardly moved: it was a click. Let go far away: it was dropped, on the column under the pointer.
            on release ov_rz.$n while length(ov_dx, ov_dy) < 8 { emit ov_focus(n); ov_open = false }
            on release ov_rz.$n while length(ov_dx, ov_dy) >= 8 { ov_col = ovl.col; emit ov_move(n) }
            on release ov_rz.$n { ov_drag = -1; ov_dx = 0; ov_dy = 0 }
        }
        //  The name of the window under the pointer, or of the one in use, in the header between the number and the count (cut
        //  with an ellipsis where it is too long).
        repeat n in 0..45 {
            let ovt.c = ovw.$n.ws
            let ovt.row = floor(ovt.c / ovl.nc)
            let ovt.x = floor(ovl.l + (145 + (ovt.c - ovt.row * ovl.nc) * 304 - 96) * ovu + 0.5)
            let ovt.y = floor(ovl.t + (22 + ovt.row * 224) * ovu + 0.5)
            let ovt.on = n < ovw.count and ovw.$n.used and ovl.moving < 1
            text ovw.$n.title { at: ovt.x, ovt.y; anchor: left center; size: 11.5; width: 156 * ovu; lines: 1; color: ink; family: "Space Grotesk"; show: ovt.on and (ov_hot == n or (ov_hotc != ovt.c and ovw.$n.active)) }
        }
        //  The window being carried: a card following the pointer, over everything.
        repeat n in 0..45 {
            let ovg.tw = floor(180 * ovu + 0.5)
            let ovg.th = floor(101 * ovu + 0.5)
            group {
                show: ov_drag == n and ovl.moving > 0
                opacity: 94%
                body {
                    color: deep
                    opacity: 40%
                    shadow: 0, 12 * ovu, 26 * ovu, 70%, #000000
                    box { at: ovm.x, ovm.y; size: ovg.tw, ovg.th; corner: 9 * ovu * (1 - 0.73 * cy_k) }
                }
                group {
                    clip box { at: ovm.x, ovm.y; size: ovg.tw, ovg.th; corner: 9 * ovu * (1 - 0.73 * cy_k) }
                    image wthumbs.$n.picture { at: ovm.x - ovg.tw / 2, ovm.y - ovg.th / 2; size: ovg.tw, ovg.th; show: ovw.$n.snap }
                    image ovw.$n.icon { at: floor(ovm.x - 11 * ovu + 0.5), floor(ovm.y - 11 * ovu + 0.5); size: floor(22 * ovu + 0.5), floor(22 * ovu + 0.5); show: not ovw.$n.snap }
                    box { at: ovm.x, ovm.y + ovg.th / 2 - 12 * ovu; size: ovg.tw, 24 * ovu; color: card; opacity: 85% }
                    text ovw.$n.title { at: floor(ovm.x - ovg.tw / 2 + 10 * ovu + 0.5), floor(ovm.y + ovg.th / 2 - 12 * ovu + 0.5); anchor: left center; size: 10.5; width: ovg.tw - 20 * ovu; lines: 1; color: ink; family: "Space Grotesk" }
                }
                box { at: ovm.x, ovm.y; size: ovg.tw, ovg.th; corner: 9 * ovu * (1 - 0.73 * cy_k); stroke: 2 * ovu; color: mint }
            }
        }
    }
}
