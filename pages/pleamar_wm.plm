part PleamarWm {
        //  The Pleamar-WM page: layout, gaps and effects (live, kept in wm.json) and the input lines of session.conf (next login).
        group {
            show: set_pgw > 0.01
            opacity: set_pgw
            let wm.sc = clamp(wm_scroll, 0, max(0, wm.h - set.h))
            let wm.off = floor(wm.sc * pu + 0.5)        // whole pixels: text shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pu, sby + set.h / 2 * pu; size: 456 * pu, set.h * pu }
            zone box wm_wheel { at: spx + 219 * pu, sby + set.h / 2 * pu; size: 446 * pu, set.h * pu }
            on scroll wm_wheel { wm_scroll_to = clamp(wm_scroll_to - wheel * 44, 0, max(0, wm.h - set.h)) }
            group {
            move: 0, -wm.off
            let wsl.x0 = spx + 122 * pu
            let wsl.w = 250 * pu
            let wh = 12 * pu

            box { at: spx + 219 * pu, sby + 94 * pu; size: 438 * pu, 188 * pu; corner: 14 * pu; color: ink; opacity: veil }
            box { at: spx + 219 * pu, sby + 247 * pu; size: 438 * pu, 62 * pu; corner: 14 * pu; color: ink; opacity: veil }
            box { at: spx + 219 * pu, sby + 378 * pu; size: 438 * pu, 156 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "LAYOUT & WINDOWS" { at: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text "EFFECTS" { at: floor(spx + 14 * pu + 0.5), floor(sby + 204 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            text "INPUT  ·  NEXT LOGIN" { at: floor(spx + 14 * pu + 0.5), floor(sby + 290 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }

            //  Layout: where the windows of a monitor go.
            text "Layout" { at: floor(spx + 14 * pu + 0.5), floor(sby + 42 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            repeat i in 0..5 {
                let lx = spx + 164 * pu + mod(i, 3) * 90 * pu
                let ly = sby + (42 + floor(i / 3) * 28) * pu
                box { at: lx, ly; size: 84 * pu, 24 * pu; corner: 12 * pu; color: if(wm_layout == i, mint, ink); opacity: if(wm_layout == i, 24%, 8% + 10% * wm_lay_hit.$i.hover) }
                text pick(i, "Lead left", "Columns", "Rows", "Grid", "Lead right") { at: floor(lx + 0.5), floor(ly + 0.5); anchor: center; align: center; size: 14; weight: 600; width: 80 * pu; lines: 1; color: if(wm_layout == i, mint, ink); family: "Space Grotesk" }
                zone box wm_lay_hit.$i { at: lx, ly; size: 86 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (ly) - sby - wm.off > 0 and (ly) - sby - wm.off < set.h * pu }
                on press wm_lay_hit.$i { emit wm_layout_set(i) }
            }

            //  The leader's share of the width, 30 to 80 %.
            text "Leader width" { at: floor(spx + 14 * pu + 0.5), floor(sby + 104 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            body { color: deep; rim: 9%; box { at: wsl.x0 + wsl.w / 2, sby + 104 * pu; size: wsl.w, wh; corner: wh / 2 } }
            group {
                glow: 6 * pu, 50%, mint
                body {
                    gradient: wsl.x0, 0 to wsl.x0 + wsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: wsl.x0, sby + 104 * pu - wh / 2; size: max(0.1, wsl.w * (wm_share - 0.3) / 0.5), wh; corner: wh / 2 }
                }
            }
            text wm_share_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 104 * pu + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
            zone box wm_share_hit { at: wsl.x0 + wsl.w / 2, sby + 104 * pu; size: wsl.w + 24 * pu, 30 * pu; cursor: pointer; active: (sby + 104 * pu) - sby - wm.off > 0 and (sby + 104 * pu) - sby - wm.off < set.h * pu }
            on press wm_share_hit { emit wm_share_set(clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }
            on drag wm_share_hit { emit wm_share_set(clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }

            //  Gaps between windows, 0 to 32 px.
            text "Gaps" { at: floor(spx + 14 * pu + 0.5), floor(sby + 136 * pu + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
            body { color: deep; rim: 9%; box { at: wsl.x0 + wsl.w / 2, sby + 136 * pu; size: wsl.w, wh; corner: wh / 2 } }
            group {
                glow: 6 * pu, 50%, mint
                body {
                    gradient: wsl.x0, 0 to wsl.x0 + wsl.w, 0, mintlo, mint 55%, minthi
                    rim: 22%
                    box { from: wsl.x0, sby + 136 * pu - wh / 2; size: max(0.1, wsl.w * wm_gap / 32), wh; corner: wh / 2 }
                }
            }
            text wm_gap_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 136 * pu + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
            zone box wm_gap_hit { at: wsl.x0 + wsl.w / 2, sby + 136 * pu; size: wsl.w + 24 * pu, 30 * pu; cursor: pointer; active: (sby + 136 * pu) - sby - wm.off > 0 and (sby + 136 * pu) - sby - wm.off < set.h * pu }
            on press wm_gap_hit { emit wm_gap_set(clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }
            on drag wm_gap_hit { emit wm_gap_set(clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }

            //  Free-floating windows, as on Windows or KDE.
            text "Free-floating windows" { at: floor(spx + 14 * pu + 0.5), floor(sby + 170 * pu + 0.5); anchor: left center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk" }
            body {
                color: mix(off, mint, clamp(wm_k0, 0, 1))
                box { at: spx + 405 * pu, sby + 170 * pu; size: 38 * pu, 22 * pu; corner: 11 * pu }
            }
            box { at: spx + 397 * pu + wm_k0 * 16 * pu, sby + 170 * pu; size: (17 + 9 * clamp(4 * wm_k0 * (1 - wm_k0), 0, 1)) * pu, (17 - 3 * clamp(4 * wm_k0 * (1 - wm_k0), 0, 1)) * pu; corner: (8.5 - 1.5 * clamp(4 * wm_k0 * (1 - wm_k0), 0, 1)) * pu; color: ink }
            zone box wm_tg_hit.0 { at: spx + 219 * pu, sby + 170 * pu; size: 430 * pu, 28 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 170 * pu) - sby - wm.off > 0 and (sby + 170 * pu) - sby - wm.off < set.h * pu }
            on press wm_tg_hit.0 { emit wm_toggle(0) }

            //  Effects.
            repeat i in 1..3 {
                let ty = sby + (234 + (i - 1) * 30) * pu
                let tk = pick(i - 1, wm_k1, wm_k2)
                text pick(i - 1, "Rain on the glass", "Snow") { at: floor(spx + 14 * pu + 0.5), floor(ty + 0.5); anchor: left center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk" }
                body {
                    color: mix(off, mint, clamp(tk, 0, 1))
                    box { at: spx + 405 * pu, ty; size: 38 * pu, 22 * pu; corner: 11 * pu }
                }
                box { at: spx + 397 * pu + tk * 16 * pu, ty; size: (17 + 9 * clamp(4 * tk * (1 - tk), 0, 1)) * pu, (17 - 3 * clamp(4 * tk * (1 - tk), 0, 1)) * pu; corner: (8.5 - 1.5 * clamp(4 * tk * (1 - tk), 0, 1)) * pu; color: ink }
                zone box wm_tg_hit.$i { at: spx + 219 * pu, ty; size: 430 * pu, 28 * pu; corner: 10 * pu; cursor: pointer; active: (ty) - sby - wm.off > 0 and (ty) - sby - wm.off < set.h * pu }
                on press wm_tg_hit.$i { emit wm_toggle(i) }
            }

            //  Pointer speeds, -1 to 1, and the screen's idle time, 1 to 30 minutes.
            repeat i in 0..3 {
                let sy = sby + (320 + i * 30) * pu
                let sv = pick(i, (wm_ms + 1) / 2, (wm_ts + 1) / 2, (wm_idle - 1) / 29)
                text pick(i, "Mouse speed", "Touchpad speed", "Screen off after") { at: floor(spx + 14 * pu + 0.5), floor(sy + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
                body { color: deep; rim: 9%; box { at: wsl.x0 + wsl.w / 2, sy; size: wsl.w, wh; corner: wh / 2 } }
                group {
                    glow: 6 * pu, 50%, mint
                    body {
                        gradient: wsl.x0, 0 to wsl.x0 + wsl.w, 0, mintlo, mint 55%, minthi
                        rim: 22%
                        box { from: wsl.x0, sy - wh / 2; size: max(0.1, wsl.w * sv), wh; corner: wh / 2 }
                    }
                }
                text pick(i, wm_ms_text, wm_ts_text, wm_idle_text) { at: floor(spx + 424 * pu + 0.5), floor(sy + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
                zone box wm_in_hit.$i { at: wsl.x0 + wsl.w / 2, sy; size: wsl.w + 24 * pu, 30 * pu; cursor: pointer; active: (sy) - sby - wm.off > 0 and (sy) - sby - wm.off < set.h * pu }
                on press wm_in_hit.$i { emit wm_input_set(i * 10 + clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }
                on drag wm_in_hit.$i { emit wm_input_set(i * 10 + clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }
            }
            box { at: wsl.x0 + wsl.w / 2, sby + 320 * pu; size: 1.5 * pu, wh + 6 * pu; corner: 0.75 * pu; color: ink; opacity: 40% }
            box { at: wsl.x0 + wsl.w / 2, sby + 350 * pu; size: 1.5 * pu, wh + 6 * pu; corner: 0.75 * pu; color: ink; opacity: 40% }

            //  Natural scroll and tap to click, for the touchpad.
            repeat i in 3..5 {
                let ty = sby + (320 + i * 30) * pu
                let tk = pick(i - 3, wm_k3, wm_k4)
                text pick(i - 3, "Natural scroll (touchpad)", "Tap to click (touchpad)") { at: floor(spx + 14 * pu + 0.5), floor(ty + 0.5); anchor: left center; size: 15.5; weight: 600; color: ink; family: "Space Grotesk" }
                body {
                    color: mix(off, mint, clamp(tk, 0, 1))
                    box { at: spx + 405 * pu, ty; size: 38 * pu, 22 * pu; corner: 11 * pu }
                }
                box { at: spx + 397 * pu + tk * 16 * pu, ty; size: (17 + 9 * clamp(4 * tk * (1 - tk), 0, 1)) * pu, (17 - 3 * clamp(4 * tk * (1 - tk), 0, 1)) * pu; corner: (8.5 - 1.5 * clamp(4 * tk * (1 - tk), 0, 1)) * pu; color: ink }
                zone box wm_tg_hit.$i { at: spx + 219 * pu, ty; size: 430 * pu, 28 * pu; corner: 10 * pu; cursor: pointer; active: (ty) - sby - wm.off > 0 and (ty) - sby - wm.off < set.h * pu }
                on press wm_tg_hit.$i { emit wm_toggle(i) }
            }

            //  Window style: the border, the corners, the shadow and the title bar.
            box { at: spx + 219 * pu, sby + 629 * pu; size: 438 * pu, 274 * pu; corner: 14 * pu; color: ink; opacity: veil }
            text "WINDOW STYLE" { at: floor(spx + 14 * pu + 0.5), floor(sby + 480 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" }
            repeat i in 0..9 {
                let sy = sby + (512 + i * 30) * pu
                let sv = pick(i, wm_bw / 6, (wm_ba - 20) / 80, wm_rad / 24, wm_shd / 200, (wm_tb - 16) / 18, (wm_tbo - 40) / 60, (wm_wa - 40) / 60, (wm_wi - 40) / 60, wm_fr / 100)
                text pick(i, "Border width", "Border strength", "Corner radius", "Shadow", "Title bar height", "Title bar glass", "Window opacity", "Unfocused opacity", "Frosted backing") { at: floor(spx + 14 * pu + 0.5), floor(sy + 0.5); anchor: left center; size: 15; color: faint; family: "Space Grotesk" }
                body { color: deep; rim: 9%; box { at: wsl.x0 + wsl.w / 2, sy; size: wsl.w, wh; corner: wh / 2 } }
                group {
                    glow: 6 * pu, 50%, mint
                    body {
                        gradient: wsl.x0, 0 to wsl.x0 + wsl.w, 0, mintlo, mint 55%, minthi
                        rim: 22%
                        box { from: wsl.x0, sy - wh / 2; size: max(0.1, wsl.w * sv), wh; corner: wh / 2 }
                    }
                }
                text pick(i, wm_bw_text, wm_ba_text, wm_rad_text, wm_shd_text, wm_tb_text, wm_tbo_text, wm_wa_text, wm_wi_text, wm_fr_text) { at: floor(spx + 424 * pu + 0.5), floor(sy + 0.5); anchor: right center; size: 17.5; weight: 600; color: ink; family: "Space Grotesk" }
                zone box wm_st_hit.$i { at: wsl.x0 + wsl.w / 2, sy; size: wsl.w + 24 * pu, 30 * pu; cursor: pointer; active: sy - sby - wm.off > 0 and sy - sby - wm.off < set.h * pu }
                on press wm_st_hit.$i { emit wm_style_set(i * 10 + clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }
                on drag wm_st_hit.$i { emit wm_style_set(i * 10 + clamp((pointer.x - wsl.x0) / wsl.w, 0, 1)) }
            }
            }

            //  The scrollbar and the "More" cue, as on the Display page: a thumb as tall as the viewport is of the page, and a pill
            //  at the foot of the view while there is more below (pressing it scrolls a screenful down).
            let wm.thh = set.h * set.h / max(set.h, wm.h)
            let wm.thy = wm.thh / 2 + wm.sc / max(1, wm.h - set.h) * (set.h - wm.thh)
            box { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: if(wm.h > set.h, 6%, 0%) }
            box { at: spx + 442 * pu, sby + wm.thy * pu; size: 3 * pu, wm.thh * pu; corner: 1.5 * pu; color: mint; opacity: if(wm.h > set.h, 55%, 0%) }
            let wm.cue = clamp((wm.h - set.h - wm.sc) / 24, 0, 1)
            let wm.cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * wm.cue }
            }
            box { at: spx + 224 * pu, wm.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * wm.cue }
            box { at: spx + 224 * pu, wm.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * wm_cue_hit.hover) * wm.cue }
            path { at: spx + 204 * pu, wm.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: wm.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, wm.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: wm.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            text "More" { at: floor(spx + 232 * pu + 0.5), floor(wm.cuey + 0.5); anchor: center; size: 15; weight: 700; color: ink; opacity: wm.cue; family: "Space Grotesk" }
            zone box wm_cue_hit { at: spx + 224 * pu, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: wm.cue > 0.5 }
            on press wm_cue_hit { wm_scroll_to = clamp(wm_scroll_to + 342, 0, max(0, wm.h - set.h)) }
            zone box wm_bar_hit { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: wm.h > set.h }
            on press wm_bar_hit { wm_scroll_to = clamp(((pointer.y - sby) / pu - wm.thh / 2) / max(1, set.h - wm.thh) * (wm.h - set.h), 0, max(0, wm.h - set.h)) }
            on drag wm_bar_hit { wm_scroll_to = clamp(((pointer.y - sby) / pu - wm.thh / 2) / max(1, set.h - wm.thh) * (wm.h - set.h), 0, max(0, wm.h - set.h)) }
        }
}
