part PleamarWm {
        //  The Pleamar-WM page: layout, gaps and effects (live, kept in wm.json) and the input lines of session.conf (next login).
        group {
            show: set_pgw > 0.01
            opacity: set_pgw
            let wm.sc = clamp(wm_scroll, 0, max(0, wm.h - set.h))
            let wm.off = floor(wm.sc * pu + 0.5)        // whole pixels: text shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pu, sby + set.h / 2 * pu; size: 456 * pu, set.h * pu }
            zone box wm_wheel { at: spx + 219 * pu, sby + set.h / 2 * pu; size: 446 * pu, set.h * pu }
            on scroll wm_wheel { wm_scroll_to = clamp(wm_scroll_to - wheel * 44, 0, max(0, wm.h - set.h)) }
            group {
            move: 0, -wm.off
            let wsl.x0 = spx + 122 * pu
            let wsl.w = 250 * pu
            let wh = 12 * pu

            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 125 * pu; size: 438 * pu, 250 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 125 * pu; size: 438 * pu, 250 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 309 * pu; size: 438 * pu, 62 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 309 * pu; size: 438 * pu, 62 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 440 * pu; size: 438 * pu, 156 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 440 * pu; size: 438 * pu, 156 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); text "LAYOUT & WINDOWS" { at: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 266 * pu + 0.5); text "EFFECTS" { at: floor(spx + 14 * pu + 0.5), floor(sby + 266 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 352 * pu + 0.5); text "INPUT  ·  NEXT LOGIN" { at: floor(spx + 14 * pu + 0.5), floor(sby + 352 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }

            //  Whose layout the buttons below set: one for each monitor plugged in (each monitor keeps its own).
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 42 * pu + 0.5); text "Monitor" { at: floor(spx + 14 * pu + 0.5), floor(sby + 42 * pu + 0.5); anchor: left center; size: 16.5; color: faint; family: "Space Grotesk" } }
            //  Each one is a little glass button (a gradient lit from the top, a hairline of light round it, a highlight along its upper edge) with a monitor
            //  drawn in it; the picked one glows. Left edges and widths are the layout buttons' below, so the columns line up.
            //  (The window manager keeps up to four monitors: with a fourth plugged in the pills are narrower, so all four fit in the row.)
            let mnw = if(wm_m.3.on, 63, 84)
            let mnp = if(wm_m.3.on, 66, 90)
            repeat k in 0..4 {
                let mnl = spx + (122 + k * mnp) * pu
                let mnx = mnl + mnw / 2 * pu
                let mny = sby + 42 * pu
                let mns = if(wm_mon_sel == k, 1, 0)
                body {
                    gradient: mnx, mny - 13 * pu to mnx, mny + 13 * pu, mix(mix(ink, deep, 78%), mix(mint, #ffffff, 30%), mns), mix(deep, mix(mint, #000000, 35%), mns)
                    rim: 28% + 30% * mns
                    shadow: 0, 2 * pu, 7 * pu, 30% * mns, mint
                    opacity: if(wm_m.$k.on, 55% + 20% * wm_mon_hit.$k.hover + 25% * mns, 0%)
                    box { at: mnx, mny; size: mnw * pu, 26 * pu; corner: 13 * pu }
                }
                box { at: mnx, mny - 8.5 * pu; size: (mnw - 22) * pu, 2 * pu; corner: 1 * pu; color: #ffffff; opacity: if(wm_m.$k.on, 14% + 22% * mns + 8% * wm_mon_hit.$k.hover, 0%) }
                box { at: mnl + 17 * pu, mny - 1 * pu; size: 15 * pu, 10 * pu; corner: 2.5 * pu; stroke: 1.4 * pu; color: mix(ink, mint, mns); opacity: if(wm_m.$k.on, 100%, 0%) }
                box { at: mnl + 17 * pu, mny + 6.5 * pu; size: 7 * pu, 1.6 * pu; corner: 0.8 * pu; color: mix(ink, mint, mns); opacity: if(wm_m.$k.on, 100%, 0%) }
                group { scale: rs; pivot: floor(mnl + (mnw + 25) / 2 * pu + 0.5), floor(mny + 0.5); text wm_m.$k.name { at: floor(mnl + (mnw + 25) / 2 * pu + 0.5), floor(mny + 0.5); anchor: center; align: center; size: if(wm_m.3.on, 12.5, 14); weight: 600; width: ((mnw - 30) * pu) / rs; lines: 1; color: mix(ink, mint, mns); show: wm_m.$k.on; family: "Space Grotesk" } }
                zone box wm_mon_hit.$k { at: mnx, mny; size: (mnw + 2) * pu, 28 * pu; corner: 14 * pu; cursor: pointer; label: "Set the layout of this monitor"; active: wm_m.$k.on and (mny) - sby - wm.off > 0 and (mny) - sby - wm.off < set.h * pu }
                on press wm_mon_hit.$k { emit wm_mon_pick(k) }
            }

            //  Layout: where the windows of a monitor go.
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 76 * pu + 0.5); text "Layout" { at: floor(spx + 14 * pu + 0.5), floor(sby + 76 * pu + 0.5); anchor: left center; size: 16.5; color: faint; family: "Space Grotesk" } }
            repeat i in 0..8 {
                let lx = spx + 164 * pu + mod(i, 3) * 90 * pu
                let ly = sby + (76 + floor(i / 3) * 28) * pu
                box { at: lx, ly; size: 84 * pu, 24 * pu; corner: 12 * pu; color: if(wm_layout == i, mint, ink); opacity: if(wm_layout == i, 24%, 8% + 10% * wm_lay_hit.$i.hover) }
                PPillOutline(lx, ly, 84 * pu, 24 * pu, 12 * pu, wm_lay_hit.$i.hover, clamp(3 * (if(wm_layout == i, 24%, 8% + 10% * wm_lay_hit.$i.hover)), 0, 1), pu)
                group { scale: rs; pivot: floor(lx + 0.5), floor(ly + 0.5); text pick(i, "Lead left", "Columns", "Rows", "Grid", "Lead right", "Scrolling", "Marea", "Fractal") { at: floor(lx + 0.5), floor(ly + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (80 * pu) / rs; lines: 1; color: if(wm_layout == i, mint, ink); family: "Space Grotesk" } }
                zone box wm_lay_hit.$i { at: lx, ly; size: 86 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (ly) - sby - wm.off > 0 and (ly) - sby - wm.off < set.h * pu }
                on press wm_lay_hit.$i { emit wm_layout_set(i) }
            }

            //  The leader's share of the width, 30 to 80 %.
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 166 * pu + 0.5); text "Leader width" { at: floor(spx + 14 * pu + 0.5), floor(sby + 166 * pu + 0.5); anchor: left center; size: 16.5; color: faint; family: "Space Grotesk" } }
            PSlider(wsl.x0, sby + 166 * pu, wsl.w, clamp((wm_share - 0.3) / 0.5, 0, 1), wm_share_hit.hover, cu, wh, 0)
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 166 * pu + 0.5); text wm_share_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 166 * pu + 0.5); anchor: right center; size: 19.5; weight: 600; color: ink; family: "Space Grotesk" } }
            zone box wm_share_hit { at: wsl.x0 + wsl.w / 2, sby + 166 * pu; size: wsl.w + 24 * pu, 30 * pu; cursor: pointer; active: (sby + 166 * pu) - sby - wm.off > 0 and (sby + 166 * pu) - sby - wm.off < set.h * pu }
            on press wm_share_hit { emit wm_share_set(clamp(((pointer.x - tx.pnl) - wsl.x0) / wsl.w, 0, 1)) }
            on drag wm_share_hit { emit wm_share_set(clamp(((pointer.x - tx.pnl) - wsl.x0) / wsl.w, 0, 1)) }

            //  Gaps between windows, 0 to 32 px.
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 198 * pu + 0.5); text "Gaps" { at: floor(spx + 14 * pu + 0.5), floor(sby + 198 * pu + 0.5); anchor: left center; size: 16.5; color: faint; family: "Space Grotesk" } }
            PSlider(wsl.x0, sby + 198 * pu, wsl.w, clamp(wm_gap / 32, 0, 1), wm_gap_hit.hover, cu, wh, 0)
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 198 * pu + 0.5); text wm_gap_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 198 * pu + 0.5); anchor: right center; size: 19.5; weight: 600; color: ink; family: "Space Grotesk" } }
            zone box wm_gap_hit { at: wsl.x0 + wsl.w / 2, sby + 198 * pu; size: wsl.w + 24 * pu, 30 * pu; cursor: pointer; active: (sby + 198 * pu) - sby - wm.off > 0 and (sby + 198 * pu) - sby - wm.off < set.h * pu }
            on press wm_gap_hit { emit wm_gap_set(clamp(((pointer.x - tx.pnl) - wsl.x0) / wsl.w, 0, 1)) }
            on drag wm_gap_hit { emit wm_gap_set(clamp(((pointer.x - tx.pnl) - wsl.x0) / wsl.w, 0, 1)) }

            //  Free-floating windows, as on Windows or KDE.
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 232 * pu + 0.5); text "Free-floating windows" { at: floor(spx + 14 * pu + 0.5), floor(sby + 232 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pu, sby + 232 * pu, wm_k0, wm_tg_hit.0.pressed, wm_tg_hit.0.hover, mint)
            zone box wm_tg_hit.0 { at: spx + 219 * pu, sby + 232 * pu; size: 430 * pu, 28 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 232 * pu) - sby - wm.off > 0 and (sby + 232 * pu) - sby - wm.off < set.h * pu }
            on press wm_tg_hit.0 { emit wm_toggle(0) }

            //  Effects.
            repeat i in 1..3 {
                let ty = sby + (296 + (i - 1) * 30) * pu
                let tk = pick(i - 1, wm_k1, wm_k2)
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(ty + 0.5); text pick(i - 1, "Rain on the glass", "Snow") { at: floor(spx + 14 * pu + 0.5), floor(ty + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
                SettingsSwitch(spx + 424 * pu, ty, tk, wm_tg_hit.$i.pressed, wm_tg_hit.$i.hover, mint)
                zone box wm_tg_hit.$i { at: spx + 219 * pu, ty; size: 430 * pu, 28 * pu; corner: 10 * pu; cursor: pointer; active: (ty) - sby - wm.off > 0 and (ty) - sby - wm.off < set.h * pu }
                on press wm_tg_hit.$i { emit wm_toggle(i) }
            }

            //  Pointer speeds, -1 to 1, and the screen's idle time, 1 to 30 minutes.
            repeat i in 0..3 {
                let sy = sby + (382 + i * 30) * pu
                let sv = pick(i, (wm_ms + 1) / 2, (wm_ts + 1) / 2, (wm_idle - 1) / 29)
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sy + 0.5); text pick(i, "Mouse speed", "Touchpad speed", "Screen off after") { at: floor(spx + 14 * pu + 0.5), floor(sy + 0.5); anchor: left center; size: 16.5; color: faint; family: "Space Grotesk" } }
                PSlider(wsl.x0, sy, wsl.w, clamp(sv, 0, 1), wm_in_hit.$i.hover, cu, wh, 0)
                group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sy + 0.5); text pick(i, wm_ms_text, wm_ts_text, wm_idle_text) { at: floor(spx + 424 * pu + 0.5), floor(sy + 0.5); anchor: right center; size: 19.5; weight: 600; color: ink; family: "Space Grotesk" } }
                zone box wm_in_hit.$i { at: wsl.x0 + wsl.w / 2, sy; size: wsl.w + 24 * pu, 30 * pu; cursor: pointer; active: (sy) - sby - wm.off > 0 and (sy) - sby - wm.off < set.h * pu }
                on press wm_in_hit.$i { emit wm_input_set(i * 10 + clamp(((pointer.x - tx.pnl) - wsl.x0) / wsl.w, 0, 1)) }
                on drag wm_in_hit.$i { emit wm_input_set(i * 10 + clamp(((pointer.x - tx.pnl) - wsl.x0) / wsl.w, 0, 1)) }
            }
            box { at: wsl.x0 + wsl.w / 2, sby + 382 * pu; size: 1.5 * pu, wh + 6 * pu; corner: 0.75 * pu; color: ink; opacity: 40% }
            box { at: wsl.x0 + wsl.w / 2, sby + 412 * pu; size: 1.5 * pu, wh + 6 * pu; corner: 0.75 * pu; color: ink; opacity: 40% }

            //  Natural scroll and tap to click, for the touchpad.
            repeat i in 3..5 {
                let ty = sby + (382 + i * 30) * pu
                let tk = pick(i - 3, wm_k3, wm_k4)
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(ty + 0.5); text pick(i - 3, "Natural scroll (touchpad)", "Tap to click (touchpad)") { at: floor(spx + 14 * pu + 0.5), floor(ty + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
                SettingsSwitch(spx + 424 * pu, ty, tk, wm_tg_hit.$i.pressed, wm_tg_hit.$i.hover, mint)
                zone box wm_tg_hit.$i { at: spx + 219 * pu, ty; size: 430 * pu, 28 * pu; corner: 10 * pu; cursor: pointer; active: (ty) - sby - wm.off > 0 and (ty) - sby - wm.off < set.h * pu }
                on press wm_tg_hit.$i { emit wm_toggle(i) }
            }

            //  Window style: the border, the corners, the shadow and the title bar.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: obs; border: 3.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 741 * pu; size: 438 * pu, 374 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 741 * pu; size: 438 * pu, 374 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 542 * pu + 0.5); text "WINDOW STYLE" { at: floor(spx + 14 * pu + 0.5), floor(sby + 542 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            //  Window style, as a whole: the title bar's glass and its buttons, and the border.
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 574 * pu + 0.5); text "Style" { at: floor(spx + 14 * pu + 0.5), floor(sby + 574 * pu + 0.5); anchor: left center; size: 16.5; color: faint; family: "Space Grotesk" } }
            repeat i in 0..4 {
                let lx = spx + 164 * pu + mod(i, 2) * 126 * pu
                let ly = sby + (574 + floor(i / 2) * 28) * pu
                box { at: lx, ly; size: 120 * pu, 24 * pu; corner: 12 * pu; color: if(wm_wst == i, mint, ink); opacity: if(wm_wst == i, 24%, 8% + 10% * wm_wst_hit.$i.hover) }
                PPillOutline(lx, ly, 120 * pu, 24 * pu, 12 * pu, wm_wst_hit.$i.hover, clamp(3 * (if(wm_wst == i, 24%, 8% + 10% * wm_wst_hit.$i.hover)), 0, 1), pu)
                group { scale: rs; pivot: floor(lx + 0.5), floor(ly + 0.5); text pick(i, "Vitreus glass", "Water", "Borderless", "Glow") { at: floor(lx + 0.5), floor(ly + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (114 * pu) / rs; lines: 1; color: if(wm_wst == i, mint, ink); family: "Space Grotesk" } }
                zone box wm_wst_hit.$i { at: lx, ly; size: 122 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: (ly) - sby - wm.off > 0 and (ly) - sby - wm.off < set.h * pu; label: pick(i, "Window style: Vitreus glass", "Window style: Water", "Window style: Borderless", "Window style: Glow") }
                on press wm_wst_hit.$i { emit wm_wst_set(i) }
            }
            //  Title bars, on every window (tiled or floating).
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 634 * pu + 0.5); text "Title bars" { at: floor(spx + 14 * pu + 0.5), floor(sby + 634 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pu, sby + 634 * pu, wm_k5, wm_tg_hit.5.pressed, wm_tg_hit.5.hover, mint)
            zone box wm_tg_hit.5 { at: spx + 219 * pu, sby + 634 * pu; size: 430 * pu, 28 * pu; corner: 10 * pu; cursor: pointer; active: (sby + 634 * pu) - sby - wm.off > 0 and (sby + 634 * pu) - sby - wm.off < set.h * pu }
            on press wm_tg_hit.5 { emit wm_toggle(5) }
            repeat i in 0..9 {
                let sy = sby + (674 + i * 30) * pu
                let sv = pick(i, wm_bw / 6, (wm_ba - 20) / 80, wm_rad / 24, wm_shd / 200, (wm_tb - 16) / 18, (wm_tbo - 40) / 60, (wm_wa - 40) / 60, (wm_wi - 40) / 60, wm_fr / 100)
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sy + 0.5); text pick(i, "Border width", "Border strength", "Corner radius", "Shadow", "Title bar height", "Title bar glass", "Window opacity", "Unfocused opacity", "Frosted backing") { at: floor(spx + 14 * pu + 0.5), floor(sy + 0.5); anchor: left center; size: 16.5; color: faint; family: "Space Grotesk" } }
                PSlider(wsl.x0, sy, wsl.w, clamp(sv, 0, 1), wm_st_hit.$i.hover, cu, wh, 0)
                group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sy + 0.5); text pick(i, wm_bw_text, wm_ba_text, wm_rad_text, wm_shd_text, wm_tb_text, wm_tbo_text, wm_wa_text, wm_wi_text, wm_fr_text) { at: floor(spx + 424 * pu + 0.5), floor(sy + 0.5); anchor: right center; size: 19.5; weight: 600; color: ink; family: "Space Grotesk" } }
                zone box wm_st_hit.$i { at: wsl.x0 + wsl.w / 2, sy; size: wsl.w + 24 * pu, 30 * pu; cursor: pointer; active: sy - sby - wm.off > 0 and sy - sby - wm.off < set.h * pu }
                on press wm_st_hit.$i { emit wm_style_set(i * 10 + clamp(((pointer.x - tx.pnl) - wsl.x0) / wsl.w, 0, 1)) }
                on drag wm_st_hit.$i { emit wm_style_set(i * 10 + clamp(((pointer.x - tx.pnl) - wsl.x0) / wsl.w, 0, 1)) }
            }
            }

            //  The scrollbar and the "More" cue, as on the Display page: a thumb as tall as the viewport is of the page, and a pill
            //  at the foot of the view while there is more below (pressing it scrolls a screenful down).
            let wm.thh = set.h * set.h / max(set.h, wm.h)
            let wm.thy = wm.thh / 2 + wm.sc / max(1, wm.h - set.h) * (set.h - wm.thh)
            box { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: if(wm.h > set.h, 6%, 0%) }
            box { at: spx + 442 * pu, sby + wm.thy * pu; size: 3 * pu, wm.thh * pu; corner: 1.5 * pu; color: mint; opacity: if(wm.h > set.h, 55%, 0%) }
            let wm.cue = clamp((wm.h - set.h - wm.sc) / 24, 0, 1)
            let wm.cuey = sby + (set.h - 26) * pu + 2.5 * pu * sin(time * 270)
            repeat i in 0..16 {
                let fk = (i + 1) / 16
                box { from: spx - 4 * pu, sby + (set.h - 56 + i * 3.5) * pu; size: 448 * pu, 3.5 * pu + 0.5; color: deep; opacity: 45% * fk * fk * wm.cue }
            }
            box { at: spx + 224 * pu, wm.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: deep; opacity: 80% * wm.cue }
            box { at: spx + 224 * pu, wm.cuey; size: 76 * pu, 26 * pu; corner: 13 * pu; color: mint; opacity: (10% + 14% * wm_cue_hit.hover) * wm.cue }
            path { at: spx + 204 * pu, wm.cuey - 1 * pu; stroke: 1.6 * pu; color: mint; opacity: wm.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            path { at: spx + 204 * pu, wm.cuey + 4 * pu; stroke: 1.6 * pu; color: mint; opacity: wm.cue; move -4 * pu, -3 * pu; line 0, 1 * pu; line 4 * pu, -3 * pu }
            group { scale: rs; pivot: floor(spx + 232 * pu + 0.5), floor(wm.cuey + 0.5); text "More" { at: floor(spx + 232 * pu + 0.5), floor(wm.cuey + 0.5); anchor: center; size: 16.5; weight: 700; color: ink; opacity: wm.cue; family: "Space Grotesk" } }
            zone box wm_cue_hit { at: spx + 224 * pu, sby + (set.h - 26) * pu; size: 76 * pu, 26 * pu; corner: 13 * pu; cursor: pointer; active: wm.cue > 0.5 }
            on press wm_cue_hit { wm_scroll_to = clamp(wm_scroll_to + 342, 0, max(0, wm.h - set.h)) }
            zone box wm_bar_hit { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 14 * pu, set.h * pu; cursor: pointer; active: wm.h > set.h }
            on press wm_bar_hit { wm_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - wm.thh / 2) / max(1, set.h - wm.thh) * (wm.h - set.h), 0, max(0, wm.h - set.h)) }
            on drag wm_bar_hit { wm_scroll_to = clamp((((pointer.y - ty.set) - sby) / pu - wm.thh / 2) / max(1, set.h - wm.thh) * (wm.h - set.h), 0, max(0, wm.h - set.h)) }
        }
}
