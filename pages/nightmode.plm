part Nightmode {
        //  The Night mode page (Visuals): the switch, how warm the tint is, and when it turns itself on and off.
        group {
            show: set_pgn > 0.01
            opacity: set_pgn
            let ntx0 = spx + 14 * pu
            let ntw = 410 * pu

            //  Card one: the switch.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 26 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 26 * pu, 438 * pu, 52 * pu, 820.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 26 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 26 * pu; size: 438 * pu, 52 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); text "Night mode" { at: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 35 * pu + 0.5); text night_status { at: floor(spx + 14 * pu + 0.5), floor(sby + 35 * pu + 0.5); anchor: left center; size: 15; width: (300 * pu) / rs; lines: 1; color: if(night_on, mint, faint); family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pu, sby + 26 * pu, night_pill, night_sw_hit.pressed, night_sw_hit.hover, mint)
            zone box night_sw_hit { at: spx + 405 * pu, sby + 26 * pu; size: 46 * pu, 30 * pu; cursor: pointer }
            on press night_sw_hit { emit night_toggle }

            //  Card two: how warm. The track is the range itself, from neutral to the warmest, so what is being picked
            //  can be seen; the knob sits where the tint is.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 102 * pu; size: 438 * pu, 84 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 102 * pu, 438 * pu, 84 * pu, 904.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 102 * pu; size: 438 * pu, 84 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 102 * pu; size: 438 * pu, 84 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 71 * pu + 0.5); text "COLOR" { at: floor(spx + 14 * pu + 0.5), floor(sby + 71 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 92 * pu + 0.5); text "Warmth" { at: floor(spx + 14 * pu + 0.5), floor(sby + 92 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 92 * pu + 0.5); text night_temp_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 92 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            //  The control center's pencil slider (PSlider). Under it the track keeps the warmth it picks, faintly (white to orange), so the pencil's level is read against it.
            body {
                gradient: ntx0, 0 to ntx0 + ntw, 0, #f4f7ff, #ffd9ad 45%, #ff9a45
                opacity: 45%
                box { at: ntx0 + ntw / 2, sby + 114 * pu; size: ntw, 12 * pu; corner: 6 * pu }
            }
            PSlider(ntx0, sby + 114 * pu, ntw, clamp(night_t, 0, 1), night_t_hit.hover, cu, 12 * pu, 0)
            group { scale: rs; pivot: floor(ntx0 + 0.5), floor(sby + 135 * pu + 0.5); text "6500 K" { at: floor(ntx0 + 0.5), floor(sby + 135 * pu + 0.5); anchor: left center; size: 13.5; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(ntx0 + ntw + 0.5), floor(sby + 135 * pu + 0.5); text "2500 K" { at: floor(ntx0 + ntw + 0.5), floor(sby + 135 * pu + 0.5); anchor: right center; size: 13.5; color: faint; family: "Space Grotesk" } }
            zone box night_t_hit { at: ntx0 + ntw / 2, sby + 114 * pu; size: ntw + 24 * pu, 30 * pu; cursor: pointer }
            on press night_t_hit { emit night_temp_set(clamp(((pointer.x - tx.pnl) - ntx0) / ntw, 0, 1)) }
            on drag night_t_hit { emit night_temp_set(clamp(((pointer.x - tx.pnl) - ntx0) / ntw, 0, 1)) }

            //  Card three: the schedule. Automatic, and the two times, in half hours.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 220 * pu; size: 438 * pu, 136 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 220 * pu, 438 * pu, 136 * pu, 54.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 220 * pu; size: 438 * pu, 136 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 220 * pu; size: 438 * pu, 136 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 159 * pu + 0.5); text "SCHEDULE" { at: floor(spx + 14 * pu + 0.5), floor(sby + 159 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 177 * pu + 0.5); text "Automatic" { at: floor(spx + 14 * pu + 0.5), floor(sby + 177 * pu + 0.5); anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 194 * pu + 0.5); text "Turns itself on and off at these times" { at: floor(spx + 14 * pu + 0.5), floor(sby + 194 * pu + 0.5); anchor: left center; size: 15; width: (300 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pu, sby + 185 * pu, night_auto_pill, night_auto_hit.pressed, night_auto_hit.hover, mint)
            zone box night_auto_hit { at: spx + 405 * pu, sby + 185 * pu; size: 46 * pu, 30 * pu; cursor: pointer }
            on press night_auto_hit { emit night_auto_toggle }
            //  From and Until: dimmed while it is not automatic, and still there to be set.
            group {
                opacity: 40% + 60% * night_auto_pill
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 225 * pu + 0.5); text "From" { at: floor(spx + 14 * pu + 0.5), floor(sby + 225 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
                ellipse { at: spx + 292 * pu, sby + 225 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * night_sm_hit.hover }
                box { at: spx + 292 * pu, sby + 225 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 345 * pu, sby + 225 * pu; size: 78 * pu, 24 * pu; corner: 7 * pu; color: ink; opacity: 8% }
                group { scale: rs; pivot: floor(spx + 345 * pu + 0.5), floor(sby + 225 * pu + 0.5); text night_start_text { at: floor(spx + 345 * pu + 0.5), floor(sby + 225 * pu + 0.5); anchor: center; align: center; size: 16.5; weight: 700; width: (74 * pu) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
                ellipse { at: spx + 398 * pu, sby + 225 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * night_sp_hit.hover }
                box { at: spx + 398 * pu, sby + 225 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 398 * pu, sby + 225 * pu; size: 1.6 * pu, 9 * pu; corner: 0.8 * pu; color: ink }
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 261 * pu + 0.5); text "Until" { at: floor(spx + 14 * pu + 0.5), floor(sby + 261 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
                ellipse { at: spx + 292 * pu, sby + 261 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * night_em_hit.hover }
                box { at: spx + 292 * pu, sby + 261 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 345 * pu, sby + 261 * pu; size: 78 * pu, 24 * pu; corner: 7 * pu; color: ink; opacity: 8% }
                group { scale: rs; pivot: floor(spx + 345 * pu + 0.5), floor(sby + 261 * pu + 0.5); text night_end_text { at: floor(spx + 345 * pu + 0.5), floor(sby + 261 * pu + 0.5); anchor: center; align: center; size: 16.5; weight: 700; width: (74 * pu) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
                ellipse { at: spx + 398 * pu, sby + 261 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * night_ep_hit.hover }
                box { at: spx + 398 * pu, sby + 261 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 398 * pu, sby + 261 * pu; size: 1.6 * pu, 9 * pu; corner: 0.8 * pu; color: ink }
            }
            zone box night_sm_hit { at: spx + 292 * pu, sby + 225 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            zone box night_sp_hit { at: spx + 398 * pu, sby + 225 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            zone box night_em_hit { at: spx + 292 * pu, sby + 261 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            zone box night_ep_hit { at: spx + 398 * pu, sby + 261 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            on press night_sm_hit { emit night_start_step(-1) }
            on press night_sp_hit { emit night_start_step(1) }
            on press night_em_hit { emit night_end_step(-1) }
            on press night_ep_hit { emit night_end_step(1) }
        }
}
