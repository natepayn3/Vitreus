part Nightmode {
        //  The Night mode page (Visuals): the switch, how warm the tint is, and when it turns itself on and off.
        group {
            show: set_pgn > 0.01
            opacity: set_pgn
            let ntx0 = spx + 122 * pw
            let ntw = 250 * pw

            //  Card one: the switch.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 31 * pu; size: 438 * pw, 62 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 31 * pu, 438 * pw, 62 * pu, 820.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 31 * pu; size: 438 * pw, 62 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 31 * pu; size: 438 * pw, 62 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 31 * pu; size: 438 * pw, 62 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            measure ldr_nigc1
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 22 * pu + 0.5); text "Night mode" { at: floor(spx + 14 * pw + 0.5), floor(sby + 22 * pu + 0.5); measure: ldr_nigc1; anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            measure ldh_nigc1
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 41 * pu + 0.5); text night_status { at: floor(spx + 14 * pw + 0.5), floor(sby + 41 * pu + 0.5); measure: ldh_nigc1; anchor: left center; size: 15; color: if(night_on, mint, faint); family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pw, sby + 31 * pu, night_pill, night_sw_hit.pressed, night_sw_hit.hover, mint)
            PLeader(spx + 14 * pw + max(ldr_nigc1.width, ldh_nigc1.width) * rs + 8 * pu, spx + 424 * pw - 40 * cu, sby + 31 * pu, night_sw_hit.hover, pu)
            zone box night_sw_hit { at: spx + 424 * pw - 19 * cu, sby + 31 * pu; size: 44 * cu, 28 * cu; cursor: pointer; label: "Night mode" }
            on press night_sw_hit { emit night_toggle }

            //  Card two: how warm. The track is the range itself, from neutral to the warmest, so what is being picked
            //  can be seen; the knob sits where the tint is.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 123.5 * pu; size: 438 * pw, 63 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 123.5 * pu, 438 * pw, 63 * pu, 904.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 123.5 * pu; size: 438 * pw, 63 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 123.5 * pu; size: 438 * pw, 63 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 123.5 * pu; size: 438 * pw, 63 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 79 * pu + 0.5); text "COLOR" { at: floor(spx + 14 * pw + 0.5), floor(sby + 79 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            measure ldr_nige1
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 112 * pu + 0.5); text "Warmth" { at: floor(spx + 14 * pw + 0.5), floor(sby + 112 * pu + 0.5); measure: ldr_nige1; anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pw + 0.5), floor(sby + 112 * pu + 0.5); text night_temp_text { at: floor(spx + 424 * pw + 0.5), floor(sby + 112 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            //  The control center's pencil slider (PSlider). Under it the track keeps the warmth it picks, faintly (white to orange), so the pencil's level is read against it.
            body {
                gradient: ntx0, 0 to ntx0 + ntw, 0, #f4f7ff, #ffd9ad 45%, #ff9a45
                opacity: 45%
                box { at: ntx0 + ntw / 2, sby + 112 * pu; size: ntw, 12 * pu; corner: 6 * pu }
            }
            PSlider(ntx0, sby + 112 * pu, ntw, clamp(night_t, 0, 1), night_t_hit.hover, cu, 12 * pu, 0)
            PLeader(spx + 14 * pw + ldr_nige1.width * rs + 8 * pu, ntx0 - 6 * pu, sby + 112 * pu, night_t_hit.hover, pu)
            group { scale: rs; pivot: floor(ntx0 + 0.5), floor(sby + 134 * pu + 0.5); text "6500 K" { at: floor(ntx0 + 0.5), floor(sby + 134 * pu + 0.5); anchor: left center; size: 13.5; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(ntx0 + ntw + 0.5), floor(sby + 134 * pu + 0.5); text "2500 K" { at: floor(ntx0 + ntw + 0.5), floor(sby + 134 * pu + 0.5); anchor: right center; size: 13.5; color: faint; family: "Space Grotesk" } }
            zone box night_t_hit { at: ntx0 + ntw / 2, sby + 112 * pu; size: ntw + 24 * pu, 30 * pu; cursor: pointer }
            on press night_t_hit { emit night_temp_set(clamp(((pointer.x - tx.pnl) - ntx0) / ntw, 0, 1)) }
            on drag night_t_hit { emit night_temp_set(clamp(((pointer.x - tx.pnl) - ntx0) / ntw, 0, 1)) }

            //  Card three: the schedule. Automatic, and the two times, in half hours.
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pw, sby + 246.75 * pu; size: 438 * pw, 123.5 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pw, sby + 246.75 * pu, 438 * pw, 123.5 * pu, 54.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pw, sby + 246.75 * pu; size: 438 * pw, 123.5 * pu; corner: 14 * pu; color: obsidian; opacity: card_fill * (1 - obs) }      // the card's deeper backing (see `card_fill`)
            box { at: spx + 219 * pw, sby + 246.75 * pu; size: 438 * pw, 123.5 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pw, sby + 246.75 * pu; size: 438 * pw, 123.5 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 172 * pu + 0.5); text "SCHEDULE" { at: floor(spx + 14 * pw + 0.5), floor(sby + 172 * pu + 0.5); anchor: left center; size: 16; weight: 700; color: faint; family: "Space Grotesk" } }
            measure ldr_nigb1
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 208 * pu + 0.5); text "Automatic" { at: floor(spx + 14 * pw + 0.5), floor(sby + 208 * pu + 0.5); measure: ldr_nigb1; anchor: left center; size: 19; weight: 700; color: ink; family: "Space Grotesk" } }
            measure ldh_nigb1
            group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 222 * pu + 0.5); text "Turns itself on and off at these times" { at: floor(spx + 14 * pw + 0.5), floor(sby + 222 * pu + 0.5); measure: ldh_nigb1; anchor: left center; size: 15; color: faint; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pw, sby + 214 * pu, night_auto_pill, night_auto_hit.pressed, night_auto_hit.hover, mint)
            PLeader(spx + 14 * pw + max(ldr_nigb1.width, ldh_nigb1.width) * rs + 8 * pu, spx + 424 * pw - 40 * cu, sby + 214 * pu, night_auto_hit.hover, pu)
            zone box night_auto_hit { at: spx + 424 * pw - 19 * cu, sby + 214 * pu; size: 44 * cu, 28 * cu; cursor: pointer; label: "Automatic" }
            on press night_auto_hit { emit night_auto_toggle }
            //  From and Until: dimmed while it is not automatic, and still there to be set.
            group {
                opacity: 40% + 60% * night_auto_pill
                group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 249.5 * pu + 0.5); text "From" { at: floor(spx + 14 * pw + 0.5), floor(sby + 249.5 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
                ellipse { at: spx + 307 * pw, sby + 249.5 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * night_sm_hit.hover }
                box { at: spx + 307 * pw, sby + 249.5 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 360 * pw, sby + 249.5 * pu; size: 78 * pu, 24 * pu; corner: 7 * pu; color: ink; opacity: 8% }
                group { scale: rs; pivot: floor(spx + 360 * pw + 0.5), floor(sby + 249.5 * pu + 0.5); text night_start_text { at: floor(spx + 360 * pw + 0.5), floor(sby + 249.5 * pu + 0.5); anchor: center; align: center; size: 16.5; weight: 700; width: (74 * pw) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
                ellipse { at: spx + 413 * pw, sby + 249.5 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * night_sp_hit.hover }
                box { at: spx + 413 * pw, sby + 249.5 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 413 * pw, sby + 249.5 * pu; size: 1.6 * pu, 9 * pu; corner: 0.8 * pu; color: ink }
                group { scale: rs; pivot: floor(spx + 14 * pw + 0.5), floor(sby + 281.5 * pu + 0.5); text "Until" { at: floor(spx + 14 * pw + 0.5), floor(sby + 281.5 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
                ellipse { at: spx + 307 * pw, sby + 281.5 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * night_em_hit.hover }
                box { at: spx + 307 * pw, sby + 281.5 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 360 * pw, sby + 281.5 * pu; size: 78 * pu, 24 * pu; corner: 7 * pu; color: ink; opacity: 8% }
                group { scale: rs; pivot: floor(spx + 360 * pw + 0.5), floor(sby + 281.5 * pu + 0.5); text night_end_text { at: floor(spx + 360 * pw + 0.5), floor(sby + 281.5 * pu + 0.5); anchor: center; align: center; size: 16.5; weight: 700; width: (74 * pw) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
                ellipse { at: spx + 413 * pw, sby + 281.5 * pu; radius: 11 * pu; color: ink; opacity: 8% + 12% * night_ep_hit.hover }
                box { at: spx + 413 * pw, sby + 281.5 * pu; size: 9 * pu, 1.6 * pu; corner: 0.8 * pu; color: ink }
                box { at: spx + 413 * pw, sby + 281.5 * pu; size: 1.6 * pu, 9 * pu; corner: 0.8 * pu; color: ink }
            }
            zone box night_sm_hit { at: spx + 307 * pw, sby + 249.5 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            zone box night_sp_hit { at: spx + 413 * pw, sby + 249.5 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            zone box night_em_hit { at: spx + 307 * pw, sby + 281.5 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            zone box night_ep_hit { at: spx + 413 * pw, sby + 281.5 * pu; size: 26 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
            on press night_sm_hit { emit night_start_step(-1) }
            on press night_sp_hit { emit night_start_step(1) }
            on press night_em_hit { emit night_end_step(-1) }
            on press night_ep_hit { emit night_end_step(1) }
        }
}
