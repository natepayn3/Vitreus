part Hyprland {
        //  The Hyprland page: layout and gaps, border resize and tearing, animations and input.
        //  Every change goes to Hyprland at once and is kept for the next start (see the Hyprland section of
        //  vitreus.luau). It fits the page, so it does not scroll.
        group {
            show: set_pgh > 0.01 and not wm_niri
            opacity: set_pgh
            let hsl.x0 = spx + 122 * pu
            let hsl.w = 250 * pu
            let hyp_hh = 12 * pu

            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 115 * pu; size: 438 * pu, 230 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 115 * pu, 438 * pu, 230 * pu, 48.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 115 * pu; size: 438 * pu, 230 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 115 * pu; size: 438 * pu, 230 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 278 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 278 * pu, 438 * pu, 44 * pu, 76.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 278 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 278 * pu; size: 438 * pu, 44 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            //  Obsidian: a solid plate a step lighter than the shell, with a small tight shadow, in place of the veil.
            body { color: mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k); opacity: (obs) * (1 - dd_k); border: 2.4 * pu * dd_k, ink; shadow: 0, 2 * pu, 7 * pu, 40% * (1 - dd_k), #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 395 * pu; size: 438 * pu, 138 * pu; corner: 14 * pu } }
            DdCard(spx + 219 * pu, sby + 395 * pu, 438 * pu, 138 * pu, 104.5, mix(mix(obsidian, ink, (veil) * 1.6), dd_cream, dd_k), (obs) * dd_k, pu) { show: dd_k > 0.004 and (obs > 0.004) }      // Doodle: the hand-drawn card
            box { at: spx + 219 * pu, sby + 395 * pu; size: 438 * pu, 138 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
            box { at: spx + 219 * pu, sby + 395 * pu; size: 438 * pu, 138 * pu; corner: 14 * pu; stroke: 1 * pu; color: ink; opacity: hair * (1 - dd_k) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); text "GENERAL & LAYOUT" { at: floor(spx + 14 * pu + 0.5), floor(sby + 13 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 243 * pu + 0.5); text "ANIMATIONS" { at: floor(spx + 14 * pu + 0.5), floor(sby + 243 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 313 * pu + 0.5); text "INPUT" { at: floor(spx + 14 * pu + 0.5), floor(sby + 313 * pu + 0.5); anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk" } }

            //  Layout.
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 42 * pu + 0.5); text "Layout" { at: floor(spx + 14 * pu + 0.5), floor(sby + 42 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            zone box hy_lay_hit_sl { at: spx + 164 * pu + (3 - 1) * 90 * pu / 2, sby + 42 * pu + (1 - 1) * 0 / 2; size: 3 * 90 * pu, 24 * pu + (1 - 1) * 0 }
            SetPick(spx + 164 * pu, sby + 42 * pu, 90 * pu, 3, 24 * pu, hy_layout - 1, hy_lay_hit_sl.hover, pu, 1, 0, 0, if(hy_layout >= 1 and hy_layout <= 3, 1, 0))
            repeat i in 0..3 {
                let lx = spx + 164 * pu + i * 90 * pu
                box { at: lx, sby + 42 * pu; size: 84 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * hy_lay_hit.$i.hover }
                group { scale: rs; pivot: floor(lx + 0.5), floor(sby + 42 * pu + 0.5); text pick(i, "Dwindle", "Master", "Scrolling") { at: floor(lx + 0.5), floor(sby + 42 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (80 * pu) / rs; lines: 1; color: if(hy_layout == i + 1, mint, ink); family: "Space Grotesk" } }
                zone box hy_lay_hit.$i { at: lx, sby + 42 * pu; size: 86 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
                on press hy_lay_hit.$i { emit hy_layout_set(i + 1) }
            }

            //  Gaps, 0 to 30 px.
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 74 * pu + 0.5); text "Gaps" { at: floor(spx + 14 * pu + 0.5), floor(sby + 74 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(hsl.x0, sby + 74 * pu, hsl.w, clamp(hy_gaps / 30, 0, 1), hy_gaps_hit.hover, cu, hyp_hh, 0)
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 74 * pu + 0.5); text hy_gaps_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 74 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box hy_gaps_hit { at: hsl.x0 + hsl.w / 2, sby + 74 * pu; size: hsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press hy_gaps_hit { emit hy_gaps_set(clamp(((pointer.x - tx.pnl) - hsl.x0) / hsl.w, 0, 1)) }
            on drag hy_gaps_hit { emit hy_gaps_set(clamp(((pointer.x - tx.pnl) - hsl.x0) / hsl.w, 0, 1)) }

            //  Corner rounding, 0 to 30 px.
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 106 * pu + 0.5); text "Corner rounding" { at: floor(spx + 14 * pu + 0.5), floor(sby + 106 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(hsl.x0, sby + 106 * pu, hsl.w, clamp(hy_round / 30, 0, 1), hy_round_hit.hover, cu, hyp_hh, 0)
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 106 * pu + 0.5); text hy_round_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 106 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box hy_round_hit { at: hsl.x0 + hsl.w / 2, sby + 106 * pu; size: hsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press hy_round_hit { emit hy_round_set(clamp(((pointer.x - tx.pnl) - hsl.x0) / hsl.w, 0, 1)) }
            on drag hy_round_hit { emit hy_round_set(clamp(((pointer.x - tx.pnl) - hsl.x0) / hsl.w, 0, 1)) }

            //  Border thickness, 0 to 10 px.
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 138 * pu + 0.5); text "Border thickness" { at: floor(spx + 14 * pu + 0.5), floor(sby + 138 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(hsl.x0, sby + 138 * pu, hsl.w, clamp(hy_border / 10, 0, 1), hy_border_hit.hover, cu, hyp_hh, 0)
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 138 * pu + 0.5); text hy_border_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 138 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box hy_border_hit { at: hsl.x0 + hsl.w / 2, sby + 138 * pu; size: hsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press hy_border_hit { emit hy_border_set(clamp(((pointer.x - tx.pnl) - hsl.x0) / hsl.w, 0, 1)) }
            on drag hy_border_hit { emit hy_border_set(clamp(((pointer.x - tx.pnl) - hsl.x0) / hsl.w, 0, 1)) }

            //  Sensitivity, -1 to 1.
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 346 * pu + 0.5); text "Sensitivity" { at: floor(spx + 14 * pu + 0.5), floor(sby + 346 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            PSlider(hsl.x0, sby + 346 * pu, hsl.w, clamp((hy_sens + 1) / 2, 0, 1), hy_sens_hit.hover, cu, hyp_hh, 0)
            box { at: hsl.x0 + hsl.w / 2, sby + 346 * pu; size: 1.5 * pu, hyp_hh + 6 * pu; corner: 0.75 * pu; color: ink; opacity: 40% }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 346 * pu + 0.5); text hy_sens_text { at: floor(spx + 424 * pu + 0.5), floor(sby + 346 * pu + 0.5); anchor: right center; size: 19.5; weight: 700; color: mint; family: "Space Grotesk" } }
            zone box hy_sens_hit { at: hsl.x0 + hsl.w / 2, sby + 346 * pu; size: hsl.w + 24 * pu, 30 * pu; cursor: pointer }
            on press hy_sens_hit { emit hy_sens_set(clamp(((pointer.x - tx.pnl) - hsl.x0) / hsl.w, 0, 1)) }
            on drag hy_sens_hit { emit hy_sens_set(clamp(((pointer.x - tx.pnl) - hsl.x0) / hsl.w, 0, 1)) }

            //  Focus follows the mouse: off, on, loose, full.
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 382 * pu + 0.5); text "Follow mouse" { at: floor(spx + 14 * pu + 0.5), floor(sby + 382 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
            zone box hy_fol_hit_sl { at: spx + 152 * pu + (4 - 1) * 66 * pu / 2, sby + 382 * pu + (1 - 1) * 0 / 2; size: 4 * 66 * pu, 24 * pu + (1 - 1) * 0 }
            SetPick(spx + 152 * pu, sby + 382 * pu, 66 * pu, 4, 24 * pu, hy_follow, hy_fol_hit_sl.hover, pu)
            repeat i in 0..4 {
                let fx = spx + 152 * pu + i * 66 * pu
                box { at: fx, sby + 382 * pu; size: 60 * pu, 24 * pu; corner: (12 * pu) * (1 - 0.85 * dd_k); color: ink; opacity: 7% * hy_fol_hit.$i.hover }
                group { scale: rs; pivot: floor(fx + 0.5), floor(sby + 382 * pu + 0.5); text pick(i, "Off", "On", "Loose", "Full") { at: floor(fx + 0.5), floor(sby + 382 * pu + 0.5); anchor: center; align: center; size: 15.5; weight: 600; width: (56 * pu) / rs; lines: 1; color: if(hy_follow == i, mint, ink); family: "Space Grotesk" } }
                zone box hy_fol_hit.$i { at: fx, sby + 382 * pu; size: 62 * pu, 26 * pu; corner: 13 * pu; cursor: pointer }
                on press hy_fol_hit.$i { emit hy_follow_set(i) }
            }

            //  The switches: resize from the border, tearing, animations, natural scroll.
            repeat i in 0..4 {
                let ty = sby + pick(i, 172, 206, 272, 418) * pu
                let tk = pick(i, hy_k0, hy_k1, hy_k2, hy_k3)
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(ty - 6 * pu + 0.5); text pick(i, "Resize from border", "Allow screen tearing", "Window manager animations", "Natural scroll (touchpad)") { at: floor(spx + 14 * pu + 0.5), floor(ty - 6 * pu + 0.5); anchor: left center; size: 17; weight: 600; color: ink; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(ty + 8 * pu + 0.5); text pick(i, "Grab a window's edge anywhere to resize it", "Lets opted-in fullscreen apps skip vsync", "Hyprland's own window and workspace motion", "Reverses the touchpad's scroll direction") { at: floor(spx + 14 * pu + 0.5), floor(ty + 8 * pu + 0.5); anchor: left center; size: 14.5; color: faint; family: "Space Grotesk" } }
                SettingsSwitch(spx + 424 * pu, ty, tk, hy_tg_hit.$i.pressed, hy_tg_hit.$i.hover, mint)
                zone box hy_tg_hit.$i { at: spx + 219 * pu, ty; size: 430 * pu, 32 * pu; corner: 10 * pu; cursor: pointer }
                on press hy_tg_hit.$i { emit hy_toggle(i) }
            }
        }
}
